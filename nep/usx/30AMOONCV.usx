<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="AMO" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">आमोस</para>
<para style="toc1">आमोस</para>
<para style="toc2">आमोस</para>
<para style="mt1">आमोस</para>
<chapter number="1" style="c" sid="AMO 1"/>
<para style="p"><verse number="1" style="v" sid="AMO 1:1"/>आमोसका वचनहरू, जो तकोका गोठालाहरूमध्येका एक जना थिए। जब उज्जियाह यहूदाका राजा थिए र यारोबामका छोरा योआशचाहिँ इस्राएलका राजा थिए, तब भुइँचालो जानुभन्दा दुई वर्षअगि आमोसले इस्राएलको बारेमा यस्तो दर्शन देखेका थिए।<verse eid="AMO 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="AMO 1:2"/>तिनले भने: “याहवेह सियोन पर्वतदेखि सिंहझैँ गर्जनुहुन्छ, र यरूशलेमबाट चर्को आवाजमा गर्जनुहुन्छ; गोठालाका खर्कहरू सुकेर जान्छन् र कर्मेलको टाकुरा ओइलाउँछ।”<verse eid="AMO 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="AMO 1:3"/>याहवेह यसो भन्‍नुहुन्छ: “दमस्कसका तीन वटा पापहरूका कारण, अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ। किनकि त्यसले फलामका दाँतहरू भएका डण्डाले गिलादलाई दाइँ गरेकी छे;<verse eid="AMO 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="AMO 1:4"/>म हजाएलको घरमा आगो पठाउनेछु, जसले बेन-हददका किल्‍लाहरूलाई भस्म पार्नेछ।<verse eid="AMO 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="AMO 1:5"/>म दमस्कसका ढोकालाई फोरिदिनेछु; म अवेनको बेँसीमा बस्‍ने राजालाई नाश गर्नेछु; अनि बेथ-अदनमा राजदण्ड लिने राजालाई म नाश गर्नेछु। अरामका मानिसहरू निर्वासित भएर कीर देशमा जानेछन्,” याहवेहले भन्‍नुहुन्छ।<verse eid="AMO 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="AMO 1:6"/>याहवेह यसो भन्‍नुहुन्छ: “गाजाका तीन वटा पापहरूका कारण, अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ। किनकि गाजाले सारा समुदायलाई कैदमा लगेकी छे; अनि एदोमको हातमा तिनीहरूलाई बेचेकी छे;<verse eid="AMO 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="AMO 1:7"/>म गाजाका पर्खालहरूमाथि आगो पठाउनेछु, जसले त्यसका किल्‍लाहरू भस्म पार्नेछ।<verse eid="AMO 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="AMO 1:8"/>म अश्दोदको राजा र अश्कलोनको राजदण्ड लिनेलाई नाश गर्नेछु। सबै पलिश्तीहरू नमरेसम्म, म मेरो हात एक्रोनको सहरको विरुद्धमा उठाउनेछु,” प्रभु याहवेह भन्‍नुहुन्छ।<verse eid="AMO 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="AMO 1:9"/>याहवेह यसो भन्‍नुहुन्छ: “टायरका तीन वटा पापहरूका कारण, अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ। किनकि त्यसले मित्रताको सन्धिलाई अनादर गर्दै एदोमलाई कैदीको सारा समुदाय बेचेकी छे;<verse eid="AMO 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="AMO 1:10"/>म टायरका पर्खालहरूमाथि आगो पठाउनेछु, जसले त्यसका बलिया किल्‍लाहरूलाई भस्म पार्नेछ।”<verse eid="AMO 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="AMO 1:11"/>याहवेह यसो भन्‍नुहुन्छ: “एदोमका तीन वटा पापहरूका कारण, अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ। किनकि एदोमले आफ्नो भाइलाई तरवारले खेद्‌यो, र देशका स्त्रीहरूलाई मार्‍यो; किनभने त्यसको रिस निरन्तर उठिरह्‍यो, र त्यसको रिसको ज्वाला दन्किरह्‍यो।<verse eid="AMO 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="AMO 1:12"/>म तेमानमाथि आगो पठाउनेछु; त्यसले बोज्राका किल्‍लाहरूलाई भस्म पार्नेछ।”<verse eid="AMO 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="AMO 1:13"/>याहवेह यसो भन्‍नुहुन्छ: “अम्मोनका तीन वटा पापहरूका कारण, अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ। किनकि अम्मोनले आफ्ना सिमानाहरू बढाउनका निम्ति गिलादका गर्भवती स्त्रीहरूका पेट तरवारले चिरिदियो।<verse eid="AMO 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="AMO 1:14"/>म रब्बाका पर्खालहरूमाथि आगो पठाउनेछु, जसले त्यसको किल्‍लाहरू भस्म पार्नेछ; लडाइँको दिनमा युद्ध ध्वनिहरूका बीचमा, र आँधीबेहरीको दिनमा प्रचण्ड बतासको बीचमा भस्म पार्नेछ।<verse eid="AMO 1:14"/></para>
<para style="p"><verse number="15" style="v" sid="AMO 1:15"/>रब्बाका राजाका साथै तिनी र तिनका अधिकारीहरू सबै एकसाथ निर्वासनमा लगिनेछन्,” याहवेह भन्‍नुहुन्छ।<verse eid="AMO 1:15"/></para>
<chapter eid="AMO 1"/>
<chapter number="2" style="c" sid="AMO 2"/>
<para style="p"><verse number="1" style="v" sid="AMO 2:1"/>याहवेह यसो भन्‍नुहुन्छ: “मोआबका तीन वटा पापहरू, अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ। किनकि त्यसले एदोमको राजाका हड्डीहरू जलाएर खरानी पारिदियो;<verse eid="AMO 2:1"/></para>
<para style="p"><verse number="2" style="v" sid="AMO 2:2"/>म मोआबमाथि आगो पठाउनेछु, जसले किर्योतका किल्‍लाहरूलाई भस्म पार्नेछ। मोआबको पतन ठूलो होहल्‍लाका साथ युद्ध-ध्वनिको बीचमा र तुरहीका आवाजका साथ हुनेछ।<verse eid="AMO 2:2"/></para>
<para style="p"><verse number="3" style="v" sid="AMO 2:3"/>म त्यसको शासकलाई नाश गर्नेछु, र त्यसका सबै अधिकारीहरूलाई त्योसितै मार्नेछु,” याहवेह भन्‍नुहुन्छ।<verse eid="AMO 2:3"/></para>
<para style="p"><verse number="4" style="v" sid="AMO 2:4"/>याहवेह यसो भन्‍नुहुन्छ: “यहूदाका तीन वटा पापहरू, अथवा चारै वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ। किनकि तिनीहरूले याहवेहको व्यवस्थालाई अस्वीकार गरेका छन्, र उहाँका आदेशहरूलाई पालन गरेका छैनन्; किनकि तिनीहरू झूटा देवताहरूको कारण बाटो बिराएका छन्, जसका पितापुर्खाहरूले तिनीहरूलाई पछ्याएका थिए,<verse eid="AMO 2:4"/></para>
<para style="p"><verse number="5" style="v" sid="AMO 2:5"/>म यहूदामाथि आगो पठाउनेछु; त्यसले यरूशलेमका किल्‍लाहरू भस्म पार्नेछ।”<verse eid="AMO 2:5"/></para>
<para style="p"><verse number="6" style="v" sid="AMO 2:6"/>याहवेह यसो भन्‍नुहुन्छ: “इस्राएलका तीन वटा पापहरूका कारण, अथवा चार वटा पापहरूका कारण म त्यसलाई दण्ड नदिई छोड्नेछैनँ। तिनीहरूले निर्दोषलाई चाँदीमा, र खाँचोमा परेकाहरूलाई एक जोर जुत्तामा बेच्छन्।<verse eid="AMO 2:6"/></para>
<para style="p"><verse number="7" style="v" sid="AMO 2:7"/>तिनीहरूले भुइँको धुलोमा कुल्चेझैँ गरिबका टाउकोमाथि कुल्चन्छन्; अनि अत्याचारमा परेकाहरूलाई न्याय दिँदैनन्। बुबा र छोराले एउटै स्त्रीलाई प्रयोग गर्छन्; अनि यसरी मेरो पवित्र नामलाई अपवित्र बनाउँछन्।<verse eid="AMO 2:7"/></para>
<para style="p"><verse number="8" style="v" sid="AMO 2:8"/>तिनीहरू हरेक वेदीको छेउमा बन्धकको रूपमा राखेका लुगाहरूमा ढल्किन्छन्। तिनीहरू आफ्ना देवताको मन्दिरमा जरिमानाको रूपमा उठाएको दाखमद्य पिउँछन्।<verse eid="AMO 2:8"/></para>
<para style="p"><verse number="9" style="v" sid="AMO 2:9"/>“मैले तिनीहरूकै सामु एमोरीहरूलाई नाश गरेँ, तर पनि त्यो देवदारुको रूखजस्तै अल्गो, र फलाँटको रूखजस्तै बलियो थियो। मैले ती रूखहरूमाथि रहेका फलहरू, र त्यसको तल रहेका जराहरू नाश गरिदिएँ।<verse eid="AMO 2:9"/></para>
<para style="p"><verse number="10" style="v" sid="AMO 2:10"/>तिमीहरूलाई एमोरीहरूको देश अधिकारमा दिनका निम्ति मैले तिमीहरूलाई इजिप्टबाट निकालेर ल्याएँ; अनि मैले तिमीहरूलाई चालीस वर्षसम्म उजाडस्थानमा डोर्‍याएँ।”<verse eid="AMO 2:10"/></para>
<para style="p"><verse number="11" style="v" sid="AMO 2:11"/>मैले तिमीहरूका छोराहरूका बीचबाट अगमवक्ताहरू र तिमीहरूका जवान पुरुषहरूका बीचबाट नाजिरीहरू खडा गरेँ। “हे इस्राएलका मानिसहरू हो, के यो साँचो होइन र?” याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 2:11"/></para>
<para style="p"><verse number="12" style="v" sid="AMO 2:12"/>“तर तिमीहरूले नाजिरीहरूलाई दाखमद्य पिउन बाध्य गरायौ, र अगमवक्ताहरूलाई अगमवाणी नबोल भनी आदेश दियौ।<verse eid="AMO 2:12"/></para>
<para style="p"><verse number="13" style="v" sid="AMO 2:13"/>“त्यसैले अब म अन्‍नले लादिएको गाडाले किचेझैँ तिमीहरूलाई जमिनमा किचिदिनेछु।<verse eid="AMO 2:13"/></para>
<para style="p"><verse number="14" style="v" sid="AMO 2:14"/>वेगसित दगुर्ने पनि उम्कनेछैन; बलवान्‌हरूको बल पनि काम लाग्नेछैन, र योद्धाहरूले पनि आफ्नो प्राण बचाउन सक्नेछैनन्।<verse eid="AMO 2:14"/></para>
<para style="p"><verse number="15" style="v" sid="AMO 2:15"/>धनु चलाउने पनि आफ्नो ठाउँमा टिक्नेछैन; र अति वेगसित दौडने सिपाही उम्कनेछैन; अनि घोडसवारले पनि आफ्नो प्राण बचाउन सक्नेछैन।<verse eid="AMO 2:15"/></para>
<para style="p"><verse number="16" style="v" sid="AMO 2:16"/>बहादुर योद्धाहरू नै भए तापनि त्यो दिन तिनीहरू नाङ्गै भाग्नेछन्,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 2:16"/></para>
<chapter eid="AMO 2"/>
<chapter number="3" style="c" sid="AMO 3"/>
<para style="p"><verse number="1" style="v" sid="AMO 3:1"/>हे इस्राएलका मानिसहरू हो, यो वचन सुन, जुन वचन याहवेहले तिमीहरूको विरुद्धमा बोल्नुभएको छ—मैले इजिप्टबाट ल्याएका सम्पूर्ण परिवारको विरुद्धमा:<verse eid="AMO 3:1"/></para>
<para style="p"><verse number="2" style="v" sid="AMO 3:2"/>“पृथ्वीका सारा घरानाका बीचबाट मैले केवल तिमीहरूलाई मात्र चुनेको छु; यसकारण म तिमीहरूलाई तिमीहरूका सबै पापहरूको दण्ड दिनेछु।”<verse eid="AMO 3:2"/></para>
<para style="p"><verse number="3" style="v" sid="AMO 3:3"/>के एक-आपसमा सहमत नभएसम्म दुई जना सँगसँगै हिँड्छन् र?<verse eid="AMO 3:3"/></para>
<para style="p"><verse number="4" style="v" sid="AMO 3:4"/>के जङ्गलमा शिकार नै नभेटी सिंह गर्जन्छ र? के सिंहले केही फेला नपारीकन त्यो आफ्नो गुफाभित्र गर्जन्छ र?<verse eid="AMO 3:4"/></para>
<para style="p"><verse number="5" style="v" sid="AMO 3:5"/>के पासोमा चारो राखिएको छैन भने, चरो पासोमा पर्छ र? के पासोमा केही परेको छैन भने, त्यो पासो भुइँबाट माथि आफैँ उछिटिन्छ र?<verse eid="AMO 3:5"/></para>
<para style="p"><verse number="6" style="v" sid="AMO 3:6"/>जब सहरमा तुरही फुकिन्छ, तब के मानिसहरू डरले काम्दैनन् र? जब सहरमा विपत्ति आउँछ, के त्यो याहवेहले नपठाउनुभएसम्म आउँछ र?<verse eid="AMO 3:6"/></para>
<para style="p"><verse number="7" style="v" sid="AMO 3:7"/>निश्‍चय नै प्रभु याहवेहले आफ्नो योजना उहाँका सेवक अगमवक्ताहरूलाई प्रकट नगरी केही पनि गर्नुहुन्‍न।<verse eid="AMO 3:7"/></para>
<para style="p"><verse number="8" style="v" sid="AMO 3:8"/>सिंह गर्जेको सुनेर, को भयभीत नहोला र? प्रभु याहवेहले बोल्नुभएको छ; अनि कसले अगमवाणी गर्दैन र?<verse eid="AMO 3:8"/></para>
<para style="p"><verse number="9" style="v" sid="AMO 3:9"/>अश्दोदका किल्‍लाहरू र इजिप्टका किल्‍लाहरूलाई घोषणा गर: “सामरियाका पर्वतहरूमा एकसाथ भेला होओ; त्यसभित्र भएको ठूलो अशान्ति र त्यसका आफ्नै मानिसहरूका बीचको थिचोमिचो हेर।”<verse eid="AMO 3:9"/></para>
<para style="p"><verse number="10" style="v" sid="AMO 3:10"/>याहवेह घोषणा गर्नुहुन्छ, “कसरी उचित काम गर्ने भन्‍ने कुरा तिनीहरूलाई थाहा नै छैन; तिनीहरूले खोसेका र लुटेका मालसामानहरू तिनीहरूका किल्‍लाहरूमा थुपार्छन्।”<verse eid="AMO 3:10"/></para>
<para style="p"><verse number="11" style="v" sid="AMO 3:11"/>यसकारण प्रभु याहवेह यसो भन्‍नुहुन्छ: “शत्रुले तिमीहरूको देशमाथि आक्रमण गर्नेछ; त्यसले तिमीहरूका बलिया गढहरूलाई नाश गर्नेछ, र तिमीहरूका किल्‍लाहरूलाई लुटपाट गर्नेछ।”<verse eid="AMO 3:11"/></para>
<para style="p"><verse number="12" style="v" sid="AMO 3:12"/>याहवेह यसो भन्‍नुहुन्छ: “जसरी एउटा गोठालोले सिंहको मुखबाट भेडाका खुट्टाका दुई वटा हड्डीहरू अथवा एउटा कानको टुक्रा मात्र बचाउँछ, त्यसरी नै सामरियामा बस्‍ने इस्राएलीहरू, पलङको कुना र गद्दीमा बस्‍ने थोरै मानिसहरू मात्र बचाइनेछन्।”<verse eid="AMO 3:12"/></para>
<para style="p"><verse number="13" style="v" sid="AMO 3:13"/>प्रभु याहवेह, सेनाहरूका परमेश्‍वर घोषणा गर्नुहुन्छ, “यो सुन, र याकोबको घरानाको विरुद्धमा यो चेतावनी देओ।<verse eid="AMO 3:13"/></para>
<para style="p"><verse number="14" style="v" sid="AMO 3:14"/>“जुन दिन इस्राएललाई त्यसका पापहरूका निम्ति दण्ड दिन्छु, म बेथेल सहरका वेदीहरू ध्वस्त गर्नेछु; वेदीका चारैतिरका सिङहरू काटिनेछन्, र ती भुइँमा खस्‍नेछन्।<verse eid="AMO 3:14"/></para>
<para style="p"><verse number="15" style="v" sid="AMO 3:15"/>म गर्मीका महल सँगसँगै हिउँदका महललाई पनि भत्काउनेछु; हस्तीदन्तले सजिएका भवनहरू ध्वस्त पारिनेछन्, र दरबारहरू भत्काइनेछन्,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 3:15"/></para>
<chapter eid="AMO 3"/>
<chapter number="4" style="c" sid="AMO 4"/>
<para style="p"><verse number="1" style="v" sid="AMO 4:1"/>हे सामरिया पर्वतमाथि बस्‍ने बाशानका गाईहरू हो, यो वचन सुन! हे स्त्रीहरू हो, जसले गरिबहरूलाई थिचोमिचो गर्दछौ र खाँचोमा परेकाहरूलाई सताउँदछौ; अनि आफ्ना पतिहरूलाई भन्दछौ, “हाम्रो निम्ति केही पेय पदार्थ ल्याइदिनुहोस्!”<verse eid="AMO 4:1"/></para>
<para style="p"><verse number="2" style="v" sid="AMO 4:2"/>प्रभु याहवेहले आफ्नो पवित्रताको शपथ खानुभएको छ: “अवश्य नै समय आउनेछ, जब तिमीहरू अङ्कुसेले तानेर निकालिनेछौ, र बाँकी रहेका तिमीहरू पनि बल्छीले समातेर लगिनेछौ।<verse eid="AMO 4:2"/></para>
<para style="p"><verse number="3" style="v" sid="AMO 4:3"/>तिमीहरू हरेक पर्खालका धाँदाहरूबाट सीधै बाहिर निस्कनेछौ। तिमीहरू हर्मोनतिर फ्याँकिनेछौ,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:3"/></para>
<para style="p"><verse number="4" style="v" sid="AMO 4:4"/>“बेथेलमा जाओ र पाप गर; गिलगालमा जाओ र अझ बढी पाप गर। हरेक बिहान तिमीहरूका बलिदानहरू ल्याओ! हरेक तीन वर्षमा तिमीहरूका दशांश भेटी पनि ल्याओ।<verse eid="AMO 4:4"/></para>
<para style="p"><verse number="5" style="v" sid="AMO 4:5"/>खमिर हालेको रोटीलाई धन्यवादको भेटीको रूपमा चढाओ, र स्वेच्छा भेटीहरूका निम्ति धाक लगाओ; अर्थात् हे इस्राएलीहरू हो, तिनीहरूका निम्ति घमण्ड गर; किनकि तिमीहरू यसै गर्न रुचाउँछौ,” प्रभु याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:5"/></para>
<para style="p"><verse number="6" style="v" sid="AMO 4:6"/>“मैले हरेक सहरमा तिमीहरूलाई भोको पेट राखेँ, र हरेक नगरमा रोटीको अभाव गरिदिएँ; तापनि तिमीहरू मकहाँ फर्केर आएनौ,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:6"/></para>
<para style="p"><verse number="7" style="v" sid="AMO 4:7"/>“फसलको समय अझै तीन महिना बाँकी रहँदै मैले तिमीहरूका निम्ति वर्षा पनि रोकिदिएँ। मैले एउटा सहरमा वर्षाको पानी पठाएँ, तर अर्को सहरमा रोकिदिएँ। एउटा खेतमा पानी पर्‍यो; तर अर्को खेतमाथि परेन, त्यो सुक्यो।<verse eid="AMO 4:7"/></para>
<para style="p"><verse number="8" style="v" sid="AMO 4:8"/>मानिसहरू पानी पिउनका निम्ति सहर-सहरमा धरमरिँदै हिँडे, तर प्रशस्त पिउनलाई पानी पाएनन्, तापनि तिमीहरू मकहाँ फर्केर आएनौ,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:8"/></para>
<para style="p"><verse number="9" style="v" sid="AMO 4:9"/>“धेरै पटक मैले तिमीहरूका बगैँचाहरू र दाखबारीहरूलाई प्रहार गरेँ; मैले तिनीहरूलाई रोग र ढुसीले नाश पारेँ। सलहहरूले तिमीहरूका नेभारा र जैतुनका रूखहरूलाई सखाप पारिदिए, तापनि तिमीहरू मकहाँ फर्केर आएनौ,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:9"/></para>
<para style="p"><verse number="10" style="v" sid="AMO 4:10"/>“मैले इजिप्टमा पठाएझैँ तिमीहरूका बीचमा विपत्तिहरू पठाएँ। मैले तिमीहरूका जवान मानिसहरूलाई तरवारले मारेँ र तिमीहरूका घोडाहरूसमेत कब्जा गरेँ। मैले तिमीहरूका छाउनी मृतक शरीरका दुर्गन्धले भरिदिएँ, तापनि तिमीहरू मकहाँ फर्केर आएनौ,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:10"/></para>
<para style="p"><verse number="11" style="v" sid="AMO 4:11"/>“मैले सदोम र गमोरालाई ध्वस्त पारेजस्तै गरी तिमीहरूमध्ये कतिलाई ध्वस्त पारेको छु। तिमीहरू जल्दैगरेको आगोबाट निकालिएको अगुल्टोजस्तै थियौ, तापनि तिमीहरू मकहाँ फर्केर आएनौ,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 4:11"/></para>
<para style="p"><verse number="12" style="v" sid="AMO 4:12"/>“यसकारण हे इस्राएलीहरू हो, म तिमीहरूलाई यसो गर्नेछु; किनकि मैले तिमीहरूलाई यसो गर्न लागेको हुनाले, तिमीहरू आफ्ना परमेश्‍वरलाई भेट्न तयार होओ।”<verse eid="AMO 4:12"/></para>
<para style="p"><verse number="13" style="v" sid="AMO 4:13"/>जसले पर्वतहरू बनाउनुहुन्छ, जसले बतासलाई सृजना गर्नुहुन्छ; अनि उहाँले आफ्ना विचारहरू मानिस जातिलाई प्रकट गर्नुहुन्छ; उहाँले नै बिहानीको प्रभातलाई अन्धकारमा परिवर्तन गर्नुहुन्छ, र पृथ्वीका अग्ला-अग्ला स्थानहरूमा कुल्चनुहुन्छ; उहाँको नाम याहवेह सेनाहरूका परमेश्‍वर हो।<verse eid="AMO 4:13"/></para>
<chapter eid="AMO 4"/>
<chapter number="5" style="c" sid="AMO 5"/>
<para style="p"><verse number="1" style="v" sid="AMO 5:1"/>हे इस्राएलको घराना हो, मैले तिमीहरूका निम्ति गरेको विलापको गीत सुन:<verse eid="AMO 5:1"/></para>
<para style="p"><verse number="2" style="v" sid="AMO 5:2"/>“कन्ये इस्राएल फेरि कहिल्यै नउठ्ने गरी लडेकी छे; आफ्नै देशमा त्यागिएकी छे; त्यसलाई उठाउने कोही पनि छैन।”<verse eid="AMO 5:2"/></para>
<para style="p"><verse number="3" style="v" sid="AMO 5:3"/>प्रभु याहवेह इस्राएललाई यसो भन्‍नुहुन्छ: “तेरो सहरबाट एक हजार जना सेनाहरू निस्कन्छन्, तर केवल एक सय मात्र छोडिनेछन्; तेरो सहरबाट एक सय जना सेनाहरू निस्कन्छन्, तर केवल दश जना मात्र छोडिनेछन्।”<verse eid="AMO 5:3"/></para>
<para style="p"><verse number="4" style="v" sid="AMO 5:4"/>याहवेहले इस्राएलको घरानालाई यसो भन्‍नुहुन्छ: “मलाई खोज र तिमीहरू जीवित रहो;<verse eid="AMO 5:4"/></para>
<para style="p"><verse number="5" style="v" sid="AMO 5:5"/>बेथेललाई नखोज, गिलगालमा नजाओ र बेर्शेबातिर यात्रा नगर। किनकि गिलगाल निश्‍चय नै निर्वासनमा लगिनेछ; अनि बेथेल काम नलाग्ने हुनेछ।”<verse eid="AMO 5:5"/></para>
<para style="p"><verse number="6" style="v" sid="AMO 5:6"/>याहवेहलाई खोज र जीवित रहो, नत्रता उहाँ योसेफको घरानामा आगोजस्तै दन्किएर आउनुहुनेछ; जुन आगोले तिनीहरूलाई भस्म पार्नेछ, र त्यसलाई निभाउन बेथेलमा कोही पनि हुनेछैन।<verse eid="AMO 5:6"/></para>
<para style="p"><verse number="7" style="v" sid="AMO 5:7"/>त्यहाँ न्यायलाई तितो बनाउने, र धार्मिकतालाई माटोमा मिलाउने दुवै हुनेछैनन्।<verse eid="AMO 5:7"/></para>
<para style="p"><verse number="8" style="v" sid="AMO 5:8"/>उहाँले किरकिटी र मृगशिरा तारामण्डललाई सृजना गर्नुभयो, जसले मध्य रातलाई बिहानीमा र र मध्य दिनलाई रातमा परिवर्तन गर्नुहुन्छ; जसले समुद्रको पानीलाई बोलाउनुहुन्छ, र ती पानीहरूलाई जमिनमाथि खन्याउनुहुन्छ; उहाँको नाम याहवेह हो।<verse eid="AMO 5:8"/></para>
<para style="p"><verse number="9" style="v" sid="AMO 5:9"/>उहाँले बलिया किल्‍लाहरूलाई अचानक सर्वनाश गर्नुहुन्छ, र बलिया गढ भएको सहरलाई तहसनहस पार्नुहुन्छ।<verse eid="AMO 5:9"/></para>
<para style="p"><verse number="10" style="v" sid="AMO 5:10"/>तिमीहरू अदालतमा साँचो न्याय गर्नेलाई घृणा गर्छौ, र सत्य बोल्नेलाई तुच्छ ठान्छौ।<verse eid="AMO 5:10"/></para>
<para style="p"><verse number="11" style="v" sid="AMO 5:11"/>तिमीहरू गरिबमाथि परालको समेत कर लगाउँछौ, र तिनीहरूका अन्‍नमा कर थोपर्छौ। यसकारण तिमीहरूले ढुङ्गाका महलहरू बनाएका छौ, तर तिमीहरू ती महलहरूमा बस्‍नेछैनौ; तिमीहरूले सुन्दर दाखबारी लगाएका छौ, तर तिमीहरूले त्यसको दाखरस पिउनेछैनौ।<verse eid="AMO 5:11"/></para>
<para style="p"><verse number="12" style="v" sid="AMO 5:12"/>किनकि म जान्दछु, तिमीहरूका अपराधहरू कति धेरै छन्, र तिमीहरूका पापहरू निकै गम्भीर छन्। तिमीहरू जसले धर्मीहरूलाई सताउँछौ र घूस लिन्छौ; अनि गरिबलाई अदालतमा न्याय पाउनबाट रोक्छौ।<verse eid="AMO 5:12"/></para>
<para style="p"><verse number="13" style="v" sid="AMO 5:13"/>यसकारण यस्तो समयमा बुद्धिमान् मानिस पनि चुपचाप बस्‍नेछ; किनकि समय खराब छ।<verse eid="AMO 5:13"/></para>
<para style="p"><verse number="14" style="v" sid="AMO 5:14"/>भलाइको खोजी गर, दुष्‍टताको होइन, ताकि तिमीहरू बाँचिरहो। तब तिमीहरूले भन्‍ने गरेझैँ, याहवेह सेनाहरूका परमेश्‍वर तिमीहरूसँग हुनुहुनेछ।<verse eid="AMO 5:14"/></para>
<para style="p"><verse number="15" style="v" sid="AMO 5:15"/>दुष्‍टतालाई घृणा गर, भलाइलाई प्रेम गर; अदालतमा न्यायलाई कायम राख। सायद याहवेह सेनाहरूका परमेश्‍वरले योसेफका बाँकी रहेकाहरूमाथि अनुग्रह गर्नुहुनेछ।<verse eid="AMO 5:15"/></para>
<para style="p"><verse number="16" style="v" sid="AMO 5:16"/>यसकारण याहवेह सेनाहरूका परमेश्‍वर भन्‍नुहुन्छ: “सबै सडकहरूमा रुवाबासी र हरेक सार्वजनिक चोकहरूमा वेदनाका रोदनहरू हुनेछन्। खेती गर्ने किसानहरूलाई रुन र शोक गर्नेहरूलाई विलाप गर्न बोलाइनेछ।<verse eid="AMO 5:16"/></para>
<para style="p"><verse number="17" style="v" sid="AMO 5:17"/>त्यहाँ सबै दाखबारीहरूमा रुवाबासी हुनेछ; किनकि म तिमीहरूका बीचबाट भएर जानेछु,” याहवेह भन्‍नुहुन्छ।<verse eid="AMO 5:17"/></para>
<para style="p"><verse number="18" style="v" sid="AMO 5:18"/>धिक्‍कार तिमीहरूलाई, जसले याहवेहको दिनको तिर्सना गर्दछौ! तिमीहरू याहवेहको दिनको किन तिर्सना गर्दछौ? त्यो दिन उज्यालो होइन, तर अन्धकारको दिन हुनेछ।<verse eid="AMO 5:18"/></para>
<para style="p"><verse number="19" style="v" sid="AMO 5:19"/>कुनै मानिस सिंहबाट भागेर भालुलाई भेटे जस्तै, र घरभित्र पस्दा, र विश्रामको लागि आफ्नो हात भित्तामा राख्दा त्यसलाई सर्पले डसेजस्तै, त्यो दिन हुनेछ।<verse eid="AMO 5:19"/></para>
<para style="p"><verse number="20" style="v" sid="AMO 5:20"/>हो, याहवेहको दिन उज्यालो होइन, तर अन्धकारमय हुनेछ; अर्थात् उज्यालोको किरण विनाको घोर अन्धकार।<verse eid="AMO 5:20"/></para>
<para style="p"><verse number="21" style="v" sid="AMO 5:21"/>“म तिमीहरूका धार्मिक चाडहरूलाई तुच्छ ठान्छु; मेरा लागि तिमीहरूका सभाहरू दुर्गन्धजस्तै हो।<verse eid="AMO 5:21"/></para>
<para style="p"><verse number="22" style="v" sid="AMO 5:22"/>तिमीहरूले मेरा निम्ति होमबलि र अन्‍नबलिहरू चढाए पनि, म ती बलिहरू ग्रहण गर्नेछैनँ। तिमीहरूले अति असल बाछाको मेलबलिहरू चढाए तापनि म ती बलिहरूलाई वास्ता गर्नेछैनँ।<verse eid="AMO 5:22"/></para>
<para style="p"><verse number="23" style="v" sid="AMO 5:23"/>तिमीहरूका प्रशंसाको होहल्‍ला मबाट टाढा राख! म तिमीहरूका वीणाको सङ्गीत सुन्‍नेछैनँ।<verse eid="AMO 5:23"/></para>
<para style="p"><verse number="24" style="v" sid="AMO 5:24"/>तर न्याय एउटा नदीझैँ बगोस्, र धार्मिकताचाहिँ कहिल्यै नसुक्ने मुहानझैँ!<verse eid="AMO 5:24"/></para>
<para style="p"><verse number="25" style="v" sid="AMO 5:25"/>“हे इस्राएलका घराना हो, के तिमीहरूले उजाडस्थानमा चालीस वर्षसम्म मेरा निम्ति बलिदानहरू र भेटीहरू चढायौ?<verse eid="AMO 5:25"/></para>
<para style="p"><verse number="26" style="v" sid="AMO 5:26"/>तर तिमीहरूले आफ्ना राज-देव सक्‍कूत, र तिमीहरूको तारा-देव कीयूनका देवस्थानलाई उचालेका छौ, जसलाई तिमीहरूले आफ्नै निम्ति बनाएका थियौ।<verse eid="AMO 5:26"/></para>
<para style="p"><verse number="27" style="v" sid="AMO 5:27"/>यसकारण म तिमीहरूलाई दमस्कसभन्दा टाढा निर्वासनमा पठाउनेछु,” याहवेह भन्‍नुहुन्छ, जसको नाम सेनाहरूका परमेश्‍वर हो।<verse eid="AMO 5:27"/></para>
<chapter eid="AMO 5"/>
<chapter number="6" style="c" sid="AMO 6"/>
<para style="p"><verse number="1" style="v" sid="AMO 6:1"/>धिक्‍कार तिमीहरूलाई, जो सियोनमा निर्धक्‍कसाथ बसेका छौ; अनि धिक्‍कार तिमीहरूलाई, जो सामरियाको पर्वतमाथि आफूलाई सुरक्षित ठान्छौ; धिक्‍कार तिमीहरू प्रमुख राष्ट्रका प्रसिद्ध मानिसहरू, जसकहाँ इस्राएलका मानिसहरू आउँछन्!<verse eid="AMO 6:1"/></para>
<para style="p"><verse number="2" style="v" sid="AMO 6:2"/>कल्नेह सहरमा जाओ र त्यसलाई हेर; त्यहाँबाट हमात सहरमा जाओ; अनि तल पलिश्तीको गातमा जाओ। के तिमीहरूका दुई राज्यहरूभन्दा ती असल छन् र? के तिनीहरूको देश तिमीहरूको भन्दा ठूलो छ र?<verse eid="AMO 6:2"/></para>
<para style="p"><verse number="3" style="v" sid="AMO 6:3"/>तिमीहरूले विपत्तिको दिनलाई टाढा पन्छाउँछौ, र एउटा आतङ्कको शासन नजिक ल्याउँछौ।<verse eid="AMO 6:3"/></para>
<para style="p"><verse number="4" style="v" sid="AMO 6:4"/>तिमीहरू हस्तीदन्तले जडेको पलङमा सुत्छौ, र सोफाहरूमा ढल्कन्छौ। तिमीहरू असल भेडाहरू र मोटा बाछाहरू खान्छौ।<verse eid="AMO 6:4"/></para>
<para style="p"><verse number="5" style="v" sid="AMO 6:5"/>तिमीहरू दावीदले झैँ वीणा बजाउँछौ, र सङ्गीतका बाजाहरूमा तत्कालै धुन रच्दछौ।<verse eid="AMO 6:5"/></para>
<para style="p"><verse number="6" style="v" sid="AMO 6:6"/>तिमीहरू कचौरा भरेर दाखमद्य पिउँछौ, र उत्तम सुगन्धित तेलहरू प्रयोग गर्छौ, तर योसेफको विनाशमाथि शोक गर्दैनौ।<verse eid="AMO 6:6"/></para>
<para style="p"><verse number="7" style="v" sid="AMO 6:7"/>यसकारण तिमीहरू नै पहिले निर्वासनमा जानेछौ; तिमीहरूका भोज र मोजमज्जाहरूको अन्त्य हुनेछ।<verse eid="AMO 6:7"/></para>
<para style="p"><verse number="8" style="v" sid="AMO 6:8"/>प्रभु याहवेहले आफ्नै नाममा शपथ खानुभएको छ—याहवेह सेनाहरूका परमेश्‍वर घोषणा गर्नुहुन्छ: “म याकोबको घमण्डलाई घृणा गर्छु, र त्यसका किल्‍लाहरूलाई घृणा गर्छु; म यस सहर र यसमा भएका सबैलाई शत्रुको हातमा सुम्पिदिनेछु।”<verse eid="AMO 6:8"/></para>
<para style="p"><verse number="9" style="v" sid="AMO 6:9"/>यदि एउटा घरमा दश जना मानिसहरू मात्रै बाँकी रहे तापनि तिनीहरू मर्नेछन्।<verse eid="AMO 6:9"/></para>
<para style="p"><verse number="10" style="v" sid="AMO 6:10"/>यदि लासहरू घरबाट बाहिर निकालेर जलाउन भनी आफन्त आएर त्यहाँ लुकेकाहरूलाई, “तिमीसित अझै कोही छ?” भनी सोध्छ र उसले भन्छ, “अहँ, कोही पनि छैन,” तब त्यसले भन्‍नेछ, “चुप लाग! हामीले याहवेहको नाम लिनुहुँदैन।”<verse eid="AMO 6:10"/></para>
<para style="p"><verse number="11" style="v" sid="AMO 6:11"/>किनकि याहवेहले आज्ञा दिनुभएको छ; अनि उहाँले विशाल भवनहरूलाई चकनाचुर र साना घरहरूलाई तहसनहस पार्नुहुनेछ।<verse eid="AMO 6:11"/></para>
<para style="p"><verse number="12" style="v" sid="AMO 6:12"/>के घोडाहरू चट्टानहरूमाथि दौडन्छन् र? के कसैले समुद्रमा गोरुहरूले जोत्छ र? तर तिमीहरूले त न्यायलाई विषमा र धार्मिकताका फलचाहिँ तितोमा परिणत गरिदिएका छौ,<verse eid="AMO 6:12"/></para>
<para style="p"><verse number="13" style="v" sid="AMO 6:13"/>अर्थात् तिमीहरू लो-देबार सहरलाई जितेकोमा आनन्द मनाउँछौ, र भन्छौ, “के हामीले आफ्नै बलले कार्नैम सहरलाई कब्जा गरेका होइनौँ र?”<verse eid="AMO 6:13"/></para>
<para style="p"><verse number="14" style="v" sid="AMO 6:14"/>किनकि याहवेह सेनाहरूका परमेश्‍वर घोषणा गर्नुहुन्छ, “हे इस्राएल, म एउटा देशलाई तिमीहरूका विरुद्धमा उचाल्नेछु; त्यसले लेबो-हमातदेखि अराबाको बेँसीसम्मै तिमीहरूमाथि अत्याचार गर्नेछ।”<verse eid="AMO 6:14"/></para>
<chapter eid="AMO 6"/>
<chapter number="7" style="c" sid="AMO 7"/>
<para style="p"><verse number="1" style="v" sid="AMO 7:1"/>प्रभु याहवेहले मलाई यही नै देखाउनुभयो: राजाका भागको कटनी भइसकेपछि र पछिल्‍लो बाली उम्रँदै गर्दा उहाँले सलहहरूका बथान तयार पार्दै हुनुहुन्थ्यो।<verse eid="AMO 7:1"/></para>
<para style="p"><verse number="2" style="v" sid="AMO 7:2"/>जब तिनीहरूले जमिनलाई सखाप पारे, तब मैले भनेँ, “प्रभु याहवेह, क्षमा गर्नुहोस्! कसरी याकोब बाँच्न सक्छ? त्यो त साह्रै सानो छ!”<verse eid="AMO 7:2"/></para>
<para style="p"><verse number="3" style="v" sid="AMO 7:3"/>यसकारण याहवेहले आफ्नो मन परिवर्तन गर्नुभयो। याहवेहले भन्‍नुभयो, “यस्तो हुनेछैन।”<verse eid="AMO 7:3"/></para>
<para style="p"><verse number="4" style="v" sid="AMO 7:4"/>प्रभु याहवेहले मलाई यो देखाउनुभयो: प्रभु याहवेहले आगोद्वारा न्याय गर्न बोलाउँदैहुनुहुन्थ्यो; त्यसले विशाल समुद्रलाई सुकाइदियो र जमिनलाई भस्म पारिदियो।<verse eid="AMO 7:4"/></para>
<para style="p"><verse number="5" style="v" sid="AMO 7:5"/>त्यसपछि मैले कराएर भनेँ, “प्रभु याहवेह, म तपाईंलाई बिन्ती गर्छु, रोक्नुहोस्! कसरी याकोब बाँच्न सक्छ र? त्यो त साह्रै सानो छ।”<verse eid="AMO 7:5"/></para>
<para style="p"><verse number="6" style="v" sid="AMO 7:6"/>यसकारण याहवेहले आफ्नो मन परिवर्तन गर्नुभयो। प्रभु याहवेहले भन्‍नुभयो, “यस्तो हुनेछैन।”<verse eid="AMO 7:6"/></para>
<para style="p"><verse number="7" style="v" sid="AMO 7:7"/>उहाँले फेरि मलाई यस्तो देखाउनुभयो: प्रभु नाप्‍ने टाँगोले सीधा नापेर बनाएको पर्खालको छेउमा आफ्नो हातमा एउटा नाप्‍ने साहुल लिएर खडा हुनुभएको थियो।<verse eid="AMO 7:7"/></para>
<para style="p"><verse number="8" style="v" sid="AMO 7:8"/>अनि याहवेहले मलाई सोध्नुभयो, “आमोस, तँ के देख्दैछस्?” मैले जवाफ दिए, “एउटा नाप्‍ने साहुल देख्दैछु।” त्यसपछि प्रभुले भन्‍नुभयो, “हेर, म मेरा मानिस इस्राएलीहरूका बीचमा एउटा साहुल प्रयोग गर्दैछु; अब म तिनीहरूलाई छोडनेछैनँ।”<verse eid="AMO 7:8"/></para>
<para style="p"><verse number="9" style="v" sid="AMO 7:9"/>“इसहाकका अल्गा-अल्गा ठाउँहरू सर्वनाश हुनेछन्; र इस्राएलका पवित्रस्थानहरू ध्वस्त हुनेछन्; म यारोबामका घरानाको विरुद्धमा मेरो तरवार लिएर खडा हुनेछु।”<verse eid="AMO 7:9"/></para>
<para style="p"><verse number="10" style="v" sid="AMO 7:10"/>त्यसपछि बेथेलका पुजारी अमस्याहले इस्राएलका राजा यारोबामलाई एउटा सन्देश पठाए: “आमोसले इस्राएलका घरानाको बीचमा तपाईंको विरुद्धमा एउटा षड्यन्त्र रच्दैछ। देशले तिनका सबै कुराहरू सहन सक्दैन।<verse eid="AMO 7:10"/></para>
<para style="p"><verse number="11" style="v" sid="AMO 7:11"/>किनकि आमोसले यसो भनिरहेका छन्: “यारोबाम तरवारद्वारा मारिनेछ; र इस्राएल निश्‍चय नै तिनीहरूका स्वदेशबाट टाढा निर्वासनमा जानेछ।”<verse eid="AMO 7:11"/></para>
<para style="p"><verse number="12" style="v" sid="AMO 7:12"/>त्यसपछि अमस्याहले आमोसलाई भने, “हे दर्शी, यहाँबाट निस्किहाल! यहूदाको देशमा फर्केर जाऊ। त्यहीँ नै आफ्नो कमाइको रोटी खाऊ, र भविष्यवाणी गर्ने काम गर।<verse eid="AMO 7:12"/></para>
<para style="p"><verse number="13" style="v" sid="AMO 7:13"/>अब उसो बेथेलमा भविष्यवाणी नगर; किनकि यो राजाको पवित्रस्थान हो, र राज्यको मन्दिर हो।”<verse eid="AMO 7:13"/></para>
<para style="p"><verse number="14" style="v" sid="AMO 7:14"/>आमोसले अमस्याहलाई जवाफ दिए, “म अगमवक्ता थिइनँ, न त अगमवक्ताको छोरा नै थिएँ, तर म त एउटा गोठालो थिएँ, र अञ्जीरका रूखहरूको हेरचाह गर्थेँ।<verse eid="AMO 7:14"/></para>
<para style="p"><verse number="15" style="v" sid="AMO 7:15"/>तर याहवेहले मलाई भेडाहरू चराउनबाट बोलाउनुभयो र भन्‍नुभयो, ‘जा, मेरा मानिस इस्राएललाई अगमवाणी गर्।’<verse eid="AMO 7:15"/></para>
<para style="p"><verse number="16" style="v" sid="AMO 7:16"/>यसकारण अब याहवेहको वचन सुन। तिमी भन्छौ, “ ‘इस्राएलको विरुद्धमा अगमवाणी नगर, र इसहाकको घरानाको विरुद्धमा प्रचार गर्न बन्द गर।’<verse eid="AMO 7:16"/></para>
<para style="p"><verse number="17" style="v" sid="AMO 7:17"/>“यसकारण याहवेह यसो भन्‍नुहुन्छ: “ ‘तिम्री पत्नी सहरमा एउटी वेश्या हुनेछे, र तिम्रा छोराछोरीहरू तरवारद्वारा काटिएर मारिनेछन्। तेरो देशलाई नापि-नापिकन विभाजन गरिनेछ; अनि तँ आफैँचाहिँ मूर्तिपूजकको देशमा मर्नेछस्। अनि इस्राएलचाहिँ निश्‍चय नै आफ्नो स्वदेशबाट टाढा निर्वासनमा लगिनेछ।’ ”<verse eid="AMO 7:17"/></para>
<chapter eid="AMO 7"/>
<chapter number="8" style="c" sid="AMO 8"/>
<para style="p"><verse number="1" style="v" sid="AMO 8:1"/>प्रभु याहवेहले मलाई यस्तो देखाउनुभयो: पाकेका फलको एउटा डालो।<verse eid="AMO 8:1"/></para>
<para style="p"><verse number="2" style="v" sid="AMO 8:2"/>उहाँले मलाई सोध्नुभयो, “आमोस, तँ के देख्दैछस्?” मैले जवाफ दिए, “पाकेको फलको एउटा डालो।” त्यसपछि याहवेहले मलाई भन्‍नुभयो, “मेरा मानिस इस्राएलीहरूको समय पूरा भएको छ; म तिनीहरूलाई अब उसो छोड्नेछैनँ।”<verse eid="AMO 8:2"/></para>
<para style="p"><verse number="3" style="v" sid="AMO 8:3"/>प्रभु याहवेहले घोषणा गर्नुहुन्छ, “त्यस दिन मन्दिरका गीतहरू विलापमा परिवर्तन हुनेछन्। जताततै लाशका थुप्रा हुनेछन्! सन्‍नाटा हुनेछ!”<verse eid="AMO 8:3"/></para>
<para style="p"><verse number="4" style="v" sid="AMO 8:4"/>खाँचोमा परेकाहरूलाई कुल्चनेहरू, हे देशका गरिबहरूलाई त्याग्नेहरू हो, यो कुरा सुन।<verse eid="AMO 8:4"/></para>
<para style="p"><verse number="5" style="v" sid="AMO 8:5"/>तिमीहरू यसो भन्छौ, “औँसीको दिन कहिले बित्छ र हामी अन्‍न बेच्न सक्छौँ; अनि शब्बाथ कहिले समाप्‍त हुन्छ र हामी गहुँ बेच्न सक्छौँ?” अर्थात् नापतौलमा ठगेर, मूल्य बढाएर र छली ढक तराजु चलाएर ठग्न सक्छौँ;<verse eid="AMO 8:5"/></para>
<para style="p"><verse number="6" style="v" sid="AMO 8:6"/>गरिबलाई चाँदीले, र खाँचोमा परेकालाई एक जोडी जुत्तामा किनेर कसिङ्गर सरहको गहुँ बेच्न सक्छौँ।<verse eid="AMO 8:6"/></para>
<para style="p"><verse number="7" style="v" sid="AMO 8:7"/>याहवेह आफैँले याकोबको घमण्डको शपथ खानुभएको छ: “म तिनीहरूले गरेका हरेक कुराहरूलाई बिर्सनेछैनँ।<verse eid="AMO 8:7"/></para>
<para style="p"><verse number="8" style="v" sid="AMO 8:8"/>“के यसको निम्ति देश काम्दैन र? अनि त्यहाँ बस्‍ने सबैले विलाप गर्दैनन् र? सारा देश नील नदीझैँ उठ्नेछ; इजिप्टको नदीझैँ यो उर्लनेछ र घट्नेछ।”<verse eid="AMO 8:8"/></para>
<para style="p"><verse number="9" style="v" sid="AMO 8:9"/>प्रभु याहवेहले घोषणा गर्नुहुन्छ, “त्यस दिन, “म सूर्यलाई मध्यदिनमा नै अस्ताइदिनेछु, र दिनको उज्यालोमा नै पृथ्वीलाई अन्धकार तुल्याइदिनेछु।<verse eid="AMO 8:9"/></para>
<para style="p"><verse number="10" style="v" sid="AMO 8:10"/>म तिमीहरूका धार्मिक चाडहरूलाई रुवाबासीमा र तिमीहरूका सबै गीतहरू विलापमा परिवर्तन गरिदिनेछु। म तिमीहरू सबैलाई भाङ्ग्राको कपडा पहिरन लगाउनेछु, र तिमीहरूका कपाल खौरन लगाउनेछु। म त्यस समयलाई एउटै छोराको निम्ति शोक गरेझैँ बनाइदिनेछु, र त्यस दिनको अन्त्य सारै तितो हुनेछ।”<verse eid="AMO 8:10"/></para>
<para style="p"><verse number="11" style="v" sid="AMO 8:11"/>प्रभु याहवेहले घोषणा गर्नुहुन्छ, “ती दिनहरू आउँदैछन्, जब म देशमा अनिकाल पठाउनेछु; तब अन्‍न अथवा पानीको तिर्खाको अनिकाल होइन, तर याहवेहको वचन सुन्‍ने तिर्सनाको अनिकाल हुनेछ।<verse eid="AMO 8:11"/></para>
<para style="p"><verse number="12" style="v" sid="AMO 8:12"/>याहवेहको वचनको खोजी गर्दै मानिसहरू, एक समुद्रदेखि अर्को समुद्रसम्म भौँतारिँदै हिँड्नेछन्; अनि उत्तरदेखि पूर्वसम्म घुमिहिँड्नेछन्, तर तिनीहरूले भेट्टाउनेछैनन्।”<verse eid="AMO 8:12"/></para>
<para style="p"><verse number="13" style="v" sid="AMO 8:13"/>त्यस दिन, “सुन्दरी युवतीहरू र बलिया युवाहरू तिर्खाले मूर्च्छा पर्नेछन्।<verse eid="AMO 8:13"/></para>
<para style="p"><verse number="14" style="v" sid="AMO 8:14"/>सामरियाको पापको शपथ खानेहरूले यसो भन्छन्, ‘तिम्रो देवता दानको जीवनको शपथ,’ ‘बेर्शेबाको देवताको जीवनको शपथ,’ तिनीहरू सबै ढल्नेछन्, फेरि कहिल्यै उठ्न सक्नेछैनन्।”<verse eid="AMO 8:14"/></para>
<chapter eid="AMO 8"/>
<chapter number="9" style="c" sid="AMO 9"/>
<para style="p"><verse number="1" style="v" sid="AMO 9:1"/>मैले प्रभुलाई वेदीको छेउमा उभिरहनुभएको देखेँ; अनि उहाँले भन्‍नुभयो: “खम्बाका टुप्पाहरूमा हिर्का, ताकि सँघारहरू हल्‍लिऊन्। सबै मानिसहरूका टाउकोमाथि ती ढालिऊन्; बाँकी बचेकाहरूलाई म तरवारले मार्नेछु। एकै जना पनि भाग्न पाउनेछैन; एउटै पनि उम्कन पाउनेछैन।<verse eid="AMO 9:1"/></para>
<para style="p"><verse number="2" style="v" sid="AMO 9:2"/>तिनीहरू पातालको गहिराइसम्म गए तापनि मेरो हातले तिनीहरूलाई त्यहाँबाट निकाल्नेछ। तिनीहरू माथि स्वर्गमा उक्ले तापनि म तिनीहरूलाई तल झार्नेछु।<verse eid="AMO 9:2"/></para>
<para style="p"><verse number="3" style="v" sid="AMO 9:3"/>तिनीहरू कर्मेलको टाकुरामा लुके तापनि त्यहाँ म तिनीहरूलाई खोज्नेछु र पक्रिनेछु। तिनीहरू मेरो दृष्‍टिबाट समुद्रको पीँधमा लुके तापनि त्यहाँ म तिनीहरूलाई डस्‍न सर्पहरूलाई आज्ञा दिनेछु।<verse eid="AMO 9:3"/></para>
<para style="p"><verse number="4" style="v" sid="AMO 9:4"/>तिनीहरूका शत्रुहरूले तिनीहरूलाई निर्वासनमा लगे तापनि त्यहाँ म तिनीहरूलाई मार्न तरवारलाई आज्ञा दिनेछु। “म मेरो नजर तिनीहरूमाथि राख्नेछु, भलाइको निम्ति होइन, तर खराबीको निम्ति।”<verse eid="AMO 9:4"/></para>
<para style="p"><verse number="5" style="v" sid="AMO 9:5"/>प्रभु, सेनाहरूका याहवेह, उहाँ जसले पृथ्वीलाई छुनुहुन्छ, र त्यो पग्लन्छ; अनि त्यहाँ बस्‍नेहरू सबै विलाप गर्छन्; सारा देश नील नदीझैँ माथि उठ्नेछ, त्यसपछि इजिप्ट नदीझैँ डुब्नेछ;<verse eid="AMO 9:5"/></para>
<para style="p"><verse number="6" style="v" sid="AMO 9:6"/>उहाँले आफ्नो भव्य दरबार आकाशमा बनाउनुहुन्छ, र यसको जग पृथ्वीमा बसाल्नुहुन्छ; उहाँ जसले समुद्रको पानीलाई बोलाउनुहुन्छ, र ती पानीलाई जमिनको सतहमाथि खन्याउनुहुन्छ, उहाँको नाम याहवेह हो।<verse eid="AMO 9:6"/></para>
<para style="p"><verse number="7" style="v" sid="AMO 9:7"/>“के तिमी इस्राएलीहरू मेरा निम्ति कूशका सन्तानजस्ता छैनौ र?” याहवेहले घोषणा गर्नुहुन्छ। “के मैले इस्राएललाई इजिप्टबाट, पलिश्तीहरूलाई कप्‍तोरबाट, र अरामीहरूलाई कीरबाट निकालेर ल्याएको होइन?<verse eid="AMO 9:7"/></para>
<para style="p"><verse number="8" style="v" sid="AMO 9:8"/>“निश्‍चय नै प्रभु याहवेहको दृष्‍टि यो दुष्‍ट राज्यमाथि छ। म यसलाई पृथ्वीको सतहबाट ध्वस्त गर्नेछु। तापनि म याकोबको घरानालाई सम्पूर्ण रूपले नाश गर्नेछैनँ,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="AMO 9:8"/></para>
<para style="p"><verse number="9" style="v" sid="AMO 9:9"/>“किनकि म आज्ञा दिनेछु, र इस्राएलको घरानालाई सबै राष्ट्रहरूका बीचमा यसरी हल्‍लाउनेछु, जसरी चाल्नीमा अन्‍नलाई चालिन्छ; तर एउटा ढुङ्गाको टुक्रा पनि भुइँमा खस्‍नेछैन।<verse eid="AMO 9:9"/></para>
<para style="p"><verse number="10" style="v" sid="AMO 9:10"/>मेरा मानिसहरूका बीचमा भएका सबै पापीहरू तरवारले मारिनेछन्; तिनीहरू सबै जना, जसले यसो भन्छन्, ‘विपत्ति हामी नजिक आउनेछैन, न त विपत्तिले हामीलाई छुने नै छ।’<verse eid="AMO 9:10"/></para>
<para style="p"><verse number="11" style="v" sid="AMO 9:11"/>“त्यस दिन, “म दावीदको भत्केको पाललाई फेरि स्थापित गर्नेछु, अर्थात् म यसका भत्केका पर्खालहरू मर्मत गर्नेछु; अनि यसका भग्नावशेषहरूलाई फेरि निर्माण गर्नेछु, अर्थात् योजस्तो पहिले थियो, त्यस्तै फेरि निर्माण गर्नेछु,<verse eid="AMO 9:11"/></para>
<para style="p"><verse number="12" style="v" sid="AMO 9:12"/>ताकि तिनीहरूले एदोमका बाँकी बचेकाहरूलाई र मेरो नाम लिने सबै राष्ट्रहरूमाथि अधिकार गर्न सकून्,” याहवेह घोषणा गर्नुहुन्छ, जसले यी कुराहरू गर्न सक्नुहुन्छ।<verse eid="AMO 9:12"/></para>
<para style="p"><verse number="13" style="v" sid="AMO 9:13"/>याहवेह घोषणा गर्नुहुन्छ, ती दिनहरू आउँदैछन्, “जब जोत्नेले कटनी गर्नेलाई उछिन्‍नेछ, र बिउ छर्नेले दाख पेल्नेलाई उछिन्‍नेछ। नयाँ दाखमद्य पर्वतहरूबाट चुहुनेछन्, र सबै डाँडाहरूबाट ती बग्नेछन्।<verse eid="AMO 9:13"/></para>
<para style="p"><verse number="14" style="v" sid="AMO 9:14"/>म मेरो जाति इस्राएललाई निर्वासनबाट फर्काएर ल्याउनेछु। “तिनीहरूले भत्केका सहरहरू फेरि पुनर्निर्माण गर्नेछन्, र ती सहरहरूमा बसोबास गर्नेछन्। तिनीहरूले दाखबारीहरू लगाउनेछन् र तिनीहरूका दाखमद्य पिउनेछन्; तिनीहरूले बगैँचाहरू बनाउनेछन् र त्यहाँका फलहरू खानेछन्।<verse eid="AMO 9:14"/></para>
<para style="p"><verse number="15" style="v" sid="AMO 9:15"/>म इस्राएललाई तिनीहरूको आफ्नै देशमा बसाल्नेछु, मैले तिनीहरूलाई दिएको देशबाट फेरि कहिल्यै पनि नउखेलिने गरी बसाल्नेछु,” याहवेह तिमीहरूका परमेश्‍वर यसो भन्‍नुहुन्छ।<verse eid="AMO 9:15"/></para>
<chapter eid="AMO 9"/>
</usx>