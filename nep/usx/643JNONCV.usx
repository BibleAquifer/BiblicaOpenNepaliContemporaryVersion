<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="3JN" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">3 यूहन्‍ना</para>
<para style="toc1">3 यूहन्‍ना</para>
<para style="toc2">3 यूहन्‍ना</para>
<para style="mt1">3 यूहन्‍ना</para>
<chapter number="1" style="c" sid="3JN 1"/>
<para style="p"><verse number="1" style="v" sid="3JN 1:1"/>मण्डलीका प्रधानबाट, मेरा प्रिय मित्र गायस, जसलाई म सत्यतामा प्रेम गर्दछु।<verse eid="3JN 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="3JN 1:2"/>प्रिय मित्र, म प्रार्थना गर्दछु, जसरी तिम्रो आत्माको उन्‍नति भएको छ, त्यसरी नै तिमी स्वस्थ बस र सबै कुरामा तिमीलाई भलो होस्।<verse eid="3JN 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="3JN 1:3"/>केही दाजुभाइ-दिदीबहिनीहरू आएर सत्यताको विषयमा तिम्रो विश्‍वासयोग्यता र तिमी कसरी निरन्तर हिँडिरहेका छौ भन्‍ने विषयमा साक्षी दिएकोले म धेरै आनन्दित भएको छु।<verse eid="3JN 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="3JN 1:4"/>मेरा सन्तानहरू सत्यतामा चलिरहेका छन् भन्‍ने कुरा सुन्‍न पाउनुभन्दा ठूलो आनन्द मेरो लागि अरू केही हुँदैन।<verse eid="3JN 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="3JN 1:5"/>हे प्रिय मित्र, ती दाजुभाइ-दिदीबहिनीहरू तिम्रा लागि परदेशी भए तापनि तिमीले जे गर्दैछौ, त्यसमा तिमी विश्‍वासयोग्य छौ।<verse eid="3JN 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="3JN 1:6"/>तिनीहरूले तिम्रो प्रेमको विषयमा मण्डलीलाई साक्षी दिएका छन्। परमेश्‍वरलाई मनपर्ने रीतिले तिनीहरूलाई आफ्ना यात्रामा पठाऊ।<verse eid="3JN 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="3JN 1:7"/>तिनीहरू उहाँकै नामको निम्ति निस्केका हुन्, र गैरयहूदीहरूबाट कुनै सहायता लिएनन्।<verse eid="3JN 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="3JN 1:8"/>यसकारण सत्यताका निम्ति सँगै मिलेर काम गर्न सकौँ भन्‍नका लागि हामीले यस्ता मानिसहरूलाई सेवा सत्कार गर्नैपर्छ।<verse eid="3JN 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="3JN 1:9"/>मैले मण्डलीलाई केही कुरा लेखेको थिएँ, तर तिमीहरूमा ठूलो हुन खोज्ने डियोत्रिफसले हामीलाई स्वीकार गर्दैन।<verse eid="3JN 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="3JN 1:10"/>यसकारण म आएँ भने त्यसले गरिरहेका कामहरूबारे कुरा उठाउनेछु। त्यसले हाम्रा विरुद्धमा खराब कुराहरू बक्दै हिँड्छ। त्यतिमा पनि सन्तुष्‍ट नभएर त्यसले अरू विश्‍वासीहरूलाई स्वीकार गर्दैन र स्वीकार गर्न चाहनेहरूलाई पनि त्यसले रोक्छ, र तिनीहरूलाई मण्डलीबाट बाहिर निकालिदिन्छ।<verse eid="3JN 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="3JN 1:11"/>हे प्रिय मित्र, खराबीको होइन, तर असल कुराको अनुकरण गर। जसले असल कुरा गर्दछ, त्यो परमेश्‍वरबाटको हो। जसले खराबी गर्दछ, त्यसले परमेश्‍वरलाई देखेको छैन।<verse eid="3JN 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="3JN 1:12"/>डेमेत्रियसका विषयमा सबैले असल साक्षी दिएका छन्, र सत्यता स्वयम्‌ले पनि त्यही साक्षी दिन्छ। हामी पनि तिनको विषयमा असल बोल्छौँ, र हाम्रो साक्षी सत्य छ भनी तिमी जान्दछौ।<verse eid="3JN 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="3JN 1:13"/>मैले तिमीलाई लेख्नुपर्ने कुराहरू धेरै छन्, तर म कलम र मसीले ती लेख्न चाहन्‍नँ।<verse eid="3JN 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="3JN 1:14"/>म तिमीलाई चाँडै नै भेट्ने आशा गर्दछु, तब हामी आमने-सामने भएर कुरा गर्नेछौँ।<verse eid="3JN 1:14"/></para>
<para style="p"><verse number="15" style="v" sid="3JN 1:15"/>तिमीलाई शान्ति होस्! यहाँ भएका मित्रहरूले आफ्नो अभिवादन पठाएका छन्। त्यहाँ भएका मित्रहरूलाई नाम लिएर अभिवादन भनिदेऊ।<verse eid="3JN 1:15"/></para>
<chapter eid="3JN 1"/>
</usx>