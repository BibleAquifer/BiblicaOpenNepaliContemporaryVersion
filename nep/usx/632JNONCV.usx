<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="2JN" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">2 यूहन्‍ना</para>
<para style="toc1">2 यूहन्‍ना</para>
<para style="toc2">2 यूहन्‍ना</para>
<para style="mt1">2 यूहन्‍ना</para>
<chapter number="1" style="c" sid="2JN 1"/>
<para style="p"><verse number="1" style="v" sid="2JN 1:1"/>मण्डलीका प्रधानबाट, परमेश्‍वरका जनहरूद्वारा चुनिएकी स्त्री र तिनका छोराछोरी, जसलाई म सत्यतामा प्रेम गर्छु, र मैले मात्र होइन, तर ती सबैले, जसले सत्यलाई चिनेका छन्।<verse eid="2JN 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="2JN 1:2"/>सत्यताको कारणले, जुन हामीमा रहन्छ, र सदासर्वदाका लागि हामीसँग रहिरहनेछ:<verse eid="2JN 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="2JN 1:3"/>परमेश्‍वर पिता र येशू ख्रीष्‍टबाट, जो पिताको पुत्र हुनुहुन्छ; अनुग्रह, कृपा र शान्तिसँगै सत्य तथा प्रेम हामीहरूसित रहून्!<verse eid="2JN 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="2JN 1:4"/>पिताले हामीलाई जस्तो आज्ञा दिनुभयो, तिम्रा केही छोराछोरीहरू ठिक त्यसै गरी सत्यतामा चलिरहेका छन् भनी भेट्टाएकोमा म धेरै आनन्दित भएको छु।<verse eid="2JN 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="2JN 1:5"/>हे प्रिय स्त्री, म तिम्रा लागि नयाँ आज्ञा लेख्दिनँ, तर जो हामीसँग सुरुदेखि नै छ, त्यही लेख्दैछु। म बिन्ती गर्दछु, हामी एक-अर्कालाई प्रेम गरौँ।<verse eid="2JN 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="2JN 1:6"/>हामीले उहाँका आज्ञाहरू पालन गर्दै जिउनु नै प्रेम हो। जसरी तिमीहरूले सुरुदेखि सुनेका छौ, त्यसरी नै तिमीहरू प्रेममा हिँड्नुपर्छ, यही नै उहाँको आज्ञा हो।<verse eid="2JN 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="2JN 1:7"/>किनकि म तिमीहरूलाई भन्दछु, धेरै जना बहकाउनेहरू संसारमा निस्किआएका छन्, जसले येशू ख्रीष्‍ट शरीरमा आउनुभएको हो भनी स्वीकार गर्दैनन्। यस्ता कुनै पनि व्यक्ति छली र ख्रीष्‍ट विरोधी हो।<verse eid="2JN 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="2JN 1:8"/>होसियार बस, जुन कुराको निम्ति हामीहरूले काम गरेका छौँ, त्यो गुमाउने होइन, तर तिमीहरूले पूरा इनाम पाउन सक।<verse eid="2JN 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="2JN 1:9"/>हरेक जसले बाटो बिराएर अन्‍यत्र जाँदछ, त्यो ख्रीष्‍टको शिक्षामा स्थिर रहँदैन, त्यससँग परमेश्‍वर हुनुहुन्‍न; ख्रीष्‍टको शिक्षामा रहिरहने सबैसँग पिता र पुत्र दुवै हुनुहुन्छ।<verse eid="2JN 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="2JN 1:10"/>यदि कोही तिमीहरूकहाँ आउँछ र यही शिक्षा ल्याउँदैन भने त्यसलाई घरमा नलैजाओ, न त त्यसलाई स्वागत नै गर।<verse eid="2JN 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="2JN 1:11"/>जसले त्यसलाई स्वागत गर्छ, ऊ त्यसका दुष्‍ट कामहरूमा सहभागी बनेको हुन्छ।<verse eid="2JN 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="2JN 1:12"/>मैले तिमीहरूलाई लेख्नुपर्ने कुरा धेरै छन्, तर कागज र मसीले ती म लेख्न चाहन्‍नँ। तर तिमीहरूकहाँ आएर आमने-सामने भएर कुरा गर्ने म आशा राख्छु, जसबाट हाम्रो आनन्द पूर्ण हुन सकोस्।<verse eid="2JN 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="2JN 1:13"/>परमेश्‍वरद्वारा चुनिएकी तिम्री बहिनीका छोराछोरीहरूले तिमीलाई अभिवादन पठाएका छन्।<verse eid="2JN 1:13"/></para>
<chapter eid="2JN 1"/>
</usx>