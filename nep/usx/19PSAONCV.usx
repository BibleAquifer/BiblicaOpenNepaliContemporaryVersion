<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="PSA" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">भजनसंग्रह</para>
<para style="toc1">भजनसंग्रह</para>
<para style="toc2">भजनसंग्रह</para>
<para style="mt1">भजनसंग्रह</para>
<chapter number="1" style="c" sid="PSA 1"/>
<para style="p"><verse number="1" style="v" sid="PSA 1:1"/>धन्य हुन् तिनीहरू, जो दुष्‍टहरूको सल्‍लाहमा हिँड्दैनन्, जो पापीहरूको मार्गमा खडा हुँदैनन्, जो गिल्‍ला गर्नेहरूको सङ्गतमा बस्दैनन्।<verse eid="PSA 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 1:2"/>तर तिनीहरू याहवेहको व्यवस्थामा नै प्रसन्‍न रहन्छन्, र दिनरात उहाँकै व्यवस्थामा नै मनन गर्छन्।<verse eid="PSA 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 1:3"/>तिनीहरू नदीको किनारमा रोपेको रूखजस्तै हुन्छन्, जसले आफ्नो ऋतुमा फल दिन्छ; र जसको पात कहिल्यै ओइलाउँदैन; तिनीहरूले जे काम गर्छन्, त्यसमा सफल हुन्छन्।<verse eid="PSA 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 1:4"/>दुष्‍टहरू त्यस्ता हुँदैनन्; तर तिनीहरूचाहिँ बतासले उडाइलैजाने भुसजस्तै हुन्छन्।<verse eid="PSA 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 1:5"/>यसकारण दुष्‍टहरू न्यायमा खडा रहनेछैनन्, न त धर्मीहरूको सभामा पापीहरूले स्थान पाउनेछन्।<verse eid="PSA 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 1:6"/>किनकि याहवेहले धर्मीहरूको मार्गको रक्षा गर्नुहुन्छ; तर दुष्‍टहरूको मार्गले विनाशमा पुर्‍याउँछ।<verse eid="PSA 1:6"/></para>
<chapter eid="PSA 1"/>
<chapter number="2" style="c" sid="PSA 2"/>
<para style="p"><verse number="1" style="v" sid="PSA 2:1"/>राष्ट्रहरू किन षड्यन्त्र रच्दछन्, अनि जाति-जातिहरू किन व्यर्थमा जाल रच्छन्?<verse eid="PSA 2:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 2:2"/>याहवेह र उहाँका अभिषिक्त जनका विरुद्धमा पृथ्वीका राजाहरू खडा हुन्छन्, र शासकहरू एकजुट भएर भेला भएका छन्।<verse eid="PSA 2:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 2:3"/>तिनीहरू यसो भन्छन्, “आओ, हामी तिनीहरूका साङ्लाहरू छिनालौँ, र तिनीहरूका बन्धनहरू फुकालौँ।”<verse eid="PSA 2:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 2:4"/>स्वर्गमा विराजमान हुनुहुनेचाहिँ हाँस्‍नुहुन्छ; प्रभुले तिनीहरूको उपहास गर्नुहुन्छ।<verse eid="PSA 2:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 2:5"/>आफ्नो क्रोधमा उहाँले तिनीहरूलाई हप्काउनुहुन्छ, र आफ्ना क्रोधमा तिनीहरूलाई यसो भन्दै भयभीत पार्नुहुन्छ,<verse eid="PSA 2:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 2:6"/>“मैले मेरो राजालाई नियुक्त गरेको छु, मेरो पवित्र सियोन पर्वतमा”, प्रभु घोषणा गर्नुहुन्छ।<verse eid="PSA 2:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 2:7"/>म याहवेहको उर्दी घोषणा गर्नेछु: उहाँले मलाई आज्ञा गर्नुभयो, “तिमी मेरा पुत्र हौ; आज म तिम्रो पिता भएको छु।<verse eid="PSA 2:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 2:8"/>मसँग माग र म राष्ट्रहरूलाई तिम्रो उत्तराधिकार तुल्याइदिनेछु, र पृथ्वीको अन्तसम्म तिम्रो निज सम्पत्ति तुल्याइदिनेछु।<verse eid="PSA 2:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 2:9"/>तिमीले फलामको राजदण्डले तिनीहरूलाई पिस्‍नेछौ, कुमालेको भाँडाझैँ तिनीहरूलाई टुक्रा-टुक्रा पार्नेछौ।”<verse eid="PSA 2:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 2:10"/>यसकारण हे राजाहरू हो, बुद्धिमान् होओ; पृथ्वीका शासकहरू हो, सचेत होओ!<verse eid="PSA 2:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 2:11"/>भयसाथ याहवेहको सेवा गर, र कम्पनसाथ उहाँको आनन्द मनाओ।<verse eid="PSA 2:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 2:12"/>उहाँको पुत्रलाई सम्मान गर, नत्रता उहाँ क्रोधित हुनुहुनेछ, र तिमीहरूको व्यवहारले विनाशमा पुर्‍याउला; किनकि उहाँको क्रोध चाँडै दन्कन्छ। धन्य हुन् तिनीहरू सबै, जो उहाँको शरणमा पर्दछन्।<verse eid="PSA 2:12"/></para>
<chapter eid="PSA 2"/>
<chapter number="3" style="c" sid="PSA 3"/>
<para style="p"><verse number="1" style="v" sid="PSA 3:1"/>दावीदको भजन; आफ्नो छोरा अब्शालोमदेखि भाग्दा उनले लेखेको भजन। हे याहवेह, मेरा विरोधीहरू कति धेरै छन्! मेरो विरुद्धमा कति धेरै जना खडा भएका छन्!<verse eid="PSA 3:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 3:2"/>धेरैले मेरो विषयमा यसो भन्दैछन्, “परमेश्‍वरले त्यसलाई सहायता गर्नहुनेछैन।” सेला<verse eid="PSA 3:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 3:3"/>तर हे याहवेह, तपाईं मेरो चारैतिर ढाल हुनुहुन्छ; तपाईं मेरो गौरव र मेरो शिर उच्‍च पारिदिने हुनुहुन्छ।<verse eid="PSA 3:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 3:4"/>म ठूलो सोरमा याहवेहलाई पुकार गर्दछु, र उहाँले आफ्नो पवित्र पर्वतबाट मलाई जवाफ दिनुहुन्छ। सेला<verse eid="PSA 3:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 3:5"/>म पल्टन्छु र निदाउँछु; म फेरि उठ्छु; किनकि याहवेहले नै मलाई सम्हाल्नुहुन्छ।<verse eid="PSA 3:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 3:6"/>मेरो विरुद्धमा मेरा वरिपरि घेरा हाल्ने दसौँ हजार शत्रुहरूसँग पनि म डराउनेछैनँ।<verse eid="PSA 3:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 3:7"/>हे याहवेह, उठ्नुहोस्; हे मेरा परमेश्‍वर, मलाई उद्धार गर्नुहोस्! मेरा सबै शत्रुहरूका गालामा चड्काउनुहोस्; दुष्‍टहरूका दाँत भाँचिदिनुहोस्।<verse eid="PSA 3:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 3:8"/>याहवेहबाट छुटकारा आउँछ, तपाईंको आशिष् तपाईंका प्रजामाथि रहोस्। सेला<verse eid="PSA 3:8"/></para>
<chapter eid="PSA 3"/>
<chapter number="4" style="c" sid="PSA 4"/>
<para style="p"><verse number="1" style="v" sid="PSA 4:1"/>सङ्गीत निर्देशकको निम्ति तारवाद्यको साथ, दावीदको भजन। हे मेरा धार्मिक परमेश्‍वर, मैले पुकार गर्दा मलाई जवाफ दिनुहोस्। मेरो सङ्कष्‍टबाट मलाई मुक्त गर्नुहोस्; ममाथि दया गर्नुहोस् र मेरो प्रार्थना सुन्‍नुहोस्।<verse eid="PSA 4:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 4:2"/>हे मानिसहरू हो, तिमीहरू मेरो महिमालाई कहिलेसम्म शर्ममा परिवर्तन गरिरहन्छौ? तिमीहरू कहिलेसम्म व्यर्थका कुराहरू मन पराउँछौ र असत्यको पछि लागिरहन्छौ? सेला<verse eid="PSA 4:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 4:3"/>याद राख: याहवेहले आफ्नो निम्ति विश्‍वासयोग्य सेवकहरू छुट्ट्याउनुभएको छ; मैले पुकार गर्दा याहवेहले सुन्‍नुहुन्छ।<verse eid="PSA 4:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 4:4"/>रिसमा पर्दा पाप नगर। जब तिमी ओछ्यानमा पल्टन्छौँ, आफ्नो हृदयभित्र मनन गर, र शान्त रहो। सेला<verse eid="PSA 4:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 4:5"/>धार्मिकताका बलिदानहरू चढाओ, र याहवेहमाथि भरोसा राख।<verse eid="PSA 4:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 4:6"/>धेरैले सोध्दछन्, “हामीलाई कसले असल कुरा देखाउन सक्ला?” हे याहवेह, तपाईंको मुहारको ज्योति हामीमाथि चम्काउनुहोस्!<verse eid="PSA 4:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 4:7"/>तपाईंले तिनीहरूका कटनी र नयाँ दाखमद्यको प्रशस्ततामा हुने, आनन्दभन्दा बढी आनन्दले मेरो हृदय भरिदिनुभएको छ।<verse eid="PSA 4:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 4:8"/>म शान्तिसँग पल्टिनेछु र निदाउनेछु; किनकि हे याहवेह, तपाईंले मात्र मलाई सुरक्षित राख्नुहुन्छ।<verse eid="PSA 4:8"/></para>
<chapter eid="PSA 4"/>
<chapter number="5" style="c" sid="PSA 5"/>
<para style="p"><verse number="1" style="v" sid="PSA 5:1"/>सङ्गीत निर्देशकको निम्ति बाँसुरीसहित गाइने, दावीदको भजन। हे याहवेह, मेरा शब्दहरूमा कान लगाइदिनुहोस्; मेरो सुस्केरामा ध्यान दिनुहोस्।<verse eid="PSA 5:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 5:2"/>हे मेरा राजा, मेरा परमेश्‍वर, सहायताको निम्ति मेरो पुकार सुनिदिनुहोस्; किनकि तपाईंलाई म प्रार्थना गर्दछु।<verse eid="PSA 5:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 5:3"/>हे याहवेह, बिहानै तपाईंले मेरो सोर सुन्‍नुहुन्छ; सबेरै तपाईंको अगि मेरो बिन्ती राख्दछु, र आशामा प्रतीक्षा गर्दछु।<verse eid="PSA 5:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 5:4"/>तपाईं दुष्‍टतासँग प्रसन्‍न हुनुहुने परमेश्‍वर हुनुहुन्‍न; दुष्‍ट मानिसहरू तपाईंसँग बास गर्न सक्दैनन्।<verse eid="PSA 5:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 5:5"/>घमण्डी मानिसहरू तपाईंको सामु खडा हुन सक्दैनन्। दुष्‍ट काम गर्नेहरू सबैलाई तपाईं घृणा गर्नुहुन्छ।<verse eid="PSA 5:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 5:6"/>झूटो बोल्नेहरूलाई तपाईंले नष्‍ट पार्नुहुन्छ; रक्तपात गर्ने र छलीहरूलाई तपाईं याहवेहले घृणा गर्नुहुन्छ।<verse eid="PSA 5:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 5:7"/>तर मचाहिँ तपाईंको अचुक प्रेमद्वारा तपाईंको भवनभित्र आउनेछु; तपाईंको पवित्र मन्दिरतिर म श्रद्धासाथ दण्डवत् गर्नेछु।<verse eid="PSA 5:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 5:8"/>हे याहवेह, तपाईंको धार्मिकतामा मलाई डोर्‍याउनुहोस्; मेरा शत्रुहरूका कारण, तपाईंको मार्ग मेरो सामु सोझो पारिदिनुहोस्।<verse eid="PSA 5:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 5:9"/>तिनीहरूका मुखका एउटै शब्दमा पनि सत्यता छैन; तिनीहरूका हृदय विनाशले भरिएको छ। तिनीहरूका घोक्रो खुल्‍ला चिहानजस्तै छ; तिनीहरूका जिब्राले छलका कुरा बोल्छन्।<verse eid="PSA 5:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 5:10"/>हे परमेश्‍वर, तिनीहरूलाई दोषी ठहराउनुहोस्; तिनीहरूका आफ्नै जाल पतनको कारण होस्। तिनीहरूका अनेक अपराधको कारण तिनीहरूलाई त्यागिदिनुहोस्; किनकि तिनीहरूले तपाईंका विरुद्धमा विद्रोह गरेका छन्।<verse eid="PSA 5:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 5:11"/>तर तपाईंमा शरण लिनेहरूचाहिँ खुशी होऊन्; र तिनीहरू आनन्दले गीत गाऊन्। तपाईंले नै तिनीहरूको रक्षा गर्नुहोस्; र तपाईंको नामलाई प्रेम गर्नेहरू तपाईंमा आनन्दित होऊन्।<verse eid="PSA 5:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 5:12"/>निश्‍चय नै, हे याहवेह, तपाईंले धर्मीहरूलाई आशिष् दिनुहुन्छ; तपाईंले ढाललेझैँ, तपाईंको कृपादृष्‍टिले तिनीहरूलाई घेरिराख्नुहुन्छ।<verse eid="PSA 5:12"/></para>
<chapter eid="PSA 5"/>
<chapter number="6" style="c" sid="PSA 6"/>
<para style="p"><verse number="1" style="v" sid="PSA 6:1"/>सङ्गीत निर्देशकको निम्ति तारवाला बाजाहरूमा शिमिनिथ,* दावीदको भजन। हे याहवेह, मलाई तपाईंको रिसमा नहप्काउनुहोस्; न त तपाईंको क्रोधमा मलाई ताडना नै दिनुहोस्।<verse eid="PSA 6:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 6:2"/>हे याहवेह, ममाथि कृपा गर्नुहोस्, किनकि म दुर्बल भएको छु; हे याहवेह, मलाई निको पार्नुहोस्, किनकि मेरा हाडहरूमा घोर पीडा छ।<verse eid="PSA 6:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 6:3"/>मेरो प्राण गहिरो वेदनामा छ; कहिलेसम्म, हे याहवेह, कहिलेसम्म?<verse eid="PSA 6:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 6:4"/>हे याहवेह, मतिर फर्कनुहोस्, मेरो उद्धार गर्नुहोस्; तपाईंको अचुक प्रेमको कारण मलाई बचाउनुहोस्।<verse eid="PSA 6:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 6:5"/>मृतकहरू कसैले तपाईंको नामको स्मरण गर्दैनन्, चिहानबाट कसले तपाईंको प्रशंसा गर्छ र?<verse eid="PSA 6:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 6:6"/>मेरो पीडाले गर्दा म थाकिसकेको छु। रातभरि मेरो आँसुको बाढीले ओछ्यान तैरिन्छ। र मेरो आँसुले सिरानी डुबाउँछ।<verse eid="PSA 6:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 6:7"/>मेरा आँखाहरू शोकले गर्दा कमजोर भएका छन्; मेरा वैरीहरूका कारणले ती कमजोर भएका छन्।<verse eid="PSA 6:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 6:8"/>हे सबै दुष्‍ट काम गर्नेहरू हो, मबाट टाढा जाओ; किनकि याहवेहले मेरो रुवाइ सुन्‍नुभएको छ।<verse eid="PSA 6:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 6:9"/>याहवेहले दयाको निम्ति मेरो पुकार सुन्‍नुभएको छ; याहवेहले मेरो प्रार्थना ग्रहण गर्नुहुन्छ।<verse eid="PSA 6:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 6:10"/>मेरा सबै शत्रुहरू ज्यादै लज्जित हुनेछन् र डराउनेछन्; तिनीहरू एकै क्षणमा लज्जित भएर पछि हट्नेछन्।<verse eid="PSA 6:10"/></para>
<chapter eid="PSA 6"/>
<chapter number="7" style="c" sid="PSA 7"/>
<para style="p"><verse number="1" style="v" sid="PSA 7:1"/>बेन्यामीनी कूशको बारेमा दावीदले याहवेहको सामु गाएको शिग्गायोन।* हे याहवेह, मेरो परमेश्‍वर, म तपाईंमा नै शरण पर्दछु; मेरो खेदो गर्नेहरूबाट मलाई बचाउनुहोस् र छुटकारा दिनुहोस्,<verse eid="PSA 7:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 7:2"/>नत्रता तिनीहरूले मलाई सिंहले झैँ फहराउनेछन्; मेरो उद्धार गर्ने कोही नहुँदा तिनीहरूले मलाई टुक्रा-टुक्रा पार्नेछन्।<verse eid="PSA 7:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 7:3"/>हे याहवेह, मेरा परमेश्‍वर, यदि मैले यो गरेको छु र यदि मेरा हातबाट केही अधर्म भएको छ भने;<verse eid="PSA 7:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 7:4"/>यदि मसँग मिल्ने मित्रहरूलाई मैले खराबी गरेको छु भने; वा कारणविना मेरा शत्रुहरूलाई केही लुटेको छु भने;<verse eid="PSA 7:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 7:5"/>यदि मैले यसो गरेको भए, मेरो शत्रुहरूले मलाई खेदून् र पक्रून्; तिनीहरूले मेरो प्राणलाई धुलोमा कुल्चिऊन्, र मेरो इज्जत धुलोमा पारून्। सेला<verse eid="PSA 7:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 7:6"/>हे याहवेह, तपाईंको क्रोधमा उठ्नुहोस्; मेरा शत्रुहरूको क्रोधको विरुद्धमा खडा हुनुहोस्, हे मेरा परमेश्‍वर, उठ्नुहोस् र आफ्नो न्याय आदेश गर्नुहोस्।<verse eid="PSA 7:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 7:7"/>जाति-जातिहरू तपाईंको वरिपरि भेला होऊन्; उच्‍च सिंहासनमा विराजमान भई तिनीहरूमाथि शासन गर्नुहोस्;<verse eid="PSA 7:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 7:8"/>याहवेहले जाति-जातिहरूको न्याय गरून्। हे याहवेह, सर्वोच्‍च परमेश्‍वर मेरो धार्मिकताअनुसार, र मेरो इमानदारीताअनुसार निर्दोष प्रमाणित गर्नुहोस्।<verse eid="PSA 7:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 7:9"/>हे धार्मिक परमेश्‍वर, जसले हृदय र मन जाँच्नुहुन्छ, दुष्‍टहरूको उपद्रवको अन्त्य गर्नुहोस्, अनि धर्मीहरूको सुरक्षा गर्नुहोस्।<verse eid="PSA 7:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 7:10"/>सर्वोच्‍च परमेश्‍वर मेरो ढाल हुनुहुन्छ, जसले सोझो हृदय भएकाहरूलाई बचाउनुहुन्छ।<verse eid="PSA 7:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 7:11"/>परमेश्‍वर धार्मिक न्यायकर्ता हुनुहुन्छ, यस्तो परमेश्‍वर, जसले प्रतिदिन आफ्नो क्रोध प्रकट गर्नुहुन्छ।<verse eid="PSA 7:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 7:12"/>यदि मानिसले पश्‍चात्ताप गरेन भने, उहाँले आफ्नो तरवारमा शान लगाउनुहुनेछ; उहाँले आफ्नो धनुमा ताँदो चढाउनुहुनेछ र निसाना लगाउनुहुनेछ।<verse eid="PSA 7:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 7:13"/>उहाँले आफ्ना प्राणघातक हातहतियार तयार पार्नुभएको छ; उहाँले आफ्ना अग्निकाँडहरू तयार पार्नुभएको छ।<verse eid="PSA 7:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 7:14"/>जसले अधर्मको गर्भधारण गर्दछ, त्यसले सङ्कष्‍ट बोक्दछ र छललाई जन्म दिन्छ।<verse eid="PSA 7:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 7:15"/>जसले खनेर खाडल बनाउँछ र अरूलाई गिराउन चाहन्छ, त्यसले खनेको खाडलमा आफैँ जाकिन्छन्।<verse eid="PSA 7:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 7:16"/>त्यसले रचेका उपद्रवले आफैँलाई नै बेर्नेछ; र त्यसको अत्याचार त्यसकै टाउकोमा खनिन्छ।<verse eid="PSA 7:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 7:17"/>उहाँका धार्मिकताको कारण म याहवेहलाई धन्यवाद चढाउनेछु र सर्वोच्‍च याहवेहको नामको स्तुति गाउनेछु।<verse eid="PSA 7:17"/></para>
<chapter eid="PSA 7"/>
<chapter number="8" style="c" sid="PSA 8"/>
<para style="p"><verse number="1" style="v" sid="PSA 8:1"/>सङ्गीत निर्देशकको निम्ति गित्तीथ* मा आधारित, दावीदको भजन। हे याहवेह, हाम्रा प्रभु, सारा पृथ्वीभरि तपाईंको नाम कति प्रतापी छ! स्वर्गभन्दा उच्‍चमा तपाईंले आफ्नो महिमा स्थापित गर्नुभएको छ।<verse eid="PSA 8:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 8:2"/>तपाईंले केटाकेटीहरू र शिशुहरूका प्रशंसाबाट, आफ्ना शत्रुहरू र विरोधीहरूलाई चुप गराउनलाई शत्रुहरूका विरुद्ध बलियो किल्‍ला स्थापना गर्नुभएको छ।<verse eid="PSA 8:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 8:3"/>जब म तपाईंका औँलाहरूद्वारा बनाइएको आकाशलाई, तपाईंले स्थापित गर्नुभएका चन्द्रमा र ताराहरूमाथि विचार गर्छु,<verse eid="PSA 8:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 8:4"/>मानिस जाति के नै हो र तपाईं त्यसको वास्ता गर्नुहुन्छ? मनुष्यहरू के नै हुन् र तपाईं तिनीहरूको फ्रिक्री गर्नुहुन्छ?<verse eid="PSA 8:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 8:5"/>तपाईंले तिनीहरूलाई स्वर्गदूतहरूभन्दा केही कम बनाउनुभएको छ, र तिनीहरूलाई महिमा र आदरको मुकुट पहिर्‍याइदिनुभएको छ।<verse eid="PSA 8:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 8:6"/>तपाईंका हातका कार्यहरूमाथि तपाईंले तिनीहरूलाई शासक बनाउनुभएको छ; र तपाईंले सबै थोक तिनीहरूका पैतालामुनि राखिदिनुभएको छ:<verse eid="PSA 8:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 8:7"/>सबै भेडाबाख्रा र गाईगोरुहरू, र सबै जङ्गली पशुपक्षीहरू,<verse eid="PSA 8:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 8:8"/>आकाशका चराचुरुङ्गीहरू र समुद्रका माछाहरू र समुद्रभित्र पौडने सबै जन्तुहरू।<verse eid="PSA 8:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 8:9"/>हे याहवेह, हाम्रा प्रभु, सारा पृथ्वीभरि तपाईंको नाम कति प्रतापी छ!<verse eid="PSA 8:9"/></para>
<chapter eid="PSA 8"/>
<chapter number="9" style="c" sid="PSA 9"/>
<para style="p"><verse number="1" style="v" sid="PSA 9:1"/>सङ्गीत निर्देशकको निम्ति पुत्रको मृत्युको रागमा आधारित, दावीदको भजन। हे याहवेह, मेरो सारा हृदयले म तपाईंको प्रशंसा गर्नेछु; तपाईंका सबै अचम्मका कामहरूको वर्णन म गर्नेछु।<verse eid="PSA 9:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 9:2"/>म तपाईंमा रमाउनेछु र आनन्द मनाउनेछु; हे सर्वोच्‍च परमेश्‍वर, तपाईंको नाममा म स्तुति गाउनेछु।<verse eid="PSA 9:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 9:3"/>मेरा शत्रुहरू पिठिउँ फर्काएर भाग्छन्; तपाईंका सामु तिनीहरूले ठेस खान्छन् र नष्‍ट हुन्छन्।<verse eid="PSA 9:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 9:4"/>किनकि तपाईंले न्याय गर्नुभयो र मेरो पक्षमा निर्णय गरिदिनुभएको छ, सिंहासनमा विराजमान भई तपाईंले निष्पक्ष न्याय गर्नुभएको छ।<verse eid="PSA 9:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 9:5"/>तपाईंले जाति-जातिहरूलाई हप्काउनुभएको छ; र दुष्‍टहरूलाई नष्‍ट पार्नुभएको छ; तपाईंले तिनीहरूका नाम सधैँको निम्ति मेटिदिनुभएको छ।<verse eid="PSA 9:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 9:6"/>मेरा शत्रुहरूमाथि अनन्त विनाश आइपरेको छ, तपाईंले तिनीहरूका सहरहरू ध्वस्त पारिदिनुभएको छ; तिनीहरूको सम्झना नै मेटिएको छ।<verse eid="PSA 9:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 9:7"/>याहवेहले सदासर्वदाको निम्ति राज्य गर्नुहुन्छ; उहाँले आफ्नो सिंहासन न्यायको निम्ति स्थापित गर्नुभएको छ।<verse eid="PSA 9:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 9:8"/>उहाँले धार्मिकतामा संसारको न्याय गर्नहुन्छ; उहाँले जाति-जातिहरूमाथि निष्पक्षसाथ न्याय गर्नुहुन्छ।<verse eid="PSA 9:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 9:9"/>याहवेह थिचोमिचोमा परेकाहरूका निम्ति शरणस्थान हुनुहुन्छ, सङ्कष्‍टको समयमा उहाँ किल्‍ला हुनुहुन्छ।<verse eid="PSA 9:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 9:10"/>तपाईंका नाम जान्‍नेहरूले तपाईंमा भरोसा राख्दछन्, किनकि, हे याहवेह, तपाईंको खोजी गर्नेहरूलाई तपाईंले कहिल्यै त्याग्नुभएको छैन।<verse eid="PSA 9:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 9:11"/>सियोनमा विराजमान हुनुहुने याहवेहको स्तुति गाओ; जाति-जातिहरूका बीच उहाँका कामहरूको घोषणा गर।<verse eid="PSA 9:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 9:12"/>किनकि रक्तपातको बदला लिनुहुनेले सम्झना राख्नुहुन्छ; उहाँले सङ्कष्‍टमा परेकाहरूको पुकारलाई बेवास्ता गर्नुहुन्‍न।<verse eid="PSA 9:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 9:13"/>हे याहवेह, हेर्नुहोस्, कसरी मलाई मेरा शत्रुहरूले खेदो गर्छन्। ममाथि कृपा गर्नुहोस् र मलाई मृत्युको मुखबाट छुटाउनुहोस्;<verse eid="PSA 9:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 9:14"/>ताकि सियोनकी छोरीका ढोकाहरूमा म तपाईंको प्रशंसाको घोषणा गर्न सकूँ र त्यहाँ तपाईंले गर्नुभएको मुक्तिमा म रमाउन सकूँ।<verse eid="PSA 9:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 9:15"/>राष्ट्रहरू आफूले खनेका खाडलमा आफैँ जाकिएका छन्; तिनीहरूले लुकाइराखेका जालमा तिनीहरूका आफ्नै पाउ परेका छन्।<verse eid="PSA 9:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 9:16"/>याहवेह त उहाँको न्यायको कामद्वारा चिनिनुहुन्छ; तिनीहरूका हातका कामद्वारा दुष्‍टहरू जालमा पर्दछन्। हिग्गियोन। सेला<verse eid="PSA 9:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 9:17"/>दुष्‍टहरूचाहिँ मृत्युको पातालमै फर्केर जानेछन्, सबै राष्ट्रहरू जसले परमेश्‍वरलाई बिर्सन्छन्।<verse eid="PSA 9:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 9:18"/>तर परमेश्‍वरले अभावमा हुनेहरूलाई कहिल्यै बिर्सनुहुनेछैन; पीडितहरूको आशा कहिल्यै चकनाचुर हुनेछैन।<verse eid="PSA 9:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 9:19"/>हे याहवेह, तपाईं उठ्नुहोस्, नाशवान् मानिस विजयी हुन नपाओस्; तपाईंको उपस्थितिमा जाति-जातिहरूको न्याय गरियोस्।<verse eid="PSA 9:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 9:20"/>हे याहवेह, तिनीहरूमाथि त्रास खन्याउनुहोस्; तिनीहरू त नाशवान् मानिस मात्र हुन् भनी राष्ट्रहरूले जानून्। सेला<verse eid="PSA 9:20"/></para>
<chapter eid="PSA 9"/>
<chapter number="10" style="c" sid="PSA 10"/>
<para style="p"><verse number="1" style="v" sid="PSA 10:1"/>हे याहवेह, किन तपाईं टाढा उभिनुहुन्छ? तपाईं सङ्कष्‍टको समयमा किन आफूलाई लुकाउनुहुन्छ?<verse eid="PSA 10:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 10:2"/>दुष्‍टहरूले आफ्ना अहङ्कारमा कमजोरहरूलाई अत्याचार गर्छन्। तिनीहरूले रचेका योजनामा उनीहरू फस्छन्।<verse eid="PSA 10:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 10:3"/>तिनीहरूले आफ्नो हृदयका इच्छाहरूमा गर्व गर्छन्; लोभीहरूलाई आशीर्वाद दिन्छन्, र याहवेहलाई निन्दा गर्छन्।<verse eid="PSA 10:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 10:4"/>दुष्‍टहरूले आफ्नो घमण्डमा परमेश्‍वरको खोजी गर्दैनन्; तिनीहरूका सारा विचारहरूमा परमेश्‍वरको लागि कुनै स्थान हुँदैन।<verse eid="PSA 10:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 10:5"/>दुष्‍टहरूका योजनाहरू सधैँ सफल हुन्छन्; तपाईंका विधिहरू तिनीहरूले इन्कार गर्छन्; तिनीहरूले आफ्ना सबै शत्रुहरूको उपहास गर्दछन्।<verse eid="PSA 10:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 10:6"/>तिनीहरूले आफ्नो मनमा भन्छन्, “हामीलाई कुनै पनि कुराले हल्‍लाउन सक्नेछैन।” तिनीहरूले अडान लिन्छन्, “हाम्रो कुनै पनि पुस्तामा विपत्ति आइपर्नेछैन।”<verse eid="PSA 10:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 10:7"/>तिनीहरूका मुख श्राप, छल र हप्कीले भरिएका हुन्छन्; तिनीहरूका जिब्रोमा दुष्‍टता र गलत कुरा हुन्छन्।<verse eid="PSA 10:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 10:8"/>तिनीहरू गाउँहरूकै छेउमा ढुकिबस्छन्; पर्खेर निर्दोषहरूको हत्या गर्दछन्। तिनीहरूका आँखा असहायहरूलाई गुप्‍त स्थानहरूमा खोजिरहन्छ।<verse eid="PSA 10:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 10:9"/>तिनीहरू सिंहझैँ झाडीमा ढुकेर बस्छन्; असहायहरूलाई पक्रनलाई ढुकेर बस्छन्; असहायहरूलाई पक्रन्छन् र आफ्नो पासोमा पारेर घिसार्दै लैजान्छन्।<verse eid="PSA 10:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 10:10"/>तिनीहरूका शिकारहरू चकनाचुर पारिन्छन्, ती निर्बल भई ढल्छन्, दुष्‍टहरूका शक्तिमुनि उनीहरू लडिहाल्छन्।<verse eid="PSA 10:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 10:11"/>तिनीहरूले आफ्नो मनमा भन्दछन्, “हामीले गरेका कुराहरू परमेश्‍वरले बिर्सनुभएको छ; उहाँले आफ्नो मुहार ढाक्नुभएको छ, र उहाँले कहिल्यै देख्नुहुन्‍न।”<verse eid="PSA 10:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 10:12"/>हे याहवेह, उठ्नुहोस्, हे परमेश्‍वर, तपाईंको हात उठाउनुहोस्। असहायहरूलाई नबिर्सनुहोस्।<verse eid="PSA 10:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 10:13"/>किन दुष्‍टहरूले परमेश्‍वरको विरोध गर्छन्? तिनीहरूले किन आफ्नो मनमा यसो भन्छन्, “उहाँले हाम्रो लेखा लिनुहुनेछैन?”<verse eid="PSA 10:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 10:14"/>तर हे परमेश्‍वर, तपाईं दुःखीहरूका सङ्कष्‍ट देख्नुहुन्छ; तपाईंले तिनीहरूका दुःख देख्नुहुन्छ र आफ्नो हातमा लिनुहुन्छ। दुःखीहरूले आफूलाई तपाईंमा सुम्पन्छन्; तपाईं नै अनाथहरूका सहायक हुनुहुन्छ।<verse eid="PSA 10:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 10:15"/>दुष्‍ट तथा कुकर्मीहरूका पाखुरा भाँचिदिनुहोस्; दुष्‍ट काम गर्नेहरूबाट लेखा लिनलाई बोलाउनुहोस्, ताकि तिनीहरूमा फेरि दुष्‍टता नभेट्टाइयोस्।<verse eid="PSA 10:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 10:16"/>याहवेह सदासर्वदाको निम्ति राजा हुनुहुन्छ; उहाँको देशबाट जाति-जातिहरू नष्‍ट हुनेछन्।<verse eid="PSA 10:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 10:17"/>हे याहवेह, तपाईंले कष्‍टमा परेकाहरूको इच्छा बुझ्नुहुन्छ; तपाईं तिनीहरूका पुकार सुन्‍नुहुन्छ र तिनीहरूलाई उत्साह दिनुहुन्छ।<verse eid="PSA 10:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 10:18"/>तपाईं अनाथ र थिचोमिचोमा परेकाहरूको पक्षमा न्याय गर्नुहुन्छ, ताकि मरणशील मानिसले फेरि कसैमाथि आतङ्क नमच्‍चाओस्।<verse eid="PSA 10:18"/></para>
<chapter eid="PSA 10"/>
<chapter number="11" style="c" sid="PSA 11"/>
<para style="p"><verse number="1" style="v" sid="PSA 11:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। याहवेहमा म शरण लिन्छु, तिमीहरू कसरी मलाई यसो भन्‍न सक्छौ: “चराझैँ तिम्रो डाँडामा उडिजाऊ,<verse eid="PSA 11:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 11:2"/>किनकि हेर, दुष्‍टहरूले आफ्नो धनुमा ताँदो चढाउँछन्; अँध्यारोबाट काँड ताकेर सोझो हृदय भएकाहरूलाई हान्‍नका निम्ति तिनीहरूले आफ्नो काँड ताँदोमा चढाएका छन्।<verse eid="PSA 11:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 11:3"/>जब जगहरू नै नष्‍ट पारिन्छन् भने, धर्मी जनहरूले के गर्न सक्छन् र?”<verse eid="PSA 11:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 11:4"/>याहवेह आफ्नो पवित्र मन्दिरमा हुनुहुन्छ; याहवेह आफ्नो स्वर्गीय सिंहासनमा विराजमान हुनुहुन्छ। उहाँले पृथ्वीका सबै मानिसहरूलाई नियालेर हेर्नुहुन्छ; उहाँले आफ्ना आँखाले तिनीहरूको जाँच गर्नुहुन्छ।<verse eid="PSA 11:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 11:5"/>याहवेहले धर्मीहरूलाई जाँच गर्नुहुन्छ; तर दुष्‍ट, जसले हिंसा रुचाउँछन्, उहाँले तिनीहरूलाई घृणा गर्नुहुन्छ।<verse eid="PSA 11:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 11:6"/>दुष्‍टहरूमाथि उहाँले प्रचण्ड आगो र बल्दो गन्धक बर्साउनुहुनेछ; र पोल्ने हावा तिनीहरूको भाग हुनेछ।<verse eid="PSA 11:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 11:7"/>किनकि याहवेह धर्मी हुनुहुन्छ, उहाँले न्यायलाई प्रेम गर्नुहुन्छ; धर्मी मानिसहरूले उहाँको मुहारको दर्शन गर्नेछन्।<verse eid="PSA 11:7"/></para>
<chapter eid="PSA 11"/>
<chapter number="12" style="c" sid="PSA 12"/>
<para style="p"><verse number="1" style="v" sid="PSA 12:1"/>सङ्गीत निर्देशकको निम्ति शिमिनिथ।* दावीदको भजन। हे याहवेह, सहायता गर्नुहोस्; किनकि भक्तजन एकै जना पनि रहेनन्; विश्‍वासयोग्यहरू मानिसहरूका बीचबाट मासिसकेका छन्।<verse eid="PSA 12:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 12:2"/>हरेकले आफ्ना छिमेकीसँग झूटो बोल्छन्; तिनीहरूका ओठले चापलुसी गर्छन्; तर तिनीहरूका हृदयमा धोकाका कुरा राख्छन्।<verse eid="PSA 12:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 12:3"/>सबै चापलुसी गर्ने ओठहरूलाई र घमण्डका कुरा गर्ने हरेक जिब्रोलाई याहवेहले काटी फालिदेऊन्—<verse eid="PSA 12:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 12:4"/>तिनीहरू जसले भन्छन्, “हाम्रा जिब्राहरूले नै हामी जित्नेछौँ; हाम्रा ओठहरूले नै हामीलाई बचाउँछन्; हामीमाथि शासन गर्ने शासक को छ र?”<verse eid="PSA 12:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 12:5"/>याहवेह भन्‍नुहुन्छ, “दुर्बलहरूमाथि भएको अत्याचार र खाँचोमा हुनेहरूको सुस्केराको कारणले म अब उठ्नेछु, म तिनीहरूलाई तिनीहरूको बदनाम गर्नेहरूबाट सुरक्षा गर्नेछु।”<verse eid="PSA 12:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 12:6"/>याहवेहका वचनहरू खोटरहित छन्, ती भट्टीमा सात पल्ट खारेर शुद्ध पारिएका चाँदीजस्तै छन्।<verse eid="PSA 12:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 12:7"/>हे याहवेह, तपाईंले खाँचोमा परेकाहरूलाई रक्षा गर्नुहुनेछ, र दुष्‍टहरूबाट हामीलाई सधैँ सुरक्षित राख्नुहुनेछ,<verse eid="PSA 12:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 12:8"/>जब मानिसहरूका बीचमा दुष्‍टताको सम्मान हुन्छ; दुष्‍टहरू गमक्‍क भई खुल्‍ला रूपमा डुलिहिँड्छन्।<verse eid="PSA 12:8"/></para>
<chapter eid="PSA 12"/>
<chapter number="13" style="c" sid="PSA 13"/>
<para style="p"><verse number="1" style="v" sid="PSA 13:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। हे याहवेह, कहिलेसम्म? के सधैँभरिको लागि तपाईंले बिर्सनुहुन्छ? तपाईंले आफ्नो मुहार मसँग कहिलेसम्म लुकाउनुहुन्छ?<verse eid="PSA 13:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 13:2"/>कहिलेसम्म मैले आफ्नो चिन्ता बोक्ने, र दिनहुँ मेरो हृदयमा शोक बोकिराख्ने? मेरा शत्रुहरू कहिलेसम्म ममाथि विजयी भइरहने?<verse eid="PSA 13:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 13:3"/>हे याहवेह, मेरा परमेश्‍वर, मलाई हेर्नुहोस् र मलाई जवाफ दिनुहोस्; मेरा आँखालाई ज्योति दिनुहोस्, नत्रता म मृत्युको निद्रामा पर्नेछु।<verse eid="PSA 13:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 13:4"/>नत्रता मेरो वैरीहरूले भन्‍नेछ, “मैले त्यसमाथि विजय पाएको छु,” र जब म डगमगाउँछु, मेरा वैरीहरू रमाउनेछन्।<verse eid="PSA 13:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 13:5"/>तर मैले तपाईंको अचुक प्रेममा भरोसा राखेको छु; मेरो हृदय तपाईंको मुक्तिमा रमाउँछ।<verse eid="PSA 13:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 13:6"/>म याहवेहको स्तुति गाउनेछु; किनकि उहाँ मप्रति भलो हुनुहुन्छ।<verse eid="PSA 13:6"/></para>
<chapter eid="PSA 13"/>
<chapter number="14" style="c" sid="PSA 14"/>
<para style="p"><verse number="1" style="v" sid="PSA 14:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। मूर्खले आफ्नो मनमा भन्छ, “परमेश्‍वर छँदैछैन।” तिनीहरू भ्रष्‍ट छन्, तिनीहरूले नीच काम गर्दछन्; असल काम गर्ने कोही पनि छैन।<verse eid="PSA 14:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 14:2"/>याहवेहले स्वर्गबाट सबै मानिस जातिलाई हेर्नुहुन्छ, यो जान्‍नलाई कि कोही त समझदार होला, जसले परमेश्‍वरको खोजी गर्दछ।<verse eid="PSA 14:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 14:3"/>तिनीहरू सबै भड्किगएका छन्, सबै जना भ्रष्‍ट भएका छन्; असल गर्ने कोही छैन; एक जना पनि छैन।<verse eid="PSA 14:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 14:4"/>के यी सबै दुष्‍ट काम गर्नेहरूले केही पनि जान्दैनन्? रोटी खाएझैँ तिनीहरूले मेरा मानिसहरूलाई खान्छन्; तिनीहरूले याहवेहलाई कहिल्यै पुकार्दैनन्।<verse eid="PSA 14:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 14:5"/>तर त्यहाँ तिनीहरू डरले काम्छन्; किनकि धर्मीहरूको समूहमा परमेश्‍वर उपस्थित हुनुहुन्छ।<verse eid="PSA 14:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 14:6"/>तिमी दुष्‍ट काम गर्नेहरूले गरिबका योजनाहरूलाई विफल पार्छौ; तर याहवेह नै तिनीहरूका शरणस्थान हुनुहुन्छ।<verse eid="PSA 14:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 14:7"/>अहो, इस्राएलको मुक्ति सियोनबाट आएको भए त कति असल हुनेथियो! जब याहवेहले आफ्नो मानिसहरूको सुदिन फर्काइदिनुहुन्छ, तब याकोब रमाओस्, र इस्राएल आनन्दित होस्।<verse eid="PSA 14:7"/></para>
<chapter eid="PSA 14"/>
<chapter number="15" style="c" sid="PSA 15"/>
<para style="p"><verse number="1" style="v" sid="PSA 15:1"/>दावीदको भजन। हे याहवेह, तपाईंको पवित्र वासस्थानमा कसले बास गर्न पाउनेछ? तपाईंको पवित्र पर्वतमा कसले बस्‍न पाउनेछ?<verse eid="PSA 15:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 15:2"/>त्यो मानिस, जसको जीवन निर्दोष छ; जसले धर्मी काम गर्छ, जसले आफ्नो हृदयबाट सत्य बोल्छ,<verse eid="PSA 15:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 15:3"/>जसको जिब्रोले अरूको निन्दा गर्दैन, जसले आफ्नो छिमेकीको खराबी गर्दैन, र मित्रहरूको अपमान गर्दैन;<verse eid="PSA 15:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 15:4"/>जसले दुष्‍ट मानिसलाई घृणा गर्दछ, तर याहवेहको भय मान्‍नेहरूलाई आदर गर्दछ; जसले आफ्नो हानि हुँदा पनि आफूले शपथ खाएको कुरा बदल्दैन, र जसले आफ्नो मन बदल्दैन;<verse eid="PSA 15:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 15:5"/>जसले आफ्नो रकम खाँचोमा परेकालाई ब्याजमा लाउँदैन; र जसले निर्दोषको विरुद्धमा घूस लिँदैन। यस्ता जीवन जिउनेहरू कहिल्यै पनि डगमगाउनेछैन।<verse eid="PSA 15:5"/></para>
<chapter eid="PSA 15"/>
<chapter number="16" style="c" sid="PSA 16"/>
<para style="p"><verse number="1" style="v" sid="PSA 16:1"/>दावीदको मिक्ताम।* हे मेरा परमेश्‍वर, मलाई रक्षा गर्नुहोस्; किनकि मैले तपाईंमा शरण लिएको छु।<verse eid="PSA 16:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 16:2"/>मैले याहवेहलाई भने, “तपाईं मेरा प्रभु हुनुहुन्छ; तपाईंबाहेक मसँग अरू कुनै असल कुरो छैन।”<verse eid="PSA 16:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 16:3"/>पृथ्वीमा भएका भक्तजनहरू चाहिँ, “तिनीहरू नै आदर्श छन्; र तिनीहरूमा नै मेरो पूरा आनन्द छ।”<verse eid="PSA 16:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 16:4"/>अरू देवताहरूको पछि लाग्नेहरूको दुःख बढ्दैजानेछ। म ती देवताहरूलाई रक्तबलि चढाउनेछैनँ। न त तिनीहरूका नाम मेरो ओठले उच्‍चारण गर्नेछ।<verse eid="PSA 16:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 16:5"/>हे याहवेह, तपाईं नै मेरो हिस्सा र कचौरा हुनुहुन्छ; तपाईंले नै मेरो भाग सुरक्षित राखिदिनुभएको छ।<verse eid="PSA 16:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 16:6"/>सिमानाका रेखाहरू मेरो मनपर्ने ठाउँमा परेका छन्; साँच्‍चै नै मलाई मनपर्ने पैतृक सम्पत्ति पाएको छु।<verse eid="PSA 16:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 16:7"/>यसैकारण म याहवेहको प्रशंसा गर्दछु, जसले मलाई परामर्श दिनुहुन्छ; रातमा पनि मेरो हृदयले मलाई निर्देशन दिन्छ।<verse eid="PSA 16:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 16:8"/>म मेरो आँखा सधैँ याहवेहमा राख्दछु, उहाँ मेरो दाहिनेपट्टि हुनुभएकोले, म डगमगाउनेछैनँ।<verse eid="PSA 16:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 16:9"/>यसैकारण मेरो हृदय आनन्दित छ, र मेरो जिब्रो हर्षित छ; मेरो शरीरले पनि सुरक्षितसाथ विश्राम गर्नेछ।<verse eid="PSA 16:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 16:10"/>किनभने तपाईंले मेरो प्राणलाई चिहानमा छोड्नुहुनेछैन; न त तपाईंले आफ्ना पवित्र जनको शरीर कुहुन दिनुहुनेछ।<verse eid="PSA 16:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 16:11"/>जीवनका मार्गहरू तपाईंले मलाई थाहा गराउनुभएको छ; आफ्नो उपस्थितिमा तपाईंले मभित्र आनन्द भरिदिनुहुनेछ। तपाईंको दाहिने बाहुलीमा अनन्तको आनन्द छ।<verse eid="PSA 16:11"/></para>
<chapter eid="PSA 16"/>
<chapter number="17" style="c" sid="PSA 17"/>
<para style="p"><verse number="1" style="v" sid="PSA 17:1"/>दावीदको प्रार्थना। हे याहवेह मेरो पुकारलाई सुन्‍नुहोस्, मेरो पुकार उचित छ; निष्कपट ओठहरूबाट निस्केका मेरो प्रार्थनामा कान लगाउनुहोस्।<verse eid="PSA 17:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 17:2"/>मेरो निर्दोषता तपाईंबाट ठहरिएको होस्; तपाईंका आँखाहरूले जे सही छ, त्यही देखून्।<verse eid="PSA 17:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 17:3"/>यदि तपाईंले मेरो हृदय जाँच्नुभयो भने, राति आएर मलाई जाँच गर्नुभए तापनि तपाईंले मभित्र केही पनि दुष्‍ट योजना भेट्टाउनुहुनेछैन; मैले संकल्प गरेको छु, मेरो ओठले पाप गर्नेछैन।<verse eid="PSA 17:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 17:4"/>यद्यपि मानिसहरूले मलाई घूस दिन खोज्छन्; तपाईंको मुखबाट निस्केका आज्ञाद्वारा मैले आफूलाई हिंसाको मार्गबाट जोगाइराखेको छु।<verse eid="PSA 17:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 17:5"/>मेरा पाइलाहरू तपाईंका मार्गमा चलेका छन्; मेरा पाउहरू चिप्लेका छैनन्।<verse eid="PSA 17:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 17:6"/>हे परमेश्‍वर, म तपाईंलाई पुकार्छु; किनकि तपाईंले मलाई जवाफ दिनुहुनेछ; तपाईंको कान मतिर लगाउनुहोस्, र मेरो बिन्ती सुन्‍नुहोस्।<verse eid="PSA 17:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 17:7"/>तपाईंको अचुक प्रेमको अद्‌भुत कार्यहरू देखाउनुहोस्; तपाईंमा शरण लिनेहरूलाई तिनीहरूका वैरीहरूबाट तपाईं आफ्नो दाहिने बाहुलीले बचाउनुहुन्छ।<verse eid="PSA 17:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 17:8"/>मलाई तपाईंको आँखाको नानीलाई झैँ रक्षा गर्नुहोस्; तपाईंको पखेटाको छायामा मलाई लुकाउनुहोस्,<verse eid="PSA 17:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 17:9"/>मलाई नष्‍ट पार्न आइलाग्ने दुष्‍टहरूबाट, मलाई घेरेर मार्न चाहने घातक शत्रुहरूबाट बचाउनुहोस्।<verse eid="PSA 17:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 17:10"/>तिनीहरूले आफ्ना निर्दयी हृदय बन्द गरेका छन्, र तिनीहरूका मुखले घमण्डका कुरा गर्दछन्।<verse eid="PSA 17:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 17:11"/>मलाई तिनीहरूले खोजी-खोजी निकालेर चारैतिर घेरेका छन्; मलाई जमिनमा पछार्नलाई तिनीहरू दाउ हेर्दछन्।<verse eid="PSA 17:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 17:12"/>तिनीहरू शिकारको निम्ति भोकाएको सिंहझैँ छन्, तिनीहरू एउटा डरलाग्दो सिंहझैँ झाडीमा ढुकिबस्छन्।<verse eid="PSA 17:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 17:13"/>हे याहवेह, उठ्नुहोस्, तिनीहरूको सामना गर्नुहोस्; तिनीहरूलाई पराजित गरिदिनुहोस्; आफ्नो तरवारले मलाई दुष्‍टहरूबाट बचाउनुहोस्।<verse eid="PSA 17:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 17:14"/>हे याहवेह, जसको पुरस्कार यस संसारको जीवनकालमा सीमित छ, संसारका यस्ता मानिसहरूबाट तपाईंको बाहुलीले मलाई बचाउनुहोस्। तपाईंले साँचेर राख्नुभएका थोकहरूले दुष्‍टहरूको पेट भरिएको होस्; तिनीहरूका छोराछोरीहरूले प्रशस्त खानेकुरा हसुरून्, र तिनीहरूका आफ्ना भावी छोराछोरीहरूका लागि पनि प्रशस्त रहोस्।<verse eid="PSA 17:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 17:15"/>तर मचाहिँ धार्मिकतामा तपाईंको मुहार हेर्नेछु; जब म बिउँझन्छु, तब तपाईंको मुहारको दर्शन गरेर म सन्तुष्‍ट हुनेछु।<verse eid="PSA 17:15"/></para>
<chapter eid="PSA 17"/>
<chapter number="18" style="c" sid="PSA 18"/>
<para style="p"><verse number="1" style="v" sid="PSA 18:1"/>सङ्गीत निर्देशकको निम्ति, याहवेहका सेवक दावीदले लेखेको भजन; शत्रुहरू र शाऊलका हातबाट याहवेहले बचाउनुहुँदा दावीदले याहवेहको निम्ति गाएको भजन। हे याहवेह, मेरा शक्ति, म तपाईंलाई प्रेम गर्दछु।<verse eid="PSA 18:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 18:2"/>याहवेह मेरो चट्टान, मेरो किल्‍ला र मेरा उद्धारकर्ता हुनुहुन्छ; मेरो परमेश्‍वर मेरो चट्टान हुनुहुन्छ, जसमा म शरण लिन्छु, उहाँ मेरो ढाल, मेरो मुक्तिको सिङ र मेरो उच्‍च गढ हुनुहुन्छ।<verse eid="PSA 18:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 18:3"/>म याहवेहलाई पुकार्दछु, जो प्रशंसाको योग्य हुनुहुन्छ, र म मेरा शत्रुहरूबाट बचाइन्छु।<verse eid="PSA 18:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 18:4"/>मृत्युका पासोहरूले मलाई घेरे; विनाशको बाढीले मलाई भयभीत बनाए;<verse eid="PSA 18:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 18:5"/>चिहानका पासाहरूले मलाई चारैतिर घेरा हाले; मैले मृत्युको पासोको सामना गर्नुपर्‍यो।<verse eid="PSA 18:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 18:6"/>मेरो सङ्कष्‍टमा मैले याहवेहलाई पुकारेँ; सहायताको निम्ति मैले मेरा परमेश्‍वरलाई पुकारेँ। उहाँले आफ्नो भवनबाट मेरो सोर सुन्‍नुभयो; मेरो पुकार उहाँको सामु पुग्यो। हो, उहाँको कानमै पुग्यो।<verse eid="PSA 18:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 18:7"/>पृथ्वी काम्यो, र हल्‍लियो; र पहाडका जगहरू हल्‍लिए; तिनीहरू थरथर कामे, किनकि उहाँ रिसाउनुभएको थियो।<verse eid="PSA 18:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 18:8"/>उहाँको नाकका प्वालबाट धुवाँ निस्क्यो; उहाँको मुखबाट भस्मकारी आगो निस्क्यो; त्यहाँबाट बल्दैगरेका कोइलाहरू निस्के।<verse eid="PSA 18:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 18:9"/>उहाँ स्वर्ग उघारेर पृथ्वीमा ओर्लनुभयो; अँध्यारो बादल उहाँको पाउमुनि थियो।<verse eid="PSA 18:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 18:10"/>करूबहरूमा सवार भएर उहाँ उड्नुभयो; बतासका पखेटाहरूमाथि चढेर उहाँ माथि उड्नुभयो।<verse eid="PSA 18:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 18:11"/>उहाँले अन्धकारलाई आफ्नो ओढ्ने, मण्डप तुल्याउनुभयो; हो, आकाशको कालो झरीको बादललाई उहाँले ओढ्ने, मण्डप तुल्याउनुभयो।<verse eid="PSA 18:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 18:12"/>उहाँको उपस्थितिको ज्योतिबाट, असिना र बिजुलीका गर्जन लिई बाक्लो बादल अगि बढ्यो।<verse eid="PSA 18:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 18:13"/>याहवेह स्वर्गबाट गर्जनुभयो; असिना र बिजुलीका साथ सर्वोच्‍चको सोर गुञ्जायमान भयो।<verse eid="PSA 18:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 18:14"/>उहाँले आफ्ना काँडहरू हानेर शत्रुहरूलाई तितरबितर पारिदिनुभयो; उहाँले तिनीहरूलाई चट्याङद्वारा अस्तव्यस्त पार्नुभयो।<verse eid="PSA 18:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 18:15"/>हे याहवेह, तपाईंको हप्काइले र तपाईंका नाकका प्वालबाट निस्केका सासले समुद्रका तहहरू देखा परे, र पृथ्वीका जगहरू प्रकट भए।<verse eid="PSA 18:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 18:16"/>उहाँले माथि उच्‍चबाट हात पसारेर मलाई समातेर थाम्नुभयो; उहाँले मलाई गहिरो सागरबाट तानेर निकाल्नुभयो।<verse eid="PSA 18:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 18:17"/>उहाँले मलाई मेरा शक्तिशाली शत्रुबाट छुटाउनुभयो, मेरा वैरीहरूबाट, जो मभन्दा धेरै बलिया थिए।<verse eid="PSA 18:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 18:18"/>मेरा विपत्तिका दिनमा तिनीहरू ममाथि आइलागे, तर याहवेह मेरा सहारा हुनुभयो।<verse eid="PSA 18:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 18:19"/>उहाँले मलाई एउटा फराकिलो ठाउँमा निकालेर ल्याउनुभयो; उहाँले मलाई छुटाउनुभयो; किनकि उहाँ मसँग प्रसन्‍न हुनुहुन्थ्यो।<verse eid="PSA 18:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 18:20"/>याहवेहले मेरो धार्मिकताअनुसार मसँग व्यवहार गर्नुभएको छ; मेरा हातका शुद्धताअनुसार उहाँले मलाई प्रतिफल दिनुभएको छ।<verse eid="PSA 18:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 18:21"/>किनकि म याहवेहको मार्गमा चलेको छु; मेरा परमेश्‍वरबाट तर्केर मैले दुष्‍टता गरेको छैनँ।<verse eid="PSA 18:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 18:22"/>उहाँका सारा नियमहरू मेरा अगि छन्; उहाँका उर्दीहरूबाट म तर्केर हिँडेको छैनँ।<verse eid="PSA 18:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 18:23"/>म उहाँको अगि निर्दोष रहेको छु; र मैले आफूलाई पापबाट जोगाइराखेको छु।<verse eid="PSA 18:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 18:24"/>याहवेहले मेरो धार्मिकताअनुसार, उहाँको दृष्‍टिमा मेरा हातका शुद्धताअनुसार मलाई प्रतिफल दिनुभएको छ।<verse eid="PSA 18:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 18:25"/>विश्‍वासयोग्यसँग तपाईं आफूलाई विश्‍वासयोग्य रूपमा देखाउनुहुन्छ, निर्दोषसँग तपाईं आफूलाई निर्दोष रूपमा प्रकट गर्नुहुन्छ;<verse eid="PSA 18:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 18:26"/>शुद्धसँग तपाईं आफूलाई शुद्ध रूपमा प्रकट गर्नुहुन्छ, तर छलीसँग तपाईं आफूलाई चतुर प्रकट गराउनुहुन्छ।<verse eid="PSA 18:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 18:27"/>तपाईं नम्रहरूलाई बचाउनुहुन्छ, तर जसका आँखामा अहङ्कार छ, तिनीहरूलाई होच्याउनुहुन्छ।<verse eid="PSA 18:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 18:28"/>हे याहवेह, तपाईंले मेरो दियो बलि रहन दिनुहुन्छ; मेरा परमेश्‍वरले मेरो अन्धकारलाई उज्यालोमा परिवर्तन गर्नुहुन्छ।<verse eid="PSA 18:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 18:29"/>तपाईंको सहायताले म फौजमाथि आक्रमण गर्न सक्छु; मेरा परमेश्‍वरसँग म अग्लो पर्खाल नाघ्न सक्छु।<verse eid="PSA 18:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 18:30"/>परमेश्‍वरको बारेमा भन्‍नुपर्दा, उहाँका मार्ग सिद्ध छ: याहवेहको वचन दोषरहित छ; उहाँमा शरण लिनेहरू सबैको उहाँ ढाल हुनुहुन्छ।<verse eid="PSA 18:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 18:31"/>किनकि याहवेहबाहेक अर्को परमेश्‍वर को छ र? हाम्रा परमेश्‍वरबाहेक अर्को चट्टान को छ र?<verse eid="PSA 18:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 18:32"/>उनै परमेश्‍वरले मलाई युद्धको लागि तयार पार्नुहुन्छ, र मेरा मार्गलाई सुरक्षित तुल्याउनुहुन्छ।<verse eid="PSA 18:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 18:33"/>उहाँले मेरा पाउहरू मृगको झैँ बनाउनुहुन्छ; उहाँले मलाई उच्‍च स्थानमा खडा रहन सक्षम बनाउनुहुन्छ।<verse eid="PSA 18:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 18:34"/>उहाँले मेरा हातहरूलाई लडाइँको निम्ति तालिम दिनुहुन्छ; मेरा पाखुराले काँसोको धनु तानेर झुकाउन सक्छन्।<verse eid="PSA 18:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 18:35"/>तपाईंले मलाई आफ्नो सुरक्षाको ढाल दिनुभएको छ, र तपाईंको दाहिने बाहुलीले मलाई सहारा दिएको छ; तपाईंको सहायताले मलाई महान् बनाएको छ।<verse eid="PSA 18:35"/></para>
<para style="p"><verse number="36" style="v" sid="PSA 18:36"/>तपाईंले मेरा पाइलाहरूका निम्ति बाटो फराकिलो बनाउनुहुन्छ, ताकि मेरा गोडा नचिप्लून्।<verse eid="PSA 18:36"/></para>
<para style="p"><verse number="37" style="v" sid="PSA 18:37"/>मेरा शत्रुहरूलाई मैले खेदेर भेट्टाएँ; तिनीहरूको विनाश नहोउन्जेल म फर्केर आइनँ।<verse eid="PSA 18:37"/></para>
<para style="p"><verse number="38" style="v" sid="PSA 18:38"/>मैले तिनीहरूलाई टुक्रै-टुक्रा बनाएँ; ताकि तिनीहरू उठ्न नसकून्; तिनीहरू मेरा पाउमुनि लडे।<verse eid="PSA 18:38"/></para>
<para style="p"><verse number="39" style="v" sid="PSA 18:39"/>तपाईंले मलाई लडाइँको निम्ति तयार पार्नुभएको छ; तपाईंले मेरा शत्रुहरूलाई मेरा पाउमा निहुरन लगाउनुभएको छ।<verse eid="PSA 18:39"/></para>
<para style="p"><verse number="40" style="v" sid="PSA 18:40"/>तपाईंले मेरा शत्रुहरूलाई पिठिउँ फर्काएर भाग्न लगाउनुभएको छ, र मैले मेरा वैरीहरूलाई विनाश पारेँ।<verse eid="PSA 18:40"/></para>
<para style="p"><verse number="41" style="v" sid="PSA 18:41"/>तिनीहरूले सहायताको लागि पुकार गरे, तर तिनीहरूलाई बचाउने कोही पनि भएन तिनीहरूले याहवेहलाई पनि पुकारे, तर उहाँले पनि तिनीहरूलाई जवाफ दिनुभएन।<verse eid="PSA 18:41"/></para>
<para style="p"><verse number="42" style="v" sid="PSA 18:42"/>मैले तिनीहरूलाई बतासले उडाइलैजाने धुलोझैँ धुलोपिठो पारेँ; मैले तिनीहरूलाई बाटोको हिलोझैँ कुल्चिएँ।<verse eid="PSA 18:42"/></para>
<para style="p"><verse number="43" style="v" sid="PSA 18:43"/>तपाईंले मलाई मानिसहरूका आक्रमणबाट छुटाउनुभयो; तपाईंले मलाई राष्ट्रहरूका शासक बनाउनुभयो; मैले नचिनेका मानिसहरू मेरो अधीनमा आएका छन्।<verse eid="PSA 18:43"/></para>
<para style="p"><verse number="44" style="v" sid="PSA 18:44"/>विदेशीहरू मेरा अगि झुक्दछन्; मेरो सोर सुन्‍नसाथ तिनीहरू मेरा आज्ञापालन गर्दछन्।<verse eid="PSA 18:44"/></para>
<para style="p"><verse number="45" style="v" sid="PSA 18:45"/>तिनीहरूको सारा साहस हराउँछन्; तिनीहरूका किल्‍लाहरूबाट तिनीहरू डरले काम्दै निस्कन्छन्।<verse eid="PSA 18:45"/></para>
<para style="p"><verse number="46" style="v" sid="PSA 18:46"/>याहवेह जीवित हुनुहुन्छ! मेरो चट्टानको स्तुति होस्! परमेश्‍वर, मेरा मुक्तिदाता, उच्‍च होऊन्!<verse eid="PSA 18:46"/></para>
<para style="p"><verse number="47" style="v" sid="PSA 18:47"/>उहाँ मेरो परमेश्‍वर हुनुहुन्छ, जसले मेरो निम्ति बदला लिनुहुन्छ, जसले राष्ट्रहरूलाई मेरो वशमा पारिदिनुहुन्छ,<verse eid="PSA 18:47"/></para>
<para style="p"><verse number="48" style="v" sid="PSA 18:48"/>जसले मलाई मेरा शत्रुहरूबाट बचाउनुहुन्छ। तपाईंले मलाई मेरा वैरीहरूभन्दा माथि उच्‍च पार्नुभएको छ; हिंसक मानिसहरूबाट मलाई उद्धार गर्नुभएको छ।<verse eid="PSA 18:48"/></para>
<para style="p"><verse number="49" style="v" sid="PSA 18:49"/>यसैकारण हे याहवेह, राष्ट्रहरूका बीचमा म तपाईंको प्रशंसा गर्नेछु; म तपाईंको नामको प्रशंसाको गीत गाउनेछु।<verse eid="PSA 18:49"/></para>
<para style="p"><verse number="50" style="v" sid="PSA 18:50"/>उहाँले आफ्ना राजालाई महान् विजय दिनुहुन्छ; र उहाँका अभिषिक्त जनलाई आफ्नो अचुक प्रेम देखाउनुहुन्छ, दावीद र तिनका वंशहरूलाई सदासर्वदा।<verse eid="PSA 18:50"/></para>
<chapter eid="PSA 18"/>
<chapter number="19" style="c" sid="PSA 19"/>
<para style="p"><verse number="1" style="v" sid="PSA 19:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। आकाशले परमेश्‍वरको महिमाको वर्णन गर्दछ; अन्तरिक्ष मण्डलले उहाँका हातका कामहरू प्रकट गर्दछन्।<verse eid="PSA 19:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 19:2"/>हरेक दिनले अर्को दिनसँग परमेश्‍वरको महिमाको चर्चा गर्दछ; हरेक रातले अर्को रातलाई उहाँका ज्ञानको प्रदर्शन गर्दछ।<verse eid="PSA 19:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 19:3"/>तिनीहरू बोल्दैनन्, न त तिनीहरूको बोल्ने शब्दहरू नै छन्; तिनीहरूबाट कुनै सोर सुनिँदैन।<verse eid="PSA 19:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 19:4"/>तरै पनि तिनीहरूका सोर सारा पृथ्वीभरि पुग्दछ; तिनीहरूका आवाज संसारको अन्त्यसम्म पुगेका छन्। परमेश्‍वरले आकाशमा सूर्यको निम्ति एउटा वासस्थान बनाउनुभएको छ।<verse eid="PSA 19:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 19:5"/>जुनचाहिँ विवाह-मण्डपबाट निस्केको दुलहाझैँ छ, दौडमा दौडिने धावकको विजयमा झैँ रमाउँछ।<verse eid="PSA 19:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 19:6"/>त्यो आकाशको एक कुनाबाट उदाउँछ, र अर्को कुनासम्म चक्‍कर लगाउँछ; त्यसको तापबाट कुनै कुरो लुकिरहन सक्दैन।<verse eid="PSA 19:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 19:7"/>याहवेहका व्यवस्थाहरू सिद्ध छन्, प्राणलाई ताजा गराउने, याहवेहका कानुनहरू विश्‍वासयोग्य छन्; सोझा व्यक्तिलाई बुद्धिमान् तुल्याउने।<verse eid="PSA 19:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 19:8"/>याहवेहका नियमहरू ठिक छन्, हृदयलाई आनन्दित गराउने, याहवेहका आज्ञाहरू उज्ज्वल छन्, आँखालाई ज्योति दिने।<verse eid="PSA 19:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 19:9"/>याहवेहको भय स्वच्छ छ, अनन्तकाल सम्मै स्थिर रहिरहने; याहवेहका उर्दीहरू अटल छन्, ती सबै धार्मिक सत्य छन्।<verse eid="PSA 19:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 19:10"/>ती सुनभन्दा पनि ज्यादै बहुमूल्य, निखुर सुनभन्दा, अझ ज्यादा बहुमूल्य छन्; ती महभन्दा मिठा, चाकाबाट झर्दै गरेको महभन्दा मिठा छन्।<verse eid="PSA 19:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 19:11"/>तीद्वारा तपाईंका सेवकले चेतावनी पाउँछ; ती पालन गर्दा ठूलो प्रतिफल मिल्छ।<verse eid="PSA 19:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 19:12"/>तर कसले आफ्ना भूलहरू छुट्ट्याउन सक्छन्? मेरा गुप्‍त दोषहरू क्षमा गरिदिनुहोस्!<verse eid="PSA 19:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 19:13"/>आफ्नै स्वइच्छाले गरेका पापहरूबाट तपाईंले आफ्नो सेवकलाई जोगाउनुहोस्; ममाथि ती प्रभुत्व हुन नपाओस्; अनि म दोषरहित र घोर अपराधहरूबाट निर्दोष हुनेछु।<verse eid="PSA 19:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 19:14"/>हे याहवेह, मेरा चट्टान र मेरा उद्धारक! मेरा मुखका वचनहरू र मेरा हृदयका ध्यान तपाईंका दृष्‍टिमा ग्रहणयोग्य हुन सकून्।<verse eid="PSA 19:14"/></para>
<chapter eid="PSA 19"/>
<chapter number="20" style="c" sid="PSA 20"/>
<para style="p"><verse number="1" style="v" sid="PSA 20:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। याहवेहले तपाईंको सङ्कष्‍टको दिनमा तपाईंलाई उत्तर देऊन्; याकोबका परमेश्‍वरका नामले तपाईंलाई सुरक्षा गरून्।<verse eid="PSA 20:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 20:2"/>उहाँको वासस्थानबाट तपाईंलाई मदत पठाऊन्, र सियोनबाट तपाईंलाई सहारा देऊन्।<verse eid="PSA 20:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 20:3"/>उहाँले तपाईंका सारा बलिदानहरू स्मरण गरून्, र तपाईंका होमबलिहरू ग्रहण गरून्। सेला<verse eid="PSA 20:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 20:4"/>उहाँले तपाईंको मनको इच्छा पूरा गरून्, र तपाईंका सबै योजनाहरू सफल गरून्।<verse eid="PSA 20:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 20:5"/>तपाईंको विजयमा हामी आनन्दले कराउनेछौँ, र हाम्रा परमेश्‍वरका नाममा हामी आफ्ना झण्डाहरू उच्‍च पार्नेछौँ। याहवेहले तपाईंका सबै बिन्ती पूरा गरिदेऊन्।<verse eid="PSA 20:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 20:6"/>अब मलाई थाहा भयो: याहवेहले आफ्ना अभिषिक्त जनलाई विजय दिनुहुन्छ। उहाँले आफ्नो दाहिने बाहुलीको उद्धारको शक्तिद्वारा आफ्नो पवित्र स्वर्गबाट अभिषिक्त जनलाई जवाफ दिनुहुन्छ।<verse eid="PSA 20:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 20:7"/>कोही रथहरूमा र कोही घोडाहरूमाथि भरोसा गर्दछन्, तर हामीचाहिँ याहवेह हाम्रा परमेश्‍वरको नाममा भरोसा गर्दछौँ।<verse eid="PSA 20:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 20:8"/>तिनीहरू निहुरेर भुइँमा घुँडा टेक्नेछन्, तर हामीहरूचाहिँ खडा हुनेछौँ र सीधा उभिनेछौँ।<verse eid="PSA 20:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 20:9"/>हे याहवेह, राजालाई विजय गराउनुहोस्! हामीले पुकार गर्दा हामीलाई जवाफ दिनुहोस्!<verse eid="PSA 20:9"/></para>
<chapter eid="PSA 20"/>
<chapter number="21" style="c" sid="PSA 21"/>
<para style="p"><verse number="1" style="v" sid="PSA 21:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। हे याहवेह, तपाईंको सामर्थ्यमा राजा रमाउँछन्, तपाईंले दिनुभएको विजयमा उहाँ अति धेरै आनन्दित छन्।<verse eid="PSA 21:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 21:2"/>तपाईंले उनको हृदयका इच्छा पूरा गर्नुभएको छ, र उनको ओठको बिन्ती इन्कार गर्नुभएको छैन। सेला<verse eid="PSA 21:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 21:3"/>तपाईंले उनलाई उत्तम आशिष् लिएर स्वागत गर्नुभयो। तपाईंले उनको शिरमा निखुर सुनको मुकुट पहिर्‍याइदिनुभयो।<verse eid="PSA 21:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 21:4"/>उनले तपाईंबाट जीवन मागे, र तपाईंले उनलाई दिनुभयो अर्थात्, उनलाई सदाकालको निम्ति लामो आयु दिनुभएको छ।<verse eid="PSA 21:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 21:5"/>तपाईंले दिनुभएका विजयहरूद्वारा उनको आदर र महिमा बढेको छ; तपाईंले उनलाई वैभव र ऐश्‍वर्य प्रदान गरिदिनुभएको छ।<verse eid="PSA 21:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 21:6"/>निश्‍चय नै तपाईंले उनलाई अनन्त आशिष् प्रदान गर्नुभएको छ; र तपाईंको उपस्थितिको आनन्दले उनलाई हर्षित तुल्याउनुभएको छ;<verse eid="PSA 21:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 21:7"/>किनकि राजाले याहवेहमा भरोसा राख्दछन्; सर्वोच्‍च परमेश्‍वरको अचुक प्रेमको कारण उनी अटल रहनेछन्।<verse eid="PSA 21:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 21:8"/>तपाईंका बाहुलीले आफ्ना सारा शत्रुहरूलाई हराउनुहुन्छ; तपाईंको दाहिने बाहुलीले आफ्ना वैरीहरूलाई पक्रनुहुन्छ।<verse eid="PSA 21:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 21:9"/>जब तपाईं प्रकट हुनुहुनेछ, तपाईंले शत्रुहरूलाई दन्किरहेको आगोको भट्टीमाझैँ जलाउनुहुनेछ। याहवेहले आफ्नो क्रोधमा तिनीहरूलाई निल्नुहुनेछ, र उहाँको आगोले तिनीहरूलाई भस्म पारिदिनेछ।<verse eid="PSA 21:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 21:10"/>तपाईंले तिनीहरूका सन्ततिलाई पृथ्वीबाट र मानव-जातिको बीचबाट तिनीहरूका वंशलाई नष्‍ट पार्नुहुनेछ।<verse eid="PSA 21:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 21:11"/>तिनीहरूले तपाईंको विरुद्धमा दुष्‍ट युक्ति रचे, र दुष्‍ट योजना तयार गरे तापनि तिनीहरू सफल हुनेछैनन्।<verse eid="PSA 21:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 21:12"/>किनकि जब तपाईं आफ्नो धनुषले तिनीहरूमाथि निशाना ताक्नुहुन्छ, तपाईंले तिनीहरूलाई पिठिउँ फर्काएर भाग्न बाध्य बनाउनुहुनेछ।<verse eid="PSA 21:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 21:13"/>हे याहवेह, आफ्नो शक्तिमा उच्‍च हुनुहोस्; हामी तपाईंको सामर्थ्यको बारेमा गाउने र प्रशंसा गर्नेछौँ।<verse eid="PSA 21:13"/></para>
<chapter eid="PSA 21"/>
<chapter number="22" style="c" sid="PSA 22"/>
<para style="p"><verse number="1" style="v" sid="PSA 22:1"/>सङ्गीत निर्देशकको निम्ति “प्रभातको हरिणी” को रागमा आधारित, दावीदको भजन। हे मेरा परमेश्‍वर, हे मेरा परमेश्‍वर, तपाईंले मलाई किन त्याग्नुभएको छ? मलाई बचाउनको लागि तपाईं किन धेरै टाढा हुनुहुन्छ? मेरा गुहारका शब्दहरूबाट तपाईं किन यति धेरै टाढा हुनुहुन्छ?<verse eid="PSA 22:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 22:2"/>हे मेरा परमेश्‍वर, म दिनमा पुकार्छु, तर तपाईंले जवाफ दिनुहुन्‍न; रातमा पनि मलाई विश्राम छैन।<verse eid="PSA 22:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 22:3"/>तरै पनि तपाईं पवित्र परमेश्‍वर, सिंहासनमा विराजमान हुनुहुन्छ; इस्राएलले प्रशंसा गर्ने तपाईं मात्र हुनुहुन्छ।<verse eid="PSA 22:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 22:4"/>हाम्रा पितापुर्खाले तपाईंमा नै भरोसा राखेका थिए; तिनीहरूले भरोसा राखे, र तपाईंले तिनीहरूलाई छुटकारा गर्नुभयो।<verse eid="PSA 22:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 22:5"/>तिनीहरूले तपाईंलाई पुकारे, र तपाईंले बचाउनुभयो; तिनीहरूले तपाईंमाथि भरोसा गरे, र शर्ममा परेनन्।<verse eid="PSA 22:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 22:6"/>तर म त मानिस होइनँ, एउटा किरा मात्र हुँ; सबैबाट गिल्‍ला गरिएको र मानिसहरूद्वारा अपमानित गरिएको।<verse eid="PSA 22:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 22:7"/>मलाई देख्नेहरू सबैले मेरो गिल्‍ला गर्दछन्; तिनीहरूको टाउको हल्‍लाउँदै अपमान गर्दै भन्दछन्:<verse eid="PSA 22:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 22:8"/>“त्यसले याहवेहमा भरोसा गर्दछ, याहवेहले नै त्यसलाई बचाऊन्; किनकि त्यसले उहाँमा नै रमाहट गर्दछ, उहाँले नै त्यसलाई छुटकारा देऊन्।”<verse eid="PSA 22:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 22:9"/>तपाईंले नै मलाई आमाको गर्भबाट निकाल्नुभयो; म मेरी आमाको कोखमा बालक हुँदा नै तपाईंले मलाई तपाईंमा भरोसा गर्ने तुल्याउनुभयो।<verse eid="PSA 22:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 22:10"/>मेरो जन्मदेखि नै म तपाईंमा सुम्पिएको हुँ; आमाको गर्भदेखि नै तपाईं मेरो परमेश्‍वर हुनुहुन्छ।<verse eid="PSA 22:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 22:11"/>मबाट टाढा नहुनुहोस्; किनकि सङ्कष्‍ट मेरो नजिकै छ, र मलाई सहायता गर्ने कोही पनि छैन।<verse eid="PSA 22:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 22:12"/>धेरै साँढेहरूले मलाई घेरेका छन्; बाशानका बलिया साँढेहरू मेरा चारैपट्टि छन्।<verse eid="PSA 22:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 22:13"/>गर्जने सिंहहरू, जसले आफ्नो शिकार टुक्रा-टुक्रा पार्दछन्, तिनीहरू नै मेरा विरुद्धमा आफ्ना मुख बाउँछन्।<verse eid="PSA 22:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 22:14"/>म त पानीझैँ पोखिएको छु, र मेरा सारा हड्डीहरू जोर्नीबाट खुस्केका छन्; मेरो हृदय मैनजस्तै भएको छ; त्यो मभित्रै पग्लेको छ।<verse eid="PSA 22:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 22:15"/>मेरो शक्ति माटोको खपेटोजस्तै सुकेको छ, र मेरो जिब्रो तालुमा टाँसिएको छ; तपाईंले मलाई मृत्युको धुलोमा छोडिदिनुभएको छ।<verse eid="PSA 22:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 22:16"/>कुकुरहरूले मलाई चारैतिर घेरेका छन्; खराब मानिसहरूको झुण्डले मलाई चारैपट्टि घेरेका छन्; तिनीहरूले मेरा हात र खुट्टाहरू छेडेका छन्।<verse eid="PSA 22:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 22:17"/>मेरा सबै हाडहरू म गन्‍न सक्छु; मानिसहरूले मलाई एकोहोरो लगाएर खराब दृष्‍टिले हेर्छन्।<verse eid="PSA 22:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 22:18"/>तिनीहरूले मेरा बाहिरी वस्त्रहरू एक-आपसमा बाँड्छन्, र मेरो भित्री वस्त्रको निम्ति तिनीहरूले चिट्ठा हाल्छन्।<verse eid="PSA 22:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 22:19"/>तर हे याहवेह, तपाईं मबाट टाढा नहुनुहोस्! तपाईं मेरो बल, चाँडो आएर मलाई सहायता गर्नुहोस्!<verse eid="PSA 22:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 22:20"/>तरवारबाट मलाई बचाउनुहोस्; र मेरो अमूल्य जीवन कुकुरहरूका पञ्जाबाट छुटाउनुहोस्।<verse eid="PSA 22:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 22:21"/>सिंहहरूका मुखबाट मेरो छुटकारा गर्नुहोस्; जङ्गली साँढेहरूका सिङबाट मलाई बचाउनुहोस्।<verse eid="PSA 22:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 22:22"/>म आफ्ना दाजुभाइ-दिदीबहिनीहरूका बीचमा तपाईंको नाम घोषणा गर्नेछु; मानिसहरूको भेलामा म तपाईंको प्रशंसा गर्नेछु।<verse eid="PSA 22:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 22:23"/>तिमीहरू, जो याहवेहको भय मान्दछौ, उहाँको प्रशंसा गर! याकोबका सबै वंशहरू हो, उहाँको आदर गर! हे इस्राएलका सबै सन्तानहरू हो, उहाँको भय मान!<verse eid="PSA 22:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 22:24"/>किनकि उहाँले दुःखीहरूको पीडालाई तुच्छ मान्‍नुभएको वा अवहेलना गर्नुभएको छैन; उहाँले तिनीहरूबाट आफ्नो मुहार लुकाउनुभएको छैन, तर मदतको निम्ति तिनीहरूको पुकार उहाँले सुन्‍नुभएको छ।<verse eid="PSA 22:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 22:25"/>ठूलो महासभामा मेरो प्रशंसाको विषय तपाईं नै हुनुहुन्छ; तपाईंको भय मान्‍नेहरूका सामु म आफ्नो भाकल पूरा गर्नेछु।<verse eid="PSA 22:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 22:26"/>गरिबहरू खाएर तृप्‍त हुनेछन्; याहवेहलाई खोज्नेहरूले उहाँको प्रशंसा गर्नेछन्, तिनीहरूका हृदय आनन्दले सदासर्वदा रमाउनेछ।<verse eid="PSA 22:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 22:27"/>पृथ्वीका अन्त्यसम्म रहने समस्त मानिसले याहवेहलाई सम्झना गर्नेछन्, र उहाँतर्फ फर्किनेछन्; र राष्ट्रहरूका सबै परिवारहरू उहाँको सामु निहुरिएर दण्डवत् गर्नेछन्।<verse eid="PSA 22:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 22:28"/>किनकि शासन याहवेहको हो, र उहाँले नै राष्ट्रहरूमाथि शासन गर्नुहुन्छ।<verse eid="PSA 22:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 22:29"/>पृथ्वीका सबै धनीहरू भोजन गर्दै उहाँको आराधना गर्नेछन्; जो धुलोमा मिलिजानेछन्, ती सबैले उहाँको सामु घुँडा टेक्नेछन्; जस-जसले आफूलाई बचाउन सक्दैनन्।<verse eid="PSA 22:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 22:30"/>पछि आउने पुस्ताले उहाँको सेवा गर्नेछन्; भावी सन्तानहरूलाई प्रभुको बारेमा बताइनेछ।<verse eid="PSA 22:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 22:31"/>तिनीहरूले भावी पुस्तालाई उहाँले गर्नुभएको धार्मिकताको घोषणा गर्नेछन्; उहाँले यस्तो अद्‌भुत काम गर्नुभएको छ!<verse eid="PSA 22:31"/></para>
<chapter eid="PSA 22"/>
<chapter number="23" style="c" sid="PSA 23"/>
<para style="p"><verse number="1" style="v" sid="PSA 23:1"/>दावीदको भजन। याहवेह मेरा गोठाला हुनुहुन्छ, मलाई केही कुराको घटी हुँदैन।<verse eid="PSA 23:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 23:2"/>उहाँले मलाई हरियो खर्कमा सुताउनुहुन्छ; उहाँले मलाई शान्त पानीतिर डोर्‍याउनुहुन्छ।<verse eid="PSA 23:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 23:3"/>उहाँले मेरो प्राणलाई पुनः ताजा पार्नुहुन्छ। उहाँले आफ्नो नामको खातिर मलाई धार्मिकताका मार्गहरूमा अगुवाइ गर्नुहुन्छ।<verse eid="PSA 23:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 23:4"/>मृत्युको अन्धकारमय घाटीबाट भएर जानुपरे तापनि म कुनै खतरादेखि डराउनेछैनँ; किनकि तपाईं मेरो साथमा हुनुहुन्छ; तपाईंको लहुरो र तपाईंको छडीले मलाई सान्त्वना दिन्छन्।<verse eid="PSA 23:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 23:5"/>तपाईंले मेरा शत्रुहरूको सामु, मेरो निम्ति भोज तयार पार्नुहुन्छ। तपाईंले मेरो शीरलाई तेलले अभिषेक गर्नुहुन्छ; मेरो कचौरा भरिएर पोखिन्छ।<verse eid="PSA 23:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 23:6"/>निश्‍चय नै तपाईंको भलाइ र प्रेम मेरो जीवनभरि हरेक दिन मेरो पछि लाग्नेछन्, र म सधैँभरि याहवेहको भवनमा बास गर्नेछु।<verse eid="PSA 23:6"/></para>
<chapter eid="PSA 23"/>
<chapter number="24" style="c" sid="PSA 24"/>
<para style="p"><verse number="1" style="v" sid="PSA 24:1"/>दावीदको भजन। पृथ्वी र यसमा भएका सबै थोक, यो संसार र यसमा बास गर्ने सबै प्राणीहरू याहवेहकै हुन्;<verse eid="PSA 24:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 24:2"/>किनकि उहाँले पृथ्वीलाई समुद्रमाथि बसाल्नुभयो, र पानीमाथि स्थापित गर्नुभयो।<verse eid="PSA 24:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 24:3"/>याहवेहको डाँडामा को उक्लिन सक्ला? उहाँको पवित्रस्थानमा को उभिन सक्ला?<verse eid="PSA 24:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 24:4"/>त्यही नै, जसको हात निर्दोष छ, र जसको हृदय शुद्ध छ; जसले मूर्तिमाथि भरोसा राख्दैन, अथवा जसले झूटो ईश्‍वरको नाममा शपथ खाँदैन।<verse eid="PSA 24:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 24:5"/>तिनीहरूले याहवेहबाट आशिष् पाउनेछन्, र मुक्तिदाता परमेश्‍वरले तिनीहरूलाई धर्मी ठहराउनुहुनेछ।<verse eid="PSA 24:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 24:6"/>उहाँलाई खोज्ने पुस्ताका मानिसहरू यस्तै हुन्छन्, जसले तपाईंको दर्शन खोज्दछन्, हे याकोबका परमेश्‍वर। सेला<verse eid="PSA 24:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 24:7"/>हे मूलढोकाहरू हो, आफ्ना शिर उच्‍च पार; हे सनातनका द्वारहरू हो, आफ्ना शिर उठाओ, ताकि महिमाका महाराजा प्रवेश गरून्।<verse eid="PSA 24:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 24:8"/>यी महिमाका राजा को हुनुहुन्छ? याहवेह, जो बलियो र शक्तिशाली हुनुहुन्छ, याहवेह, जो लडाइँमा पराक्रमी हुनुहुन्छ।<verse eid="PSA 24:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 24:9"/>हे मूलढोकाहरू हो, आफ्ना शिर उच्‍च पार; हे सनातनका ढोकाहरू हो, आफ्ना शिर उठाओ; ताकि महिमाका महाराजा प्रवेश गरून्।<verse eid="PSA 24:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 24:10"/>महिमाका यी राजाचाहिँ को हुनुहुन्छ? सेनाहरूका याहवेह— उहाँ नै महिमाका महाराजा हुनुहुन्छ। सेला<verse eid="PSA 24:10"/></para>
<chapter eid="PSA 24"/>
<chapter number="25" style="c" sid="PSA 25"/>
<para style="p"><verse number="1" style="v" sid="PSA 25:1"/>दावीदको भजन। हे याहवेह, मेरा परमेश्‍वर, म मेरो भरोसा तपाईंमा राख्दछु।<verse eid="PSA 25:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 25:2"/>म तपाईंमा भरोसा गर्दछु; मलाई शर्ममा पर्न नदिनुहोस्, न त मेरा शत्रुहरू ममाथि विजयी हुन पाऊन्।<verse eid="PSA 25:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 25:3"/>तपाईंमा आशा राख्ने कोही पनि कहिल्यै शर्ममा पर्नेछैन, तर कारणविना विश्‍वासघात गर्नेहरू भने शर्ममा पर्नेछन्।<verse eid="PSA 25:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 25:4"/>हे याहवेह, मलाई तपाईंका मार्गहरू देखाउनुहोस्; मलाई तपाईंका मार्गहरूका शिक्षा दिनुहोस्,<verse eid="PSA 25:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 25:5"/>मलाई तपाईंको सत्यतामा अगुवाइ गर्नुहोस् र मलाई सिकाउनुहोस्; किनकि तपाईं मेरा मुक्तिदाता परमेश्‍वर हुनुहुन्छ, अनि मेरो आशा दिनभरि नै तपाईंमा राख्दछु।<verse eid="PSA 25:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 25:6"/>हे याहवेह, तपाईंका महान् करुणा र प्रेमको स्मरण गर्नुहोस्, किनकि ती प्राचीनकालदेखि नै भएका छन्।<verse eid="PSA 25:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 25:7"/>मेरा जवानीका पापहरू र मेरा अपराधहरू स्मरण नगर्नुहोस्। हे याहवेह, तपाईंको अचुक प्रेमअनुसार मेरो सम्झना गर्नुहोस्, किनकि तपाईं भलो हुनुहुन्छ।<verse eid="PSA 25:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 25:8"/>याहवेह भलो र धर्मी हुनुहुन्छ। यसैकारण उहाँले पापीहरूलाई आफ्नो मार्ग सिकाउनुहुन्छ।<verse eid="PSA 25:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 25:9"/>उहाँले नम्रहरूलाई ठिक कुरामा अगुवाइ गर्नुहुन्छ, र तिनीहरूलाई उहाँका मार्गहरू सिकाउनुहुन्छ।<verse eid="PSA 25:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 25:10"/>याहवेहका करारका शर्तहरू पालन गर्नेहरूप्रति उहाँका सबै मार्गहरू प्रेमिलो र विश्‍वासयोग्य हुन्छन्।<verse eid="PSA 25:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 25:11"/>हे याहवेह, तपाईंको नामको खातिर, मेरो अपराध क्षमा गरिदिनुहोस्, किनकि मेरो यो अपराध अति ठूलो छ।<verse eid="PSA 25:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 25:12"/>तब याहवेहको भय कसले मान्दछ? उहाँले तिनीहरूलाई कुन मार्गको छनौट गर्ने भन्‍ने शिक्षा दिनुहुनेछ।<verse eid="PSA 25:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 25:13"/>तिनीहरूले आफ्ना जीवन समृद्धिमा बिताउनेछन्, र तिनीहरूका सन्ततिले देशमा अधिकार गर्नेछन्।<verse eid="PSA 25:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 25:14"/>उहाँको भय मान्‍नेहरूसँग याहवेहले मित्रता राख्नुहुन्छ, उहाँले तिनीहरूलाई आफ्नो करार बताउनुहुन्छ।<verse eid="PSA 25:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 25:15"/>मेरा आँखाहरू सधैँ याहवेहमा रहन्छन्, किनकि उहाँले मात्र मेरा खुट्टाहरू पासोबाट छुटाउनुहुनेछ।<verse eid="PSA 25:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 25:16"/>हे याहवेह, मतिर फर्कनुहोस् र ममाथि कृपालु हुनुहोस्, किनकि म एकलो र पीडित छु।<verse eid="PSA 25:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 25:17"/>मेरा हृदयका कष्‍टहरू ज्यादै बढेका छन्; मेरा पीडाहरूबाट मलाई छुटकारा दिनुहोस्।<verse eid="PSA 25:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 25:18"/>मेरा दुःख र मेरा पीडाहरूलाई हेर्नुहोस्, र मेरा सबै पापहरू क्षमा गरिदिनुहोस्।<verse eid="PSA 25:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 25:19"/>हेर्नुहोस्, मेरा शत्रुहरू कति धेरै भएका छन्, र कति भयानक रीतिले मलाई तिनीहरू घृणा गर्दछन्।<verse eid="PSA 25:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 25:20"/>मेरो प्राणलाई रक्षा गर्नुहोस् र मेरो उद्धार गर्नुहोस्; मलाई शर्ममा नपार्नुहोस्, किनकि म तपाईंमा शरण पर्छु।<verse eid="PSA 25:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 25:21"/>इमानदारीता र धार्मिकताले मेरो रक्षा गरून्, किनकि मेरो आशा याहवेह तपाईंमा छ।<verse eid="PSA 25:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 25:22"/>हे परमेश्‍वर, इस्राएललाई तिनीहरूका सबै कष्‍टहरूबाट मुक्त गरिदिनुहोस्!<verse eid="PSA 25:22"/></para>
<chapter eid="PSA 25"/>
<chapter number="26" style="c" sid="PSA 26"/>
<para style="p"><verse number="1" style="v" sid="PSA 26:1"/>दावीदको भजन। हे याहवेह, मलाई निर्दोष प्रमाणित गर्नुहोस्; किनकि मैले दोषरहित जीवन जिएको छु; ढलपल नभइकन मैले याहवेहमा भरोसा राखेको छु।<verse eid="PSA 26:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 26:2"/>हे याहवेह, मलाई जाँच्नुहोस्; र मेरो पारख गर्नुहोस्। मेरो हृदय र मन जाँचेर हेर्नुहोस्;<verse eid="PSA 26:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 26:3"/>किनकि तपाईंको अचुक प्रेम सधैँ मेरो सामु छ; र म तपाईंको विश्‍वासयोग्यतामा हिँडेको छु।<verse eid="PSA 26:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 26:4"/>म छली मानिसहरूसँग बस्दिनँ, न त पाखण्डीहरूसँग म सङ्गत गर्छु।<verse eid="PSA 26:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 26:5"/>कुकर्मीहरूको झुण्डलाई म घृणा गर्दछु; म दुष्‍ट काम गर्नेहरूसँग बस्‍न इन्कार गर्दछु।<verse eid="PSA 26:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 26:6"/>हे याहवेह, म आफ्ना हात निर्दोषतामा धुन्छु, र तपाईंका वेदीको परिक्रमा गर्दछु।<verse eid="PSA 26:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 26:7"/>उच्‍च सोरले म तपाईंको प्रशंसाको घोषणा गर्दछु, र म तपाईंका सबै अचम्मका कामहरूको वर्णन गर्दछु।<verse eid="PSA 26:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 26:8"/>हे याहवेह, तपाईंको वासस्थान, र तपाईंको महिमा रहने ठाउँलाई म प्रेम गर्दछु।<verse eid="PSA 26:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 26:9"/>पापीहरूसँग मेरो प्राण, रक्तपिपासुहरूसँग मेरो जीवन नलिनुहोस्;<verse eid="PSA 26:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 26:10"/>जसका हातहरू दुष्‍ट योजनाहरूले भरिएका छन्, र जसका दाहिने हात घूसले भरिएका छन्।<verse eid="PSA 26:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 26:11"/>तर म त निर्दोष जीवन जिउँछु; मेरो उद्धार गर्नुहोस् र ममाथि कृपालु हुनुहोस्।<verse eid="PSA 26:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 26:12"/>मेरा खुट्टाहरू समतल ठाउँमा खडा छन्; ठूलो महासभामा म याहवेहको प्रशंसा गर्नेछु।<verse eid="PSA 26:12"/></para>
<chapter eid="PSA 26"/>
<chapter number="27" style="c" sid="PSA 27"/>
<para style="p"><verse number="1" style="v" sid="PSA 27:1"/>दावीदको भजन। याहवेह मेरो ज्योति र मेरो मुक्ति हुनुहुन्छ; मैले कसको भय मान्‍नु? याहवेह नै मेरो जीवनको किल्‍ला हुनुहुन्छ; म कोसँग भयभीत हुनु?<verse eid="PSA 27:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 27:2"/>जब दुष्‍टहरू मलाई आक्रमण गर्न मेरो विरुद्धमा अगि बढ्छन्, जब मेरा शत्रुहरू र मेरा वैरीहरू ममाथि आइलाग्दछन्; तब तिनीहरू ठक्‍कर खाएर लड्नेछन्।<verse eid="PSA 27:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 27:3"/>सेनाले मेरो विरुद्धमा छाउनी बनाए तापनि मेरो हृदय डराउनेछैनँ; मेरो विरुद्धमा लडाइँ चले तापनि त्यस बेलामा पनि म पूरा निर्धक्‍क रहनेछु।<verse eid="PSA 27:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 27:4"/>याहवेहसँग म एउटै कुरा माग्दछु, म त्यसैको मात्र खोजी गर्दछु: कि म आजीवन याहवेहको भवनमा रहन पाऊँ, उहाँको सुन्दरता हेर्न पाऊँ, र याहवेहको भवनमा उहाँलाई खोजी गर्न पाऊँ।<verse eid="PSA 27:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 27:5"/>किनकि सङ्कष्‍टका दिनमा उहाँले मलाई उहाँको वासस्थानमा सुरक्षित राख्नुहुनेछ; उहाँले आफ्नो पवित्र वासस्थानको छहारीमा मलाई लुकाउनुहुनेछ; र एउटा चट्टानमाथि उच्‍च राख्नुहुनेछ।<verse eid="PSA 27:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 27:6"/>तब मेरो वरिपरिका शत्रुहरूमाथि मेरो शिर उच्‍च पारिनेछ; उहाँको पवित्र वासस्थानमा म आनन्दको सोर सुनाउँदै बलिदान चढाउनेछु; म भजन गाउनेछु, र याहवेहलाई प्रशंसा गर्नेछु।<verse eid="PSA 27:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 27:7"/>हे याहवेह, जब म पुकार गर्छु, मेरो सोर सुन्‍नुहोस्; ममाथि कृपालु हुनुहोस् र मलाई जवाफ दिनुहोस्।<verse eid="PSA 27:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 27:8"/>मेरो हृदयले तपाईंको विषयमा भन्दछ, “उहाँको मुहारको खोजी गर्।” हे याहवेह, म तपाईंको मुहारको खोजी गर्नेछु।<verse eid="PSA 27:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 27:9"/>मबाट तपाईंको मुहार नलुकाउनुहोस्; तपाईंको सेवकलाई क्रोधमा नहटाउनुहोस्; तपाईं मेरा सहायक हुनुभएको छ। हे परमेश्‍वर, मेरा मुक्तिदाता, मलाई नत्याग्नुहोस्; मलाई तिरस्कार नगर्नुहोस्।<verse eid="PSA 27:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 27:10"/>मेरा बुबाआमाले मलाई त्यागे तापनि याहवेहले मलाई सम्हाल्नुहुनेछ।<verse eid="PSA 27:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 27:11"/>हे याहवेह, मलाई तपाईंका मार्ग सिकाउनुहोस्; र मलाई अत्याचार गर्ने मानिसहरूको कारण, मलाई सोझो मार्गमा अगुवाइ गर्नुहोस्।<verse eid="PSA 27:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 27:12"/>मेरा वैरीहरूका इच्छामा मलाई नछोडिदिनुहोस्; किनकि मेरो विरुद्धमा झूटा साक्षीहरू खडा भएका छन्, तिनीहरू खराब आरोप लगाउँछन्।<verse eid="PSA 27:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 27:13"/>म यसमा अझ विश्‍वस्त छु: म जीवितहरूको देशमा याहवेहको भलाइ देख्नेछु।<verse eid="PSA 27:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 27:14"/>याहवेहको प्रतीक्षा गर; बलियो र हृदयमा साहसिलो होऊ; र याहवेहको प्रतीक्षा गर।<verse eid="PSA 27:14"/></para>
<chapter eid="PSA 27"/>
<chapter number="28" style="c" sid="PSA 28"/>
<para style="p"><verse number="1" style="v" sid="PSA 28:1"/>दावीदको भजन। हे याहवेह, म तपाईंलाई पुकार्दछु; तपाईं मेरा चट्टान हुनुहुन्छ, मेरो पुकार नसुनेजस्तो नगर्नुहोस्; किनकि यदि तपाईं मौन रहनुभयो भने, म चिहानमा पर्नेहरूजस्तै हुनेछु।<verse eid="PSA 28:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 28:2"/>मेरा हातहरू तपाईंको महा-पवित्रस्थानतर्फ पसार्दा, मदतको निम्ति मैले तपाईंलाई पुकार्दा, तपाईंको कृपाको निम्ति मेरो पुकार सुन्‍नुहोस्।<verse eid="PSA 28:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 28:3"/>मलाई दुष्‍टहरूसित मर्नलाई नलैजानुहोस्; ती दुष्‍ट काम गर्नेहरूसित, जो छिमेकीहरूसँग मैत्रीपूर्ण कुरा त गर्छन्, तर तिनीहरूका हृदयमा भने उनीहरूलाई क्षति पुर्‍याउने योजना गर्छन्।<verse eid="PSA 28:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 28:4"/>तिनीहरूका काम र तिनीहरूले गरेका दुष्‍ट कामअनुसारको प्रतिफल तिनीहरूलाई दिनुहोस्; तिनीहरूका हातका कामअनुसार तिनीहरूलाई प्रतिफल दिनुहोस्; र तिनीहरूले पाउनुपर्ने दण्ड तिनीहरूलाई दिनुहोस्।<verse eid="PSA 28:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 28:5"/>किनकि तिनीहरूले याहवेहका कामहरू, र उहाँका हातले गरेका कामहरूको इज्जत गर्दैनन्; उहाँले तिनीहरूलाई नष्‍ट पार्नुहुनेछ, र तिनीहरूलाई फेरि पुनर्निर्माण गर्नुहुनेछैन।<verse eid="PSA 28:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 28:6"/>याहवेहलाई प्रशंसा होस्; किनकि उहाँले कृपाको निम्ति मेरो प्रार्थना सुन्‍नुभएको छ।<verse eid="PSA 28:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 28:7"/>याहवेह मेरो बल र मेरो ढाल हुनुहुन्छ; मेरो हृदयले उहाँमा पूरा भरोसा राखेको छ, र उहाँले मलाई सहायता गर्नुभएको छ; मेरो हृदय आनन्दले उफ्रन्छ, र भजन गाएर म उहाँलाई धन्यवाद चढाउनेछु।<verse eid="PSA 28:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 28:8"/>याहवेह आफ्नो प्रजाको निम्ति शक्ति हुनुहुन्छ, र आफ्नो अभिषिक्त जनको निम्ति मुक्तिको किल्‍ला हुनुहुन्छ।<verse eid="PSA 28:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 28:9"/>तपाईंको प्रजाहरूलाई बचाउनुहोस् र तपाईंको उत्तराधिकारलाई आशिष् दिनुहोस्; तिनीहरूका गोठालो हुनुहोस् र सदाकालको निम्ति तिनीहरूलाई सम्हाल्नुहोस्।<verse eid="PSA 28:9"/></para>
<chapter eid="PSA 28"/>
<chapter number="29" style="c" sid="PSA 29"/>
<para style="p"><verse number="1" style="v" sid="PSA 29:1"/>दावीदको भजन। हे स्वर्गदूतहरू हो, याहवेहको गुणगान गर। याहवेहलाई महिमा र शक्तिको श्रेय देओ।<verse eid="PSA 29:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 29:2"/>याहवेहलाई उहाँको नाम अनुसारको महिमा देओ; याहवेहलाई उहाँको पवित्रतामा सुशोभित भएर आराधना गर।<verse eid="PSA 29:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 29:3"/>याहवेहको आवाज पानीहरूमाथि प्रतिध्वनि हुँदछ; महिमाका परमेश्‍वर गर्जनुहुन्छ; याहवेह शक्तिशाली पानीहरूमाथि गर्जनुहुन्छ।<verse eid="PSA 29:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 29:4"/>याहवेहको आवाज शक्तिशाली छ; याहवेहको आवाज प्रतापी छ।<verse eid="PSA 29:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 29:5"/>याहवेहको आवाजले देवदारुका काठहरू भाँचिन्छन्; याहवेहले लेबनानका देवदारुका काठहरूलाई टुक्रा-टुक्रा पारिदिनुहुन्छ।<verse eid="PSA 29:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 29:6"/>उहाँले लेबनानलाई एउटा बाछाझैँ, र सिरिओनलाई जवान जङ्गली साँढेझैँ उफ्रन लगाउनुहुन्छ।<verse eid="PSA 29:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 29:7"/>याहवेहको आवाजले बिजुलीका चमकझैँ प्रहार गर्छ।<verse eid="PSA 29:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 29:8"/>याहवेहको आवाजले मरुभूमिलाई हल्‍लाउँदछ; याहवेहले कादेशको मरुभूमिलाई थर्कमान पार्नुहुन्छ।<verse eid="PSA 29:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 29:9"/>याहवेहको आवाजले फलाँटका रूखहरूलाई बङ्ग्याइदिन्छ, र जङ्गललाई लाछलुछ पारेर उजाड पारिदिन्छ। उहाँको भवनमा सबै जना “महिमा!” भन्दै कराउँछन्।<verse eid="PSA 29:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 29:10"/>याहवेह बाढी माथिको सिंहासनमा विराजमान हुनुहुन्छ; याहवेह राजा भई सदासर्वदै सिंहासनमा विराजमान हुनुहुन्छ।<verse eid="PSA 29:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 29:11"/>याहवेहले आफ्ना मानिसहरूलाई शक्ति प्रदान गर्नुहुन्छ; याहवेहले आफ्ना मानिसहरूलाई शान्तिको आशिष् दिनुहुन्छ।<verse eid="PSA 29:11"/></para>
<chapter eid="PSA 29"/>
<chapter number="30" style="c" sid="PSA 30"/>
<para style="p"><verse number="1" style="v" sid="PSA 30:1"/>मन्दिर समर्पणको निम्ति गीत; दावीदको भजन। हे याहवेह, म तपाईंलाई उच्‍च पार्नेछु; किनकि तपाईंले मलाई गहिराइबाट माथि उचाल्नुभएको छ, र मेरा शत्रुहरूलाई ममाथि विजय हुन दिनुभएको छैन।<verse eid="PSA 30:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 30:2"/>हे याहवेह, मेरा परमेश्‍वर, मैले तपाईंलाई सहायताको निम्ति पुकारेँ, र तपाईंले मलाई निको पार्नुभयो।<verse eid="PSA 30:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 30:3"/>हे याहवेह, तपाईंले मलाई पातालबाट माथि निकालेर ल्याउनुभएको छ; तपाईंले मलाई चिहानमा जानदेखि बचाउनुभएको छ।<verse eid="PSA 30:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 30:4"/>हे याहवेहका पवित्र जनहरू हो, उहाँको स्तुति गाओ; उहाँको पवित्र नामको स्तुति गर।<verse eid="PSA 30:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 30:5"/>किनकि उहाँको क्रोध क्षणभरको निम्ति मात्र रहन्छ; तर उहाँको कृपादृष्‍टि जीवनभरि नै रहन्छ; रुवाइ रातभरि मात्र रहन्छ, तर बिहान आनन्द आइहाल्छ।<verse eid="PSA 30:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 30:6"/>जब मैले आफूलाई सुरक्षित पाएँ, तब मैले भनेँ, “म कहिल्यै ढलपल हुनेछैनँ।”<verse eid="PSA 30:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 30:7"/>हे याहवेह, जब तपाईंले ममाथि आफ्नो कृपादृष्‍टि राख्नुभयो, तब तपाईंले मलाई पहाड समान स्थिर पार्नुभयो; तर जब तपाईंले आफ्नो मुहार लुकाउनुभयो, म निराश भएँ।<verse eid="PSA 30:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 30:8"/>हे याहवेह, तपाईंलाई मैले पुकारेँ; प्रभुलाई मैले दयाको निम्ति बिन्ती गरेँ;<verse eid="PSA 30:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 30:9"/>“यदि मेरो विनाश भयो भने, यदि म चिहानमा गएँ भने के लाभ हुन्छ र? के धुलोले तपाईंको प्रशंसा गर्छ र? के त्यसले तपाईंको विश्‍वसनीयताको घोषणा गर्छ र?<verse eid="PSA 30:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 30:10"/>हे याहवेह, मेरो बिन्ती सुन्‍नुहोस् र ममाथि कृपालु हुनुहोस्; हे याहवेह, तपाईं मेरो सहायक बन्‍नुहोस्।”<verse eid="PSA 30:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 30:11"/>तपाईंले मेरो विलापलाई उल्‍लासमय नाचमा परिवर्तन गर्नुभयो; तपाईंले मेरो शरीरबाट भाङ्ग्राको वस्त्र हटाइदिनुभयो र आनन्दको वस्त्र पहिर्‍याइदिनुभयो,<verse eid="PSA 30:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 30:12"/>ताकि मेरो हृदयले तपाईंको स्तुतिगान गरोस् र चुप नलागोस्। हे याहवेह, मेरा परमेश्‍वर, म सदासर्वदा तपाईंलाई प्रशंसा चढाउनेछु।<verse eid="PSA 30:12"/></para>
<chapter eid="PSA 30"/>
<chapter number="31" style="c" sid="PSA 31"/>
<para style="p"><verse number="1" style="v" sid="PSA 31:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। हे याहवेह, मैले तपाईंमा शरण लिएको छु; मलाई कहिल्यै पनि शर्ममा पर्न नदिनुहोस्। तपाईंको धार्मिकतामा मलाई छुटाउनुहोस्।<verse eid="PSA 31:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 31:2"/>मेरो पुकार सुन्‍न आफ्नो कान मतिर फर्काउनुहोस्; मेरो उद्धार गर्नलाई चाँडो आउनुहोस्; तपाईं मेरो शरण लिने चट्टान हुनुहोस्, मलाई बचाउने बलियो किल्‍ला तपाईं नै हुनुहोस्।<verse eid="PSA 31:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 31:3"/>तपाईं मेरो चट्टान र मेरो किल्‍ला हुनुभएकोले, तपाईंको नामको खातिर मलाई अगुवाइ गर्नुहोस् र डोर्‍याउनुहोस्।<verse eid="PSA 31:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 31:4"/>मेरो निम्ति गुप्‍तमा थापिएको पासोबाट मलाई छुटाउनुहोस्; किनकि तपाईं नै मेरो शरणस्थान हुनुहुन्छ।<verse eid="PSA 31:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 31:5"/>तपाईंकै हातमा मेरो आत्मा सुम्पन्छु; हे याहवेह, हे मेरा विश्‍वासयोग्य परमेश्‍वर, मेरो उद्धार गर्नुहोस्।<verse eid="PSA 31:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 31:6"/>व्यर्थका मूर्तिहरूमा मन लगाउनेहरूलाई म घृणा गर्दछु; तर मचाहिँ याहवेहमा नै भरोसा राख्दछु।<verse eid="PSA 31:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 31:7"/>म तपाईंको अचुक प्रेममा आनन्दित र हर्षित हुनेछु, किनकि तपाईंले मेरो पीडा देख्नुभयो, र मेरो प्राणको व्यथालाई जान्‍नुभएको छ।<verse eid="PSA 31:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 31:8"/>तपाईंले मलाई शत्रुका हातमा पर्न दिनुभएको छैन; तर तपाईंले मेरा पाउलाई फराकिलो ठाउँमा खडा गर्नुभएको छ।<verse eid="PSA 31:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 31:9"/>हे याहवेह, ममाथि कृपालु हुनुहोस्; किनकि म सङ्कष्‍टमा परेको छु; शोकले गर्दा मेरा आँखा कमजोर भएका छन्, अनि मेरो प्राण र मेरो शरीर शोकमा छन्।<verse eid="PSA 31:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 31:10"/>मेरो जीवन वेदनामा जलेको छ, र मेरो आयुचाहिँ सुस्केरामा बितेका छन्; मेरो अधर्मको कारणले मेरो बल घटेको छ, र मेरा हाडहरू कमजोर भइसकेका छन्।<verse eid="PSA 31:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 31:11"/>मेरा सारा शत्रुहरूका कारणले गर्दा, म मेरा छिमेकीहरूका निम्ति घृणाको पात्र बनेको छु, मेरा सबै हितैषी मित्रहरूका निम्ति म एक डरको कारण भएको छु, मलाई बाटोमा देख्नेहरू, मबाट टाढा भाग्दछन्।<verse eid="PSA 31:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 31:12"/>मरिसकेको मानिसलाई झैँ मलाई तिनीहरूले बिर्सेका छन्; म एक फुटेको भाँडाझैँ भएको छु।<verse eid="PSA 31:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 31:13"/>किनकि धेरैले मेरो विरुद्धमा कानेखुसी गरेको मैले सुनेको छु, “चारैपट्टि मेरो निम्ति खतरा मात्र छ।” तिनीहरूले मेरो विरुद्धमा जाल बनाउँदछन्, र मेरो प्राण लिनलाई तिनीहरू षड्यन्त्र रच्दछन्।<verse eid="PSA 31:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 31:14"/>तर हे याहवेह, म तपाईंमा नै भरोसा राख्छु; म भन्छु, “तपाईं नै मेरो परमेश्‍वर हुनुहुन्छ।”<verse eid="PSA 31:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 31:15"/>मेरा समयहरू तपाईंकै हातमा छन्; मलाई खेदो गर्ने, मेरा शत्रुहरूका हातबाट मलाई छुटाउनुहोस्!<verse eid="PSA 31:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 31:16"/>तपाईंको मुहार आफ्नो सेवकमाथि चम्काउनुहोस्; तपाईंको अचुक प्रेममा मलाई बचाउनुहोस्!<verse eid="PSA 31:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 31:17"/>हे याहवेह, मैले शर्माउन नपरोस्, किनकि मैले तपाईंलाई पुकारेको छु; तर दुष्‍टहरू शर्ममा परून्, र तिनीहरू पातालमा चुपचाप रहून्।<verse eid="PSA 31:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 31:18"/>तिनीहरूका झूटो बोल्ने ओठहरू चुप होऊन्, किनकि घमण्ड र अवहेलनासाथ, तिनीहरू धर्मीहरूका विरुद्धमा अहङ्कारी भई बोल्छन्।<verse eid="PSA 31:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 31:19"/>तपाईंका भलाइ कति प्रशस्त छन्, जसलाई तपाईंको भय मान्‍नेहरूका निम्ति तपाईंले भण्डार गर्नुभएको छ, तपाईंले सबै मानिसहरूका सामु तपाईंमा शरण पर्नेहरूलाई ती दिनुभएको छ।<verse eid="PSA 31:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 31:20"/>तपाईंको उपस्थितिको छहारीमा, तपाईंले तिनीहरूलाई मानिसहरूको षड्यन्त्रबाट लुकाउनुहुन्छ; तपाईंले तिनीहरूलाई दोष लगाउने जिब्राहरूबाट आफ्नो वासस्थानमा सुरक्षित राख्नुहुन्छ।<verse eid="PSA 31:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 31:21"/>याहवेहको प्रशंसा होस्; किनकि म शत्रुहरूको घेरामा परेको सहरभित्र हुँदा, उहाँले आफ्नो अद्‌भुत प्रेम ममाथि देखाउनुभयो।<verse eid="PSA 31:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 31:22"/>म आत्तिएको बेलामा मैले भनेँ, “तपाईंको दृष्‍टिबाट हराएको छु।” तर जब मैले तपाईंलाई गुहारको निम्ति पुकारेँ, तब तपाईंले मेरो दयाको पुकार सुनिदिनुभयो।<verse eid="PSA 31:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 31:23"/>हे सबै विश्‍वासयोग्यहरू हो, याहवेहलाई प्रेम गर। याहवेहले आफ्ना विश्‍वासयोग्यहरूलाई रक्षा गर्नुहुन्छ। तर अहङ्कारीहरूलाई चाहिँ उहाँले पूरा दण्ड दिनुहुन्छ।<verse eid="PSA 31:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 31:24"/>हे सबै याहवेहमा आशा राख्नेहरू हो, बलियो र साहसिलो होओ।<verse eid="PSA 31:24"/></para>
<chapter eid="PSA 31"/>
<chapter number="32" style="c" sid="PSA 32"/>
<para style="p"><verse number="1" style="v" sid="PSA 32:1"/>दावीदको मस्किल।* धन्य हो त्यो मानिस, जसका अपराधहरू क्षमा भएका छन्; जसका पापहरू ढाकिएका छन्।<verse eid="PSA 32:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 32:2"/>त्यो मानिस धन्यको हो, जसको पापको लेखा याहवेहले राख्नुहुन्‍न, जसको मनमा कुनै छलकपट छैन।<verse eid="PSA 32:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 32:3"/>जब म आफ्नो पाप स्वीकार नगरी मौन रहेँ, तब मेरो दिनभरिको विलौनाले गर्दा मेरा हाडहरू मक्‍किए।<verse eid="PSA 32:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 32:4"/>किनकि दिनरात तपाईंको बाहुलीको भार ममाथि रह्‍यो; मेरो शरीरको शक्ति गर्मीको तापलेझैँ सुकिगएको छ। सेला<verse eid="PSA 32:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 32:5"/>तब मैले आफ्नो पाप तपाईंको सामु स्वीकार गरेँ, र मेरो अधर्म लुकाइ राखिनँ। मैले भनेँ, “म याहवेहको सामु मेरो अपराधहरू स्वीकार गर्नेछु।” र तपाईंले मेरो पापको दोष क्षमा गर्नुभयो। सेला<verse eid="PSA 32:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 32:6"/>यसकारण, जबसम्म तपाईंलाई भेट्न सकिन्छ, सबै भक्तजनहरूले तपाईंमा प्रार्थना गरून्; निश्‍चय नै उर्लेको डरलाग्दो भेलले तिनीहरूलाई छुनेछैन।<verse eid="PSA 32:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 32:7"/>तपाईं मेरो लुक्ने ठाउँ हुनुहुन्छ; तपाईंले मलाई सङ्कष्‍टबाट रक्षा गर्नुहुन्छ; तपाईंले मलाई उद्धारका गीतले चारैतिर घेर्नुहुन्छ। सेला<verse eid="PSA 32:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 32:8"/>म तँलाई शिक्षा दिनेछु; र तँ कुन मार्गमा हिँड्नुपर्ने हो, सो तँलाई सिकाउनेछु; म तँलाई सल्‍लाह दिनेछु, र तँमाथि मेरो नजर राख्नेछु।<verse eid="PSA 32:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 32:9"/>घोडा वा खच्‍चरझैँ नहोऊ, जसको समझशक्ति हुँदैन, जसलाई रोक्न लगाम र डोकरी चाहिन्छ, नत्रता तिनीहरू तेरो वशमा आउनेछैनन्।<verse eid="PSA 32:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 32:10"/>दुष्‍टहरूले धेरै कष्‍ट भोग्छन्, तर याहवेहमा भरोसा राख्नेहरूलाई उहाँको अचुक प्रेमले चारैतिर घेर्दछ।<verse eid="PSA 32:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 32:11"/>हे धर्मी जनहरू हो, याहवेहमा आनन्दित होओ र हर्ष मनाओ; सोझो मन भएकाहरू हो, तिमीहरू सबैले आनन्दसाथ जयजयकार गर!<verse eid="PSA 32:11"/></para>
<chapter eid="PSA 32"/>
<chapter number="33" style="c" sid="PSA 33"/>
<para style="p"><verse number="1" style="v" sid="PSA 33:1"/>हे धर्मी जनहरू हो, याहवेहमा आनन्दसाथ गाओ; सोझो मन भएकाहरूले उहाँको स्तुति गर्न सुहाउँछ।<verse eid="PSA 33:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 33:2"/>वीणा बजाएर याहवेहको प्रशंसा गर; दसतारे वीणा बजाएर उहाँका लागि सङ्गीत बजाओ।<verse eid="PSA 33:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 33:3"/>उहाँको निम्ति एउटा नयाँ गीत गाओ; निपुणतासाथ बाजाहरू बजाओ र आनन्दको जयजयकार गर।<verse eid="PSA 33:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 33:4"/>किनकि याहवेहको वचन ठिक र सत्य छ; उहाँ आफ्ना सबै कामहरूमा विश्‍वासयोग्य हुनुहुन्छ।<verse eid="PSA 33:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 33:5"/>याहवेहले धार्मिकता र न्यायलाई मन पराउनुहुन्छ; उहाँको अचुक प्रेमले पृथ्वी भरिपूर्ण छ।<verse eid="PSA 33:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 33:6"/>याहवेहको वचनद्वारा आकाशहरू बनिए, उहाँकै मुखको सासले सूर्य, चन्द्र र ताराहरू बनिए।<verse eid="PSA 33:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 33:7"/>उहाँले समुद्रको पानीलाई जम्मा गरेर एक थुप्रो पार्नुहुन्छ; उहाँले सागरहरूलाई भण्डारगृहमा राख्नुहुन्छ।<verse eid="PSA 33:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 33:8"/>सारा पृथ्वीले याहवेहको डर मानोस्; संसारका सारा मानिसहरू, उहाँको भयमा स्थिर भई खडा होऊन्।<verse eid="PSA 33:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 33:9"/>किनकि उहाँले बोल्नुभयो र पृथ्वी अस्तित्वमा आयो; उहाँको आज्ञाले पृथ्वी स्थिर भयो।<verse eid="PSA 33:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 33:10"/>याहवेहले राष्ट्रहरूका योजनाहरू रद्द तुल्याउनुहुन्छ; उहाँले मानिसहरूका उद्देश्यलाई विफल तुल्याउनुहुन्छ।<verse eid="PSA 33:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 33:11"/>तर याहवेहका योजनाहरू सदासर्वदा स्थिर रहन्छन्; उहाँका हृदयका विचारहरू पुस्तौँसम्म रहिरहन्छन्।<verse eid="PSA 33:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 33:12"/>धन्यको हो त्यो राष्ट्र, जसका परमेश्‍वर याहवेह हुनुहुन्छ, ती प्रजा, जसलाई आफ्नो उत्तराधिकारको निम्ति उहाँले चुन्‍नुभएको छ।<verse eid="PSA 33:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 33:13"/>याहवेहले स्वर्गबाट तल हेर्नुहुन्छ; उहाँले सबै मानव-जातिलाई देख्नुहुन्छ।<verse eid="PSA 33:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 33:14"/>उहाँले आफ्नो वासस्थानबाट तल पृथ्वीका सारा बासिन्दाहरूमाथि नजर लगाउनुहुन्छ।<verse eid="PSA 33:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 33:15"/>उहाँले नै सबैको हृदयको रचना गर्नुहुन्छ, तिनीहरूका सबै कामको विचार गर्नुहुन्छ।<verse eid="PSA 33:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 33:16"/>कुनै पनि राजाले उसको ठूलो सेनाद्वारा विजय पाउन सक्दैन; कुनै पनि योद्धा उसको ठूलो शक्तिद्वारा उम्कन सक्दैन।<verse eid="PSA 33:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 33:17"/>घोडामाथि छुटकाराको आशा राख्नु व्यर्थ छ; त्यसका सबै ठूला ताकतले पनि बचाउन सक्दैन।<verse eid="PSA 33:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 33:18"/>तर याहवेहको नजर उहाँका भय मान्‍नेहरूमाथि रहन्छ; तिनीहरूमाथि, जसको आशा उहाँको अचुक प्रेममाथि हुन्छ,<verse eid="PSA 33:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 33:19"/>तिनीहरूका प्राणलाई मृत्युबाट छुटकारा गराउन र अनिकालको समयमा तिनीहरूलाई जीवित राख्न।<verse eid="PSA 33:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 33:20"/>हाम्रो अन्तस्करणले याहवेहको बाटो हेर्दछौँ; उहाँ नै हाम्रो सहायक र हाम्रो ढाल हुनुहुन्छ।<verse eid="PSA 33:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 33:21"/>उहाँमा नै हाम्रा हृदय रमाउँछन्; किनकि हामी उहाँको पवित्र नाममा भरोसा राख्दछौँ।<verse eid="PSA 33:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 33:22"/>हे याहवेह, हामीले हाम्रो आशा तपाईंमा राखेअनुसार, तपाईंको अचुक प्रेम हामीमाथि रहोस्।<verse eid="PSA 33:22"/></para>
<chapter eid="PSA 33"/>
<chapter number="34" style="c" sid="PSA 34"/>
<para style="p"><verse number="1" style="v" sid="PSA 34:1"/>अबीमेलेकको सामु बौलाहा हुँ भनी दावीदले बहाना गरेको र तिनीद्वारा उनलाई धपाइएको समयको दावीदको भजन। हर समय म याहवेहलाई स्तुति गर्नेछु; उहाँको प्रशंसा मेरो मुखमा निरन्तर हुनेछ।<verse eid="PSA 34:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 34:2"/>याहवेहमा नै मेरो अन्तस्करणले गर्व गर्नेछ; कष्‍टमा परेकाहरू यो सुनून्, र खुशी होऊन्।<verse eid="PSA 34:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 34:3"/>मसँगसँगै याहवेहको महिमा गर; हामी मिलेर उहाँको नामलाई उच्‍च पारौँ।<verse eid="PSA 34:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 34:4"/>मैले याहवेहको खोजी गरेँ; र उहाँले मलाई जवाफ दिनुभयो, उहाँले मेरा सबै डरहरूबाट मलाई छुटाउनुभयो।<verse eid="PSA 34:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 34:5"/>उहाँलाई हेर्नेहरू उज्ज्वल हुन्छन्; तिनीहरूका अनुहार कहिल्यै शर्ममा पर्दैन।<verse eid="PSA 34:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 34:6"/>यस गरिब मानिसले याहवेहलाई पुकार गर्‍यो, र उहाँले त्यसलाई सुन्‍नुभयो; उहाँले त्यसका सबै सङ्कष्‍टहरूबाट बचाउनुभयो।<verse eid="PSA 34:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 34:7"/>याहवेहका स्वर्गदूतहरूले उहाँको डर मान्‍नेहरूका चारैतिर सुरक्षाको घेरा लगाउँछन्, र उहाँले तिनीहरूलाई छुटकारा दिनुहुन्छ।<verse eid="PSA 34:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 34:8"/>याहवेहलाई जाँच गरेर हेर कि उहाँ कति असल हुनुहुन्छ! धन्य हुन् तिनीहरू, जसले उहाँमा शरण लिन्छन्।<verse eid="PSA 34:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 34:9"/>हे याहवेहका पवित्र जनहरू हो, उहाँको डर मान; किनकि उहाँको डर मान्‍नेहरूलाई केही कुराको खाँचो पर्दैन।<verse eid="PSA 34:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 34:10"/>जवान सिंहहरू कमजोर हुन सक्छन् र तिनीहरू भोकाउन सक्छन्; तर याहवेहको खोजी गर्नेहरूलाई कुनै असल कुराको अभाव हुँदैन।<verse eid="PSA 34:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 34:11"/>हे मेरा बालबालिकाहरू हो, आओ र मेरा कुरा सुन। म तिमीहरूलाई याहवेहको भय सिकाउनेछु।<verse eid="PSA 34:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 34:12"/>तिमीहरूमध्ये कसैले जीवनलाई प्रेम गर्दछ, दीर्घायु र असल दिनहरू देख्ने इच्छा गर्दछ भने<verse eid="PSA 34:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 34:13"/>आफ्नो जिब्रोलाई खराब कुरादेखि र आफ्नो ओठलाई झूटो बोल्नदेखि अलग राख!<verse eid="PSA 34:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 34:14"/>दुष्‍टताबाट अलग बस र भलाइ गर; शान्ति खोज, र त्यसको पछि लाग।<verse eid="PSA 34:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 34:15"/>याहवेहको नजर धर्मीहरूमाथि रहन्छ, र उहाँका कान तिनीहरूका पुकार सुन्‍नलाई खुल्‍ला हुन्छन्।<verse eid="PSA 34:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 34:16"/>तर याहवेहको अनुहार खराबी गर्नेहरूका विरुद्धमा हुन्छ, अनि उहाँले तिनीहरूको स्मृतिसमेत धर्तीबाट मेटाइदिनुहुन्छ।<verse eid="PSA 34:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 34:17"/>धर्मी जनहरूले पुकार गर्दछन्, याहवेहले तिनीहरूको पुकार सुन्‍नुहुन्छ; तिनीहरूका सबै सङ्कष्‍टबाट तिनीहरूलाई उद्धार गर्नुहुन्छ।<verse eid="PSA 34:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 34:18"/>याहवेह हृदय टुटेकाहरू सबैका नजिक हुनुहुन्छ, र आत्मामा पिसिएकाहरूलाई उहाँले बचाउनुहुन्छ।<verse eid="PSA 34:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 34:19"/>धर्मी मानिसलाई धेरै विपत्तिहरू आइलाग्दछन्, तर याहवेहले त्यसलाई ती सबै विपत्तिबाट उद्धार गर्नुहुन्छ;<verse eid="PSA 34:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 34:20"/>याहवेहले त्यसका सबै हाडहरूको रक्षा गर्नुहुन्छ; तिनमा एउटै हाड पनि भाँचिनेछैन।<verse eid="PSA 34:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 34:21"/>खराबीले दुष्‍टलाई मार्दछ; धर्मी जनका शत्रुहरूचाहिँ दोषी ठहरिनेछन्।<verse eid="PSA 34:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 34:22"/>याहवेहले आफ्ना सेवकहरूलाई उद्धार गर्नुहुन्छ; उहाँमा शरण पर्ने कोही पनि दोषी ठहरिनेछैन।<verse eid="PSA 34:22"/></para>
<chapter eid="PSA 34"/>
<chapter number="35" style="c" sid="PSA 35"/>
<para style="p"><verse number="1" style="v" sid="PSA 35:1"/>दावीदको भजन। हे याहवेह, मलाई विरोध गर्नेहरूको विरोध गरिदिनुहोस्; मसँग युद्ध गर्नेहरूका विरुद्धमा युद्ध गरिदिनुहोस्।<verse eid="PSA 35:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 35:2"/>ढाल लिनुहोस् र कवच पहिरनुहोस्; उठ्नुहोस् र मेरो सहायताको निम्ति खडा हुनुहोस्।<verse eid="PSA 35:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 35:3"/>मलाई खेद्नेहरूका विरुद्धमा तपाईंको भाला र बर्छा उठाउनुहोस्। मलाई भन्‍नुहोस्, “म तेरो मुक्ति हुँ।”<verse eid="PSA 35:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 35:4"/>मेरो प्राण लिन खोज्नेहरू अपमानित होऊन् र शर्ममा परून्; मेरा विरुद्धमा हानि रच्नेहरू पछाडि फर्कून् र शर्ममा परून्।<verse eid="PSA 35:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 35:5"/>याहवेहका स्वर्गदूतले तिनीहरूलाई टाढा लखेटून्; तिनीहरू बतासले उडाएका भुसजस्ता होऊन्।<verse eid="PSA 35:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 35:6"/>याहवेहका स्वर्गदूतले तिनीहरूलाई लखेटिरहून्; तिनीहरूको बाटो अँध्यारो र चिप्लो होस्।<verse eid="PSA 35:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 35:7"/>किनकि कारणविना तिनीहरूले मलाई फसाउनलाई पासो बिछाए; र कारणविना मलाई फसाउनलाई तिनीहरूले खाडल खने,<verse eid="PSA 35:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 35:8"/>अचानक तिनीहरूमाथि विनाश आइपरोस्; तिनीहरूले लुकाएर थापेको पासोमा तिनीहरू आफैँ परून्, तिनीहरूले खनेका खाडलमा आफैँ परेर नष्‍ट होऊन्।<verse eid="PSA 35:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 35:9"/>तब मेरो प्राणचाहिँ याहवेहमा आनन्दित हुनेछ, र उहाँको मुक्तिमा हर्षित हुनेछ।<verse eid="PSA 35:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 35:10"/>मेरो पूरा बलले भन्‍नेछु, “हे याहवेह, तपाईंजस्तो को छ र? तपाईंले दुर्बलहरूलाई तिनीहरूभन्दा शक्तिशालीहरूबाट बचाउनुहुन्छ, अनि दुर्बल र खाँचोमा परेकाहरूलाई लुटेराहरूबाट बचाउनुहुन्छ।”<verse eid="PSA 35:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 35:11"/>निर्दयी साक्षीहरू अगि आउँछन्; तिनीहरूले मैले जान्दै नजानेका कुराहरू मलाई सोध्छन्।<verse eid="PSA 35:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 35:12"/>तिनीहरूले मलाई भलाइको बदलामा खराबी गर्छन्, तपाईंले मेरो प्राणलाई आफन्त गुमाएझैँ शोकमा डुबाउनुभएको छ।<verse eid="PSA 35:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 35:13"/>तापनि जब तिनीहरू बिरामी भए, मैले भाङ्ग्राको वस्त्र लगाएँ; र उपवास बसेर आफूलाई दुःखित बनाएँ, जब मेरा प्रार्थना उत्तरविना नै फर्केर आयो,<verse eid="PSA 35:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 35:14"/>मेरा मित्र वा भाइको निम्ति शोक गरेझैँ, म तिनीहरूको निम्ति शोक गर्दै हिँडेँ। आफ्नी आमाको निम्ति विलाप गरेझैँ मैले शोकमा शिर झुकाएँ।<verse eid="PSA 35:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 35:15"/>तर जब मैले ठेस खाएँ, तिनीहरू मेरो विरुद्धमा एकमत भएर हाँसो गरे; मैले थाहै नपाई आक्रमणकारीहरू मेरो विरुद्धमा जम्मा भए। तिनीहरूले नथाकी लगातार मेरो निन्दा गरे।<verse eid="PSA 35:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 35:16"/>भक्तिहीनलेझैँ तिनीहरूले क्रूरतासाथ निन्दा गरे; तिनीहरूले ममाथि दाह्रा किटे।<verse eid="PSA 35:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 35:17"/>हे प्रभु, कहिलेसम्म तपाईं हेरिरहनुहुन्छ? तिनीहरूका आक्रमणबाट, र ती सिंहहरूबाट मलाई छुटाउनुहोस्।<verse eid="PSA 35:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 35:18"/>म तपाईंलाई ठूलो महासभामा धन्यवाद चढाउनेछु; विशाल जनसमूहमा म तपाईंको प्रशंसा गर्नेछु।<verse eid="PSA 35:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 35:19"/>मेरा शत्रुहरू कारणविना मेरो विरुद्धमा रमाउन नपाऊन्; मलाई घृणा गर्नेहरूले कारणविना एकनासै मेरो खिल्‍ली गर्न नपाऊन्।<verse eid="PSA 35:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 35:20"/>तिनीहरू त शान्तिको कुरै गर्दैनन्; तर देशमा शान्तिसँग बस्‍ने मानिसहरूका विरुद्धमा झूटो आरोपहरू रच्दछन्।<verse eid="PSA 35:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 35:21"/>तिनीहरूले ठूलो मुख बाएर मेरो विरुद्धमा भन्छन्, “ओहो! ओहो! हामीले आफ्नै आँखाले यो देख्न पायौँ।”<verse eid="PSA 35:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 35:22"/>हे याहवेह, तपाईंले यो देख्नुभएको छ; अब चुप लागेर नबस्‍नुहोस्। हे प्रभु, मदेखि टाढा नहुनुहोस्!<verse eid="PSA 35:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 35:23"/>हे प्रभु, मेरा परमेश्‍वर, उठ्नुहोस्; र मेरो रक्षाको निम्ति जाग्नुहोस्! मेरो निम्ति लडिदिनुहोस्।<verse eid="PSA 35:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 35:24"/>हे याहवेह, मेरा परमेश्‍वर, तपाईंको धार्मिकतामा मलाई निर्दोष ठहराउनुहोस्; तिनीहरू ममाथि रमाउन नपाऊन्।<verse eid="PSA 35:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 35:25"/>तिनीहरूले आफ्ना मनमा भन्‍न नपाऊन् कि, “आहा! हामीले चिताएजस्तै पुग्यो!” अथवा भन्‍न नपाऊन्, “हामीले त्यसलाई निलिदियौँ।”<verse eid="PSA 35:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 35:26"/>मेरो विपतको समयमा मेरो हाँसो उडाउनेहरू सबै लाजमा र अन्योलमा परून्; मभन्दा ठूलो हुँ भनी घमण्डले धाक दिनेहरू सबै शर्म र अपमानले ढाकिऊन्।<verse eid="PSA 35:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 35:27"/>म निर्दोष साबित भएको कामना राख्नेहरू आनन्दले जयजयकार गरून् र हर्षित होऊन्; तिनीहरूले निरन्तर यसो भनिरहून् कि, “याहवेह उच्‍च पारिनुभएको होस्, उहाँ, जो आफ्नो सेवकको भलाइमा प्रसन्‍न हुनुहुन्छ।”<verse eid="PSA 35:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 35:28"/>मेरो जिब्रोले तपाईंको धार्मिकताको घोषणा गर्नेछ, र तपाईंको प्रशंसा दिनभरि गरिरहनेछ।<verse eid="PSA 35:28"/></para>
<chapter eid="PSA 35"/>
<chapter number="36" style="c" sid="PSA 36"/>
<para style="p"><verse number="1" style="v" sid="PSA 36:1"/>सङ्गीत निर्देशकको निम्ति, याहवेहको सेवक दावीदको भजन। दुष्‍टका पाप सम्बन्धी, मेरो हृदयमा परमेश्‍वरको एक सन्देश छ: तिनीहरूका आँखामा परमेश्‍वरको डर छैन।<verse eid="PSA 36:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 36:2"/>तिनीहरूले आफूलाई आफ्नो नजरमा उच्‍च ठान्छन्, तिनीहरूले आफ्ना अधर्म फेला पार्दैनन् वा आफ्ना पाप घृणा गर्दैनन्।<verse eid="PSA 36:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 36:3"/>तिनीहरूका मुखका शब्दहरू दुष्‍ट र छली छन्; तिनीहरू बुद्धिमानी हुन र भलाइको काम गर्न चुकेका छन्।<verse eid="PSA 36:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 36:4"/>तिनीहरूले आफ्ना ओछ्यानमा पनि कुकर्मको योजना बनाउँछन्; तिनीहरूले आफूलाई कुमार्गतिर लगाउँछन्; र तिनीहरूले खराबीलाई इन्कार गर्दैनन्।<verse eid="PSA 36:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 36:5"/>हे याहवेह, तपाईंको अचुक प्रेम स्वर्गैसम्म फैलिएको छ, तपाईंको विश्‍वासयोग्यता आकाशसम्मै छ।<verse eid="PSA 36:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 36:6"/>तपाईंको धार्मिकता परमेश्‍वरका अति उच्‍च पहाडहरू जस्तै छन्; तपाईंको न्याय गहिरो समुद्रजस्तै छ। हे याहवेह, तपाईंले मानिस र पशुपक्षीलाई जोगाइराख्नुहुन्छ।<verse eid="PSA 36:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 36:7"/>हे परमेश्‍वर, तपाईंको अचुक प्रेम कति अनमोलको छ! मानव जातिहरूले तपाईंका पखेटाको छायामा शरण लिन्छन्।<verse eid="PSA 36:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 36:8"/>तिनीहरू तपाईंका भवनको प्रशस्तताबाट भोज गर्छन्; तपाईंको आनन्दको नदीबाट तिनीहरूलाई पिउन दिनुहुन्छ।<verse eid="PSA 36:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 36:9"/>किनकि जीवनको स्रोत तपाईंसँग छ; तपाईंको ज्योतिमा हामी उज्यालो देख्छौँ।<verse eid="PSA 36:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 36:10"/>तपाईंलाई चिन्‍नेहरूमा तपाईंको प्रेम र सोझो हृदय भएकाहरूमा तपाईंको धार्मिकता निरन्तर रहिरहोस्।<verse eid="PSA 36:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 36:11"/>अहङ्कारीको खुट्टा मेरो विरुद्धमा मलाई कुल्चन नआओस्, न त दुष्‍टका हातले मलाई भगाउन पाओस्।<verse eid="PSA 36:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 36:12"/>दुष्कर्मीहरू कसरी लम्पसार परेर लडेका छन्; तिनीहरू उठ्नै नसक्ने गरी फ्याँकिएका छन्।<verse eid="PSA 36:12"/></para>
<chapter eid="PSA 36"/>
<chapter number="37" style="c" sid="PSA 37"/>
<para style="p"><verse number="1" style="v" sid="PSA 37:1"/>दावीदको भजन। दुष्‍ट काम गर्ने मानिसहरूलाई देखेर झर्को नमान, वा दुष्‍ट काम गर्नेहरूप्रति डाही नहोऊ;<verse eid="PSA 37:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 37:2"/>किनकि तिनीहरू त चाँडै घाँसजस्तै ओइलाउनेछन्, हरिया बिरुवाहरूजस्तै तिनीहरू चाँडै नष्‍ट हुनेछन्।<verse eid="PSA 37:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 37:3"/>याहवेहमा भरोसा राख, र भलाइ गर; ताकि देशमा आनन्दसाथ बस्‍न सक।<verse eid="PSA 37:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 37:4"/>याहवेहमा आनन्दित होऊ; र उहाँले तिम्रो हृदयका इच्छाहरू पूरा गरिदिनुहुनेछ।<verse eid="PSA 37:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 37:5"/>तिम्रो आफ्नो मार्ग याहवेहलाई सुम्प; उहाँमा नै भरोसा राख; र उहाँले यो गर्नुहुनेछ:<verse eid="PSA 37:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 37:6"/>उहाँले तिम्रो धार्मिकता प्रभातको ज्योतिसमान र तिम्रो न्याय मध्यदिनको सूर्यसमान पार्नुहुनेछ।<verse eid="PSA 37:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 37:7"/>याहवेहको सामु मौन भई बस, र धैर्यतापूर्वक उहाँको प्रतीक्षा गर; जब मानिसहरू आफ्ना कुमार्गहरूमा सफल हुन्छन्, तब तिनीहरूका खराब योजनाहरू सफल हुँदा झर्को नमान।<verse eid="PSA 37:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 37:8"/>रिसबाट टाढा होऊ, र क्रोधबाट फर्क; झर्को नमान—यसले खराबीतिर मात्र डोर्‍याउँछ।<verse eid="PSA 37:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 37:9"/>किनकि दुष्‍टहरू नष्‍ट पारिनेछन्; तर याहवेहको प्रतीक्षा गर्नेहरूले देशमा अधिकार गर्नेछन्।<verse eid="PSA 37:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 37:10"/>थोरै समय मात्र बाँकी छ, र दुष्‍टहरू रहनेछैनन्; तिमीले तिनीहरूलाई खोजे तापनि तिनीहरू भेट्टाइनेछैनन्।<verse eid="PSA 37:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 37:11"/>तर नम्रहरूले देश अधिकार गर्नेछन्, र शान्ति र प्रशस्ततामा जिउनेछन्।<verse eid="PSA 37:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 37:12"/>दुष्‍टहरूले धर्मी जनका विरुद्धमा षड्यन्त्र रच्दछन्, र तिनीहरूले तिनीहरूमाथि दाह्रा किट्दछन्;<verse eid="PSA 37:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 37:13"/>तर प्रभु दुष्‍टहरूमाथि हाँस्‍नुहुन्छ; किनकि उहाँले तिनीहरूको दिन आइरहेको जान्‍नुहुन्छ।<verse eid="PSA 37:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 37:14"/>दुःखी र खाँचोमा परेकाहरूलाई ढाल्न, र सत्यको बाटोमा जिउनेहरूलाई मार्न, दुष्‍टहरूले तरवार थुत्छन्, र धनुमा ताँदो चढाउँछन्।<verse eid="PSA 37:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 37:15"/>तर तिनीहरूका तरवारले तिनीहरूकै मुटु छेडिनेछ, र तिनीहरूका धनुहरू भाँचिनेछन्।<verse eid="PSA 37:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 37:16"/>दुष्‍टहरूका धेरै सम्पत्तिभन्दा धर्मी जनहरूसँग भएको थोरै कुरा उत्तम हो;<verse eid="PSA 37:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 37:17"/>किनकि दुष्‍टहरूको शक्ति तोडिनेछन्, तर याहवेहले धर्मीहरूलाई थामिराख्नुहुन्छ।<verse eid="PSA 37:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 37:18"/>निर्दोष मानिसहरूले याहवेहको सुरक्षामा आफ्ना दिन बिताउँछन्, र तिनीहरूको अधिकार सदासर्वदा रहनेछ।<verse eid="PSA 37:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 37:19"/>आपत्‌को दिनमा तिनीहरू शर्ममा पर्नेछैनन्; अनिकालको दिनमा तिनीहरूसँग प्रशस्त खानेकुरा हुनेछ।<verse eid="PSA 37:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 37:20"/>तर दुष्‍टहरूचाहिँ नष्‍ट हुनेछन्: याहवेहका शत्रुहरूचाहिँ खेतका फूलहरूजस्तै भए तापनि तिनीहरू भष्म हुनेछन्, तिनीहरू धुवाँजस्तै लोप हुनेछन्।<verse eid="PSA 37:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 37:21"/>दुष्‍टहरूले ऋण लिन्छन् र फर्काउँदैनन्; तर धर्मीहरूले उदारतापूर्वक दिन्छन्।<verse eid="PSA 37:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 37:22"/>याहवेहबाट आशिष् पाउनेहरूले देश अधिकार गर्नेछन्; तर उहाँबाट श्राप पाउनेहरूचाहिँ नष्‍ट हुनेछन्।<verse eid="PSA 37:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 37:23"/>याहवेहमा आनन्दित हुने मानिसका पाइलाहरूलाई उहाँले दह्रिलो पार्नुहुन्छ;<verse eid="PSA 37:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 37:24"/>त्यसले ठेस खाए तापनि त्यो लड्नेछैन; किनकि याहवेहले त्यसलाई आफ्नो हातले थाम्नुहुन्छ।<verse eid="PSA 37:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 37:25"/>म जवान थिएँ र अहिले वृद्ध भएको छु; तर धर्मी जनहरू त्यागिएका वा तिनका सन्तानहरूले मागेर खानुपरेको मैले कहिल्यै देखेको छैन।<verse eid="PSA 37:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 37:26"/>तिनीहरू सधैँ उदार चित्तका हुन्छन्, र खुल्‍ला मनले दिन्छन्; तिनीहरूका सन्तान आशिषित हुनेछन्।<verse eid="PSA 37:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 37:27"/>दुष्‍टताबाट फर्क र भलाइ गर; अनि तिमी देशमा सदासर्वदा बास गर्नेछौ।<verse eid="PSA 37:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 37:28"/>किनकि याहवेहले न्यायीलाई प्रेम गर्नुहुन्छ, र आफ्ना विश्‍वासयोग्यहरूलाई त्याग्नुहुन्‍न। तिनीहरू सधैँका लागि सुरक्षित पारिनेछन्; तर दुष्‍टका सन्तानहरू नष्‍ट भएर जानेछन्।<verse eid="PSA 37:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 37:29"/>धर्मी जनहरूले देशमा अधिकार गर्नेछन्, र त्यसमा सदासर्वदा बास गर्नेछन्।<verse eid="PSA 37:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 37:30"/>धर्मीका मुखबाट बुद्धिका कुरा गर्छन्, र त्यसको जिब्रोले न्यायको कुरा बोल्छ।<verse eid="PSA 37:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 37:31"/>त्यसको हृदयमा त्यसका परमेश्‍वरको व्यवस्था हुन्छ; त्यसका खुट्टाहरू चिप्लँदैनन्।<verse eid="PSA 37:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 37:32"/>दुष्‍टले धर्मीको बाटोमा पासो थापेर बस्छ, र त्यसलाई मार्ने उद्देश्य राख्दछ;<verse eid="PSA 37:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 37:33"/>तर याहवेहले धर्मी जनलाई दुष्‍टहरूको शक्तिमा छोड्नुहुनेछैन, न त न्याय हुँदा धर्मीलाई दोषी ठहरिन अनुमति दिनुहुन्छ।<verse eid="PSA 37:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 37:34"/>याहवेहमा आशा गर र उहाँकै मार्गमा हिँड; प्रतिज्ञाको देश अधिकार गर्न उहाँले तिमीलाई उचाल्नुहुनेछ। दुष्‍टको विनाश तिम्रै आँखाले देख्नेछौ।<verse eid="PSA 37:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 37:35"/>मैले एक जना दुष्‍ट र निर्दयी मानिसलाई आफ्नै जमिनमा उम्रेर सप्रेको बोटजस्तै देखेको छु,<verse eid="PSA 37:35"/></para>
<para style="p"><verse number="36" style="v" sid="PSA 37:36"/>तर त्यो चाँडै मर्‍यो, र यसको ठाउँमा केही पनि रहेन; यद्यपि मैले त्यसलाई खोजेँ, तर भेट्टाउन सकिनँ।<verse eid="PSA 37:36"/></para>
<para style="p"><verse number="37" style="v" sid="PSA 37:37"/>निर्दोष मानिसलाई विचार गर, र धर्मी मानिसलाई हेर; किनभने शान्तिप्रिय मानिसहरूका निम्ति सन्तति हुनेछन्।<verse eid="PSA 37:37"/></para>
<para style="p"><verse number="38" style="v" sid="PSA 37:38"/>तर सबै पापीहरू नष्‍ट हुनेछन्; दुष्‍टहरूका निम्ति कुनै सन्तति हुनेछैन।<verse eid="PSA 37:38"/></para>
<para style="p"><verse number="39" style="v" sid="PSA 37:39"/>धर्मी जनहरूको मुक्ति याहवेहबाट आउँछ; सङ्कष्‍टको समयमा उहाँ नै तिनीहरूको किल्‍ला हुनुहुन्छ।<verse eid="PSA 37:39"/></para>
<para style="p"><verse number="40" style="v" sid="PSA 37:40"/>याहवेहले तिनीहरूलाई मदत गर्नुहुन्छ, र तिनीहरूको उद्धार गर्नुहुन्छ; उहाँले तिनीहरूलाई दुष्‍टबाट उद्धार गर्नुहुन्छ र बचाउनुहुन्छ; किनभने तिनीहरूले उहाँमा शरण लिन्छन्।<verse eid="PSA 37:40"/></para>
<chapter eid="PSA 37"/>
<chapter number="38" style="c" sid="PSA 38"/>
<para style="p"><verse number="1" style="v" sid="PSA 38:1"/>दावीदको भजन। हे याहवेह, तपाईंको क्रोधमा मलाई नहप्काउनुहोस्; वा तपाईंको क्रोधमा मलाई ताडना नदिनुहोस्।<verse eid="PSA 38:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 38:2"/>किनकि तपाईंका काँडहरूले मलाई घोचेका छन्, र तपाईंको हात ममाथि परेको छ।<verse eid="PSA 38:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 38:3"/>तपाईंको क्रोधले गर्दा मेरो शरीर तन्दुरुस्त छैन; मेरा पापको कारणले गर्दा मेरा हाडहरू स्वस्थ छैनन्।<verse eid="PSA 38:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 38:4"/>मेरा अधर्महरूले मलाई ढाकिसकेको छ, बोक्न नसक्ने भारीझैँ ती धेरै गह्रौँ भएका छन्।<verse eid="PSA 38:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 38:5"/>मेरो पापमय मूर्खताको कारणले गर्दा, मेरा घाउहरू दुर्गन्धित भएका छन्, र सडिसकेका छन्।<verse eid="PSA 38:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 38:6"/>म झुकेर धुलैमा मिलिसकेको छु; सारा दिन म विलाप गर्दै हिँड्छु।<verse eid="PSA 38:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 38:7"/>मेरो ढाड जलनको पीडाले भरिएको छ; मेरो शरीर स्वस्थ छैन।<verse eid="PSA 38:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 38:8"/>म दुर्बल भएको छु, र पूर्ण रूपले टुटेको छु; हृदयको पीडामा म कहालिन्छु।<verse eid="PSA 38:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 38:9"/>हे प्रभु, मेरा सबै इच्छा तपाईंको अगि खुलस्त छन्; मेरा सुस्केरा तपाईंबाट लुकेको छैन।<verse eid="PSA 38:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 38:10"/>मेरो मुटु छिटो-छिटो धड्कन्छ; मेरो बलले भ्याउँदैन; मेरो आँखाको ज्योति पनि मबाट गइसकेको छ।<verse eid="PSA 38:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 38:11"/>मेरा मित्रहरू, र सङ्गीहरू मेरा घाउहरूका कारणले गर्दा मबाट अलग बस्छन्; मेरा छिमेकीहरू टाढै उभिन्छन्।<verse eid="PSA 38:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 38:12"/>मेरो प्राण लिन खोज्नेहरूले पासो थाप्छन्; मेरो हानि खोज्नेहरूले मेरो विनाशको कुरा गर्छन्; दिनभरि छली योजना रच्दछन्।<verse eid="PSA 38:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 38:13"/>म त बहिरो मानिसझैँ भएको छु, जसले सुन्‍न सक्दैन; बोल्नै नसक्ने मानिसझैँ म लाटो भएको छु;<verse eid="PSA 38:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 38:14"/>सुन्‍न नसक्ने मानिसजस्तै म भएको छु, जसको मुखले जवाफै दिन सक्दैन।<verse eid="PSA 38:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 38:15"/>हे याहवेह, म तपाईंकै प्रतीक्षा गर्दछु; हे प्रभु, मेरा परमेश्‍वर, तपाईंले जवाफ दिनुहुनेछ।<verse eid="PSA 38:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 38:16"/>किनकि मैले भनेँ, “तिनीहरूले मेरो उपहास गर्न नपाऊन्, वा मेरो गोडा चिप्लँदा तिनीहरूले घमण्ड गर्न नपाऊन्।”<verse eid="PSA 38:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 38:17"/>किनकि म त ढल्नै लागेको छु; र मेरो पीडा सधैँ मसँग छ।<verse eid="PSA 38:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 38:18"/>मेरो अधर्म म स्वीकार गर्दछु; मेरो पापको कारण म दुःखित छु।<verse eid="PSA 38:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 38:19"/>कारणविना मेरा शत्रुहरू धेरै भएका छन्; कारणविना मलाई घृणा गर्नेहरू धेरै छन्।<verse eid="PSA 38:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 38:20"/>मेरो भलाइको साटो खराबी गर्दछन्, मैले तिनीहरूको केवल भलाइ गर्न खोज्दा पनि मेरो विरुद्धमा दोष लगाउँछन्।<verse eid="PSA 38:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 38:21"/>हे याहवेह, मलाई नत्याग्नुहोस्; हे मेरा परमेश्‍वर, मबाट टाढा नहुनुहोस्!<verse eid="PSA 38:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 38:22"/>हे प्रभु, मेरा मुक्तिदाता, मलाई सहायता गर्न चाँडै आउनुहोस्!<verse eid="PSA 38:22"/></para>
<chapter eid="PSA 38"/>
<chapter number="39" style="c" sid="PSA 39"/>
<para style="p"><verse number="1" style="v" sid="PSA 39:1"/>सङ्गीत निर्देशकको निम्ति, यदूतूनको लागि, दावीदको भजन। मैले भनेँ, “म आफ्नो चालचलनमा होसियार रहनेछु, र मेरो जिब्रोलाई पापबाट रोक्नेछु; दुष्‍टहरूको उपस्थितिमा, म आफ्नो मुखमा मोहोलो लगाएर बस्‍नेछु।”<verse eid="PSA 39:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 39:2"/>तर जब मैले पूर्ण मौन धारण गरेँ, तब असल कुरा पनि बोलिनँ, तर मेरो पीडा झन् बढेर गयो।<verse eid="PSA 39:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 39:3"/>मेरो हृदय मभित्र जलिरह्‍यो; मैले मनन गर्दा, आगो दन्कियो; तब मैले मेरो जिब्रोले बोलेँ:<verse eid="PSA 39:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 39:4"/>“हे याहवेह, मेरो जीवनको अन्त्य देखाउनुहोस्, र मेरो जीवन अब कति दिन बाँकी छ; मेरो जीवन कति क्षणभङ्गुर छ भनी मलाई जान्‍न दिनुहोस्!<verse eid="PSA 39:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 39:5"/>तपाईंले मेरो जीवनकाल छोटो बनाउनुभएको छ; तपाईंको दृष्‍टिमा मेरो जीवनको आयु नगण्य छ। हरेक मानिसको जीवन एक मुट्ठी सास मात्र हो; तिनीहरूको पनि जसले आफूलाई सुरक्षित सम्झन्छन्। सेला<verse eid="PSA 39:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 39:6"/>“निश्‍चय नै हरेक मानिस एउटा छायाजस्तै हिँड्‍डुल गर्छ; व्यर्थमा तिनीहरू धनसम्पत्ति थुपार्न हतार गर्छन्; तर त्यो अन्त्यमा कसको हुन्छ, सो जान्दैनन्।<verse eid="PSA 39:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 39:7"/>“हे प्रभु, अब म के कुराको निम्ति प्रतीक्षा गरूँ? मेरो आशा त तपाईंमा नै छ।<verse eid="PSA 39:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 39:8"/>मलाई मेरा सबै अपराधहरूबाट छुटाउनुहोस्; मलाई मूर्खहरूको अपमानको पात्र नबनाउनुहोस्।<verse eid="PSA 39:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 39:9"/>म मौन थिएँ; मैले मेरो मुख खोलिनँ; किनकि त्यो गर्ने तपाईं नै हुनुहुन्छ।<verse eid="PSA 39:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 39:10"/>तपाईंको विपत्ति मबाट हटाउनुहोस्; तपाईंको हातको मुक्‍काबाट म पराजित भएको छु।<verse eid="PSA 39:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 39:11"/>जब तपाईंले मानिसहरूलाई तिनीहरूका पापको निम्ति हप्काउनुहुन्छ र ताडना दिनुहुन्छ; तब तपाईंले तिनीहरूका धनसम्पत्ति धमिरालेझैँ नष्‍ट पार्नुहुन्छ— साँच्‍चै, हरेक मानिस एक मुट्ठी सास मात्र हो। सेला<verse eid="PSA 39:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 39:12"/>“हे याहवेह, मेरो प्रार्थना सुन्‍नुहोस्, मदतको निम्ति मैले गरेको पुकार सुनिदिनुहोस्; मेरो आँसुलाई त्यसै नटारिदिनुहोस्; किनकि प्रवासीझैँ म तपाईंमा आश्रित छु, मेरा सबै पुर्खाहरूजस्ता थिए, त्यस्तै नै एक परदेशी हुँ।<verse eid="PSA 39:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 39:13"/>मेरो अन्त हुनुभन्दा अगि नै मबाट क्रोधको दृष्‍टि हटाउनुहोस्, ताकि म फेरि हर्षित हुन सकूँ।”<verse eid="PSA 39:13"/></para>
<chapter eid="PSA 39"/>
<chapter number="40" style="c" sid="PSA 40"/>
<para style="p"><verse number="1" style="v" sid="PSA 40:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। मैले धीरजसाथ याहवेहको प्रतीक्षा गरेँ; उहाँ मतिर फर्कनुभयो र मेरो पुकार सुन्‍नुभयो।<verse eid="PSA 40:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 40:2"/>उहाँले मलाई खाडलबाट, दलदले हिलोबाट तानेर निकाल्नुभयो; उहाँले मेरा खुट्टाहरू चट्टानमाथि बसाल्नुभयो; र मलाई उभिन स्थिर स्थान दिनुभयो।<verse eid="PSA 40:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 40:3"/>उहाँले मेरो मुखमा एउटा नयाँ गीत हालिदिनुभयो; हाम्रा परमेश्‍वरका प्रशंसाको एउटा गीत। धेरै जनाले यो देख्नेछन्, र याहवेहको भय मान्‍नेछन्, र उहाँमाथि भरोसा राख्नेछन्।<verse eid="PSA 40:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 40:4"/>धन्य हो त्यो मानिस, जसले याहवेहमा आफ्नो भरोसा राख्दछ, जसले घमण्डीहरूमा भरोसा राख्दैनन्, जो झूटो देवहरूपट्टि लाग्दैनन्।<verse eid="PSA 40:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 40:5"/>हे याहवेह, मेरा परमेश्‍वर, तपाईंले गर्नुभएका अद्‌भुत कार्यहरू धेरै छन्; तपाईंले हाम्रो निम्ति गर्नुभएका योजनाहरू धेरै छन्। तपाईंको तुलना कसैसँग गर्न सकिँदैन; मैले तपाईंका कामहरूका बारेमा वर्णन गर्नुपर्‍यो भने, ती घोषणा गर्न असंख्य हुनेछन्।<verse eid="PSA 40:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 40:6"/>तपाईंले बलिदान र भेटी चाहनुभएन, तर मेरा कानहरू तपाईंले खोलिदिनुभएको छ, तपाईंले होमबलि र पाप शुद्धीकरण बलि चाहनुभएन।<verse eid="PSA 40:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 40:7"/>तब मैले भनेँ, “हेर्नुहोस्, म आएको छु, धर्मशास्त्रमा मेरो विषयमा यस्तै लेखिएको छ।<verse eid="PSA 40:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 40:8"/>म तपाईंको इच्छा पूरा गर्न चाहन्छु, हे मेरा परमेश्‍वर; तपाईंको व्यवस्था मेरो हृदयभित्र छ।”<verse eid="PSA 40:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 40:9"/>म ठूलो महासभामा तपाईंको धार्मिकताको घोषणा गर्छु; म मेरा ओठहरू बन्द गर्नेछैनँ; हे याहवेह, तपाईंले यो जान्‍नुहुन्छ।<verse eid="PSA 40:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 40:10"/>तपाईंको धार्मिकता म मेरो हृदयमा लुकाउँदिनँ; तपाईंको विश्‍वासयोग्यता र तपाईंको मुक्तिको विषयमा म बोल्छु। तपाईंको अचुक प्रेम र तपाईंको सत्यता म ठूलो महासभामा लुकाउँदिनँ।<verse eid="PSA 40:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 40:11"/>हे याहवेह, तपाईंको कृपा मदेखि नरोक्नुहोस्; तपाईंको अचुक प्रेम र तपाईंको विश्‍वासयोग्यताले मलाई निरन्तर रक्षा गरून्।<verse eid="PSA 40:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 40:12"/>किनकि असंख्य कष्‍टहरूले मलाई चारैतिर घेरेका छन्; मेरा अपराधहरू यतिसम्म थुप्रिएका छन्, कि म देख्न पनि सक्दिनँ। ती मेरा शिरका केशभन्दा बढी छन्; यसैले मेरो हृदय हताश भएको छ।<verse eid="PSA 40:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 40:13"/>हे याहवेह, मलाई बचाउन प्रसन्‍न हुनुहोस्; हे याहवेह, मलाई मदत गर्न चाँडै आउनुहोस्!<verse eid="PSA 40:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 40:14"/>मेरो प्राण लिन खोज्नेहरू सबै जना शर्ममा र अन्योलमा परून्; मेरो विनाश चाहनेहरू सबै पिठिउँ फर्काएर भागून् र अपमानित होऊन्!<verse eid="PSA 40:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 40:15"/>मलाई “खुच्‍चिङ! खुच्‍चिङ!” भन्‍नेहरू सबै लाजले गर्दा व्याकुल होऊन्।<verse eid="PSA 40:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 40:16"/>तर तपाईंलाई खोज्नेहरू सबै, तपाईंमा रमाऊन् र आनन्दित होऊन्; तपाईंको मुक्तिको चाहना गर्नेहरू सबैले सधैँ यसो भनून्, “याहवेह महान् हुनुहुन्छ!”<verse eid="PSA 40:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 40:17"/>तर म त गरिबी र अभावमा छु; प्रभुले मेरो बारेमा विचार गरिदिनुहोस्। तपाईं मेरा सहायक र मलाई छुटाउने हुनुहुन्छ; हे मेरा परमेश्‍वर, ढिलो नगर्नुहोस्।<verse eid="PSA 40:17"/></para>
<chapter eid="PSA 40"/>
<chapter number="41" style="c" sid="PSA 41"/>
<para style="p"><verse number="1" style="v" sid="PSA 41:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। धन्य हुन् तिनीहरू, जसले गरिबलाई वास्ता गर्छन्; याहवेहले तिनीहरूलाई सङ्कष्‍टको दिनमा बचाउनुहुन्छ।<verse eid="PSA 41:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 41:2"/>याहवेहले तिनीहरूको रक्षा गर्नुहुन्छ र जीवित राख्नुहुन्छ। तिनीहरू पृथ्वीका आशिषित मानिसहरूसँग गनिन्छन्। उहाँले तिनीहरूलाई तिनीहरूका वैरीहरूका इच्छामा छोड्नुहुन्‍न।<verse eid="PSA 41:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 41:3"/>याहवेहले तिनीहरूलाई बिरामी हुँदा सम्हाल्नुहुन्छ, र तिनीहरूलाई तिनीहरूका बिरामीको ओछ्यानबाट स्वस्थ पार्नुहुन्छ।<verse eid="PSA 41:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 41:4"/>मैले भनेँ, “हे याहवेह, ममाथि कृपा गर्नुहोस्; मलाई निको पार्नुहोस्; किनकि मैले तपाईंको विरुद्धमा पाप गरेको छु।”<verse eid="PSA 41:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 41:5"/>मेरा शत्रुहरूले खराब कुरा बोलेर मलाई यसो भन्छन्, “त्यो कहिले मर्ला र त्यसको नामनिशानै मेटिएला?”<verse eid="PSA 41:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 41:6"/>जब तीमध्ये कोही मलाई भेट्न आउँछ, त्यसले झूटो कुरा बोल्छ, र त्यसको हृदयले अधर्मका कुराहरू थुपार्छ; तब बाहिर गएर त्यसले मेरो निन्दाका कुरा फैलाउँछ।<verse eid="PSA 41:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 41:7"/>मलाई घृणा गर्नेहरू सबै एकमत भएर मेरो विरुद्धमा कानेखुसी गर्दछन्; तिनीहरू मेरो विरुद्धमा हानि चिताएर यसो भन्छन्,<verse eid="PSA 41:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 41:8"/>“त्यसलाई घातक रोग लागेको छ; त्यो बिरामी भएर जहाँ पस्रेको छ; त्यहाँबाट कहिल्यै उठ्नेछैन।”<verse eid="PSA 41:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 41:9"/>मेरो घनिष्‍ठ मित्रले, जसलाई मैले भरोसा गरेँ, जसले मेरै भोजन खान्थ्यो, त्यसले समेत मेरो विरुद्धमा लात उठाएको छ।<verse eid="PSA 41:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 41:10"/>तर हे याहवेह, ममाथि कृपा गर्नुहोस्; मलाई खडा गर्नुहोस्, र म तिनीहरूलाई बदला लिन सकूँ!<verse eid="PSA 41:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 41:11"/>म जान्दछु, तपाईं मसँग प्रसन्‍न हुनुहुन्छ; किनकि मेरा शत्रुहरू ममाथि विजयी हुन पाउँदैनन्।<verse eid="PSA 41:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 41:12"/>मेरो इमानदारीताको कारण तपाईंले मलाई सम्हाल्नुहुन्छ र मलाई तपाईंको उपस्थितिमा सदासर्वदा राख्नुहुन्छ।<verse eid="PSA 41:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 41:13"/>याहवेह, इस्राएलका परमेश्‍वरलाई, सदासर्वदा प्रशंसा होस्! आमेन! आमेन!<verse eid="PSA 41:13"/></para>
<chapter eid="PSA 41"/>
<chapter number="42" style="c" sid="PSA 42"/>
<para style="p"><verse number="1" style="v" sid="PSA 42:1"/>सङ्गीत निर्देशकको निम्ति, कोरहका छोराहरूका मस्किल।* जसरी हरिणले खोलाको पानीको तिर्सना गर्दछ, त्यसरी नै हे मेरा परमेश्‍वर, म तपाईंको तिर्सना गर्दछु।<verse eid="PSA 42:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 42:2"/>मेरो प्राण परमेश्‍वरको निम्ति, जीवित परमेश्‍वरको निम्ति तिर्खाउँछ। म कहिले जाऊँ र परमेश्‍वरलाई भेटूँ?<verse eid="PSA 42:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 42:3"/>मेरो आँसु दिनरात मेरो भोजन बनेको छ, मानिसहरू निरन्तर मलाई भनिरहन्छन्, “खोइ त तेरो परमेश्‍वर?”<verse eid="PSA 42:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 42:4"/>मेरो हृदयका कुराहरू पोखाउँदा, यी कुराहरू म सम्झन्छु: कसरी ती उत्सव मनाउने जन समूहहरूसँग जयजयकार र धन्यवादसाथ, महान् परमेश्‍वरको सुरक्षामा म अगुवा भएर तिनीहरूलाई परमेश्‍वरको भवनतर्फ लाने गर्थेँ।<verse eid="PSA 42:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 42:5"/>हे मेरो प्राण, तँ किन उदास हुन्छस्? मेरो अन्तस्करण तँ किन यति व्याकुल हुन्छस्? परमेश्‍वरमा आशा राख्, हे मेरा मुक्तिदाता, हे मेरा परमेश्‍वर, म अझै पनि तपाईंको प्रशंसा गर्नेछु।<verse eid="PSA 42:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 42:6"/>मेरो प्राण मभित्र उदास भएको छ; यसकारण म यर्दनको देशबाट हेर्मोन पर्वत—मिसारको डाँडाबाट तपाईंलाई सम्झनेछु।<verse eid="PSA 42:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 42:7"/>तपाईंको छाँगाहरूका गर्जनमा, सागरले सागरलाई पुकार्दछ; तपाईंका सम्पूर्ण छालहरू र तरङ्गहरूले मलाई छोपेका छन्।<verse eid="PSA 42:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 42:8"/>याहवेहले दिनमा उहाँको अचुक प्रेम पठाउनुहुन्छ, राति उहाँले मलाई एउटा गीत दिनुहुन्छ, जुनचाहिँ मेरो जीवनको परमेश्‍वरलाई प्रार्थना हो।<verse eid="PSA 42:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 42:9"/>परमेश्‍वर मेरा चट्टानलाई म भन्छु, “तपाईंले मलाई किन बिर्सनुभएको? शत्रुको थिचोमिचोले गर्दा म किन शोक गरेर हिँडिरहनुपर्ने?”<verse eid="PSA 42:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 42:10"/>मेरा हाडहरूमा गहिरो चोट पर्छ, जब मेरा वैरीहरूले मलाई गिल्‍ला गर्दै दिनभरि भन्छन्, “खोइ त तेरो परमेश्‍वर?”<verse eid="PSA 42:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 42:11"/>हे मेरो प्राण, तँ किन उदास हुन्छस्? हे मेरो अन्तस्करण, तँ किन यति धेरै व्याकुल हुन्छस्? परमेश्‍वरमा आशा राख्, हे मेरा मुक्तिदाता, हे मेरा परमेश्‍वर, म अझै पनि तपाईंको प्रशंसा गर्नेछु।<verse eid="PSA 42:11"/></para>
<chapter eid="PSA 42"/>
<chapter number="43" style="c" sid="PSA 43"/>
<para style="p"><verse number="1" style="v" sid="PSA 43:1"/>हे मेरा परमेश्‍वर, मलाई निर्दोष प्रमाणित गर्नुहोस्, र भक्तिहीन जातिको विरुद्धमा मेरो पक्षमा बोलिदिनुहोस्; छली र दुष्‍टहरूबाट मलाई छुटाउनुहोस्!<verse eid="PSA 43:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 43:2"/>किनकि तपाईं परमेश्‍वर हुनुहुन्छ, जसमा मेरो शक्ति छ। तपाईंले मलाई किन त्याग्नुभएको छ? शत्रुबाट थिचोमिचोमा परेर मैले किन विलाप गर्दै हिँड्नुपर्छ?<verse eid="PSA 43:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 43:3"/>तपाईंको ज्योति र तपाईंको विश्‍वासयोग्यतालाई पठाइदिनुहोस्; तिनले मलाई डोर्‍याऊन्; तिनले नै मलाई तपाईंको पवित्र पर्वतमा पुर्‍याऊन्; त्यस स्थानमा, जहाँ तपाईं बास गर्नुहुन्छ।<verse eid="PSA 43:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 43:4"/>तब म परमेश्‍वरको वेदीमा जानेछु, परमेश्‍वरकहाँ, जो मेरो आनन्द र हर्ष हुनुहुन्छ। म वीणा बजाएर तपाईंको प्रशंसा गर्नेछु, हे परमेश्‍वर, मेरा परमेश्‍वर।<verse eid="PSA 43:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 43:5"/>हे मेरो प्राण, तँ किन उदास हुन्छस्? हे मेरो अन्तस्करण, तँ किन यति धेरै व्याकुल हुन्छस्? परमेश्‍वरमा आशा राख्, हे मेरा मुक्तिदाता, हे मेरा परमेश्‍वर, म अझै पनि तपाईंको प्रशंसा गर्नेछु।<verse eid="PSA 43:5"/></para>
<chapter eid="PSA 43"/>
<chapter number="44" style="c" sid="PSA 44"/>
<para style="p"><verse number="1" style="v" sid="PSA 44:1"/>सङ्गीत निर्देशकको निम्ति, कोरहका छोराहरूको मस्किल।* हे परमेश्‍वर, हामीले आफ्नै कानले सुनेका छौँ; हाम्रा पितापुर्खाहरूले हामीलाई भनेका छन्, तपाईंले प्राचीन कालमा, उनीहरूका समयमा के-के कामहरू गर्नुभयो।<verse eid="PSA 44:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 44:2"/>तपाईंले आफ्नै हातले जाति-जातिहरूलाई धपाइदिनुभयो, र हाम्रा पितापुर्खाहरूलाई बसाल्नुभयो; तपाईंले जाति-जातिहरूलाई सताउनुभयो, र हाम्रा पितापुर्खाहरूलाई वृद्धि गराउनुभयो।<verse eid="PSA 44:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 44:3"/>तिनीहरूले आफ्नै तरवारद्वारा देश जितेका होइनन्, न त तिनीहरूको बाहुबलले विजय पाएका हुन्; तपाईंको दाहिने बाहुलीले, तपाईंकै पाखुराले र तपाईंको मुहारको प्रकाशले तिनीहरू विजय भएका थिए; किनकि तपाईंले तिनीहरूलाई प्रेम गर्नुहुन्थ्यो।<verse eid="PSA 44:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 44:4"/>तपाईं मेरा राजा र मेरा परमेश्‍वर हुनुहुन्छ; जसले याकोबलाई विजयको आदेश दिनुहुन्छ।<verse eid="PSA 44:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 44:5"/>तपाईंद्वारा नै हाम्रा शत्रुहरूलाई पछाडि धपाउँछौँ; तपाईंको नामद्वारा नै हाम्रा वैरीहरूलाई कुल्चन्छौँ।<verse eid="PSA 44:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 44:6"/>म आफ्नो धनुमा भरोसा गर्दिनँ, मेरो तरवारले मलाई विजय गराउँदैन;<verse eid="PSA 44:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 44:7"/>तर तपाईंले हामीलाई हाम्रा शत्रुहरूमाथि विजय दिनुहुन्छ; तपाईंले नै हाम्रा विरोधीहरूलाई लाजमा पार्नुहुन्छ।<verse eid="PSA 44:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 44:8"/>दिनभरि नै हामी आफ्ना परमेश्‍वरमा गर्व गर्छौँ, र हामी सदाकाल तपाईंको नामको प्रशंसा गर्नेछौँ। सेला<verse eid="PSA 44:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 44:9"/>तर अहिले तपाईंले हामीलाई त्याग्नुभएको छ, र लज्जित तुल्याउनुभएको छ; तपाईं हाम्रा सेनाहरूको साथमा जान छोड्नुभएको छ।<verse eid="PSA 44:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 44:10"/>तपाईंले हामीलाई शत्रुहरूको सामुबाट पछि हट्ने तुल्याउनुभएको छ; र हाम्रा विरोधीहरूले हामीलाई लुटेका छन्।<verse eid="PSA 44:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 44:11"/>तपाईंले हामीलाई भेडाहरूजस्तै अरूको आहारा हुनलाई त्यागिदिनुभएको छ; र हामीलाई जाति-जातिहरूका बीचमा तितरबितर पार्नुभएको छ।<verse eid="PSA 44:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 44:12"/>तपाईंले आफ्नो प्रजाहरूलाई सस्तोमा दास हुनलाई बेचिदिनुभएको छ; तिनीहरूको बिक्रीबाट तपाईंलाई केही फाइदा भएको छैन।<verse eid="PSA 44:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 44:13"/>हाम्रा वरिपरिका मानिसहरूका बीचमा हामीलाई तिरस्कार र हाँसोको पात्र बनाउनुभएको छ; छिमेकीहरूका बीचमा हामीलाई हाँसोको पात्र तुल्याउनुभएको छ।<verse eid="PSA 44:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 44:14"/>तपाईंले हामीलाई जाति-जातिहरूका बीचमा हाँसोको पात्र हुन दिनुभएको छ; मानिसहरू हामीलाई देखेर टाउको हल्‍लाउँछन्।<verse eid="PSA 44:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 44:15"/>मेरो गिल्‍ला गर्ने र खिसी गर्नेहरूका बोलीहरूले, बदला लिने शत्रुहरूका कारणले,<verse eid="PSA 44:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 44:16"/>मैले आफ्नो अपमान दिनभरि सहनुपर्छ, र मेरो अनुहार लाजले ढाकिएको छ।<verse eid="PSA 44:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 44:17"/>यी सबै कुरा हामीमाथि परिआएका छन्; यद्यपि हामीले तपाईंलाई बिर्सेका छैनौँ, हामी तपाईंको करारप्रति झूटो भएका छैनौँ।<verse eid="PSA 44:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 44:18"/>हाम्रा हृदय तपाईंबाट पछाडि फर्केका छैनन्; हाम्रा पाइलाहरू तपाईंका मार्गबाट तर्किएका छैनन्।<verse eid="PSA 44:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 44:19"/>तर तपाईंले हामीलाई चकनाचुर पारेर स्यालहरू बस्‍ने ठाउँ बनाउनुभयो, र हामीलाई घोर अन्धकारले ढाक्नुभयो।<verse eid="PSA 44:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 44:20"/>यदि हाम्रा परमेश्‍वरको नाम हामीले बिर्सिएका छौँ भने, अथवा कुनै विदेशी देवी-देवतातिर हाम्रा हातहरू पसारेका छौँ भने,<verse eid="PSA 44:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 44:21"/>के परमेश्‍वरले त्यो कुरा जान्‍नुहुने थिएन र? किनकि उहाँले हाम्रा हृदयका गुप्‍त कुराहरू समेत जान्‍नुहुन्छ।<verse eid="PSA 44:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 44:22"/>तरै पनि तपाईंको खातिर हामी दिनभरि मृत्युको सामना गर्छौँ; हामीहरू काट्न लगिएका भेडाहरूजस्तै गनिएका छौँ।<verse eid="PSA 44:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 44:23"/>हे प्रभु, उठ्नुहोस्! तपाईं किन सुत्नुहुन्छ? जाग्नुहोस्! हामीलाई सदाको लागि नत्याग्नुहोस्।<verse eid="PSA 44:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 44:24"/>किन तपाईं आफ्नो मुहार लुकाउनुहुन्छ र हाम्रा दुःख र हामीमाथिको अत्याचार बिर्सनुहुन्छ?<verse eid="PSA 44:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 44:25"/>हामी धुलोसम्मै झारिएका छौँ; हाम्रो पेट जमिनमै टाँसिसकेको छ।<verse eid="PSA 44:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 44:26"/>उठ्नुहोस् र हामीलाई सहायता गर्नुहोस्; तपाईंको अचुक प्रेमको कारण हाम्रो उद्धार गरिदिनुहोस्!<verse eid="PSA 44:26"/></para>
<chapter eid="PSA 44"/>
<chapter number="45" style="c" sid="PSA 45"/>
<para style="p"><verse number="1" style="v" sid="PSA 45:1"/>सङ्गीत निर्देशकको लागि “लिली फूल” को रागमा आधारित, कोरहका छोराहरूबाट मास्किल।* विवाहको गीत। जब म राजाको निम्ति गीत गाउँदछु; सुन्दर विचारहरूले मेरो हृदय भरिन्छ; मेरो जिब्रो सिपालु लेखकको कलम हुन्छ।<verse eid="PSA 45:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 45:2"/>तपाईं पुरुषहरूमध्ये सर्वश्रेष्‍ठ हुनुहुन्छ; र तपाईंका ओठहरू अनुग्रहले अभिषिक्त छन्; किनकि परमेश्‍वरले तपाईंलाई सदाकालको निम्ति आशिष् दिनुभएको छ।<verse eid="PSA 45:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 45:3"/>हे परमवीर योद्धा, तपाईंको कम्मरमा आफ्नो तरवार भिर्नुहोस्; प्रताप र वैभव धारण गर्नुहोस्।<verse eid="PSA 45:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 45:4"/>तपाईंको वैभवमा विजयका साथ सवार हुनुहोस्; सत्यता, नम्रता र धार्मिकताको पक्षमा तपाईंको सवारी होस्; तपाईंको दाहिने बाहुलीले अचम्मका कामहरू गरोस्।<verse eid="PSA 45:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 45:5"/>तपाईंका तीखा काँडहरूले राजाका शत्रुहरूका हृदय छेडिओस्; राष्ट्रहरू तपाईंको चरणमा झुकून्।<verse eid="PSA 45:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 45:6"/>हे परमेश्‍वर, तपाईंको सिंहासन सदाको निम्ति रहनेछ; न्यायको राजदण्ड तपाईंको राज्यको राजदण्ड हुनेछ।<verse eid="PSA 45:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 45:7"/>तपाईंले धार्मिकतालाई प्रेम गर्नुहुन्छ र दुष्‍टतालाई घृणा गर्नुहुन्छ; यसकारण परमेश्‍वर, तपाईंका परमेश्‍वरले तपाईंलाई तपाईंका सङ्गीहरूभन्दा उच्‍च पार्नुभएको छ र हर्षको तेलले अभिषेक गर्नुभएको छ।<verse eid="PSA 45:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 45:8"/>तपाईंका सबै कपडाहरू मूर्र, चन्दन, तेजपातको सुवास्‍नाले सुगन्धित छन्; हस्तीदन्तले सिँगारिएका राजमहलबाट तारको सुरिलो सङ्गीतले तपाईंलाई हर्षित तुल्याउँछ।<verse eid="PSA 45:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 45:9"/>तपाईंका सम्मानित स्त्रीहरूमा राजकुमारीहरू छन्; तपाईंको दाहिने हातपट्टि ओपीरका निखुर सुनले सुसज्जित भएकी राजकीय दुलही छिन्।<verse eid="PSA 45:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 45:10"/>हे कुमारी, सुन, ध्यान देऊ र विचार गर: तिम्रा मानिसहरू र आफ्नो पिताको घरलाई पनि बिर्स!<verse eid="PSA 45:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 45:11"/>तिम्रो सुन्दरताले राजा मोहित होऊन्; उहाँको आदर गर; किनकि उहाँ तिम्रा मालिक हुन्।<verse eid="PSA 45:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 45:12"/>टायरकी छोरीहरू उपहार लिएर आउनेछन्; धनी मानिसहरूले तिम्रो कृपादृष्‍टि खोज्नेछन्।<verse eid="PSA 45:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 45:13"/>राजकुमारी राजमहलमा ऐश्‍वर्यमयी छिन्; तिनको वस्त्र सुनले जडिएको छ।<verse eid="PSA 45:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 45:14"/>तिनी बुट्टेदार पोशाकमा राजाकहाँ पुर्‍याइन्छिन्; तिनका कुमारी साथीहरूले तिनलाई पछ्याउँछन्, जो तिनीसँगै रहनलाई ल्याइन्छन्।<verse eid="PSA 45:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 45:15"/>हर्ष र आनन्दका साथ डोर्‍याइँदै, तिनीहरू राजाको महलभित्र प्रवेश गर्दछन्।<verse eid="PSA 45:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 45:16"/>तपाईंका पुर्खाहरूको स्थानमा तपाईंका छोराहरू हुनेछन्; तपाईंले तिनीहरूलाई सारा पृथ्वीमा राजकुमार बनाउनुहुनेछ।<verse eid="PSA 45:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 45:17"/>म तपाईंको नामलाई पुस्तौँ-पुस्तासम्म कायम राख्नेछु; यसकारण राष्ट्रहरूले तपाईंको प्रशंसा सदासर्वदा गर्नेछन्।<verse eid="PSA 45:17"/></para>
<chapter eid="PSA 45"/>
<chapter number="46" style="c" sid="PSA 46"/>
<para style="p"><verse number="1" style="v" sid="PSA 46:1"/>सङ्गीत निर्देशकको निम्ति, अलामोत लयमा आधारित, कोरहका छोराहरूका भजन। परमेश्‍वर हाम्रा शरणस्थान र बल हुनुहुन्छ, सङ्कष्‍टमा सधैँ हाजिर हुने सहायक।<verse eid="PSA 46:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 46:2"/>यसकारण हामी डराउनेछैनौँ, चाहे पृथ्वीमा ठूलो हलचल आओस्, चाहे पर्वतहरू समुद्रको गहिराइमा खसून्;<verse eid="PSA 46:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 46:3"/>चाहे समुद्र गर्जोस् र फीँज काढोस्, र त्यो डरलाग्दो भेल उर्लेर आउँदा पर्वतहरू थर्कून्। सेला<verse eid="PSA 46:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 46:4"/>एउटा नदी छ, जसको प्रवाहले परमेश्‍वरको नगर, सर्वोच्‍च परमेश्‍वरले बास गर्नुहुने पवित्रस्थानलाई हर्षित तुल्याउँछ।<verse eid="PSA 46:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 46:5"/>परमेश्‍वर त्यस सहरभित्र हुनुहुन्छ, त्यो पतन हुनेछैन; परमेश्‍वरले त्यसलाई बिहानै सहायता गर्नुहुनेछ।<verse eid="PSA 46:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 46:6"/>राष्ट्रहरूमा डरले कोलाहल हुन्छ; राज्यहरू पतन हुन्छन्। परमेश्‍वरले आफ्नो आवाज निकाल्नुहुन्छ, तब पृथ्वी पग्लन्छ।<verse eid="PSA 46:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 46:7"/>सेनाहरूका याहवेह हाम्रो साथमा हुनुहुन्छ; याकोबका परमेश्‍वर हाम्रो किल्‍ला हुनुहुन्छ। सेला<verse eid="PSA 46:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 46:8"/>आओ र याहवेहले गर्नुभएका कामहरू हेर, उहाँले पृथ्वीलाई कस्तो उजाड पार्नुभएको छ।<verse eid="PSA 46:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 46:9"/>पृथ्वीको छेउसम्मै उहाँले मानिसहरूका लडाइँ झगडा रोक्नुहुन्छ; उहाँले धनु भाँच्नुहुन्छ र भालाहरूलाई टुक्रा-टुक्रा पारिदिनुहुन्छ; उहाँले रथहरूलाई आगोमा जलाउनुहुन्छ।<verse eid="PSA 46:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 46:10"/>उहाँले भन्‍नुहुन्छ, “शान्त रहो, र म नै परमेश्‍वर हुँ भनी जान; म राष्ट्रहरूको बीचमा उच्‍च पारिनेछु, म पृथ्वीमा उचालिनेछु।”<verse eid="PSA 46:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 46:11"/>सेनाहरूका याहवेह हाम्रो साथमा हुनुहुन्छ; याकोबका परमेश्‍वर हाम्रो किल्‍ला हुनुहुन्छ। सेला<verse eid="PSA 46:11"/></para>
<chapter eid="PSA 46"/>
<chapter number="47" style="c" sid="PSA 47"/>
<para style="p"><verse number="1" style="v" sid="PSA 47:1"/>सङ्गीत निर्देशकको निम्ति, कोरहको छोराहरूका भजन। हे सबै जाति-जातिका मानिसहरू हो, ताली बजाओ; उच्‍च सोरले परमेश्‍वरको निम्ति जयजयकार गर!<verse eid="PSA 47:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 47:2"/>सर्वोच्‍च याहवेह कस्तो महान् हुनुहुन्छ, सारा पृथ्वीभरिका महाराजा।<verse eid="PSA 47:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 47:3"/>उहाँले राष्ट्रहरूलाई हाम्रा अधीनमा, र जाति-जातिहरूलाई हाम्रा पैतालामुनि पार्नुभएको छ।<verse eid="PSA 47:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 47:4"/>उहाँले हाम्रा निम्ति उत्तराधिकारको भाग छान्‍नुभयो, याकोबको गौरव, जसलाई उहाँले प्रेम गर्नुहुन्थ्यो। सेला<verse eid="PSA 47:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 47:5"/>परमेश्‍वर आनन्दको सोरसित, याहवेह तुरहीको आवाजसित माथि उक्लनुभएको छ।<verse eid="PSA 47:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 47:6"/>परमेश्‍वरको निम्ति गीत गाओ, गीत गाओ; हाम्रा राजाको निम्ति गीत गाओ, गीत गाओ!<verse eid="PSA 47:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 47:7"/>किनकि परमेश्‍वर सारा पृथ्वीका राजा हुनुहुन्छ; उहाँको निम्ति प्रशंसाको भजन गाओ!<verse eid="PSA 47:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 47:8"/>परमेश्‍वरले राष्ट्रहरूमाथि शासन गर्नुहुन्छ; परमेश्‍वर उहाँको पवित्र सिंहासनमा विराजमान हुनुहुन्छ।<verse eid="PSA 47:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 47:9"/>अब्राहामका परमेश्‍वरका मानिसहरूझैँ राष्ट्रहरूका श्रेष्‍ठ व्यक्तिहरू भेला भएका छन्; किनकि पृथ्वीका शासकहरू परमेश्‍वरकै हुन्; परमेश्‍वर अति उच्‍च हुनुहुन्छ।<verse eid="PSA 47:9"/></para>
<chapter eid="PSA 47"/>
<chapter number="48" style="c" sid="PSA 48"/>
<para style="p"><verse number="1" style="v" sid="PSA 48:1"/>एउटा गीत, कोरहका छोराहरूको भजन। हाम्रा परमेश्‍वरको सहरमा, उहाँको पवित्र पर्वतमा, याहवेह महान् र प्रशंसाको योग्य हुनुहुन्छ।<verse eid="PSA 48:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 48:2"/>उचाइमा सुन्दर, सारा पृथ्वीको आनन्द सियोन पर्वत हो, जो सापोनको उचाइझैँ छ, जो हाम्रा महाराजाको सहर हो।<verse eid="PSA 48:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 48:3"/>तिनका किल्‍लाहरूमा परमेश्‍वर हुनुहुन्छ; तिनका रक्षक परमेश्‍वर आफैँ हुनुहुन्छ भनी उहाँले देखाउनुभएको छ।<verse eid="PSA 48:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 48:4"/>जब राजाहरूले एकसाथ दल बाँधे; जब तिनीहरूसँगै अगि बढे,<verse eid="PSA 48:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 48:5"/>तिनीहरूले तिनलाई देखे; र तिनीहरू छक्‍क परे; तिनीहरू डराएर भागे।<verse eid="PSA 48:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 48:6"/>तिनीहरू त्यहीँ नै डरले थरथर काँप्न लागे, प्रसवपीडामा भएकी स्त्रीजस्तै तिनीहरू पीडामा परे।<verse eid="PSA 48:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 48:7"/>तर्शीशको जहाजहरूलाई झैँ तपाईंले तिनीहरूलाई पूर्वीय बतासले नष्‍ट पार्नुभयो।<verse eid="PSA 48:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 48:8"/>सेनाहरूका याहवेहको सहरमा, हाम्रा परमेश्‍वरको नगरमा, जस्तो हामीले सुनेका थियौँ, त्यस्तै देखेका छौँः परमेश्‍वरले तिनलाई सदासर्वदा सुरक्षित राख्नुहुन्छ। सेला<verse eid="PSA 48:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 48:9"/>हे परमेश्‍वर, तपाईंको मन्दिरभित्र, हामी तपाईंको अचुक प्रेमको ध्यान गर्छौँ।<verse eid="PSA 48:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 48:10"/>हे परमेश्‍वर, तपाईंको नामजस्तै, तपाईंको प्रशंसा पृथ्वीको छेउसम्मै पुग्दछ; तपाईंको दाहिने बाहुली धार्मिकताले भरिएको छ।<verse eid="PSA 48:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 48:11"/>तपाईंका सही न्यायहरूका कारण, सियोन पर्वत आनन्दित हुन्छ; यहूदाका सहरहरू हर्षित हुन्छन्।<verse eid="PSA 48:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 48:12"/>सियोनको चारैतिर हिँड, र यसको परिक्रमा गर; यसका धरहराहरू गन,<verse eid="PSA 48:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 48:13"/>यसको सुरक्षाको पर्खालहरूमाथि ध्यानसाथ हेर; यसका किल्‍लाहरूमाथि दृष्‍टि लगाओ; तब तिमीहरूले अर्को पुस्तालाई यसको बारेमा राम्ररी वर्णन गर्न सक्छौ।<verse eid="PSA 48:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 48:14"/>किनकि यिनै परमेश्‍वर हाम्रा सदासर्वदाका परमेश्‍वर हुनुहुन्छ; अनन्तसम्मै उहाँले हामीलाई अगुवाइ गर्नुहुनुहुनेछ।<verse eid="PSA 48:14"/></para>
<chapter eid="PSA 48"/>
<chapter number="49" style="c" sid="PSA 49"/>
<para style="p"><verse number="1" style="v" sid="PSA 49:1"/>सङ्गीत निर्देशकको निम्ति, कोरहका छोराहरूको भजन। हे सबै जाति-जातिहरू हो, यो सुन; हे संसारका बासिन्दाहरू हो, सुन;<verse eid="PSA 49:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 49:2"/>साना र ठूला दुवै, धनी र गरिब सबै ध्यान देओ:<verse eid="PSA 49:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 49:3"/>मेरो मुखले बुद्धिका कुराहरू बोल्नेछ; मेरो हृदयका चिन्तनले समझशक्ति प्रदान गर्नेछ।<verse eid="PSA 49:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 49:4"/>म हितोपदेशमा ध्यान लगाउनेछु; वीणा बजाएर उखानको अर्थ खोल्नेछु।<verse eid="PSA 49:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 49:5"/>दुष्‍ट छलीहरूले मलाई घेर्दा, दुःखका दिनहरू आउँदा म किन डराउने,<verse eid="PSA 49:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 49:6"/>तिनीहरू, जसले आफ्नो सम्पत्तिमाथि भरोसा राख्छन्, र आफ्नो ठूलो धनसम्पत्तिको घमण्ड गर्छन्।<verse eid="PSA 49:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 49:7"/>कुनै पनि मानिसले कसैको प्राणको उद्धार गर्न सक्दैन, न त परमेश्‍वरलाई आफ्नो जीवनको लागि मोल नै दिन सक्छ।<verse eid="PSA 49:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 49:8"/>जीवनको मूल्य धेरै मूल्यवान् हुन्छ; कसैको धनले तिरेर कहिल्यै पुग्दैन।<verse eid="PSA 49:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 49:9"/>कोही पनि यस्तो मानिस छैन, जो सधैँ जीवित रहन्छ, र कहिल्यै कुहुनुपर्दैन।<verse eid="PSA 49:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 49:10"/>किनकि सबैलाई थाहा छ, बुद्धिमान् मानिसहरू मर्छन्; मूर्ख र विवेकहीन मानिसहरू पनि मर्छन्, तिनीहरूका धनसम्पत्ति अरूहरूका लागि छोड्छन्।<verse eid="PSA 49:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 49:11"/>तिनीहरूको निम्ति चिहान नै सदासर्वदाको घर हुन्छ; पुस्तौँसम्म ती तिनीहरूका वासस्थान हुनेछन्, यद्यपि तिनीहरूले आफ्नो जमिन आफ्नै नाममा राखेका थिए।<verse eid="PSA 49:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 49:12"/>मानिसहरू महान् भए तापनि सधैँभरि जीवित रहन सक्दैनन्; तिनीहरू नष्‍ट हुने पशुजस्तै छन्।<verse eid="PSA 49:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 49:13"/>आफूमाथि भर पर्ने ती सबैको गति यस्तै हुन्छ, र तिनीहरूको कुराहरूलाई समर्थन गरेर तिनीहरूका पछि लाग्नेहरूको गति पनि यस्तै हुन्छ। सेला<verse eid="PSA 49:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 49:14"/>भेडाहरूजस्तै तिनीहरूको अन्त्य मृत्यु हुन्छ; मृत्यु तिनीहरूको गोठालो हुनेछ (तर बिहानै धर्मीहरूले तिनीहरूमाथि शासन गर्नेछन्)। तिनीहरूका भौतिक शरीर चिहानमा कुहेर जानेछ; तिनीहरूका राजकीय महलदेखि टाढा।<verse eid="PSA 49:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 49:15"/>तर परमेश्‍वरले मेरो प्राणलाई चिहानको शक्तिबाट उद्धार गर्नुहुनेछ; निश्‍चय नै उहाँले मलाई आफूसँग लिनुहुनेछ।<verse eid="PSA 49:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 49:16"/>नडराओ, जब अरू कोही धनी हुन्छन्, जब तिनीहरूको घरको गौरव बढ्छ;<verse eid="PSA 49:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 49:17"/>किनकि तिनीहरू मरेर जाँदा तिनीहरूले आफूसँग केही पनि लैजान सक्दैनन्; तिनीहरूको गौरव तिनीहरूसँग चिहानमा जाँदैन।<verse eid="PSA 49:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 49:18"/>तिनीहरूले जीवित हुँदा आफूलाई धन्यको ठाने तापनि— र तिम्रो उन्‍नति हुँदा मानिसहरूले तिम्रो प्रशंसा गर्छन्—<verse eid="PSA 49:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 49:19"/>तिनीहरू पहिल्यै मरेका आफ्ना पितापुर्खाहरूका पुस्ताकहाँ मिल्न जानेछन्; जसले जीवनको ज्योति फेरि कहिल्यै देख्नेछैनन्।<verse eid="PSA 49:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 49:20"/>जोसँग धनसम्पत्ति छ, तर समझशक्ति छैन भने ती मानिसहरू नष्‍ट हुने पशुजस्तै हुन्।<verse eid="PSA 49:20"/></para>
<chapter eid="PSA 49"/>
<chapter number="50" style="c" sid="PSA 50"/>
<para style="p"><verse number="1" style="v" sid="PSA 50:1"/>आसापको भजन। याहवेह, सर्वशक्तिशाली परमेश्‍वर बोल्नुहुन्छ, र पृथ्वीका मानिसहरूलाई सूर्योदयदेखि सूर्यास्तसम्म बोलाउनुहुन्छ।<verse eid="PSA 50:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 50:2"/>सुन्दरतामा सियोनबाट सिद्ध, परमेश्‍वर प्रकाशमान् हुनुभएको छ।<verse eid="PSA 50:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 50:3"/>हाम्रा परमेश्‍वर आउनुहुन्छ, र शान्त बस्‍नुहुनेछैन; उहाँको अगि भस्म पार्ने आगो छ, र उहाँको चारैपट्टि ठूलो आँधीबेहरी छ।<verse eid="PSA 50:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 50:4"/>आफ्ना मानिसहरूका न्याय गर्न परमेश्‍वरले माथिको आकाश र तलको पृथ्वीलाई बोलाउनुहुन्छ:<verse eid="PSA 50:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 50:5"/>“मेरा समर्पित मानिसहरू मकहाँ भेला गराओ, जसले बलिद्वारा मसँग करार बाँधेका छन्।”<verse eid="PSA 50:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 50:6"/>स्वर्गले उहाँको धार्मिकता घोषणा गर्छ; किनकि उहाँ नै न्यायको परमेश्‍वर हुनुहुन्छ। सेला<verse eid="PSA 50:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 50:7"/>“हे मेरा मानिसहरू हो, सुन, र म तिमीहरूसँग बोल्नेछु; हे इस्राएल, म तेरो विरुद्धमा गवाही दिनेछु: म परमेश्‍वर, तेरा परमेश्‍वर हुँ।<verse eid="PSA 50:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 50:8"/>म तँलाई तेरो बलिदानहरूका बारेमा दोष दिन्‍नँ, वा तेरो होमबलिहरूको बारेमा, जो सधैँ मेरो सामु छन्।<verse eid="PSA 50:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 50:9"/>मलाई तेरो गोठबाट साँढेको, वा तेरो खोरहरूबाट बोकाको आवश्यकता छैन;<verse eid="PSA 50:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 50:10"/>किनकि सम्पूर्ण जङ्गली पशुहरू मेरै हुन्, र हजारौँ डाँडाहरूका पशुप्राणी मेरै हुन्।<verse eid="PSA 50:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 50:11"/>म पहाडहरूका हरेक पक्षीलाई चिन्दछु; भूमिका सबै प्राणीहरू मेरै हुन्।<verse eid="PSA 50:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 50:12"/>यदि म भोकै भए तापनि तँलाई भन्‍नेथिइनँ; किनकि संसार मेरै हो, र त्यसमा भएका सबै थोक पनि मेरै हुन्।<verse eid="PSA 50:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 50:13"/>के म साँढेहरूको मासु खान्छु? अथवा बोकाहरूको रगत पिउँछु र?<verse eid="PSA 50:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 50:14"/>“परमेश्‍वरको निम्ति धन्यवादको बलि चढा, र सर्वोच्‍च परमेश्‍वरलाई गरेको तेरो भाकल पूरा गर्।<verse eid="PSA 50:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 50:15"/>सङ्कष्‍टको दिनमा मलाई पुकार्; म तँलाई छुटाउनेछु, र तैँले मलाई महिमा दिनेछस्।”<verse eid="PSA 50:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 50:16"/>तर परमेश्‍वरले दुष्‍टलाई भन्‍नुहुन्छ: “तैँले मेरो व्यवस्था पाठ गर्ने के हक छ? अथवा मेरो करारको कुरा गर्ने के अधिकार छ?<verse eid="PSA 50:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 50:17"/>मेरो शिक्षालाई तैँले घृणा गर्छस्, र मेरा आज्ञाहरूलाई इन्कार गर्छस्।<verse eid="PSA 50:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 50:18"/>जब चोरलाई देख्दा तँ चोरकै साथी बन्छस्; व्यभिचारीहरूसँग सहभागी हुन्छस्।<verse eid="PSA 50:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 50:19"/>तेरो मुख खराबी कुरा बोल्नलाई प्रयोग गर्छस्, र तेरो जिब्रोलाई छली कुरा गर्नलाई चलाउँछस्।<verse eid="PSA 50:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 50:20"/>तँ बस्छस्, र आफ्नै भाइको विरुद्धमा गवाही दिन्छस्; तँ आफ्नै साक्खै भाइलाई दोष लगाउँछस्।<verse eid="PSA 50:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 50:21"/>तैँले यी सबै कुराहरू गरिस्, र म चुप रहेँ; तैँले मलाई पूर्णतया आफूजस्तै ठानिस्; तर अब म तँलाई हप्काउनेछु, र तेरै मुखको अगि तेरो दोष देखाउनेछु।<verse eid="PSA 50:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 50:22"/>“हे परमेश्‍वरलाई बिसर्नेहरू हो, यो कुरा राम्ररी विचार गर; नत्रता म तिमीहरूलाई टुक्रा-टुक्रा पार्नेछु, र तिमीहरूलाई छुटाउने कोही पनि हुनेछैन:<verse eid="PSA 50:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 50:23"/>धन्यवादको बलिदान चढाउनेहरूले नै मेरो आदर गर्दछन्, जसले आफ्नो मार्ग सुधार्छ, म त्यसलाई परमेश्‍वरको मुक्ति देखाउनेछु।”<verse eid="PSA 50:23"/></para>
<chapter eid="PSA 50"/>
<chapter number="51" style="c" sid="PSA 51"/>
<para style="p"><verse number="1" style="v" sid="PSA 51:1"/>सङ्गीत निर्देशकको निम्ति, दावीदले बतशेबासँग व्यभिचार गरेपछि नातान अगमवक्ता तिनीकहाँ आएपछिको दावीदको भजन। हे परमेश्‍वर, तपाईंको अचुक प्रेमअनुसार ममाथि दया गर्नुहोस्; तपाईंको महान् करुणाअनुसार मेरा अपराधहरू मेटिदिनुहोस्!<verse eid="PSA 51:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 51:2"/>मेरा सबै अधर्महरूलाई पखालिदिनुहोस्, र मेरो पापबाट मलाई शुद्ध पारिदिनुहोस्!<verse eid="PSA 51:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 51:3"/>किनकि मेरा अपराधहरू म जान्दछु; र मेरो पाप सधैँ मेरै सामु छ।<verse eid="PSA 51:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 51:4"/>मैले तपाईंको विरुद्धमा, मात्र तपाईंकै विरुद्धमा पाप गरेको छु, अनि तपाईंको दृष्‍टिमा जे खराबी छ, मैले त्यही गरेको छु; यसकारण तपाईंको फैसलामा तपाईं सही हुनुहुन्छ, र तपाईंले न्याय गर्नुहुँदा धर्मी ठहरिनुहुन्छ।<verse eid="PSA 51:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 51:5"/>निश्‍चय नै म जन्मँदै पापी थिएँ, मेरी आमाले मलाई गर्भधारण गरेदेखि नै म पापी थिएँ।<verse eid="PSA 51:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 51:6"/>तपाईंले गर्भमै विश्‍वासयोग्यता चाहना गर्नुहुन्छ; तपाईंले मलाई त्यो गोप्य ठाउँमा बुद्धिका कुरा सिकाउनुहुन्छ।<verse eid="PSA 51:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 51:7"/>हिसपले मलाई शुद्ध पार्नुहोस्, र म शुद्ध हुनेछु; मलाई धुनुहोस्, र म हिउँभन्दा सेतो हुनेछु।<verse eid="PSA 51:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 51:8"/>मलाई हर्ष र आनन्दका कुरा सुन्‍न दिनुहोस्; तपाईंले धुलोपिठो पार्नुभएका यी हड्डीहरू आनन्दित होऊन्!<verse eid="PSA 51:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 51:9"/>मेरा पापहरूदेखि आफ्नो मुहार लुकाउनुहोस्, र मेरा सारा अधर्महरू मेटिदिनुहोस्!<verse eid="PSA 51:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 51:10"/>हे परमेश्‍वर, मभित्र शुद्ध हृदय सृजना गर्नुहोस्, र मभित्र स्थिर आत्मा पुनर्जीवित पार्नुहोस्!<verse eid="PSA 51:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 51:11"/>तपाईंको उपस्थितिबाट मलाई टाढा नहटाउनुहोस्, र तपाईंको पवित्र आत्मा मबाट नलैजानुहोस्!<verse eid="PSA 51:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 51:12"/>तपाईंको मुक्तिको आनन्द मलाई फेरि दिनुहोस्, र मलाई सम्हाल्न तत्पर आत्मा दिनुहोस्!<verse eid="PSA 51:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 51:13"/>तब म अपराधीहरूलाई तपाईंका मार्गहरू सिकाउनेछु, ताकि पापीहरू तपाईंतिर फर्केर आऊन्।<verse eid="PSA 51:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 51:14"/>हे मेरा मुक्तिदाता परमेश्‍वर, मलाई हत्याको दोषबाट छुटकारा दिनुहोस् र मेरो ओठले तपाईंको धार्मिकता गाउनेछु।<verse eid="PSA 51:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 51:15"/>हे प्रभु, मेरा ओठहरू खोलिदिनुहोस्, र मेरो मुखले तपाईंको प्रशंसाको घोषणा गर्नेछ।<verse eid="PSA 51:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 51:16"/>बलिदानहरूमा तपाईं खुशी हुनुहुन्‍न, नत्रता म बलिदान चढाउनेथिएँ; तपाईं होमबलिमा प्रसन्‍न हुनुहुन्‍न।<verse eid="PSA 51:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 51:17"/>हे परमेश्‍वर, तोडिएको मन नै मेरो बलिदान हो; हे परमेश्‍वर, तपाईंले चूर्ण र पश्‍चात्तापी हृदयलाई कहिल्यै तिरस्कार गर्नुहुन्‍न।<verse eid="PSA 51:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 51:18"/>तपाईंको कृपाले सियोनको समृद्धि होस्, यरूशलेमका पर्खालहरू निर्माण गरिदिनुहोस्।<verse eid="PSA 51:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 51:19"/>तब तपाईं धर्मीहरूका बलिदानहरूमा प्रसन्‍न हुनुहुनेछ, सिङ्गो चढाइएका होमबलिहरूमा; तब तपाईंको वेदीमा साँढेहरू बलि चढाइनेछन्।<verse eid="PSA 51:19"/></para>
<chapter eid="PSA 51"/>
<chapter number="52" style="c" sid="PSA 52"/>
<para style="p"><verse number="1" style="v" sid="PSA 52:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको मस्किल*—जब एदोमी दोएग शाऊल राजाकहाँ गएर दावीदको बारेमा भनेका थिए: “दावीद अहीमेलेकको घरमा गएका छन्।” हे वीर मानिस, तँ किन आफ्ना दुष्‍ट काममा गर्व गर्छस्? किन सारा दिन घमण्ड गर्छस्, तँ, जो परमेश्‍वरको दृष्‍टिमा घृणित छस्?<verse eid="PSA 52:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 52:2"/>तँ छली कुरा गर्छस्, तेरा जिब्रोले विनाश पार्ने युक्ति रच्दछ; यो धारिलो छुरीजस्तै छ।<verse eid="PSA 52:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 52:3"/>तँ असल कुराभन्दा खराब कुरा मन पराउँछस्; सत्य कुरा बोल्नुभन्दा बरु झूटो कुरा गर्न रुचाउँछस्।<verse eid="PSA 52:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 52:4"/>ए छली जिब्रो! तँलाई हरेक हानिकारक शब्दहरू मन पर्छ।<verse eid="PSA 52:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 52:5"/>निश्‍चय नै परमेश्‍वरले तँलाई अनन्तको विनाशमा फाल्नुहुनेछ: उहाँले तँलाई तानेर तेरो वासस्थानबाट निकाल्नुहुनेछ; उहाँले तँलाई जीवितहरूका देशबाट जरैसमेत उखेल्नुहुनेछ।<verse eid="PSA 52:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 52:6"/>धर्मी जनहरू त्यो देखेर भय मान्‍नेछन्। तिनीहरूले यसो भनी तेरो हाँसो उडाउनेछन्,<verse eid="PSA 52:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 52:7"/>“यो त्यही मानिस हो, जसले परमेश्‍वरलाई आफ्नो शरणस्थान बनाएन, तर त्यसले आफ्नो धेरै धनसम्पत्तिमा भरोसा राख्यो, र अरूलाई विनाश गर्दै आफूचाहिँ बलियो भयो!”<verse eid="PSA 52:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 52:8"/>तर मचाहिँ परमेश्‍वरको भवनमा बढेको हरियो जैतुनको रूखजस्तो छु; म परमेश्‍वरको अचुक प्रेममा सदासर्वदा भरोसा गर्दछु।<verse eid="PSA 52:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 52:9"/>तपाईंले गर्नुभएका कार्यहरूका कारण भक्तजनहरूको उपस्थितिमा सधैँ म तपाईंको प्रशंसा गर्नेछु, र तपाईंको नाममा म आशा राख्नेछु; किनकि तपाईंको नाम असल छ।<verse eid="PSA 52:9"/></para>
<chapter eid="PSA 52"/>
<chapter number="53" style="c" sid="PSA 53"/>
<para style="p"><verse number="1" style="v" sid="PSA 53:1"/>सङ्गीत निर्देशकको निम्ति, महलत* शैली, दावीदको मस्किल।* मूर्खले आफ्नो मनमा भन्छ, “परमेश्‍वर छँदैछैन।” तिनीहरू भ्रष्‍ट छन्, र तिनीहरूका चाल लाजमर्दो छ; असल काम गर्ने कोही पनि छैन।<verse eid="PSA 53:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 53:2"/>परमेश्‍वरले स्वर्गबाट सबै मानिस जातिलाई हेर्नुहुन्छ यो जान्‍नलाई कि कोही त समझदार होला, जसले परमेश्‍वरको खोजी गर्दछ?<verse eid="PSA 53:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 53:3"/>तर हरेक मानिस भड्किगएका छन्, सबै जना भ्रष्‍ट भएका छन्; असल गर्ने कोही छैन, एक जना पनि छैन।<verse eid="PSA 53:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 53:4"/>के यी सबै दुष्‍ट काम गर्नेहरूले केही पनि जान्दैनन्? रोटी खाएझैँ तिनीहरूले मेरा मानिसहरूलाई खान्छन्; तिनीहरूले परमेश्‍वरलाई कहिल्यै पुकार्दैनन्।<verse eid="PSA 53:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 53:5"/>तर जहाँ डराउनुपर्ने कुनै कारण नै थिएन, त्यहीँ नै तिनीहरू डरले व्याकुल भए। परमेश्‍वरले तिमीहरूलाई आक्रमण गर्नेहरूका हड्डीहरू छरपस्ट पार्नुभएको छ; तिमीहरूले तिनीहरूलाई शर्ममा पारेका छौ; किनभने परमेश्‍वरले तिनीहरूलाई इन्कार गर्नुभएको थियो।<verse eid="PSA 53:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 53:6"/>अहो, इस्राएलको मुक्ति सियोनबाट आएको भए त कति असल हुनेथियो! जब परमेश्‍वरले आफ्नो मानिसहरूको सुदिन फर्काइदिनुहुन्छ, तब याकोब रमाओस्, र इस्राएल आनन्दित होस्।<verse eid="PSA 53:6"/></para>
<chapter eid="PSA 53"/>
<chapter number="54" style="c" sid="PSA 54"/>
<para style="p"><verse number="1" style="v" sid="PSA 54:1"/>सङ्गीत निर्देशकको निम्ति, तारवाद्यमा आधारित, दावीदको मस्किल*—जब जीपीहरू शाऊलकहाँ गएर भनेका थिए, “के दावीद हामीहरूका माझमा लुकेका छैनन् र?” हे परमेश्‍वर, तपाईंको नामद्वारा मलाई बचाउनुहोस्; तपाईंको शक्तिद्वारा मलाई निर्दोष साबित गर्नुहोस्!<verse eid="PSA 54:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 54:2"/>हे परमेश्‍वर, मेरो प्रार्थना सुन्‍नुहोस्; मेरा मुखका शब्दहरू सुनिदिनुहोस्!<verse eid="PSA 54:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 54:3"/>मलाई परदेशीहरूले आक्रमण गर्छन्; मलाई निर्दयी मानिसहरूले मार्न खोज्छन्— ती मानिसहरूले परमेश्‍वरको श्रद्धा गर्दैनन्। सेला<verse eid="PSA 54:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 54:4"/>हेर, परमेश्‍वर मेरा सहायक हुनुहुन्छ; प्रभुले नै मलाई सहारा दिनुहुन्छ।<verse eid="PSA 54:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 54:5"/>मेरा विरोधीहरूका खराबी तिनीहरूमाथि नै फर्किऊन्; तपाईंको विश्‍वसनीयतामा तिनीहरूलाई सर्वनाश गर्नुहोस्!<verse eid="PSA 54:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 54:6"/>म तपाईंलाई स्वेच्छाबलि चढाउनेछु; हे याहवेह, तपाईंको नामको प्रशंसा म गर्नेछु; किनकि त्यो असल कुरा हो।<verse eid="PSA 54:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 54:7"/>तपाईंले मलाई मेरा सबै सङ्कष्‍टहरूबाट छुटाउनुभएको छ; र मेरा आँखाहरूले मेरा वैरीहरूमाथि मेरो विजयी देख्दछु।<verse eid="PSA 54:7"/></para>
<chapter eid="PSA 54"/>
<chapter number="55" style="c" sid="PSA 55"/>
<para style="p"><verse number="1" style="v" sid="PSA 55:1"/>सङ्गीत निर्देशकको निम्ति, तारवाद्यमा आधारित, दावीदको मस्किल।* हे परमेश्‍वर, मेरो प्रार्थना सुन्‍नुहोस्; मेरो बिन्तीलाई बेवास्ता नगर्नुहोस्!<verse eid="PSA 55:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 55:2"/>मलाई सुन्‍नुहोस्, र मलाई जवाफ दिनुहोस्। मेरो मन धेरै दुःखित छ, र म व्याकुल भएको छु,<verse eid="PSA 55:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 55:3"/>मेरा शत्रुहरूको आवाजको कारणले, दुष्‍टहरूका धम्कीले गर्दा। किनकि तिनीहरूले ममाथि कष्‍ट ल्याएका छन्, र तिनीहरूका क्रोधमा मलाई सताउने गर्दछन्।<verse eid="PSA 55:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 55:4"/>मेरो हृदय मभित्र धेरै पीडामा छ; मृत्युको त्रास ममा परेको छ।<verse eid="PSA 55:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 55:5"/>डर र कम्पनले मलाई डुबाएको छ; त्रासले मलाई व्याकुल बनाएको छ।<verse eid="PSA 55:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 55:6"/>मैले भनेँ, “ओह, ढुकुरको जस्तै मेरा पखेटा भए त! म उडेर टाढा जानेथिएँ, र विश्राम लिनेथिएँ।<verse eid="PSA 55:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 55:7"/>म उडेर धेरै टाढासम्म जानेथिएँ, र मरुभूमिमा बस्‍नेथिएँ। सेला<verse eid="PSA 55:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 55:8"/>डरलाग्दा आँधीबेहरी र हुरीबाट धेरै टाढा, मेरो शरणस्थानतिर आतुरीसाथ जानेथिएँ।”<verse eid="PSA 55:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 55:9"/>हे प्रभु, दुष्‍टहरूलाई खलबल्याइदिनुहोस्; तिनीहरूका योजनालाई निरुत्साहित पारिदिनुहोस्; किनकि मैले सहरमा हिंसा र झैझगडा देख्दछु।<verse eid="PSA 55:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 55:10"/>तिनीहरू सहरका पर्खालहरूमा चढेर शिकारको खोजमा दिनरात वरिपरि घुम्छन्; त्यस सहरभित्र दुष्‍टता र उपद्रव छन्।<verse eid="PSA 55:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 55:11"/>सहरभित्र विनाशकारी शक्तिहरू सक्रिय छन्; त्यसका गल्‍लीहरूलाई धम्की र झूटले कहिल्यै छोड्दैन।<verse eid="PSA 55:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 55:12"/>यदि मेरा शत्रुहरूले मलाई अपमान गरेका भए, म त्यो सहन सक्नेथिएँ; यदि मेरा वैरीहरू मेरो विरुद्धमा उठेका भए, म लुक्न सक्नेथिएँ।<verse eid="PSA 55:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 55:13"/>तर त्यो त मजस्तै मानिस, तँ नै होस्, मेरो सहकर्मी, मेरो घनिष्‍ठ साथी,<verse eid="PSA 55:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 55:14"/>जससँग मेरो एक समय मिठो सम्बन्ध थियो; मानिसहरूको भीडमा, हामी एकसाथ हिँड्थ्यौँ, परमेश्‍वरको भवनमा सँगै जान्थ्यौँ।<verse eid="PSA 55:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 55:15"/>मेरा शत्रुहरूलाई मृत्युले अचानक लैजाओस्; तिनीहरू चिहानमा जीवितै जाऊन्; किनकि तिनीहरूका बीच दुष्‍टताले बास गर्दछ।<verse eid="PSA 55:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 55:16"/>तर मचाहिँ परमेश्‍वरलाई पुकार्छु; र याहवेहले मलाई बचाउनुहुन्छ।<verse eid="PSA 55:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 55:17"/>साँझ, बिहान र दिउँसो दुःख-कष्‍टमा म उहाँलाई पुकार्छु, र उहाँले मेरो सोर सुन्‍नुहुन्छ।<verse eid="PSA 55:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 55:18"/>विरोधीहरूका विरुद्धमा लडिरहेको युद्धबाट उहाँले मलाई विनाचोट बचाउनुहुन्छ, यद्यपि मेरो विरुद्धमा धेरै विरोधीहरू छन्।<verse eid="PSA 55:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 55:19"/>परमेश्‍वर, जो सनातनदेखि सिंहासनमा विराजमान हुनुहुन्छ, जो कहिल्यै पनि बदलिनुहुन्‍न, उहाँले तिनीहरूलाई सुन्‍नुहुनेछ र तिनीहरूलाई नम्र तुल्याउनुहुनेछ; किनकि तिनीहरूले परमेश्‍वरको डर मान्दैनन्।<verse eid="PSA 55:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 55:20"/>मेरा सहकर्मीले उसका आफ्नै मित्रहरूलाई आक्रमण गर्छ; उसले आफ्नो प्रतिज्ञा भङ्ग गर्छ।<verse eid="PSA 55:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 55:21"/>उसको मुखको बोली घिउजस्तै चिप्लो छ, तर उसको हृदयमा युद्ध हुन्छ; उसका कुराहरू तेलभन्दा चिप्ला छन्, तर ती नाङ्गा तरवारहरू हुन्।<verse eid="PSA 55:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 55:22"/>आफ्नो बोझ याहवेहमा राख; र उहाँले तिमीलाई सम्हाल्नुहुनेछ। उहाँले कहिल्यै धर्मीहरूलाई हार्न दिनुहुनेछैन।<verse eid="PSA 55:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 55:23"/>तर हे परमेश्‍वर, तपाईंले दुष्‍टहरूलाई विनाशको खाडलमा खसाल्नुहुनेछ; हत्यारा र छली मानिसहरू तिनीहरूका आयुको अवधिको आधा समयसम्म पनि बाँच्नेछैनन्। तर मचाहिँ तपाईंमा भरोसा राख्दछु।<verse eid="PSA 55:23"/></para>
<chapter eid="PSA 55"/>
<chapter number="56" style="c" sid="PSA 56"/>
<para style="p"><verse number="1" style="v" sid="PSA 56:1"/>सङ्गीत निर्देशकको निम्ति, टाढाको बाजको रूखको ढुकुरको लयमा आधारित, दावीदको मिक्ताम;* जब पलिश्तीहरूले उनलाई गातमा पक्रेका थिए। हे परमेश्‍वर, ममाथि दया देखाउनुहोस्; किनकि मेरा शत्रुहरूले मेरो खेदो गर्छन्; तिनीहरूले मलाई दिनभरि नै आक्रमण गरिरहन्छन्।<verse eid="PSA 56:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 56:2"/>मेरा विरोधीहरूले दिनभरि नै मलाई खेदो गर्छन्; आफ्ना घमण्डमा धेरै जनाले मलाई आक्रमण गर्दछन्।<verse eid="PSA 56:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 56:3"/>जब म डराउँछु, तब तपाईंमा भरोसा राख्दछु।<verse eid="PSA 56:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 56:4"/>परमेश्‍वरमा, जसको वचनको प्रतिज्ञाको म प्रशंसा गर्दछु— म उहाँमा भरोसा राख्छु र डराउँदिनँ, मरणशील मानिसले मलाई के गर्न सक्छ र?<verse eid="PSA 56:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 56:5"/>तिनीहरूले दिनभरि नै मेरा कुराहरूको उल्टो अर्थ लगाउँछन्; तिनीहरूका सबै योजनाहरू मेरो हानिको लागि हुन्छन्।<verse eid="PSA 56:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 56:6"/>मलाई मार्ने आशामा तिनीहरू षड्यन्त्र रच्छन्, लुकी बस्छन्; तिनीहरूले मेरा कदमहरू नियाल्छन्।<verse eid="PSA 56:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 56:7"/>तिनीहरूका दुष्‍टताको कारण तिनीहरूलाई उम्कन नदिनुहोस्; हे परमेश्‍वर, तपाईंको रिसमा राष्ट्रहरूलाई ढालिदिनुहोस्!<verse eid="PSA 56:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 56:8"/>तपाईंले मेरो विलापको लेखा राख्नुहोस्; मेरा आँसुको हिसाब बोतलमा राख्नुहोस्— तपाईंको पुस्तकमा के ती सबै लेखिएका छैनन् र?<verse eid="PSA 56:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 56:9"/>जब म सहायताको निम्ति पुकार्छु, तब मेरा शत्रुहरू मबाट पछि हटेर जानेछन्। यस कुराबाट परमेश्‍वर मेरो पक्षमा हुनुहुन्छ भन्‍ने कुरा म जान्दछु।<verse eid="PSA 56:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 56:10"/>परमेश्‍वरमा, जसको प्रतिज्ञाको म प्रशंसा गर्दछु, याहवेहमा, जसको प्रतिज्ञाको म प्रशंसा गर्दछु—<verse eid="PSA 56:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 56:11"/>परमेश्‍वरमा म भरोसा राख्दछु; र म डराउँदिनँ। मलाई मरणशील मानिसले के गर्न सक्छ र?<verse eid="PSA 56:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 56:12"/>हे मेरा परमेश्‍वर, मैले तपाईंसँग भाकलहरू गरेको छु; मेरो धन्यवादको बलि म तपाईंलाई चढाउनेछु;<verse eid="PSA 56:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 56:13"/>किनकि तपाईंले मलाई मृत्युबाट बचाउनुभएको छ; र मेरा पाउलाई ठेस लाग्नदेखि बचाइदिनुभएको छ, ताकि म परमेश्‍वरको सामु जीवनको ज्योतिमा हिँड्न सकूँ।<verse eid="PSA 56:13"/></para>
<chapter eid="PSA 56"/>
<chapter number="57" style="c" sid="PSA 57"/>
<para style="p"><verse number="1" style="v" sid="PSA 57:1"/>सङ्गीत निर्देशकको निम्ति, “विनाश नगर” लयमा आधारित, शाऊलबाट भागेर ओडारमा बास बस्दा दावीदको मिक्ताम।* ममाथि कृपा गर्नुहोस्, हे मेरा परमेश्‍वर, ममाथि कृपा गर्नुहोस्; किनकि म तपाईंमा शरण लिन्छु। जबसम्म यो विपत्ति हट्दैन, तबसम्म म तपाईंको पखेटाको छायामुनि शरण लिनेछु।<verse eid="PSA 57:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 57:2"/>म सर्वोच्‍च परमेश्‍वरलाई पुकार्छु, परमेश्‍वरलाई, जसले मलाई निर्दोष प्रमाणित गर्नुहुन्छ।<verse eid="PSA 57:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 57:3"/>उहाँले स्वर्गबाट सहायता पठाउनुहुन्छ र मलाई बचाउनुहुन्छ; मलाई खेदो गर्नेहरूलाई उहाँले हप्काउनुहुन्छ, सेला परमेश्‍वरले आफ्नो अचुक प्रेम र विश्‍वसनीयता पठाउनुहुन्छ।<verse eid="PSA 57:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 57:4"/>म सिंहहरूको बीचमा छु; हिँस्रक जनावरहरूजस्ता मानिसहरूका बीचमा बस्‍न म बाध्य छु; जसका दाँतहरू धारिला तरवार र काँड हुन्, जसका जिब्रा धारिलो तरवारजस्तै छन्।<verse eid="PSA 57:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 57:5"/>हे परमेश्‍वर, स्वर्गभन्दा उच्‍च हुनुहोस्; सारा पृथ्वीमाथि तपाईंको महिमा रहोस्!<verse eid="PSA 57:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 57:6"/>तिनीहरूले मेरा पाउहरूका निम्ति जाल बिछाएका छन्; म सङ्कष्‍टले झुकेको छु। तिनीहरूले मेरो मार्गमा खाडल खनेका छन्, तर तिनीहरू त्यस खाडलमा आफैँ परेका छन्। सेला<verse eid="PSA 57:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 57:7"/>हे परमेश्‍वर, मेरो हृदय स्थिर छ, मेरो हृदय स्थिर छ; म गाउनेछु र धुन बजाउनेछु।<verse eid="PSA 57:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 57:8"/>हे मेरो प्राण, उठ्! हे सारङ्गी र वीणा जाग्! म प्रभातलाई जगाउनेछु।<verse eid="PSA 57:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 57:9"/>हे प्रभु, राष्ट्र-राष्ट्रहरूका बीचमा म तपाईंको प्रशंसा गर्नेछु; जाति-जातिहरूबीच म तपाईंको स्तुति गाउनेछु।<verse eid="PSA 57:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 57:10"/>किनकि तपाईंको प्रेम महान् छ, आकाशझैँ उच्‍च छ; तपाईंको विश्‍वासयोग्यता आकाशसम्मै पुग्दछ।<verse eid="PSA 57:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 57:11"/>हे परमेश्‍वर, स्वर्गभन्दा उच्‍च हुनुहोस्; सारा पृथ्वीमाथि तपाईंको महिमा रहोस्!<verse eid="PSA 57:11"/></para>
<chapter eid="PSA 57"/>
<chapter number="58" style="c" sid="PSA 58"/>
<para style="p"><verse number="1" style="v" sid="PSA 58:1"/>सङ्गीत निर्देशकको निम्ति, “विनाश नहोस्” रागमा आधारित, दावीदको मिक्ताम। हे शासकहरू हो, के तिमीहरू न्यायपूर्वक बोल्दछौ? के तिमीहरू मानिसहरूलाई समान रूपमा न्याय गर्छौ?<verse eid="PSA 58:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 58:2"/>होइन, तिमीहरू हृदयमा अन्याय रच्दछौ; र पृथ्वीमा तिमीहरूका आफ्ना हातले हिंसाका काम गर्छन्।<verse eid="PSA 58:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 58:3"/>दुष्‍ट मानिसहरू जन्मैदेखि भड्केर जान्छन्; तिनीहरू गर्भदेखि नै पथभ्रष्‍ट हुन्छन्, झूटो फैलाउँछन्।<verse eid="PSA 58:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 58:4"/>तिनीहरूको विष विषालु सर्पको विषजस्तै छ; तिनीहरू गोमन सर्पजस्तै छन्, जसले आफ्नो कान बन्द गरेको छ,<verse eid="PSA 58:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 58:5"/>सपेराको सङ्गीतको धुन होस्, या जतिसुकै निपुण जादुगरको जादु होस्, तिनको सोर सुनिँदैन।<verse eid="PSA 58:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 58:6"/>हे परमेश्‍वर, तिनीहरूका दाँत तिनीहरूकै मुखमा तोडिदिनुहोस्; हे याहवेह, ती सिंहहरूका बङ्गाराहरू भाँचिदिनुहोस्!<verse eid="PSA 58:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 58:7"/>बग्ने पानीजस्तै तिनीहरू विलाइजाऊन्; जब तिनीहरूले धनुमा ताँदो चढाउँछन्, तब तिनीहरूका काँडहरू निशानासम्म नपुगून्।<verse eid="PSA 58:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 58:8"/>चिप्ले किराजस्तै तिनीहरू हिँड्दा-हिँड्दै पग्लेर जाऊन्; जन्मिनै नपाई तुहेको बालकजस्तै तिनीहरूले सूर्यको उज्यालो कहिल्यै नदेखून्।<verse eid="PSA 58:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 58:9"/>तिम्रा भाँडाहरू काँडाको आगोमा तात्तिन अगि, ती हरिया हुन् वा सुकेका, दुष्‍टहरू बगाएर लगिनेछन्।<verse eid="PSA 58:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 58:10"/>जब पापीहरूमाथि बदला खनिन्छ, जब धर्मी जनहरूको पाउहरू दुष्‍टहरूको रगतमा चोबिन्छन्, तब धर्मी जनहरू हर्षित हुनेछन्।<verse eid="PSA 58:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 58:11"/>तब मानिसहरूले भन्‍नेछन्, “निश्‍चय नै धर्मी जनहरू पुरस्कृत हुन्छन्; साँच्‍चै नै परमेश्‍वर हुनुहुन्छ, जसले पृथ्वीको न्याय गर्नुहुन्छ।”<verse eid="PSA 58:11"/></para>
<chapter eid="PSA 58"/>
<chapter number="59" style="c" sid="PSA 59"/>
<para style="p"><verse number="1" style="v" sid="PSA 59:1"/>सङ्गीत निर्देशकको निम्ति, “विनाश नहोस्” को रागमा आधारित, दावीदको मिक्ताम,* जब शाऊलले दावीदलाई मार्न भनी उनका घरमा सुराकी गर्न पठाएका थिए। हे परमेश्‍वर, मलाई मेरा शत्रुहरूबाट छुटाउनुहोस्; मलाई आक्रमण गर्नेहरूबाट रक्षा गर्नुहोस्।<verse eid="PSA 59:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 59:2"/>दुष्‍ट कार्य गर्नेहरूबाट मलाई छुटकारा दिनुहोस्, र मेरो प्राण लिन खोज्नेहरूबाट मलाई बचाउनुहोस्।<verse eid="PSA 59:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 59:3"/>हेर्नुहोस्, मेरो प्राण लिनलाई तिनीहरू कसरी ढुकेर बसेका छन्! हे याहवेह, मेरो दोष वा पाप नभए तापनि कारणविना क्रूर मानिसहरू मेरो विरुद्धमा षड्यन्त्र रच्दछन्।<verse eid="PSA 59:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 59:4"/>मेरो कुनै दोषविना नै तिनीहरू मलाई आक्रमण गर्न तयार छन्। मलाई सहायता गर्न उठ्नुहोस्; मेरो दुर्गतिमा दृष्‍टि गर्नुहोस्।<verse eid="PSA 59:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 59:5"/>हे याहवेह, सेनाहरूका परमेश्‍वर, हे इस्राएलका परमेश्‍वर, सबै राष्ट्रहरूलाई दण्ड दिन तपाईं जाग्नुहोस्; विश्‍वासघातीहरूमाथि कुनै दया नदेखाउनुहोस्। सेला<verse eid="PSA 59:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 59:6"/>तिनीहरू साँझपख कुकुरहरूजस्तै घुर्दै, सहरको चारैतिर आउँछन्।<verse eid="PSA 59:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 59:7"/>हेर्नुहोस्, तिनीहरूको मुखबाट के निकाल्छन्— तिनीहरूका ओठबाट निक्लेका शब्दहरू तरवारजस्तै धारिला छन्; अनि तिनीहरू सोच्दछन्, “हामीलाई कसले सुन्‍न सक्छ र?”<verse eid="PSA 59:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 59:8"/>तर हे याहवेह, तपाईं तिनीहरूमाथि हाँस्‍नुहुन्छ; तपाईं सबै राष्ट्रहरूको उपहास गर्नुहुन्छ।<verse eid="PSA 59:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 59:9"/>तपाईं मेरो शक्ति हुनुहुन्छ, म तपाईंको प्रतीक्षा गर्दछु; हे परमेश्‍वर, तपाईं मेरो शरणस्थान हुनुहुन्छ।<verse eid="PSA 59:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 59:10"/>मेरो परमेश्‍वरको अचुक प्रेममा, उहाँ मसँग खडा हुनुहुनेछ, र परमेश्‍वर मेरो अगाडि जानुहुनेछ। उहाँले मलाई मेरा शत्रुहरूमाथि विजय देख्न दिनुहुनेछ।<verse eid="PSA 59:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 59:11"/>तर हे प्रभु, हाम्रा ढाल, तिनीहरूलाई नमार्नुहोस्, नत्रता मेरा मानिसहरूले भुल्नेछन्। तपाईंको शक्तिले तिनीहरूलाई उखेल्नुहोस् र तिनीहरूलाई होच्याउनुहोस्।<verse eid="PSA 59:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 59:12"/>तिनीहरूका मुखको पापको फल, तिनीहरूका ओठका शब्दहरूका कारण, तिनीहरू आफ्नै घमण्डमा फसून्। तिनीहरूले बोलेका श्राप र झूटका कारण,<verse eid="PSA 59:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 59:13"/>तपाईंको क्रोधमा तिनीहरूलाई भस्म पार्नुहोस्, तिनीहरू पूरै नष्‍ट नहोउन्जेल भस्म गर्नुहोस्। तब पृथ्वीको छेउसम्मै मानिसहरूले जान्‍नेछन्, कि परमेश्‍वरले इस्राएलमाथि र संसारभरि राज्य गर्नुहुन्छ।<verse eid="PSA 59:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 59:14"/>तिनीहरू साँझपख कुकुरहरूजस्तै घुर्दै सहरको चारैतिर आउँछन्।<verse eid="PSA 59:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 59:15"/>तिनीहरू आहाराको खोजीमा भौँतारिन्छन्, अनि तिनीहरू आहाराले सन्तुष्‍ट नहुँदा कराउँछन्।<verse eid="PSA 59:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 59:16"/>तर म तपाईंको शक्तिको गुणगान गाउनेछु, बिहानै म तपाईंको अचुक प्रेमको गीत गाउनेछु; किनकि तपाईं मेरा किल्‍ला हुनुहुन्छ, सङ्कष्‍टको दिनमा मेरो शरणस्थान हुनुहुन्छ।<verse eid="PSA 59:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 59:17"/>तपाईं मेरो बल हुनुहुन्छ, म तपाईंको प्रशंसा गाउनेछु; हे परमेश्‍वर, तपाईं मेरो शरणस्थान हुनुहुन्छ, मेरो प्रेमिला परमेश्‍वरमा म भरोसा गर्न सक्छु।<verse eid="PSA 59:17"/></para>
<chapter eid="PSA 59"/>
<chapter number="60" style="c" sid="PSA 60"/>
<para style="p"><verse number="1" style="v" sid="PSA 60:1"/>सङ्गीत निर्देशकको निम्ति, “करारको लिली” लयमा आधारित, दावीदको मिक्ताम,* जब उनले अराम नहरेम र आराम सोबाह, र नुनको बेँसीमा युद्ध गरे, तब योआबले 12 हजार एदोमीहरूलाई मारेर फर्के। हे परमेश्‍वर, तपाईंले हामीलाई त्यागिदिनुभएको छ, र हामीलाई तोडिदिनुभएको छ; तपाईं हामीसँग रिसाउनुभएको छ—अब हामीलाई पुनर्स्थापित गर्नुहोस्!<verse eid="PSA 60:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 60:2"/>तपाईंले धर्तीलाई हल्‍लाउनुभएको छ, र त्यसलाई फटाएर खुल्‍ला पार्नुभएको छ; पृथ्वीका धाँदाहरू जोडिदिनुहोस्; किनकि त्यो हल्‍लिँदैछ।<verse eid="PSA 60:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 60:3"/>तपाईंले तपाईंका मानिसहरूलाई अति कठिन समयहरू भोग्न दिनुभएको छ; तपाईंले हामीलाई पिएर धरमराइदिने मद्य दिनुभएको छ।<verse eid="PSA 60:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 60:4"/>तपाईंको भय मान्‍नेहरूका लागि तपाईंले विजयको झण्डा उच्‍च पार्नुभएको छ, ताकि तिनीहरूले धनुबाट सुरक्षा पाउन सकून्। सेला<verse eid="PSA 60:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 60:5"/>तपाईंको दाहिने हातले हामीलाई बचाउनुहोस्, र मदत गर्नुहोस्; ताकि तपाईंका प्रियजनहरूले छुटकारा पाऊन्।<verse eid="PSA 60:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 60:6"/>परमेश्‍वरले उहाँको वासस्थानबाट बोल्नुभएको छ: “विजयमा म शेकेमलाई विभाजन गर्नेछु, र सुक्‍कोतको बेँसीलाई नापेर छुट्ट्याउनेछु।<verse eid="PSA 60:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 60:7"/>गिलाद मेरो हो, र मनश्शे पनि मेरै हो; एफ्राइम मेरो टोप हो, यहूदा मेरो राजदण्ड हो।<verse eid="PSA 60:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 60:8"/>मोआब मेरो हात धुने भाँडो हो, एदोममा म आफ्नो जुत्ता फाल्नेछु; पलिश्तीमाथिको विजयमा म कराउँछु।”<verse eid="PSA 60:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 60:9"/>किल्‍ला भएको सहरमा मलाई कसले पुर्‍याइदेला? कसले मलाई एदोमसम्म डोर्‍याउला?<verse eid="PSA 60:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 60:10"/>हे परमेश्‍वर, तपाईं नै होइन, जसले हामीलाई अहिले त्याग्नुभएको छ, र अहिले हाम्रा सेनाहरूका साथमा पनि जानुभएन?<verse eid="PSA 60:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 60:11"/>शत्रुहरूका विरुद्धमा हामीलाई सहायता गर्नुहोस्; किनकि मानिसको सहायता व्यर्थ छ।<verse eid="PSA 60:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 60:12"/>परमेश्‍वरको सहायताद्वारा हामीले विजय प्राप्‍त गर्नेछौँ, र उहाँले हाम्रा शत्रुहरूलाई कुल्चनुहुनेछ।<verse eid="PSA 60:12"/></para>
<chapter eid="PSA 60"/>
<chapter number="61" style="c" sid="PSA 61"/>
<para style="p"><verse number="1" style="v" sid="PSA 61:1"/>सङ्गीत निर्देशकको निम्ति, तारवाद्यमा आधारित, दावीदको भजन। हे परमेश्‍वर, मेरो पुकार सुन्‍नुहोस्; मेरो प्रार्थना सुनिदिनुहोस्।<verse eid="PSA 61:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 61:2"/>जब मेरो हृदय धेरै व्याकुल हुन्छ, तब म पृथ्वीको छेउदेखि तपाईंलाई पुकार्दछु; मभन्दा धेरै अग्लो चट्टानमा मलाई लैजानुहोस्।<verse eid="PSA 61:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 61:3"/>किनकि तपाईं मेरा लागि शरणस्थान हुनुहुन्छ, तपाईं मेरा वैरीका विरुद्धमा एक बलियो धरहरा हुनुहुन्छ।<verse eid="PSA 61:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 61:4"/>तपाईंको पालमा सदासर्वदा रहिरहन, र तपाईंको पखेटामुनि शरण लिन पाऊँ भन्‍ने मेरो चाहना छ। सेला<verse eid="PSA 61:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 61:5"/>किनकि हे परमेश्‍वर, तपाईंले मेरा भाकलहरू सुन्‍नुभएको छ; तपाईंको नामको भय मान्‍नेहरूका उत्तराधिकार मलाई दिनुभएको छ।<verse eid="PSA 61:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 61:6"/>राजाको आयु बढाइदिनुहोस्; पुस्तौँसम्म उनको आयु बढाउनुहोस्।<verse eid="PSA 61:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 61:7"/>उनी परमेश्‍वरको उपस्थितिमा सदासर्वदा राज गरून्; तपाईंको अचुक प्रेम र विश्‍वासयोग्यताले उनको सुरक्षा गर्नुहोस्!<verse eid="PSA 61:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 61:8"/>तब म यसरी सदासर्वदा तपाईंको नामको स्तुतिगान गाउनेछु र प्रत्येक दिन मेरा भाकलहरू पूरा गर्नेछु।<verse eid="PSA 61:8"/></para>
<chapter eid="PSA 61"/>
<chapter number="62" style="c" sid="PSA 62"/>
<para style="p"><verse number="1" style="v" sid="PSA 62:1"/>सङ्गीत निर्देशकको निम्ति, यदूतूनका लागि, दावीदको भजन। परमेश्‍वरमा मात्र मेरो प्राणले विश्राम पाउँछ; उहाँबाट नै मेरो मुक्ति आउँछ।<verse eid="PSA 62:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 62:2"/>साँच्‍चै, उहाँ मेरो चट्टान र मेरो मुक्ति हुनुहुन्छ; उहाँ मेरो शरणस्थान हुनुहुन्छ, म कहिल्यै हार्नेछैनँ।<verse eid="PSA 62:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 62:3"/>तिमीहरूले मलाई कहिलेसम्म आक्रमण गरिबस्छौ? ढल्न लागेको पर्खाल र भत्कन लागेको बारजस्तै मानिसलाई— तिमीहरू सबै जना मिलेर मलाई ढाल्छौ?<verse eid="PSA 62:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 62:4"/>साँच्‍चै मलाई मेरो उच्‍च स्थानबाट खसाल्नलाई तिनीहरूले योजना बनाएका छन्; तिनीहरू असत्यतामा रमाउँछन्, तिनीहरूको मुखलेचाहिँ आशिष् दिन्छन्, तर तिनीहरूको हृदयले सराप्छन्। सेला<verse eid="PSA 62:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 62:5"/>हे मेरो प्राण, परमेश्‍वरमा नै विश्राम गर्; मेरो आशा उहाँबाटै आउँछ।<verse eid="PSA 62:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 62:6"/>साँच्‍चै उहाँ मात्र मेरो चट्टान र मेरो मुक्ति हुनुहुन्छ; उहाँ मेरो शरणस्थान हुनुहुन्छ, म हार्नेछैनँ।<verse eid="PSA 62:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 62:7"/>मेरो मुक्ति र मेरो सम्मान परमेश्‍वरमा आधारित छ; उहाँ मेरो बलियो चट्टान र मेरो शरणस्थान हुनुहुन्छ।<verse eid="PSA 62:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 62:8"/>हे मानिसहरू हो, हर समय उहाँमा भरोसा गर; आफ्ना हृदय उहाँको सामु पोख; किनकि परमेश्‍वर हाम्रा शरणस्थान हुनुहुन्छ।<verse eid="PSA 62:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 62:9"/>साँच्‍चै निम्न स्तरका मानिसहरू एक मुट्ठी सास मात्र हुन्; उच्‍च स्तरका मानिसहरू भ्रम मात्र हुन्। यदि तिनीहरूलाई तराजुमा जोखियो भने तिनीहरूको केही ओजन छैन; तिनीहरू दुवै एक मुट्ठी सास मात्र छन्।<verse eid="PSA 62:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 62:10"/>लुटपाट गर्ने काममा भरोसा नगर, अथवा चोरीका सामानहरूमा घमण्ड नगर; तिम्रो धनसम्पत्ति वृद्धि भए तापनि त्यसमा तिम्रो हृदय नलगाओ!<verse eid="PSA 62:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 62:11"/>एउटा कुरा परमेश्‍वरले भन्‍नुभएको छ, दुई पटक मैले सुनेको छु: “हे परमेश्‍वर, शक्ति तपाईंमा नै निहित छ;<verse eid="PSA 62:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 62:12"/>हे प्रभु, अचुक प्रेम तपाईंमा छ।” “अनि निश्‍चय नै तपाईंले प्रत्येक मानिसलाई तिनीहरूका हरेक कामअनुसारको प्रतिफल दिनुहुन्छ।”<verse eid="PSA 62:12"/></para>
<chapter eid="PSA 62"/>
<chapter number="63" style="c" sid="PSA 63"/>
<para style="p"><verse number="1" style="v" sid="PSA 63:1"/>यहूदाको मरुभूमिमा हुँदा दावीदको भजन। हे परमेश्‍वर, तपाईं मेरो परमेश्‍वर हुनुहुन्छ; म दिलोज्यानले तपाईंलाई खोज्दछु; पानी नभएको सुक्खा र बाँझो जमिनमा, मेरो प्राण तपाईंका निम्ति तिर्खाउँछ।<verse eid="PSA 63:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 63:2"/>पवित्रस्थानमा मैले तपाईंको दर्शन गरेको छु, र तपाईंको शक्ति र महिमालाई देखेको छु।<verse eid="PSA 63:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 63:3"/>तपाईंको अचुक प्रेम जीवनभन्दा पनि उत्तम छ; यसैले मेरा ओठले तपाईंको महिमा गर्नेछ।<verse eid="PSA 63:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 63:4"/>मेरो जीवनभरि नै म तपाईंको प्रशंसा गर्नेछु, र तपाईंको नाममा म मेरो हात उचाल्नेछु।<verse eid="PSA 63:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 63:5"/>मेरो प्राण अति उत्तम भोजनझैँ पूर्ण रूपमा सन्तुष्‍ट हुनेछ; स्तुतिगान गाउँदै मेरो मुखले तपाईंको प्रशंसा गर्नेछ।<verse eid="PSA 63:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 63:6"/>मेरो ओछ्यानमा म तपाईंलाई सम्झन्छु; रातको हरेक पहरमा म तपाईंलाई मनन गर्छु।<verse eid="PSA 63:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 63:7"/>किनकि तपाईं मेरो सहायक हुनुहुन्छ; म तपाईंको पखेटाको छायामुनि आनन्दले गाउँछु।<verse eid="PSA 63:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 63:8"/>मेरो सम्पूर्ण शक्तिले तपाईंलाई समात्छ; तपाईंको दाहिने हातले मलाई सम्हालेर राख्दछ।<verse eid="PSA 63:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 63:9"/>मलाई मार्न खोज्नेहरूचाहिँ नष्‍ट पारिनेछन्; तिनीहरू पृथ्वीको गहिराइ भागहरूमा जानेछन्।<verse eid="PSA 63:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 63:10"/>तिनीहरू तरवारद्वारा मारिनेछन्; र स्यालहरूको आहारा हुनेछन्।<verse eid="PSA 63:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 63:11"/>तर राजा परमेश्‍वरमा आनन्दित हुनेछन्; परमेश्‍वरको नाममा शपथ लिनेहरू सबैले उहाँलाई महिमा दिनेछन्; जबकि झूटो बोल्ने मुख थुनिनेछ।<verse eid="PSA 63:11"/></para>
<chapter eid="PSA 63"/>
<chapter number="64" style="c" sid="PSA 64"/>
<para style="p"><verse number="1" style="v" sid="PSA 64:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। हे मेरा परमेश्‍वर, मैले गुनासो गर्दा मेरो सोर सुन्‍नुहोस्; शत्रुको धम्कीबाट मेरो प्राणलाई बचाउनुहोस्!<verse eid="PSA 64:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 64:2"/>दुष्‍टहरूको गुप्‍त पासोहरूबाट कुकर्मीहरूको षड्यन्त्रहरूबाट मलाई लुकाउनुहोस्!<verse eid="PSA 64:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 64:3"/>तिनीहरूले आफ्नो जिब्रोलाई तरवारझैँ धारिलो पार्छन्, र तिनीहरूका निर्दयी शब्दहरूले प्राणघातक काँडझैँ ताकेका छन्।<verse eid="PSA 64:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 64:4"/>तिनीहरूले निर्दोषहरूलाई ढुकि पासोमा पारेर काँड हान्छन्; तिनीहरूले डरैविना अचानक काँड हान्छन्।<verse eid="PSA 64:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 64:5"/>तिनीहरूले एक-अर्कालाई आफ्ना दुष्‍ट षड्यन्त्रहरूबाट प्रोत्साहन दिन्छन्; तिनीहरूले लुकाएर पासो थाप्ने कुरा गर्छन्; तिनीहरूले भन्छन्, “यसलाई कसले देख्छ र?”<verse eid="PSA 64:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 64:6"/>तिनीहरू अन्याय रच्छन् र भन्छन्, “हामीले सिद्ध योजना बनाएका छौँ!” मानिसको मन र हृदय साँच्‍चै धूर्त छ।<verse eid="PSA 64:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 64:7"/>तर परमेश्‍वरले उहाँका काँडहरूले तिनीहरूलाई हान्‍नुहुनेछ; तिनीहरू अचानक घाइते हुनेछन्।<verse eid="PSA 64:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 64:8"/>उहाँले तिनीहरूका जिब्रोलाई तिनीहरूकै विरुद्धमा बोल्न लगाउनुहुनेछ, र तिनीहरूलाई नष्‍ट पार्नुहुनेछ; तिनीहरूलाई देख्ने सबैले गिल्‍ला गर्दै टाउको हल्‍लाउनेछन्।<verse eid="PSA 64:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 64:9"/>सबै मानिसहरू परमेश्‍वरसँग डराउनेछन्; तिनीहरूले परमेश्‍वरको कामको घोषणा गर्नेछन्; र उहाँले गर्नुभएका कामहरू विचार गर्नेछन्।<verse eid="PSA 64:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 64:10"/>धर्मी जनहरू याहवेहमा आनन्दित हुनेछन्, र उहाँमा शरण लिनेछन्; साँचो हृदय भएकाहरू सबैले उहाँको महिमा गर्नेछन्!<verse eid="PSA 64:10"/></para>
<chapter eid="PSA 64"/>
<chapter number="65" style="c" sid="PSA 65"/>
<para style="p"><verse number="1" style="v" sid="PSA 65:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन; एक गीत। हे हाम्रा परमेश्‍वर, सियोनमा प्रशंसाले तपाईंलाई पर्खिरहेको छ; तपाईंसँगको हाम्रो भाकल पूरा गर्नेछौँ।<verse eid="PSA 65:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 65:2"/>तपाईं प्रार्थना सुनेर त्यसको उत्तर दिने परमेश्‍वर हुनुहुन्छ। तपाईंकहाँ नै सबै मानिसहरू आउनेछन्।<verse eid="PSA 65:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 65:3"/>जब हाम्रा पापहरूले हामीलाई डुबाएका थिए, तब हाम्रा अपराधहरूलाई तपाईंले क्षमा गरिदिनुभयो।<verse eid="PSA 65:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 65:4"/>धन्यका हुन् ती मानिसहरू, जसलाई तपाईंले चुन्‍नुहुन्छ, र तपाईंको मन्दिरको आँगनमा बस्‍नलाई आफू नजिक ल्याउनुहुन्छ! तपाईंका पवित्र भवनका असल थोकहरूले हामी भरिएका छौँ।<verse eid="PSA 65:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 65:5"/>तपाईंले हामीलाई महान् र धार्मिक कामहरूबाट जवाफ दिनुहुन्छ; हे हाम्रा उद्धारकर्ता परमेश्‍वर, पृथ्वीको छेउसम्मका समस्त मानिसहरू र टाढा-टाढा समुद्रपारि रहने मानिसहरूका आशा तपाईं नै हुनुहुन्छ,<verse eid="PSA 65:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 65:6"/>तपाईंले आफ्नो शक्तिद्वारा पर्वतहरू निर्माण गर्नुभयो। तपाईंले आफूलाई शक्तिले सुसज्जित पार्नुभएको छ।<verse eid="PSA 65:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 65:7"/>जसले समुद्रको गर्जन र तिनका छालहरूको गर्जन, र राष्ट्रहरूबीच भएको कोलाहल शान्त गर्नुभएको छ।<verse eid="PSA 65:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 65:8"/>तपाईंका अलौकिक चिन्हहरू देखेर पृथ्वीभरिका सारा मानिसहरू छक्‍क पर्छन्; जहाँ सूर्य उदाउँछ, र जहाँ सूर्य अस्ताउँछ, तपाईंले आनन्दका गीतहरू आह्वान गर्नुहुन्छ।<verse eid="PSA 65:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 65:9"/>तपाईंले भूमिको वास्ता गर्नुहुन्छ र पानीले भिजाउनुहुन्छ; तपाईंले भूमिलाई प्रशस्त गरी मलिलो बनाउनुहुन्छ। मानिसहरूलाई अन्‍नबाली जुटाउनलाई, परमेश्‍वरका नदीहरू पानीले भरिएका छन्; किनकि तपाईंले यसरी नै निर्धारण गर्नुभएको छ।<verse eid="PSA 65:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 65:10"/>तपाईंले त्यसका गराहरूलाई पानीले भिजाउनुहुन्छ र त्यसका डीलहरूलाई सम्म पार्नुहुन्छ; तपाईंले खेतलाई झरीले भिजाएर नरम पार्नुहुन्छ, र त्यसको उब्जनीलाई आशिष् दिनुहुन्छ।<verse eid="PSA 65:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 65:11"/>तपाईंको प्रशस्तताले वर्षलाई मुकुट पहिराउनुहुन्छ र तपाईंको प्रशस्त आशिष्‌को अन्‍नबालीले तपाईंका गाडाहरू भरिएर पोखिन्छन्।<verse eid="PSA 65:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 65:12"/>मरुभूमिका वस्तु चर्ने खर्कहरू हरियो भएका छन्; डाँडाहरू हर्षले सुसज्जित छन्।<verse eid="PSA 65:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 65:13"/>हरियो खर्कहरू भेडाबाख्राहरूले भरिभराउ भएका छन्; र बेँसीहरू बालीले ढाकिएका छन्; तिनीहरू सबै आनन्दले कराउँछन् र भजन गाउँछन्।<verse eid="PSA 65:13"/></para>
<chapter eid="PSA 65"/>
<chapter number="66" style="c" sid="PSA 66"/>
<para style="p"><verse number="1" style="v" sid="PSA 66:1"/>सङ्गीत निर्देशकको निम्ति, एक गीत; एक भजन। हे सारा पृथ्वी, आनन्दसाथ परमेश्‍वरको जयजयकार गर!<verse eid="PSA 66:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 66:2"/>उहाँको नामको महिमा गर; र उहाँको प्रशंसा महिमामय बनाओ।<verse eid="PSA 66:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 66:3"/>परमेश्‍वरलाई भन, “तपाईंका कार्यहरू कति अद्‌भुत छन्! तपाईंको शक्ति यति महान् छ कि तपाईंको अगि तपाईंका शत्रुहरू निहुरिन्छन्।<verse eid="PSA 66:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 66:4"/>सारा पृथ्वी तपाईंको सामु झुक्छ; तिनीहरूले तपाईंको निम्ति प्रशंसा गाउँछन्, तिनीहरूले तपाईंको नामको गीत गाउँछन्।” सेला<verse eid="PSA 66:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 66:5"/>आओ र परमेश्‍वरले गर्नुभएका कामहरू हेर; मानिसहरूको निम्ति उहाँका अद्‌भुत कार्यहरू!<verse eid="PSA 66:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 66:6"/>उहाँले समुद्रलाई सुक्खा भूमिमा बदल्नुभयो, तिनीहरूले पैदलै सुक्खा नदी तरे— आओ, हामी उहाँमा आनन्द मनाऔँ।<verse eid="PSA 66:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 66:7"/>परमेश्‍वरले आफ्नो शक्तिद्वारा सदासर्वदा शासन गर्नुहुन्छ; उहाँको आँखाले राष्ट्रहरूलाई हेर्नुहुन्छ— तपाईंको विरुद्धमा तपाईंका विद्रोहीहरू उठ्न नसकून्। सेला<verse eid="PSA 66:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 66:8"/>हे सबै जाति-जातिहरू हो, हाम्रा परमेश्‍वरलाई प्रशंसा गर, उहाँलाई चढाइएको प्रशंसाको आवाज सुनियोस्;<verse eid="PSA 66:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 66:9"/>उहाँले हामीलाई जीवित राख्नुभएको छ, र हाम्रा खुट्टाहरूलाई चिप्लन दिनुभएको छैन।<verse eid="PSA 66:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 66:10"/>किनकि हे परमेश्‍वर, तपाईंले हामीलाई जाँच गर्नुभयो; तपाईंले हामीलाई चाँदीलाई जस्तै खार्नुभयो।<verse eid="PSA 66:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 66:11"/>तपाईंले हामीलाई कैदमा पार्नुभयो; र हाम्रो ढाडमा गह्रौँ भारी बोकाउनुभयो।<verse eid="PSA 66:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 66:12"/>तपाईंले हाम्रो शिरमाथि मानिसहरूलाई सवार गर्न दिनुभयो; हामी आगो र पानीद्वारा भएर गयौँ; तर तपाईंले हामीलाई प्रशस्तताको ठाउँमा ल्याउनुभयो।<verse eid="PSA 66:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 66:13"/>म तपाईंको मन्दिरमा होमबलि सहित आउनेछु; र तपाईंसँग गरेका मेरा भाकलहरू पूरा गर्नेछु।<verse eid="PSA 66:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 66:14"/>जब म सङ्कष्‍टमा थिएँ, मेरा ओठले प्रतिज्ञा गरेका र मेरो मुखले बोलेका भाकलहरू म पूरा गर्नेछु।<verse eid="PSA 66:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 66:15"/>म तपाईंलाई मोटा पशुहरूको बलिदान चढाउनेछु; र भेडाहरूको भेटी चढाउनेछु; म बहरहरू र बोकाहरू चढाउनेछु। सेला<verse eid="PSA 66:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 66:16"/>हे परमेश्‍वरको भय मान्‍नेहरू हो, सबै आओ र सुन; उहाँले मेरो निम्ति के गर्नुभएको छ, सो म तिमीहरूलाई बताउनेछु।<verse eid="PSA 66:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 66:17"/>मेरो मुखले उहाँलाई सहायताको निम्ति पुकारेँ; उहाँको प्रशंसा मेरो जिब्रोमा थियो।<verse eid="PSA 66:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 66:18"/>यदि मेरो हृदयमा मैले पापलाई ठाउँ दिएको भए, प्रभुले मेरो बिन्ती सुन्‍नुहुने थिएन;<verse eid="PSA 66:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 66:19"/>तर परमेश्‍वरले साँच्‍चै नै सुन्‍नुभएको छ; र उहाँले मेरो प्रार्थना सुन्‍नुभएको छ।<verse eid="PSA 66:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 66:20"/>परमेश्‍वरलाई प्रशंसा होस्, जसले मेरो प्रार्थना इन्कार गर्नुभएको छैन, वा मबाट उहाँको अचुक प्रेम रोक्नुभएको छैन!<verse eid="PSA 66:20"/></para>
<chapter eid="PSA 66"/>
<chapter number="67" style="c" sid="PSA 67"/>
<para style="p"><verse number="1" style="v" sid="PSA 67:1"/>सङ्गीत निर्देशकको निम्ति, तारवाद्यमा आधारित, एउटा भजन; एउटा गीत। परमेश्‍वर हामीप्रति अनुग्रही होऊन्, र हामीलाई आशिष् देऊन्; अनि उहाँको मुहार हामीमाथि चम्काऊन्— सेला<verse eid="PSA 67:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 67:2"/>ताकि तपाईंको मार्ग पृथ्वीमाथि प्रकट होस्, अनि तपाईंको मुक्ति सबै राष्ट्रहरूको बीचमा थाहा होस्।<verse eid="PSA 67:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 67:3"/>हे परमेश्‍वर, तपाईंको प्रशंसा मानिसहरूले गरून्; सबै जाति-जातिहरूले तपाईंको प्रशंसा गरून्।<verse eid="PSA 67:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 67:4"/>जाति-जातिहरू रमाऊन् र आनन्दले गाऊन्; किनकि तपाईंले जाति-जातिहरूलाई निष्पक्षसाथ शासन गर्नुहुन्छ, र पृथ्वीका राष्ट्रहरूलाई अगुवाइ गर्नुहुन्छ। सेला<verse eid="PSA 67:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 67:5"/>हे परमेश्‍वर, तपाईंको प्रशंसा मानिसहरूले गरून्; सबै जाति-जातिहरूले तपाईंको प्रशंसा गरून्।<verse eid="PSA 67:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 67:6"/>भूमिले आफ्नो बाली उब्जनी गर्छ; परमेश्‍वर, हाम्रा परमेश्‍वरले हामीलाई आशिष् दिनुहुन्छ।<verse eid="PSA 67:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 67:7"/>परमेश्‍वरले हामीलाई अझै आशिष् देऊन्, कि समस्त पृथ्वीका मानिसहरूले उहाँको डर मानून्।<verse eid="PSA 67:7"/></para>
<chapter eid="PSA 67"/>
<chapter number="68" style="c" sid="PSA 68"/>
<para style="p"><verse number="1" style="v" sid="PSA 68:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन; एक गीत। परमेश्‍वर उठून्, उहाँका शत्रुहरू छरपस्ट भइजाऊन्; उहाँका वैरीहरू उहाँको सामुबाट भागून्।<verse eid="PSA 68:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 68:2"/>हावाले धुवाँलाई उडाए झैँ तपाईंले तिनीहरूलाई उडाइदिनुहोस्। आगोको अगि मैन बिलाइए झैँ, परमेश्‍वरको अगि दुष्‍टहरू नष्‍ट होऊन्।<verse eid="PSA 68:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 68:3"/>तर धर्मीहरूचाहिँ खुशी होऊन्; र परमेश्‍वरको अगि तिनीहरू रमाऊन्; तिनीहरू खुशी र आनन्दित होऊन्।<verse eid="PSA 68:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 68:4"/>परमेश्‍वरको निम्ति गाओ, उहाँको नामको प्रशंसा गाओ; बादलमा सवार हुनुहुनेलाई प्रशंसा गर; उहाँको नाम याहवेह हो—उहाँको अगि आनन्दित होओ।<verse eid="PSA 68:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 68:5"/>उहाँको पवित्र वासस्थानमा परमेश्‍वर अनाथहरूका पिता र विधवाहरूका रक्षक हुनुहुन्छ।<verse eid="PSA 68:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 68:6"/>एकलो मानिसलाई परमेश्‍वरले परिवारमा बसाल्नुहुन्छ; उहाँले कैदीहरूलाई स्वतन्त्र गर्नुहुन्छ, र आनन्दित तुल्याउनुहुन्छ; तर विद्रोहीहरूचाहिँ सुक्खा भूमिमा बस्छन्।<verse eid="PSA 68:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 68:7"/>हे परमेश्‍वर, जब तपाईं आफ्ना मानिसहरूका अगि जानुभयो, जब तपाईं मरुभूमिबाट भएर अगि बढ्नुभयो, सेला<verse eid="PSA 68:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 68:8"/>तब पृथ्वी काम्यो, आकाशले झरी बर्सायो; अद्वितीय परमेश्‍वरको सामु, जो सीनै पर्वतका परमेश्‍वर हुनुहुन्छ, परमेश्‍वरको सामु, जो इस्राएलका परमेश्‍वर हुनुहुन्छ।<verse eid="PSA 68:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 68:9"/>हे परमेश्‍वर, तपाईंले प्रशस्त गरी पानी बर्साउनुभयो; तपाईंले सुक्खा भूमिलाई फेरि ताजा बनाउनुभयो।<verse eid="PSA 68:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 68:10"/>तपाईंका मानिसहरू त्यस भूमिमा बसोबास गरे; हे परमेश्‍वर, तपाईंको प्रशस्तताबाट निमुखाहरूलाई सबै कुरा जुटाउनुभयो।<verse eid="PSA 68:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 68:11"/>प्रभुले वचन घोषणा गर्नुहुन्छ; र त्यही वचनको घोषणा गर्ने स्त्रीहरूको समूह ठूलो छ:<verse eid="PSA 68:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 68:12"/>“राजा र सेनाहरू बेपत्ता गरी भाग्छन्; घरका स्त्रीहरूचाहिँ लुटका सामानहरू बाँड्छन्,<verse eid="PSA 68:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 68:13"/>जब तिमीहरू भेडाको खोरमा सुत्छौ, तब तिमीहरू ढुकुरका पखेटा चाँदी, र त्यसका प्वाँखहरू चम्किलो सुनले ढाकिएका जस्तै हुन्छौ।”<verse eid="PSA 68:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 68:14"/>जब सर्वशक्तिमान्‌ले राजाहरूलाई देशमा छरपस्ट पार्नुभयो, त्यो जल्मोन डाँडामा हिउँ परेजस्तै थियो।<verse eid="PSA 68:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 68:15"/>बाशानका पर्वतहरू, वैभवशाली पर्वतहरू, बाशानका पर्वतहरू, धेरै अग्ला पर्वतहरू,<verse eid="PSA 68:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 68:16"/>हे अग्ला चुचुराहरू हो, तिमी किन ईर्ष्याले त्यस पर्वततिर हेर्छौ, जुन पर्वतमा परमेश्‍वरले शासन गर्न रोज्नुभएको छ; जहाँ याहवेह स्वयम् सदासर्वदा बास गर्नुहुनेछ?<verse eid="PSA 68:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 68:17"/>परमेश्‍वरका रथहरू दसौँ हजार, र हजारौँ-हजार छन्; प्रभु सीनै पर्वतबाट उहाँको पवित्रस्थानमा आउनुभएको छ।<verse eid="PSA 68:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 68:18"/>जब तपाईं उच्‍चमा चढिजानुभयो, तब तपाईंले धेरै कैदीहरूलाई बन्दी बनाएर लैजानुभयो; तपाईंले मानिसहरूबाट उपहार प्राप्‍त गर्नुभयो, विद्रोही मानिसहरूबाट समेत पाउनुभयो— ताकि तपाईं, याहवेह परमेश्‍वर, त्यहाँ बास गर्न सक्नुभएको होस्।<verse eid="PSA 68:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 68:19"/>परमेश्‍वर, हाम्रा मुक्तिदाता प्रभुको प्रशंसा होस्, जसले हाम्रा दिनहुँको बोझहरू बोक्नुहुन्छ। सेला<verse eid="PSA 68:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 68:20"/>हाम्रा परमेश्‍वर हामीलाई बचाउने परमेश्‍वर हुनुहुन्छ; याहवेह प्रभुमा नै मृत्युबाट छुटकारा छ।<verse eid="PSA 68:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 68:21"/>परमेश्‍वरले निश्‍चय नै उहाँका शत्रुहरूका शिर कुच्याउनुहुनेछ; ती मानिसहरू, जसका टाउको केशले भरिएको छ, जो आफ्ना पापमा लागिरहन्छन्।<verse eid="PSA 68:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 68:22"/>प्रभु भन्‍नुहुन्छ, “म तिनीहरूलाई बाशानबाट ल्याउनेछु; म तिनीहरूलाई समुद्रको गहिराइहरूबाट फर्काइल्याउनेछु;<verse eid="PSA 68:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 68:23"/>तिमीहरूले आफ्ना खुट्टा आफ्ना वैरीहरूका रगतमा चोप्न सक, र तिमीहरूका कुकुरहरूले त्यही रगतमा जिब्रा चोप्न पाऊन्।”<verse eid="PSA 68:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 68:24"/>हे परमेश्‍वर, तपाईंको विजययात्रा देख्न सकिन्छ, मेरा परमेश्‍वर र महाराजाको पवित्रस्थानतिर विजययात्रा सवार भइरहेको छ।<verse eid="PSA 68:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 68:25"/>गायकहरू अगि-अगि छन्, तिनीहरूका पछि-पछि वाद्यवादकहरू छन्; र तिनीहरूसँग खैँजडी बजाउने कन्याहरू छन्।<verse eid="PSA 68:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 68:26"/>ठूलो महासभामा परमेश्‍वरको प्रशंसा गर! इस्राएलको सभामा याहवेहको प्रशंसा गर!<verse eid="PSA 68:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 68:27"/>सबैभन्दा सानो कुल बेन्यामीनले तिनीहरूलाई अगुवाइ गर्दछ, यहूदाका शासकहरू तिनीहरूको झुण्डमा सामेल छन्; जबूलूनका र नप्‍तालीका शासकहरू पनि तिनीहरूसँगै सामेल छन्।<verse eid="PSA 68:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 68:28"/>हे परमेश्‍वर, आफ्नो शक्तिको आह्वान गर्नुहोस्; हे परमेश्‍वर, तपाईंको शक्ति बितेको दिनमा जस्तै गरी हामीलाई देखाउनुहोस्।<verse eid="PSA 68:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 68:29"/>यरूशलेममा भएको तपाईंको मन्दिरको खातिर तपाईंको निम्ति राजाहरूले भेटीहरू ल्याउनेछन्।<verse eid="PSA 68:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 68:30"/>निगालो घारीको बीचमा रहने जङ्गली पशुलाई हप्काउनुहोस्; राष्ट्रहरूका बाछाहरूका बीचमा रहने साँढेहरूको झुण्डलाई हकार्नुहोस्! हारेपछि तिनीहरूले चाँदीका टुक्राहरू ल्याऊन्। लडाइँमा रमाउने राष्ट्रहरूलाई छरपस्ट पारिदिनुहोस्।<verse eid="PSA 68:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 68:31"/>राजदूतहरू इजिप्टबाट आउनेछन्; कूशले आफूलाई परमेश्‍वरमा समर्पण गर्नेछ।<verse eid="PSA 68:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 68:32"/>हे पृथ्वीका राज्यहरू हो, परमेश्‍वरको स्तुतिगान गर, प्रभुको प्रशंसा गाओ; सेला<verse eid="PSA 68:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 68:33"/>उहाँ, जो प्राचीनकालदेखि नै सर्वोच्‍च स्वर्गमा सवार गर्नुहुन्छ, जो शक्तिशाली आवाजका साथ गर्जनुहुन्छ।<verse eid="PSA 68:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 68:34"/>परमेश्‍वरको शक्तिको घोषणा गर, जसको महानता इस्राएलभरि छाएको छ, आकाशले उहाँको शक्ति देखाउँछ।<verse eid="PSA 68:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 68:35"/>तपाईं परमेश्‍वर, आफ्नो पवित्र वासस्थानमा अति शोभायमान हुनुहुन्छ; इस्राएलका परमेश्‍वरले उहाँका मानिसहरूलाई शक्ति र सामर्थ्य दिनुहुन्छ। परमेश्‍वरलाई प्रशंसा होस्!<verse eid="PSA 68:35"/></para>
<chapter eid="PSA 68"/>
<chapter number="69" style="c" sid="PSA 69"/>
<para style="p"><verse number="1" style="v" sid="PSA 69:1"/>सङ्गीत निर्देशकको निम्ति, “लिली फूल” को रागमा आधारित, दावीदको भजन। हे परमेश्‍वर, मलाई बचाउनुहोस्; किनकि पानी मेरो घाँटीसम्म आइसकेको छ।<verse eid="PSA 69:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 69:2"/>म गहिरो दलदलमा डुब्दैछु, जहाँ उभिने ठाउँ नै छैन। म गहिरो पानीमा डुबेको छु; बाढीहरू ममाथि उर्लन्छन्।<verse eid="PSA 69:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 69:3"/>सहायताको लागि पुकार गर्दा-गर्दा म थाकिसकेको छु; मेरो घाँटी सुकेको छ। मेरा परमेश्‍वरको खोजी गर्दा-गर्दा मेरा आँखाहरू कमजोर भएका छन्।<verse eid="PSA 69:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 69:4"/>कारणविना मलाई घृणा गर्नेहरू मेरो टाउकोका केशभन्दा धेरै छन्; कारणविना मेरा शत्रुहरू धेरै छन्, जसले मलाई मार्न खोजिहिँड्छन्। जुन कुरा मैले चोरेकै छैनँ, मलाई त्यसको भरपाई गर्न बाध्य तुल्याइएको छु।<verse eid="PSA 69:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 69:5"/>हे परमेश्‍वर, तपाईं मेरो मूर्खता जान्‍नुहुन्छ; मेरा दोषहरू तपाईंबाट लुकेका छैनन्।<verse eid="PSA 69:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 69:6"/>हे प्रभु, सेनाहरूका याहवेह, तपाईंमा आशा राख्नेहरू मेरो कारणले शर्ममा नपरून्; हे इस्राएलका परमेश्‍वर, तपाईंलाई खोज्नेहरू मेरो कारणले लाजमा नपरून्।<verse eid="PSA 69:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 69:7"/>किनकि तपाईंको खातिर मैले तिरस्कार सहेको छु; मेरो अनुहार लाजले ढाकेको छ।<verse eid="PSA 69:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 69:8"/>मेरा आफन्तका बीचमा म विदेशी भएको छु, मेरा साक्खै दाजुभाइ-दिदीबहिनीहरूका बीच म बिरानो भएको छु;<verse eid="PSA 69:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 69:9"/>किनकि तपाईंको घरप्रतिको जोशले मलाई खाएको छ, र तपाईंलाई अपमान गर्नेहरूको अपमान ममाथि आइपरेको छ।<verse eid="PSA 69:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 69:10"/>जब म रुन्छु, र उपवास बस्छु, मैले अपमान सहनैपर्छ;<verse eid="PSA 69:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 69:11"/>जब म भाङ्ग्रा लगाउँछु, मानिसहरू मेरो हाँसो गर्दछन्।<verse eid="PSA 69:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 69:12"/>सहरको मूलढोकामा बस्‍ने मानिसहरूले मेरो ठट्टा उडाउँछन्; अनि म मतवालाहरूको गीत बनेको छु।<verse eid="PSA 69:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 69:13"/>तर हे याहवेह, तपाईंको ग्रहणयोग्य समयमा, म तपाईंलाई प्रार्थना गर्दछु; हे परमेश्‍वर, तपाईंको अचुक प्रेममा, तपाईंको निश्‍चित छुटकाराले मलाई उत्तर दिनुहोस्।<verse eid="PSA 69:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 69:14"/>मलाई दलदले हिलोबाट बचाउनुहोस्! मलाई डुब्न नदिनुहोस्, घृणा गर्नेहरूबाट, गहिरो पानीबाट मलाई बचाउनुहोस्!<verse eid="PSA 69:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 69:15"/>मलाई पानीको बाढीले नछोपोस् वा पानीको गहिराइले मलाई ननिलोस्, वा चिहानको मुख ममाथि बन्द नहोस्!<verse eid="PSA 69:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 69:16"/>हे याहवेह, तपाईंको अचुक प्रेमको उत्तमतामा मलाई जवाफ दिनुहोस्; तपाईंको महान् कृपामा मतिर फर्कनुहोस्।<verse eid="PSA 69:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 69:17"/>तपाईंको सेवकबाट आफ्नो मुहार नलुकाउनुहोस्; मलाई चाँडै जवाफ दिनुहोस्, किनकि म सङ्कटमा परेको छु।<verse eid="PSA 69:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 69:18"/>मेरो नजिक आएर मेरो उद्धार गर्नुहोस्; मेरा शत्रुहरूका कारण मलाई छुटाउनुहोस्!<verse eid="PSA 69:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 69:19"/>म अपमानित भएको, म शर्ममा परेको, र मेरो बेइज्जत भएको तपाईंलाई थाहा छ; मेरा सबै शत्रुहरू तपाईंकै सामु छन्।<verse eid="PSA 69:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 69:20"/>अपमानले गर्दा मेरो मन टुटेको छ; र म निरीह भएको छु; मलाई सहानुभूति देखाउने कोही छन् कि भनेर खोजी गरेँ, तर कोही थिएनन्; र सान्त्वना दिनेहरू पनि खोजेँ, तर कोही भेटिनँ।<verse eid="PSA 69:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 69:21"/>मेरो खानामा तिनीहरूले पित्त हाले, म तिर्खाउँदा सिर्का पिउन दिए।<verse eid="PSA 69:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 69:22"/>तिनीहरूका अगि राखिएको भोजन तिनीहरूका निम्ति पासो बनोस्; र तिनीहरूका समृद्धि नै तिनीहरूको पासो बनोस्!<verse eid="PSA 69:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 69:23"/>तिनीहरूका आँखाहरू अँध्यारा होऊन्, र तिनीहरूले नदेखून्; तिनीहरूका ढाड सदा कुप्रिरहून्!<verse eid="PSA 69:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 69:24"/>तपाईंको क्रोध तिनीहरूमाथि खन्याउनुहोस्; तपाईंको रिसको आगो तिनीहरूमाथि आइपरोस्!<verse eid="PSA 69:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 69:25"/>तिनीहरूको स्थान उजाड भइजाओस्; तिनीहरूका पालहरूमा बास गर्ने कोही नहोस्।<verse eid="PSA 69:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 69:26"/>किनकि तपाईंले ताडना दिनु भएकाहरूलाई तिनीहरूले सताउँछन्, र तपाईंले घाइते पार्नुभएकाहरूका बारेमा तिनीहरूले कुरा काट्छन्।<verse eid="PSA 69:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 69:27"/>तपाईंले तिनीहरूको अपराधमाथि अपराधको हिसाब राख्नुहोस्; र तिनीहरू तपाईंको मुक्तिमा सहभागी हुन नपाऊन्।<verse eid="PSA 69:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 69:28"/>जीवनको पुस्तकबाट तिनीहरूका नाम मेटिओस्, र धर्मी जनहरूसँग तिनीहरू गन्ती नहोऊन्।<verse eid="PSA 69:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 69:29"/>तर म त दुःखित र पीडित छु— हे परमेश्‍वर, तपाईंको मुक्तिले मलाई सुरक्षा गरोस्!<verse eid="PSA 69:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 69:30"/>गीत गाएर म परमेश्‍वरको नामको प्रशंसा गर्नेछु, र धन्यवादसाथ उहाँलाई महिमा गर्नेछु।<verse eid="PSA 69:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 69:31"/>यस कुराले याहवेहलाई साँढेको बलिभन्दा बढी सिङ र खुर भएको बहरको बलिले भन्दा बढी प्रसन्‍न पार्नेछ।<verse eid="PSA 69:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 69:32"/>थिचोमिचोमा परेकाहरू यो कुरा देखेर रमाउनेछन्— हे परमेश्‍वरलाई खोज्नेहरू हो, तिमीहरूको हृदय नयाँ जोसले भरियोस्।<verse eid="PSA 69:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 69:33"/>याहवेहले अभावमा परेकाहरूको पुकार सुन्‍नुहुन्छ, र बन्धनमा परेका आफ्ना मानिसहरूलाई अवहेलना गर्नुहुन्‍न।<verse eid="PSA 69:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 69:34"/>स्वर्ग, पृथ्वी, समुद्र र तिनमा हिँड्‍डुल गर्ने सारा सृष्‍टिले परमेश्‍वरको प्रशंसा गरून्!<verse eid="PSA 69:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 69:35"/>किनकि परमेश्‍वरले सियोनलाई बचाउनुहुनेछ, र यहूदाका सहरहरूलाई पुनर्निर्माण गर्नुहुनेछ। तब उहाँका मानिसहरू त्यहाँ बस्‍नेछन्, र त्यसमाथि कब्जा गर्नेछन्;<verse eid="PSA 69:35"/></para>
<para style="p"><verse number="36" style="v" sid="PSA 69:36"/>उहाँका सेवकहरूका सन्तानहरू त्यहाँ उत्तराधिकार हुनेछन्; अनि उहाँको नामलाई प्रेम गर्नेहरू त्यहाँ बास गर्नेछन्।<verse eid="PSA 69:36"/></para>
<chapter eid="PSA 69"/>
<chapter number="70" style="c" sid="PSA 70"/>
<para style="p"><verse number="1" style="v" sid="PSA 70:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको बिन्ती भजन। हे परमेश्‍वर, मलाई बचाउनुहोस्; हे याहवेह, मलाई सहायता गर्न चाँडै आउनुहोस्!<verse eid="PSA 70:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 70:2"/>मेरो प्राण लिन खोज्नेहरू सबै जना शर्ममा र अन्योलमा परून्; मेरो विनाश चाहनेहरू सबै पिठिउँ फर्काएर भागून् र अपमानित होऊन्।<verse eid="PSA 70:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 70:3"/>मलाई “खुच्‍चिङ! खुच्‍चिङ!” भन्दै ठट्टा उडाउनेहरू, लाजको कारण पछि फर्कून्।<verse eid="PSA 70:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 70:4"/>तर तपाईंलाई खोज्नेहरू सबै, तपाईंमा रमाऊन् र आनन्दित होऊन्; तपाईंको मुक्तिको चाहना गर्नेहरू सबैले सधैँ यसो भनून्, “परमेश्‍वर महान् हुनुहुन्छ!”<verse eid="PSA 70:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 70:5"/>तर म त गरिबी र अभावमा छु; हे परमेश्‍वर, मकहाँ चाँडो आउनुहोस्; तपाईं मेरा सहायक र छुटकारा दिने हुनुहुन्छ; हे याहवेह, ढिलो नगर्नुहोस्!<verse eid="PSA 70:5"/></para>
<chapter eid="PSA 70"/>
<chapter number="71" style="c" sid="PSA 71"/>
<para style="p"><verse number="1" style="v" sid="PSA 71:1"/>हे याहवेह, मैले तपाईंमा शरण लिएको छु; मलाई कहिल्यै शर्ममा पर्न नदिनुहोस्!<verse eid="PSA 71:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 71:2"/>तपाईंको धार्मिकतामा मलाई उद्धार गर्नुहोस् र छुटकारा दिनुहोस्; तपाईंको कान मतिर फर्काउनुहोस् र मलाई बचाउनुहोस्!<verse eid="PSA 71:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 71:3"/>तपाईं मेरो आश्रयको चट्टान बन्‍नुहोस्, जहाँ म सधैँ जान सकूँ; मलाई बचाउने आज्ञा दिनुहोस्; किनकि तपाईं मेरो चट्टान र मेरो गढ हुनुहुन्छ।<verse eid="PSA 71:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 71:4"/>हे मेरा परमेश्‍वर, मलाई दुष्‍टहरूका हातबाट, अन्यायी र निर्दयी मानिसहरूका पञ्जाबाट छुटाउनुहोस्!<verse eid="PSA 71:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 71:5"/>किनकि हे सार्वभौम याहवेह, तपाईं मेरो आशा हुनुहन्छ; युवाअवस्थादेखि नै तपाईं मेरो शरणस्थान हुनुहुन्छ।<verse eid="PSA 71:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 71:6"/>मैले जन्मदेखि नै तपाईंमाथि भरोसा गरेको छु; मलाई तपाईंले मेरी आमाको गर्भबाट निकाल्नुभएको हो। म तपाईंको निरन्तर प्रशंसा गरिरहनेछु।<verse eid="PSA 71:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 71:7"/>म धेरै जनाको निम्ति चिन्ह भएको छु; तपाईं मेरो बलियो शरणस्थान हुनुहुन्छ।<verse eid="PSA 71:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 71:8"/>मेरो मुख तपाईंको प्रशंसाले भरिएको छ; दिनभरि नै म तपाईंको वैभवता घोषणा गर्दछु।<verse eid="PSA 71:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 71:9"/>मेरो वृद्धावस्थामा मलाई नत्याग्नुहोस्; मलाई मेरो बल घटेको अवस्थामा नत्याग्नुहोस्!<verse eid="PSA 71:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 71:10"/>किनकि मेरा शत्रुहरूले मेरो विरुद्धमा कुरा गर्छन्; अनि मलाई मार्न खोज्नेहरू एकसाथ मिलेर षड्यन्त्र गर्छन्।<verse eid="PSA 71:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 71:11"/>तिनीहरूले भन्छन्, “परमेश्‍वरले त्यसलाई त्याग्नुभएको छ; त्यसलाई खेदेर पक्रौँ; किनकि त्यसलाई बचाउने कोही छैन।”<verse eid="PSA 71:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 71:12"/>हे मेरा परमेश्‍वर, मबाट टाढा नहुनुहोस्; हे परमेश्‍वर, मलाई सहायता गर्न चाँडो आउनुहोस्!<verse eid="PSA 71:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 71:13"/>मलाई दोष लाउनेहरू शर्ममा परेर नाश भइजाऊन्; मलाई हानि पुर्‍याउन चाहनेहरू लाजमा र अपमानमा परून्।<verse eid="PSA 71:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 71:14"/>तर मचाहिँ तपाईंमा सधैँ आशा गरिरहनेछु; म तपाईंको अझ धेरै प्रशंसा गर्नेछु।<verse eid="PSA 71:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 71:15"/>मेरो मुखले तपाईंका धार्मिक कामहरू र तपाईंका उद्धारको कामहरूको बारेमा दिनभरि नै मानिसहरूलाई भन्‍नेछु, यद्यपि मलाई तिनको बारेमा सबै कुरा कसरी भन्‍ने भनेर थाहा छैन।<verse eid="PSA 71:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 71:16"/>हे सार्वभौम याहवेह, म तपाईंका महान् कार्यहरूको घोषणा गर्दै आउनेछु, म तपाईंको धार्मिक कार्यहरूको विषयमा घोषणा गर्नेछु, केवल तपाईंको धार्मिकताको म बयान गर्नेछु।<verse eid="PSA 71:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 71:17"/>हे परमेश्‍वर, मेरो युवावस्थाका दिनदेखि नै मलाई तपाईंले सिकाउनुभएको छ; र आजको दिनसम्मै म तपाईंका अचम्मका कामहरूको घोषणा गर्दछु।<verse eid="PSA 71:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 71:18"/>हे परमेश्‍वर, अहिले म वृद्ध भइसकेको छु, र मेरो कपाल फुलिसकेको छ; तबसम्म मलाई नत्याग्नुहोस्, जबसम्म अर्को पुस्तालाई र पछि आउने सबै मानिसहरूलाई तपाईंले गर्नुभएका महान् कामहरू र अचम्मका कुराहरू घोषणा गरी सक्दिनँ।<verse eid="PSA 71:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 71:19"/>हे परमेश्‍वर, तपाईंका धार्मिकता आकाशसम्मै चुलिएको छ; तपाईंले महान् कामहरू गर्नुभएको छ। हे परमेश्‍वर, तपाईंजस्तो अरू को छ र?<verse eid="PSA 71:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 71:20"/>यद्यपि तपाईंले मलाई धेरै र तिता कष्‍टहरू अनुभव गर्न दिनुभयो; तपाईंले मेरो प्राणलाई पुनर्जीवित पार्नुहुनेछ, र पृथ्वीको गहिराइहरूबाट तपाईंले मलाई फेरि माथि ल्याउनुहुनेछ।<verse eid="PSA 71:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 71:21"/>तपाईंले मेरो इज्जत बढाइदिनुहुनेछ, र मलाई फेरि सान्त्वना दिनुहुनेछ।<verse eid="PSA 71:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 71:22"/>हे मेरा परमेश्‍वर, तपाईं विश्‍वासयोग्य हुनुभएको कारण म वीणा बजाएर तपाईंको प्रशंसा गर्नेछु; हे इस्राएलका पवित्र परमेश्‍वर, म सारङ्गी बजाएर तपाईंको प्रशंसा गर्नेछु,<verse eid="PSA 71:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 71:23"/>मेरा ओठहरू हर्षसाथ जयजयकार गर्नेछन्, म तपाईंको प्रशंसा गाउँछु; किनकि मलाई तपाईंले मुक्त गर्नुभएको छ।<verse eid="PSA 71:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 71:24"/>मेरो जिब्रोले तपाईंका धार्मिक कार्यहरूको बारेमा दिनभरि नै मानिसहरूलाई भन्‍नेछु; किनकि मेरो हानि गर्न चाहनेहरू शर्ममा र अन्योलमा परेका छन्।<verse eid="PSA 71:24"/></para>
<chapter eid="PSA 71"/>
<chapter number="72" style="c" sid="PSA 72"/>
<para style="p"><verse number="1" style="v" sid="PSA 72:1"/>सोलोमनको भजन। हे परमेश्‍वर, राजालाई तपाईंको न्याय, र राजाका छोरालाई तपाईंको धार्मिकता दिनुहोस्।<verse eid="PSA 72:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 72:2"/>राजाले तपाईंका मानिसहरूलाई धार्मिकतासाथ र तपाईंका पीडित जनहरूलाई धार्मिकतासाथ न्याय गरून्।<verse eid="PSA 72:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 72:3"/>पर्वतहरूले मानिसहरूका लागि समृद्धि ल्याऊन्; पहाडहरूले धार्मिकताका फल ल्याऊन्।<verse eid="PSA 72:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 72:4"/>उहाँले पीडितलाई मानिसहरूबीच रक्षा गरून्, र अभावमा हुनेहरूका सन्तानहरूलाई बचाऊन्; उहाँले अत्याचारीहरूलाई नाश गरून्।<verse eid="PSA 72:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 72:5"/>जबसम्म सूर्य रहन्छ, र जबसम्म चन्द्रमा रहन्छ, सबै पुस्ताका मानिसहरूले राजाको भय मानून्।<verse eid="PSA 72:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 72:6"/>तिनी काटिएको घाँसको चउरमाथि बर्सने पानीजस्तै, र जमिनलाई भिजाउन सिँचाइ गरिने झरीहरूझैँ होऊन्।<verse eid="PSA 72:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 72:7"/>राजाको शासनकालमा धर्मीहरूको उन्‍नति होस्, र चन्द्रमा रहुन्जेल देशमा प्रसस्तता होस्।<verse eid="PSA 72:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 72:8"/>राजाले एक समुद्रदेखि अर्को समुद्रसम्म, यूफ्रेटिस नदीदेखि पृथ्वीको अन्तिम छेउ-छाउसम्म शासन गरून्।<verse eid="PSA 72:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 72:9"/>राजाको सामु मरुभूमिमा बस्‍नेहरूले दण्डवत् गरून्, र उनका शत्रुहरूले धुलो चाटून्।<verse eid="PSA 72:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 72:10"/>तर्शीश र टाढा सामुद्रिक किनारका राजाहरूले उनलाई सलामी ल्याऊन्; शेबा र सेबाका राजाहरूले उनलाई भेटी चढाऊन्।<verse eid="PSA 72:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 72:11"/>सबै राजाहरू उनको अगाडि निहुरिऊन्; र सबै राष्ट्रहरूले उनको सेवा गरून्।<verse eid="PSA 72:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 72:12"/>किनकि उनले अभावमा हुनेहरूलाई उद्धार गर्छन्, जसले उहाँलाई पुकार गर्छन्; पीडितहरू जसको सहायता गर्ने कोही छैन।<verse eid="PSA 72:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 72:13"/>दुर्बल र अभावमा भएकाहरूलाई उनले दया देखाउनेछन्, र अभावमा हुनेहरूको प्राण मृत्युदेखि बचाउनेछन्।<verse eid="PSA 72:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 72:14"/>उनले तिनीहरूलाई हिंसा र अत्याचारबाट छुटाउनेछन्; किनकि उनको दृष्‍टिमा तिनीहरूको रगत बहुमूल्य छ।<verse eid="PSA 72:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 72:15"/>तिनी दीर्घायु होऊन्! तिनलाई शेबाको सुन भेटीस्वरूप दिइयोस्। तिनको निम्ति मानिसहरूले सधैँ प्रार्थना गरून्, र दिनभरि नै तिनलाई आशिष् देऊन्।<verse eid="PSA 72:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 72:16"/>देशभरि नै प्रशस्त अन्‍न होस्; पर्वतका टाकुराहरू समेतलाई प्रभावित पारून्। तिनको बाली लेबनानझैँ फस्टाओस्; र सहरका मानिसहरू जमिनको घाँसझैँ फस्टाऊन्।<verse eid="PSA 72:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 72:17"/>तिनको नाम सदासर्वदा रहिरहोस्; सूर्य रहुन्जेलसम्म तिनको नाम रहिरहोस्। तब तिनीद्वारा सबै राष्ट्रहरूले आशिष् पाउनेछन्; र तिनलाई धन्यका भन्‍नेछन्।<verse eid="PSA 72:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 72:18"/>इस्राएलका परमेश्‍वर, याहवेह परमेश्‍वरलाई प्रशंसा होस्! उहाँले मात्र अचम्मका काम गर्नुहुन्छ।<verse eid="PSA 72:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 72:19"/>उहाँको महिमायोग्य नामको सदासर्वदा प्रशंसा होस्; उहाँको महिमाले सारा पृथ्वी भरियोस्। आमेन! आमेन!<verse eid="PSA 72:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 72:20"/>यिशैका छोरा दावीदका प्रार्थनाहरू यहीँ समाप्‍त हुन्छ।<verse eid="PSA 72:20"/></para>
<chapter eid="PSA 72"/>
<chapter number="73" style="c" sid="PSA 73"/>
<para style="p"><verse number="1" style="v" sid="PSA 73:1"/>आसापको भजन। साँच्‍चै नै परमेश्‍वर इस्राएलको निम्ति भलो हुनुहुन्छ; तिनीहरूको निम्ति, जसको हृदय शुद्ध छ।<verse eid="PSA 73:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 73:2"/>तर मेरा खुट्टाहरू चिप्लनै लागेका थिए; मैले टेक्ने आधार हराउनै लागेको थिएँ;<verse eid="PSA 73:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 73:3"/>किनकि जब मैले दुष्‍टहरूको उन्‍नति देखेँ, तब मैले ती घमण्डीहरूको डाह गर्न लागेँ।<verse eid="PSA 73:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 73:4"/>तिनीहरूलाई कुनै पीडा छैन; तिनीहरूका शरीर एकदम हृष्‍टपुष्‍ट र बलिया छन्।<verse eid="PSA 73:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 73:5"/>अन्य मानिसहरूझैँ तिनीहरू कष्‍टमा पर्दैनन्; मानिसलाई लाग्ने रोगहरूले तिनीहरूलाई छुँदैन।<verse eid="PSA 73:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 73:6"/>यसकारण अहङ्कार तिनीहरूका गहना हो, र हिंसा तिनीहरूका पहिरन।<verse eid="PSA 73:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 73:7"/>तिनीहरूका कठोर हृदयबाट अधर्म निस्कन्छ; तिनीहरूका दुष्‍ट कल्पनाको कुनै सीमा छैन।<verse eid="PSA 73:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 73:8"/>तिनीहरूले अरूको ठट्टा गर्दछन् र खराबी कुरा गर्दछन्; अहङ्कारसाथ अरूलाई अत्याचारको धम्की दिन्छन्।<verse eid="PSA 73:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 73:9"/>तिनीहरूका मुखले स्वर्ग हासिल गर्ने दाबी गर्दछन्, र तिनीहरूका जिब्रोले पृथ्वी अधिकार गर्दछन्।<verse eid="PSA 73:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 73:10"/>त्यसकारण तिनीहरूका मानिसहरू तिनीहरूका कुरातर्फ फर्कन्छन्, र प्रशस्ततामा पानी पिउँछन्।<verse eid="PSA 73:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 73:11"/>तिनीहरूले भन्छन्, “परमेश्‍वरले कसरी जान्‍नुहुन्छ र? के सर्वोच्‍च परमेश्‍वरमा कुनै कुराको ज्ञान छ र?”<verse eid="PSA 73:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 73:12"/>दुष्‍टहरू कस्ता हुन्छन्— तिनीहरूले निस्फिक्री भई सधैँ धनसम्पत्ति थुपार्छन्।<verse eid="PSA 73:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 73:13"/>साँच्‍चै मैले व्यर्थमा आफ्नो हृदय शुद्ध राखेको छु, र मेरो निर्दोषतामा आफ्नो हात धोएको छु।<verse eid="PSA 73:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 73:14"/>दिनभरि म कष्‍ट भोगेको छु, र हरेक बिहान मैले दण्ड भोग्नुपर्दछ।<verse eid="PSA 73:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 73:15"/>यदि मैले त्यसरी भनेको भए त, तपाईंका सन्तानलाई मैले विश्‍वासघात गर्नेथिएँ।<verse eid="PSA 73:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 73:16"/>जब मैले यी सबै कुराहरू बुझ्ने कोसिस गरेँ, तब मेरा निम्ति यो अति कठिन भयो।<verse eid="PSA 73:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 73:17"/>जब म परमेश्‍वरको पवित्रस्थानभित्र पसेँ; तब मात्र मैले तिनीहरूको अन्तिम अवस्था बुझेँ।<verse eid="PSA 73:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 73:18"/>निश्‍चय नै तपाईंले तिनीहरूलाई चिप्ला स्थानहरूमा राख्नुहुन्छ; तपाईंले तिनीहरूलाई सर्वनाशको लागि फालिदिनुहुन्छ।<verse eid="PSA 73:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 73:19"/>केही क्षणमै तिनीहरू नष्‍ट पारिन्छन्; त्रासले तिनीहरू पूर्ण रूपमा ध्वस्त हुन्छन्!<verse eid="PSA 73:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 73:20"/>तिनीहरू बिहान बिउँझँदा टलेर जाने खराब सपनाजस्तै हुन्; हे प्रभु, जब तपाईं उठ्नुहुन्छ, तब तपाईंले तिनीहरूलाई कल्पना झैँ तुच्छ ठान्‍नुहुन्छ।<verse eid="PSA 73:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 73:21"/>जब मेरो मन घोर पीडामा थियो, मेरो आत्मामा तितोपना थियो,<verse eid="PSA 73:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 73:22"/>म चेतनाहीन र ज्ञानविहीन थिएँ; तपाईंको सामु म पशुजस्तै थिएँ।<verse eid="PSA 73:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 73:23"/>तरै पनि म सधैँ तपाईंसँगै रहन्छु; तपाईंले मेरो दाहिने हात थाम्नुभएको छ।<verse eid="PSA 73:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 73:24"/>तपाईंको सल्‍लाहले मलाई डोर्‍याउनुहुन्छ, र त्यसपछि मलाई महिमामा लानुहुनेछ।<verse eid="PSA 73:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 73:25"/>स्वर्गमा तपाईंबाहेक मेरो अरू को छ र? अनि तपाईंबाहेक पृथ्वीमा मैले चाहना गरेको अरू कोही छैन।<verse eid="PSA 73:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 73:26"/>मेरो देह र मेरो हृदय दुवै विफल होलान्, तर परमेश्‍वर सदासर्वदाको निम्ति मेरो हृदयको बल र मेरो भाग हुनुहुन्छ।<verse eid="PSA 73:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 73:27"/>तपाईंबाट टाढा रहने मानिसहरू नष्‍ट हुनेछन्; तपाईंलाई विश्‍वासघात गर्ने सबैलाई तपाईंले विनाश गर्नुहुन्छ।<verse eid="PSA 73:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 73:28"/>तर मेरो लागि चाहिँ परमेश्‍वरको नजिक रहन पाउनु असल छ; मैले प्रभु याहवेहलाई मेरो शरणस्थान बनाएको छु; म तपाईंका सारा कामहरूको वर्णन गर्नेछु।<verse eid="PSA 73:28"/></para>
<chapter eid="PSA 73"/>
<chapter number="74" style="c" sid="PSA 74"/>
<para style="p"><verse number="1" style="v" sid="PSA 74:1"/>आसापको मस्किल।* हे परमेश्‍वर, किन तपाईंले हामीलाई सधैँका लागि त्याग्नुभएको छ? तपाईंको क्रोध तपाईंका खर्कका भेडाहरूका विरुद्धमा किन दन्कन्छ?<verse eid="PSA 74:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 74:2"/>आफ्ना राष्ट्रलाई सम्झना गर्नुहोस्, जसलाई तपाईंले प्राचीन समयमा किन्‍नुभएको थियो; जसलाई तपाईंका उत्तराधिकारका प्रजा हुनलाई तपाईंले मोल तिरेर छुटाउनुभयो— सियोन पर्वत, जहाँ तपाईं बास गर्नुहुन्छ।<verse eid="PSA 74:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 74:3"/>आफ्ना कदमहरू यी अनन्त भग्नावशेषतिर बढाउनुहोस्; पवित्रस्थानमा भएका सबै थोक शत्रुहरूले नष्‍ट पारेका छन्।<verse eid="PSA 74:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 74:4"/>तपाईंले हामीसँग भेट गर्नुभएको ठाउँमा तपाईंका वैरीहरू गर्जेका छन्; तिनीहरूले आफ्ना झण्डाहरू विजयको चिन्हको रूपमा गाडेका छन्।<verse eid="PSA 74:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 74:5"/>झाडीका रूखहरू बन्चरोले काट्दै नष्‍ट पार्ने मानिसजस्तै तिनीहरू थिए।<verse eid="PSA 74:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 74:6"/>तिनीहरूले ठूलो बन्चरो र घनले बुट्टादार काठहरूलाई चकनाचुर पारे।<verse eid="PSA 74:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 74:7"/>तपाईंका पवित्रस्थानलाई तिनीहरूले आगो लगाए; तपाईंका नामको वासस्थान तिनीहरूले अपवित्र पारे।<verse eid="PSA 74:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 74:8"/>तिनीहरूले आफ्ना मनमा भने, “हामी तिनीहरूलाई पूर्ण रूपले नाश पारौँ!” तिनीहरूले देशमा भएका परमेश्‍वरका आराधना गरिने हरेक पवित्रस्थान जलाए।<verse eid="PSA 74:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 74:9"/>परमेश्‍वरबाट हामीले कुनै अलौकिक चिन्हहरू पाएका छैनौँ; अब कोही अगमवक्ता बाँकी रहेनन्, यस्तो हालत कहिलेसम्म रहने हो, सो हामी कसैले जान्दैनौँ।<verse eid="PSA 74:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 74:10"/>हे परमेश्‍वर, कहिलेसम्म शत्रुहरूले तपाईंको ठट्टा उडाउनेछन्? के वैरीहरूले तपाईंको नामको निन्दा सदासर्वदा गर्नेछन् त?<verse eid="PSA 74:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 74:11"/>किन तपाईं आफ्नो बाहुली, तपाईंको दाहिने हात रोक्नुहुन्छ? हस्तक्षेप गर्नुहोस् र तिनीहरूलाई नष्‍ट पार्नुहोस्।<verse eid="PSA 74:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 74:12"/>तर परमेश्‍वर प्राचीन समयदेखि नै मेरा राजा हुनुहुन्छ; उहाँले नै पृथ्वीमा मुक्ति ल्याउनुहुन्छ।<verse eid="PSA 74:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 74:13"/>तपाईंले नै आफ्नो शक्तिद्वारा समुद्रलाई दुई भाग पार्नुभयो; तपाईंले समुद्रको विशाल जन्तुहरूका टाउकाहरू कुच्याउनुभयो।<verse eid="PSA 74:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 74:14"/>तपाईं नै हो, जसले लिव्यातनको शिर कुच्याउनुभयो; र त्यसलाई मरुभूमिका पशुहरूलाई आहाराको निम्ति दिनुभयो।<verse eid="PSA 74:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 74:15"/>तपाईंले छहरा र नदीनालाका मूल फुटाइदिनुभयो; तपाईंले अटुट बगिरहने नदीहरूलाई सुकाइदिनुभयो।<verse eid="PSA 74:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 74:16"/>दिन तपाईंको हो, र रात पनि तपाईंकै हो; तपाईंले नै सूर्य र चन्द्र स्थापित गर्नुभएको हो।<verse eid="PSA 74:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 74:17"/>तपाईं नै हो, जसले पृथ्वीका सबै सिमानाहरू बनाउनुभयो; तपाईंले ग्रीष्म ऋतु र शिशिर ऋतु दुवैलाई बनाउनुभयो।<verse eid="PSA 74:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 74:18"/>हे याहवेह, तपाईंलाई शत्रुहरूले कसरी खिसी गर्थे, सम्झनुहोस्; र मूर्खहरूले कसरी तपाईंका नामको गिल्‍ला गर्थे।<verse eid="PSA 74:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 74:19"/>आफ्नो ढुकुरको प्राण जङ्गली जनावरहरूका हातमा नसुम्पनुहोस्; आफ्ना पीडित मानिसहरूका प्राणलाई सदाकाल नभुल्नुहोस्।<verse eid="PSA 74:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 74:20"/>तपाईंका करार सम्झनुहोस्; किनकि देशका अँध्यारा ठाउँहरू हिंसाले भरिएका छन्।<verse eid="PSA 74:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 74:21"/>थिचोमिचोमा परेकाहरू लाजमा परेर पछि नहटून्; पीडित र अभावमा हुनेहरूले तपाईंको नामको प्रशंसा गरून्।<verse eid="PSA 74:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 74:22"/>हे परमेश्‍वर, उठ्नुहोस्, र आफ्नो पक्षमा लड्नुहोस्; मूर्खहरूले कसरी दिनभरि नै तपाईंको ठट्टा गर्दछन्, सो कुरा सम्झनुहोस्।<verse eid="PSA 74:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 74:23"/>तपाईंका विरोधीहरूको रिसको होहल्‍ला र तपाईंका शत्रुहरूले गरिरहेका खैलाबैला नभुल्नुहोस्।<verse eid="PSA 74:23"/></para>
<chapter eid="PSA 74"/>
<chapter number="75" style="c" sid="PSA 75"/>
<para style="p"><verse number="1" style="v" sid="PSA 75:1"/>सङ्गीत निर्देशकको निम्ति, “विनाश नहोस्” को रागमा आधारित, आसापको भजन; एक गीत। हे परमेश्‍वर, हामी तपाईंलाई धन्यवाद चढाउँछौँ, हामी तपाईंलाई धन्यवाद चढाउँछौँ; किनकि तपाईंको नाम नजिकै छ; मानिसहरूले तपाईंका अचम्मका कामहरूको वर्णन गर्दछन्।<verse eid="PSA 75:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 75:2"/>तपाईं भन्‍नुहुन्छ, “मैले उचित समय ठहराएको छु; मैले नै निष्पक्षतासाथ न्याय गर्दछु।<verse eid="PSA 75:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 75:3"/>जब पृथ्वीमा भुइँचालो जान्छ र मानिसहरू काम्छन्, त्यसका खम्बाहरूलाई स्थिर गरी थामिराख्ने म नै हुँ। सेला<verse eid="PSA 75:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 75:4"/>घमण्डीहरूलाई म भन्दछु, ‘घमण्ड नगर,’ र दुष्‍ट मानिसहरूलाई भन्दछु, ‘तिमीहरूका सिङ नउठाओ,<verse eid="PSA 75:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 75:5"/>स्वर्गको विरुद्धमा तिमीहरूको सिङ नउठाओ; मुन्टो बटारेर घमण्डसाथ नबोल।’ ”<verse eid="PSA 75:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 75:6"/>किनकि विजय पूर्वबाट वा पश्‍चिमबाट वा मरुभूमिबाट आउँदैन।<verse eid="PSA 75:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 75:7"/>परमेश्‍वरले न्याय गर्नुहुन्छ: उहाँले कसैलाई होच्याउनुहुन्छ, र कसैलाई उच्‍च पार्नुहुन्छ,<verse eid="PSA 75:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 75:8"/>याहवेहको हातमा एउटा कचौरा छ, जसमा मसाला मिसिएको फीँज भएको मद्य छ; उहाँले त्यो खन्याउनुहुन्छ, र पृथ्वीका सबै दुष्‍टहरूले मद्यको थिग्रासम्मै पिउँछन्।<verse eid="PSA 75:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 75:9"/>तर मचाहिँ सदाकाल यही कुरा घोषणा गर्नेछु; म याकोबका परमेश्‍वरको प्रशंसा गाउनेछु,<verse eid="PSA 75:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 75:10"/>जसले भन्‍नुहुन्छ, “म सबै दुष्‍टहरूका सिङहरू काटिदिनेछु; तर धर्मी जनहरूका सिङचाहिँ उच्‍च पारिनेछन्।”<verse eid="PSA 75:10"/></para>
<chapter eid="PSA 75"/>
<chapter number="76" style="c" sid="PSA 76"/>
<para style="p"><verse number="1" style="v" sid="PSA 76:1"/>सङ्गीत निर्देशकको निम्ति, तारवाद्यमा आधारित, आसापको भजन; एक गीत। यहूदामा परमेश्‍वर प्रसिद्ध हुनुभएको छ; इस्राएलमा उहाँको नाम महान् छ।<verse eid="PSA 76:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 76:2"/>उहाँको पाल शालेममा छ, उहाँको वासस्थान सियोनमा छ।<verse eid="PSA 76:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 76:3"/>त्यहाँ उहाँले अग्निकाँडहरू भाँच्नुभयो, ढाल, तरवार र युद्धका हतियारहरू भाँच्नुभयो। सेला<verse eid="PSA 76:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 76:4"/>तपाईं ज्योतिले चम्किलो हुनुहुन्छ, र शिकारले भरिएका पर्वतहरूभन्दा पनि भव्य हुनुहुन्छ।<verse eid="PSA 76:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 76:5"/>साहसी मानिसहरू लुटिएका छन्; तिनीहरू गहिरो निद्रामा परेका छन्; एउटै पनि शूरवीरले आफ्नो हात उचाल्न सक्दैन।<verse eid="PSA 76:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 76:6"/>हे याकोबका परमेश्‍वर, तपाईंको हप्काइमा घोडा र रथ दुवै चीर निद्रामा परेका छन्।<verse eid="PSA 76:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 76:7"/>तपाईं मात्र भययोग्य हुनुहुन्छ; तपाईं रिसाउनुहुँदा तपाईंको अगि को खडा रहन सक्छ र?<verse eid="PSA 76:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 76:8"/>स्वर्गबाट तपाईंले न्याय घोषणा गर्नुभयो; र पृथ्वी डरायो र चुपचाप भयो—<verse eid="PSA 76:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 76:9"/>हे परमेश्‍वर, जब तपाईं पृथ्वीमा पीडितहरू सबैलाई बचाउन न्याय गर्न उठ्नुभयो। सेला<verse eid="PSA 76:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 76:10"/>निश्‍चय नै मानव-जाति विरुद्ध तपाईंको क्रोधले तपाईंलाई प्रशंसा ल्याउँदछ; र तपाईंको क्रोधबाट बाँचेकाहरू रोकिएका छन्।<verse eid="PSA 76:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 76:11"/>तिमीहरूका परमेश्‍वर, याहवेहलाई भाकल गर, र त्यो पूरा गर; उहाँलाई, जो भययोग्य हुनुहुन्छ, देशको चारैपट्टि रहने मानिसहरू सबैले भेटी ल्याऊन्।<verse eid="PSA 76:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 76:12"/>उहाँले शासकहरूको घमण्डलाई तोडिदिनुहुन्छ; पृथ्वीका राजाहरू उहाँसँग डराउँछन्।<verse eid="PSA 76:12"/></para>
<chapter eid="PSA 76"/>
<chapter number="77" style="c" sid="PSA 77"/>
<para style="p"><verse number="1" style="v" sid="PSA 77:1"/>सङ्गीत निर्देशकको निम्ति, यदूतूनको लागि, आसापको भजन। मैले सहायताको निम्ति परमेश्‍वरलाई पुकारेँ, मलाई सुन्‍नुभएको होस् भनेर मैले परमेश्‍वरलाई पुकारेँ।<verse eid="PSA 77:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 77:2"/>जब म दुःखमा थिएँ, मैले प्रभुलाई प्रार्थना गरेँ; रातमा नथाकी उहाँमा मैले हात पसारेँ, तर मेरो हृदयले सान्त्वना पाएन।<verse eid="PSA 77:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 77:3"/>हे परमेश्‍वर, मैले तपाईंको सम्झना गरेँ, र मैले अफसोस गरेँ; मैले हृदयमा मनन गरेँ, र मेरो आत्मा शिथिल भयो। सेला<verse eid="PSA 77:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 77:4"/>तपाईंले मेरा आँखा चिम्‍लन दिनुभएन; म बोल्न नसक्ने गरी अति दुःखित थिएँ।<verse eid="PSA 77:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 77:5"/>मैले बितेका दिनहरूको सम्झना गरेँ, धेरै अगाडिका वर्षहरू;<verse eid="PSA 77:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 77:6"/>रातका मेरा गीतहरू सम्झेँ। मैले हृदयमा मनन गरेँ, र मेरो आत्माले यो विचार गर्‍यो:<verse eid="PSA 77:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 77:7"/>“के प्रभुले सदाको निम्ति मलाई त्याग्नुहुनेछ? के उहाँले मलाई फेरि कहिल्यै दया देखाउनुहुनेछैन?<verse eid="PSA 77:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 77:8"/>के उहाँको अचुक प्रेम सदाको लागि मेटिएको छ? के उहाँका प्रतिज्ञाहरू सदाको लागि असफल भएका हुन्?<verse eid="PSA 77:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 77:9"/>के परमेश्‍वरले दया देखाउन बिर्सनुभएको हो? के उहाँले आफ्नो रिसमा दयाको दृष्‍टि रोक्नुभएको हो?” सेला<verse eid="PSA 77:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 77:10"/>तब मैले सोचेँ, “मेरो पीडाको कारणचाहिँ सर्वोच्‍च परमेश्‍वरको दाहिने बाहुली परिवर्तन भएको छ।”<verse eid="PSA 77:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 77:11"/>म याहवेहका हातका कामहरू स्मरण गर्नेछु; हो, म बितेका समयहरूका तपाईंका अचम्मका कामहरू याद गर्नेछु।<verse eid="PSA 77:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 77:12"/>म तपाईंका सबै कामहरूलाई विचार गर्नेछु र तपाईंका सबै महान् कार्यहरूलाई मनन गर्नेछु।<verse eid="PSA 77:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 77:13"/>हे परमेश्‍वर, तपाईंका मार्गहरू पवित्र छन्; हाम्रा महान् परमेश्‍वरझैँ अरू देव को छ र?<verse eid="PSA 77:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 77:14"/>तपाईं अचम्मका कामहरू गर्ने परमेश्‍वर हुनुहुन्छ; तपाईंले आफ्नो शक्ति जाति-जातिहरूका बीच प्रकट गर्नुहुन्छ।<verse eid="PSA 77:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 77:15"/>तपाईंको शक्तिशाली बाहुलीले आफ्ना मानिसहरूलाई, याकोब र योसेफका सन्तानहरूलाई उद्धार गर्नुभयो। सेला<verse eid="PSA 77:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 77:16"/>हे परमेश्‍वर, समुद्रले तपाईंलाई देख्यो, सागरले तपाईंलाई देख्यो र डरायो; गहिरो महासागर डराएर काम्यो।<verse eid="PSA 77:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 77:17"/>बादलहरूले झरी बर्साए, आकाशमा चट्याङ गुन्ज्यो; तपाईंको बिजुली काँडहरू चारैतिर चम्के।<verse eid="PSA 77:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 77:18"/>तपाईंको चट्याङको गर्जन आँधीबेहरीमा सुनियो; तपाईंको चम्किलो बिजुलीले संसारलाई उज्यालो पारिदियो; पृथ्वी काम्यो र भुइँचालो गयो।<verse eid="PSA 77:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 77:19"/>तपाईंको मार्गले समुद्र भएर डोर्‍यायो; तपाईंको बाटो महासागरको बीचमा थियो, यद्यपि तपाईंका पाइलाका छापहरू देखिएनन्।<verse eid="PSA 77:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 77:20"/>तपाईंले आफ्ना मानिसहरूलाई भेडाका बथानलाई जस्तै मोशा र हारूनका हातद्वारा डोर्‍याउनुभयो।<verse eid="PSA 77:20"/></para>
<chapter eid="PSA 77"/>
<chapter number="78" style="c" sid="PSA 78"/>
<para style="p"><verse number="1" style="v" sid="PSA 78:1"/>आसापको मस्किल।* हे मेरा मानिसहरू हो, मेरा शिक्षातिर ध्यान दिएर सुन; मेरा मुखका वचनहरूतिर ध्यान लगाओ।<verse eid="PSA 78:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 78:2"/>म मेरो मुख दृष्‍टान्तमा बोल्नलाई खोल्नेछु; म प्राचीनका कुराहरूबाट गुप्‍त कुराहरू भन्‍नेछु—<verse eid="PSA 78:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 78:3"/>हामीले ती कुराहरू सुनेका र जानेका छौँ, जुन कुरा हाम्रा पितापुर्खाहरूले हामीलाई बताएका छन्।<verse eid="PSA 78:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 78:4"/>हामी ती कुराहरूलाई तिनीहरूका छोराछोरीहरूबाट लुकाउनेछैनौँ; हामी आउने पुस्तालाई याहवेहका प्रशंसायोग्य कामहरू, उहाँको शक्ति र उहाँले गर्नुभएका अद्‌भुत कार्यहरूको बारेमा वर्णन गर्नेछौँ।<verse eid="PSA 78:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 78:5"/>उहाँले याकोबको निम्ति विधि-विधानहरू कायम गर्नुभयो, र इस्राएलमा व्यवस्था स्थापित गर्नुभयो; यी कुराहरू आफ्ना छोराछोरीहरूलाई सिकाउनु भनेर उहाँले हाम्रा पितापुर्खाहरूलाई आज्ञा दिनुभयो;<verse eid="PSA 78:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 78:6"/>ताकि यी कुराहरू आउँदा पुस्ताले जानून्, यी कुराहरू नजन्मेका शिशुहरूले पनि जानून्, र यी कुराहरू तिनीहरूले पनि आफ्ना छोराछोरीहरूलाई भनून्।<verse eid="PSA 78:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 78:7"/>तब तिनीहरूले परमेश्‍वरमा आफ्ना भरोसा राख्नेछन्, र उहाँका कामहरू तिनीहरूले बिर्सने छैनन्; तर तिनीहरूले उहाँका आज्ञाहरू पालन गर्नेछन्।<verse eid="PSA 78:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 78:8"/>तिनीहरू आफ्ना पितापुर्खाहरू जस्तै अटेरी र विद्रोही पुस्ता हुनेछैनन्; तिनीहरूका हृदय परमेश्‍वरप्रति वफादार थिएनन्, तिनीहरूका आत्मा परमेश्‍वरप्रति विश्‍वासयोग्य थिएनन्।<verse eid="PSA 78:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 78:9"/>एफ्राइमका मानिसहरू धनुकाँडले सुसज्जित भए तापनि लडाइँको दिनमा तिनीहरू पिठिउँ फर्काएर पछि भागे;<verse eid="PSA 78:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 78:10"/>तिनीहरूले परमेश्‍वरका करार पालन गरेनन्, र उहाँका व्यवस्थाअनुसार चल्न अस्वीकार गरे।<verse eid="PSA 78:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 78:11"/>परमेश्‍वरले गर्नुभएका कामहरू, उहाँले तिनीहरूलाई देखाउनुभएको अद्‌भुत कार्यहरू, तिनीहरूले बिर्से।<verse eid="PSA 78:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 78:12"/>उहाँले तिनीहरूका पितापुर्खाहरूका अगि, इजिप्ट देश र सोअनको मैदानमा अचम्मका कामहरू गर्नुभयो।<verse eid="PSA 78:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 78:13"/>उहाँले समुद्रलाई दुई भाग पार्नुभयो, र यसबाट तिनीहरूलाई पारि डोर्‍याउनुभयो; उहाँले पानीलाई पर्खालझैँ खडा गर्नुभयो।<verse eid="PSA 78:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 78:14"/>उहाँले तिनीहरूलाई दिनमा बादलले र रातभरि आगोको उज्यालोले अगुवाइ गर्नुभयो।<verse eid="PSA 78:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 78:15"/>उहाँले मरुभूमिमा चट्टानलाई दुई भाग पार्नुभयो, र सागरको पानीजस्तै गरी प्रशस्त पानी तिनीहरूलाई दिनुभयो;<verse eid="PSA 78:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 78:16"/>उहाँले चट्टाने भिरबाट पानीका धारा निकाल्नुभयो, र पानीलाई बेँसीतिर नदीजस्तै बगाउनुभयो।<verse eid="PSA 78:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 78:17"/>तर सर्वोच्‍च परमेश्‍वरको विरुद्धमा मरुभूमिमा विद्रोही भएर, तिनीहरू उहाँको विरुद्धमा निरन्तर पापमा लागिरहे।<verse eid="PSA 78:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 78:18"/>तिनीहरूले असाध्यै खानेकुराको माग गरेर जानी-जानी परमेश्‍वरको परीक्षा गरे।<verse eid="PSA 78:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 78:19"/>तिनीहरूले यसो भन्दै परमेश्‍वरको निन्दा गरे: “के परमेश्‍वरले हाम्रो निम्ति मरुभूमिमा भोजनको टेबुल तयार गर्न सक्नुहुन्छ र?<verse eid="PSA 78:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 78:20"/>हेर! उहाँले चट्टानलाई हिर्काउनुभयो, र पानी फुटेर निस्क्यो, पानीका धारा प्रशस्त गरी बगेर निस्क्यो; तर के उहाँले हामीलाई खानेकुरा पनि दिन सक्नुहुन्छ? के उहाँले आफ्ना मानिसहरूका निम्ति मासु जुटाउन सक्नुहुन्छ र?”<verse eid="PSA 78:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 78:21"/>जब याहवेहले तिनीहरूका कुरा सुन्‍नुभयो, उहाँ धेरै रिसाउनुभयो; याकोबको विरुद्धमा उहाँको आगो दन्क्यो, र उहाँको क्रोध इस्राएलका विरुद्धमा दन्क्यो;<verse eid="PSA 78:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 78:22"/>किनकि तिनीहरूले परमेश्‍वरमाथि विश्‍वास गरेनन्, न त उहाँको छुटकारामा नै भरोसा राखे।<verse eid="PSA 78:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 78:23"/>तापनि उहाँले माथि आकाशलाई हुकुम गर्नुभयो, र स्वर्गका ढोकाहरू खोलिदिनुभयो;<verse eid="PSA 78:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 78:24"/>उहाँले मानिसहरूका निम्ति खानलाई मन्‍न बर्साउनुभयो, उहाँले तिनीहरूलाई स्वर्गको अन्‍न दिनुभयो।<verse eid="PSA 78:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 78:25"/>मानिसहरूले स्वर्गदूतहरूका रोटी खाए; परमेश्‍वरले तिनीहरूलाई प्रशस्त खानेकुरा पठाइदिनुभयो।<verse eid="PSA 78:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 78:26"/>उहाँले आकाशमा पूर्वीय बतास बहाउनुभयो; र उहाँको शक्तिद्वारा दक्षिणी बतासलाई चलाउनुभयो।<verse eid="PSA 78:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 78:27"/>उहाँले धुलोको कणसरह तिनीहरूका निम्ति मासु बर्साउनुभयो; उड्ने पक्षीहरूलाई समुद्री किनारका बालुवासरह बर्साइदिनुभयो।<verse eid="PSA 78:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 78:28"/>उहाँले ती पक्षीहरूलाई तिनीहरूका छाउनीभित्र, तिनीहरूका पालको वरिपरि झार्नुभयो।<verse eid="PSA 78:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 78:29"/>तिनीहरूले नघाउन्जेल खाए— उहाँले तिनीहरूलाई तिनीहरूले इच्छा गरेअनुसार दिनुभयो।<verse eid="PSA 78:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 78:30"/>तर तिनीहरूको भोक मेटिनु अगि नै, तिनीहरूले खाएका खाना तिनीहरूका मुखमा छँदै,<verse eid="PSA 78:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 78:31"/>परमेश्‍वरको क्रोध तिनीहरूको विरुद्ध दन्क्यो; तिनीहरूमध्येका बलियाहरूलाई उहाँले मार्नुभयो, इस्राएलका जवान मानिसहरूलाई ढालिदिनुभयो।<verse eid="PSA 78:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 78:32"/>यी सबै कुराहरू हुँदा पनि तिनीहरूले पाप गरी नै रहे; र उहाँका अद्‌भुत कार्यहरू देखेर पनि तिनीहरूले विश्‍वास गरेनन्।<verse eid="PSA 78:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 78:33"/>यसकारण उहाँले तिनीहरूका दिनहरू व्यर्थतामा र तिनीहरूका वर्षहरूचाहिँ आतङ्कमा अन्त्य गरिदिनुभयो।<verse eid="PSA 78:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 78:34"/>जब परमेश्‍वरले तिनीहरूमध्ये कतिलाई मार्नुभयो; तब तिनीहरूले उहाँको खोजी गर्दै, फेरि पश्‍चात्ताप गर्दै उहाँतिर फर्के।<verse eid="PSA 78:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 78:35"/>परमेश्‍वर तिनीहरूका चट्टान हुनुहुन्छ र सर्वोच्‍च परमेश्‍वर तिनीहरूका उद्धारक हुनुहुँदोरहेछ भन्‍ने कुरा तिनीहरूले सम्झे।<verse eid="PSA 78:35"/></para>
<para style="p"><verse number="36" style="v" sid="PSA 78:36"/>तर त्यसपछि तिनीहरूका मुखले उहाँको चापलुसी गरे, र तिनीहरूका जिब्रोले उहाँसित झूटो बोले;<verse eid="PSA 78:36"/></para>
<para style="p"><verse number="37" style="v" sid="PSA 78:37"/>तिनीहरूका हृदय उहाँतर्फ वफादार थिएनन्, न त उहाँका करारप्रति तिनीहरू विश्‍वासयोग्य नै थिए।<verse eid="PSA 78:37"/></para>
<para style="p"><verse number="38" style="v" sid="PSA 78:38"/>तापनि तिनीहरूप्रति उहाँ दयालु हुनुभयो; उहाँले तिनीहरूका अपराधहरू क्षमा गर्नुभयो, र तिनीहरूलाई नष्‍ट पार्नुभएन। पटक-पटक उहाँले आफ्नो रिस नियन्त्रण गर्नुभयो र आफ्नो पूरा क्रोध पोख्नुभएन।<verse eid="PSA 78:38"/></para>
<para style="p"><verse number="39" style="v" sid="PSA 78:39"/>उहाँले मानिसहरू देह मात्र हुन् भनी सम्झिनुभयो, जो हावाजस्तो बहन्छन् र फर्किआउँदैनन्।<verse eid="PSA 78:39"/></para>
<para style="p"><verse number="40" style="v" sid="PSA 78:40"/>तिनीहरूले कत्ति चोटि मरुभूमिमा परमेश्‍वरको विरुद्धमा विद्रोह गरे, र उहाँलाई उजाडस्थानमा दुःखित तुल्याए!<verse eid="PSA 78:40"/></para>
<para style="p"><verse number="41" style="v" sid="PSA 78:41"/>तिनीहरूले घरी-घरी परमेश्‍वरलाई परीक्षा गरे; र इस्राएलका पवित्र परमेश्‍वरलाई उक्साए।<verse eid="PSA 78:41"/></para>
<para style="p"><verse number="42" style="v" sid="PSA 78:42"/>तिनीहरूले उहाँको शक्तिको स्मरण गरेनन्— जुन दिन उहाँले तिनीहरूलाई मोल तिरेर अत्याचारीबाट छुटकारा दिनुभएको थियो,<verse eid="PSA 78:42"/></para>
<para style="p"><verse number="43" style="v" sid="PSA 78:43"/>जब उहाँले इजिप्टमा आफ्नो अलौकिक चिन्हहरू, र सोअनको मैदानमा अद्‌भुत कार्यहरू देखाउनुभयो।<verse eid="PSA 78:43"/></para>
<para style="p"><verse number="44" style="v" sid="PSA 78:44"/>उहाँले तिनीहरूका नदीलाई रगतमा परिवर्तन गरिदिनुभयो; तिनीहरूले खोलाहरूका पानीबाट पिउन सकेनन्।<verse eid="PSA 78:44"/></para>
<para style="p"><verse number="45" style="v" sid="PSA 78:45"/>उहाँले तिनीहरूलाई नाश पार्नलाई झिँगाका हुलहरू पठाउनुभयो, र तिनीहरूलाई उजाड पार्नलाई भ्यागुताहरू पठाउनुभयो।<verse eid="PSA 78:45"/></para>
<para style="p"><verse number="46" style="v" sid="PSA 78:46"/>उहाँले तिनीहरूका अन्‍नबालीहरू फट्याङ्ग्राहरूलाई, र तिनीहरूका खेतका उब्जनी सलहलाई दिनुभयो।<verse eid="PSA 78:46"/></para>
<para style="p"><verse number="47" style="v" sid="PSA 78:47"/>उहाँले तिनीहरूका अङ्‌गुरका बोटहरू असिनाले र अञ्जीरका बोटहरू तुसारोले नष्‍ट पारिदिनुभयो।<verse eid="PSA 78:47"/></para>
<para style="p"><verse number="48" style="v" sid="PSA 78:48"/>उहाँले तिनीहरूका गाईबस्तुहरूलाई असिनाले, र भेडाबाख्राहरूलाई चट्याङले प्रहार गर्नुभयो।<verse eid="PSA 78:48"/></para>
<para style="p"><verse number="49" style="v" sid="PSA 78:49"/>उहाँले तिनीहरूका विरुद्ध आफ्नो प्रचण्ड रिस, क्रोध, आक्रोश र शत्रुता— विनाशकारी दूतहरूको एक दल पठाउनुभयो।<verse eid="PSA 78:49"/></para>
<para style="p"><verse number="50" style="v" sid="PSA 78:50"/>उहाँले आफ्नो क्रोधका लागि बाटो तयार पार्नुभयो; उहाँले तिनीहरूका प्राणलाई मृत्युबाट बचाउनुभएन, तर तिनीहरूका प्राण महामारीलाई सुम्पनुभयो।<verse eid="PSA 78:50"/></para>
<para style="p"><verse number="51" style="v" sid="PSA 78:51"/>उहाँले इजिप्टका सबै ज्येष्‍ठ सन्तानलाई, हामका पालहरूमा पुरुषत्वको रूपमा रहेका पहिलो फललाई मास्‍नुभयो।<verse eid="PSA 78:51"/></para>
<para style="p"><verse number="52" style="v" sid="PSA 78:52"/>तर उहाँले आफ्ना मानिसहरूलाई भेडाहरूका बथानलाई जस्तै निकालेर ल्याउनुभयो; उहाँले तिनीहरूलाई मरुभूमिमा भेडालाई जस्तै अगुवाइ गर्नुभयो।<verse eid="PSA 78:52"/></para>
<para style="p"><verse number="53" style="v" sid="PSA 78:53"/>उहाँले तिनीहरूलाई सुरक्षित डोर्‍याउनुभयो यसैले तिनीहरू डराएनन्; तर तिनीहरूका शत्रुहरूलाई चाहिँ समुद्रले निल्यो।<verse eid="PSA 78:53"/></para>
<para style="p"><verse number="54" style="v" sid="PSA 78:54"/>यसरी परमेश्‍वरले तिनीहरूलाई आफ्नो पवित्र देशको सिमानामा ल्याउनुभयो, जुन पर्वत उहाँले आफ्नो दाहिने हातले जित्नुभएको थियो।<verse eid="PSA 78:54"/></para>
<para style="p"><verse number="55" style="v" sid="PSA 78:55"/>उहाँले जाति-जातिहरूलाई तिनीहरूकै सामु लखेट्नुभयो, र उनीहरूका जमिन पैतृक सम्पत्तिझैँ इस्राएलीहरूलाई बाँडिदिनुभयो; र इस्राएलीहरूका कुललाई उनीहरूका घरमा बसाल्नुभयो।<verse eid="PSA 78:55"/></para>
<para style="p"><verse number="56" style="v" sid="PSA 78:56"/>तर तिनीहरूले परमेश्‍वरको परीक्षा गरे र सर्वोच्‍च परमेश्‍वरको विरुद्धमा विद्रोही भए; तिनीहरूले उहाँका विधि-विधानहरू पालन गरेनन्।<verse eid="PSA 78:56"/></para>
<para style="p"><verse number="57" style="v" sid="PSA 78:57"/>तिनीहरूका पितापुर्खाहरू जस्तै बेइमान र विश्‍वासघाती, भर पर्न नसकिने बाङ्गो धनुजस्तै भए।<verse eid="PSA 78:57"/></para>
<para style="p"><verse number="58" style="v" sid="PSA 78:58"/>तिनीहरूका देवस्थानहरूद्वारा उहाँलाई क्रोधित तुल्याए; तिनीहरूका मूर्तिहरूका कारण उहाँलाई डाही तुल्याए।<verse eid="PSA 78:58"/></para>
<para style="p"><verse number="59" style="v" sid="PSA 78:59"/>जब परमेश्‍वरले तिनीहरूको सोर सुन्‍नुभयो, उहाँ अत्यन्तै रिसाउनुभयो; उहाँले इस्राएलीहरूलाई पूर्ण रूपमा इन्कार गर्नुभयो।<verse eid="PSA 78:59"/></para>
<para style="p"><verse number="60" style="v" sid="PSA 78:60"/>उहाँले शीलोमा भएको पवित्रस्थानलाई त्याग्नुभयो, जुन पाल मानिसहरूका बीचमा उहाँले राख्नुभएको थियो।<verse eid="PSA 78:60"/></para>
<para style="p"><verse number="61" style="v" sid="PSA 78:61"/>उहाँको शक्तिको सन्दुक निर्वासनमा पठाइदिनुभयो, उहाँको महिमालाई शत्रुहरूका हातमा जान दिनुभयो।<verse eid="PSA 78:61"/></para>
<para style="p"><verse number="62" style="v" sid="PSA 78:62"/>उहाँले आफ्ना मानिसहरूलाई तरवारले काटिन सुम्पिदिनुभयो; आफ्ना उत्तराधिकारसँग अत्यन्तै रिसाउनुभयो।<verse eid="PSA 78:62"/></para>
<para style="p"><verse number="63" style="v" sid="PSA 78:63"/>आगोले तिनीहरूका जवान पुरुषहरू भस्म पारिए, र उनीहरूका कन्याहरूका निम्ति वैवाहिक गीत गाइएन;<verse eid="PSA 78:63"/></para>
<para style="p"><verse number="64" style="v" sid="PSA 78:64"/>तिनीहरूका पुजारीहरू तरवारले मारिए, र तिनीहरूका विधवाहरूले विलाप गर्न पाएनन्।<verse eid="PSA 78:64"/></para>
<para style="p"><verse number="65" style="v" sid="PSA 78:65"/>तब प्रभु निद्राबाट बिउँझिएझैँ जाग्नुभयो; र मद्यले मातेका लडाकुझैँ उहाँ बिउँझनुभयो।<verse eid="PSA 78:65"/></para>
<para style="p"><verse number="66" style="v" sid="PSA 78:66"/>उहाँले आफ्ना शत्रुहरूलाई बदला लिनुभयो; उहाँले तिनीहरूलाई अनन्तको निम्ति लाजमा पार्नुभयो।<verse eid="PSA 78:66"/></para>
<para style="p"><verse number="67" style="v" sid="PSA 78:67"/>तब उहाँले योसेफका पालहरूलाई त्याग्नुभयो, उहाँले एफ्राइमको वंशलाई छान्‍नुभएन;<verse eid="PSA 78:67"/></para>
<para style="p"><verse number="68" style="v" sid="PSA 78:68"/>तर यहूदाका कुललाई छान्‍नुभयो, सियोन पर्वत, जसलाई उहाँले प्रेम गर्नुहुन्थ्यो।<verse eid="PSA 78:68"/></para>
<para style="p"><verse number="69" style="v" sid="PSA 78:69"/>यही ठाउँमा उहाँले आफ्नो पवित्रस्थान उच्‍च स्थानहरूझैँ बनाउनुभयो। उहाँले पृथ्वीलाईझैँ त्यस ठाउँलाई सदाको लागि स्थापित गर्नुभएको छ।<verse eid="PSA 78:69"/></para>
<para style="p"><verse number="70" style="v" sid="PSA 78:70"/>उहाँले दावीदलाई आफ्नो सेवक चुन्‍नुभयो, र तिनलाई भेडीगोठबाट उठाउनुभयो;<verse eid="PSA 78:70"/></para>
<para style="p"><verse number="71" style="v" sid="PSA 78:71"/>उहाँले भेडा गोठालोबाट, दावीदलाई याकोबका मानिसहरू र आफ्नो उत्तराधिकार इस्राएलीहरूको गोठालो हुनलाई ल्याउनुभयो।<verse eid="PSA 78:71"/></para>
<para style="p"><verse number="72" style="v" sid="PSA 78:72"/>अनि दावीदले हृदयको इमानदारीतामा तिनीहरूको हेरचाह गरे; निपुणतासाथ तिनीहरूको अगुवाइ गरे।<verse eid="PSA 78:72"/></para>
<chapter eid="PSA 78"/>
<chapter number="79" style="c" sid="PSA 79"/>
<para style="p"><verse number="1" style="v" sid="PSA 79:1"/>आसापको भजन। हे परमेश्‍वर, राष्ट्रहरूले तपाईंका उत्तराधिकारलाई आक्रमण गरेका छन्; तिनीहरूले तपाईंका पवित्र मन्दिरलाई अपवित्र पारेका छन्; तिनीहरूले यरूशलेमलाई भग्नावशेषका थुप्राहरू पारिदिएका छन्।<verse eid="PSA 79:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 79:2"/>तिनीहरूले तपाईंका सेवकहरूका लासलाई आकाशका पक्षीहरूलाई आहाराको निम्ति छोडेका छन्, तपाईंका आफ्ना मानिसका शरीर जङ्गली जनावरहरूलाई दिएका छन्।<verse eid="PSA 79:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 79:3"/>तिनीहरूले उनीहरूका रगत यरूशलेमको चारैतिर पानीजस्तै बगाएका छन्, र उनीहरूका लासलाई गाड्ने कोही छैनन्।<verse eid="PSA 79:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 79:4"/>हाम्रा छिमेकीहरूका सामु हामी गिल्‍लाका पात्र; र हाम्रा वरिपरिका मानिसहरूका बीच तिरस्कार र हाँसोका पात्र भएका छौँ।<verse eid="PSA 79:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 79:5"/>हे याहवेह, तपाईं कहिलेसम्म क्रोधित भइरहनुहुन्छ? के सधैँभरिको लागि? तपाईंको डाह कहिलेसम्म आगोझैँ दन्किनेछ?<verse eid="PSA 79:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 79:6"/>तपाईंको क्रोध ती राष्ट्रहरूमाथि खन्याउनुहोस्, जसले तपाईंलाई स्वीकार गर्दैनन्; ती राज्यहरूमाथि, जसले तपाईंको नामलाई पुकार्दैनन्;<verse eid="PSA 79:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 79:7"/>किनकि तिनीहरूले याकोबलाई निलेका छन्, र तिनको वासस्थान उजाड पारेका छन्।<verse eid="PSA 79:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 79:8"/>हाम्रा पितापुर्खाहरूका पापको दण्ड हामीलाई नदिनुहोस्; तपाईंको कृपा चाँडै हामीलाई भेट्न आओस्, किनकि हामी अत्यन्तै अभावमा छौँ।<verse eid="PSA 79:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 79:9"/>हे हाम्रा उद्धारक परमेश्‍वर, तपाईंको नामको महिमाको खातिर, हामीलाई सहायता गर्नुहोस्; तपाईंको नामको खातिर हामीलाई छुटाउनुहोस् र हाम्रा पाप क्षमा गर्नुहोस्!<verse eid="PSA 79:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 79:10"/>“तिनीहरूका परमेश्‍वर कहाँ छन्?” भन्‍ने मौका राष्ट्रहरूले नपाऊन्। तपाईंका आफ्ना सेवकहरूको बगाइएका रगतको बदला लिनुहुन्छ भन्‍ने कुरा हाम्रै आँखाको अगि राष्ट्रहरूलाई थाहा गराउनुहोस्।<verse eid="PSA 79:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 79:11"/>कैदीहरूका विलाप तपाईंको सामु पुगोस्; तपाईंको शक्तिशाली हातद्वारा मृत्युको दण्डमा परेकाहरूको रक्षा गर्नुहोस्।<verse eid="PSA 79:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 79:12"/>हे प्रभु, तिनीहरूले तपाईंलाई गरेका तिरस्कारको सट्टा, हाम्रा छिमेकीहरूसँग सात गुणा बदला लिनुहोस्।<verse eid="PSA 79:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 79:13"/>तब हामी, तपाईंका मानिसहरू, तपाईंको खर्कका भेडाहरूले, सदासर्वदा तपाईंको प्रशंसा गर्नेछौँ; पुस्तौँ-पुस्तासम्म हामी तपाईंको प्रशंसाको घोषणा गर्नेछौँ।<verse eid="PSA 79:13"/></para>
<chapter eid="PSA 79"/>
<chapter number="80" style="c" sid="PSA 80"/>
<para style="p"><verse number="1" style="v" sid="PSA 80:1"/>सङ्गीत निर्देशकको निम्ति, “करारका लिली फूल” को रागमा आधारित, आसापको भजन। हे इस्राएलका गोठाला, हामीलाई सुन्‍नुहोस्; तपाईं, जसले योसेफलाई भेडाबाख्राको बगाललाई झैँ अगुवाइ गर्नुहुन्छ, तपाईं, जो करूबहरूका बीचमा विराजमान हुनुहुन्छ, प्रकाशमान् हुनुहोस्!<verse eid="PSA 80:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 80:2"/>एफ्राइम, बेन्यामीन र मनश्शेको सामु। आफ्नो सामर्थ्य जगाउनुहोस्; आउनुहोस् र हामीलाई बचाउनुहोस्!<verse eid="PSA 80:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 80:3"/>हे परमेश्‍वर, हामीलाई पुनर्स्थापना गर्नुहोस्; आफ्नो मुहार हामीमाथि चम्काउनुहोस्; र हामी बचाइन सकौँ।<verse eid="PSA 80:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 80:4"/>हे याहवेह, सेनाहरूका परमेश्‍वर, आफ्नो प्रजाका प्रार्थनाको विरुद्ध, तपाईंको क्रोध कहिलेसम्म सल्किरहन्छ?<verse eid="PSA 80:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 80:5"/>तपाईंले तिनीहरूलाई आँसुका रोटी खुवाउनुभएको छ; र पिउनलाई कचौराभरि आँसु दिनुभएको छ।<verse eid="PSA 80:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 80:6"/>तपाईंले हामीलाई छिमेकीहरूका लागि झगडाको पात्र बनाउनुभएको छ, र हाम्रा शत्रुहरूले हामीलाई गिल्‍ला गर्छन्।<verse eid="PSA 80:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 80:7"/>हे सेनाहरूका परमेश्‍वर, हामीलाई पुनर्स्थापन गर्नुहोस्; आफ्नो मुहार हामीमाथि चम्काउनुहोस्; र हामी बचाइन सकौँ।<verse eid="PSA 80:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 80:8"/>तपाईंले इजिप्टबाट एउटा दाखको बोट ल्याउनुभयो; र राष्ट्रहरूलाई लखेटेर त्यसलाई रोप्नुभयो।<verse eid="PSA 80:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 80:9"/>तपाईंले त्यसको निम्ति भूमि तयार गर्नुभयो, र त्यसको जरो गड्यो; र त्यो देशभरि फैलियो।<verse eid="PSA 80:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 80:10"/>त्यसका छायाले पहाडहरू ढाकिए, र त्यसका हाँगाबिँगाहरूले शक्तिशाली देवदारुका रूखहरू ढाके।<verse eid="PSA 80:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 80:11"/>त्यसका हाँगाहरू भूमध्य समुद्रसम्म गए, अनि त्यसका मुनाहरूचाहिँ यूफ्रेटिस नदीसम्मै फैलिए।<verse eid="PSA 80:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 80:12"/>तपाईंले त्यसका पर्खाल किन भत्काइदिनुभएको छ? के त्यहाँबाट जाने सबैले त्यसको फल टिपून्?<verse eid="PSA 80:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 80:13"/>जङ्गलका बँदेलहरूले त्यसलाई नष्‍ट पार्छन्। र जङ्गली जनावरहरू त्यसमा चर्छन्।<verse eid="PSA 80:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 80:14"/>हे सेनाहरूका परमेश्‍वर, हाम्रा बीचमा फेरि फर्कनुहोस्! स्वर्गबाट तल दृष्‍टि गर्नुहोस् र हाम्रो दुर्दशा हेर्नुहोस्! यस दाखको बोटको हेरचाह गर्नुहोस्।<verse eid="PSA 80:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 80:15"/>तपाईंको आफ्नो दाहिने बाहुलीले रोप्नुभएको त्यो विरुवाको जरा, त्यो दाख, जसलाई तपाईंले आफ्नो लागि हुर्काउनुभएको छ।<verse eid="PSA 80:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 80:16"/>तपाईंका दाखको बोट काटेर ढालिएको छ, आगोले डढाइएको छ; तपाईंको हप्कीले तपाईंका प्रजा नष्‍ट हुन्छन्।<verse eid="PSA 80:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 80:17"/>तपाईंको दायाँतर्फ भएको मानिसमाथि तपाईंको हात रहोस्। त्यो मानिसको पुत्र, जसलाई तपाईंले आफ्नो निम्ति खडा गर्नुभएको छ।<verse eid="PSA 80:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 80:18"/>तब हामी तपाईंबाट पिठिउँ फर्काउनेछैनौँ; हामीलाई नयाँ जीवन प्रदान गर्नुहोस्, र हामी तपाईंका नाम पुकार गर्नेछौँ।<verse eid="PSA 80:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 80:19"/>हे याहवेह, सेनाहरूका परमेश्‍वर; हामीलाई पुनर्स्थापना गर्नुहोस्, आफ्नो मुहार हामीमाथि चम्काउनुहोस्, र हामी बचाइन सकौँ।<verse eid="PSA 80:19"/></para>
<chapter eid="PSA 80"/>
<chapter number="81" style="c" sid="PSA 81"/>
<para style="p"><verse number="1" style="v" sid="PSA 81:1"/>सङ्गीत निर्देशकको निम्ति, गित्तित,* आसापको भजन। परमेश्‍वरका लागि, जो हाम्रो बल हुनुहुन्छ, आनन्दले गाओ; उच्‍च सोरले याकोबका परमेश्‍वरको जयजयकार गर!<verse eid="PSA 81:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 81:2"/>सङ्गीत बजाउन सुरु गर, खैँजडी बजाओ, मधुर सितार र वीणा बजाओ!<verse eid="PSA 81:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 81:3"/>औँसी र पूर्णिमाको रातमा हुने, हाम्रो चाडमा भेडाको सिङबाट बनेको तुरही बजाओ।<verse eid="PSA 81:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 81:4"/>इस्राएलको निम्ति यो एउटा आदेश हो, याकोबका परमेश्‍वरको यो एउटा विधि हो।<verse eid="PSA 81:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 81:5"/>जब परमेश्‍वर इजिप्टको विरुद्ध उठ्नुभयो, उहाँले योसेफको निम्ति यो एउटा कानुनको रूपमा स्थापित गर्नुभयो। मैले एउटा अज्ञात आवाजले यसो भनेको सुनेँ:<verse eid="PSA 81:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 81:6"/>“मैले तिनीहरूका काँधबाट बोझ हटाइदिएँ; डोकाको बोझबाट तिनीहरूका हात मुक्त भए।<verse eid="PSA 81:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 81:7"/>दुःखमा पर्दा तिमीहरूले पुकार्‍यौ, र मैले तिमीहरूलाई छुटाएँ; मैले मेघ गर्जनबाट तिमीहरूलाई उत्तर दिएँ; मैले मेरीबाका पानीमा तिमीहरूलाई परीक्षा गरेँ। सेला<verse eid="PSA 81:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 81:8"/>हे मेरा प्रजा सुन, म तिमीहरूलाई चेतावनी दिनेछु— हे इस्राएल, तिमीहरूले मेरा कुरा सुनेको भए त!<verse eid="PSA 81:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 81:9"/>तिमीहरूका बीचमा पराई देवता हुनुहुँदैन; तिमीहरूले मबाहेक कुनै देवतालाई दण्डवत् गर्नुहुँदैन।<verse eid="PSA 81:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 81:10"/>म याहवेह नै तिमीहरूका परमेश्‍वर हुँ, जसले तिमीहरूलाई इजिप्टबाट निकालेर ल्याएँ, तिमीहरूका मुख पूरा खोल, र म त्यो भरिदिनेछु।<verse eid="PSA 81:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 81:11"/>“तर मेरा प्रजाले मैले भनेको सुन्दैनन्; इस्राएलले मेरो अधीनमा रहन मान्दैनन्।<verse eid="PSA 81:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 81:12"/>यसकारण तिनीहरू आफ्नै युक्तिमा हिँडून् भनी मैले तिनीहरूलाई तिनीहरूकै हृदयको जिद्दीमा छोडिदिएँ।<verse eid="PSA 81:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 81:13"/>“मेरा प्रजाले मेरा कुरा सुनेका भए त, इस्राएल मेरो मार्गमा हिँडेको भए त,<verse eid="PSA 81:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 81:14"/>म कति चाँडो तिनीहरूका शत्रुहरूलाई पराजित गर्नेथिएँ, र तिनीहरूका दुश्मनहरूका विरुद्धमा मेरो हात उठाउनेथिएँ!<verse eid="PSA 81:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 81:15"/>याहवेहलाई अवहेलना गर्नेहरू उहाँको अगि खुम्चिँदै लत्रक्‍क पर्नेथिए, र उनीहरूको दण्ड सदाकाल रहनेथियो।<verse eid="PSA 81:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 81:16"/>तर तिमीहरूलाई सबैभन्दा सर्वोत्तम गहुँ खुवाउनेथिएँ; र चट्टानमा बनेको महले म तिमीहरूलाई तृप्‍त पार्नेथिएँ।”<verse eid="PSA 81:16"/></para>
<chapter eid="PSA 81"/>
<chapter number="82" style="c" sid="PSA 82"/>
<para style="p"><verse number="1" style="v" sid="PSA 82:1"/>आसापको भजन। परमेश्‍वर विशाल समुदायमा आफ्नो स्थान ग्रहण गर्नुहुन्छ; “देवताहरूका” बीचमा उहाँले न्याय गर्नुहुन्छ।<verse eid="PSA 82:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 82:2"/>कहिलेसम्म तिमीहरू अन्यायीहरूको पक्ष लिइबस्छौ? र दुष्‍टहरूको पक्ष लिइरहन्छौ? सेला<verse eid="PSA 82:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 82:3"/>दुर्बल र अनाथहरूका पक्षमा खडा होऊ; गरिब र अत्याचारमा परेकाहरूको हकको रक्षा गर!<verse eid="PSA 82:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 82:4"/>दुर्बल र गरिबहरूलाई छुटाओ; दुष्‍टहरूका हातबाट तिनीहरूलाई मुक्त गर!<verse eid="PSA 82:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 82:5"/>“तिनीहरू न केही जान्दछन्, न त केही बुझ्दछन्; तिनीहरू अन्धकारमा यताउता डुल्छन्; पृथ्वीका सारा जग नै डगमगाएका छन्।<verse eid="PSA 82:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 82:6"/>“मैले भनेँ, ‘तिमीहरू “देवहरू” हौ; तिमीहरू सबै सर्वोच्‍च परमेश्‍वरका छोराहरू हौ।’<verse eid="PSA 82:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 82:7"/>तर तिमीहरू साधारण मानिसहरूझैँ मर्नेछौ; अरू शासकझैँ तिमीहरूको पतन हुनेछ।”<verse eid="PSA 82:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 82:8"/>हे परमेश्‍वर, उठ्नुहोस्, पृथ्वीको न्याय गर्नुहोस्; किनकि सारा राष्ट्रहरू तपाईंका उत्तराधिकार हुन्।<verse eid="PSA 82:8"/></para>
<chapter eid="PSA 82"/>
<chapter number="83" style="c" sid="PSA 83"/>
<para style="p"><verse number="1" style="v" sid="PSA 83:1"/>एउटा गीत, आसापको भजन। हे परमेश्‍वर, तपाईं मौन नरहनुहोस्; हे परमेश्‍वर, आफ्नो कान नथुन्‍नुहोस्; तपाईं निष्क्रिय नहुनुहोस्!<verse eid="PSA 83:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 83:2"/>हेर्नुहोस्, तपाईंका शत्रुहरूले कस्तो हुङ्कार गरेका छन्, तपाईंलाई घृणा गर्नेहरूले कसरी शिर ठाडो पारेका छन्।<verse eid="PSA 83:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 83:3"/>तिनीहरूले धूर्ततासाथ तपाईंका मानिसहरूका विरुद्धमा षड्यन्त्र रच्तछन्; तिनीहरू तपाईंले अनमोल ठान्‍नुभएकाहरूको विरुद्धमा मतो गर्छन्।<verse eid="PSA 83:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 83:4"/>तिनीहरू भन्छन्, “आओ, हामी तिनीहरूको राष्ट्रलाई ध्वंस पारौँ; ताकि इस्राएल भन्‍ने नामको सम्झना नै नरहोस्!”<verse eid="PSA 83:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 83:5"/>तिनीहरू एकमत भएर षड्यन्त्र रच्दछन्; तिनीहरू तपाईंको विरुद्ध गठबन्धन गर्दछन्—<verse eid="PSA 83:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 83:6"/>एदोमीहरू र इश्माएलीहरूका पालहरू, मोआबीहरू र हग्रीहरू,<verse eid="PSA 83:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 83:7"/>गबालीहरू, अम्मोनीहरू र अमालेकीहरू, पलिश्तीहरू र टायरका निवासीहरू।<verse eid="PSA 83:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 83:8"/>लोतका सन्तानलाई सशक्त पार्न, अश्शूर पनि तिनीहरूसँग मिलेको छ। सेला<verse eid="PSA 83:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 83:9"/>मिद्यानीहरूलाई गर्नुभएझैँ तिनीहरूलाई पनि गर्नुहोस्, कीशोन खोलामा सीसरा र याबीनलाई गरेझैँ गर्नुहोस्,<verse eid="PSA 83:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 83:10"/>जो एन्दोरमा नाश पारिएका थिए, र जमिनमा फोहोर भएका थिए।<verse eid="PSA 83:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 83:11"/>तिनीहरूका भारदारहरूलाई ओरेब र जीबझैँ, राजकुमारहरूलाई जेबह र सल्मुन्‍नाजस्तै बनाउनुहोस्;<verse eid="PSA 83:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 83:12"/>जसले भने, “हामी परमेश्‍वरका खर्कलाई कब्जा गरौँ।”<verse eid="PSA 83:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 83:13"/>हे मेरा परमेश्‍वर, तिनीहरूलाई भुमरीमा परेको धुलोझैँ, बतासले उडाएको भुसझैँ तुल्याउनुहोस्!<verse eid="PSA 83:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 83:14"/>जसरी आगोले जङ्गल भस्म पार्छ, र ज्वालाले पहाड जलाउँछ,<verse eid="PSA 83:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 83:15"/>त्यसरी नै तिनीहरूलाई तपाईंको प्रचण्ड आँधीले खेद्नुहोस् र आँधीबेहरीले तिनीहरूलाई भयभीत पार्नुहोस्!<verse eid="PSA 83:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 83:16"/>तिनीहरूका मुहार लाजले ढाकिदिनुहोस्; ताकि हे याहवेह, तिनीहरूले तपाईंको नामको खोजी गरून्।<verse eid="PSA 83:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 83:17"/>तिनीहरू सधैँ शर्ममा परून्, र भयभीत होऊन्; तिनीहरू अपमानमा नष्‍ट होऊन्।<verse eid="PSA 83:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 83:18"/>तिनीहरूले जानून्, कि तपाईं जसको नाम याहवेह हो— तपाईं मात्र सारा पृथ्वीमा सर्वोच्‍च परमेश्‍वर हुनुहुन्छ।<verse eid="PSA 83:18"/></para>
<chapter eid="PSA 83"/>
<chapter number="84" style="c" sid="PSA 84"/>
<para style="p"><verse number="1" style="v" sid="PSA 84:1"/>सङ्गीत निर्देशकको निम्ति, गित्तित,* कोरहका छोराहरूको भजन। हे सेनाहरूका याहवेह! तपाईंको वासस्थान कति मनोहर छ,<verse eid="PSA 84:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 84:2"/>याहवेहको मन्दिरका चोकहरूको निम्ति मेरो प्राणले तिर्सना गर्दछ, र मूर्च्छा नै पर्छ; मेरो हृदय र मेरो शरीर दुवैले जीवित परमेश्‍वरको पुकार गर्दछ।<verse eid="PSA 84:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 84:3"/>हे सेनाहरूका याहवेह, मेरा राजा अनि मेरा परमेश्‍वर, तपाईंका वेदीको नजिक भँगेरीले पनि घर पाउँछे, अनि गौँथलीले गुँड पाउँछे, जहाँ आफ्ना बचेराहरूलाई हुर्काउँछे।<verse eid="PSA 84:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 84:4"/>तपाईंको वासस्थानमा बस्‍ने धन्यका हुन्; तिनीहरू सदा तपाईंको प्रशंसा गर्छन्। सेला<verse eid="PSA 84:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 84:5"/>तिनीहरू धन्यका हुन्, जसको बल तपाईंमा छ; जसले आफ्ना मन सियोनको यात्रामा लगाएका छन्।<verse eid="PSA 84:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 84:6"/>तिनीहरू बाकाको बेँसीबाट भएर जाँदा, तिनीहरूले त्यसलाई जलस्रोत बनाउँछन्; शरद ऋतुको वर्षाले त्यहाँ आशिष् हुँदछ।<verse eid="PSA 84:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 84:7"/>तिनीहरूले बलमाथि बल प्राप्‍त गर्दै जान्छन्; जबसम्म प्रत्येक सियोनमा परमेश्‍वरको सामु उपस्थित हुँदैनन्।<verse eid="PSA 84:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 84:8"/>हे याहवेह सेनाहरूका परमेश्‍वर, मेरो प्रार्थना सुन्‍नुहोस्; हे याकोबका परमेश्‍वर, मेरो बिन्ती सुन्‍नुहोस्! सेला<verse eid="PSA 84:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 84:9"/>हे परमेश्‍वर, जो हाम्रो ढाल हुनुहुन्छ, हामीलाई हेर्नुहोस्; तपाईंको आफ्नो अभिषिक्तमाथि कृपादृष्‍टि गर्नुहोस्!<verse eid="PSA 84:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 84:10"/>तपाईंको मन्दिरको चोकमा एक दिन अरू ठाउँको हजार दिनभन्दा उत्तम छ; दुष्‍टहरूका पालहरूमा बस्‍नुभन्दा त, बरु मेरा परमेश्‍वरको भवनको ढोके हुन मलाई मन पर्छ,<verse eid="PSA 84:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 84:11"/>किनकि याहवेह परमेश्‍वर सूर्य र ढाल हुनुहुन्छ; याहवेहले निगाह र इज्जत दिनुहुन्छ; सत्य मार्गमा हिँड्नेहरूलाई याहवेहले कुनै भलो कुराबाट वञ्चित राख्नुहुन्‍न।<verse eid="PSA 84:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 84:12"/>हे सेनाहरूका याहवेह, तपाईंमा भरोसा राख्ने मानिसहरू धन्यका हुन्।<verse eid="PSA 84:12"/></para>
<chapter eid="PSA 84"/>
<chapter number="85" style="c" sid="PSA 85"/>
<para style="p"><verse number="1" style="v" sid="PSA 85:1"/>सङ्गीत निर्देशकको निम्ति, कोरहका छोराहरूको भजन। हे याहवेह, तपाईंको देशमाथि तपाईंले कृपा राख्नुभएको छ; तपाईंले याकोबको सुख-शान्ति पुनर्स्थापित गरिदिनुभएको छ।<verse eid="PSA 85:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 85:2"/>तपाईंले आफ्ना प्रजाको अधर्म क्षमा गर्नुभएको छ; तिनीहरूका सबै पाप ढाकिदिनुभएको छ। सेला<verse eid="PSA 85:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 85:3"/>तपाईंले आफ्ना सबै क्रोध पन्छाउनुभयो; र आफ्नो दन्किँदो क्रोधबाट तपाईं फर्कनुभयो।<verse eid="PSA 85:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 85:4"/>हे हाम्रा मुक्तिदाता परमेश्‍वर, हामीलाई पुनर्स्थापित गर्नुहोस्, र हामीप्रतिको तपाईंको अप्रसन्‍नता हटाइदिनुहोस्!<verse eid="PSA 85:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 85:5"/>के तपाईं हामीसित सधैँ रिसाइरहनुहुनेछ? के तपाईं पुस्तौँ-पुस्तासम्म नै क्रोध गरिरहनुहुनेछ?<verse eid="PSA 85:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 85:6"/>के तपाईं हामीलाई पुनर्जागृत बनाउनुहुन्‍न, ताकि तपाईंका प्रजा तपाईंमा रमाऊन्?<verse eid="PSA 85:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 85:7"/>हे याहवेह, आफ्नो अचुक प्रेम हामीलाई देखाउनुहोस्, र हामीलाई तपाईंको मुक्ति प्रदान गर्नुहोस्!<verse eid="PSA 85:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 85:8"/>याहवेह परमेश्‍वरले जे भन्‍नुहुनेछ, त्यो म सुन्‍नेछु; उहाँले आफ्ना प्रजाहरू, र आफ्ना विश्‍वासयोग्य सेवकहरूसँग शान्तिको प्रतिज्ञा गर्नुहुन्छ— तर तिनीहरू फेरि मूर्खतातिर नलागून्।<verse eid="PSA 85:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 85:9"/>निश्‍चय नै उहाँको भय मान्‍नेहरूको नजिकै उहाँको मुक्ति छ; ताकि उहाँको महिमा हाम्रो देशमा बास गरोस्।<verse eid="PSA 85:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 85:10"/>अचुक प्रेम र विश्‍वासयोग्यता आपसमा मिल्छन्; धार्मिकता र शान्तिले एक-अर्कालाई चुम्बन गर्छन्।<verse eid="PSA 85:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 85:11"/>पृथ्वीबाट विश्‍वासयोग्यताको अङ्कुर निस्कन्छ, र स्वर्गबाट धार्मिकताले तल हेर्दछ।<verse eid="PSA 85:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 85:12"/>जे असल छ, याहवेहले त्यही दिनुहुनेछ; र हाम्रा जमिनले फसल उमार्नेछ।<verse eid="PSA 85:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 85:13"/>धार्मिकता उहाँको अगि-अगि जानेछ र उहाँका पाइलाहरूको निम्ति मार्ग तयार गर्छ।<verse eid="PSA 85:13"/></para>
<chapter eid="PSA 85"/>
<chapter number="86" style="c" sid="PSA 86"/>
<para style="p"><verse number="1" style="v" sid="PSA 86:1"/>सङ्कष्‍टमा दावीदको प्रार्थना। हे याहवेह, मेरो प्रार्थना सुन्‍नुहोस्, र मलाई जवाफ दिनुहोस्; किनकि म असहाय र अभावग्रस्त छु।<verse eid="PSA 86:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 86:2"/>मेरो रक्षा गरिदिनुहोस्; किनकि म तपाईंको भक्त हुँ; तपाईंको सेवकलाई बचाउनुहोस्, जसले तपाईंमा भरोसा गर्दछ। तपाईं मेरा परमेश्‍वर हुनुहुन्छ;<verse eid="PSA 86:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 86:3"/>हे प्रभु, ममाथि दयालु हुनुहोस्; किनकि म दिनभरि तपाईंलाई पुकार गर्दछु।<verse eid="PSA 86:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 86:4"/>आफ्नो सेवकलाई हर्षित पार्नुहोस्; किनकि प्रभु, म मेरो भरोसा तपाईंमा राख्दछु।<verse eid="PSA 86:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 86:5"/>हे प्रभु, तपाईं भलो र क्षमाशील हुनुहुन्छ; तपाईंलाई पुकार्ने सबैलाई तपाईंको अचुक प्रेम प्रशस्त रहन्छ।<verse eid="PSA 86:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 86:6"/>हे याहवेह, मेरो प्रार्थना सुनिदिनुहोस्; दयाको निम्ति मेरो पुकारमा ध्यान दिनुहोस्!<verse eid="PSA 86:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 86:7"/>जब म सङ्कष्‍टमा हुन्छु, म तपाईंलाई पुकार गर्नेछु; किनकि तपाईंले मलाई जवाफ दिनुहुन्छ।<verse eid="PSA 86:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 86:8"/>हे प्रभु! तपाईंजस्तो अरू कोही ईश्‍वरहरू छैनन्; तपाईंका कार्यहरू अरू कुनै ईश्‍वरसँग तुलना गर्न सकिँदैन।<verse eid="PSA 86:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 86:9"/>हे प्रभु, तपाईंले बनाउनुभएका सबै राष्ट्रहरू तपाईंको सामु आएर दण्डवत् गर्नेछन्; तिनीहरूले तपाईंको नामको महिमा गर्नेछन्।<verse eid="PSA 86:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 86:10"/>किनकि तपाईं महान् हुनुहुन्छ, र अचम्मका कामहरू गर्नुहुन्छ; तपाईं मात्र परमेश्‍वर हुनुहुन्छ।<verse eid="PSA 86:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 86:11"/>हे याहवेह, मलाई तपाईंको मार्ग सिकाउनुहोस्; ताकि म तपाईंको विश्‍वासयोग्यतामा भर पर्न सकूँ; मलाई एकाग्र मन दिनुहोस्, र म तपाईंको नामको भय मान्‍न सकूँ।<verse eid="PSA 86:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 86:12"/>हे प्रभु, मेरा परमेश्‍वर, मेरो सारा हृदयले म तपाईंको प्रशंसा गर्नेछु; म सदासर्वदा तपाईंको नामको महिमा गर्नेछु।<verse eid="PSA 86:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 86:13"/>किनकि मप्रति तपाईंको अचुक प्रेम महान् छ; तपाईंले मेरो जीवनलाई पातालको गहिराइबाट छुटाउनुभएको छ।<verse eid="PSA 86:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 86:14"/>हे परमेश्‍वर, अहङ्कारी मानिसहरूले मलाई आक्रमण गरिरहेका छन्; निर्दयी मानिसहरूका समूहले मलाई मार्न खोजिरहेका छन्— ती मानिसहरू, जसले तपाईंलाई आदर गर्दैनन्।<verse eid="PSA 86:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 86:15"/>तर प्रभु, तपाईं दयालु र अनुग्रही परमेश्‍वर हुनुहुन्छ; रिसाउनमा ढिलो, प्रेम र सत्यतामा भरिपूर्ण हुनुहुन्छ।<verse eid="PSA 86:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 86:16"/>मतिर फर्कनुहोस् र ममाथि दया गर्नुहोस्; आफ्नो शक्ति तपाईंको सेवकलाई दिनुहोस्, र आफ्नी सेविकाको छोरालाई बचाउनुहोस्! किनकि म तपाईंको सेवा गर्दछु।<verse eid="PSA 86:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 86:17"/>तपाईंका भलाइको चिन्ह मलाई दिनुहोस्; र मलाई घृणा गर्नेहरू, त्यो देखेर शर्ममा परून्; किनकि हे याहवेह, तपाईंले मलाई सहायता गर्नुभएको छ र सान्त्वना दिनुभएको छ।<verse eid="PSA 86:17"/></para>
<chapter eid="PSA 86"/>
<chapter number="87" style="c" sid="PSA 87"/>
<para style="p"><verse number="1" style="v" sid="PSA 87:1"/>एउटा गीत, कोरहका छोराहरूका भजन। याहवेहले आफ्नो जग पवित्र पर्वतमा स्थापित गर्नुभएको छ।<verse eid="PSA 87:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 87:2"/>याकोबका सबै वासस्थानहरूलाई भन्दा उहाँले सियोनका ढोकाहरूलाई बढी प्रेम गर्नुहुन्छ।<verse eid="PSA 87:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 87:3"/>हे परमेश्‍वरको सहर, तेरो विषयमा प्रशंसामय कुराहरू भनिएका छन्: सेला<verse eid="PSA 87:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 87:4"/>“मलाई स्वीकार गर्नेहरूमध्ये राहाब र बेबिलोनलाई म सूचीमा राख्नेछु— पलिश्ती, टायर र कूशलाई समेत भन्‍नेछु, ‘योचाहिँ सियोनमा जन्मेको थियो।’ ”<verse eid="PSA 87:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 87:5"/>वास्तवमा सियोनको विषयमा चाहिँ यो भनिनेछ, “यो र त्यो त्यहीँ जन्मेका थिए, अनि सर्वोच्‍च परमेश्‍वरले नै त्यसलाई स्थापना गर्नुहुनेछ।”<verse eid="PSA 87:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 87:6"/>याहवेहले जाति-जातिहरूका नाम दर्ता-पुस्तकमा लेख्नुहुनेछ: “यसको जन्म सियोनमा भएको हो।” सेला<verse eid="PSA 87:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 87:7"/>सङ्गीत बजाउँदा तिनीहरूले गाउनेछन्: “मेरा सबै आशिष्‌का मूलहरू तँमा नै छन्।”<verse eid="PSA 87:7"/></para>
<chapter eid="PSA 87"/>
<chapter number="88" style="c" sid="PSA 88"/>
<para style="p"><verse number="1" style="v" sid="PSA 88:1"/>एउटा गीत, कोरहका छोराहरूको भजन, सङ्गीत निर्देशकको निम्ति— महलत लिन्‍नोत* लयमा आधारित, एज्रीका हेमानको मस्किल।* हे याहवेह, तपाईं नै त्यो परमेश्‍वर हुनुहुन्छ, जसले मलाई बचाउनुहुन्छ; दिनरात म तपाईंलाई पुकार्दछु।<verse eid="PSA 88:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 88:2"/>मेरो प्रार्थना तपाईंको सामु पुगोस्; मेरो क्रन्दनतिर आफ्नो कान लगाउनुहोस्!<verse eid="PSA 88:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 88:3"/>किनकि मेरो प्राण पीडाले भरिएको छ र मेरो जीवन चिहानको नजिकै पुगेको छ।<verse eid="PSA 88:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 88:4"/>चिहानमा जानेहरूसँगै मेरो गणना भएको छ; म शक्तिविहीन मानिसझैँ भएको छु।<verse eid="PSA 88:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 88:5"/>म मरेकाहरूसितै छुट्ट्याइएको छु, मारिएका मानिसजस्तै, जो चिहानमा नै रहन्छन्, जसलाई तपाईं कहिल्यै सम्झनुहुन्‍न; जो तपाईंको वास्ताबाट त्यागिएका छन्।<verse eid="PSA 88:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 88:6"/>तपाईंले मलाई चिहानको तल्‍लो भागमा, अति अन्धकारमय गहिराइहरूमा फ्याँकिदिनुभएको छ।<verse eid="PSA 88:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 88:7"/>तपाईंको क्रोधले मलाई दबाएर राखेको छ; तपाईंका सबै छालहरूले मलाई व्याकुल पार्नुभएको छ। सेला<verse eid="PSA 88:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 88:8"/>मेरा अति नजिकका साथीहरूबाट तपाईंले मलाई अलग गर्नुभएको छ; तपाईंले मलाई तिनीहरूको लागि घृणित तुल्याउनुभएको छ। म पासोमा परेको छु, र म उम्कन सक्दिनँ;<verse eid="PSA 88:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 88:9"/>शोकले मेरा आँखाहरू धमिला हुन्छन्। हे याहवेह, म सारा दिन तपाईंलाई पुकार गर्दछु; म मेरा हात तपाईंतिर पसार्दछु।<verse eid="PSA 88:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 88:10"/>के मृतकहरूलाई तपाईं आफ्ना अद्‌भुत कार्यहरू देखाउनुहुन्छ? के मरेकाहरू जीवित भएर तपाईंको स्तुति गर्छन् र? सेला<verse eid="PSA 88:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 88:11"/>के तपाईंको अचुक प्रेम चिहानमा, तपाईंको विश्‍वसताको मृत-लोकमा घोषणा गरिन्छ?<verse eid="PSA 88:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 88:12"/>के तपाईंको अद्‌भुत कार्यहरू अन्धकारको स्थानमा, अथवा तपाईंको धार्मिकताका कामहरू स्मरण नहुने देशमा चिनिन्छन् र?<verse eid="PSA 88:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 88:13"/>हे याहवेह, तर म सहायताको निम्ति तपाईंमा पुकार गर्दछु; बिहानै मेरो प्रार्थना तपाईंको सामु आउँछ।<verse eid="PSA 88:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 88:14"/>हे याहवेह, तपाईं मलाई किन इन्कार गर्नुहुन्छ? अनि आफ्नो मुहार मबाट किन लुकाउनुहुन्छ?<verse eid="PSA 88:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 88:15"/>मेरो युवावस्थादेखि नै म सताइएको छु, र मर्न लागेको छु; तपाईंको त्रासबाट म पीडित छु, र म निराश भएको छु।<verse eid="PSA 88:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 88:16"/>तपाईंको क्रोध ममाथि खनिएको छ; तपाईंका त्रासहरूले मलाई नष्‍ट पारेका छन्।<verse eid="PSA 88:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 88:17"/>तिनीहरूले मलाई दिनभरि नै बाढीले झैँ घेर्छन्; तिनीहरूले मलाई पूर्ण रूपमा घेरेका छन्।<verse eid="PSA 88:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 88:18"/>तपाईंले मबाट मेरा मित्र र मेरा छिमेकीहरू हटाउनुभएको छ— अन्धकार मेरो नजिकको मित्र बनेको छ।<verse eid="PSA 88:18"/></para>
<chapter eid="PSA 88"/>
<chapter number="89" style="c" sid="PSA 89"/>
<para style="p"><verse number="1" style="v" sid="PSA 89:1"/>एज्रीका एतानको मस्किल।* म याहवेहको अचुक प्रेमको प्रशंसा सदासर्वदा गाउनेछु; मेरो मुखले पुस्तौँ-पुस्तालाई तपाईंको विश्‍वासयोग्यता बताइरहनेछु।<verse eid="PSA 89:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 89:2"/>तपाईंको अचुक प्रेम सदाको निम्ति दृढ रहिरहनेछ; स्वर्गमा पनि तपाईंले आफ्नो विश्‍वासयोग्यता स्थापित गर्नुभएको छ भनी म घोषणा गर्नेछु।<verse eid="PSA 89:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 89:3"/>तपाईंले भन्‍नुभयो, “मैले आफ्नो चुनेको मानिससित करार बाँधेको छु; मैले आफ्नो सेवक दावीदसित यो शपथ खाएको छु,<verse eid="PSA 89:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 89:4"/>‘म तेरो वंशलाई सदाको निम्ति स्थापित गर्नेछु, र पुस्तौँ-पुस्तासम्म म तेरो सिंहासन स्थिर बनाउनेछु।’ ” सेला<verse eid="PSA 89:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 89:5"/>हे याहवेह, स्वर्गले तपाईंको अद्‌भुत कार्यहरूको प्रशंसा गर्दछ, पवित्र जनहरूको सभामा तपाईंको विश्‍वासयोग्यताको पनि गुणगान हुँदछ।<verse eid="PSA 89:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 89:6"/>किनकि सारा ब्रह्‍माण्डमा नै याहवेहको तुलना कोसँग गर्न सकिन्छ र? स्वर्गीय प्राणीहरूमध्ये को याहवेहको समान छन् र?<verse eid="PSA 89:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 89:7"/>पवित्र जनहरूको सभाघरमा परमेश्‍वर अधिक श्रद्धायोग्य हुनुहुन्छ; उहाँको वरिपरि हुनेहरूमध्ये, उहाँ अति भययोग्य हुनुहुन्छ।<verse eid="PSA 89:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 89:8"/>हे सेनाहरूका याहवेह परमेश्‍वर, तपाईंजस्तो अरू को छ र? तपाईं शक्तिशाली हुनुहुन्छ, हे याहवेह, तपाईंको विश्‍वासयोग्यता तपाईंको वरिपरि छ।<verse eid="PSA 89:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 89:9"/>उर्लंदो समुद्रमाथि तपाईंले नै राज्य गर्नुहुन्छ; त्यसका छालहरू उर्लंदा, तपाईंले नै तिनलाई शान्त गराउनुहुन्छ।<verse eid="PSA 89:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 89:10"/>तपाईंले मारिएकाहरूलाई झैँ राहाबलाई नष्‍ट पार्नुभयो; तपाईंले आफ्ना शत्रुहरूलाई आफ्ना पाखुराले तितरबितर पार्नुभयो।<verse eid="PSA 89:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 89:11"/>स्वर्गहरू तपाईंको हो, र पृथ्वी पनि तपाईंकै हो; संसार र त्यसमा भएका यावत् थोक तपाईंले नै स्थापित गर्नुभयो।<verse eid="PSA 89:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 89:12"/>उत्तर र दक्षिण तपाईंले नै सृष्‍टि गर्नुभएको हो; तबोर र हेर्मोन तपाईंको नाममा हर्षले गाउँछन्।<verse eid="PSA 89:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 89:13"/>तपाईंको पाखुरा शक्तिशाली छ; तपाईंको हात बलियो छ, तपाईंको दाहिने हात उच्‍च छ।<verse eid="PSA 89:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 89:14"/>धार्मिकता र न्याय तपाईंको सिंहासनका जग हुन्; अचुक प्रेम र विश्‍वासयोग्यता तपाईंको अगि जान्छन्।<verse eid="PSA 89:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 89:15"/>हे याहवेह, ती मानिसहरू धन्य हुन्, जसले जयध्वनिसाथ तपाईंको प्रशंसा गर्न सिकेका छन्; जो तपाईंका प्रकाशको उपस्थितिमा हिँड्छन्।<verse eid="PSA 89:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 89:16"/>तिनीहरू दिनभरि तपाईंको नाममा रमाउँछन्; तिनीहरूले तपाईंको धार्मिकताको उत्सव मनाउँछन्।<verse eid="PSA 89:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 89:17"/>किनकि तपाईं नै तिनीहरूका महिमा र बल हुनुहुन्छ, र तपाईंकै निगाहले हाम्रो सिङ उच्‍च पारिदिनुभएको छ।<verse eid="PSA 89:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 89:18"/>वास्तवमा याहवेह नै हाम्रो ढाल हुनुहुन्छ; हाम्रा राजा इस्राएलका पवित्र परमेश्‍वर हुनुहुन्छ।<verse eid="PSA 89:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 89:19"/>तपाईंले एक पटक दर्शनमा बोल्नुभयो, आफ्ना विश्‍वासयोग्य जनहरूसित यसो भन्‍नुभयो: “मैले एक योद्धालाई बल प्रदान गरेको छु; मैले मानिसहरूबाट चुनिएको एक युवकलाई उच्‍च पारेको छु।<verse eid="PSA 89:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 89:20"/>मैले मेरो सेवक दावीदलाई भेट्टाएको छु; मैले आफ्नो पवित्र तेलले त्यसलाई अभिषेक गरेको छु।<verse eid="PSA 89:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 89:21"/>मेरो हातले त्यसलाई थाम्नेछ; निश्‍चय नै मेरो पाखुराले त्यसलाई बलियो बनाउनेछ।<verse eid="PSA 89:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 89:22"/>शत्रुले त्यसबाट तिरो असुल्ने छैन; कुनै दुष्‍ट मानिसले त्यसमाथि अत्याचार गर्नेछैन।<verse eid="PSA 89:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 89:23"/>त्यसका वैरीलाई म त्यसकै सामु चूर्ण पार्नेछु, अनि त्यसलाई घृणा गर्नेहरूलाई प्रहार गर्नेछु।<verse eid="PSA 89:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 89:24"/>मेरो विश्‍वासयोग्यता र अचुक प्रेम त्यससँग रहनेछ, र मेरो नामद्वारा त्यसको सिङ उच्‍च हुनेछ।<verse eid="PSA 89:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 89:25"/>म त्यसको हातलाई समुद्रमाथि, त्यसको दाहिने हातलाई नदीहरूमाथि स्थापित गराउनेछु।<verse eid="PSA 89:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 89:26"/>त्यसले मलाई यसो भनेर पुकार्नेछ, ‘तपाईं मेरा पिता, मेरा परमेश्‍वर, मेरो मुक्तिको चट्टान हुनुहुन्छ।’<verse eid="PSA 89:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 89:27"/>म त्यसलाई मेरो पहिले जन्मेको, जेठो छोरा हुन नियुक्त गर्नेछु, पृथ्वीका राजाहरूमा सबैभन्दा उच्‍च तुल्याउनेछु।<verse eid="PSA 89:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 89:28"/>म त्यसको निम्ति मेरो अचुक प्रेम सदासर्वदा कायम राख्नेछु, र त्यससँगको मेरो करार कहिल्यै विफल हुनेछैन।<verse eid="PSA 89:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 89:29"/>म त्यसको वंश सदाको निम्ति स्थापना गर्नेछु, आकाशको अस्तित्व रहेसम्म, त्यसको सिंहासन राख्नेछु।<verse eid="PSA 89:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 89:30"/>“त्यसका सन्तानले मेरो व्यवस्था त्यागे, र मेरा विधानहरू मानेनन् भने<verse eid="PSA 89:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 89:31"/>यदि तिनीहरूले मेरा उर्दीहरू भङ्ग गरे भने र मेरा आदेशहरू पालन गरेनन् भने,<verse eid="PSA 89:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 89:32"/>म तिनीहरूका पापको दण्ड छडीले, तिनीहरूका अधर्मको सजाय कोर्राले दिनेछु;<verse eid="PSA 89:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 89:33"/>तर म मेरो अचुक प्रेम त्यसबाट हटाउनेछैनँ, न त कहिल्यै म मेरो विश्‍वासयोग्यतालाई घात गर्नेछु।<verse eid="PSA 89:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 89:34"/>म मेरो करार भङ्ग गर्नेछैनँ, अथवा मेरो मुखले उच्‍चारण गरेका वचन बदल्नेछैनँ।<verse eid="PSA 89:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 89:35"/>मैले मेरो पवित्रताद्वारा एक पटक सधैँको निम्ति शपथ खाएको छु— र म दावीदलाई ढाँट्नेछैनँ।<verse eid="PSA 89:35"/></para>
<para style="p"><verse number="36" style="v" sid="PSA 89:36"/>त्यसको वंश सदासर्वदाको निम्ति रहनेछ र त्यसको सिंहासन मेरो अगि सूर्यझैँ स्थिर रहनेछ;<verse eid="PSA 89:36"/></para>
<para style="p"><verse number="37" style="v" sid="PSA 89:37"/>आकाशमा रहेको विश्‍वासयोग्य साक्षी चन्द्रमाझैँ, त्यो सदासर्वदाको लागि स्थापित रहनेछ।” सेला<verse eid="PSA 89:37"/></para>
<para style="p"><verse number="38" style="v" sid="PSA 89:38"/>तर तपाईंले आफ्नो अभिषिक्त जनलाई त्याग्नुभएको छ, र तुच्छ ठान्‍नुभएको छ; तिनीसँग तपाईं क्रोधित हुनुभएको छ।<verse eid="PSA 89:38"/></para>
<para style="p"><verse number="39" style="v" sid="PSA 89:39"/>तपाईंले आफ्नो सेवकसितको करार रद्द गर्नुभएको छ; तपाईंले तिनको मुकुट धुलोमा फ्याँकेर अशुद्ध पार्नुभएको छ।<verse eid="PSA 89:39"/></para>
<para style="p"><verse number="40" style="v" sid="PSA 89:40"/>तपाईंले तिनका सबै सुरक्षित पर्खालहरू भत्काइदिनुभएको छ; र तिनका किल्‍लाहरू तहसनहस पारिदिनुभएको छ।<verse eid="PSA 89:40"/></para>
<para style="p"><verse number="41" style="v" sid="PSA 89:41"/>त्यहाँबाट भएर जानेहरू सबैले तिनलाई लुटेका छन्; आफ्ना छिमेकीको निम्ति तिनी हेलाको पात्र भएका छन्।<verse eid="PSA 89:41"/></para>
<para style="p"><verse number="42" style="v" sid="PSA 89:42"/>तिनका वैरीहरूका दाहिने हात तपाईंले उच्‍च पार्नुभएको छ; तपाईंले तिनका सबै शत्रुहरूलाई आनन्दित तुल्याउनुभएको छ।<verse eid="PSA 89:42"/></para>
<para style="p"><verse number="43" style="v" sid="PSA 89:43"/>तपाईंले तिनको तरवारको धारलाई काम नलाग्ने बनाउनुभएको छ, र युद्धमा तिनलाई समर्थन गर्नुभएको छैन।<verse eid="PSA 89:43"/></para>
<para style="p"><verse number="44" style="v" sid="PSA 89:44"/>तपाईंले तिनको वैभव समाप्‍त गरिदिनुभएको छ, र तिनको सिंहासन जमिनमा पल्टाइदिनुभएको छ।<verse eid="PSA 89:44"/></para>
<para style="p"><verse number="45" style="v" sid="PSA 89:45"/>तिनको जवानीका दिन तपाईंले घटाइदिनुभएको छ; तपाईंले तिनलाई लाजको वस्त्रले ढाकिदिनुभएको छ। सेला<verse eid="PSA 89:45"/></para>
<para style="p"><verse number="46" style="v" sid="PSA 89:46"/>हे याहवेह, कहिलेसम्म यस्तो गर्नुहुन्छ? के तपाईं आफूलाई सधैँभरिको निम्ति लुकाइराख्नुहुनेछ? कहिलेसम्म तपाईंको क्रोध आगोझैँ दन्किरहनेछ?<verse eid="PSA 89:46"/></para>
<para style="p"><verse number="47" style="v" sid="PSA 89:47"/>स्मरण गर्नुहोस्; मेरो आयु कति क्षणिक छ। किनकि तपाईंले सम्पूर्ण मानवतालाई कस्तो निरर्थकताको निम्ति सृजनुभएको छ!<verse eid="PSA 89:47"/></para>
<para style="p"><verse number="48" style="v" sid="PSA 89:48"/>यस्तो कुन मानिस होला, जो सधैँभरि बाँचिरहन्छ र मृत्यु देख्दैन, अथवा चिहानको शक्तिबाट को उम्कन सक्छ र? सेला<verse eid="PSA 89:48"/></para>
<para style="p"><verse number="49" style="v" sid="PSA 89:49"/>हे प्रभु, तपाईंको अगिको अचुक प्रेम कहाँ छ? जसमा तपाईंले तपाईंको विश्‍वासयोग्यतामा दावीदसँग शपथ खानुभएको थियो?<verse eid="PSA 89:49"/></para>
<para style="p"><verse number="50" style="v" sid="PSA 89:50"/>हे प्रभु, स्मरण गर्नुहोस्; तपाईंको सेवकको कसरी उपहास भएको छ, म आफ्नो हृदयमा कसरी सबै राष्ट्रहरूको हाँसो बोकेर हिँड्दछु,<verse eid="PSA 89:50"/></para>
<para style="p"><verse number="51" style="v" sid="PSA 89:51"/>हे याहवेह, जसले मेरो उपहास गरेका छन्, ती तपाईंका शत्रुहरू हुन्, तिनीहरूले पाइला-पाइलामा कसरी तपाईंका अभिषिक्त जनको उपहास गरेका छन्।<verse eid="PSA 89:51"/></para>
<para style="p"><verse number="52" style="v" sid="PSA 89:52"/>सदासर्वदा याहवेहको प्रशंसा होस्! आमेन! आमेन!<verse eid="PSA 89:52"/></para>
<chapter eid="PSA 89"/>
<chapter number="90" style="c" sid="PSA 90"/>
<para style="p"><verse number="1" style="v" sid="PSA 90:1"/>परमेश्‍वरका जन मोशाको प्रार्थना। हे प्रभु, पुस्तौँ-पुस्तादेखि तपाईं हाम्रा वासस्थान हुनुभएको छ।<verse eid="PSA 90:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 90:2"/>पहाडहरू उत्पन्‍न हुनुभन्दा अगि, अथवा तपाईंले पृथ्वी र संसारलाई अस्तित्वमा ल्याउन अगि, अनादिदेखि अनन्तसम्म, तपाईं नै परमेश्‍वर हुनुहुन्छ।<verse eid="PSA 90:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 90:3"/>तपाईंले यसो भनेर मानिसलाई पुनः धुलोमा फर्काउनुहुन्छ, “ए मरणशील मानिस हो, धुलोमा फर्किजाओ!”<verse eid="PSA 90:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 90:4"/>तपाईंको दृष्‍टिमा एक हजार वर्ष अहिले बितिगएको एक दिनजस्तै, अथवा रातको एक पहरजस्तै छ।<verse eid="PSA 90:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 90:5"/>तापनि तपाईंले मानिसहरूलाई बाढीले लगेझैँ मृत्युको निद्रामा लैजानुहुन्छ— तिनीहरू बिहान पलाउने नयाँ घाँसजस्तै छन्:<verse eid="PSA 90:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 90:6"/>त्यो बिहान नयाँ भएर मौलाउँछ; तर बेलुकी त्यो सुक्छ र ओइलाउँछ।<verse eid="PSA 90:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 90:7"/>तपाईंको क्रोधले हामी नष्‍ट भएका छौँ, र तपाईंको क्रोधले हामी भयभीत हुन्छौँ।<verse eid="PSA 90:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 90:8"/>तपाईंले हाम्रा अधर्महरू तपाईंकै सामु राख्नुभएको छ, हाम्रा गुप्‍त पापहरू तपाईंका उपस्थितिको प्रकाशमा छन्।<verse eid="PSA 90:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 90:9"/>हाम्रा सारा दिनहरू तपाईंको क्रोधमुनि बित्दछन्; हामी आफ्ना वर्षहरू विलापमा बिताउँछौँ।<verse eid="PSA 90:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 90:10"/>हाम्रो आयु त सत्तरी वर्ष मात्र हो, अथवा बलले साथ दियो भने, असीसम्म; तापनि त्यसको उत्तम अवधि पनि कष्‍ट र शोकमा बित्छ; किनकि आयुचाहिँ चाँडै बितिजान्छ, र हामी उडिजान्छौँ।<verse eid="PSA 90:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 90:11"/>तपाईंको आक्रोशको शक्ति कसले बुझ्न सकेको छ र? किनकि तपाईंको क्रोध तपाईंलाई दिनुपर्ने भय जत्तिकै ठूलो छ।<verse eid="PSA 90:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 90:12"/>हामीलाई हाम्रा दिनहरू गन्‍न सिकाउनुहोस्, ताकि हामीले बुद्धिको हृदय प्राप्‍त गर्न सकौँ!<verse eid="PSA 90:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 90:13"/>हे याहवेह, दयालु बनिदिनुहोस्; कहिलेसम्म तपाईं ढिलो गर्नुहुन्छ? आफ्ना सेवकहरूमाथि दया गर्नुहोस्!<verse eid="PSA 90:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 90:14"/>हरेक बिहानले मेरो निम्ति तपाईंको अचुक प्रेमको वचन ल्याओस्, र हामी सारा जीवनभरि रमाएर गीत गाउन सकौँ र खुशी हुन सकौँ।<verse eid="PSA 90:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 90:15"/>जति दिन तपाईंले हामीलाई कष्‍ट दिनुभयो, र जति वर्ष दुःख भोग्यौँ, त्यहीअनुसार हामीलाई खुशी तुल्याउनुहोस्!<verse eid="PSA 90:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 90:16"/>तपाईंका कार्यहरू तपाईंका सेवकहरूलाई देखाइयोस्, तपाईंको वैभव तिनीहरूका छोराछोरीकहाँ प्रकट होस्!<verse eid="PSA 90:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 90:17"/>प्रभु हाम्रा परमेश्‍वरको निगाह हामीमाथि रहोस्; हाम्रा हातका काम हाम्रा निम्ति सुदृढ पारिऊन्— हो, हाम्रा हातका कामहरू सुदृढ पारिऊन्!<verse eid="PSA 90:17"/></para>
<chapter eid="PSA 90"/>
<chapter number="91" style="c" sid="PSA 91"/>
<para style="p"><verse number="1" style="v" sid="PSA 91:1"/>जो सर्वोच्‍च परमेश्‍वरको शरणमा बास गर्दछ, त्यो सर्वशक्तिमान्‌को छत्रछायामुनि सुरक्षित रहनेछ।<verse eid="PSA 91:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 91:2"/>म याहवेहको बारेमा भन्‍नेछु, “उहाँ मेरा शरणस्थान र किल्‍ला हुनुहुन्छ, मेरा परमेश्‍वर, उहाँमा नै म भरोसा राख्दछु।”<verse eid="PSA 91:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 91:3"/>निश्‍चय नै उहाँले तिमीलाई शिकारीको पासोबाट र घातक रूढीबाट बचाउनुहुनेछ।<verse eid="PSA 91:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 91:4"/>उहाँले आफ्ना प्वाँखहरूले तिमीलाई ढाक्नुहुनेछ; र उहाँको पखेटामुनि तिमीले शरण पाउनेछौ; उहाँको विश्‍वासयोग्यता तिम्रो ढाल र सुरक्षाको पर्खाल हुनेछ।<verse eid="PSA 91:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 91:5"/>तिमी रातको त्रासदेखि डराउनेछैनौ, न त दिउँसो उडेर आउने काँडदेखि नै डराउनेछौ,<verse eid="PSA 91:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 91:6"/>न अन्धकारमा फैलिने रूढीदेखि, न त मध्यदिनमा नाश पार्ने महामारीदेखि नै डराउनेछौ।<verse eid="PSA 91:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 91:7"/>तिम्रो नजिक एक हजार जना ढल्नेछन्, तिम्रो दाहिने हाततिर दश हजार; तर त्यो तिम्रो नजिक आउनेछैन।<verse eid="PSA 91:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 91:8"/>तिमीले आफ्ना आँखाले मात्र त्यो हेर्नेछौ, र दुष्‍टहरूको दण्ड देख्नेछौ।<verse eid="PSA 91:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 91:9"/>यदि तिमीले “याहवेह मेरो शरणस्थान हुनुहुन्छ भनी भन्यौ,” र सर्वोच्‍च परमेश्‍वरलाई आफ्नो वासस्थान बनायौ भने,<verse eid="PSA 91:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 91:10"/>तिम्रो कुनै अनिष्‍ट हुनेछैन, तिम्रो घरको नजिक कुनै विपत्ति आउनेछैन।<verse eid="PSA 91:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 91:11"/>किनकि उहाँले तिम्रो निम्ति आफ्ना स्वर्गदूतहरूलाई तिम्रा सबै मार्गमा रक्षा गर्नलाई आज्ञा दिनुहुनेछ;<verse eid="PSA 91:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 91:12"/>तिमीलाई तिनीहरूका हातहरूमा उचाल्नेछन्, ताकि तिम्रो खुट्टा ढुङ्गामाथि नबजारियोस्।<verse eid="PSA 91:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 91:13"/>तिमीले सिंह र गोमन सर्पलाई कुल्चनेछौ; जवान सिंह र सर्पलाई तिमीले पैतालामुनि कुल्चनेछौ।<verse eid="PSA 91:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 91:14"/>याहवेह भन्‍नुहुन्छ, “उसले मलाई प्रेम गरेको हुनाले, म उसलाई छुटाउनेछु; उसले मेरो नाम ग्रहण गरेको छ, यसकारण म उसको रक्षा गर्नेछु।<verse eid="PSA 91:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 91:15"/>उसले मलाई पुकार्नेछ, र म उसलाई उत्तर दिनेछु; उसका दुःखको घडीमा म उसँग रहनेछु; म उसलाई छुटकारा दिनेछु र आदर गर्नेछु।<verse eid="PSA 91:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 91:16"/>लामो आयु दिएर म उसलाई सन्तुष्‍ट पार्नेछु र म उसलाई मेरो मुक्ति देखाउनेछु।”<verse eid="PSA 91:16"/></para>
<chapter eid="PSA 91"/>
<chapter number="92" style="c" sid="PSA 92"/>
<para style="p"><verse number="1" style="v" sid="PSA 92:1"/>एउटा भजन; विश्राम दिनको निम्ति एउटा गीत। याहवेहको प्रशंसा गर्नु र हे सर्वोच्‍च परमेश्‍वर, तपाईंको नाममा धुन बजाउनु असल कुरा हो।<verse eid="PSA 92:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 92:2"/>बिहान तपाईंको अचुक प्रेमको र राति तपाईंको विश्‍वासयोग्यताको घोषणा गर्नु,<verse eid="PSA 92:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 92:3"/>दशतारे वीणाको सङ्गीतमा र सितारको मधुर लयमा तपाईंको स्तुति गर्नु असल कुरा हो।<verse eid="PSA 92:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 92:4"/>किनकि हे याहवेह, तपाईंले आफ्ना कामद्वारा मलाई आनन्दित पार्नुभएको छ; तपाईंका हातका कार्यहरू हेरेर म हर्षले गाउँछु।<verse eid="PSA 92:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 92:5"/>हे याहवेह, तपाईंका कार्यहरू कत्ति महान् छन्! तपाईंका विचारहरू कत्ति गहन छन्!<verse eid="PSA 92:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 92:6"/>विवेकहीन मानिसले यो जान्दैन, मूर्खले यो बुझ्न सक्दैन,<verse eid="PSA 92:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 92:7"/>यद्यपि दुष्‍टहरू घाँसजस्तै मौलाउँछन्, र सबै कुकर्मीहरूका फलिफाप पनि हुन्छ, तर परिणाम स्वरूप तिनीहरू सधैँका निम्ति नष्‍ट पारिनेछन्।<verse eid="PSA 92:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 92:8"/>तर तपाईं, हे याहवेह, सदासर्वदा उच्‍च हुनुहुन्छ।<verse eid="PSA 92:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 92:9"/>किनकि, हे याहवेह, तपाईंका शत्रुहरू, तपाईंका शत्रुहरू निश्‍चय नै नष्‍ट हुनेछन्; सबै कुकर्मीहरू तितरबितर हुनेछन्।<verse eid="PSA 92:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 92:10"/>तपाईंले जङ्गली साँढेको सिङजस्तै मेरो सिङ उच्‍च पार्नुभएको छ; उत्तम तेलले मेरो अभिषेक भएको छ।<verse eid="PSA 92:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 92:11"/>मेरा आँखाले मेरा विरोधीहरूको हार भएको देखेका छन्; मेरा कानले मेरा दुष्‍ट वैरीहरू लखेटिएका कुरा सुनेका छन्।<verse eid="PSA 92:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 92:12"/>धर्मीहरूचाहिँ खजूरको बोटझैँ फस्टाउनेछन्; तिनीहरू लेबनानका देवदारुजस्तै बढ्नेछन्;<verse eid="PSA 92:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 92:13"/>तिनीहरू याहवेहका भवनमा रोपिएका हुनेछन्, हाम्रा परमेश्‍वरका चोकहरूमा तिनीहरू मौलाउनेछन्।<verse eid="PSA 92:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 92:14"/>बुढेसकालमा पनि तिनीहरू फलदायी हुनेछन्; तिनीहरू ताजा र हरिया भइरहनेछन्,<verse eid="PSA 92:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 92:15"/>र यस्तो घोषणा गर्नेछन्, “याहवेह धर्मी हुनुहुन्छ; उहाँ मेरो चट्टान हुनुहुन्छ, र उहाँमा केही पनि दुष्‍टता छैन।”<verse eid="PSA 92:15"/></para>
<chapter eid="PSA 92"/>
<chapter number="93" style="c" sid="PSA 93"/>
<para style="p"><verse number="1" style="v" sid="PSA 93:1"/>याहवेहले राज्य गर्नुहुन्छ, उहाँ वैभवले आभूषित हुनुहुन्छ; याहवेह वैभवले आभूषित हुनुहुन्छ; र शक्तिले सुसज्जित हुनुहुन्छ; निश्‍चय नै संसार दृढ र सुरक्षित स्थापित गरिएको छ।<verse eid="PSA 93:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 93:2"/>अनादिदेखि तपाईंको सिंहासन स्थापित भएको छ; तपाईं अनन्तदेखि हुनुहुन्छ।<verse eid="PSA 93:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 93:3"/>हे याहवेह, समुद्रहरू उर्लिआएका छन्, समुद्रहरूले आफ्नो गर्जन उच्‍च पारेका छन्; तिनका भयानक छालहरू उर्लिएका छन्।<verse eid="PSA 93:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 93:4"/>महासमुद्रको गर्जनभन्दा शक्तिशाली, समुद्रका तरङ्गहरूभन्दा पनि शक्तिशाली— उच्‍चमा हुनुहुने याहवेह शक्तिशाली हुनुहुन्छ।<verse eid="PSA 93:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 93:5"/>हे याहवेह, तपाईंका कानुनहरू दृढ रहन्छन्; अनन्तकालको निम्ति तपाईंको भवन पवित्रताले सुसज्जित छ।<verse eid="PSA 93:5"/></para>
<chapter eid="PSA 93"/>
<chapter number="94" style="c" sid="PSA 94"/>
<para style="p"><verse number="1" style="v" sid="PSA 94:1"/>हे याहवेह, बदला लिनुहुने परमेश्‍वर, हे बदला लिनुहुने परमेश्‍वर, चम्कनुहोस्!<verse eid="PSA 94:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 94:2"/>हे पृथ्वीका न्यायाधीश, उठ्नुहोस्; अहङ्कारीहरूलाई तिनीहरूले पाउनुपर्ने प्रतिफल दिनुहोस्!<verse eid="PSA 94:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 94:3"/>हे याहवेह, कहिलेसम्म दुष्‍टहरू, आखिर कहिलेसम्म दुष्‍टहरू उल्‍लासित भइरहून्?<verse eid="PSA 94:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 94:4"/>तिनीहरू अहङ्कारले भरिएको कुरा गर्छन्; सबै कुकर्मीहरू घमण्डले भरिएका छन्।<verse eid="PSA 94:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 94:5"/>हे याहवेह, तिनीहरूले तपाईंका प्रजालाई कुल्चीमिल्ची पार्छन्; तपाईंका उत्तराधिकारीहरूमाथि अत्याचार गर्छन्।<verse eid="PSA 94:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 94:6"/>तिनीहरू विधवा र विदेशीहरूलाई मार्दछन्; अनाथहरूलाई हत्या गर्दछन्।<verse eid="PSA 94:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 94:7"/>तिनीहरू भन्छन्, “याहवेहले देख्नुहुन्‍न; याकोबका परमेश्‍वरले चाल पाउनुहुन्‍न।”<verse eid="PSA 94:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 94:8"/>मानिसहरूका माझमा ए विवेकहीनहरूहो; केही त विचार गर, ए मूर्खहरू हो, तिमीहरू कहिले बुद्धिमान् हुन्छौ?<verse eid="PSA 94:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 94:9"/>जसले कान दिनुभयो के उहाँले सुन्‍नुहुन्‍न र? जसले आँखा बनाउनुभयो के उहाँले देख्नुहुन्‍न र?<verse eid="PSA 94:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 94:10"/>के राष्ट्रहरूलाई अनुशासन गर्नुहुनेले दण्ड दिनुहुन्‍न र? के मानव-जातिलाई शिक्षा दिनुहुनेलाई ज्ञानको अभाव हुन्छ र?<verse eid="PSA 94:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 94:11"/>याहवेहले मानिसका सबै योजनाहरू जान्‍नुहुन्छ; ती व्यर्थ हुन्, भनी उहाँ जान्‍नुहुन्छ।<verse eid="PSA 94:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 94:12"/>हे याहवेह, त्यो धन्यको हो, जसलाई तपाईंले अनुशासनमा राख्नुहुन्छ, जसलाई आफ्नो व्यवस्थाबाट सिकाउनुहुन्छ;<verse eid="PSA 94:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 94:13"/>दुष्‍टहरूका निम्ति खाडल नखनिएसम्म तपाईंले त्यसलाई कष्‍टका दिनमा आराम दिनुहुनेछ,<verse eid="PSA 94:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 94:14"/>किनकि याहवेहले आफ्ना प्रजालाई तिरस्कार गर्नुहुनेछैन। उहाँले आफ्ना उत्तराधिकारीहरूलाई त्याग्नुहुनेछैन।<verse eid="PSA 94:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 94:15"/>न्याय फेरि धार्मिकतामा स्थापित गरिनेछ, र सबै सोझो हृदय भएकाहरू त्यसको पछि लाग्नेछन्।<verse eid="PSA 94:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 94:16"/>दुष्‍टहरूका विरुद्धमा मसँग को उठ्नेछ? कुकर्मीहरूका विरुद्ध मेरो पक्षमा को खडा हुनेछ?<verse eid="PSA 94:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 94:17"/>याहवेहले मलाई सहायता नगर्नुभएको भए, म चाँडै मृत्युको शून्यतामा बास गर्न पुग्नेथिएँ।<verse eid="PSA 94:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 94:18"/>जब मैले भनेँ, “मेरो खुट्टा चिप्लँदैछ” तब हे याहवेह, तपाईंको अचुक प्रेमले मलाई थाम्यो।<verse eid="PSA 94:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 94:19"/>जब मेरो मनमा ज्यादै चिन्ता-फिक्री भयो, तब तपाईंको सान्त्वनाले मलाई आनन्दित तुल्यायो।<verse eid="PSA 94:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 94:20"/>के भ्रष्‍ट शासकहरू तपाईंसँग मिल्न सक्छन्, जसले आफ्ना उर्दीद्वारा विपत्ति ल्याउँछन्?<verse eid="PSA 94:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 94:21"/>तिनीहरू धर्मीहरूका विरुद्ध एकजुट हुन्छन्, र निर्दोषमाथि मृत्युदण्डको आज्ञा गर्छन्।<verse eid="PSA 94:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 94:22"/>तर याहवेह मेरो किल्‍ला हुनुभएको छ, र परमेश्‍वर मेरो चट्टान हुनुहुन्छ, जसमा म शरण लिन्छु।<verse eid="PSA 94:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 94:23"/>उहाँले तिनीहरूका पाप तिनीहरूमाथि नै खन्याइदिनुहुनेछ, र तिनीहरूका दुष्‍टताको लागि तिनीहरूलाई नाश गर्नुहुनेछ; याहवेह हाम्रा परमेश्‍वरले तिनीहरूलाई नाश गर्नुहुनेछ।<verse eid="PSA 94:23"/></para>
<chapter eid="PSA 94"/>
<chapter number="95" style="c" sid="PSA 95"/>
<para style="p"><verse number="1" style="v" sid="PSA 95:1"/>आओ, हामी याहवेहको निम्ति आनन्दले गाऔँ; हाम्रा मुक्तिका चट्टानको निम्ति उच्‍च सोरले जयजयकार गरौँ!<verse eid="PSA 95:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 95:2"/>धन्यवाद चढाउँदै उहाँको सामु आऔँ, भजन र सङ्गीतले उहाँको प्रशंसा गरौँ!<verse eid="PSA 95:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 95:3"/>किनकि याहवेह महान् परमेश्‍वर हुनुहुन्छ, सबै देवहरूमाथि महान् राजा।<verse eid="PSA 95:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 95:4"/>पृथ्वीका गहिराइहरू उहाँको हातमा छ; र पर्वतका चुचुराहरू उहाँकै हुन्।<verse eid="PSA 95:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 95:5"/>समुद्र उहाँकै हो, किनकि त्यो उहाँले नै बनाउनुभएको हो, र सुक्खा जमिन उहाँकै हातद्वारा बनिए।<verse eid="PSA 95:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 95:6"/>आओ, हामी उहाँलाई दण्डवत् गरौँ र आराधना गरौँ; याहवेह हाम्रा सृष्‍टिकर्ताको अगि घुँडा टेकौँ;<verse eid="PSA 95:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 95:7"/>किनकि उहाँ नै हाम्रा परमेश्‍वर हुनुहुन्छ; अनि हामी उहाँको खर्कका प्रजा र उहाँको रेख-देखमा रहेको बगाल हौँ। यदि आज तिमीहरूले उहाँको सोर सुन्यौ भने,<verse eid="PSA 95:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 95:8"/>“तिमीहरूले मेरीबामा गरेजस्तो आफ्नो हृदय कठोर नपार; जस्तो तिमीहरूले त्यस दिन मरुभूमिमा भएको मस्सामा गरेका थियौ,<verse eid="PSA 95:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 95:9"/>जहाँ तिमीहरूका पुर्खाहरूले मलाई परीक्षा गरे; तिनीहरूले मेरो काम देख्दादेख्दै पनि मेरो जाँच गरेका थिए।<verse eid="PSA 95:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 95:10"/>चालीस वर्षसम्म म त्यस पुस्तासँग रिसाएँ, र मैले भनेँ, ‘यी यस्ता मानिसहरू हुन्, जसका हृदय बरालिएर जान्छन्, र तिनीहरूले मेरा मार्गहरू चिनेका छैनन्।’<verse eid="PSA 95:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 95:11"/>यसकारण मैले आफ्नो क्रोधमा शपथ खाएर घोषणा गरेँ, ‘तिनीहरू कहिल्यै पनि मेरो विश्राममा पस्‍नेछैनन्।’ ”<verse eid="PSA 95:11"/></para>
<chapter eid="PSA 95"/>
<chapter number="96" style="c" sid="PSA 96"/>
<para style="p"><verse number="1" style="v" sid="PSA 96:1"/>याहवेहको निम्ति एउटा नयाँ गीत गाओ; सारा पृथ्वीले याहवेहको निम्ति गाओ!<verse eid="PSA 96:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 96:2"/>याहवेहको निम्ति गाओ, उहाँका नामको प्रशंसा गर; प्रत्येक दिन उहाँले दिनुभएको मुक्तिको घोषणा गर!<verse eid="PSA 96:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 96:3"/>जाति-जातिहरूका बीच उहाँका महिमाको घोषणा गर, सारा मानिसहरूका बीचमा उहाँका अचम्मका कामहरूको वर्णन गर!<verse eid="PSA 96:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 96:4"/>किनकि याहवेह महान् हुनुहुन्छ, र अति उच्‍च प्रशंसाको योग्य हुनुहुन्छ; सारा देवहरूभन्दा उहाँको भय मान्‍नुपर्छ।<verse eid="PSA 96:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 96:5"/>किनकि जाति-जातिहरूका सबै देवहरू केवल मूर्तिहरू मात्र हुन्, तर याहवेहले त स्वर्गहरू सृष्‍टि गर्नुभयो।<verse eid="PSA 96:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 96:6"/>उहाँको सामु गौरव र वैभव छन्; उहाँका पवित्रस्थानमा शक्ति र महिमा छन्।<verse eid="PSA 96:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 96:7"/>हे जाति-जातिहरूका परिवार हो, याहवेहलाई जान, याहवेहलाई महिमा र शक्तिको प्रशंसा चढाओ!<verse eid="PSA 96:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 96:8"/>याहवेहलाई उहाँको नाम सुहाउँदो महिमा देओ; भेटी लिएर उहाँका मन्दिरका चोकहरूमा आओ!<verse eid="PSA 96:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 96:9"/>उहाँका पवित्रताको वैभवमा याहवेहलाई आराधना गर; हे सारा पृथ्वी, उहाँको सामु थरथर काम।<verse eid="PSA 96:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 96:10"/>जाति-जातिहरूका बीचमा घोषणा गर, “याहवेहले राज्य गर्नुहुन्छ।” संसार स्थिर रूपले स्थापित भएको छ, त्यो डगमगाउनेछैन; उहाँले निष्पक्षसाथ मानिसहरूको न्याय गर्नुहुन्छ।<verse eid="PSA 96:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 96:11"/>आकाश आनन्दित होस्, र पृथ्वी रमाओस्; समुद्र र त्यसमा भएका सबै हर्षले गुञ्जायमान होऊन्!<verse eid="PSA 96:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 96:12"/>खेत र त्यसमा भएका सबै कुरा उल्‍लासित होऊन्; जङ्गलका सारा रूखहरू आनन्दले गाऊन्।<verse eid="PSA 96:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 96:13"/>सबै सृष्‍टिले याहवेहको सामु गाऊन्, किनकि उहाँ आउनुहुन्छ; उहाँ पृथ्वीको न्याय गर्न आउनुहुन्छ। उहाँले धार्मिकतामा संसारको न्याय गर्नुहुनेछ, र आफ्नो विश्‍वसतासाथ मानिसहरूको न्याय गर्नुहुनेछ।<verse eid="PSA 96:13"/></para>
<chapter eid="PSA 96"/>
<chapter number="97" style="c" sid="PSA 97"/>
<para style="p"><verse number="1" style="v" sid="PSA 97:1"/>याहवेहले राज्य गर्नुहुन्छ, पृथ्वी रमाओस्; टाढाका समुद्री तटहरू पनि आनन्दित होऊन्।<verse eid="PSA 97:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 97:2"/>उहाँको वरिपरि बादल र बाक्लो अन्धकार छाएको छ; धार्मिकता र न्याय उहाँका सिंहासनका जग हुन्।<verse eid="PSA 97:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 97:3"/>आगो उहाँको अगि-अगि जान्छ, र उहाँका वरिपरि रहेका वैरीहरूलाई भस्म पार्छ।<verse eid="PSA 97:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 97:4"/>उहाँका बिजुलीले संसारलाई उज्यालो पार्दछ; पृथ्वीले यो देख्दछ, र थरथरी काम्दछ।<verse eid="PSA 97:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 97:5"/>याहवेहको सामु, पर्वतहरू मैनझैँ पग्लन्छन्, उहाँको सामु, जो सारा पृथ्वीका प्रभु हुनुहुन्छ।<verse eid="PSA 97:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 97:6"/>स्वर्गले उहाँका धार्मिकताको घोषणा गर्दछ, र समस्त जातिहरूले उहाँका महिमा देख्नेछन्।<verse eid="PSA 97:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 97:7"/>मूर्तिहरूलाई आराधना गर्नेहरू, र मूर्तिहरूमा घमण्ड गर्नेहरू, सबै जना शर्ममा पर्नेछन्; हे सबै देवताहरू हो, तिमीहरूले याहवेहको आराधना गर!<verse eid="PSA 97:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 97:8"/>तपाईंकै न्यायको कारण हे याहवेह, सियोनले सुन्छ र आनन्दित हुन्छ; र यहूदाका गाउँहरू हर्षित हुन्छन्।<verse eid="PSA 97:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 97:9"/>किनकि हे याहवेह, तपाईं सारा पृथ्वीभन्दा सर्वोच्‍च परमेश्‍वर हुनुहुन्छ; तपाईं सबै देवताहरूभन्दा अति उच्‍च हुनुहुन्छ।<verse eid="PSA 97:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 97:10"/>याहवेहलाई प्रेम गर्नेहरू सबैले दुष्‍टतालाई घृणा गरून्; किनकि उहाँले आफ्ना भक्तहरूको प्राणको रक्षा गर्नुहुन्छ र तिनीहरूलाई दुष्‍टहरूको हातबाट छुटाउनुहुन्छ।<verse eid="PSA 97:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 97:11"/>धर्मीहरूमाथि ज्योति प्रकाशमान् हुन्छ र सोझो मन भएकाहरूमाथि आनन्द छाउँछ।<verse eid="PSA 97:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 97:12"/>हे धर्मीहरू हो, याहवेहमा रमाहट गर; र उहाँका पवित्र नामको प्रशंसा गर!<verse eid="PSA 97:12"/></para>
<chapter eid="PSA 97"/>
<chapter number="98" style="c" sid="PSA 98"/>
<para style="p"><verse number="1" style="v" sid="PSA 98:1"/>एउटा भजन। याहवेहको निम्ति एउटा नयाँ गीत गाओ; किनकि उहाँले अद्‌भुत कार्य गर्नुभएको छ; उहाँका दाहिने हात र पवित्र पाखुराले उहाँको निम्ति विजयका कामहरू गरेका छन्।<verse eid="PSA 98:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 98:2"/>याहवेहले आफ्नो मुक्तिको घोषणा गर्नुभएको छ; र उहाँले आफ्नो धार्मिकता जाति-जातिहरूमा प्रकट गर्नुभएको छ।<verse eid="PSA 98:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 98:3"/>उहाँले इस्राएलका घरानाप्रतिको आफ्नो अचुक प्रेम, र उहाँको विश्‍वासयोग्यता स्मरण गर्नुभएको छ; पृथ्वीका सम्पूर्ण सिमानाहरूले हाम्रा परमेश्‍वरका मुक्तिलाई देखेका छन्।<verse eid="PSA 98:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 98:4"/>हे सारा पृथ्वी, आनन्दसाथ उच्‍च सोरले याहवेहको जयजयकार गर; सङ्गीतद्वारा उहाँको जयको घोषणा गर;<verse eid="PSA 98:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 98:5"/>वीणा बजाएर याहवेहको भजन गाओ! वीणा र सुमधुर गीतकासाथ,<verse eid="PSA 98:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 98:6"/>तुरहीहरू र भेडाका सिङ फुकेर, राजा याहवेहको सामु आनन्दले जयजयकार गर!<verse eid="PSA 98:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 98:7"/>समुद्र र त्यसमा भएका सबै थोकले, संसार, र त्यहाँ बास गर्ने सबैले गुञ्जायमान गरून्।<verse eid="PSA 98:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 98:8"/>नदीहरूका तरङ्गहरूले ताली बजाऊन्; पर्वतहरूले एकसाथ आनन्दले गाऊन्;<verse eid="PSA 98:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 98:9"/>तिनीहरूले याहवेहको सामु गाऊन्; किनकि, उहाँ पृथ्वीको न्याय गर्न आउनुहुन्छ। उहाँले संसारलाई धार्मिकताकोसाथ र जातिहरूलाई निष्पक्षतासाथ न्याय गर्नुहुनेछ।<verse eid="PSA 98:9"/></para>
<chapter eid="PSA 98"/>
<chapter number="99" style="c" sid="PSA 99"/>
<para style="p"><verse number="1" style="v" sid="PSA 99:1"/>याहवेहले राज्य गर्नुहुन्छ; राष्ट्रहरू थरथर कामून्; उहाँ करूबहरूका बीचमा विराजमान हुनुहुन्छ; पृथ्वी हल्‍लियोस्!<verse eid="PSA 99:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 99:2"/>सियोनमा याहवेह महान् हुनुहुन्छ; उहाँ सबै राष्ट्रहरूमाथि सर्वोच्‍च हुनुहुन्छ।<verse eid="PSA 99:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 99:3"/>तिनीहरूले तपाईंको महान् र भययोग्य नामको प्रशंसा गरून्— उहाँ पवित्र हुनुहुन्छ।<verse eid="PSA 99:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 99:4"/>राजा सर्वशक्तिमान् हुनुहुन्छ, उहाँले न्यायलाई मन पराउनुहुन्छ— तपाईंले निष्पक्षता स्थापना गर्नुभएको छ; तपाईंले याकोबमा न्याय र धार्मिकता सम्पन्‍न गर्नुभएको छ।<verse eid="PSA 99:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 99:5"/>याहवेह हाम्रा परमेश्‍वरलाई उच्‍च पार, र उहाँको पाउदानमा आराधना गर; उहाँ पवित्र हुनुहुन्छ।<verse eid="PSA 99:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 99:6"/>उहाँका पुजारीहरूमध्ये मोशा र हारून थिए, र शमूएल उहाँका नाम पुकार गर्नेहरू मध्येका एक थिए; तिनीहरूले याहवेहलाई पुकारे, र उहाँले तिनीहरूलाई जवाफ दिनुभयो।<verse eid="PSA 99:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 99:7"/>उहाँले बादलको खाँबोबाट तिनीहरूसँग बोल्नुभयो; उहाँले तिनीहरूलाई दिनुभएका विधान र उर्दीहरूको तिनीहरूले पालन गरे।<verse eid="PSA 99:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 99:8"/>हे याहवेह, हाम्रा परमेश्‍वर, तपाईंले तिनीहरूलाई जवाफ दिनुभयो; तपाईं इस्राएलीहरूका निम्ति क्षमाशील परमेश्‍वर हुनुहुन्थ्यो, यद्यपि तपाईंले तिनीहरूका दुष्कर्महरूलाई दण्ड दिनुभयो।<verse eid="PSA 99:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 99:9"/>याहवेह, हाम्रा परमेश्‍वरलाई उच्‍च पार, र उहाँको पवित्र पर्वतमा आराधना गर; किनकि याहवेह हाम्रा परमेश्‍वर पवित्र हुनुहुन्छ।<verse eid="PSA 99:9"/></para>
<chapter eid="PSA 99"/>
<chapter number="100" style="c" sid="PSA 100"/>
<para style="p"><verse number="1" style="v" sid="PSA 100:1"/>प्रशंसाको भजन। हे सारा पृथ्वी, आनन्दको निम्ति याहवेहको जयजयकार गर!<verse eid="PSA 100:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 100:2"/>हर्षकासाथ याहवेहको आराधना गर; आनन्दका गीतहरू गाउँदै उहाँको सामु आओ!<verse eid="PSA 100:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 100:3"/>याहवेह नै परमेश्‍वर हुनुहुन्छ भनी जान। उहाँले हामीलाई बनाउनुभयो, र हामी उहाँकै हौँ; हामी उहाँका प्रजा, र उहाँका खर्कका भेडाहरू हौँ।<verse eid="PSA 100:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 100:4"/>धन्यवादसाथ उहाँका मूलढोकाहरूभित्र पस; र प्रशंसा गर्दै उहाँका चोकहरूमा प्रवेश गर; उहाँलाई धन्यवाद देओ, र उहाँको नामको प्रशंसा गर!<verse eid="PSA 100:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 100:5"/>किनकि याहवेह भलो हुनुहुन्छ, र उहाँको अचुक प्रेम सधैँभरि रहिरहन्छ; उहाँको विश्‍वासयोग्यता सबै पुस्ताहरूमा रहिरहन्छ।<verse eid="PSA 100:5"/></para>
<chapter eid="PSA 100"/>
<chapter number="101" style="c" sid="PSA 101"/>
<para style="p"><verse number="1" style="v" sid="PSA 101:1"/>दावीदको भजन। म तपाईंको अचुक प्रेम र न्यायको गीत गाउनेछु; हे याहवेह, म तपाईंको प्रशंसा गाउनेछु।<verse eid="PSA 101:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 101:2"/>म निर्दोष जीवन बिताउनलाई होसियार रहनेछु, तपाईं मकहाँ कहिले आउनुहुनेछ? म निर्दोष हृदय लिएर आफ्नो घरको कामकाज गर्नेछु।<verse eid="PSA 101:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 101:3"/>म आफ्नो आँखाहरू अगि कुनै पनि अनुचित कुराहरू राख्नेछैनँ। पथभ्रष्‍ट भएकाहरूका कामलाई म घृणा गर्छु; यसमा मेरो कुनै सरोकार हुनेछैन।<verse eid="PSA 101:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 101:4"/>कुटिल हृदय भएकाहरू मबाट टाढा रहनेछन्; दुष्‍टसँग मेरो कुनै सरोकार रहनेछैन।<verse eid="PSA 101:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 101:5"/>जसले गुप्‍तमा आफ्ना छिमेकीको निन्दा गर्दछ, म त्यसलाई नाश गर्नेछु; अहङ्कारी दृष्‍टि भएका र घमण्डी हृदय भएकालाई, म सहनेछैनँ।<verse eid="PSA 101:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 101:6"/>देशका विश्‍वासयोग्य जनहरूमाथि म मेरो नजर राख्नेछु; ताकि तिनीहरू मसित बास गरून्; त्यो, जसको चालचलन निर्दोष छ, उसले नै मेरो सेवा गर्नेछ।<verse eid="PSA 101:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 101:7"/>छली काम गर्ने कसैले पनि मेरो घरमा बास पाउनेछैन; झूटो बोल्ने कोही पनि मेरो उपस्थितिमा खडा हुनेछैन।<verse eid="PSA 101:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 101:8"/>हरेक बिहान म देशका दुष्‍ट काम गर्नेहरू सबैलाई नाश पार्नेछु; याहवेहको सहरबाट म हरेक दुष्कर्मीलाई नष्‍ट पार्नेछु।<verse eid="PSA 101:8"/></para>
<chapter eid="PSA 101"/>
<chapter number="102" style="c" sid="PSA 102"/>
<para style="p"><verse number="1" style="v" sid="PSA 102:1"/>विपत्तिमा परेको मानिसले याहवेहको सामु वर्णन गरेको विलाप। हे याहवेह, मेरो प्रार्थना सुन्‍नुहोस्; सहायताको निम्ति मेरो पुकार तपाईंका सामु पुगोस्!<verse eid="PSA 102:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 102:2"/>मेरो कष्‍टको समयमा आफ्नो मुहार मबाट नलुकाउनुहोस्; तपाईंको कान मतिर लगाउनुहोस्; जब म पुकार गर्दछु, मलाई तुरुन्तै जवाफ दिनुहोस्!<verse eid="PSA 102:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 102:3"/>किनकि मेरा दिनहरू धुवाँझैँ लोप भएर जान्छन्; मेरा हाडहरू सल्केका भुङ्ग्रोझैँ जल्दछन्।<verse eid="PSA 102:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 102:4"/>मेरो हृदय घाँसझैँ ओइलाएर सुकेको छ; म आफ्नो भोजन खान पनि बिर्सन्छु।<verse eid="PSA 102:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 102:5"/>मेरो पीडामा म चर्को सोरले कराएको कारण, म हाड र छाला भएको छु।<verse eid="PSA 102:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 102:6"/>म उजाडस्थानको उल्‍लुझैँ भएको छु; भग्नावशेषमा बस्‍ने उल्‍लुझैँ छु।<verse eid="PSA 102:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 102:7"/>अनिद्राले गर्दा म जागा रहन्छु; म छानामाथिको एकलो चरोझैँ भएको छु।<verse eid="PSA 102:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 102:8"/>दिनभरि मेरा शत्रुहरूले मेरो गिल्‍ला गर्छन्; मेरो खिल्‍ली उडाउनेहरूले मेरो नाम सरापको रूपमा प्रयोग गर्छन्।<verse eid="PSA 102:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 102:9"/>किनकि म खरानीलाई भोजनको रूपमा खान्छु, र म आफ्नो आँसु मिसिएको पानी पिउँछु;<verse eid="PSA 102:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 102:10"/>किनकि तपाईंको ठूलो क्रोधले गर्दा, तपाईंले मलाई उठाएर एकापट्टि फाल्नुभएको छ।<verse eid="PSA 102:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 102:11"/>मेरा दिनहरू साँझको छायाजस्तै बित्दछन्; म घाँसझैँ ओइलाएको छु।<verse eid="PSA 102:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 102:12"/>तर तपाईं, हे याहवेह, सदाको निम्ति विराजमान हुनुहुन्छ; तपाईंको कीर्ति पुस्तौँ-पुस्तासम्म रहिरहन्छ।<verse eid="PSA 102:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 102:13"/>तपाईं उठ्नुहुनेछ र सियोनमाथि कृपा गर्नुहुनेछ; किनकि सियोनमाथि दया गर्ने समय अहिले नै हो; अब तोकिएको त्यो समय आइपुगेको छ।<verse eid="PSA 102:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 102:14"/>किनकि तपाईंका सेवकहरूलाई त्यहाँका ढुङ्गाहरू अति प्रिय छन्; त्यहाँको धुलोले समेत तिनीहरूलाई दया देखाउँछन्।<verse eid="PSA 102:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 102:15"/>जाति-जातिहरूले याहवेहको नामको भय मान्‍नेछन्, पृथ्वीका सबै राजाहरूले तपाईंको महिमाको आदर गर्नेछन्।<verse eid="PSA 102:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 102:16"/>किनकि याहवेहले सियोनलाई पुनर्निर्माण गर्नुहुनेछ, र उहाँ आफ्नो महिमामा प्रकट हुनुहुनेछ।<verse eid="PSA 102:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 102:17"/>उहाँले बेसहाराका प्रार्थनाप्रति ध्यान दिनुहुनेछ; उहाँले तिनीहरूका बिन्तीलाई तुच्छ ठान्‍नुहुनेछैन।<verse eid="PSA 102:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 102:18"/>यी कुरा भावी पुस्ताको निम्ति लेखियोस्: ताकि अहिलेसम्म सृष्‍टि नगरिएका मानिसहरूले समेत याहवेहको प्रशंसा गरून्:<verse eid="PSA 102:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 102:19"/>यसरी उहाँले कैदीहरूका क्रन्दन सुन्‍न, र मृत्युदण्ड पाएकाहरूलाई मुक्त गर्न, उच्‍च स्थानमा रहेको आफ्नो पवित्रस्थानबाट हेर्नुभयो; स्वर्गबाट तल पृथ्वीमाथि दृष्‍टि गर्नुभयो।<verse eid="PSA 102:19"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 102:21"/>त्यस बेला, जब याहवेहको आराधना गर्नलाई जाति-जातिहरू र राज्यहरू एकत्रित हुनेछन्। यसकारण सियोनमा याहवेहको नामको र यरूशलेममा उहाँको प्रशंसा घोषणा गरिनेछ।<verse eid="PSA 102:21"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 102:23"/>मेरो जीवनकालमा, उहाँले मेरो बल तोडिदिनुभयो; र मेरा दिनहरू घटाइदिनुभयो।<verse eid="PSA 102:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 102:24"/>त्यसैले मैले भनेँ: “हे मेरा परमेश्‍वर, मेरो आधा उमेरमा नै मलाई उठाइ नलैजानुहोस्; तपाईंका वर्षहरू त पुस्तौँ-पुस्तासम्म रहिरहन्छन्।<verse eid="PSA 102:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 102:25"/>सुरुमा तपाईंले पृथ्वीको जग बसाल्नुभयो; र स्वर्ग तपाईंकै हातका काम हुन्।<verse eid="PSA 102:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 102:26"/>तिनीहरू नाश भएर जानेछन्, तर तपाईंचाहिँ रहिरहनुहुन्छ; तिनीहरू कपडाझैँ सबै फाटेर जानेछन्। लुगा फेरेझैँ तपाईंले तिनलाई फेर्नुहुनेछ, र ती फालिनेछन्।<verse eid="PSA 102:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 102:27"/>तर तपाईंचाहिँ एकनास रहनुहुन्छ, तपाईंका वर्षहरूको अन्त्य कहिल्यै हुनेछैन।<verse eid="PSA 102:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 102:28"/>तपाईंका सेवकहरूका सन्तान तपाईंको उपस्थितिमा बास गर्नेछन्; तिनीहरूका सन्तान तपाईंको सामु स्थिर रहनेछन्।”<verse eid="PSA 102:28"/></para>
<chapter eid="PSA 102"/>
<chapter number="103" style="c" sid="PSA 103"/>
<para style="p"><verse number="1" style="v" sid="PSA 103:1"/>दावीदको गीत। ए मेरो प्राण, याहवेहको प्रशंसा गर्; ए मेरो सारा अन्तस्करण, उहाँको पवित्र नामको प्रशंसा गर्!<verse eid="PSA 103:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 103:2"/>ए मेरो प्राण, याहवेहको प्रशंसा गर्, र उहाँका सबै उपकारहरू नबिर्सी—<verse eid="PSA 103:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 103:3"/>जसले तेरा सबै पापहरू क्षमा गर्नुहुन्छ; र जसले तेरा सबै रोगहरू निको पार्नुहुन्छ;<verse eid="PSA 103:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 103:4"/>जसले तेरो जीवनलाई चिहानबाट छुटाउनुहुन्छ; र तँलाई प्रेम र करुणासहितको मुकुट लगाइदिनुहुन्छ;<verse eid="PSA 103:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 103:5"/>जसले तेरो जीवनलाई उत्तम कुराहरूले तृप्‍त गरिदिनुहुन्छ; ताकि तेरो जवानी चीलको जस्तै नयाँ होस्।<verse eid="PSA 103:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 103:6"/>थिचोमिचोमा परेकाहरू सबैका निम्ति याहवेहले धार्मिकता र न्यायको काम गर्नुहुन्छ।<verse eid="PSA 103:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 103:7"/>उहाँले आफ्नो मार्ग मोशालाई, आफ्नो काम इस्राएलीहरूलाई प्रकट गर्नुभयो:<verse eid="PSA 103:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 103:8"/>याहवेह कृपालु र अनुग्रही हुनुहुन्छ, रिसाउनमा ढिलो र प्रेमले भरिपूर्ण।<verse eid="PSA 103:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 103:9"/>उहाँले सधैँ दोष लगाइरहनुहुन्‍न, न त आफ्नो क्रोध सदासर्वदा लिइरहनुहुन्छ;<verse eid="PSA 103:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 103:10"/>उहाँले हामीसित हाम्रा पापअनुसारको व्यवहार गर्नुहुन्‍न, न त हाम्रा अधर्मअनुसार हामीलाई बदला लिनुहुन्छ।<verse eid="PSA 103:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 103:11"/>किनकि पृथ्वीबाट स्वर्ग जति उच्‍च छ, उहाँका डर मान्‍नेहरूमाथि उहाँको अचुक प्रेम त्यत्ति नै महान् छ।<verse eid="PSA 103:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 103:12"/>पश्‍चिमबाट पूर्व जति टाढा छ, उहाँले हाम्रा अपराधहरू हामीबाट त्यति नै टाढा हटाइदिनुभएको छ।<verse eid="PSA 103:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 103:13"/>जसरी बुबाले आफ्ना छोराछोरीहरूलाई टिठ्याउँछन्, त्यसरी नै याहवेहले उहाँको भय मान्‍नेहरूलाई टिठ्याउनुभएको छ;<verse eid="PSA 103:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 103:14"/>किनकि उहाँले हाम्रो बनावट जान्‍नुहुन्छ, हामी धुलो मात्र हौँ भनी उहाँ सम्झनुहुन्छ।<verse eid="PSA 103:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 103:15"/>मानिसको आयु घाँसजस्तो छ, मैदानका फूलझैँ त्यो ढकमक्‍क फुल्दछ;<verse eid="PSA 103:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 103:16"/>अनि बतास त्यस फूलमाथि भएर जाँदा त्यो विलाएर जान्छ; र त्यसको ठाउँले पनि त्यसको याद गर्दैन।<verse eid="PSA 103:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 103:17"/>तर याहवेहको अचुक प्रेम, उहाँको भय मान्‍नेहरूमाथि अनन्तदेखि अनन्तसम्म रहिरहन्छ र उहाँको धार्मिकता तिनीहरूका सन्तानहरूका सन्तानहरूमाथि रहन्छ—<verse eid="PSA 103:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 103:18"/>तिनीहरूमाथि जस-जसले उहाँको करार पालन गर्दछन्, र उहाँका विधिहरू स्मरण गरेर त्यसअनुसार चल्दछन्।<verse eid="PSA 103:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 103:19"/>याहवेहले आफ्नो सिंहासन स्वर्गमा स्थापित गर्नुभएको छ; र उहाँको प्रभुत्वले सबैमाथि शासन गर्दछ।<verse eid="PSA 103:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 103:20"/>हे उहाँका शक्तिशाली स्वर्गदूतहरू हो, उहाँका आदेश सुनेर उहाँका योजना पूरा गर्नेहरू हो, याहवेहको प्रशंसा गर!<verse eid="PSA 103:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 103:21"/>हे उहाँका सारा स्वर्गीय सेनाहरू हो, उहाँको इच्छाअनुसार काम गर्ने सेवकहरू हो, याहवेहको प्रशंसा गर।<verse eid="PSA 103:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 103:22"/>हे याहवेहका सारा सृष्‍टि हो, उहाँका सबै राज्यमा रहेकाहरू हो, उहाँको प्रशंसा गर! हे मेरो प्राण, याहवेहको प्रशंसा गर्!<verse eid="PSA 103:22"/></para>
<chapter eid="PSA 103"/>
<chapter number="104" style="c" sid="PSA 104"/>
<para style="p"><verse number="1" style="v" sid="PSA 104:1"/>हे मेरो प्राण, याहवेहको प्रशंसा गर्! हे याहवेह, मेरा परमेश्‍वर, तपाईं अति महान् हुनुहुन्छ; तपाईंले वैभव र प्रतापको पोशाक पहिरनुभएको छ।<verse eid="PSA 104:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 104:2"/>पोशाक पहिरेझैँ उहाँले आफूलाई ज्योतिले ढाक्नुभएको छ; उहाँले आकाशलाई पालझैँ तन्काउनुभएको छ;<verse eid="PSA 104:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 104:3"/>उहाँले आफ्नो माथिल्‍लो कोठाका दलिनहरू पानीमाथि बसाल्नुभएको छ। उहाँले बादललाई आफ्ना रथ बनाउनुहुन्छ; र उहाँ बतासका पखेटामा सवार हुनुहुन्छ।<verse eid="PSA 104:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 104:4"/>उहाँले बतासलाई आफ्ना दूत, र आगोका ज्वालालाई आफ्ना सेवक बनाउनुहुन्छ।<verse eid="PSA 104:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 104:5"/>उहाँले पृथ्वीलाई त्यसको जगमा बसाल्नुभयो; त्यो कहिल्यै डगमगाउनेछैन।<verse eid="PSA 104:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 104:6"/>तपाईंले त्यसलाई वस्त्रले झैँ गहिरो पानीले ढाक्नुभयो; पानी पर्वतहरूमाथि पुगेको थियो।<verse eid="PSA 104:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 104:7"/>तर तपाईंको हप्कीमा पानी भागे, तपाईंको गर्जनको सोरमा ती तुरुन्तै हटेर गए;<verse eid="PSA 104:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 104:8"/>पर्वतहरू खडा भए र तल बेँसीहरू देखा परे, तपाईंले तिनीहरूलाई तोकिदिनुभएको ठाउँमा ती बनिए।<verse eid="PSA 104:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 104:9"/>पानीले फेरि पृथ्वीलाई नडुबाओस् भनी तपाईंले त्यसले नाघ्न नसक्ने सिमाना राखिदिनुभयो।<verse eid="PSA 104:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 104:10"/>उहाँले खोल्साहरूमा पानीका मूलहरू फुटाउनुहुन्छ; ती पर्वतका बीच भएर बग्दछन्।<verse eid="PSA 104:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 104:11"/>तिनीहरूले मैदानका सबै जीवजन्तुलाई पानी दिन्छन्; अनि जङ्गली गधाहरूले पनि आफ्नो तिर्खा त्यहीँ मेटाउँछन्।<verse eid="PSA 104:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 104:12"/>आकाशका चराचुरुङ्गीहरूले त्यसकै छेउमा आफ्ना गुँड बनाउँछन्; हाँगाहरूका बीचमा तिनीहरू गीत गाउँछन्।<verse eid="PSA 104:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 104:13"/>उहाँले आफ्ना उच्‍च कक्षबाट पर्वतहरूमा पानी बर्साउनुहुन्छ; उहाँको कामका फलबाट पृथ्वी तृप्‍त हुन्छ।<verse eid="PSA 104:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 104:14"/>उहाँले गाईबस्तुका निम्ति घाँस, र मानिसले खेतबारीमा परिश्रम गरोस् भनी बोटबिरुवा उमार्नुहुन्छ; र जमिनबाट आहारा ल्याउनुहुन्छ।<verse eid="PSA 104:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 104:15"/>मानिसका हृदय हर्षित पार्नलाई दाखमद्य, त्यसको मुख चहकिलो पार्नलाई तेल, र त्यसको हृदय बलियो तुल्याउनलाई उहाँले रोटी दिनुहुन्छ।<verse eid="PSA 104:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 104:16"/>याहवेहका रूखहरू र उहाँले लगाउनुभएका लेबनानका देवदारुका रूखहरूले पर्याप्‍त पानी पाउँछन्।<verse eid="PSA 104:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 104:17"/>त्यहाँ चराहरूले आफ्ना गुँड लगाउँछन्; सारसले पनि सल्‍लाका रूखहरूमा आफ्नो गुँड बनाउँछ।<verse eid="PSA 104:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 104:18"/>अग्ला पर्वतहरू जङ्गली बाख्राहरूका निम्ति हुन्; पहराहरू खरायोहरूका निम्ति शरणस्थान हुन्।<verse eid="PSA 104:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 104:19"/>ऋतु छुट्ट्याउन उहाँले चन्द्रमा बनाउनुभयो; सूर्यले आफ्नो अस्ताउने बेला जान्दछ।<verse eid="PSA 104:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 104:20"/>तपाईंले अँध्यारो ल्याउनुहुन्छ, र रात पर्छ; र सबै जङ्गली पशुहरू निस्किआउँछन्।<verse eid="PSA 104:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 104:21"/>सिंहहरू आफ्ना शिकारका निम्ति गर्जन्छन् र तिनीहरूले परमेश्‍वरबाट आफ्ना आहारा खोज्छन्।<verse eid="PSA 104:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 104:22"/>सूर्य उदाउँदा ती जङ्गली पशुहरू गइहाल्छन्; तिनीहरू आफ्ना ओडारमा फर्कन्छन् र आराम गर्छन्।<verse eid="PSA 104:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 104:23"/>तब मानिसहरू आफ्ना काममा जान्छन्, र साँझसम्म परिश्रम गर्छन्।<verse eid="PSA 104:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 104:24"/>हे याहवेह, तपाईंले कति धेरै जीवित प्राणीहरू बनाउनुभएको छ! ती सबै तपाईंले आफ्ना बुद्धिले बनाउनुभएको छ; पृथ्वी तपाईंको सृष्‍टिले भरिपूर्ण छ।<verse eid="PSA 104:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 104:25"/>त्यहाँ विशाल र फराकिलो समुद्र छ, जसमा अनगन्ती जीवजन्तुहरू छन्— साना र ठूला दुवै किसिमका जीवित प्राणीहरू त्यहाँ छन्।<verse eid="PSA 104:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 104:26"/>त्यसमाथि जहाजहरू ओहोर-दोहोर गर्दछन्; त्यहाँ लिव्यातन छ, जसलाई त्यहाँ खेल्नलाई तपाईंले बनाउनुभयो।<verse eid="PSA 104:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 104:27"/>ठिक समयमा आफ्ना आहारा पाउने आशाले तिनीहरू सबैले तपाईंको बाटो हेर्छन्।<verse eid="PSA 104:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 104:28"/>जब तपाईंले त्यो तिनीहरूलाई दिनुहुन्छ, तब तिनीहरूले त्यो बटुल्छन्; जब तपाईंले आफ्नो मुट्ठी खोल्नुहुन्छ, तिनीहरू उत्तम पदार्थहरूले तृप्‍त हुन्छन्।<verse eid="PSA 104:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 104:29"/>जब तपाईंले आफ्ना मुहार लुकाउनुहुन्छ, तिनीहरू भयभीत हुन्छन्; जब तपाईंले तिनीहरूको सास लिनुहुन्छ, तिनीहरू मर्छन् र माटोमा फर्किजान्छन्।<verse eid="PSA 104:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 104:30"/>जब तपाईंले आफ्नो आत्मा पठाउनुहुन्छ, तब तिनीहरूको सृष्‍टि हुन्छ; र तपाईंले पृथ्वीको रूपलाई नयाँ तुल्याउनुहुन्छ।<verse eid="PSA 104:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 104:31"/>याहवेहको महिमा सदासर्वदा रहिरहोस्; याहवेह आफ्ना कार्यहरूमा प्रसन्‍न होऊन्—<verse eid="PSA 104:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 104:32"/>उहाँले पृथ्वीलाई हेर्नुहुन्छ, र त्यो थरथरी काम्दछ; उहाँले पर्वतहरूलाई छुनुहुन्छ, र तीबाट धुवाँ निस्कन्छ।<verse eid="PSA 104:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 104:33"/>म मेरो जीवनभरि याहवेहको भजन गाइरहनेछु; म बाँचुन्जेल परमेश्‍वरको प्रशंसा गाउनेछु।<verse eid="PSA 104:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 104:34"/>जब म याहवेहमा आनन्दित हुन्छु; मेरो ध्यान उहाँलाई मनपर्दो होस्।<verse eid="PSA 104:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 104:35"/>तर पापीहरू पृथ्वीबाट नाश भएर जाऊन्, र दुष्‍टहरू रहँदै नरहून्! हे मेरो प्राण, याहवेहको प्रशंसा गर्! याहवेहको प्रशंसा गर्!<verse eid="PSA 104:35"/></para>
<chapter eid="PSA 104"/>
<chapter number="105" style="c" sid="PSA 105"/>
<para style="p"><verse number="1" style="v" sid="PSA 105:1"/>याहवेहलाई प्रशंसा देओ, उहाँको नामको घोषणा गर; जाति-जातिहरूमा उहाँले गर्नुभएका कार्यहरूको बयान गर!<verse eid="PSA 105:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 105:2"/>उहाँको निम्ति गाओ, उहाँको प्रशंसाको गीत गाओ; उहाँका सबै अद्‌भुत कार्यहरूको वर्णन गर!<verse eid="PSA 105:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 105:3"/>उहाँको पवित्र नाममा गौरव गर; याहवेहलाई खोज्नेहरूका हृदय आनन्दित होऊन्!<verse eid="PSA 105:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 105:4"/>याहवेह र उहाँको शक्तिलाई हेर; उहाँको मुहारको निरन्तर खोजी गर!<verse eid="PSA 105:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 105:5"/>हे याहवेहका सेवक, हे अब्राहामका वंश हो, हे उहाँबाट चुनिएका याकोबका सन्तानहरू हो, उहाँले गर्नुभएका अद्‌भुत कार्यहरूका स्मरण गर, उहाँका अचम्मका कामहरू र उहाँले गर्नुभएका फैसलाको सम्झना गर!<verse eid="PSA 105:5"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 105:7"/>उहाँ नै याहवेह हाम्रा परमेश्‍वर हुनुहुन्छ; उहाँका न्यायका कामहरू सारा पृथ्वीमा छ।<verse eid="PSA 105:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 105:8"/>परमेश्‍वरले आफ्नो करार सदासर्वदा सम्झनुहुन्छ, त्यो प्रतिज्ञा, जो उहाँले हजार पुस्ताहरूलाई दिनुभएको थियो,<verse eid="PSA 105:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 105:9"/>त्यो करार जो उहाँले अब्राहामसँग बाँध्नुभएको थियो, त्यो शपथ, जो उहाँले इसहाकसँग गर्नुभएको थियो।<verse eid="PSA 105:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 105:10"/>त्यो उहाँले याकोबसँग उर्दीको रूपमा, इस्राएलसँग अनन्त करारको रूपमा पक्‍का गर्नुभयो:<verse eid="PSA 105:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 105:11"/>“म तँलाई कनान देश दिनेछु, त्यो पैतृक सम्पत्तिको रूपमा तेरो भाग हुनेछ।”<verse eid="PSA 105:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 105:12"/>जब तिनीहरू संख्यामा थोरै थिए, अति थोरै र त्यसमाथि पनि परदेशी थिए,<verse eid="PSA 105:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 105:13"/>तिनीहरू एउटा राष्ट्रबाट अर्को राष्ट्रमा, एउटा राज्यबाट अर्को राज्यमा भौँतारिँदै हिँड्थे।<verse eid="PSA 105:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 105:14"/>उहाँले कसैलाई तिनीहरूमाथि अत्याचार गर्न दिनुभएन; तिनीहरूको खातिर उहाँले राजाहरूलाई यसरी हप्काउनुभयो:<verse eid="PSA 105:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 105:15"/>“मेरा अभिषिक्त जनहरूलाई नछोओ; मेरा अगमवक्ताहरूलाई केही हानि नगर!”<verse eid="PSA 105:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 105:16"/>उहाँले त्यस देशमा अनिकाल पठाउनुभयो, र तिनीहरूका आहाराको सम्पूर्ण स्रोत नष्‍ट गरिदिनुभयो;<verse eid="PSA 105:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 105:17"/>उहाँले योसेफ नाम गरेका पुरुषलाई, तिनीहरूको अगि पठाउनुभयो— जो दासको रूपमा बेचिएका थिए।<verse eid="PSA 105:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 105:18"/>तिनका खुट्टाहरूमा नेल ठोकेर तिनीहरूले घाइते पारेका थिए; तिनको घाँटीमा फलामको साङ्लाले बाँधेका थिए,<verse eid="PSA 105:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 105:19"/>उहाँका अगमवाणी पूरा नभएसम्म, याहवेहको वचनले तिनलाई सत्य प्रमाणित नगरेसम्म; तिनीहरूले त्यसो गरे।<verse eid="PSA 105:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 105:20"/>राजाले मानिस पठाएर तिनलाई छुटाए; जनताका शासकले तिनलाई मुक्त गरे।<verse eid="PSA 105:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 105:21"/>राजाले तिनलाई आफ्नो घरको मालिक, र आफ्ना सबै धनसम्पत्तिको शासक बनाए।<verse eid="PSA 105:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 105:22"/>तिनकै इच्छाअनुसार आफ्ना राजकुमारहरूलाई बुद्धि सिकाऊन्, र आफ्ना प्रधानहरूलाई ज्ञानका कुरा सिकाऊन् भनी खटाए।<verse eid="PSA 105:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 105:23"/>त्यसपछि इस्राएल इजिप्टमा आए; याकोब हामको देशमा प्रवासी भएर बसे।<verse eid="PSA 105:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 105:24"/>याहवेहले आफ्ना प्रजालाई अत्यन्त फलवन्त बनाउनुभयो; तिनीहरूका शत्रुहरूभन्दा तिनीहरूको संख्या अनगन्ती बनाउनुभयो।<verse eid="PSA 105:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 105:25"/>परमेश्‍वरले इजिप्टियनहरूका हृदयलाई उहाँका जनहरूलाई घृणा गर्ने बनाउनुभयो; ताकि आफ्ना सेवकहरूका विरुद्धमा षड्यन्त्र रचून्।<verse eid="PSA 105:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 105:26"/>उहाँले आफ्ना सेवक मोशालाई, र आफूले चुन्‍नुभएका हारूनलाई तिनीहरूकहाँ पठाउनुभयो।<verse eid="PSA 105:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 105:27"/>तिनीहरूका बीचमा ती दुईले उहाँका अलौकिक चिन्हहरू, हामका देशमा उहाँका अद्‌भुत कार्यहरू देखाए।<verse eid="PSA 105:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 105:28"/>उहाँले अन्धकार पठाउनुभयो र देशमा अँध्यारो भयो— किनकि तिनीहरूले उहाँको आदेशहरूको विरोध गरेका थिए।<verse eid="PSA 105:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 105:29"/>उहाँले तिनीहरूका पानीलाई रगतमा परिवर्तन गर्नुभयो, जसले गर्दा तिनीहरूका माछाहरू मरे।<verse eid="PSA 105:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 105:30"/>तिनीहरूको देश भ्यागुताहरूले भरियो, ती तिनीहरूका शासकहरूका शयनकक्षसम्मै पुगे।<verse eid="PSA 105:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 105:31"/>उहाँले आदेश दिनुभयो र त्यहाँ झिँगाको बथान ओइरियो, र तिनीहरूको सारा देश भुसुनाहरूले भरियो।<verse eid="PSA 105:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 105:32"/>उहाँले पानीको साटो असिना बर्साउनुभयो, र उनीहरूको देशभरि चट्याङ पठाउनुभयो;<verse eid="PSA 105:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 105:33"/>उहाँले तिनीहरूका अङ्‌गुर र नेभाराका रूखहरू ध्वस्त पार्नुभयो, र तिनीहरूका देशका रूखहरू ढालिदिनुभयो।<verse eid="PSA 105:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 105:34"/>उहाँले आज्ञा गर्नुभयो, र सलहहरू आए, असंख्य फट्याङ्ग्राहरू आए;<verse eid="PSA 105:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 105:35"/>तिनीहरूले त्यस देशका हरेक वनस्पति खाइदिए, तिनीहरूको भूमिको उब्जनीहरू सखाप पारिदिए।<verse eid="PSA 105:35"/></para>
<para style="p"><verse number="36" style="v" sid="PSA 105:36"/>तब उहाँले त्यस देशका सबै पहिले जन्मेकाहरूलाई, तिनीहरूका पुरुषार्थका पहिलो फलहरूलाई नाश पार्नुभयो।<verse eid="PSA 105:36"/></para>
<para style="p"><verse number="37" style="v" sid="PSA 105:37"/>उहाँले इस्राएललाई सुन र चाँदीले भरिपूर्ण पारि निकालेर ल्याउनुभयो; र तिनीहरूका कुलबाट कसैले पनि ठक्‍कर खाएनन्।<verse eid="PSA 105:37"/></para>
<para style="p"><verse number="38" style="v" sid="PSA 105:38"/>तिनीहरू निस्केर जाँदा इजिप्ट रमायो; किनकि इस्राएलको डर तिनीहरूमाथि परेको थियो।<verse eid="PSA 105:38"/></para>
<para style="p"><verse number="39" style="v" sid="PSA 105:39"/>उहाँले आवरणको रूपमा बादललाई फैलाउनुभयो, र रातमा उज्यालो दिनलाई आगो दिनुभयो।<verse eid="PSA 105:39"/></para>
<para style="p"><verse number="40" style="v" sid="PSA 105:40"/>तिनीहरूले मासु खान मागे, र उहाँले तिनीहरूका निम्ति बट्टाई चराहरू दिनुभयो; स्वर्गका रोटीले तिनीहरूलाई तृप्‍त पार्नुभयो।<verse eid="PSA 105:40"/></para>
<para style="p"><verse number="41" style="v" sid="PSA 105:41"/>उहाँले चट्टान फोर्नुभयो, र पानी बगेर निस्क्यो; त्यो मरुभूमिमा नदीझैँ बग्यो।<verse eid="PSA 105:41"/></para>
<para style="p"><verse number="42" style="v" sid="PSA 105:42"/>किनकि उहाँले आफ्नो सेवक अब्राहामलाई दिनुभएको पवित्र प्रतिज्ञा स्मरण गर्नुभयो।<verse eid="PSA 105:42"/></para>
<para style="p"><verse number="43" style="v" sid="PSA 105:43"/>उहाँले आफ्ना प्रजालाई आनन्दसाथ, र आफूले चुनेका जनहरूलाई हर्षोल्‍लासकासाथ गाउन लगाउँदै निकालेर ल्याउनुभयो;<verse eid="PSA 105:43"/></para>
<para style="p"><verse number="44" style="v" sid="PSA 105:44"/>उहाँले अरू जातिहरूका भूमिहरू तिनीहरूलाई दिनुभयो; र अरूले गरेको परिश्रमको फलमा तिनीहरूले आफ्नो अधिकार गरे—<verse eid="PSA 105:44"/></para>
<para style="p"><verse number="45" style="v" sid="PSA 105:45"/>तिनीहरूले उहाँका विधिहरू पालन गरून् र उहाँका नियमहरू मानून् भनेर नै यी सबै भए। याहवेहको प्रशंसा गर!<verse eid="PSA 105:45"/></para>
<chapter eid="PSA 105"/>
<chapter number="106" style="c" sid="PSA 106"/>
<para style="p"><verse number="1" style="v" sid="PSA 106:1"/>याहवेहको प्रशंसा गर! याहवेहलाई धन्यवाद देओ; किनकि उहाँ भलो हुनुहुन्छ; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 106:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 106:2"/>याहवेहका शक्तिशाली कार्यहरू कसले घोषणा गर्न सक्छ र? अथवा उहाँको प्रशंसा कसले सम्पूर्ण रूपले घोषणा गर्न सक्छ र?<verse eid="PSA 106:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 106:3"/>तिनीहरू धन्यका हुन्, जो न्यायमा चल्दछन्, जसले सधैँ उचित काम गर्दछन्।<verse eid="PSA 106:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 106:4"/>हे याहवेह, तपाईंका प्रजामाथि कृपादृष्‍टि गर्नुहुँदा, मेरो स्मरण गर्नुहोस्; तिनीहरूको उद्धार गर्नुहुँदा मलाई पनि सहायता गर्नुहोस्;<verse eid="PSA 106:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 106:5"/>ताकि तपाईंका चुनिएकाहरूको समृद्धिमा म आनन्दित हुन सकूँ, तपाईंको राष्ट्रको हर्षमा म सहभागी बन्‍न सकूँ। र तपाईंको उत्तराधिकारीहरूसँग मिलेर तपाईंलाई प्रशंसा दिन सकूँ।<verse eid="PSA 106:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 106:6"/>हाम्रा पितापुर्खाले झैँ, हामीले पनि पाप गरेका छौँ; हामीले अधर्म गरेका छौँ, र दुष्‍टतापूर्ण काम गरेका छौँ।<verse eid="PSA 106:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 106:7"/>हाम्रा पितापुर्खा इजिप्टमा हुँदा, तिनीहरूले तपाईंका अचम्मका कामहरूको वास्तै गरेनन्; तिनीहरूले तपाईंको अपार दयाको सम्झना नै गरेनन्; र लाल समुद्रको किनारमा तिनीहरूले तपाईंको विद्रोह गरे।<verse eid="PSA 106:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 106:8"/>तापनि आफ्नो महान् पराक्रम प्रकट होस् भनी आफ्नो नामको खातिर, उहाँले तिनीहरूलाई बचाउनुभयो।<verse eid="PSA 106:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 106:9"/>उहाँले लाल समुद्रलाई हकार्नुभयो, र त्यो सुकिहाल्यो; उहाँले तिनीहरूलाई समुद्रको गहिराइहरूमा सुक्खा जमिनमाथि जस्तै गरी पार गराउनुभयो।<verse eid="PSA 106:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 106:10"/>उहाँले तिनीहरूलाई वैरीका हातबाट बचाउनुभयो; उहाँले तिनीहरूलाई शत्रुको हातबाट उद्धार गर्नुभयो।<verse eid="PSA 106:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 106:11"/>तिनीहरूका विरोधीहरूलाई पानीले डुबायो; तिनीहरूमध्ये एउटै पनि बाँचेनन्।<verse eid="PSA 106:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 106:12"/>तब तिनीहरूले उहाँका प्रतिज्ञाहरूमाथि विश्‍वास गरे; र उहाँको प्रशंसाको गीत गाए।<verse eid="PSA 106:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 106:13"/>तर तिनीहरूले तुरुन्तै उहाँका कामहरू बिर्सिहाले; र तिनीहरूले उहाँको निर्देशनको प्रतीक्षा गरेनन्।<verse eid="PSA 106:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 106:14"/>मरुभूमिमा तिनीहरू धेरै नै खाने लालसामा परे; तिनीहरूले उजाडस्थानमा परमेश्‍वरको जाँच गरे।<verse eid="PSA 106:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 106:15"/>त्यसैले उहाँले तिनीहरूलाई मागेअनुसार दिनुभयो, तर तिनीहरूका बीचमा महामारी पठाउनुभयो।<verse eid="PSA 106:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 106:16"/>तिनीहरूले छाउनीमा मोशासित र याहवेहमा अर्पण गरिएका हारूनसँग डाह गरे।<verse eid="PSA 106:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 106:17"/>तब धर्ती फाटेर दातानलाई निल्यो; र अबीरामको दललाई पुरिदियो।<verse eid="PSA 106:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 106:18"/>तिनीहरूका समर्थकहरूका बीचमा आगो दन्क्यो; ज्वालाले दुष्‍टहरूलाई भस्म पार्‍यो।<verse eid="PSA 106:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 106:19"/>होरेबमा तिनीहरूले एउटा बाछा बनाए; र धातुको त्यस मूर्तिलाई आराधना गरे।<verse eid="PSA 106:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 106:20"/>यसरी तिनीहरूले परमेश्‍वरलाई दिने आफ्ना महिमा घाँस खाने साँढेको मूर्तिसँग साटे।<verse eid="PSA 106:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 106:21"/>तिनीहरूले आफ्ना उद्धारकर्ता परमेश्‍वरलाई बिर्से, जसले इजिप्टमा महान् कामहरू गर्नुभएको थियो;<verse eid="PSA 106:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 106:22"/>जसले हामको देशमा अचम्मका कामहरू, र लाल समुद्रको किनारमा अद्‌भुत कार्यहरू गर्नुभएको थियो।<verse eid="PSA 106:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 106:23"/>यसकारण उहाँले तिनीहरूलाई नाश गर्छु भन्‍नुभयो। तर उहाँका चुनिएका जन मोशा तिनीहरूलाई नाश पार्ने उहाँको क्रोध हटाउनलाई उहाँको सामु खडा भए।<verse eid="PSA 106:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 106:24"/>तब तिनीहरूले त्यो आनन्दको देशलाई तुच्छ ठाने; उहाँका प्रतिज्ञामा तिनीहरूले विश्‍वास गरेनन्।<verse eid="PSA 106:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 106:25"/>तिनीहरूले आफ्ना पालहरूमा गनगन गरे; र याहवेहमा आज्ञाकारी भएनन्।<verse eid="PSA 106:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 106:26"/>यसकारण तिनीहरूलाई उजाडस्थानमा विनाश पार्छु भनी उहाँले हात उचालेर शपथ खानुभयो,<verse eid="PSA 106:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 106:27"/>तिनीहरूका वंशलाई जातिहरूका बीचमा छरपस्ट पार्छु, र तिनीहरूलाई देश-विदेशभरि तितरबितर पार्छु भन्‍नुभयो।<verse eid="PSA 106:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 106:28"/>तिनीहरूले पोर भन्‍ने ठाउँको बाल-देवताको पूजा गरे, र निर्जीव देवताहरूलाई चढाइएका बलिका थोकहरू खाए।<verse eid="PSA 106:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 106:29"/>तिनीहरूले आफ्ना दुष्‍ट कामहरूद्वारा याहवेहलाई क्रोधित तुल्याए; अनि तिनीहरूका बीचमा महामारी फैलियो।<verse eid="PSA 106:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 106:30"/>तर पीनहासले साहसका साथ हस्तक्षेप गरे; र महामारी थामियो।<verse eid="PSA 106:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 106:31"/>यो तिनको निम्ति अनन्त पुस्ताहरूको लागि धार्मिकताझैँ गनियो।<verse eid="PSA 106:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 106:32"/>मेरीबाका पानीको नजिक पनि तिनीहरूले याहवेहलाई क्रोधित तुल्याए; र तिनीहरूले गर्दा मोशामाथि सङ्कट आयो;<verse eid="PSA 106:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 106:33"/>किनकि तिनीहरू परमेश्‍वरका आत्माको विरुद्धमा बागी भए; र मोशाको मुखबाट अनर्थका कुराहरू निस्के।<verse eid="PSA 106:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 106:34"/>याहवेहले आज्ञा गर्नुभएअनुसार तिनीहरूले वरपरका जातिहरूलाई नष्‍ट गरेनन्,<verse eid="PSA 106:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 106:35"/>बरु तिनीहरू ती जातिहरूसित नै घुलमिल भए, र तिनीहरूका रीतिरिवाज अपनाए।<verse eid="PSA 106:35"/></para>
<para style="p"><verse number="36" style="v" sid="PSA 106:36"/>तिनीहरूले उनीहरूका मूर्तिहरूलाई आराधना गरे, जुन तिनीहरूका निम्ति पासो बन्‍न पुगे।<verse eid="PSA 106:36"/></para>
<para style="p"><verse number="37" style="v" sid="PSA 106:37"/>तिनीहरूले दुष्‍ट आत्माहरूका निम्ति आफ्ना छोराछोरीहरूलाई बलि चढाए।<verse eid="PSA 106:37"/></para>
<para style="p"><verse number="38" style="v" sid="PSA 106:38"/>तिनीहरूले निर्दोषको रगत, अर्थात् आफ्नै छोराछोरीहरूको रगत बगाए, जसलाई तिनीहरूले कनान देशका मूर्तिहरूका निम्ति बलि चढाए; र तिनीहरूको रगतले धर्ती अपवित्र भयो।<verse eid="PSA 106:38"/></para>
<para style="p"><verse number="39" style="v" sid="PSA 106:39"/>तिनीहरूका आफ्नै दुष्‍ट कामहरूले आफूलाई अशुद्ध पारे; आफ्नै कामहरूद्वारा तिनीहरू व्यभिचारी भए।<verse eid="PSA 106:39"/></para>
<para style="p"><verse number="40" style="v" sid="PSA 106:40"/>त्यसकारण याहवेह आफ्ना मानिसहरूसित रिसाउनुभयो, र उहाँले आफ्ना उत्तराधिकारीहरूलाई अति घृणा गर्नुभयो।<verse eid="PSA 106:40"/></para>
<para style="p"><verse number="41" style="v" sid="PSA 106:41"/>उहाँले तिनीहरूलाई अन्य राष्ट्रहरूका हातमा सुम्पिदिनुभयो; र तिनीहरूका वैरीहरूले तिनीहरूमाथि शासन गरे।<verse eid="PSA 106:41"/></para>
<para style="p"><verse number="42" style="v" sid="PSA 106:42"/>तिनीहरूका शत्रुहरूले तिनीहरूलाई दमन गरे, र तिनीहरूलाई आफ्ना शक्तिको वशमा पारे।<verse eid="PSA 106:42"/></para>
<para style="p"><verse number="43" style="v" sid="PSA 106:43"/>धेरै पटक उहाँले तिनीहरूलाई छुटाउनुभयो, तर तिनीहरूले विद्रोह नै गर्न रुचाए, र तिनीहरू आफ्ना पापका कारण पतन हुँदैगए।<verse eid="PSA 106:43"/></para>
<para style="p"><verse number="44" style="v" sid="PSA 106:44"/>तापनि उहाँले तिनीहरूको पुकार सुन्‍नुभयो, र तिनीहरूका कष्‍टमा टिठ्याउनुभयो;<verse eid="PSA 106:44"/></para>
<para style="p"><verse number="45" style="v" sid="PSA 106:45"/>तिनीहरूको खातिर उहाँले आफ्नो करार स्मरण गर्नुभयो, र आफ्नो अचुक प्रेममा दयालु हुनुभयो।<verse eid="PSA 106:45"/></para>
<para style="p"><verse number="46" style="v" sid="PSA 106:46"/>तिनीहरूलाई कैद गर्नेहरू सबैलाई तिनीहरूप्रति दया देखाउने बनाउनुभयो।<verse eid="PSA 106:46"/></para>
<para style="p"><verse number="47" style="v" sid="PSA 106:47"/>हे याहवेह हाम्रा परमेश्‍वर, हामीलाई बचाउनुहोस्, र जाति-जातिहरूबाट हामीलाई एकत्र गर्नुहोस्! ताकि हामी तपाईंको पवित्र नाममा धन्यवाद चढाउन सकौँ, र तपाईंको प्रशंसा गर्दै महिमा दिन सकौँ!<verse eid="PSA 106:47"/></para>
<para style="p"><verse number="48" style="v" sid="PSA 106:48"/>याहवेह इस्राएलका परमेश्‍वरको प्रशंसा, अनादिदेखि अनन्तसम्मै भइरहोस्! सबै मानिसहरूले भनून् “आमेन!” याहवेहको प्रशंसा गर!<verse eid="PSA 106:48"/></para>
<chapter eid="PSA 106"/>
<chapter number="107" style="c" sid="PSA 107"/>
<para style="p"><verse number="1" style="v" sid="PSA 107:1"/>याहवेहलाई धन्यवाद देओ; किनकि उहाँ भलो हुनुहुन्छ; उहाँको अचुक प्रेम सधैँभरि रहिरहन्छ।<verse eid="PSA 107:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 107:2"/>याहवेहले छुटकारा दिनुभएकाहरूले वैरीहरूका हातबाट छुटाइएकाहरूले,<verse eid="PSA 107:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 107:3"/>विभिन्‍न देशहरूबाट, पूर्व र पश्‍चिमबाट, उत्तर र दक्षिणबाट एकत्रित भएकाहरूले यसो भनून्:<verse eid="PSA 107:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 107:4"/>कसै-कसैले बसोबास गर्नलाई कुनै सहर भेट्टाएनन्, र मरुभूमिका उजाडस्थानतिर भौँतारिँदै हिँडे।<verse eid="PSA 107:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 107:5"/>तिनीहरू भोक र प्यासले दुर्बल भई प्राण जालाजस्तै भइसकेका थिए।<verse eid="PSA 107:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 107:6"/>तब आफ्ना कष्‍टहरूमा तिनीहरूले याहवेहलाई पुकारे, र उहाँले तिनीहरूलाई तिनीहरूका सङ्कष्‍टहरूबाट छुटाउनुभयो।<verse eid="PSA 107:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 107:7"/>उहाँले तिनीहरूलाई सीधा मार्गबाट डोर्‍याउनु भएर, तिनीहरूलाई बास बस्‍न सक्ने सहरमा पुर्‍याउनुभयो।<verse eid="PSA 107:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 107:8"/>उहाँको अचुक प्रेम र मानिसहरूप्रति उहाँका अद्‌भुत कार्यहरूका निम्ति, तिनीहरूले याहवेहलाई धन्यवाद देऊन्!<verse eid="PSA 107:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 107:9"/>किनकि उहाँले तिर्सना गर्नेहरूको प्यास मेट्नुहुन्छ, र भोकाहरूलाई असल आहाराले सन्तुष्‍ट पार्नुहुन्छ।<verse eid="PSA 107:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 107:10"/>कोही-कोही अन्धकार, र घोर अन्धकारमा जिइरहेका थिए, कैदीहरू फलामका साङ्लाले बाँधिएर कष्‍ट भोगिरहेका थिए,<verse eid="PSA 107:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 107:11"/>किनकि तिनीहरूले परमेश्‍वरका वचनको विरुद्धमा विद्रोह गरेका थिए र सर्वोच्‍च परमेश्‍वरको योजनालाई तिरस्कार गरेका थिए।<verse eid="PSA 107:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 107:12"/>यसकारण उहाँले तिनीहरूलाई कठोर परिश्रम गर्न लगाउनुभयो; तिनीहरूले ठक्‍कर खाए, तर मदत गर्नलाई कोही थिएन।<verse eid="PSA 107:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 107:13"/>तब आफ्ना कष्‍टहरूमा तिनीहरूले याहवेहलाई पुकारे, र उहाँले तिनीहरूलाई तिनीहरूका सङ्कष्‍टहरूबाट बचाउनुभयो।<verse eid="PSA 107:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 107:14"/>उहाँले तिनीहरूलाई अन्धकार, र घोर अन्धकारहरूबाट निकाल्नुभयो; र तिनीहरू बाँधिएका साङ्लाहरू चुँडाइदिनुभयो।<verse eid="PSA 107:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 107:15"/>उहाँको अचुक प्रेम र मानिसहरूप्रति उहाँका अद्‌भुत कार्यहरूका निम्ति तिनीहरूले याहवेहलाई धन्यवाद देऊन्;<verse eid="PSA 107:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 107:16"/>किनकि उहाँले काँसोका मूलढोकाहरू भत्काइदिनुहुन्छ, र फलामका आग्लोहरू काटेर टुक्रा-टुक्रा पारिदिनुहुन्छ।<verse eid="PSA 107:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 107:17"/>कोही-कोही आफ्ना विद्रोही चालहरूले गर्दा मूर्ख बने, र आफ्नै अधर्मका कारण कष्‍ट भोगे।<verse eid="PSA 107:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 107:18"/>तिनीहरू सबै प्रकारका खानेकुराहरूदेखि वाक्‍कै भए, र मृत्युका ढोका नजिक पुगे।<verse eid="PSA 107:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 107:19"/>तब आफ्ना कष्‍टहरूमा तिनीहरूले याहवेहलाई पुकारे, र उहाँले तिनीहरूलाई तिनीहरूका सङ्कष्‍टहरूबाट बचाउनुभयो।<verse eid="PSA 107:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 107:20"/>उहाँले आफ्नो वचन पठाउनुभयो, र तिनीहरूलाई निको पार्नुभयो, तिनीहरूलाई चिहानबाट छुटाउनुभयो।<verse eid="PSA 107:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 107:21"/>उहाँको अचुक प्रेम र मानिसहरूप्रति उहाँका अद्‌भुत कार्यहरूका निम्ति तिनीहरूले याहवेहलाई धन्यवाद देऊन्!<verse eid="PSA 107:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 107:22"/>तिनीहरूले धन्यवादका बलि चढाऊन् र हर्षका गीत गाएर उहाँका कार्यको वर्णन गरून्!<verse eid="PSA 107:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 107:23"/>कोही-कोही जहाजहरूमा चढी सामुद्रिक यात्रामा गए; तिनीहरू महासागरका व्यापारीहरू थिए।<verse eid="PSA 107:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 107:24"/>तिनीहरूले याहवेहका कामहरू देखे, गहिरो सागरमा तिनीहरूले उहाँका अद्‌भुत कार्यहरू देखे।<verse eid="PSA 107:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 107:25"/>किनकि उहाँले आज्ञा गर्नुभयो, र प्रचण्ड आँधी चल्यो, जसले गर्दा समुद्रका छालहरू माथिसम्म उठे।<verse eid="PSA 107:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 107:26"/>छालहरू आकाशसम्म नै उठे, र फेरि सागरको गहिराइहरूमा झरे; यस्तो जोखिममा तिनीहरूको साहस हराएर गयो।<verse eid="PSA 107:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 107:27"/>तिनीहरू मदिराले मातेको मानिसझैँ धरमरिँन्थे; तिनीहरूका सबै सिपहरू बेकार साबित भए।<verse eid="PSA 107:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 107:28"/>तब आफ्ना कष्‍टहरूमा तिनीहरूले याहवेहलाई पुकारे, र उहाँले तिनीहरूलाई तिनीहरूका सङ्कष्‍टहरूबाट छुटाउनुभयो।<verse eid="PSA 107:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 107:29"/>उहाँले आँधीलाई शान्त पार्नुभयो; समुद्रका छालहरू साम्य भए।<verse eid="PSA 107:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 107:30"/>आँधी शान्त हुँदा तिनीहरू खुशी भए; र उहाँले तिनीहरूलाई तिनीहरूले इच्छा गरेको बन्दरगाहमा पुर्‍याउनुभयो।<verse eid="PSA 107:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 107:31"/>उहाँको अचुक प्रेम र मानिसहरूप्रति उहाँका अद्‌भुत कार्यहरूका निम्ति तिनीहरूले याहवेहलाई धन्यवाद देऊन्!<verse eid="PSA 107:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 107:32"/>तिनीहरूले मानिसहरूको समुदायमा उहाँलाई उच्‍च पारून्, र प्रधानहरूका सभामा उहाँको प्रशंसा गरून्!<verse eid="PSA 107:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 107:33"/>उहाँले नदीहरूलाई मरुभूमिमा, र पानीका मूलहरूलाई सुक्खा भूमिमा परिवर्तन गर्नुभयो।<verse eid="PSA 107:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 107:34"/>त्यहाँका बासिन्दाहरूका दुष्‍टताको कारणले गर्दा, मलिला जमिनलाई नुनिलो मरुस्थलमा परिवर्तन गरिदिनुभयो।<verse eid="PSA 107:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 107:35"/>उहाँले मरुभूमिलाई तालमा र सुक्खा जमिनलाई पानीका मूलमा परिवर्तन गर्नुभयो;<verse eid="PSA 107:35"/></para>
<para style="p"><verse number="36" style="v" sid="PSA 107:36"/>उहाँले त्यहाँ भोकाहरूलाई बासको निम्ति ल्याउनुभयो, र तिनीहरूले बसोबास गर्न सक्ने एउटा सहर निर्माण गरे।<verse eid="PSA 107:36"/></para>
<para style="p"><verse number="37" style="v" sid="PSA 107:37"/>तिनीहरूले खेतबारीमा बिउ छरे, र दाखबारी लगाए, अनि प्रशस्त उब्जनी कटनी गरे;<verse eid="PSA 107:37"/></para>
<para style="p"><verse number="38" style="v" sid="PSA 107:38"/>उहाँले तिनीहरूलाई आशिष् दिनुभयो, र तिनीहरूको जनसंख्या बढाउनुभयो; अनि तिनीहरूका गाईबस्तुका बथान घट्न दिनुभएन।<verse eid="PSA 107:38"/></para>
<para style="p"><verse number="39" style="v" sid="PSA 107:39"/>त्यसपछि अत्याचार, विपत्ति र शोकले गर्दा, तिनीहरूको जनसंख्या घट्यो र तिनीहरू होच्याइए;<verse eid="PSA 107:39"/></para>
<para style="p"><verse number="40" style="v" sid="PSA 107:40"/>उहाँले शासकहरूमाथि अपमान खन्याउनुहुन्छ, र तिनीहरूलाई पथविहीन उजाड ठाउँहरूमा भौँतारिँदै हिँड्ने बनाउनुभयो।<verse eid="PSA 107:40"/></para>
<para style="p"><verse number="41" style="v" sid="PSA 107:41"/>तर गरिबहरूलाई उहाँले तिनीहरूका दुःखबाट उठाउनुभयो, र तिनीहरूका परिवारहरूलाई भेडाका बगालझैँ बढाउनुभयो।<verse eid="PSA 107:41"/></para>
<para style="p"><verse number="42" style="v" sid="PSA 107:42"/>धर्मी मानिसहरू यो देखेर हर्षित हुन्छन्, तर सबै दुष्‍टहरूचाहिँ आफ्नो मुख बन्द गर्छन्।<verse eid="PSA 107:42"/></para>
<para style="p"><verse number="43" style="v" sid="PSA 107:43"/>जो बुद्धिमान् छ, त्यसले यी कुराहरूमा ध्यान देओस्, र याहवेहको महान् प्रेममाथि चिन्तन गरोस्।<verse eid="PSA 107:43"/></para>
<chapter eid="PSA 107"/>
<chapter number="108" style="c" sid="PSA 108"/>
<para style="p"><verse number="1" style="v" sid="PSA 108:1"/>एउटा गीत, दावीदको भजन। हे परमेश्‍वर, मेरो हृदय स्थिर छ; म गाउनेछु र मेरो सम्पूर्ण प्राणले धुन बजाउनेछु।<verse eid="PSA 108:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 108:2"/>हे सारङ्गी र वीणा जाग्! म प्रभातलाई जगाउनेछु।<verse eid="PSA 108:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 108:3"/>हे याहवेह, राष्ट्र-राष्ट्रहरूका बीचमा म तपाईंको प्रशंसा गर्नेछु; जाति-जातिहरूबीच म तपाईंको स्तुति गाउनेछु।<verse eid="PSA 108:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 108:4"/>किनकि तपाईंको प्रेम महान् छ, आकाशभन्दा पनि उच्‍च छ; तपाईंको विश्‍वासयोग्यता आकाशसम्मै पुग्दछ।<verse eid="PSA 108:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 108:5"/>हे परमेश्‍वर, स्वर्गभन्दा उच्‍च हुनुहोस्; सारा पृथ्वीमाथि तपाईंको महिमा रहोस्।<verse eid="PSA 108:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 108:6"/>तपाईंको दाहिने हातले हामीलाई बचाउनुहोस्, र मदत गर्नुहोस्; ताकि तपाईंका प्रियजनहरूले छुटकारा पाऊन्।<verse eid="PSA 108:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 108:7"/>परमेश्‍वरले उहाँको वासस्थानबाट बोल्नुभएको छ: “विजयमा म शेकेमलाई विभाजन गर्नेछु, र सुक्‍कोतको बेँसीलाई नापेर छुट्ट्याउनेछु।<verse eid="PSA 108:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 108:8"/>गिलाद मेरो हो, मनश्शे पनि मेरै हो; एफ्राइम मेरो टोप हो, यहूदा मेरो राजदण्ड हो।<verse eid="PSA 108:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 108:9"/>मोआब मेरो हात धुने भाँडो हो; एदोममा म आफ्नो जुत्ता फाल्नेछु; पलिश्तीमाथिको विजयमा म कराउनेछु।”<verse eid="PSA 108:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 108:10"/>किल्‍ला भएको सहरमा मलाई कसले पुर्‍याइदेला? कसले मलाई एदोमसम्म डोर्‍याउला?<verse eid="PSA 108:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 108:11"/>हे परमेश्‍वर, तपाईं नै होइन, जसले हामीलाई त्याग्नुभएको छ, र अहिले हाम्रा सेनाहरूका साथमा पनि जानुभएन?<verse eid="PSA 108:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 108:12"/>शत्रुहरूका विरुद्धमा हामीलाई सहायता गर्नुहोस्; किनकि मानिसको सहायता व्यर्थ छ।<verse eid="PSA 108:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 108:13"/>परमेश्‍वरको सहायताद्वारा हामीले विजय प्राप्‍त गर्नेछौँ; र उहाँले हाम्रा शत्रुहरूलाई कुल्चनुहुनेछ।<verse eid="PSA 108:13"/></para>
<chapter eid="PSA 108"/>
<chapter number="109" style="c" sid="PSA 109"/>
<para style="p"><verse number="1" style="v" sid="PSA 109:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। मेरा परमेश्‍वर, जसको म प्रशंसा गर्छु, तपाईं चुप लागेर नबस्‍नुहोस्;<verse eid="PSA 109:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 109:2"/>किनकि दुष्‍ट र छली मानिसहरूले मेरो विरुद्धमा आफ्ना मुख खोलेका छन्; तिनीहरूका झूटो जिब्रोले मेरो विरुद्धमा बोलेका छन्।<verse eid="PSA 109:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 109:3"/>तिनीहरूले मलाई घृणाका शब्दहरूले घेरेका छन्; कारणविना तिनीहरू मलाई हमला गर्छन्।<verse eid="PSA 109:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 109:4"/>मेरो मित्रताको साटो तिनीहरू मलाई दोष लगाउँछन्, तर मचाहिँ प्रार्थना गर्ने मानिस हुँ।<verse eid="PSA 109:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 109:5"/>तिनीहरूले मलाई भलाइको साटो खराबी गर्छन्, र मेरो मित्रताको साटो घृणा गर्छन्।<verse eid="PSA 109:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 109:6"/>मेरो शत्रुका विरोध गर्न कुनै दुष्‍ट मानिसलाई खटाउनुहोस्; त्यसलाई दोष लगाउने मानिस त्यसको दाहिने हातपट्टि खडा होस्!<verse eid="PSA 109:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 109:7"/>त्यसको न्याय हुँदा त्यो दोषी ठहरियोस्, र त्यसको विन्तिले त्यसैलाई दण्डको आज्ञा ठहरिओस्!<verse eid="PSA 109:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 109:8"/>त्यसको आयु कम होस्; त्यसको नेतृत्वको ठाउँ अरूले लेओस्!<verse eid="PSA 109:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 109:9"/>त्यसका छोराछोरीहरू अनाथ होऊन् र त्यसकी पत्नी विधवा होस्!<verse eid="PSA 109:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 109:10"/>त्यसका छोराछोरीहरू डुलुवा मगन्ते होऊन्; तिनीहरूका आफ्ना भताभुङ्ग भएका घरबाट पनि धपाइऊन्।<verse eid="PSA 109:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 109:11"/>त्यससँग भएको सर्वस्व साहूले जफत गरोस्; त्यसका परिश्रमका फलहरू पराईहरूले लुटून्!<verse eid="PSA 109:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 109:12"/>त्यसमाथि कसैले पनि दया नगरोस्, न त त्यसका अनाथ छोराछोरीमाथि कसैले दया देखाओस्!<verse eid="PSA 109:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 109:13"/>त्यसका सन्तानहरू मरेर जाऊन्; र आउँदो पुस्ताबाट तिनीहरूका नामनिशानै मेटिएर जाओस्!<verse eid="PSA 109:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 109:14"/>याहवेहको अगि, त्यसका पितापुर्खाहरूका पाप स्मरण होस्; त्यसकी आमाको पाप कहिल्यै नमेटिओस्!<verse eid="PSA 109:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 109:15"/>तिनीहरूका पाप निरन्तर याहवेहको सामु रहिरहून्, ताकि उहाँले पृथ्वीबाट तिनीहरूको नामनिशानै मेटाइदेऊन्!<verse eid="PSA 109:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 109:16"/>किनकि त्यसले दयालु हुन कहिल्यै सोचेन, तर दुःखी, अभावग्रस्त र हृदय टुटेकाहरूलाई मृत्युसम्म नै खेदो गरेको थियो।<verse eid="PSA 109:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 109:17"/>त्यसले श्राप दिन मन पराउँथ्यो— त्यसको श्राप त्यसमाथि नै आइपरोस्; त्यसले आशिष् दिन रुचाएन— त्यसबाट पनि आशिष् त्यसरी नै टाढै रहोस्!<verse eid="PSA 109:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 109:18"/>त्यसले श्रापलाई आफ्नो वस्त्रझैँ पहिरियो; त्यो पानीझैँ त्यसको पेटभित्र तेलझैँ त्यसका हाडहरूमा पसोस्!<verse eid="PSA 109:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 109:19"/>श्राप नै त्यसलाई लपेट्ने वस्त्रजस्तै होस्, र यो त्यसको कम्मरमा सधैँभरि बाँधिने पटुकाजस्तै होस्।<verse eid="PSA 109:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 109:20"/>मलाई दोष लगाउनेहरू र मेरो विरुद्धमा दुष्‍ट कुरा गर्नेहरूलाई याहवेहबाट यस्तै प्रतिफल मिलोस्!<verse eid="PSA 109:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 109:21"/>तर हे प्रभु याहवेह, तपाईंको नामको खातिर मलाई मदत गर्नुहोस्; तपाईंको प्रेमको भलाइको कारण मलाई उद्धार गर्नुहोस्!<verse eid="PSA 109:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 109:22"/>किनकि म गरिब र खाँचोमा छु, र मभित्र मेरो हृदय घाइते भएको छ।<verse eid="PSA 109:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 109:23"/>म बेलुकीको छायाझैँ बिलाउँदै गएको छु; म सलहझैँ हुत्त्‍याइएर फालिएको छु।<verse eid="PSA 109:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 109:24"/>उपवासले गर्दा मेरा घुँडाहरू कमजोर भएका छन्; मेरो शरीर हाड र छाला मात्र भएको छ।<verse eid="PSA 109:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 109:25"/>मलाई दोष लगाउनेहरूका अगि म निन्दाको पात्र बनेको छु; जब तिनीहरूले मलाई हेर्छन्, तब खिसी गर्दै आफ्ना टाउकाहरू हल्‍लाउँछन्।<verse eid="PSA 109:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 109:26"/>हे याहवेह, मेरा परमेश्‍वर, मलाई मदत गर्नुहोस्; तपाईंको अचुक प्रेमअनुसार मलाई बचाउनुहोस्;<verse eid="PSA 109:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 109:27"/>ताकि यो तपाईंकै हात हो भनी तिनीहरूले जानून्; हे याहवेह, यो तपाईंले नै गर्नुभएको हो भनी तिनीहरूले बुभून्!<verse eid="PSA 109:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 109:28"/>तिनीहरूले मलाई सराप्दा, तपाईंले मलाई आशिष् दिनुहोस्; मलाई आक्रमण गर्नेहरू लाजमा परून्; तर तपाईंको सेवक रमाओस्!<verse eid="PSA 109:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 109:29"/>मलाई दोष लगाउनेहरूले अपमानको वस्त्र पहिरेका होऊन्, र आफ्नै शर्मको खास्टोले झैँ ढाकिऊन्!<verse eid="PSA 109:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 109:30"/>म मेरा ओठले याहवेहलाई उच्‍च प्रशंसा गर्नेछु; आराधकहरूको ठूलो भीडको बीचमा म उहाँको प्रशंसा गर्नेछु।<verse eid="PSA 109:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 109:31"/>किनकि खाँचोमा परेकाहरूलाई मृत्युदण्ड दिन चाहनेको हातबाट रक्षा गर्नको लागि उहाँ तिनीहरूको दाहिने हातपट्टि खडा हुनुहुन्छ।<verse eid="PSA 109:31"/></para>
<chapter eid="PSA 109"/>
<chapter number="110" style="c" sid="PSA 110"/>
<para style="p"><verse number="1" style="v" sid="PSA 110:1"/>दावीदको भजन। याहवेहले मेरा प्रभुलाई भन्‍नुहुन्छ: “जबसम्म म तिम्रा शत्रुहरूलाई तिम्रा खुट्टाको पाउदान बनाउँदिनँ, तबसम्म तिमी मेरो दाहिने हातपट्टि बस।”<verse eid="PSA 110:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 110:2"/>याहवेहले सियोनबाट यसो भन्दै आफ्नो महान् पराक्रमको राजदण्ड विस्तार गर्नुहुनेछ, “आफ्ना शत्रुहरूका बीच तपाईंले राज्य गर्नुहुनेछ!”<verse eid="PSA 110:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 110:3"/>तपाईंका युद्धको दिनमा तपाईंका प्रजा राजीखुशीले तयार हुनेछन्। पवित्रताको वैभवमा सुशोभित भई, तपाईंका जवानहरू बिहानीको गर्भबाट निस्केको शीतझैँ तपाईंकहाँ आउनेछन्।<verse eid="PSA 110:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 110:4"/>याहवेहले शपथ खानुभएको छ, र उहाँले आफ्नो करार भङ्ग गर्नुहुनेछैन: “तिमी सदासर्वदाको निम्ति, मल्कीसेदेकको दर्जाबमोजिम पुजारी हौ।”<verse eid="PSA 110:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 110:5"/>प्रभु तिम्रो दाहिने हाततर्फ हुनुहुन्छ; उहाँले आफ्नो क्रोधको दिनमा राजाहरूलाई चकनाचुर पार्नुहुनेछ।<verse eid="PSA 110:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 110:6"/>उहाँले लासको थुप्रो लगाएर राष्ट्रहरूको न्याय गर्नुहुनेछ; अनि पृथ्वीका सबै शासकहरूलाई चकनाचुर पार्नुहुनेछ।<verse eid="PSA 110:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 110:7"/>उहाँले बाटो छेउको खोलाबाट पानी पिउनुहुनेछ; यसरी उहाँले आफ्नो शिर उच्‍च पार्नुहुनेछ।<verse eid="PSA 110:7"/></para>
<chapter eid="PSA 110"/>
<chapter number="111" style="c" sid="PSA 111"/>
<para style="p"><verse number="1" style="v" sid="PSA 111:1"/>याहवेहको प्रशंसा गर! म मेरो सारा हृदयले, धर्मी मानिसहरूको सभामा र समुदायमा म याहवेहलाई उच्‍च पार्नेछु।<verse eid="PSA 111:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 111:2"/>याहवेहका कार्यहरू महान् छन्; ती कार्यहरूमा प्रसन्‍न हुनेहरू सबैले तीमाथि मनन गर्छन्।<verse eid="PSA 111:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 111:3"/>उहाँका कार्य महिमामय र ऐश्‍वर्यपूर्ण छन्; र उहाँको धार्मिकता सदासर्वदा रहिरहन्छ।<verse eid="PSA 111:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 111:4"/>उहाँले आफ्ना अद्‌भुत कार्यहरूको स्मरण गराउनुभएको छ; याहवेह अनुग्रही र दयालु हुनुहुन्छ।<verse eid="PSA 111:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 111:5"/>उहाँको भय मान्‍नेहरूलाई उहाँले भोजन जुटाउनुहुन्छ; र उहाँ आफ्नो करार सदासर्वदा सम्झनुहुन्छ।<verse eid="PSA 111:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 111:6"/>अन्य राष्ट्रहरूको भूमि आफ्ना प्रजालाई दिएर, उहाँले तिनीहरूलाई आफ्ना कार्यको शक्ति प्रकट गर्नुभएको छ,<verse eid="PSA 111:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 111:7"/>उहाँका हातका कार्य विश्‍वासयोग्य र न्यायपूर्ण छन्; उहाँका सबै विधिहरू भरपर्दा छन्।<verse eid="PSA 111:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 111:8"/>ती सदासर्वदाको लागि अटल छन्, ती धार्मिकता र विश्‍वासयोग्यतामा लागू गरिएका छन्।<verse eid="PSA 111:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 111:9"/>उहाँले आफ्ना प्रजाको निम्ति छुटकारा उपलब्ध गराउनुभयो; उहाँले आफ्नो करार सदाकालको निम्ति स्थिर होस् भनी आज्ञा दिनुभयो— उहाँको नाम पवित्र र भययोग्य छ।<verse eid="PSA 111:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 111:10"/>याहवेहको भय नै बुद्धिको सुरुवात हो; उहाँका विधिहरू पालन गर्नेहरू सबैले ठिक समझशक्ति पाउँछन्। उहाँको प्रशंसा अनन्तसम्म भइरहनेछ।<verse eid="PSA 111:10"/></para>
<chapter eid="PSA 111"/>
<chapter number="112" style="c" sid="PSA 112"/>
<para style="p"><verse number="1" style="v" sid="PSA 112:1"/>याहवेहको प्रशंसा गर! त्यो मानिस धन्यको हो, जसले याहवेहको भय मान्दछ, जो उहाँका आज्ञाहरूमा ज्यादै प्रसन्‍न हुन्छ।<verse eid="PSA 112:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 112:2"/>त्यसका सन्तानहरू पृथ्वीमाथि शक्तिशाली हुनेछन्; धर्मी मानिसहरूका पुस्ताले आशिष् पाउनेछन्।<verse eid="PSA 112:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 112:3"/>त्यसको घरमा धन र सम्पत्ति रहन्छ, र त्यसको धार्मिकता सदाकाल रहिरहन्छ।<verse eid="PSA 112:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 112:4"/>सत्यनिष्‍ठ मानिसहरू, जो अनुग्रही, दयालु, र धर्मी छन्, तिनीहरूका निम्ति अन्धकारमा पनि ज्योति चम्कन्छ।<verse eid="PSA 112:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 112:5"/>उदार चित्तले ऋण दिनेहरू, र इमानदारीतासाथ आफ्नो कारोबार चलाउने मानिसहरूको भलो हुन्छ।<verse eid="PSA 112:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 112:6"/>अवश्य नै धर्मी जनहरू कहिल्यै डगमगाउनेछैनन्; तिनीहरूको सम्झना सदासर्वदा गरिनेछ।<verse eid="PSA 112:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 112:7"/>खराब समाचारले तिनीहरू कहिल्यै डराउनेछैनन्; याहवेहमा भरोसा गरेकोले तिनीहरूका हृदय दृढ रहन्छ।<verse eid="PSA 112:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 112:8"/>तिनीहरूका हृदय निर्धक्‍क रहन्छ, र तिनीहरूलाई कुनै डर हुनेछैन; अन्त्यमा तिनीहरूले आफ्ना वैरीहरू हार भएको देख्नेछन्।<verse eid="PSA 112:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 112:9"/>तिनीहरूले गरिबहरूलाई उदारतापूर्वक दान दिएका छन्; तिनीहरूका धार्मिकता सदासर्वदा रहिरहन्छ; तिनीहरूका शिर सम्मानले उच्‍च रहनेछ।<verse eid="PSA 112:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 112:10"/>दुष्‍ट मानिस त्यो देखेर कुँडिनेछ; तिनीहरूले आफ्ना दाह्रा किट्नेछन्, र नष्‍ट हुनेछन्; दुष्‍टहरूका अभिलाषाहरू विफल हुन्छन्।<verse eid="PSA 112:10"/></para>
<chapter eid="PSA 112"/>
<chapter number="113" style="c" sid="PSA 113"/>
<para style="p"><verse number="1" style="v" sid="PSA 113:1"/>याहवेहको प्रशंसा गर! हे याहवेहका सेवकहरू हो, उहाँको प्रशंसा गर! याहवेहको नामको प्रशंसा गर!<verse eid="PSA 113:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 113:2"/>अहिलेदेखि लिएर सदासर्वदा, याहवेहको नामको प्रशंसा भइरहोस्!<verse eid="PSA 113:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 113:3"/>सूर्योदयदेखि सूर्यास्तसम्म नै याहवेहको नामको प्रशंसा हुनुपर्छ!<verse eid="PSA 113:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 113:4"/>याहवेह सबै राष्ट्रहरूमाथि सर्वोच्‍च हुनुहुन्छ; र उहाँको महिमा आकाशभन्दा उच्‍च छ।<verse eid="PSA 113:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 113:5"/>याहवेह हाम्रा परमेश्‍वरजस्तो को छ र? उहाँ उच्‍च सिंहासनमा विराजमान हुनुहुन्छ,<verse eid="PSA 113:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 113:6"/>जो स्वर्ग र पृथ्वीलाई हेर्न भनी तल निहुरनुहुन्छ।<verse eid="PSA 113:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 113:7"/>उहाँले गरिबहरूलाई धुलोबाट उठाउनुहुन्छ, अनि खाँचोमा परेकाहरूलाई खरानीको राशबाट उचाल्नुहुन्छ।<verse eid="PSA 113:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 113:8"/>उहाँले तिनीहरूलाई राजकुमारहरूसित, आफ्नै प्रजाका राजकुमारहरूसित बसाउनुहुन्छ।<verse eid="PSA 113:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 113:9"/>उहाँले बाँझी स्त्रीलाई सन्तान दिनुभएर उनलाई सुखी आमाको रूपमा उनको घरमा स्थिर गरिदिनुहुन्छ। याहवेहको प्रशंसा गर!<verse eid="PSA 113:9"/></para>
<chapter eid="PSA 113"/>
<chapter number="114" style="c" sid="PSA 114"/>
<para style="p"><verse number="1" style="v" sid="PSA 114:1"/>जब इस्राएलीहरू इजिप्टबाट निस्किआए, जब याकोबको घराना विदेशी भाषा बोल्ने मानिसहरूका बीचबाट निस्केर आए,<verse eid="PSA 114:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 114:2"/>तब यहूदा परमेश्‍वरको पवित्रस्थान, अनि इस्राएलचाहिँ उहाँको राज्य भयो।<verse eid="PSA 114:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 114:3"/>त्यो देखेर लाल समुद्र भाग्यो; यर्दन नदी पछिल्तिर फर्कियो;<verse eid="PSA 114:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 114:4"/>पर्वतहरू भेडाहरूझैँ, डाँडाहरू थुमाहरूझैँ उफ्रन लागे।<verse eid="PSA 114:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 114:5"/>हे समुद्र, तँ किन भागिस्? हे यर्दन, तँ किन पछि फर्किस्?<verse eid="PSA 114:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 114:6"/>हे पर्वतहरू हो, तिमीहरू भेडाहरूझैँ, हे डाँडाहरू हो, तिमीहरू थुमाहरूझैँ किन उफ्र्यौ?<verse eid="PSA 114:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 114:7"/>हे पृथ्वी, प्रभुको सामु, याकोबका परमेश्‍वरको सामु थरथरी काम्;<verse eid="PSA 114:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 114:8"/>जसले चट्टानलाई पानीका तलाउमा, कठोर चट्टानलाई पानीका मूलहरूमा परिवर्तन गर्नुभयो।<verse eid="PSA 114:8"/></para>
<chapter eid="PSA 114"/>
<chapter number="115" style="c" sid="PSA 115"/>
<para style="p"><verse number="1" style="v" sid="PSA 115:1"/>हाम्रो होइन, हे याहवेह, हाम्रो होइन, तर तपाईंको अचुक प्रेम र विश्‍वसनीयताको कारण, तपाईंकै नामको महिमा होस्!<verse eid="PSA 115:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 115:2"/>राष्ट्रहरूले किन यसो भन्छन्, “तिनीहरूका परमेश्‍वर कहाँ छन्?”<verse eid="PSA 115:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 115:3"/>हाम्रा परमेश्‍वर स्वर्गमा हुनुहुन्छ; उहाँले जे चाहनुहुन्छ, त्यही गर्नुहुन्छ।<verse eid="PSA 115:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 115:4"/>तर तिनीहरूका मूर्तिहरू सुन र चाँदी हुन्, जसलाई मानिसहरूका हातहरूले बनाएका हुन्।<verse eid="PSA 115:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 115:5"/>तिनीहरूका मुख त छन्, तर बोल्न सक्दैनन्; आँखा त छन्, तर देख्न सक्दैनन्;<verse eid="PSA 115:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 115:6"/>तिनीहरूका कान त छन्, तर सुन्‍न सक्दैनन्; नाक त छन्, तर सुँघ्न सक्दैनन्;<verse eid="PSA 115:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 115:7"/>हात त छन्, तर स्पर्श गर्न सक्दैनन्; खुट्टा त छन्, तर हिँड्न सक्दैनन्; न त तिनीहरू आफ्ना गलाबाट कुनै आवाज नै निकाल्न सक्दछन्।<verse eid="PSA 115:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 115:8"/>मूर्तिहरूलाई बनाउनेहरू पनि तिनीहरूजस्तै हुनेछन्; तिनीहरूमाथि भरोसा गर्नेहरू सबै पनि त्यस्तै हुनेछन्।<verse eid="PSA 115:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 115:9"/>हे सारा इस्राएलीहरू हो, याहवेहमा भरोसा गर— उहाँ नै तिनीहरूका सहायक र ढाल हुनुहुन्छ।<verse eid="PSA 115:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 115:10"/>हे हारूनका घराना हो, याहवेहमा भरोसा गर— उहाँ नै तिनीहरूका सहायक र ढाल हुनुहुन्छ।<verse eid="PSA 115:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 115:11"/>याहवेहसँग डराउनेहरू हो, उहाँमा भरोसा गर— उहाँ नै तिनीहरूका सहायक र ढाल हुनुहुन्छ।<verse eid="PSA 115:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 115:12"/>याहवेहले हामीलाई सम्झनुहुन्छ, र हामीलाई आशिष् दिनुहुनेछ; उहाँले आफ्ना प्रजा इस्राएललाई आशिष् दिनुहुनेछ; उहाँले हारूनको घरानालाई आशिष् दिनुहुनेछ।<verse eid="PSA 115:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 115:13"/>उहाँको डर मान्‍ने साना र ठूला सबैलाई याहवेहले आशिष् दिनुहुनेछ।<verse eid="PSA 115:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 115:14"/>याहवेहले तिमीहरूलाई वृद्धि गरून्, तिमीहरू र तिमीहरूका सन्तानहरूलाई।<verse eid="PSA 115:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 115:15"/>याहवेहले तिमीहरूलाई आशिष् देऊन्, जो आकाश र पृथ्वीका सृष्‍टिकर्ता हुनुहुन्छ।<verse eid="PSA 115:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 115:16"/>स्वर्ग याहवेहकै हो, तर पृथ्वीचाहिँ उहाँले मानिस जातिलाई दिनुभएको छ।<verse eid="PSA 115:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 115:17"/>मृतकहरूले याहवेहको प्रशंसा गर्दैनन्; चिर निन्द्रामा जानेहरूले उहाँको प्रशंसा गर्दैनन्;<verse eid="PSA 115:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 115:18"/>तर हामी त अहिले र सदासर्वदा नै याहवेहको स्तुति गर्दछौँ। याहवेहको प्रशंसा गर!<verse eid="PSA 115:18"/></para>
<chapter eid="PSA 115"/>
<chapter number="116" style="c" sid="PSA 116"/>
<para style="p"><verse number="1" style="v" sid="PSA 116:1"/>म याहवेहलाई प्रेम गर्दछु; किनकि उहाँले मेरो सोर सुन्‍नुभयो; उहाँले मेरो दयाको पुकार सुन्‍नुभयो।<verse eid="PSA 116:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 116:2"/>किनकि उहाँले आफ्नो कान मतिर फर्काउनुभयो, म जीवित रहुन्जेल उहाँमा पुकार गर्नेछु।<verse eid="PSA 116:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 116:3"/>मृत्युका पासोहरूले मलाई घेरेका थिए; र चिहानको पीडा ममाथि आइलागेको थियो; दुःख र शोकले मलाई गाँजेको थियो।<verse eid="PSA 116:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 116:4"/>तब मैले याहवेहको नाममा पुकार गरेँ: “हे याहवेह, मलाई बचाउनुहोस्!”<verse eid="PSA 116:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 116:5"/>याहवेह अनुग्रही र धार्मिक हुनुहुन्छ; हाम्रा परमेश्‍वर कृपाले पूर्ण हुनुहुन्छ।<verse eid="PSA 116:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 116:6"/>याहवेहले सोझाहरूलाई रक्षा गर्नुहुन्छ; जब म अति असहाय थिएँ, तब उहाँले मलाई बचाउनुभयो।<verse eid="PSA 116:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 116:7"/>हे मेरो प्राण, फेरि एक पटक विश्राम गर्; किनकि याहवेह तँप्रति भलो हुनुभएको छ।<verse eid="PSA 116:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 116:8"/>किनकि हे याहवेह, तपाईंले मलाई मृत्युदेखि, मेरा आँखालाई आँसुदेखि, र मेरा गोडालाई ठेस लाग्नदेखि जोगाउनुभएको छ।<verse eid="PSA 116:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 116:9"/>ताकि म जीवितहरूका देशमा, याहवेहको सामु हिँड्‍डुल गर्न सकूँ।<verse eid="PSA 116:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 116:10"/>मैले याहवेहमा विश्‍वास गरेँ, यसकारण मैले भनेँ, “म धेरै पीडित छु।”<verse eid="PSA 116:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 116:11"/>अनि आफ्नो व्याकुलतामा मैले भनेँ, “हरेक मानिस झूटो हो।”<verse eid="PSA 116:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 116:12"/>याहवेहले मप्रति गर्नुभएका सम्पूर्ण भलाइको साटोमा, म उहाँलाई के फिर्ता दिन सक्छु र?<verse eid="PSA 116:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 116:13"/>म मुक्तिको कचौरा उठाउनेछु र याहवेहको नाममा पुकार गर्नेछु।<verse eid="PSA 116:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 116:14"/>याहवेहलाई गरेका मेरो भाकलहरू, म उहाँका सारा प्रजाको सामु पूरा गर्नेछु।<verse eid="PSA 116:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 116:15"/>याहवेहको नजरमा, उहाँका विश्‍वासयोग्य जनहरूको मृत्यु अनमोल छ।<verse eid="PSA 116:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 116:16"/>हे याहवेह, साँच्‍चै नै म तपाईंको सेवक हुँ; म तपाईंकी सेविकाको छोरो, तपाईंको सेवक हुँ; तपाईंले मलाई मेरो बन्धनबाट छुटाउनुभएको छ।<verse eid="PSA 116:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 116:17"/>म तपाईंलाई धन्यवादको बलि चढाउनेछु, र याहवेहको नाममा पुकार गर्नेछु।<verse eid="PSA 116:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 116:18"/>याहवेहलाई गरेका मेरा भाकलहरू, म उहाँका सारा प्रजाको सामु पूरा गर्नेछु;<verse eid="PSA 116:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 116:19"/>याहवेहको भवनको चोकहरूमा, हे यरूशलेम, तेरो बीचमा म त्यो पूरा गर्नेछु। याहवेहको प्रशंसा गर!<verse eid="PSA 116:19"/></para>
<chapter eid="PSA 116"/>
<chapter number="117" style="c" sid="PSA 117"/>
<para style="p"><verse number="1" style="v" sid="PSA 117:1"/>हे सारा राष्ट्रहरू हो, याहवेहको प्रशंसा गर; हे सारा जातिहरू हो, उहाँको जयजयकार गर!<verse eid="PSA 117:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 117:2"/>किनकि हामीप्रति उहाँको अचुक प्रेम अपार छ; र याहवेहको विश्‍वासयोग्यता सदासर्वदा रहिरहन्छ। याहवेहको प्रशंसा गर!<verse eid="PSA 117:2"/></para>
<chapter eid="PSA 117"/>
<chapter number="118" style="c" sid="PSA 118"/>
<para style="p"><verse number="1" style="v" sid="PSA 118:1"/>याहवेहलाई धन्यवाद देओ; किनकि उहाँ भलो हुनुहुन्छ; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 118:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 118:2"/>इस्राएलले भनोस्: “उहाँको अचुक प्रेम सदाकाल रहिरहन्छ।”<verse eid="PSA 118:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 118:3"/>हारूनको घरानाले भनोस्: “उहाँको अचुक प्रेम सदाकाल रहिरहन्छ।”<verse eid="PSA 118:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 118:4"/>याहवेहको भय मान्‍नेहरूले भनून्: “उहाँको अचुक प्रेम सदाकाल रहिरहन्छ।”<verse eid="PSA 118:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 118:5"/>मेरो कष्‍टमा मैले याहवेहलाई पुकार गरेँ, उहाँले मलाई जवाफ दिनुभयो, र मलाई विशाल ठाउँमा ल्याउनुभयो।<verse eid="PSA 118:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 118:6"/>याहवेह मेरो साथमा हुनुहुन्छ, म डराउनेछैनँ। मरणशील मानिसले मलाई के गर्न सक्छ र?<verse eid="PSA 118:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 118:7"/>याहवेह मेरो साथमा हुनुहुन्छ; उहाँ मेरा सहायक हुनुहुन्छ। म मेरा शत्रुहरूमाथि विजयको दृष्‍टिले हेर्छु।<verse eid="PSA 118:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 118:8"/>मानिसमाथि भरोसा गर्नुभन्दा त याहवेहमाथि शरण लिनु उत्तम हो।<verse eid="PSA 118:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 118:9"/>राजकुमारहरूमा भरोसा गर्नुभन्दा त याहवेहमाथि शरण लिनु उत्तम हो।<verse eid="PSA 118:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 118:10"/>सम्पूर्ण राष्ट्रहरूले मलाई घेरेका थिए, तर याहवेहका नाममा मैले तिनीहरूलाई नष्‍ट पारेँ।<verse eid="PSA 118:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 118:11"/>तिनीहरूले मलाई घेरेका थिए, हो तिनीहरूले घेरेका थिए, तर याहवेहका नाममा मैले तिनीहरूलाई नष्‍ट पारेँ।<verse eid="PSA 118:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 118:12"/>तिनीहरूले मलाई मौरीहरूले झैँ घेरेका थिए; तर तिनीहरू काँडाहरूमा लागेका आगोझैँ निभिहाले; याहवेहका नाममा मैले तिनीहरूलाई नष्‍ट पारेँ।<verse eid="PSA 118:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 118:13"/>मेरा शत्रुले मलाई घचेटे, र म लड्नै लागेको थिएँ; तर याहवेहले मलाई सहायता गर्नुभयो।<verse eid="PSA 118:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 118:14"/>याहवेह मेरो बल र मेरो रक्षा हुनुहुन्छ, उहाँ मेरो मुक्ति हुनुभएको छ।<verse eid="PSA 118:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 118:15"/>धर्मीहरूका पालहरूमा हर्ष र विजयको सोर गुञ्जिन्छ: “याहवेहका दाहिने बाहुलीबाट पराक्रमका काम भएका छन्!<verse eid="PSA 118:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 118:16"/>याहवेहका दाहिने बाहुली उच्‍च पारिएको छ; याहवेहका दाहिने बाहुलीबाट पराक्रमका काम भएका छन्।”<verse eid="PSA 118:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 118:17"/>म मर्नेछैनँ, तर जीवित रहनेछु, र याहवेहले के गर्नुभएको छ, त्यो घोषणा गर्नेछु।<verse eid="PSA 118:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 118:18"/>याहवेहले मलाई कठोर दण्ड दिनुभएको छ; तर उहाँले मलाई मर्न दिनुभएको छैन।<verse eid="PSA 118:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 118:19"/>मेरा निम्ति धार्मिकताका ढोकाहरू खोलिदिनुहोस्; म तीभित्र पस्‍नेछु र याहवेहलाई धन्यवाद दिनेछु।<verse eid="PSA 118:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 118:20"/>याहवेहको ढोका यही हो, जसबाट धर्मी जनहरू प्रवेश गर्नेछन्।<verse eid="PSA 118:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 118:21"/>म तपाईंलाई धन्यवाद दिनेछु; किनकि तपाईंले मलाई जवाफ दिनुभयो, तपाईं मेरो मुक्ति हुनुभएको छ।<verse eid="PSA 118:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 118:22"/>जुन ढुङ्गालाई भवन निर्माण गर्नेहरूले रद्द गरे, त्यही नै कुनाको मुख्य ढुङ्गा बन्यो;<verse eid="PSA 118:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 118:23"/>यो याहवेहले गर्नुभएको हो; अनि यो हाम्रो दृष्‍टिमा आश्‍चर्यमय छ।<verse eid="PSA 118:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 118:24"/>आजको दिन याहवेहले सृजनुभएको हो; यसमा हामी आनन्द मनाऔँ र रमाऔँ।<verse eid="PSA 118:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 118:25"/>हे याहवेह, हामीलाई बचाउनुहोस्; हे याहवेह, हामीलाई सफलता दिनुहोस्!<verse eid="PSA 118:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 118:26"/>याहवेहको नाममा आउने धन्यको हो, हामी याहवेहको भवनबाट तिमीहरूलाई आशीर्वाद दिन्छौँ।<verse eid="PSA 118:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 118:27"/>याहवेह नै परमेश्‍वर हुनुहुन्छ; र उहाँले आफ्नो ज्योति हामीमाथि चम्काउनुभएको छ। हातमा स्याउला लिएर शोभायात्रामा सहभागी होओ, हर्षकासाथ डोरीहरूले वेदीका सिङहरूमा बाँध!<verse eid="PSA 118:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 118:28"/>तपाईं मेरा परमेश्‍वर हुनुहुन्छ, र म तपाईंलाई धन्यवाद चढाउनेछु; तपाईं मेरा परमेश्‍वर हुनुहुन्छ, र म तपाईंलाई उच्‍च पार्नेछु।<verse eid="PSA 118:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 118:29"/>याहवेहलाई धन्यवाद देओ; किनकि उहाँ भलो हुनुहुन्छ; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 118:29"/></para>
<chapter eid="PSA 118"/>
<chapter number="119" style="c" sid="PSA 119"/>
<para style="p"><verse number="1" style="v" sid="PSA 119:1"/>तिनीहरू धन्यका हुन्, जो निर्दोष जीवन जिउँछन्, जो याहवेहका व्यवस्थाअनुसार हिँड्छन्।<verse eid="PSA 119:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 119:2"/>तिनीहरू धन्यका हुन्, जसले उहाँका कानुनहरू पालन गर्दछन्, र आफ्ना सारा हृदयले उहाँलाई खोज्दछन्।<verse eid="PSA 119:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 119:3"/>तिनीहरूले केही खराबी गर्दैनन्; तर उहाँका मार्गलाई पछ्याउँछन्।<verse eid="PSA 119:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 119:4"/>तपाईंका विधिहरू होशियारपूर्वक पालन गरौँ भनी तपाईंले हामीलाई आज्ञा दिनुभयो।<verse eid="PSA 119:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 119:5"/>अहो, तपाईंका उर्दीहरू पालन गर्नलाई, मेरा मार्गहरू दृढ भइदिए कति असल हुनेथियो!<verse eid="PSA 119:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 119:6"/>तब तपाईंका सम्पूर्ण आज्ञाहरू पालन गरेर म शर्ममा पर्नेथिइनँ।<verse eid="PSA 119:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 119:7"/>जब म तपाईंका धार्मिक नियमहरू सिक्दछु, तब म साँचो हृदयले तपाईंको प्रशंसा गर्नेछु।<verse eid="PSA 119:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 119:8"/>म तपाईंका उर्दीहरू पालन गर्नेछु; मलाई कहिल्यै नत्याग्नुहोस्!<verse eid="PSA 119:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 119:9"/>जवान मानिसले आफ्नो चालचलन कसरी पवित्र राख्न सक्छ? तपाईंको वचनअनुसार जीवन बिताएर नै हो।<verse eid="PSA 119:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 119:10"/>मेरो सारा हृदयले तपाईंलाई खोज्दछु; तपाईंका आज्ञाहरूबाट मलाई तर्केर जान नदिनुहोस्!<verse eid="PSA 119:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 119:11"/>तपाईंको विरुद्धमा पाप नगरूँ भनेर, तपाईंको वचनलाई मैले मेरो हृदयमा लुकाइराखेको छु।<verse eid="PSA 119:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 119:12"/>हे याहवेह, तपाईंको प्रशंसा होस्; तपाईंका उर्दीहरू मलाई सिकाउनुहोस्!<verse eid="PSA 119:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 119:13"/>तपाईंका मुखबाट निस्केका सम्पूर्ण नियमहरू मैले मेरा ओठले वर्णन गरेको छु।<verse eid="PSA 119:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 119:14"/>कसैले धेरै धनसम्पत्तिमा आनन्द गरेझैँ, म तपाईंका कानुनहरू पालन गर्नमा नै आनन्दित हुन्छु।<verse eid="PSA 119:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 119:15"/>म तपाईंका विधिहरूमा मनन गर्छु, र तपाईंका मार्गहरूमा ध्यान दिन्छु।<verse eid="PSA 119:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 119:16"/>म तपाईंका उर्दीहरूमा रमाउनेछु; म तपाईंको वचन बिर्सनेछैनँ।<verse eid="PSA 119:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 119:17"/>आफ्नो सेवकलाई दया गर्नुहोस्; ताकि म जीवित रहन सकूँ र तपाईंको वचन पालन गर्न सकूँ।<verse eid="PSA 119:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 119:18"/>मेरा आँखाहरू खोलिदिनुहोस्, ताकि म तपाईंको व्यवस्थाबाट उदेकका कुराहरू देख्न सकूँ।<verse eid="PSA 119:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 119:19"/>यस पृथ्वीमा म एउटा परदेशी हुँ; तपाईंका आज्ञाहरू मबाट नलुकाउनुहोस्!<verse eid="PSA 119:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 119:20"/>हरपल तपाईंका नियमहरू जान्‍ने तिर्सनाले मेरो प्राण छटपटिन्छ।<verse eid="PSA 119:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 119:21"/>ती अहङ्कारीहरू, जो श्रापित छन्; र तपाईंका आज्ञाहरूबाट भड्किएर हिँड्छन्; तिनीहरूलाई तपाईंले हप्काउनुहुन्छ।<verse eid="PSA 119:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 119:22"/>मबाट तिनीहरूका गिल्‍ला र तिरस्कार हटाउनुहोस्; किनकि म तपाईंका कानुनहरू पालन गर्दछु।<verse eid="PSA 119:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 119:23"/>शासकहरू एकसाथ बसेर मेरो विरुद्धमा जाल रचे तापनि तपाईंको सेवकले तपाईंकै उर्दीहरूमा ध्यान दिनेछ।<verse eid="PSA 119:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 119:24"/>तपाईंका कानुनहरू मेरा आनन्द हुन्; ती मेरा सल्‍लाहकारहरू हुन्।<verse eid="PSA 119:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 119:25"/>म धुलोमा लम्पसार परेको छु; आफ्नो वचनअनुसार मेरो जीवनको रक्षा गर्नुहोस्!<verse eid="PSA 119:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 119:26"/>मैले मेरा चालचलनहरू बताएँ, र तपाईंले मलाई जवाफ दिनुभयो; मलाई तपाईंका उर्दीहरू सिकाउनुहोस्!<verse eid="PSA 119:26"/></para>
<para style="p"><verse number="27" style="v" sid="PSA 119:27"/>मलाई तपाईंका विधिहरूका अर्थ बुझ्ने बनाउनुहोस्; ताकि म तपाईंका अचम्मका कामहरूमा ध्यान दिन सकूँ।<verse eid="PSA 119:27"/></para>
<para style="p"><verse number="28" style="v" sid="PSA 119:28"/>शोकले गर्दा मेरो प्राण थाकेको छ; आफ्नो वचनद्वारा मलाई बलियो पार्नुहोस्!<verse eid="PSA 119:28"/></para>
<para style="p"><verse number="29" style="v" sid="PSA 119:29"/>मलाई छलपूर्ण मार्गबाट जोगाउनुहोस्; ममाथि अनुग्रही बन्‍नुहोस् र मलाई तपाईंको व्यवस्था सिकाउनुहोस्!<verse eid="PSA 119:29"/></para>
<para style="p"><verse number="30" style="v" sid="PSA 119:30"/>मैले विश्‍वासयोग्यताको मार्ग छानेको छु; मैले मेरो हृदय तपाईंका नियमहरूमा लगाएको छु।<verse eid="PSA 119:30"/></para>
<para style="p"><verse number="31" style="v" sid="PSA 119:31"/>हे याहवेह, म तपाईंका कानुनहरूमा दृढ छु; मलाई शर्ममा पर्न नदिनुहोस्!<verse eid="PSA 119:31"/></para>
<para style="p"><verse number="32" style="v" sid="PSA 119:32"/>म तपाईंका आज्ञाहरूका मार्गमा दगुर्छु; किनकि तपाईंले मेरो समझलाई फराकिलो तुल्याउनुभएको छ।<verse eid="PSA 119:32"/></para>
<para style="p"><verse number="33" style="v" sid="PSA 119:33"/>हे याहवेह, मलाई तपाईंका उर्दीहरू पालन गर्न सिकाउनुहोस्; ताकि म अन्त्यसम्मै ती पालन गर्न सकूँ।<verse eid="PSA 119:33"/></para>
<para style="p"><verse number="34" style="v" sid="PSA 119:34"/>मलाई समझशक्ति दिनुहोस्, र म तपाईंको व्यवस्था पालन गर्न सकूँ, र सम्पूर्ण हृदयले म त्यसको पालन गर्न सकूँ।<verse eid="PSA 119:34"/></para>
<para style="p"><verse number="35" style="v" sid="PSA 119:35"/>मलाई तपाईंका आज्ञाहरूका मार्गमा डोर्‍याउनुहोस्; किनकि म त्यसैमा प्रसन्‍न हुन्छु।<verse eid="PSA 119:35"/></para>
<para style="p"><verse number="36" style="v" sid="PSA 119:36"/>मेरो हृदय तपाईंका कानुनहरूतर्फ फर्काइदिनुहोस्! स्वार्थी लाभतर्फ होइन।<verse eid="PSA 119:36"/></para>
<para style="p"><verse number="37" style="v" sid="PSA 119:37"/>व्यर्थका कुराहरू हेर्नदेखि मेरा आँखाहरू फर्काइदिनुहोस्; तपाईंको वचनअनुसार मेरो जीवनको रक्षा गर्नुहोस्!<verse eid="PSA 119:37"/></para>
<para style="p"><verse number="38" style="v" sid="PSA 119:38"/>आफ्ना सेवकलाई गर्नुभएको प्रतिज्ञा पूरा गर्नुहोस्; ताकि तपाईंको भय रहोस्!<verse eid="PSA 119:38"/></para>
<para style="p"><verse number="39" style="v" sid="PSA 119:39"/>जुन अपमानको मलाई डर छ, त्यो हटाउनुहोस्; किनकि तपाईंका नियमहरू असल छन्!<verse eid="PSA 119:39"/></para>
<para style="p"><verse number="40" style="v" sid="PSA 119:40"/>हेर्नुहोस्, म तपाईंका विधिहरूको कति अभिलाषी छु! तपाईंको धार्मिकतामा मेरो जीवनको रक्षा गर्नुहोस्!<verse eid="PSA 119:40"/></para>
<para style="p"><verse number="41" style="v" sid="PSA 119:41"/>हे याहवेह, मलाई तपाईंका अचुक प्रेम मिलोस्, र तपाईंको प्रतिज्ञाअनुसार तपाईंको मुक्ति मकहाँ आओस्!<verse eid="PSA 119:41"/></para>
<para style="p"><verse number="42" style="v" sid="PSA 119:42"/>तब मलाई गिल्‍ला गर्नेहरूलाई म जवाफ दिन सकूँ; किनकि म तपाईंको वचनमा भरोसा राख्दछु।<verse eid="PSA 119:42"/></para>
<para style="p"><verse number="43" style="v" sid="PSA 119:43"/>तपाईंको सत्य वचन मेरा मुखबाट कहिल्यै नखोसिदिनुहोस्; किनकि मैले तपाईंका नियमहरूमा आफ्नो आशा राखेको छु।<verse eid="PSA 119:43"/></para>
<para style="p"><verse number="44" style="v" sid="PSA 119:44"/>म तपाईंको व्यवस्था निरन्तर, सदासर्वदा पालन गर्नेछु।<verse eid="PSA 119:44"/></para>
<para style="p"><verse number="45" style="v" sid="PSA 119:45"/>म स्वतन्त्र भएर हिँड्‍डुल गर्नेछु; किनकि मैले तपाईंका विधिहरूको खोजी गरेको छु।<verse eid="PSA 119:45"/></para>
<para style="p"><verse number="46" style="v" sid="PSA 119:46"/>म तपाईंका कानुनहरूका विषयमा राजाहरूका सामु बोल्नेछु, र म लाजमा पर्नेछैनँ।<verse eid="PSA 119:46"/></para>
<para style="p"><verse number="47" style="v" sid="PSA 119:47"/>किनकि म तपाईंका आज्ञाहरूमा रमाउँछु; किनकि म तिनलाई प्रेम गर्दछु।<verse eid="PSA 119:47"/></para>
<para style="p"><verse number="48" style="v" sid="PSA 119:48"/>मैले प्रेम गरेका तपाईंका आज्ञाहरूतर्फ मेरा आफ्ना हातहरू उचाल्छु; ताकि म तपाईंका उर्दीहरूमाथि मनन गर्न सकूँ।<verse eid="PSA 119:48"/></para>
<para style="p"><verse number="49" style="v" sid="PSA 119:49"/>तपाईंका सेवकलाई दिनुभएको वचन सम्झना गर्नुहोस्; किनकि तपाईंले मलाई आशा दिनुभएको छ।<verse eid="PSA 119:49"/></para>
<para style="p"><verse number="50" style="v" sid="PSA 119:50"/>मेरो कष्‍टमा मेरो सान्त्वना यही छ: तपाईंका प्रतिज्ञाले मेरो जीवनको रक्षा गर्दछ।<verse eid="PSA 119:50"/></para>
<para style="p"><verse number="51" style="v" sid="PSA 119:51"/>अहङ्कारीहरू निर्दयी भएर मेरो हाँसो गर्छन्; तर म तपाईंका व्यवस्थाबाट तर्केर जादिनँ।<verse eid="PSA 119:51"/></para>
<para style="p"><verse number="52" style="v" sid="PSA 119:52"/>हे याहवेह, म तपाईंका प्राचीन कालदेखिका नियमहरू स्मरण गर्दछु, अनि म तिनमा सान्त्वना पाउँदछु।<verse eid="PSA 119:52"/></para>
<para style="p"><verse number="53" style="v" sid="PSA 119:53"/>तपाईंको व्यवस्था त्याग्ने दुष्‍टहरूले गर्दा, मलाई असाध्यै रिस उठेको छ।<verse eid="PSA 119:53"/></para>
<para style="p"><verse number="54" style="v" sid="PSA 119:54"/>म जहाँ बसोबास गरेँ तापनि तपाईंका उर्दीहरू मेरा गीतका विषयवस्तु भएका छन्।<verse eid="PSA 119:54"/></para>
<para style="p"><verse number="55" style="v" sid="PSA 119:55"/>हे याहवेह, रातको समयमा म तपाईंको नामको स्मरण गर्दछु, ताकि म तपाईंको व्यवस्था पालन गर्न सकूँ।<verse eid="PSA 119:55"/></para>
<para style="p"><verse number="56" style="v" sid="PSA 119:56"/>तपाईंका विधिहरू पालन गर्नु नै मेरो आचरण हुन गएको छ।<verse eid="PSA 119:56"/></para>
<para style="p"><verse number="57" style="v" sid="PSA 119:57"/>हे याहवेह, तपाईं मेरो भाग हुनुहुन्छ; तपाईंका वचनहरू पालन गर्नेछु भनी मैले प्रतिज्ञा गरेको छु।<verse eid="PSA 119:57"/></para>
<para style="p"><verse number="58" style="v" sid="PSA 119:58"/>मैले आफ्नो सारा हृदयले तपाईंको मुहारको खोजी गरेको छु; तपाईंको प्रतिज्ञाअनुसार ममाथि अनुग्रही बन्‍नुहोस्!<verse eid="PSA 119:58"/></para>
<para style="p"><verse number="59" style="v" sid="PSA 119:59"/>मैले आफ्ना आचरणहरूको बारेमा विचार गरेँ, अनि आफ्ना कदमहरू तपाईंका कानुनहरूतर्फ चालेको छु।<verse eid="PSA 119:59"/></para>
<para style="p"><verse number="60" style="v" sid="PSA 119:60"/>तपाईंका आज्ञाहरू पालन गर्न म हतारिनेछु, र ढिलो गर्नेछैनँ।<verse eid="PSA 119:60"/></para>
<para style="p"><verse number="61" style="v" sid="PSA 119:61"/>दुष्‍टहरूले मलाई डोरीहरूले बाँधे तापनि म तपाईंका व्यवस्था बिर्सनेछैनँ।<verse eid="PSA 119:61"/></para>
<para style="p"><verse number="62" style="v" sid="PSA 119:62"/>तपाईंका धार्मिक नियमहरूका निम्ति तपाईंलाई धन्यवाद चढाउन म मध्यरातमा उठ्दछु।<verse eid="PSA 119:62"/></para>
<para style="p"><verse number="63" style="v" sid="PSA 119:63"/>म तपाईंको भय मान्‍नेहरू र तपाईंका विधिहरू पालन गर्नेहरू सबैको मित्र हुँ।<verse eid="PSA 119:63"/></para>
<para style="p"><verse number="64" style="v" sid="PSA 119:64"/>हे याहवेह, पृथ्वी तपाईंको अचुक प्रेमले भरिपूर्ण छ; मलाई तपाईंका उर्दीहरू सिकाउनुहोस्!<verse eid="PSA 119:64"/></para>
<para style="p"><verse number="65" style="v" sid="PSA 119:65"/>हे याहवेह, तपाईंले आफ्नो वचनअनुसार आफ्नो सेवकको भलाइ गर्नुहोस्।<verse eid="PSA 119:65"/></para>
<para style="p"><verse number="66" style="v" sid="PSA 119:66"/>मलाई ज्ञान र बुद्धिका कुरा सिकाउनुहोस्; किनकि म तपाईंका आज्ञाहरूमाथि विश्‍वास गर्दछु।<verse eid="PSA 119:66"/></para>
<para style="p"><verse number="67" style="v" sid="PSA 119:67"/>दुःख पाउनुअगि मैले बाटो बिराएको थिएँ, तर अब म तपाईंको वचन पालन गर्दछु।<verse eid="PSA 119:67"/></para>
<para style="p"><verse number="68" style="v" sid="PSA 119:68"/>तपाईं भलो हुनुहुन्छ, र तपाईं जे गर्नुहुन्छ, भलो नै गर्नुहुन्छ; मलाई तपाईंका उर्दीहरू सिकाउनुहोस्!<verse eid="PSA 119:68"/></para>
<para style="p"><verse number="69" style="v" sid="PSA 119:69"/>अहङ्कारीहरूका झूटले मलाई कलङ्कित पारे तापनि मेरो सारा हृदयले तपाईंका विधिहरू पालन गर्दछु।<verse eid="PSA 119:69"/></para>
<para style="p"><verse number="70" style="v" sid="PSA 119:70"/>तिनीहरूका हृदय कठोर र निर्दयी भएका छन्, तर मचाहिँ तपाईंको व्यवस्थामा प्रसन्‍न हुन्छु।<verse eid="PSA 119:70"/></para>
<para style="p"><verse number="71" style="v" sid="PSA 119:71"/>दुःख भोग्नु मेरा लागि असलै भयो, ताकि यसरी नै मैले तपाईंका उर्दीहरू सिक्न सकूँ।<verse eid="PSA 119:71"/></para>
<para style="p"><verse number="72" style="v" sid="PSA 119:72"/>तपाईंको मुखबाट निस्केका व्यवस्था, मेरा निम्ति हजारौँ चाँदी र सुनका टुक्राहरूभन्दा ज्यादा मूल्यवान् छन्।<verse eid="PSA 119:72"/></para>
<para style="p"><verse number="73" style="v" sid="PSA 119:73"/>तपाईंका हातहरूले मलाई बनाएका र आकार दिएका हुन्; तपाईंका आज्ञाहरू सिक्ने समझशक्ति मलाई दिनुहोस्।<verse eid="PSA 119:73"/></para>
<para style="p"><verse number="74" style="v" sid="PSA 119:74"/>तपाईंको भय मान्‍नेहरू मलाई देखेर खुशी होऊन्; किनकि मैले मेरो आशा तपाईंको वचनमा राखेको छु।<verse eid="PSA 119:74"/></para>
<para style="p"><verse number="75" style="v" sid="PSA 119:75"/>हे याहवेह, म जान्दछु, तपाईंका नियमहरू धार्मिक छन्, र आफ्नो विश्‍वसतामा तपाईंले मलाई ताडना दिनुभएको छ।<verse eid="PSA 119:75"/></para>
<para style="p"><verse number="76" style="v" sid="PSA 119:76"/>आफ्नो सेवकलाई गर्नुभएको प्रतिज्ञाअनुसार तपाईंको अचुक प्रेम मेरो सान्त्वना बनोस्!<verse eid="PSA 119:76"/></para>
<para style="p"><verse number="77" style="v" sid="PSA 119:77"/>तपाईंको कृपा ममाथि रहोस्, ताकि म जीवित रहन सकूँ; किनकि म तपाईंको व्यवस्थामा नै रमाउँदछु।<verse eid="PSA 119:77"/></para>
<para style="p"><verse number="78" style="v" sid="PSA 119:78"/>कारणविना मलाई दोष लगाएका हुनाले अहङ्कारीहरू शर्ममा परून्; तर मचाहिँ तपाईंका विधिहरूमा मनन गर्नेछु।<verse eid="PSA 119:78"/></para>
<para style="p"><verse number="79" style="v" sid="PSA 119:79"/>तपाईंको डर मान्‍नेहरू, र तपाईंका कानुन बुझ्नेहरू मतिर फर्कून्।<verse eid="PSA 119:79"/></para>
<para style="p"><verse number="80" style="v" sid="PSA 119:80"/>मेरो निर्दोष हृदयले तपाईंका उर्दीहरू पालन गर्न सकूँ, ताकि म शर्ममा नपरूँ!<verse eid="PSA 119:80"/></para>
<para style="p"><verse number="81" style="v" sid="PSA 119:81"/>मेरो प्राण तपाईंको मुक्ति प्राप्‍त गर्ने तिर्सनामा व्याकुल छ; तर मैले आफ्नो आशा तपाईंको वचनमा राखेको छु।<verse eid="PSA 119:81"/></para>
<para style="p"><verse number="82" style="v" sid="PSA 119:82"/>तपाईंको प्रतिज्ञाको प्रतीक्षा गर्दागर्दै मेरा आँखाहरू धमिला भइसकेका छन्; म सोध्छु, “तपाईंले मलाई कहिले सान्त्वना दिनुहुन्छ?”<verse eid="PSA 119:82"/></para>
<para style="p"><verse number="83" style="v" sid="PSA 119:83"/>म धुवाँमा राख्दा-राख्दै खुम्चिएको दाखमद्यको मशकझैँ भएँ; तापनि मैले तपाईंका उर्दीहरू बिर्सेको छैनँ।<verse eid="PSA 119:83"/></para>
<para style="p"><verse number="84" style="v" sid="PSA 119:84"/>तपाईंको सेवकले कहिलेसम्म पर्खनुपर्छ? मलाई खेदो गर्नेहरूलाई कहिले दण्ड दिनुहुन्छ?<verse eid="PSA 119:84"/></para>
<para style="p"><verse number="85" style="v" sid="PSA 119:85"/>तपाईंको व्यवस्थाको विरोध गर्ने अहङ्कारीहरूले मलाई पासोमा पार्न खाडल खनेका छन्।<verse eid="PSA 119:85"/></para>
<para style="p"><verse number="86" style="v" sid="PSA 119:86"/>तपाईंका सारा आज्ञाहरू भरोसायोग्यका छन्; मलाई मदत गर्नुहोस्, म कारणविना सताइएको छु।<verse eid="PSA 119:86"/></para>
<para style="p"><verse number="87" style="v" sid="PSA 119:87"/>तिनीहरूले झण्डै मलाई पृथ्वीबाट नाश गरे; तर मैले तपाईंका विधिहरू त्यागेको छैनँ।<verse eid="PSA 119:87"/></para>
<para style="p"><verse number="88" style="v" sid="PSA 119:88"/>तपाईंको अचुक प्रेमअनुसार मेरो जीवनको रक्षा गर्नुहोस्; ताकि म तपाईंको मुखबाट निस्केका कानुनहरू पालन गर्न सकूँ।<verse eid="PSA 119:88"/></para>
<para style="p"><verse number="89" style="v" sid="PSA 119:89"/>हे याहवेह, तपाईंको वचन अनन्त छ; यो स्वर्गमा सदैव दृढ रहन्छ।<verse eid="PSA 119:89"/></para>
<para style="p"><verse number="90" style="v" sid="PSA 119:90"/>तपाईंको विश्‍वासयोग्यता पुस्तौँ-पुस्तासम्म रहिरहन्छ; तपाईंले नै पृथ्वीलाई स्थापित गर्नुभयो; अनि यो स्थिर रहन्छ।<verse eid="PSA 119:90"/></para>
<para style="p"><verse number="91" style="v" sid="PSA 119:91"/>तपाईंका नियमहरू आजको दिनसम्म स्थिर छन्; किनकि सबै सृष्‍टिले तपाईंको सेवा गर्दछन्।<verse eid="PSA 119:91"/></para>
<para style="p"><verse number="92" style="v" sid="PSA 119:92"/>तपाईंको व्यवस्थामा मेरो निम्ति आनन्द नहुँदो हो त म आफ्नो पीडामा नष्‍ट भइसकेको हुन्थेँ।<verse eid="PSA 119:92"/></para>
<para style="p"><verse number="93" style="v" sid="PSA 119:93"/>तपाईंका विधिहरू म कहिल्यै बिर्सनेछैनँ; किनकि तीद्वारा नै तपाईंले मेरो जीवनको रक्षा गर्नुभएको छ।<verse eid="PSA 119:93"/></para>
<para style="p"><verse number="94" style="v" sid="PSA 119:94"/>मलाई बचाउनुहोस्; किनकि म तपाईंकै हुँ; मैले तपाईंका विधिहरूको खोजी गरेको छु।<verse eid="PSA 119:94"/></para>
<para style="p"><verse number="95" style="v" sid="PSA 119:95"/>दुष्‍टहरूले मलाई नाश गर्न ढुकेर बसेका छन्; तर मचाहिँ तपाईंका कानुनहरूमा ध्यान दिनेछु।<verse eid="PSA 119:95"/></para>
<para style="p"><verse number="96" style="v" sid="PSA 119:96"/>हरेक सिद्धताको पनि सीमा भएको मैले देखेको छु; तर तपाईंका आज्ञाहरू असीमित छन्।<verse eid="PSA 119:96"/></para>
<para style="p"><verse number="97" style="v" sid="PSA 119:97"/>अहो, तपाईंको व्यवस्थालाई म कति प्रेम गर्दछु! दिनभरि म त्यसमा नै ध्यान गर्दछु।<verse eid="PSA 119:97"/></para>
<para style="p"><verse number="98" style="v" sid="PSA 119:98"/>तपाईंका आज्ञाहरू सधैँ मसँग छन्, र तिनले मेरा शत्रुहरूभन्दा मलाई बुद्धिमान् तुल्याउँछन्।<verse eid="PSA 119:98"/></para>
<para style="p"><verse number="99" style="v" sid="PSA 119:99"/>मेरा सबै शिक्षकहरूभन्दा मेरो अन्तर्दृष्‍टि ज्यादा छ; किनकि म तपाईंका कानुनहरूमा मनन गर्दछु।<verse eid="PSA 119:99"/></para>
<para style="p"><verse number="100" style="v" sid="PSA 119:100"/>सबै प्रधानहरूभन्दा मेरो समझशक्ति ज्यादा छ; किनकि म तपाईंका विधिहरू पालन गर्दछु।<verse eid="PSA 119:100"/></para>
<para style="p"><verse number="101" style="v" sid="PSA 119:101"/>तपाईंको वचन पालन गर्न सकूँ भनेर मैले आफ्ना खुट्टाहरूलाई हरेक खराब मार्गदेखि अलग्गै राखेको छु।<verse eid="PSA 119:101"/></para>
<para style="p"><verse number="102" style="v" sid="PSA 119:102"/>तपाईंका नियमहरूबाट म तर्केर हिँडेको छैनँ; किनकि तपाईं आफैँले नै मलाई सिकाउनुभएको छ।<verse eid="PSA 119:102"/></para>
<para style="p"><verse number="103" style="v" sid="PSA 119:103"/>तपाईंका वचनहरू मेरो लागि कति स्वादिष्‍ठ छन्; मेरो मुखमा ती महभन्दा पनि बढी मिठा छन्!<verse eid="PSA 119:103"/></para>
<para style="p"><verse number="104" style="v" sid="PSA 119:104"/>तपाईंका विधिहरूबाट म समझशक्ति प्राप्‍त गर्दछु; त्यसकारण म सबै खराब मार्गहरूलाई घृणा गर्दछु।<verse eid="PSA 119:104"/></para>
<para style="p"><verse number="105" style="v" sid="PSA 119:105"/>तपाईंको वचन मेरा खुट्टाहरूका निम्ति बत्ती, र मेरो बाटोका निम्ति ज्योति हो।<verse eid="PSA 119:105"/></para>
<para style="p"><verse number="106" style="v" sid="PSA 119:106"/>मैले शपथ खाएर त्यसलाई पक्‍का गरेको छु, ताकि म तपाईंका धार्मिक नियमहरू पालन गर्नेछु।<verse eid="PSA 119:106"/></para>
<para style="p"><verse number="107" style="v" sid="PSA 119:107"/>मैले ज्यादै कष्‍ट भोगेको छु; हे याहवेह, आफ्ना वचनअनुसार मेरो जीवनको रक्षा गर्नुहोस्!<verse eid="PSA 119:107"/></para>
<para style="p"><verse number="108" style="v" sid="PSA 119:108"/>हे याहवेह, स्वेच्छाले मैले आफ्नो मुखले चढाएको प्रशंसा ग्रहण गर्नुहोस्, र मलाई तपाईंका नियमहरू सिकाउनुहोस्!<verse eid="PSA 119:108"/></para>
<para style="p"><verse number="109" style="v" sid="PSA 119:109"/>मेरो प्राण निरन्तर जोखिममा रहन्छ; तापनि म तपाईंको व्यवस्था बिर्संनेछैनँ।<verse eid="PSA 119:109"/></para>
<para style="p"><verse number="110" style="v" sid="PSA 119:110"/>दुष्‍टहरूले मेरो निम्ति पासो थापेका छन्; तर पनि म तपाईंका विधिहरूबाट तर्केको छैनँ।<verse eid="PSA 119:110"/></para>
<para style="p"><verse number="111" style="v" sid="PSA 119:111"/>तपाईंका कानुनहरू सदाकाल मेरा निम्ति उत्तराधिकारको अंश भएका छन्। त्यो नै मेरो हृदयको आनन्द हो।<verse eid="PSA 119:111"/></para>
<para style="p"><verse number="112" style="v" sid="PSA 119:112"/>तपाईंका उर्दीहरू अन्त्यसम्म नै पालन गर्न मेरो हृदयले अठोट गरेको छ।<verse eid="PSA 119:112"/></para>
<para style="p"><verse number="113" style="v" sid="PSA 119:113"/>दोहोरो मन भएका मानिसहरूलाई म घृणा गर्दछु; तर तपाईंको व्यवस्थालाई म प्रेम गर्दछु।<verse eid="PSA 119:113"/></para>
<para style="p"><verse number="114" style="v" sid="PSA 119:114"/>तपाईं मेरो शरणस्थान र मेरो ढाल हुनुहुन्छ; तपाईंको वचनमा मैले आफ्नो आशा राखेको छु।<verse eid="PSA 119:114"/></para>
<para style="p"><verse number="115" style="v" sid="PSA 119:115"/>हे दुष्कर्मीहरू हो, मबाट टाढा होइजाओ; ताकि म मेरा परमेश्‍वरका आज्ञाहरू पालन गर्न सकूँ!<verse eid="PSA 119:115"/></para>
<para style="p"><verse number="116" style="v" sid="PSA 119:116"/>मेरा परमेश्‍वर, मलाई तपाईंको प्रतिज्ञाअनुसार थामिराख्नुहोस्, र म जीवित रहनेछु; अनि मेरो आशाहरू चकनाचुर हुन नदिनुहोस्!<verse eid="PSA 119:116"/></para>
<para style="p"><verse number="117" style="v" sid="PSA 119:117"/>मलाई साथ दिनुहोस्, र मेरो उद्धार हुनेछ; म सधैँ तपाईंका उर्दीहरूमा अझ ध्यान दिनेछु।<verse eid="PSA 119:117"/></para>
<para style="p"><verse number="118" style="v" sid="PSA 119:118"/>तपाईंका उर्दीहरूबाट तर्केर जानेहरूलाई तपाईंले इन्कार गर्नुहुन्छ; किनकि तिनीहरूको धूर्तता व्यर्थ हुन्छ।<verse eid="PSA 119:118"/></para>
<para style="p"><verse number="119" style="v" sid="PSA 119:119"/>पृथ्वीका सबै दुष्‍टहरूलाई तपाईंले धातुको अशुद्धताझैँ फालिदिनुहुन्छ; यसैले म तपाईंका विधिहरूलाई प्रेम गर्दछु।<verse eid="PSA 119:119"/></para>
<para style="p"><verse number="120" style="v" sid="PSA 119:120"/>तपाईंको भयले मेरो शरीर काम्दछ; म तपाईंका नियमहरूले भयभीत हुन्छु।<verse eid="PSA 119:120"/></para>
<para style="p"><verse number="121" style="v" sid="PSA 119:121"/>जे धार्मिक र न्यायपूर्ण छ, मैले त्यही गरेको छु; मलाई अत्याचार गर्नेहरूका हातमा नछोडिदिनुहोस्!<verse eid="PSA 119:121"/></para>
<para style="p"><verse number="122" style="v" sid="PSA 119:122"/>तपाईंको सेवकको भलाइ सुनिश्‍चित गरिदिनुहोस्; अहङ्कारीहरूले मलाई अत्याचार गर्न नपाऊन्!<verse eid="PSA 119:122"/></para>
<para style="p"><verse number="123" style="v" sid="PSA 119:123"/>तपाईंको मुक्ति र तपाईंको धार्मिक प्रतिज्ञाको प्रतीक्षा गर्दागर्दै मेरा आँखाहरू धमिला भइसकेका छन्।<verse eid="PSA 119:123"/></para>
<para style="p"><verse number="124" style="v" sid="PSA 119:124"/>आफ्नो अचुक प्रेमअनुसार आफ्ना सेवकसँग व्यवहार गर्नुहोस्, अनि मलाई तपाईंका उर्दीहरू सिकाउनुहोस्!<verse eid="PSA 119:124"/></para>
<para style="p"><verse number="125" style="v" sid="PSA 119:125"/>म तपाईंको सेवक हुँ; मलाई अन्तर्दृष्‍टि दिनुहोस्, ताकि म तपाईंका कानुनहरू बुझ्न सकूँ!<verse eid="PSA 119:125"/></para>
<para style="p"><verse number="126" style="v" sid="PSA 119:126"/>हे याहवेह, अब तपाईंले काम गर्ने समय आएको छ; तपाईंको व्यवस्था भङ्ग भएको छ।<verse eid="PSA 119:126"/></para>
<para style="p"><verse number="127" style="v" sid="PSA 119:127"/>किनकि मैले तपाईंका आज्ञाहरूलाई सुन, र निखुर सुनभन्दा पनि बढी प्रेम गर्दछु,<verse eid="PSA 119:127"/></para>
<para style="p"><verse number="128" style="v" sid="PSA 119:128"/>किनकि म तपाईंका सम्पूर्ण विधिहरू उचित ठान्दछु; अनि हरेक खराब मार्गलाई म घृणा गर्दछु।<verse eid="PSA 119:128"/></para>
<para style="p"><verse number="129" style="v" sid="PSA 119:129"/>तपाईंका कानुनहरू अद्‌भुत छन्; त्यसैले तिनलाई म पालन गर्छु।<verse eid="PSA 119:129"/></para>
<para style="p"><verse number="130" style="v" sid="PSA 119:130"/>तपाईंका वचनहरूको अर्थ खोलिँदा ज्योति चम्कन्छ; त्यसले सोझाहरूलाई समझशक्ति दिन्छ।<verse eid="PSA 119:130"/></para>
<para style="p"><verse number="131" style="v" sid="PSA 119:131"/>म तपाईंका आज्ञाहरूका तिर्सनाले आफ्नो मुख खोल्छु, र सुस्केरा हाल्दछु।<verse eid="PSA 119:131"/></para>
<para style="p"><verse number="132" style="v" sid="PSA 119:132"/>तपाईंको नामलाई प्रेम गर्नेहरूलाई तपाईंले सदा गरेझैँ, मतिर फर्कनुहोस् र ममाथि दया गर्नुहोस्!<verse eid="PSA 119:132"/></para>
<para style="p"><verse number="133" style="v" sid="PSA 119:133"/>तपाईंको वचनअनुसार मेरा पाइलाहरूलाई डोर्‍याउनुहोस्; र कुनै पापले ममाथि राज्य नगरोस्!<verse eid="PSA 119:133"/></para>
<para style="p"><verse number="134" style="v" sid="PSA 119:134"/>मानिसका अत्याचारबाट मलाई मोल तिरेर छुटाउनुहोस्, ताकि म तपाईंका विधिहरू पालन गर्न सकूँ।<verse eid="PSA 119:134"/></para>
<para style="p"><verse number="135" style="v" sid="PSA 119:135"/>तपाईंको सेवकमाथि आफ्नो मुहार चम्काउनुहोस्; र तपाईंका उर्दीहरू मलाई सिकाउनुहोस्!<verse eid="PSA 119:135"/></para>
<para style="p"><verse number="136" style="v" sid="PSA 119:136"/>मेरा आँखाहरूबाट आँसुका धारा बग्छन्; किनकि तपाईंको व्यवस्था पालन गरिएको छैन।<verse eid="PSA 119:136"/></para>
<para style="p"><verse number="137" style="v" sid="PSA 119:137"/>हे याहवेह, तपाईं धर्मी हुनुहुन्छ, अनि तपाईंका नियमहरू सही छन्।<verse eid="PSA 119:137"/></para>
<para style="p"><verse number="138" style="v" sid="PSA 119:138"/>तपाईंले स्थापित गर्नुभएका कानुनहरू धार्मिक छन्; तिनीहरू पूर्ण रूपले भरपर्दा छन्।<verse eid="PSA 119:138"/></para>
<para style="p"><verse number="139" style="v" sid="PSA 119:139"/>मेरो जोशले मलाई खाइसकेको छ; किनकि मेरा शत्रुहरूले तपाईंका वचनहरू वास्ता गर्दैनन्।<verse eid="PSA 119:139"/></para>
<para style="p"><verse number="140" style="v" sid="PSA 119:140"/>तपाईंका प्रतिज्ञाहरू सम्पूर्ण रूपले जाँच गरिएका छन्; र तपाईंको सेवकले तिनलाई प्रेम गर्दछ।<verse eid="PSA 119:140"/></para>
<para style="p"><verse number="141" style="v" sid="PSA 119:141"/>म क्षुद्र र तुच्छ छु; तापनि म तपाईंका विधिहरू बिर्संदिनँ।<verse eid="PSA 119:141"/></para>
<para style="p"><verse number="142" style="v" sid="PSA 119:142"/>तपाईंको धार्मिकता अनन्तकाल छ; अनि तपाईंको व्यवस्था सत्य छ।<verse eid="PSA 119:142"/></para>
<para style="p"><verse number="143" style="v" sid="PSA 119:143"/>ममाथि दुःख र कष्‍ट आइलागेका छन्; तर तपाईंका आज्ञाहरूले मलाई हर्षित बनाउँछन्।<verse eid="PSA 119:143"/></para>
<para style="p"><verse number="144" style="v" sid="PSA 119:144"/>तपाईंका कानुनहरू सदा धार्मिक छन्; मलाई समझशक्ति दिनुहोस्, ताकि म जीवित रहन सकूँ।<verse eid="PSA 119:144"/></para>
<para style="p"><verse number="145" style="v" sid="PSA 119:145"/>हे याहवेह, मेरो सारा हृदयले तपाईंलाई पुकार्छु; मलाई जवाफ दिनुहोस्; र म तपाईंका उर्दीहरू पालन गर्नेछु।<verse eid="PSA 119:145"/></para>
<para style="p"><verse number="146" style="v" sid="PSA 119:146"/>म तपाईंलाई पुकार्छु; मलाई बचाउनुहोस्, अनि म तपाईंका कानुनहरू पालन गर्नेछु।<verse eid="PSA 119:146"/></para>
<para style="p"><verse number="147" style="v" sid="PSA 119:147"/>म सूर्योदय हुन अगि नै उठेर सहयोगको लागि पुकार्छु; मैले तपाईंको वचनमाथि आशा राखेको छु।<verse eid="PSA 119:147"/></para>
<para style="p"><verse number="148" style="v" sid="PSA 119:148"/>तपाईंका प्रतिज्ञाहरूमा मनन गरूँ भनेर मेरा आँखाहरू रातका पहरहरूमा खुल्‍ला रहन्छन्।<verse eid="PSA 119:148"/></para>
<para style="p"><verse number="149" style="v" sid="PSA 119:149"/>तपाईंको अचुक प्रेमअनुसार मेरो सोर सुन्‍नुहोस्; हे याहवेह, तपाईंका नियमअनुसार मेरो जीवनको रक्षा गर्नुहोस्!<verse eid="PSA 119:149"/></para>
<para style="p"><verse number="150" style="v" sid="PSA 119:150"/>दुष्‍ट योजना रच्नेहरू मेरो नजिकै छन्; तर तिनीहरू तपाईंको व्यवस्थाबाट टाढा छन्।<verse eid="PSA 119:150"/></para>
<para style="p"><verse number="151" style="v" sid="PSA 119:151"/>हे याहवेह, अझै पनि तपाईं नजिकै हुनुहुन्छ; र तपाईंका सबै आज्ञाहरू सत्य छन्।<verse eid="PSA 119:151"/></para>
<para style="p"><verse number="152" style="v" sid="PSA 119:152"/>धेरै अगिदेखि नै मैले तपाईंका कानुनहरूबाट सिकेको छु, कि तपाईंले तिनीहरूलाई सदाकालको निम्ति स्थापित गर्नुभएको छ।<verse eid="PSA 119:152"/></para>
<para style="p"><verse number="153" style="v" sid="PSA 119:153"/>मेरो दुःखलाई हेर्नुहोस्, र मलाई छुटकारा दिनुहोस्; किनकि मैले तपाईंको व्यवस्थालाई बिर्सेको छैनँ।<verse eid="PSA 119:153"/></para>
<para style="p"><verse number="154" style="v" sid="PSA 119:154"/>मेरो पक्षमा बोल्नुहोस्, र मलाई उद्धार गर्नुहोस्; तपाईंको प्रतिज्ञाअनुसार मेरो जीवनको रक्षा गर्नुहोस्!<verse eid="PSA 119:154"/></para>
<para style="p"><verse number="155" style="v" sid="PSA 119:155"/>दुष्‍टहरूदेखि मुक्ति टाढा छ; किनकि तिनीहरूले तपाईंका उर्दीहरूको खोजी गर्दैनन्।<verse eid="PSA 119:155"/></para>
<para style="p"><verse number="156" style="v" sid="PSA 119:156"/>हे याहवेह, तपाईंको कृपा महान् छन्; तपाईंका नियमअनुसार मेरो जीवनको रक्षा गर्नुहोस्!<verse eid="PSA 119:156"/></para>
<para style="p"><verse number="157" style="v" sid="PSA 119:157"/>मलाई सताउने मेरा वैरीहरू धेरै छन्; तर म तपाईंका कानुनहरूबाट तर्केको छैनँ।<verse eid="PSA 119:157"/></para>
<para style="p"><verse number="158" style="v" sid="PSA 119:158"/>विश्‍वासघातीहरूलाई म घृणाको दृष्‍टिले हेर्छु; किनकि तिनीहरूले तपाईंको वचन पालन गर्दैनन्।<verse eid="PSA 119:158"/></para>
<para style="p"><verse number="159" style="v" sid="PSA 119:159"/>हेर्नुहोस्, म कसरी तपाईंका विधिहरूलाई प्रेम गर्दछु; हे याहवेह, तपाईंको अचुक प्रेमअनुसार मेरो जीवनको रक्षा गर्नुहोस्!<verse eid="PSA 119:159"/></para>
<para style="p"><verse number="160" style="v" sid="PSA 119:160"/>तपाईंका सम्पूर्ण वचनहरू सत्य छन्; तपाईंका सबै धार्मिक नियमहरू अनन्तका छन्।<verse eid="PSA 119:160"/></para>
<para style="p"><verse number="161" style="v" sid="PSA 119:161"/>शासकहरूले कारणविना मलाई खेदो गर्दछन्; तर मेरो हृदयले तपाईंको वचनको भय मान्दछ।<verse eid="PSA 119:161"/></para>
<para style="p"><verse number="162" style="v" sid="PSA 119:162"/>जसरी लुटको ठूलो धन पाउने व्यक्ति रमाउँछ, त्यसरी नै म तपाईंको प्रतिज्ञामा रमाउँदछु।<verse eid="PSA 119:162"/></para>
<para style="p"><verse number="163" style="v" sid="PSA 119:163"/>म झूटलाई घृणा गर्दछु, र तुच्छ ठान्दछु; तर तपाईंको व्यवस्थालाई म प्रेम गर्दछु।<verse eid="PSA 119:163"/></para>
<para style="p"><verse number="164" style="v" sid="PSA 119:164"/>तपाईंका धार्मिक नियमहरूको निम्ति दिनमा म सात पटक तपाईंको प्रशंसा गर्दछु।<verse eid="PSA 119:164"/></para>
<para style="p"><verse number="165" style="v" sid="PSA 119:165"/>तपाईंको व्यवस्थालाई प्रेम गर्नेहरूका लागि ठूलो शान्ति हुन्छ, अनि कुनै कुराले तिनीहरूलाई ठेस पुर्‍याउँदैन।<verse eid="PSA 119:165"/></para>
<para style="p"><verse number="166" style="v" sid="PSA 119:166"/>हे याहवेह, म तपाईंको मुक्तिको प्रतीक्षा गर्दछु, र तपाईंका आज्ञाहरू पालन गर्दछु।<verse eid="PSA 119:166"/></para>
<para style="p"><verse number="167" style="v" sid="PSA 119:167"/>म तपाईंका कानुनहरू पालन गर्दछु; किनकि म तिनलाई अत्यन्तै प्रेम गर्दछु।<verse eid="PSA 119:167"/></para>
<para style="p"><verse number="168" style="v" sid="PSA 119:168"/>तपाईंका विधिहरू र तपाईंका कानुनहरू म पालन गर्दछु; किनकि मेरा सम्पूर्ण आचरणहरू तपाईं जान्‍नुहुन्छ।<verse eid="PSA 119:168"/></para>
<para style="p"><verse number="169" style="v" sid="PSA 119:169"/>हे याहवेह, मेरो पुकार तपाईंको सामु पुगोस्; तपाईंको वचनअनुसार मलाई समझशक्ति दिनुहोस्!<verse eid="PSA 119:169"/></para>
<para style="p"><verse number="170" style="v" sid="PSA 119:170"/>मेरो बिन्ती तपाईंको सामु पुगोस्; तपाईंको प्रतिज्ञाअनुसार मलाई छुटकारा दिनुहोस्!<verse eid="PSA 119:170"/></para>
<para style="p"><verse number="171" style="v" sid="PSA 119:171"/>मेरा ओठबाट तपाईंको प्रशंसा छचल्किऊन्; किनकि तपाईंले मलाई आफ्ना उर्दीहरू सिकाउनुहुन्छ।<verse eid="PSA 119:171"/></para>
<para style="p"><verse number="172" style="v" sid="PSA 119:172"/>मेरो जिब्रोले तपाईंका वचनको गीत गाओस्; किनकि तपाईंका सम्पूर्ण आज्ञाहरू धार्मिक छन्।<verse eid="PSA 119:172"/></para>
<para style="p"><verse number="173" style="v" sid="PSA 119:173"/>तपाईंको हात मलाई सहयोग गर्न तत्पर रहोस्; किनकि मैले तपाईंका विधिहरूलाई चुनेको छु।<verse eid="PSA 119:173"/></para>
<para style="p"><verse number="174" style="v" sid="PSA 119:174"/>हे याहवेह, म तपाईंको मुक्तिको तिर्सना गर्छु; अनि तपाईंको व्यवस्थाले मलाई हर्षित पार्दछ।<verse eid="PSA 119:174"/></para>
<para style="p"><verse number="175" style="v" sid="PSA 119:175"/>म जीवित रहूँ, ताकि तपाईंको प्रशंसा गर्न सकूँ; अनि तपाईंका नियमहरूले मलाई थामून्।<verse eid="PSA 119:175"/></para>
<para style="p"><verse number="176" style="v" sid="PSA 119:176"/>हराएको भेडाजस्तै म बरालिएको छु। आफ्नो सेवकको खोजी गर्नुहोस्; किनकि मैले तपाईंका आज्ञाहरू बिर्सेको छैनँ।<verse eid="PSA 119:176"/></para>
<chapter eid="PSA 119"/>
<chapter number="120" style="c" sid="PSA 120"/>
<para style="p"><verse number="1" style="v" sid="PSA 120:1"/>आरोहणको गीत। मेरो सङ्कष्‍टमा म याहवेहलाई पुकार्दछु, र उहाँले मलाई जवाफ दिनुहुन्छ।<verse eid="PSA 120:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 120:2"/>हे याहवेह, मलाई झूटो बोल्ने ओठ र छली जिब्रोबाट बचाउनुहोस्।<verse eid="PSA 120:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 120:3"/>ए छली जिब्रो, उहाँले तँलाई के गर्नुहुनेछ? अनि अझ बढ्ता के गर्नुहोला?<verse eid="PSA 120:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 120:4"/>उहाँले तँलाई योद्धाका तीखा काँडले हानेर, र झाडीको आगोले जलाएर दण्ड दिनुहुनेछ!<verse eid="PSA 120:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 120:5"/>मलाई धिक्‍कार छ! म मेशेकमा बास गर्दछु; किनकि केदारका पालहरूका बीचमा बसेको छु!<verse eid="PSA 120:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 120:6"/>शान्तिलाई घृणा गर्नेहरूका बीचमा म बसेको धेरै समय भयो।<verse eid="PSA 120:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 120:7"/>म त शान्तिप्रिय व्यक्ति हुँ; तर मैले बोल्दा, तिनीहरू लडाइँ गर्न तम्सिन्छन्।<verse eid="PSA 120:7"/></para>
<chapter eid="PSA 120"/>
<chapter number="121" style="c" sid="PSA 121"/>
<para style="p"><verse number="1" style="v" sid="PSA 121:1"/>आरोहणको गीत। म मेरा आँखाहरू पर्वतहरूतिर उचाल्छु— मेरो सहायता कहाँबाट आउँछ?<verse eid="PSA 121:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 121:2"/>मेरो सहायता याहवेहबाट आउँछ, जो स्वर्ग र पृथ्वीका सृष्‍टिकर्ता हुनुहुन्छ।<verse eid="PSA 121:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 121:3"/>उहाँले तिम्रा खुट्टाहरू चिप्लन दिनुहुनेछैन— तिम्रो रक्षा गर्नुहुने कहिल्यै उँघ्नुहुनेछैन;<verse eid="PSA 121:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 121:4"/>साँच्‍चै, इस्राएललाई रक्षा गर्नुहुनेचाहिँ न उँघ्नुहुन्छ, न त निदाउनुहुन्छ।<verse eid="PSA 121:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 121:5"/>याहवेहले नै तिमीलाई रक्षा गर्नुहुनेछ— याहवेह नै तिम्रो दाहिने हातपट्टिको तिम्रो छहारी हुनुहुन्छ;<verse eid="PSA 121:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 121:6"/>दिउँसोको घामले तिमीलाई पोल्नेछैन, न त राति चन्द्रमाले तिमीलाई हानि गर्नेछ।<verse eid="PSA 121:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 121:7"/>याहवेहले तिमीलाई सबै हानिबाट जोगाउनुहुनेछ— उहाँले तिम्रो जीवनको रक्षा गर्नुहुनेछ;<verse eid="PSA 121:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 121:8"/>तिमी बाहिर जाँदा र भित्र आउँदा, अहिले अनि सदासर्वदा, याहवेहले तिम्रो रक्षा गर्नुहुनेछ।<verse eid="PSA 121:8"/></para>
<chapter eid="PSA 121"/>
<chapter number="122" style="c" sid="PSA 122"/>
<para style="p"><verse number="1" style="v" sid="PSA 122:1"/>दावीदको आरोहणको गीत। जब तिनीहरूले मलाई, “याहवेहका भवनमा हामी जाऔँ” भने, तब म तिनीहरूसँगै आनन्दित भएँ।<verse eid="PSA 122:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 122:2"/>हे यरूशलेम, तेरा मूलढोकाहरूभित्र हाम्रा खुट्टाहरू उभिएका छन्।<verse eid="PSA 122:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 122:3"/>यरूशलेम एउटा सहरजस्तै, एकै ठाउँमा टम्‍म गरी मिलाएर बसालिएको छ।<verse eid="PSA 122:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 122:4"/>इस्राएललाई दिइएको कानुनअनुसार याहवेहका कुलहरू याहवेहको नामको प्रशंसा गर्न त्यहाँ जान्छन्।<verse eid="PSA 122:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 122:5"/>किनकि त्यहाँ न्यायका सिंहासनहरू स्थापित छन्; त्यहाँ दावीदका वंशका सिंहासनहरू छन्।<verse eid="PSA 122:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 122:6"/>यरूशलेमको शान्तिको निम्ति प्रार्थना गर: “तँलाई प्रेम गर्नेहरू सुरक्षित रहून्।<verse eid="PSA 122:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 122:7"/>तेरा पर्खालहरूभित्र शान्ति रहोस्; र तेरा दरबारहरूभित्र सुरक्षा रहोस्!”<verse eid="PSA 122:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 122:8"/>मेरा परिवार र मेरा मित्रहरूका खातिर म, “तिमीहरूमा शान्ति रहोस्!” भन्‍नेछु।<verse eid="PSA 122:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 122:9"/>याहवेह हाम्रा परमेश्‍वरको भवनको खातिर, म तेरो भलो चिताउनेछु।<verse eid="PSA 122:9"/></para>
<chapter eid="PSA 122"/>
<chapter number="123" style="c" sid="PSA 123"/>
<para style="p"><verse number="1" style="v" sid="PSA 123:1"/>आरोहणको गीत। हे स्वर्गको सिंहासनमा विराजमान हुनुहुने परमेश्‍वर, मेरा आँखाहरू म तपाईंतिर उठाउँछु।<verse eid="PSA 123:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 123:2"/>जसरी सेवकहरूका आँखाले आफ्ना मालिकका हाततिर हेर्दछन्, जसरी सेविकाले आफ्नी मालिक्नीका हाततिर हेर्दछे, त्यसरी नै उहाँले हामीमाथि दया नगरुन्जेल, हाम्रा आँखाहरूले, याहवेह हाम्रा परमेश्‍वरतिर हेर्दछन्।<verse eid="PSA 123:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 123:3"/>हामीमाथि दया गर्नुहोस्, हे याहवेह, हामीमाथि दया गर्नुहोस्; किनकि हामीले अति नै अवहेलना सहेका छौँ।<verse eid="PSA 123:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 123:4"/>हामीले अहङ्कारीहरूबाट अति नै उपहास र घमण्डीहरूबाट अति नै अवहेलना सहेका छौँ।<verse eid="PSA 123:4"/></para>
<chapter eid="PSA 123"/>
<chapter number="124" style="c" sid="PSA 124"/>
<para style="p"><verse number="1" style="v" sid="PSA 124:1"/>दावीदको आरोहणको गीत। यदि याहवेह हाम्रो पक्षमा नहुनुभएको भए— इस्राएलले भनोस्—<verse eid="PSA 124:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 124:2"/>मानिसहरूले हामीलाई आक्रमण गर्दा, याहवेह हाम्रो पक्षमा नहुनुभएको भए;<verse eid="PSA 124:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 124:3"/>तिनीहरूका क्रोध हाम्रो विरुद्ध दन्केको बेला, तिनीहरूले हामीलाई जिउँदै निल्नेथिए;<verse eid="PSA 124:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 124:4"/>उर्लिआएको बाढीले हामीलाई डुबाउनेथियो; अनि भल उर्लेर हामीलाई बगाउने थियो।<verse eid="PSA 124:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 124:5"/>उर्लंदो पानीले हामीलाई बगाएर टाढा लैजानेथियो।<verse eid="PSA 124:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 124:6"/>याहवेहलाई प्रशंसा होस्, जसले हामीलाई तिनीहरूका दाँतले फहराउन दिनुभएन।<verse eid="PSA 124:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 124:7"/>शिकारीको पासोबाट चरा उम्केझैँ, हामी उम्केका छौँ; तिनीहरूको पासो छिनियो, र हामी उम्कियौँ।<verse eid="PSA 124:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 124:8"/>स्वर्ग र पृथ्वी सृष्‍टि गर्नुहुने, याहवेहको नाममा हाम्रो सहायता छ।<verse eid="PSA 124:8"/></para>
<chapter eid="PSA 124"/>
<chapter number="125" style="c" sid="PSA 125"/>
<para style="p"><verse number="1" style="v" sid="PSA 125:1"/>आरोहणको गीत। याहवेहमा भरोसा राख्नेहरू सियोन पर्वतझैँ छन्, जो कहिल्यै डगमगाउँदैनन्; तर सदासर्वदा स्थिर रहन्छन्।<verse eid="PSA 125:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 125:2"/>जसरी पहाडहरूले यरूशलेमलाई घेरेका छन्, त्यसरी नै याहवेहले आफ्ना मानिसहरूलाई आज अनि सदासर्वदा घेरिराख्नुहुन्छ।<verse eid="PSA 125:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 125:3"/>धर्मीहरूलाई छुट्ट्याइएको देशमा, दुष्‍टहरूको राजदण्ड रहनेछैन। नत्रता धर्मीहरूले आफ्ना हात अधर्मतिर लगाउलान्।<verse eid="PSA 125:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 125:4"/>हे याहवेह, जो असल छन्, तिनीहरूलाई असल गर्नुहोस्; तिनीहरूलाई, जसका हृदय सोझो छन्।<verse eid="PSA 125:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 125:5"/>तर खराब मार्गतिर जो फर्कन्छन्, याहवेहले तिनीहरूलाई दुष्कर्मीहरूसितै धपाउनुहुनेछ। इस्राएलमाथि शान्ति कायम रहोस्!<verse eid="PSA 125:5"/></para>
<chapter eid="PSA 125"/>
<chapter number="126" style="c" sid="PSA 126"/>
<para style="p"><verse number="1" style="v" sid="PSA 126:1"/>आरोहणको गीत। जब याहवेहले निर्वासितहरूलाई सियोनमा फर्काएर ल्याउनुभयो, यो त सपनाजस्तो थियो।<verse eid="PSA 126:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 126:2"/>त्यस बेला हाम्रा मुहारहरू हाँसोले भरिए; हाम्रा जिब्राहरू हर्षका गीतले भरिए। तब जाति-जातिहरूका बीच यसो भनियो, “याहवेहले तिनीहरूका निम्ति महान् कार्यहरू गर्नुभएको छ।”<verse eid="PSA 126:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 126:3"/>याहवेहले हाम्रा निम्ति महान् कार्यहरू गर्नुभएको छ, र हामी आनन्दले भरिएका छौँ।<verse eid="PSA 126:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 126:4"/>हे याहवेह, दक्षिण देशका पानीका मुहानहरूझैँ, निर्वासितहरूलाई स्थापित गरिदिनुहोस्!<verse eid="PSA 126:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 126:5"/>जसले आँसु बहाउँदै बिउ छर्दछन्, तिनीहरू हर्षका गीत गाउँदै कटनी गर्नेछन्।<verse eid="PSA 126:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 126:6"/>जो रुँदै-रुँदै बिउ बोकेर छर्नको लागि बाहिर जान्छन्, तिनीहरू हर्षका गीत गाउँदै अन्‍नका बिटाहरू बोकेर फर्कनेछन्।<verse eid="PSA 126:6"/></para>
<chapter eid="PSA 126"/>
<chapter number="127" style="c" sid="PSA 127"/>
<para style="p"><verse number="1" style="v" sid="PSA 127:1"/>सोलोमनको आरोहणको गीत। यदि याहवेहले नै घर बनाउनुभएन भने, बनाउनेहरूको परिश्रम व्यर्थ हुन्छ। याहवेहले नै सहरको रक्षा गर्नुभएन भने, पहरादारहरू जागा रहनु व्यर्थ हुन्छ।<verse eid="PSA 127:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 127:2"/>बिहानै उठ्नु, र अबेरसम्म जागो रहनु, अनि शोकको भोजन गर्नु व्यर्थै हुन्छ— किनकि जसलाई उहाँले प्रेम गर्नुहुन्छ, तिनीहरूलाई उहाँले निद्रा दिनुहुन्छ।<verse eid="PSA 127:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 127:3"/>छोराछोरीहरू याहवेहले दिनुभएका उत्तराधिकार हुन्; गर्भका फलहरू उहाँले दिनुभएका उपहार हुन्।<verse eid="PSA 127:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 127:4"/>युवावस्थामा जन्मेका छोराछोरीहरू, वीर योद्धाका हातमा भएका काँडहरूझैँ हुन्छन्।<verse eid="PSA 127:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 127:5"/>त्यो मानिस धन्यको हो, जसको ठोक्रो काँडहरूले भरिएको हुन्छ। मूलढोकामा आफ्ना शत्रुहरूको सामना गर्नुपर्दा तिनीहरू लाजमा पर्नेछैनन्।<verse eid="PSA 127:5"/></para>
<chapter eid="PSA 127"/>
<chapter number="128" style="c" sid="PSA 128"/>
<para style="p"><verse number="1" style="v" sid="PSA 128:1"/>आरोहणको गीत। याहवेहको भय मान्‍नेहरू र उहाँमा आज्ञाकारी भएर हिँड्नेहरू सबै धन्यका हुन्।<verse eid="PSA 128:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 128:2"/>तिमीले आफ्ना परिश्रमको कमाइ खानेछौ; भलाइ र समृद्धि तिम्रा हुनेछन्।<verse eid="PSA 128:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 128:3"/>तिम्रो घरमा तिम्री पत्नी फलवन्त दाखको बोटझैँ हुनेछिन्; र तिम्रा छोराछोरीहरू तिम्रो टेबुलको वरिपरि जैतुनका मुनाहरूजस्तै हुनेछन्।<verse eid="PSA 128:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 128:4"/>हो, याहवेहको भय मान्‍ने जन यसरी नै आशिषित हुनेछ।<verse eid="PSA 128:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 128:5"/>याहवेहले तिमीलाई सियोनबाट आशिष् देऊन्; तिम्रो जीवनभरि नै तिमीले यरूशलेमको समृद्धि देख्नेछौ।<verse eid="PSA 128:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 128:6"/>तिमी आफ्ना नातिनातिनाहरूलाई देख्ने गरी बाँच— इस्राएलमाथि शान्ति रहोस्!<verse eid="PSA 128:6"/></para>
<chapter eid="PSA 128"/>
<chapter number="129" style="c" sid="PSA 129"/>
<para style="p"><verse number="1" style="v" sid="PSA 129:1"/>आरोहणको गीत। “मेरो युवावस्थादेखि तिनीहरूले मलाई धेरै सताएका छन्,” इस्राएलले यसो भनोस्;<verse eid="PSA 129:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 129:2"/>“तिनीहरूले मेरो युवावस्थादेखि मलाई धेरै सताएका छन्; तर तिनीहरूले मलाई जित्न सकेका छैनन्।<verse eid="PSA 129:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 129:3"/>हलो जोत्नेहरूले मेरो पिठिउँमा जोतेका छन्; र पिठिउँभरि लामा फालिहरूले कोरेका छन्।<verse eid="PSA 129:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 129:4"/>तर याहवेह धार्मिक हुनुहुन्छ; उहाँले दुष्‍टहरूका बन्धन तोडेर मलाई मुक्त गर्नुभएको छ।”<verse eid="PSA 129:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 129:5"/>सियोनलाई घृणा गर्नेहरू सबै लज्जित भएर फर्किऊन्!<verse eid="PSA 129:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 129:6"/>तिनीहरू छानामाथिका घाँसजस्ता होऊन्, जो बढ्न नपाउँदै ओइलाइहाल्छन्;<verse eid="PSA 129:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 129:7"/>त्यसबाट काट्नेले आफ्नो एक मुट्ठी पनि भर्न सक्दैन, न बिटा बटुल्नेले एक अँगालो नै भर्न सक्दछ।<verse eid="PSA 129:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 129:8"/>त्यहाँबाट भएर जानेहरूले तिनीहरूका निम्ति यस्तो कामना नगरून्, “याहवेहको आशिष् तिमीहरूमाथि रहोस्; याहवेहका नाममा हामी तिमीहरूलाई आशिष् दिन्छौँ।”<verse eid="PSA 129:8"/></para>
<chapter eid="PSA 129"/>
<chapter number="130" style="c" sid="PSA 130"/>
<para style="p"><verse number="1" style="v" sid="PSA 130:1"/>आरोहणको गीत। हे याहवेह, गहिराइहरूबाट म तपाईंलाई पुकार्छु;<verse eid="PSA 130:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 130:2"/>हे प्रभु, मेरो सोर सुन्‍नुहोस्; दयाको निम्ति गरिएको मेरो पुकारलाई तपाईंका कानहरूले ध्यान देऊन्!<verse eid="PSA 130:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 130:3"/>हे याहवेह, यदि तपाईंले पापको लेखा राख्नुभयो भने, हे प्रभु, को खडा हुन सक्छ र?<verse eid="PSA 130:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 130:4"/>तर तपाईं क्षमाशील हुनुहुन्छ, त्यसैले हामी श्रद्धापूर्वक तपाईंको सेवा गर्दछौँ।<verse eid="PSA 130:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 130:5"/>म याहवेहलाई पर्खन्छु, मेरा सारा जीवनले उहाँको बाटो हेर्दछ, अनि उहाँको वचनमा म आशा राख्दछु।<verse eid="PSA 130:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 130:6"/>पालेले बिहानको प्रतीक्षा गरेको भन्दा बढी, हो, पालेले बिहानको प्रतीक्षा गरेको भन्दा बढी, म प्रभुको प्रतीक्षा गर्दछु।<verse eid="PSA 130:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 130:7"/>हे इस्राएल, याहवेहमा आफ्नो आशा राख्; किनकि याहवेहसँग नै अचुक प्रेम छ; र उहाँसित नै पूर्ण उद्धार छ।<verse eid="PSA 130:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 130:8"/>उहाँ आफैँले इस्राएललाई तिनीहरूका सबै पापहरूबाट छुटाउनुहुनेछ।<verse eid="PSA 130:8"/></para>
<chapter eid="PSA 130"/>
<chapter number="131" style="c" sid="PSA 131"/>
<para style="p"><verse number="1" style="v" sid="PSA 131:1"/>दावीदको आरोहणको गीत। हे याहवेह, मेरो हृदय घमण्डी छैन, मेरा आँखाहरू हठी छैनन्; म ठूला-ठूला कुराहरू अथवा आफूले पाउनै नसक्ने कुराहरूमा आफूलाई अल्झाउँदिनँ।<verse eid="PSA 131:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 131:2"/>तर मैले आफूलाई शान्त र चुप गराएको छु; आमासँग तृप्‍त भएर बसेको बालकझैँ, आमाको दूध छुटाइएको बालकझैँ म सन्तुष्‍ट छु।<verse eid="PSA 131:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 131:3"/>हे इस्राएल, अहिले र सदासर्वदा याहवेहमा नै आफ्नो आशा राख्!<verse eid="PSA 131:3"/></para>
<chapter eid="PSA 131"/>
<chapter number="132" style="c" sid="PSA 132"/>
<para style="p"><verse number="1" style="v" sid="PSA 132:1"/>आरोहणको गीत। हे याहवेह, दावीद र तिनले भोगेका सबै दुःखलाई सम्झनुहोस्।<verse eid="PSA 132:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 132:2"/>तिनले याहवेहसँग शपथ खाए, तिनले याकोबका सर्वशक्तिमान्‌सँग भाकल गरे:<verse eid="PSA 132:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 132:3"/>“म, तबसम्म आफ्नो घरमा पस्‍नेछैनँ, वा आफ्नो ओछ्यानमा सुत्नेछैनँ,<verse eid="PSA 132:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 132:4"/>म मेरा आँखाहरूमा निद्रा आउन दिनेछैनँ, र आँखाहरूका पलकहरूलाई उँघ्न पनि दिनेछैनँ;<verse eid="PSA 132:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 132:5"/>जबसम्म याहवेहका निम्ति एउटा ठाउँ र याकोबका सर्वशक्तिमान्‌को निम्ति म एउटा वासस्थान भेट्टाउँदिनँ।”<verse eid="PSA 132:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 132:6"/>हामीले एप्रातामा त्यसको विषयमा सुन्यौँ; हामीले याआरको मैदानमा त्यसलाई भेट्टायौँ:<verse eid="PSA 132:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 132:7"/>“हामी उहाँका वासस्थानमा जाऔँ; यसो भन्दै उहाँका पाउदानमा दण्डवत् गरौँ,<verse eid="PSA 132:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 132:8"/>‘हे याहवेह, उठ्नुहोस्, तपाईं र तपाईंको शक्तिको चिन्ह सन्दुकसमेत, तपाईंको विश्रामस्थलभित्र आउनुहोस्।<verse eid="PSA 132:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 132:9"/>तपाईंका पुजारीहरूले तपाईंको धार्मिकताको वस्त्र पहिरिऊन्; र तपाईंका विश्‍वासयोग्य जनहरू आनन्दले जयजयकार गरून्!’ ”<verse eid="PSA 132:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 132:10"/>आफ्ना सेवक दावीदको निम्ति, तपाईंका अभिषिक्त जनलाई अस्वीकार नगर्नुहोस्!<verse eid="PSA 132:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 132:11"/>याहवेहले दावीदसँग शपथ खानुभयो; एउटा पक्‍का शपथ, जुन उहाँले फिर्ता लिनुहुनेछैन: “म तेरो सिंहासनमा तेरा सन्तानहरूमध्ये एक जनालाई बसाल्नेछु।<verse eid="PSA 132:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 132:12"/>यदि तेरा छोराहरूले मेरो करार र मैले सिकाएका मेरा विधिहरू पालन गरे भने, तिनीहरूका छोराहरू पनि सदासर्वदाको निम्ति तेरो सिंहासनमा बस्‍नेछन्।”<verse eid="PSA 132:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 132:13"/>किनकि याहवेहले सियोनलाई चुन्‍नुभएको छ; उहाँले त्यसलाई आफ्नो वासस्थान बनाउने इच्छा गर्नुभएको छ;<verse eid="PSA 132:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 132:14"/>“यो सदासर्वदाको निम्ति मेरो विश्रामको स्थान हो; म यहीँ सिंहासनमा बस्‍नेछु; किनकि मैले यस्तै इच्छा गरेको छु।<verse eid="PSA 132:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 132:15"/>प्रशस्त खानपानका थोकले म त्यसलाई आशिष् दिनेछु; र त्यसका गरिबहरूलाई म रोटीले तृप्‍त पार्नेछु।<verse eid="PSA 132:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 132:16"/>त्यसका पुजारीहरूलाई पनि म मुक्तिको वस्त्र पहिराउनेछु; र त्यसका विश्‍वासयोग्य जनहरू आनन्दले सधैँ जयजयकार गर्नेछन्।<verse eid="PSA 132:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 132:17"/>“यहाँ दावीदको निम्ति म एउटा सिङ को टुसा उमार्नेछु; र मेरा अभिषिक्त जनको निम्ति बत्ती तयार गर्नेछु।<verse eid="PSA 132:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 132:18"/>म त्यसका शत्रुहरूलाई शर्मको वस्त्र पहिराउनेछु; तर त्यसको शिर भने प्रकाशमय मुकुटले शोभायमान हुनेछ।”<verse eid="PSA 132:18"/></para>
<chapter eid="PSA 132"/>
<chapter number="133" style="c" sid="PSA 133"/>
<para style="p"><verse number="1" style="v" sid="PSA 133:1"/>दावीदको आरोहणको गीत। परमेश्‍वरका जनहरू एक-आपसमा एकतामा बस्‍नु कति असल र आनन्दमय कुरा हुन्छ!<verse eid="PSA 133:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 133:2"/>यो त शिरमा खन्याइने मूल्यवान् तेलजस्तो हुन्छ, जो दाह्रीसम्म बगेर जान्छ, हारूनको दाह्रीसम्म बगेर जान्छ, जो उनका पोशाकको कठालोसम्मै बगेर जान्छ।<verse eid="PSA 133:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 133:3"/>त्यो हेर्मोन पर्वतको शीत सियोन पर्वतमा परेजस्तै हुन्छ; किनकि त्यहीँ नै याहवेहले, आफ्नो अनन्त जीवनको आशिष् समेत खन्याउनुहुन्छ।<verse eid="PSA 133:3"/></para>
<chapter eid="PSA 133"/>
<chapter number="134" style="c" sid="PSA 134"/>
<para style="p"><verse number="1" style="v" sid="PSA 134:1"/>आरोहणको गीत। हे याहवेहका सबै सेवकहरू हो, याहवेहको प्रशंसा गर! तिमीहरू, जो याहवेहको भवनमा राति उहाँको सेवा गर्दछौ।<verse eid="PSA 134:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 134:2"/>उहाँका पवित्रस्थानमा आफ्ना हात उचाल र याहवेहलाई प्रशंसा गर।<verse eid="PSA 134:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 134:3"/>स्वर्ग र पृथ्वी बनाउनुहुने याहवेहले तिमीलाई सियोनबाट आशिष् देऊन्!<verse eid="PSA 134:3"/></para>
<chapter eid="PSA 134"/>
<chapter number="135" style="c" sid="PSA 135"/>
<para style="p"><verse number="1" style="v" sid="PSA 135:1"/>याहवेहको प्रशंसा गर! याहवेहको नामको प्रशंसा गर; हे याहवेहका सेवकहरू हो, उहाँको प्रशंसा गर।<verse eid="PSA 135:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 135:2"/>तिमीहरू, जो याहवेहको भवनमा, हाम्रा परमेश्‍वरको भवनका चोकहरूमा सेवा गर्दछौ।<verse eid="PSA 135:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 135:3"/>याहवेहको प्रशंसा गर! किनकि याहवेह भलो हुनुहुन्छ; उहाँको नामको गीत गाओ; किनकि त्यो आनन्दमय हुन्छ।<verse eid="PSA 135:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 135:4"/>किनकि याहवेहले याकोबलाई आफ्नो बनाउन, अनि इस्राएललाई आफ्नो बहुमूल्य सम्पत्ति हुनलाई चुन्‍नुभएको छ।<verse eid="PSA 135:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 135:5"/>म जान्दछु, याहवेह महान् हुनुहुन्छ, र हाम्रा प्रभु सबै देवहरूभन्दा महान् हुनुहुन्छ।<verse eid="PSA 135:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 135:6"/>आकाशमा र पृथ्वीमा, समुद्रहरू अनि तिनका गहिराइमा, याहवेह आफ्नो इच्छाअनुसार गर्नुहुन्छ।<verse eid="PSA 135:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 135:7"/>उहाँले पृथ्वीको छेउबाट बादल उठाउनुहुन्छ; उहाँले वर्षासित बिजुली पठाउनुहुन्छ; र उहाँले आफ्ना भण्डारहरूबाट बतास निकाल्नुहुन्छ।<verse eid="PSA 135:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 135:8"/>उहाँले इजिप्टका मानिस र पशु, दुवैका पहिले जन्मेकाहरूलाई मार्नुभयो।<verse eid="PSA 135:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 135:9"/>हे इजिप्ट, उहाँले तेरो बीचमा, आफ्ना अलौकिक चिन्हहरू र अद्‌भुत कार्यहरू, फारो र उनका सारा भारदारहरूका विरुद्धमा पठाउनुभयो।<verse eid="PSA 135:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 135:10"/>उहाँले धेरै राष्ट्रहरूलाई नाश गर्नुभयो; र धेरै शक्तिशाली राजाहरूलाई मार्नुभयो—<verse eid="PSA 135:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 135:11"/>एमोरीहरूका राजा सीहोन, बाशानका राजा ओग, र कनानका सबै राजाहरूलाई नष्‍ट गर्नुभयो—<verse eid="PSA 135:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 135:12"/>अनि तिनीहरूका भूमि पैतृक सम्पत्तिको रूपमा, आफ्ना प्रजा इस्राएललाई उत्तराधिकारको रूपमा दिनुभयो।<verse eid="PSA 135:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 135:13"/>हे याहवेह, तपाईंको नाम सदासर्वदा रहिरहन्छ; हे याहवेह, तपाईंको ख्याति पुस्तौँ-पुस्तासम्म रहिरहन्छ।<verse eid="PSA 135:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 135:14"/>किनकि याहवेहले आफ्ना मानिसहरूलाई निर्दोष प्रमाणित गर्नुहुनेछ, र आफ्ना सेवकहरूमाथि करुणा देखाउनुहुनेछ।<verse eid="PSA 135:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 135:15"/>जाति-जातिहरूका मूर्तिहरू सुन र चाँदी हुन्, ती सबै मानिसहरूका हस्तकला मात्र हुन्।<verse eid="PSA 135:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 135:16"/>तिनीहरूका मुख त छन्, तर बोल्न सक्दैनन्; आँखा त छन्, तर देख्न सक्दैनन्।<verse eid="PSA 135:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 135:17"/>तिनीहरूका कान छन्, तर सुन्‍न सक्दैनन्; न तिनीहरूको मुखमा सास नै छ।<verse eid="PSA 135:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 135:18"/>मूर्तिहरूलाई बनाउनेहरू पनि तिनीहरूजस्तै हुनेछन्; तिनीहरूमाथि भरोसा गर्नेहरू सबै पनि त्यस्तै हुनेछन्।<verse eid="PSA 135:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 135:19"/>हे सबै इस्राएलका घराना हो, याहवेहलाई प्रशंसा गर; हे हारूनका घराना हो, याहवेहलाई प्रशंसा गर;<verse eid="PSA 135:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 135:20"/>हे लेवीका घराना हो, याहवेहलाई प्रशंसा गर; हे उहाँको डर मान्‍नेहरू हो, याहवेहलाई प्रशंसा गर।<verse eid="PSA 135:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 135:21"/>सियोनबाट याहवेहलाई प्रशंसा होस्! यरूशलेममा बास गर्नुहुनेको प्रशंसा होस्! याहवेहको प्रशंसा गर!<verse eid="PSA 135:21"/></para>
<chapter eid="PSA 135"/>
<chapter number="136" style="c" sid="PSA 136"/>
<para style="p"><verse number="1" style="v" sid="PSA 136:1"/>याहवेहलाई धन्यवाद देओ, किनकि उहाँ भलो हुनुहुन्छ। उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 136:2"/>देवताहरूका परमेश्‍वरलाई धन्यवाद देओ; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 136:3"/>प्रभुहरूका प्रभुलाई धन्यवाद देओ: उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 136:4"/>उहाँलाई धन्यवाद देओ, उहाँले मात्र ठूला अद्‌भुत कार्यहरू गर्नुहुन्छ; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 136:5"/>उहाँलाई धन्यवाद देओ, जसले आफ्ना समझशक्तिले आकाश सृष्‍टि गर्नुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 136:6"/>उहाँलाई धन्यवाद देओ, जसले पानीमाथि पृथ्वी फैलाउनुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 136:7"/>उहाँलाई धन्यवाद देओ, जसले विशाल ज्योतिहरू बनाउनुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 136:8"/>उहाँलाई धन्यवाद देओ, जसले दिनमा प्रभुत्व गर्नलाई सूर्य बनाउनुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 136:9"/>उहाँलाई धन्यवाद देओ, जसले रातमा प्रभुत्व गर्नलाई चन्द्रमा र ताराहरू बनाउनुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 136:10"/>उहाँलाई धन्यवाद देओ, जसले इजिप्टका पहिले जन्मेकाहरूलाई प्रहार गर्नुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 136:11"/>र उहाँलाई धन्यवाद देओ, जसले तिनीहरूको बीचबाट इस्राएललाई निकालेर ल्याउनुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 136:12"/>उहाँलाई धन्यवाद देओ, जसले शक्तिशाली हात र पराक्रमी पाखुराले तिनीहरूलाई निकालेर ल्याउनुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 136:13"/>उहाँलाई धन्यवाद देओ, जसले लाल समुद्रलाई दुई भागमा विभाजन गर्नुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 136:14"/>उहाँलाई धन्यवाद देओ, जसले इस्राएललाई त्यसको बीचबाट पार गराउनुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 136:15"/>उहाँलाई धन्यवाद देओ, जसले फारो र तिनका सेनालाई लाल समुद्रमा डुबाइदिनुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 136:16"/>उहाँलाई धन्यवाद देओ, जसले आफ्ना प्रजालाई उजाडस्थानबाट भएर डोर्‍याउनुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 136:17"/>उहाँलाई धन्यवाद देओ, जसले ठूला-ठूला राजालाई नाश पार्नुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 136:18"/>उहाँलाई धन्यवाद देओ, जसले शक्तिशाली राजालाई मार्नुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 136:19"/>उहाँलाई धन्यवाद देओ, जसले एमोरीहरूका राजा सीहोनलाई मार्नुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 136:20"/>उहाँलाई धन्यवाद देओ, जसले बाशानका राजा ओगलाई मार्नुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 136:21"/>उहाँलाई धन्यवाद देओ, जसले तिनीहरूका देश पैतृक सम्पत्तिको रूपमा दिनुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 136:22"/>उहाँलाई धन्यवाद देओ, जसले आफ्ना सेवक इस्राएललाई पैतृक सम्पत्तिको रूपमा दिनुभयो। उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 136:23"/>उहाँलाई धन्यवाद देओ, जसले हामी सबैलाई हाम्रा दुर्दशामा स्मरण गर्नुभयो; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 136:24"/>उहाँलाई धन्यवाद देओ, जसले हाम्रा शत्रुहरूबाट हामीलाई छुटाउनुभयो। उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:24"/></para>
<para style="p"><verse number="25" style="v" sid="PSA 136:25"/>उहाँलाई धन्यवाद देओ, जसले हरेक प्राणीलाई भोजन दिनुहुन्छ। उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:25"/></para>
<para style="p"><verse number="26" style="v" sid="PSA 136:26"/>स्वर्गका परमेश्‍वरलाई धन्यवाद देओ; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="PSA 136:26"/></para>
<chapter eid="PSA 136"/>
<chapter number="137" style="c" sid="PSA 137"/>
<para style="p"><verse number="1" style="v" sid="PSA 137:1"/>बेबिलोनका नदीहरूको किनारमा बसेर, हामी सियोनलाई सम्झँदै रोयौँ।<verse eid="PSA 137:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 137:2"/>त्यहाँका लहरे पीपलहरूमा हामीले आफ्ना वीणाहरू झुण्ड्यायौँ,<verse eid="PSA 137:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 137:3"/>किनकि हामीलाई बन्दी बनाएर लानेहरूले त्यहाँ हामीलाई गीत गाउन लगाए; हामीलाई यातना दिनेहरूले हर्षका गीतको माग गरे। तिनीहरूले भने, “हाम्रा निम्ति सियोनका गीतहरूमध्ये एउटा गीत गाओ!”<verse eid="PSA 137:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 137:4"/>बिरानो देशमा हुँदा कसरी हामी याहवेहको गीत गाउन सक्छौँ?<verse eid="PSA 137:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 137:5"/>हे यरूशलेम, यदि मैले तँलाई बिर्सेको भए, मेरो दाहिने हातले आफ्नो सिप भूलोस्।<verse eid="PSA 137:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 137:6"/>यदि मैले तँलाई नसम्झेको भए, यदि मैले यरूशलेमलाई आफ्नो सर्वोच्‍च आनन्द नमानेको भए, मेरो जिब्रो मुखको तालुमा टाँसिजाओस्!<verse eid="PSA 137:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 137:7"/>हे याहवेह, यरूशलेमको पतन भएको दिन, एदोमीहरूले के गरे, सम्झनुहोस्। तिनीहरूले चीत्कार गरे, “त्यसलाई भत्काओ, जगदेखि नै त्यसलाई भत्काओ!”<verse eid="PSA 137:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 137:8"/>सर्वनाश हुन लागेकी, हे बेबिलोनकी छोरी, तैँले हामीमाथि जे गरिस्, त्यसको लागि तँमाथि प्रतिशोध लिने मानिस धन्य हुनेछ।<verse eid="PSA 137:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 137:9"/>त्यो धन्य हुनेछ, जसले तेरा स-साना बच्‍चाहरूलाई खोस्छ र तिनीहरूलाई चट्टानमा पछार्दछ।<verse eid="PSA 137:9"/></para>
<chapter eid="PSA 137"/>
<chapter number="138" style="c" sid="PSA 138"/>
<para style="p"><verse number="1" style="v" sid="PSA 138:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। हे याहवेह, सम्पूर्ण हृदयले म तपाईंको प्रशंसा गर्नेछु; “देवताहरूका” सामु म तपाईंको प्रशंसाको गीत गाउनेछु।<verse eid="PSA 138:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 138:2"/>म तपाईंको पवित्र मन्दिरतिर फर्केर दण्डवत् गर्नेछु; अनि तपाईंको अचुक प्रेम र विश्‍वसनीयताको निम्ति तपाईंको नामको प्रशंसा गर्नेछु; किनकि तपाईंले आफ्नो आदेश यति उच्‍च पार्नुभयो कि, यसले तपाईंको प्रसिद्धिलाई पनि पार गर्दछ।<verse eid="PSA 138:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 138:3"/>जब मैले पुकारेँ, तपाईंले मलाई जवाफ दिनुभयो; तपाईंले मलाई बल दिएर ज्यादै साहसी बनाउनुभयो।<verse eid="PSA 138:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 138:4"/>हे याहवेह, तपाईंका आदेशहरू सुनेर, यस पृथ्वीका सम्पूर्ण राजाहरूले तपाईंको प्रशंसा गरून्।<verse eid="PSA 138:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 138:5"/>तिनीहरूले याहवेहका मार्गहरूको जयजयकार गरून्; किनकि याहवेहको महिमा महान् छ।<verse eid="PSA 138:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 138:6"/>याहवेह उच्‍चमा हुनुभए तापनि उहाँले नम्रहरूमाथि दयाले हेर्नुहुन्छ; तर अहङ्कारीहरूलाई भने उहाँले टाढैबाट चिन्‍नुहुन्छ।<verse eid="PSA 138:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 138:7"/>म सङ्कष्‍टको बीच भएर हिँड्नुपरे तापनि तपाईंले मेरो जीवनको रक्षा गर्नुहुन्छ; मेरा वैरीहरूका क्रोधको विरुद्धमा तपाईंले हात बढाउनुहुन्छ; र तपाईंको दाहिने हातले मलाई बचाउनुहुन्छ।<verse eid="PSA 138:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 138:8"/>याहवेहले मलाई निर्दोष प्रमाणित गर्नुहुनेछ; हे याहवेह, तपाईंको अचुक प्रेम, सदासर्वदा रहिरहन्छ; तपाईंका हातका कामहरूलाई नत्याग्नुहोस्।<verse eid="PSA 138:8"/></para>
<chapter eid="PSA 138"/>
<chapter number="139" style="c" sid="PSA 139"/>
<para style="p"><verse number="1" style="v" sid="PSA 139:1"/>सङ्गीत निर्देशकको निम्ति, दावीदको भजन। हे याहवेह, तपाईंले मलाई जाँच्नुभएको छ, अनि मलाई चिन्‍नुहुन्छ।<verse eid="PSA 139:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 139:2"/>तपाईंले मेरो उठाइ र मेरो बसाइ जान्‍नुहुन्छ; तपाईंले टाढैबाट मेरो विचार बुझ्नुहुन्छ।<verse eid="PSA 139:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 139:3"/>तपाईंले मेरो हिँडाइ र मेरो सुताइ जान्‍नुहुन्छ; मेरा सबै मार्गहरूसँग तपाईं परिचित हुनुहुन्छ।<verse eid="PSA 139:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 139:4"/>मेरो जिब्रोमा कुनै शब्द आउनअगि नै, हे याहवेह, तपाईंले त्यो सम्पूर्ण रूपले जान्‍नुहुन्छ।<verse eid="PSA 139:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 139:5"/>तपाईंले मलाई अगि र पछिबाट घेर्नुभएको छ; र आफ्नो हात ममाथि राख्नुभएको छ।<verse eid="PSA 139:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 139:6"/>मेरो निम्ति यस्तो ज्ञान ज्यादै आश्‍चर्यपूर्ण छ; यसलाई प्राप्‍त गर्न मेरो निम्ति अति कठिन छ।<verse eid="PSA 139:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 139:7"/>तपाईंको आत्माबाट म कहाँ जान सक्छु? तपाईंको उपस्थितिबाट म कहाँ भाग्न सक्छु?<verse eid="PSA 139:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 139:8"/>यदि म स्वर्गमा गएँ भने तापनि त्यहाँ तपाईं हुनुहुन्छ; यदि पातालमा मैले आफ्नो ओछ्यान बनाएँ भने, त्यहाँ पनि तपाईं हुनुहुन्छ।<verse eid="PSA 139:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 139:9"/>यदि प्रभातको पखेटामा उडेर, समुद्रको पल्‍लो किनारमा पुगेर बसेँ भने पनि,<verse eid="PSA 139:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 139:10"/>त्यहाँ पनि तपाईंको हातले मलाई डोर्‍याउनेछ, र तपाईंको दाहिने हातले मलाई थाम्नेछ।<verse eid="PSA 139:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 139:11"/>यदि मैले, “अन्धकारले मलाई छोपोस्, अनि प्रकाश मेरो चारैतिर रातको अन्धकार होस्,” भनी भनेँ पनि<verse eid="PSA 139:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 139:12"/>अन्धकार तपाईंको निम्ति अँध्यारो हुनेछैन; र रात पनि दिनझैँ चम्कनेछ; किनकि तपाईंको निम्ति अन्धकार पनि ज्योतिजस्तै हो।<verse eid="PSA 139:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 139:13"/>किनकि तपाईंले नै मेरो अन्तस्करण बनाउनुभयो; तपाईंले मलाई मेरी आमाको गर्भमा बुन्‍नुभयो।<verse eid="PSA 139:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 139:14"/>म तपाईंलाई प्रशंसा गर्दछु; किनकि म भयानक र अद्‌भुत तरिकाले बनिएको छु; तपाईंका कार्यहरू अद्‌भुत छन्, म त्यो राम्ररी जान्दछु।<verse eid="PSA 139:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 139:15"/>मेरो आकार तपाईंबाट लुकेको थिएन, जब म पृथ्वीको गहिराइमा रचिँदै थिएँ; जब म अदृष्यमा बनिँदैथिएँ;<verse eid="PSA 139:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 139:16"/>तब तपाईंका आँखाले मेरो नबनिएको त्यो शरीरलाई देखे; मेरा निम्ति तोकिएका दिनहरू तपाईंको पुस्तकमा लेखिएका थिए; तीमध्ये एउटै कुरा पनि अस्तित्वमा आउनअगि सबै लेखिएका थिए।<verse eid="PSA 139:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 139:17"/>हे परमेश्‍वर, मेरा निम्ति तपाईंका विचारहरू कति मूल्यवान् छन्! तिनको योग कति विशाल छ!<verse eid="PSA 139:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 139:18"/>यदि मैले तिनलाई गन्ती गरेँ भने, बालुवाका कणहरूभन्दा पनि तिनको संख्या बढी हुनेछन्। जब म बिउँझन्छु, तब म तपाईंसँग नै भएको पाउँदछु।<verse eid="PSA 139:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 139:19"/>हे परमेश्‍वर, तपाईंले दुष्‍टहरूलाई मार्नुभए त कति असल हुनेथियो! हे रक्तपिपासुहरू हो, मबाट दूर भइजाओ!<verse eid="PSA 139:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 139:20"/>दुष्‍ट मनसायले तिनीहरू तपाईंको विषयमा बोल्दछन्; तपाईंका शत्रुहरूले तपाईंको नामको दुरुपयोग गर्दछन्।<verse eid="PSA 139:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 139:21"/>हे याहवेह, तपाईंलाई घृणा गर्नेहरूलाई, के म घृणा गर्दिनँ र? र तपाईंको विरोध गर्नेहरूलाई, के म तुच्छ ठान्दिनँ र?<verse eid="PSA 139:21"/></para>
<para style="p"><verse number="22" style="v" sid="PSA 139:22"/>मेरो हृदयमा तिनीहरूका निम्ति घृणाबाहेक अरू केही छैन; म तिनीहरूलाई मेरै शत्रु ठान्दछु।<verse eid="PSA 139:22"/></para>
<para style="p"><verse number="23" style="v" sid="PSA 139:23"/>हे परमेश्‍वर, मलाई जाँच्नुहोस्, र मेरो हृदयलाई चिन्‍नुहोस्; मलाई खार्नुहोस् र मेरा चिन्तित विचारहरू जान्‍नुहोस्।<verse eid="PSA 139:23"/></para>
<para style="p"><verse number="24" style="v" sid="PSA 139:24"/>हेर्नुहोस्, मभित्र कुनै आपत्तिजनक चाल पो छ कि, र मलाई अनन्तको मार्गमा डोर्‍याउनुहोस्!<verse eid="PSA 139:24"/></para>
<chapter eid="PSA 139"/>
<chapter number="140" style="c" sid="PSA 140"/>
<para style="p"><verse number="1" style="v" sid="PSA 140:1"/>दावीदको भजन। हे याहवेह, दुष्‍ट मानिसहरूदेखि मलाई छुटाउनुहोस्; हिंस्रक मानिसहरूदेखि मलाई रक्षा गरिदिनुहोस्;<verse eid="PSA 140:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 140:2"/>जसले आफ्ना हृदयमा दुष्‍ट योजना बनाउँछन्, र दिनहुँ युद्ध मच्‍चाउँछन्।<verse eid="PSA 140:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 140:3"/>तिनीहरूले आफ्ना जिब्राहरू सर्पको जत्तिकै विषालु बनाउँछन्; तिनीहरूका ओठमा गोमन सर्पको विष छ। सेला<verse eid="PSA 140:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 140:4"/>हे याहवेह, दुष्‍टहरूका हातबाट मलाई सुरक्षित राख्नुहोस्; हिंस्रक मानिसबाट मलाई रक्षा गर्नुहोस्; जसले मेरा खुट्टाहरूमा ठेस लाग्ने योजना बनाउँछन्।<verse eid="PSA 140:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 140:5"/>अहङ्कारी मानिसहरूले मेरो निम्ति पासो थापेका छन्; तिनीहरूले आफ्ना जाल बिछाएका छन्; र मेरो निम्ति बाटोमा धराप थापेका छन्। सेला<verse eid="PSA 140:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 140:6"/>म याहवेहलाई भन्दछु, “तपाईं मेरा परमेश्‍वर हुनुहुन्छ।” हे याहवेह, मेरो दयाको पुकार सुन्‍नुहोस्!<verse eid="PSA 140:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 140:7"/>हे याहवेह प्रभु, मेरा शक्तिशाली उद्धारक, लडाइँका दिनमा तपाईंले मेरो शिर सुरक्षित राख्नुहुन्छ।<verse eid="PSA 140:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 140:8"/>हे याहवेह, दुष्‍टहरूका इच्छा पूरा हुन नदिनुहोस्; तिनीहरूका योजनाहरू सफल हुन नदिनुहोस्। सेला<verse eid="PSA 140:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 140:9"/>जसले मलाई चारैतिरबाट घमण्डले शिर उठाउँदै घेरेका छन्; तिनीहरूका ओठको दुष्‍टता तिनीहरूमाथि नै आइपरोस्!<verse eid="PSA 140:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 140:10"/>झरझराउँदो भुङ्ग्रो तिनीहरूमाथि ओइरियोस्; तिनीहरूलाई आगोमा नै फ्याँकियोस्; र कहिल्यै उठ्न नसक्ने गरी हिलाम्मे खाडलमा जाकिऊन्!<verse eid="PSA 140:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 140:11"/>निन्दा गर्नेहरू भूमिमा स्थापित नहोऊन्, हिंस्रक मानिसलाई विनाशले शिकार बनाओस्!<verse eid="PSA 140:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 140:12"/>म जान्दछु, याहवेहले सताइएहरूका पक्षमा न्याय दिनुहुन्छ; र खाँचोमा परेकाहरूलाई न्यायको समर्थन गर्नुहुन्छ।<verse eid="PSA 140:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 140:13"/>निश्‍चय नै धर्मीहरूले तपाईंको नामको प्रशंसा गर्नेछन्; अनि सत्यनिष्‍ठ मानिसहरू तपाईंको उपस्थितिमा बास गर्नेछन्।<verse eid="PSA 140:13"/></para>
<chapter eid="PSA 140"/>
<chapter number="141" style="c" sid="PSA 141"/>
<para style="p"><verse number="1" style="v" sid="PSA 141:1"/>दावीदको भजन। हे याहवेह, म तपाईंलाई पुकार्छु, तपाईं चाँडै मकहाँ आउनुहोस्; जब म तपाईंलाई पुकार्छु, मलाई सुनिदिनुहोस्!<verse eid="PSA 141:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 141:2"/>मेरो प्रार्थना तपाईंको सामु सुगन्धित धूपजस्तै होस्; र मैले आफ्ना हातहरू उचाल्दा, बेलुकीको त्यस बलिदानजस्तै ठहरिओस्!<verse eid="PSA 141:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 141:3"/>हे याहवेह, मेरो मुखमा एउटा पाले राखिदिनुहोस्; मेरा ओठहरूको ढोकामाथि रखवाली गरिदिनुहोस्!<verse eid="PSA 141:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 141:4"/>मेरो हृदय खराब कुरातिर आकर्षित नहोस्; ताकि अधर्मीहरूका दुष्कर्ममा म कुनै भाग नलिऊँ; साथै ती कुकर्मीहरूसित मिलेर मैले तिनीहरूको स्वादिष्‍ठ भोजन खान नपरोस्!<verse eid="PSA 141:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 141:5"/>धर्मी जनले मलाई हिर्काऊन्, त्यो त मेरो निम्ति दया हुनेछ; तिनले मलाई हप्काऊन्, त्योचाहिँ मेरो शिरको निम्ति तेल हुनेछ। मेरो शिरले त्यसलाई इन्कार गर्नेछैन; किनभने मेरो प्रार्थना सधैँ कुकर्मीहरूका कामको विरुद्ध हुन्छ।<verse eid="PSA 141:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 141:6"/>तिनीहरूका शासक भिरबाट तल खसालिनेछन्, र दुष्‍टहरूले जान्‍नेछन् कि, मेरा वचनहरू ठिक थिए।<verse eid="PSA 141:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 141:7"/>तिनीहरूले भन्‍नेछन्, “जसरी हलो जोत्नेले जमिन जोतेर फुटाउँछ, त्यसरी नै हाम्रा हाडहरू चिहानका मुखमा छरिएका छन्।”<verse eid="PSA 141:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 141:8"/>हे याहवेह प्रभु, मेरा आँखा तपाईंतिरै रहन्छन्; म तपाईंमा शरण लिन्छु; मेरो जीवन मृत्युलाई नदिनुहोस्!<verse eid="PSA 141:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 141:9"/>कुकर्मीहरूले मेरा निम्ति थापेको धरापबाट, तिनीहरूले थापेका पासोबाट मलाई रक्षा गर्नुहोस्!<verse eid="PSA 141:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 141:10"/>म सकुशल उम्कँदा, दुष्‍टहरूचाहिँ तिनीहरूका आफ्नै जालमा फसून्।<verse eid="PSA 141:10"/></para>
<chapter eid="PSA 141"/>
<chapter number="142" style="c" sid="PSA 142"/>
<para style="p"><verse number="1" style="v" sid="PSA 142:1"/>दावीदको मस्किल;* गुफामा हुँदा उनको प्रार्थना। उच्‍च सोरले म याहवेहलाई पुकार्दछु; दयाको निम्ति याहवेहमा म आफ्नो आवाज उचाल्छु।<verse eid="PSA 142:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 142:2"/>उहाँको सामु म आफ्नो उजुर पोख्दछु; उहाँको सामु म आफ्नो पीडा प्रकट गर्दछु।<verse eid="PSA 142:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 142:3"/>मेरो आत्मा मभित्र व्याकुल हुँदा, त्यो तपाईं नै हुनुहुन्छ, जसले मेरो मार्ग जान्‍नुहुन्छ। म हिँड्ने मार्गमा मानिसहरूले मेरो निम्ति पासो थापेका छन्।<verse eid="PSA 142:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 142:4"/>मेरो दाहिने हातपट्टि हेर्नुहोस्; कसैलाई मेरो वास्ता छैन। मेरो शरणस्थान कहीँ छैन; कसैले मेरो जीवनको वास्ता गर्दैन।<verse eid="PSA 142:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 142:5"/>हे याहवेह, म तपाईंलाई पुकार गर्छु; म भन्दछु, “तपाईं मेरो शरणस्थान हुनुहुन्छ, अनि जीवितहरूका देशमा मेरो भाग हुनुहुन्छ।”<verse eid="PSA 142:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 142:6"/>मेरो पुकार सुनिदिनुहोस्; किनकि म ज्यादै नम्र भएको छु; मलाई खेद्नेहरूबाट मलाई बचाउनुहोस्; किनकि तिनीहरू मभन्दा धेरै बलिया छन्।<verse eid="PSA 142:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 142:7"/>मेरो कैदबाट मलाई छुटाउनुहोस्; ताकि म तपाईंको नामको प्रशंसा गर्न सकूँ। म प्रतिको तपाईंको भलाइको कारण, धर्मीहरू मेरा चारैतिर भेला हुनेछन्।<verse eid="PSA 142:7"/></para>
<chapter eid="PSA 142"/>
<chapter number="143" style="c" sid="PSA 143"/>
<para style="p"><verse number="1" style="v" sid="PSA 143:1"/>दावीदको भजन। हे याहवेह, मेरो प्रार्थना सुन्‍नुहोस्; दयाको लागि मेरो अन्तर्बिन्तीलाई ध्यान दिनुहोस्; तपाईंको विश्‍वसनीयता र धार्मिकताअनुसार मलाई जवाफ दिनुहोस्!<verse eid="PSA 143:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 143:2"/>आफ्नो सेवकलाई मुद्दा मामिलाको न्यायमा नलैजानुहोस्; किनकि कोही पनि जीवित मानिस तपाईंको सामु धर्मी ठहरिँदैन।<verse eid="PSA 143:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 143:3"/>शत्रुले मलाई लखेट्छ; त्यसले मलाई जमिनमा लडाएर कुल्चन्छ; धेरै अगि नै मरिसकेकाहरूजस्तै गरी, त्यसले मलाई अन्धकारमा बस्‍न बाध्य पार्दछ।<verse eid="PSA 143:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 143:4"/>यसर्थ मेरो आत्मा मभित्र खिन्‍न हुन्छ; मेरो हृदय मभित्रै विचलित भएको छ।<verse eid="PSA 143:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 143:5"/>म अतीतका ती दिनहरू सम्झना गर्दछु; तपाईंका सबै कार्यहरूमा ध्यान गर्दछु, र तपाईंका हातले गरेका काममाथि विचार गर्दछु।<verse eid="PSA 143:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 143:6"/>म मेरा हात तपाईंतिर फैलाउँछु; सुक्खा जमिनझैँ म तपाईंको निम्ति तिर्खाउँछु। सेला<verse eid="PSA 143:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 143:7"/>हे याहवेह, मलाई झट्टै जवाफ दिनुहोस्; मेरो आत्मा क्षीण हुँदछ। तपाईंको मुहार मबाट नलुकाउनुहोस्; नत्र म चिहानभित्र जानेहरूझैँ हुनेछु।<verse eid="PSA 143:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 143:8"/>हरेक बिहानले मेरा निम्ति तपाईंको अचुक प्रेमको वचन ल्याओस्; किनकि तपाईंमा नै मैले आफ्नो भरोसा राखेको छु; म कुन मार्गमा हिँड्नुपर्ने हो, त्यो मलाई देखाउनुहोस्; किनकि म मेरो जीवन तपाईंमा अर्पण गर्दछु।<verse eid="PSA 143:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 143:9"/>हे याहवेह, मलाई मेरा शत्रुहरूबाट छुटाउनुहोस्; किनकि म आफूलाई तपाईंमा लुकाउँछु।<verse eid="PSA 143:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 143:10"/>मलाई तपाईंको इच्छा पूरा गर्न सिकाउनुहोस्; किनकि तपाईं मेरो परमेश्‍वर हुनुहुन्छ। तपाईंको असल आत्माले मलाई समतल जमिनमा डोर्‍याऊन्!<verse eid="PSA 143:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 143:11"/>हे याहवेह, आफ्ना नामको खातिर मेरो जीवनको रक्षा गर्नुहोस्; तपाईंको धार्मिकतामा मलाई कष्‍टबाट छुटाउनुहोस्।<verse eid="PSA 143:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 143:12"/>तपाईंको अचुक प्रेममा, मेरा शत्रुहरूलाई चुप गराइदिनुहोस्; मेरा सबै वैरीहरूलाई नाश पार्नुहोस्; किनकि म तपाईंको सेवक हुँ।<verse eid="PSA 143:12"/></para>
<chapter eid="PSA 143"/>
<chapter number="144" style="c" sid="PSA 144"/>
<para style="p"><verse number="1" style="v" sid="PSA 144:1"/>दावीदको भजन। याहवेह मेरा चट्टानलाई प्रशंसा होस्, जसले मेरा हातहरूलाई युद्धकला, र मेरा औँलाहरूलाई लडाइँ गर्न सिकाउनुहुन्छ।<verse eid="PSA 144:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 144:2"/>उहाँ मेरो प्रेमिलो परमेश्‍वर, र मेरो किल्‍ला हुनुहुन्छ; उहाँ मेरो बलियो किल्‍ला र मेरो उद्धारक, मेरो ढाल, जसमा म शरण लिन्छु, उहाँले जाति-जातिहरूलाई मेरो अधीनमा राख्नुहुन्छ।<verse eid="PSA 144:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 144:3"/>हे याहवेह, मानव-जाति के हो र तपाईं त्यसको वास्ता गर्नुहुन्छ, मरणशील मानिस को हो, र तपाईं त्यसको विचार गर्नुहुन्छ?<verse eid="PSA 144:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 144:4"/>तिनीहरू त केवल सासजस्तो मात्र हुन्; तिनीहरूका आयु ढलिजाने छायाजस्तै मात्र हुन्।<verse eid="PSA 144:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 144:5"/>हे याहवेह, आफ्ना स्वर्गहरूलाई खोल्नुहोस् र तल ओर्लनुहोस्; पर्वतहरूलाई छुनुहोस् र तीबाट धुवाँ उठोस्।<verse eid="PSA 144:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 144:6"/>बिजुली चम्काउनुहोस् र मेरा शत्रुहरूलाई तितरबितर पार्नुहोस्! आफ्ना काँडहरू छोडेर तिनीहरूलाई अलमलमा पारिदिनुहोस्!<verse eid="PSA 144:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 144:7"/>उच्‍च स्थानबाट आफ्ना हात लम्काउनुहोस्; अनि उर्लंदो बाढीबाट र विदेशीहरूका हातबाट मलाई उद्धार गर्नुहोस् र छुटाउनुहोस्।<verse eid="PSA 144:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 144:8"/>जसका मुख झूटले भरिएका छन्, जसका दाहिने हात छली छन्।<verse eid="PSA 144:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 144:9"/>हे मेरा परमेश्‍वर, म तपाईंको निम्ति एउटा नयाँ गीत गाउनेछु; दशतारे वीणा बजाएर म तपाईंको निम्ति सङ्गीत बजाउनेछु,<verse eid="PSA 144:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 144:10"/>उहाँलाई, जसले राजाहरूलाई विजय दिनुहुन्छ; जसले आफ्नो सेवक दावीदलाई छुटकारा दिनुहुन्छ। घातक तरवारबाट<verse eid="PSA 144:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 144:11"/>मलाई छुटकारा दिनुहोस्; विदेशीहरूका हातबाट उद्धार गरिदिनुहोस्; जसको मुख झूटले भरिएको छ, जसको दाहिने हात छली छ।<verse eid="PSA 144:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 144:12"/>तब हाम्रा छोराहरू तिनीहरूका युवाअवस्थामा मौलाउँदा रूखहरूजस्ता हुनेछन्, र हाम्रा छोरीहरू दरबार सिँगार्न कुँदिएका स्तम्भहरूजस्ता हुनेछन्।<verse eid="PSA 144:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 144:13"/>हाम्रा धनसारहरू हरेक किसिमका अन्‍नले भरिभराउ हुनेछन्; हाम्रा भेडाहरू हजारौँ गुणा बढ्नेछन्, हाम्रा खेतमा ती लाखौँ हुनेछन्;<verse eid="PSA 144:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 144:14"/>हाम्रा गोरुहरूले गह्रौँ भारी बोक्नेछन्। जहाँ पर्खालहरू फोरिनेछैनन्; हामी निर्वासनमा जानुपर्नेछैन; हाम्रा सडकहरूमा विलापको रुवाइ हुनेछैन।<verse eid="PSA 144:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 144:15"/>धन्यका हुन् ती प्रजाहरू; जसको जीवनमा यो सत्य साबित भएको छ; धन्यका हुन् ती प्रजाहरू, जसका परमेश्‍वर याहवेह हुनुहुन्छ!<verse eid="PSA 144:15"/></para>
<chapter eid="PSA 144"/>
<chapter number="145" style="c" sid="PSA 145"/>
<para style="p"><verse number="1" style="v" sid="PSA 145:1"/>दावीदको प्रशंसाको भजन। हे मेरा परमेश्‍वर, मेरा राजा, म तपाईंलाई उच्‍च पार्नेछु; म सदासर्वदा तपाईंको नामको प्रशंसा गर्नेछु।<verse eid="PSA 145:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 145:2"/>हरेक दिन म तपाईंको प्रशंसा गर्नेछु, र सदासर्वदा तपाईंको नामको स्तुति गर्नेछु।<verse eid="PSA 145:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 145:3"/>याहवेह महान् र प्रशंसाको अति योग्य हुनुहुन्छ; उहाँको महानता अपार छ।<verse eid="PSA 145:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 145:4"/>एक पुस्ताले अर्को पुस्तालाई तपाईंका महान् कामहरूको प्रशंसा गर्नेछन्; तिनीहरूले तपाईंका शक्तिशाली कामहरूको वर्णन गर्नेछन्।<verse eid="PSA 145:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 145:5"/>तिनीहरूले तपाईंका ऐश्‍वर्यको महिमामय वैभवको वर्णन गर्नेछन्— र म तपाईंका आश्‍चर्यपूर्ण कार्यहरूमा मनन गर्नेछु।<verse eid="PSA 145:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 145:6"/>मानिसहरूले तपाईंका अद्‌भुत कार्यहरूका शक्तिको विषयमा चर्चा गर्नेछन्— र म तपाईंका महान् कार्यहरूको घोषणा गर्नेछु।<verse eid="PSA 145:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 145:7"/>तिनीहरूले तपाईंको प्रशस्त भलाइको बारेमा उत्सव मनाउनेछन्, र तपाईंको धार्मिकताबारे आनन्दले जयजयकार गर्नेछन्।<verse eid="PSA 145:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 145:8"/>याहवेह अनुग्रही र कृपालु हुनुहुन्छ; रिसाउनमा ढिलो र अचुक प्रेममा महान् हुनुहुन्छ।<verse eid="PSA 145:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 145:9"/>याहवेह सबैमाथि भलो हुनुहुन्छ; र आफ्ना सारा सृष्‍टिमाथि उहाँले कृपा देखाउनुहुन्छ।<verse eid="PSA 145:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 145:10"/>हे याहवेह, तपाईंले सृष्‍टि गर्नुभएका सबै थोकले तपाईंको प्रशंसा गर्दछन्; तपाईंका विश्‍वासयोग्य जनहरूले तपाईंको स्तुति गर्नेछन्।<verse eid="PSA 145:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 145:11"/>तिनीहरूले तपाईंको राज्यको महिमाको वर्णन गर्नेछन्; र तपाईंको शक्तिको बखान गर्नेछन्,<verse eid="PSA 145:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 145:12"/>ताकि सबै मानिसहरूले तपाईंका शक्तिशाली कार्यहरू, र तपाईंका राज्यको महिमामय वैभव थाहा पाऊन्।<verse eid="PSA 145:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 145:13"/>तपाईंको राज्य अनन्तको राज्य हो, र तपाईंको प्रभुत्व पुस्तौँ-पुस्तासम्म रहिरहन्छ। आफ्ना सबै प्रतिज्ञामा याहवेह भरोसायोग्य हुनुहुन्छ, र उहाँले गर्नुहुने सबै थोकप्रति विश्‍वासयोग्य हुनुहुन्छ।<verse eid="PSA 145:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 145:14"/>लडेकाहरू सबैलाई याहवेहले सहारा दिनुहुन्छ; दबिएकाहरू सबैलाई उठाउनुहुन्छ।<verse eid="PSA 145:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 145:15"/>सबैका आँखाहरूले तपाईंकै बाटो हेर्दछन्; अनि तपाईंले तिनीहरूलाई उचित समयमा तिनीहरूको भोजन दिनुहुन्छ।<verse eid="PSA 145:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 145:16"/>तपाईंले आफ्नो मुट्ठी खोल्नुहुन्छ, र हरेक जीवित प्राणीका इच्छाहरूलाई तृप्‍त पार्नुहुन्छ।<verse eid="PSA 145:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 145:17"/>याहवेह उहाँका सबै मार्गहरूमा धर्मी हुनुहुन्छ, र उहाँले गर्नुहुने सबै थोकप्रति विश्‍वासयोग्य हुनुहुन्छ।<verse eid="PSA 145:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 145:18"/>याहवेहलाई पुकार्ने सबैको नजिक उहाँ हुनुहुन्छ, उहाँलाई सत्यतामा पुकार्ने सबैको नजिक उहाँ हुनुहुन्छ।<verse eid="PSA 145:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 145:19"/>उहाँको भय मान्‍नेहरूका इच्छालाई उहाँले पूरा गर्नुहुन्छ; उहाँले तिनीहरूको पुकार सुन्‍नुहुन्छ र तिनीहरूलाई बचाउनुहुन्छ।<verse eid="PSA 145:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 145:20"/>उहाँलाई प्रेम गर्ने सबैलाई याहवेहले रक्षा गर्नुहुन्छ; तर सबै दुष्‍टहरूलाई उहाँले नाश पार्नुहुनेछ।<verse eid="PSA 145:20"/></para>
<para style="p"><verse number="21" style="v" sid="PSA 145:21"/>मेरो मुखले याहवेहको प्रशंसा गर्नेछ; हरेक प्राणीले सदासर्वदा उहाँको पवित्र नामको प्रशंसा गरून्!<verse eid="PSA 145:21"/></para>
<chapter eid="PSA 145"/>
<chapter number="146" style="c" sid="PSA 146"/>
<para style="p"><verse number="1" style="v" sid="PSA 146:1"/>याहवेहको प्रशंसा गर! हे मेरो प्राण, याहवेहको प्रशंसा गर्!<verse eid="PSA 146:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 146:2"/>म मेरो जीवनभरि याहवेहको प्रशंसा गर्नेछु; म बाँचुन्जेल मेरा परमेश्‍वरको प्रशंसा गाउनेछु।<verse eid="PSA 146:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 146:3"/>शासकहरूमाथि भरोसा नगर; मानव-जातिमाथि, जसले बचाउन सक्दैन।<verse eid="PSA 146:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 146:4"/>जब तिनीहरूको आत्मा निस्कन्छ; तिनीहरू माटोमै फर्कन्छन्; त्यही दिन नै तिनीहरूका योजनाहरू पनि व्यर्थ हुन्छन्।<verse eid="PSA 146:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 146:5"/>धन्य हुन् तिनीहरू, जसका सहायक याकोबका परमेश्‍वर हुनुहुन्छ, जसको आशा याहवेह तिनीहरूका परमेश्‍वरमा हुन्छ।<verse eid="PSA 146:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 146:6"/>उहाँ स्वर्ग र पृथ्वी, समुद्र र त्यसमा भएका सबै थोकका सृष्‍टिकर्ता हुनुहुन्छ; उहाँ सदाकाल विश्‍वासयोग्य रहनुहुन्छ।<verse eid="PSA 146:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 146:7"/>उहाँले थिचोमिचोमा परेकाहरूको पक्षमा भएर न्याय गर्नुहुन्छ; र भोकाएकाहरूलाई भोजन दिनुहुन्छ। याहवेहले कैदीहरूलाई स्वतन्त्र गरिदिनुहुन्छ;<verse eid="PSA 146:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 146:8"/>याहवेहले दृष्‍टिविहीनहरूका आँखा खोलिदिनुहुन्छ; र दबिएकाहरूलाई उठाउनुहुन्छ; याहवेहले धर्मी जनहरूलाई प्रेम गर्नुहुन्छ।<verse eid="PSA 146:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 146:9"/>याहवेहले विदेशीहरूको रक्षा गर्नुहुन्छ; अनाथ र विधवाहरूलाई सम्हाल्नुहुन्छ; तर दुष्‍टहरूको योजनालाई विफल पारिदिनुहुन्छ।<verse eid="PSA 146:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 146:10"/>याहवेहले सदासर्वदा राज्य गर्नुहुन्छ। हे सियोन, तेरा परमेश्‍वरले सारा पुस्तौँ-पुस्तासम्म राज्य गर्नुहुनेछ। याहवेहको प्रशंसा गर!<verse eid="PSA 146:10"/></para>
<chapter eid="PSA 146"/>
<chapter number="147" style="c" sid="PSA 147"/>
<para style="p"><verse number="1" style="v" sid="PSA 147:1"/>याहवेहको प्रशंसा गर! हाम्रा परमेश्‍वरको स्तुति गाउनु असल हो; उहाँको प्रशंसा गर्नु कत्ति आनन्दमय र उचित छ!<verse eid="PSA 147:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 147:2"/>याहवेहले यरूशलेमलाई पुनर्निर्माण गर्नुहुन्छ; उहाँले इस्राएलका निर्वासितहरूलाई एकिकृत गर्नुहुन्छ।<verse eid="PSA 147:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 147:3"/>उहाँले हृदय टुटेकाहरूलाई निको पार्नुहुन्छ, र तिनीहरूका चोटहरूमा मलमपट्टी बाँधिदिनुहुन्छ।<verse eid="PSA 147:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 147:4"/>उहाँले ताराहरूको संख्या तोक्नुहुन्छ; र ती सबैलाई नामद्वारा बोलाउनुहुन्छ।<verse eid="PSA 147:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 147:5"/>हाम्रा प्रभु महान् र शक्तिशाली हुनुहुन्छ; उहाँको समझशक्तिको कुनै सीमा छैन।<verse eid="PSA 147:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 147:6"/>याहवेहले नम्रहरूलाई सम्हाल्नुहुन्छ; तर दुष्‍टलाई भुइँमा खसाल्नुहुन्छ।<verse eid="PSA 147:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 147:7"/>कृतज्ञतासहित याहवेहका निम्ति गाओ; वीणाको सङ्गीत बजाउँदै हाम्रा परमेश्‍वरको स्तुति गाओ।<verse eid="PSA 147:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 147:8"/>उहाँले आकाशलाई बादलले ढाक्नुहुन्छ, र पृथ्वीलाई वर्षा दिनुहुन्छ; अनि पहाडहरूमा घाँस उमार्नुहुन्छ।<verse eid="PSA 147:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 147:9"/>उहाँले पशुहरूलाई आहारा दिनुहुन्छ, र कागका बचेराहरू कराउँदा तिनीहरूलाई खुवाउनुहुन्छ।<verse eid="PSA 147:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 147:10"/>उहाँको आनन्द घोडाको बलमा होइन, न त योद्धाका खुट्टामा उहाँ प्रसन्‍न हुनुहुन्छ;<verse eid="PSA 147:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 147:11"/>तर याहवेह उहाँको भय मान्‍नेहरूसँग, उहाँको अचुक प्रेममाथि भरोसा राख्नेहरूसँग प्रसन्‍न हुनुहुन्छ।<verse eid="PSA 147:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 147:12"/>हे यरूशलेम, याहवेहको स्तुति गर्! हे सियोन, आफ्ना परमेश्‍वरको प्रशंसा गर्।<verse eid="PSA 147:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 147:13"/>उहाँले तेरा ढोकाहरूका आग्लोहरू बलियो पारिदिनुहुन्छ; अनि तँभित्र बास गर्ने जातिलाई आशिष् दिनुहुन्छ।<verse eid="PSA 147:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 147:14"/>उहाँले तेरा सिमानाहरूमा शान्ति ल्याउनुहुन्छ, उहाँले तँलाई असल गहुँले सन्तुष्‍ट पार्नुहुन्छ।<verse eid="PSA 147:14"/></para>
<para style="p"><verse number="15" style="v" sid="PSA 147:15"/>उहाँले पृथ्वीमा आफ्नो आदेश पठाउनुहुन्छ; उहाँको उर्दी द्रूत गतिमा प्रसार हुन्छ।<verse eid="PSA 147:15"/></para>
<para style="p"><verse number="16" style="v" sid="PSA 147:16"/>उहाँले हिउँलाई ऊनजस्तै फैलाउनुहुन्छ; अनि तुसारोलाई खरानीझैँ छरिदिनुहुन्छ।<verse eid="PSA 147:16"/></para>
<para style="p"><verse number="17" style="v" sid="PSA 147:17"/>उहाँले असिना कङ्कढझैँ बर्साउनुहुन्छ; उहाँका कठ्याङग्रिने चिसोमा को टिक्न सक्छ?<verse eid="PSA 147:17"/></para>
<para style="p"><verse number="18" style="v" sid="PSA 147:18"/>उहाँले आफ्ना वचन पठाउनुहुन्छ र ती पगाल्नुहुन्छ; उहाँले आफ्नो बतास चलाउनुहुन्छ, र पानी बग्न थाल्छ।<verse eid="PSA 147:18"/></para>
<para style="p"><verse number="19" style="v" sid="PSA 147:19"/>उहाँले आफ्नो वचन याकोबलाई, अनि आफ्ना नियम र आदेशहरू इस्राएललाई प्रकट गर्नुभएको छ।<verse eid="PSA 147:19"/></para>
<para style="p"><verse number="20" style="v" sid="PSA 147:20"/>उहाँले अरू जातिको निम्ति यस्तो कार्य गर्नुभएको छैन; तिनीहरूले उहाँका नियमहरू जान्दैनन्। याहवेहको प्रशंसा गर!<verse eid="PSA 147:20"/></para>
<chapter eid="PSA 147"/>
<chapter number="148" style="c" sid="PSA 148"/>
<para style="p"><verse number="1" style="v" sid="PSA 148:1"/>याहवेहको प्रशंसा गर! स्वर्गहरूबाट याहवेहको प्रशंसा गर! उच्‍च स्थानहरूबाट उहाँको प्रशंसा गर!<verse eid="PSA 148:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 148:2"/>हे उहाँका सबै दूतहरू हो, उहाँको प्रशंसा गर! हे उहाँका स्वर्गीय सेनाहरू हो, उहाँको प्रशंसा गर!<verse eid="PSA 148:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 148:3"/>हे सूर्य र चन्द्रमा हो, उहाँको प्रशंसा गर; हे सबै चम्किला ताराहरू हो, उहाँको प्रशंसा गर!<verse eid="PSA 148:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 148:4"/>हे सर्वोच्‍च स्वर्गहरू र आकाशमाथिका पानी हो, तिमीहरूले उहाँको प्रशंसा गर!<verse eid="PSA 148:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 148:5"/>तिनीहरूले याहवेहको नामको प्रशंसा गरून्; किनकि तिनीहरू उहाँका आज्ञामा सृष्‍टि भए।<verse eid="PSA 148:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 148:6"/>तब उहाँले तिनीहरूलाई सदासर्वदाको निम्ति स्थापना गर्नुभयो; उहाँले कहिल्यै नटल्ने उर्दी जारी गर्नुभयो।<verse eid="PSA 148:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 148:7"/>पृथ्वीबाट याहवेहको प्रशंसा गर! हे सामुद्रिक विशाल जन्तुहरू हो, र सबै गहिरा सागरहरू हो,<verse eid="PSA 148:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 148:8"/>बिजुली र असिना, हिउँ र बादल, उहाँका वचन पालन गर्ने आँधीबतास हो;<verse eid="PSA 148:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 148:9"/>पर्वतहरू र सबै डाँडाहरू हो, फल फलाउने रूखहरू र सबै देवदारुहरू हो;<verse eid="PSA 148:9"/></para>
<para style="p"><verse number="10" style="v" sid="PSA 148:10"/>जङ्गली जनावर र सम्पूर्ण गाईबस्तुहरू हो; स-साना जीवजन्तु र उड्ने पक्षीहरू,<verse eid="PSA 148:10"/></para>
<para style="p"><verse number="11" style="v" sid="PSA 148:11"/>पृथ्वीका राजाहरू र राष्ट्रहरू, भारदारहरू र पृथ्वीका सबै शासकहरू,<verse eid="PSA 148:11"/></para>
<para style="p"><verse number="12" style="v" sid="PSA 148:12"/>युवकहरू र युवतीहरू, वृद्ध मानिसहरू र बालकहरू; सबैले याहवेहको प्रशंसा गर!<verse eid="PSA 148:12"/></para>
<para style="p"><verse number="13" style="v" sid="PSA 148:13"/>तिनीहरू सबैले याहवेहका नामको प्रशंसा गरून्; किनकि उहाँको नाम मात्र सबैभन्दा महान् छ; उहाँको वैभव पृथ्वी र आकाशभन्दा पनि उच्‍च छ।<verse eid="PSA 148:13"/></para>
<para style="p"><verse number="14" style="v" sid="PSA 148:14"/>उहाँले आफ्ना जातिहरूका निम्ति एउटा सिङ खडा गर्नुभएको छ; इस्राएलका सबै विश्‍वासयोग्य सेवकहरूका प्रशंसाको निम्ति, जो उहाँको हृदयका नजिक रहन्छन्। याहवेहको प्रशंसा गर!<verse eid="PSA 148:14"/></para>
<chapter eid="PSA 148"/>
<chapter number="149" style="c" sid="PSA 149"/>
<para style="p"><verse number="1" style="v" sid="PSA 149:1"/>याहवेहको प्रशंसा गर! याहवेहको निम्ति एउटा नयाँ गीत गाओ, उहाँको प्रशंसा उहाँका विश्‍वासयोग्य जनहरूका सभामा छ।<verse eid="PSA 149:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 149:2"/>इस्राएल आफ्ना सृष्‍टिकर्तामा आनन्दित होओस्; सियोनका मानिसहरू तिनीहरूका राजामा रमाऊन्!<verse eid="PSA 149:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 149:3"/>तिनीहरूले नाच्दै उहाँको नामको प्रशंसा गरून्; र उहाँको निम्ति खैँजडी र वीणाको सङ्गीत बजाऊन्!<verse eid="PSA 149:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 149:4"/>किनकि याहवेह आफ्ना प्रजासित प्रसन्‍न हुनुहुन्छ; उहाँले नम्रहरूलाई विजयको मुकुट पहिर्‍याइदिनुहुन्छ।<verse eid="PSA 149:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 149:5"/>उहाँका विश्‍वासयोग्य जनहरूले यस्तो सम्मानमा आनन्द मनाऊन्; र तिनीहरूले आनन्दको निम्ति आ-आफ्ना ओछ्यानमा गाऊन्!<verse eid="PSA 149:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 149:6"/>परमेश्‍वरका प्रशंसाहरू तिनीहरूका मुखमा होऊन्, र तिनीहरूका हातमा दुईधारे तरवार होस्,<verse eid="PSA 149:6"/></para>
<para style="p"><verse number="7" style="v" sid="PSA 149:7"/>ताकि राष्ट्रहरूका विरुद्धमा तिनीहरूले बदला लिनका निम्ति, र जाति-जातिहरूलाई दण्ड दिन;<verse eid="PSA 149:7"/></para>
<para style="p"><verse number="8" style="v" sid="PSA 149:8"/>तिनीहरूका राजालाई साङ्लाहरूले, र तिनीहरूका भारदारलाई फलामका साङ्लाहरूले बाँध्न;<verse eid="PSA 149:8"/></para>
<para style="p"><verse number="9" style="v" sid="PSA 149:9"/>तिनीहरूका विरुद्ध लेखिएका मृत्युदण्ड दिन सकून्— यही नै उहाँका सबै विश्‍वासयोग्य जनहरूको महिमा हो। याहवेहको प्रशंसा गर!<verse eid="PSA 149:9"/></para>
<chapter eid="PSA 149"/>
<chapter number="150" style="c" sid="PSA 150"/>
<para style="p"><verse number="1" style="v" sid="PSA 150:1"/>याहवेहको प्रशंसा गर! परमेश्‍वरलाई उहाँको पवित्र वासस्थानमा प्रशंसा गर; उहाँको शक्तिशाली आकाशमा उहाँको प्रशंसा गर!<verse eid="PSA 150:1"/></para>
<para style="p"><verse number="2" style="v" sid="PSA 150:2"/>उहाँको शक्तिशाली कामहरूको निम्ति उहाँको प्रशंसा गर; उहाँको अपार महानताको निम्ति उहाँको प्रशंसा गर!<verse eid="PSA 150:2"/></para>
<para style="p"><verse number="3" style="v" sid="PSA 150:3"/>तुरही फुक्दै उहाँको प्रशंसा गर; वीणा र सितार बजाएर उहाँको प्रशंसा गर!<verse eid="PSA 150:3"/></para>
<para style="p"><verse number="4" style="v" sid="PSA 150:4"/>खैँजडी बजाएर नाच्दै उहाँको प्रशंसा गर; तारबाजा र बाँसुरी बजाएर उहाँको प्रशंसा गर!<verse eid="PSA 150:4"/></para>
<para style="p"><verse number="5" style="v" sid="PSA 150:5"/>झ्याली बजाएर उहाँको प्रशंसा गर; गुञ्जायमान पार्ने झ्यालीहरू बजाएर उहाँको प्रशंसा गर!<verse eid="PSA 150:5"/></para>
<para style="p"><verse number="6" style="v" sid="PSA 150:6"/>सास हुने हरेकले याहवेहको प्रशंसा गरून्! याहवेहको प्रशंसा गर!<verse eid="PSA 150:6"/></para>
<chapter eid="PSA 150"/>
</usx>