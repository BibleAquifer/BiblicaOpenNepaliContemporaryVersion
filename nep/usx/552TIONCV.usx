<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="2TI" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">2 तिमोथी</para>
<para style="toc1">2 तिमोथी</para>
<para style="toc2">2 तिमोथी</para>
<para style="mt1">2 तिमोथी</para>
<chapter number="1" style="c" sid="2TI 1"/>
<para style="p"><verse number="1" style="v" sid="2TI 1:1"/>ख्रीष्‍ट येशूमा भएको जीवनको प्रतिज्ञाअनुसार परमेश्‍वरको इच्छाद्वारा ख्रीष्‍ट येशूका प्रेरित पावलबाट,<verse eid="2TI 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="2TI 1:2"/>मेरो प्यारो छोरा तिमोथीलाई: परमेश्‍वर पिता र हाम्रा प्रभु ख्रीष्‍ट येशूबाट अनुग्रह, कृपा र शान्ति!<verse eid="2TI 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="2TI 1:3"/>जब म रातदिन प्रार्थनाहरूमा निरन्तर तिमीलाई सम्झन्छु, तब म परमेश्‍वरलाई धन्यवाद दिन्छु; जसको सेवा म मेरा पुर्खाहरूले गरेझैँ शुद्ध विवेकले गर्दछु।<verse eid="2TI 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="2TI 1:4"/>तिम्रा आँसुहरू सम्झन्छु, र तिमीलाई भेट्ने उत्कट इच्छा गर्दछु, ताकि म आनन्दले पूर्ण हुन सकूँ।<verse eid="2TI 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="2TI 1:5"/>मलाई तिम्रो निष्कपट विश्‍वासको सम्झना हुन्छ, जुन पहिले तिम्री बज्यै लोइस र तिम्री आमा युनिसमा थियो। यो विश्‍वास अब तिमीमा पनि छ भनेर म निश्‍चित छु।<verse eid="2TI 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="2TI 1:6"/>यसकारण मैले तिमीमाथि हात राखेर प्रार्थना गर्दा तिमीले पाएको परमेश्‍वरको वरदानलाई बल्दो पार्नलाई म तिमीलाई सम्झना गराउँछु।<verse eid="2TI 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="2TI 1:7"/>किनकि परमेश्‍वरले हामीलाई डरको आत्मा होइन, तर शक्ति, प्रेम र आत्मसंयमताको आत्मा दिनुभएको छ।<verse eid="2TI 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="2TI 1:8"/>यसकारण हाम्रा प्रभुको साक्षी दिन शर्म नमान, न त उहाँको कैदी, मेरो विषयमा नै; तर सुसमाचारका लागि कष्‍टमा परमेश्‍वरको शक्तिद्वारा मसँग सहभागी होऊ।<verse eid="2TI 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="2TI 1:9"/>उहाँले हामीलाई बचाउनुभएको छ, र पवित्र जीवन जिउनको लागि बोलाउनुभएको छ; हामीले गरेका कामका आधारमा होइन, तर उहाँको आफ्नै उद्देश्य र अनुग्रहको कारणले हो। यो अनुग्रह हामीलाई समयको सुरुभन्दा अगिदेखि नै ख्रीष्‍ट येशूमा दिइएको थियो।<verse eid="2TI 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="2TI 1:10"/>तर अब हाम्रा मुक्तिदाता ख्रीष्‍ट येशूको प्रकटद्वारा यो प्रकाशमा ल्याइएको छ। उहाँले मृत्युलाई नाश पार्नुभयो, र सुसमाचारद्वारा जीवन र अमरतालाई प्रकाशमा ल्याउनुभयो।<verse eid="2TI 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="2TI 1:11"/>अनि यही सुसमाचारको लागि म एक प्रचारक, प्रेरित र शिक्षकको रूपमा नियुक्त गरिएको छु।<verse eid="2TI 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="2TI 1:12"/>यसकारण मैले यी कष्‍टहरू भोगिरहेको छु, तरै पनि म शर्माउँदिनँ। किनकि मैले कसमाथि विश्‍वास राखेको छु, सो म जान्दछु, र त्यस दिनसम्मको लागि मैले उहाँलाई जे सुम्पेको छु, उहाँले त्यो सुरक्षित राख्नुहुनेछ भनी म निश्‍चित छु।<verse eid="2TI 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="2TI 1:13"/>तिमीले मबाट सुनेका सत्य शिक्षालाई ख्रीष्‍ट येशूमा विश्‍वास र प्रेमसाथ नमुनाको रूपमा पक्रिराख।<verse eid="2TI 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="2TI 1:14"/>हामीमा बास गर्नुहुने पवित्र आत्माको सहायताद्वारा तिमीलाई सुम्पिएको सत्य वचन सुरक्षित राख।<verse eid="2TI 1:14"/></para>
<para style="p"><verse number="15" style="v" sid="2TI 1:15"/>तिमीलाई थाहै छ, कि एशिया प्रान्तमा हुने हरेकले मलाई त्यागिदिएका छन्, जसमा फुगेलस र हर्मोगेनस पनि हुन्।<verse eid="2TI 1:15"/></para>
<para style="p"><verse number="16" style="v" sid="2TI 1:16"/>प्रभुले ओनेसिफरसका परिवारमाथि कृपा देखाऊन्; किनकि तिनले मलाई घरी-घरी हौसला दिन्थे, र तिनी मेरो बन्धनको शर्म मान्दैनथे।<verse eid="2TI 1:16"/></para>
<para style="p"><verse number="17" style="v" sid="2TI 1:17"/>तर जब तिनी रोममा आए, मलाई नभेट्टाउन्जेल परिश्रमसाथ मेरो खोजी गरे।<verse eid="2TI 1:17"/></para>
<para style="p"><verse number="18" style="v" sid="2TI 1:18"/>त्यस दिन प्रभुले आफ्नो कृपा तिनलाई प्रदान गरून्! तिनले मलाई एफिससमा गरेका सहायताहरू तिमीलाई राम्ररी थाहै छ।<verse eid="2TI 1:18"/></para>
<chapter eid="2TI 1"/>
<chapter number="2" style="c" sid="2TI 2"/>
<para style="p"><verse number="1" style="v" sid="2TI 2:1"/>यसकारण तिमी, मेरो छोरा, ख्रीष्‍ट येशूमा भएको अनुग्रहमा बलियो होऊ।<verse eid="2TI 2:1"/></para>
<para style="p"><verse number="2" style="v" sid="2TI 2:2"/>मबाट तिमीले धेरै साक्षीहरूका उपस्थितिमा सुनेका शिक्षाहरू यस्ता विश्‍वासयोग्य मानिसहरूलाई सुम्पिदेऊ, जो अरूहरूलाई पनि सिकाउन सक्ने योग्यका छन्।<verse eid="2TI 2:2"/></para>
<para style="p"><verse number="3" style="v" sid="2TI 2:3"/>ख्रीष्‍ट येशूका असल सिपाहीझैँ मसँग कष्‍ट भोग।<verse eid="2TI 2:3"/></para>
<para style="p"><verse number="4" style="v" sid="2TI 2:4"/>सिपाहीझैँ युद्ध गर्नेले आफूलाई सामान्य नागरिकसरह जीवनका झन्झटहरूमा अल्झाउँदैन, तर उसले आफ्नो हाकिमलाई प्रसन्‍न पार्न चाहन्छ।<verse eid="2TI 2:4"/></para>
<para style="p"><verse number="5" style="v" sid="2TI 2:5"/>यसै गरी खेलमा भाग लिनेले पनि नियमबमोजिम नखेली विजेताको मुकुट पाउँदैन।<verse eid="2TI 2:5"/></para>
<para style="p"><verse number="6" style="v" sid="2TI 2:6"/>परिश्रम गर्ने किसानले नै पहिला अन्‍नको हिस्सा पाउनुपर्छ।<verse eid="2TI 2:6"/></para>
<para style="p"><verse number="7" style="v" sid="2TI 2:7"/>मैले जे भनिरहेको छु, त्यसमा ध्यान देऊ; किनकि प्रभुले यी सबैमा तिमीलाई समझ दिनुहुनेछ।<verse eid="2TI 2:7"/></para>
<para style="p"><verse number="8" style="v" sid="2TI 2:8"/>मरेकाहरूबाट जीवित पारिनुभएको दावीदको वंश, येशू ख्रीष्‍टलाई सम्झ। मैलै प्रचार गर्ने सुसमाचार यही हो।<verse eid="2TI 2:8"/></para>
<para style="p"><verse number="9" style="v" sid="2TI 2:9"/>यसै सुसमाचारका लागि म अपराधीझैँ साङ्लोले बाँधिने सम्मको कष्‍ट भोगिरहेछु; तर परमेश्‍वरको वचनलाई साङ्लोले बाँध्न सकिँदैन।<verse eid="2TI 2:9"/></para>
<para style="p"><verse number="10" style="v" sid="2TI 2:10"/>यसकारण परमेश्‍वरले चुन्‍नुभएका मानिसहरूका निम्ति ख्रीष्‍ट येशूमा भएको अनन्त महिमासहितको मुक्ति पाऊन् भनेर म हरेक कुरा सहन्छु।<verse eid="2TI 2:10"/></para>
<para style="p"><verse number="11" style="v" sid="2TI 2:11"/>यो भनाइ विश्‍वासयोग्य छ: यदि हामी उहाँसित मर्‍यौँ भने, हामी उहाँसित जिउने पनि छौँ;<verse eid="2TI 2:11"/></para>
<para style="p"><verse number="12" style="v" sid="2TI 2:12"/>यदि हामीले सह्‍यौँ भने, हामी उहाँसित राज्य पनि गर्नेछौँ। यदि हामीले उहाँलाई त्याग्यौँ भने, उहाँले पनि हामीलाई त्याग्नुहुनेछ;<verse eid="2TI 2:12"/></para>
<para style="p"><verse number="13" style="v" sid="2TI 2:13"/>यदि हामी विश्‍वासरहित छौँ भने तापनि उहाँ विश्‍वासयोग्य रहिरहनुहुनेछ; किनकि उहाँ आफ्नो सत्य स्वभावको विरुद्ध जान सक्नुहुन्‍न।<verse eid="2TI 2:13"/></para>
<para style="p"><verse number="14" style="v" sid="2TI 2:14"/>परमेश्‍वरका मानिसहरूलाई यी कुराहरूका विषयमा स्मरण गराइरहनू। परमेश्‍वरको उपस्थितिमा तिनीहरूलाई चेतावनी देऊ, तिनीहरू शब्दहरूको विषयमा तर्कवितर्क नगरून्; किनकि यसबाट केही फाइदा हुँदैन, तर सुन्‍नेहरूलाई नोक्सानी मात्र पुर्‍याउँछ।<verse eid="2TI 2:14"/></para>
<para style="p"><verse number="15" style="v" sid="2TI 2:15"/>आफूलाई परमेश्‍वरको सामु ग्रहणयोग्य तुल्याउने भरमग्दूर प्रयत्न गर; शर्माउन नपर्ने कामदारजस्तै, जसले सत्यको वचनलाई ठिकसँग प्रयोग गर्दछ।<verse eid="2TI 2:15"/></para>
<para style="p"><verse number="16" style="v" sid="2TI 2:16"/>भक्तिहीन र मूर्ख बकबकदेखि अलग बस; किनकि यसमा लागिरहनेहरू अझ बढी भक्तिहीन हुँदै जानेछन्।<verse eid="2TI 2:16"/></para>
<para style="p"><verse number="17" style="v" sid="2TI 2:17"/>तिनीहरूका शिक्षा कुहिँदैगएको घाउझैँ फैलिन्छ। यस्ताहरूमध्ये हुमेनियस र फिलेतस हुन्,<verse eid="2TI 2:17"/></para>
<para style="p"><verse number="18" style="v" sid="2TI 2:18"/>जो सत्यतादेखि बरालिएका छन्। तिनीहरूले मृतकहरूका पुनर्जीवित भइसकेको छ भनेर कतिपयको विश्‍वासलाई उल्टाइदिन्छन्।<verse eid="2TI 2:18"/></para>
<para style="p"><verse number="19" style="v" sid="2TI 2:19"/>तैपनि परमेश्‍वरको जग दृढपूर्वक खडा नै रहन्छ; जसमा यस्ता अक्षरहरूले मोहर लगाइएको छ: “प्रभुले तिनीहरूलाई चिन्‍नुहुन्छ, जो उहाँका आफ्नाहरू हुन्,” र “प्रभुको नाम स्वीकार गर्ने हरेक जन दुष्‍टताबाट अलग हुनैपर्छ।”<verse eid="2TI 2:19"/></para>
<para style="p"><verse number="20" style="v" sid="2TI 2:20"/>एउटा सम्पन्‍न घरमा सुन र चाँदीका भाँडाहरू मात्र हुँदैनन्, तर काठ र माटाका पनि हुन्छन्; कुनै भाँडो विशेष कामको निम्ति र कुनैचाहिँ सामान्य कामको निम्ति प्रयोग गरिन्छ।<verse eid="2TI 2:20"/></para>
<para style="p"><verse number="21" style="v" sid="2TI 2:21"/>यदि कुनै मानिसले आफूलाई यस्ता आदरहीन कामहरूबाट शुद्ध राख्दछ भने त्यो आदरका कामहरूका निम्ति एउटा पात्र बन्‍नेछ; अनि त्यो अलग गरिएको, र मालिकको निम्ति उपयोगी र हरेक असल काम गर्नमा तत्पर हुनेछ।<verse eid="2TI 2:21"/></para>
<para style="p"><verse number="22" style="v" sid="2TI 2:22"/>यसकारण जवानीका खराब अभिलाषाहरूबाट भाग, र शुद्ध हृदयले प्रभुको नाम लिनेहरूसित धार्मिकता, विश्‍वास, प्रेम र शान्तिको पछि लाग।<verse eid="2TI 2:22"/></para>
<para style="p"><verse number="23" style="v" sid="2TI 2:23"/>मूर्खता तथा अज्ञानतापूर्ण विवादहरूबाट अलग बस; किनकि तिमी जान्दछौ यस्ता कुराहरूले झगडाहरू मात्र उत्पन्‍न गराउँछन्।<verse eid="2TI 2:23"/></para>
<para style="p"><verse number="24" style="v" sid="2TI 2:24"/>प्रभुको सेवकले झगडा गर्नैहुँदैन, तर हरेकप्रति दयालु, निपूर्ण रूपमा सिकाउन सक्ने र सहनशील हुनुपर्छ।<verse eid="2TI 2:24"/></para>
<para style="p"><verse number="25" style="v" sid="2TI 2:25"/>आफ्ना विरोधीहरूलाई तिनले नम्रतासाथ सम्झाउनुपर्छ; यो आशामा परमेश्‍वरले तिनीहरूका हृदय परिवर्तन गरून् र सत्यताको ज्ञानमा अगुवाइ गरून्;<verse eid="2TI 2:25"/></para>
<para style="p"><verse number="26" style="v" sid="2TI 2:26"/>अनि तिनीहरूले चेतना पाऊन् र शैतानको पासोबाट उम्कन सकून्, जसमा शैतानले तिनीहरूलाई त्यसको इच्छा पूरा गर्नलाई कैदी बनाएको छ।<verse eid="2TI 2:26"/></para>
<chapter eid="2TI 2"/>
<chapter number="3" style="c" sid="2TI 3"/>
<para style="p"><verse number="1" style="v" sid="2TI 3:1"/>तर यो याद राख! अन्तिम दिनहरूमा डरलाग्दो समयहरू हुनेछन्।<verse eid="2TI 3:1"/></para>
<para style="p"><verse number="2" style="v" sid="2TI 3:2"/>मानिसहरू आफूलाई मात्र प्रेम गर्ने, रुपियाँपैसाको मोह गर्ने, सेखी, घमण्डी, दुर्व्यवहार गर्ने, आमाबुबाका आज्ञा नमान्‍ने, बैगुनी, अपवित्र,<verse eid="2TI 3:2"/></para>
<para style="p"><verse number="3" style="v" sid="2TI 3:3"/>प्रेमविहीन, क्षमारहित, अर्कालाई दोष लगाउने, आत्मसंयम नभएका, निर्दयी, असल कुरा मन नपराउने,<verse eid="2TI 3:3"/></para>
<para style="p"><verse number="4" style="v" sid="2TI 3:4"/>विश्‍वासघाती, लापर्बाही, अहङ्कारले फुलिएका, परमेश्‍वरलाई भन्दा सुख-विलासलाई रुचाउने,<verse eid="2TI 3:4"/></para>
<para style="p"><verse number="5" style="v" sid="2TI 3:5"/>भक्तिको भेष त लिने, तर यसको शक्तिलाई इन्कार गर्नेहरू हुनेछन्। यस्ता मानिसहरूबाट अलग रहनू।<verse eid="2TI 3:5"/></para>
<para style="p"><verse number="6" style="v" sid="2TI 3:6"/>यिनीहरू यस्ता मानिसहरू हुन्, जो अर्काका घरहरूमा सुटुक्‍क पस्छन्, र पापहरूले थिचिएका सबै किसिमका दुष्‍ट इच्छाहरूले शासन गरेका र नैतिक रूपमा कमजोर भएका स्त्रीहरूलाई लोभ्याउँछन्।<verse eid="2TI 3:6"/></para>
<para style="p"><verse number="7" style="v" sid="2TI 3:7"/>यस्ता स्त्रीहरू सधैँ सिक्छन्, तर कहिल्यै पनि सत्यतालाई बुझ्न सक्षम् हुँदैनन्।<verse eid="2TI 3:7"/></para>
<para style="p"><verse number="8" style="v" sid="2TI 3:8"/>जसरी यान्‍नेस र याम्ब्रेसले मोशाको विरोध गरेका थिए, त्यसरी नै यी मानिसहरूले पनि सत्यको विरोध गर्छन्। यिनीहरूको बुद्धि भ्रष्‍ट भएको हुन्छ, र विश्‍वासमा साँचो हुँदैनन्।<verse eid="2TI 3:8"/></para>
<para style="p"><verse number="9" style="v" sid="2TI 3:9"/>तर यान्‍नेस र याम्ब्रेसका मूर्खता सबैमा प्रकट भएझैँ, यिनीहरूको मूर्खता पनि सबैमा प्रकट हुनेछ, र धेरै टिक्न सक्नेछैनन्।<verse eid="2TI 3:9"/></para>
<para style="p"><verse number="10" style="v" sid="2TI 3:10"/>तर तिमीलाई मेरो शिक्षा, मेरो जीवनको तरिका, मेरो उद्देश्य, विश्‍वास, धीरज, प्रेम, सहनशीलता,<verse eid="2TI 3:10"/></para>
<para style="p"><verse number="11" style="v" sid="2TI 3:11"/>सतावटहरू, कष्‍टहरू; एन्टिओखियामा, आइकोनियममा र लुस्त्रामा ममाथि जे-जे घटना घटेका थिए; अनि मैले सहेका के कस्ता सतावटहरू थिए, यी सबै विषयमा थाहा छ। तरै पनि परमेश्‍वरले मलाई ती सबैबाट छुटकारा दिनुभयो।<verse eid="2TI 3:11"/></para>
<para style="p"><verse number="12" style="v" sid="2TI 3:12"/>वास्तवमा हरेक जसले ख्रीष्‍ट येशूमा भक्तिपूर्ण जीवन जिउन चाहन्छ, ऊ सतावटमा पर्ने नै छ।<verse eid="2TI 3:12"/></para>
<para style="p"><verse number="13" style="v" sid="2TI 3:13"/>तर दुष्‍ट मानिसहरू, ठगाहाहरू, ठग्दै र ठगिँदै झन्-झन् खराब हुँदै जानेछन्।<verse eid="2TI 3:13"/></para>
<para style="p"><verse number="14" style="v" sid="2TI 3:14"/>तर तिमीचाहिँ आफूले सिकेका शिक्षा, जसमा तिमी विश्‍वस्त भएका छौ, त्यसैमा लागिरह। तिमी जान्दछौ, ती सत्य हुन् र तिमीलाई सिकाउनेहरू भरोसायोग्य छन्।<verse eid="2TI 3:14"/></para>
<para style="p"><verse number="15" style="v" sid="2TI 3:15"/>तिमीले बालककालदेखि नै पवित्र धर्मशास्त्र जानेका छौ, जसले ख्रीष्‍ट येशूमा भएको विश्‍वासद्वारा पाइने मुक्तिमा डोर्‍याउने ज्ञान दिन सक्षम् छ।<verse eid="2TI 3:15"/></para>
<para style="p"><verse number="16" style="v" sid="2TI 3:16"/>सम्पूर्ण पवित्र धर्मशास्त्र परमेश्‍वरको सास-फुकाइबाट हो, र यो सिकाउन, हप्काउन, सच्याउन र धार्मिकताको तालिम दिनलाई उपयोगी हुन्छ।<verse eid="2TI 3:16"/></para>
<para style="p"><verse number="17" style="v" sid="2TI 3:17"/>जसद्वारा परमेश्‍वरको जन हरेक सुकर्मको लागि निपुण भएर सिद्ध भएको होस्।<verse eid="2TI 3:17"/></para>
<chapter eid="2TI 3"/>
<chapter number="4" style="c" sid="2TI 4"/>
<para style="p"><verse number="1" style="v" sid="2TI 4:1"/>परमेश्‍वरको र जिउँदा तथा मरेकाहरूका न्याय गर्नुहुने ख्रीष्‍ट येशूको उपस्थितिमा, अनि उहाँको पुनरागमन र उहाँको राज्यलाई ध्यानमा राखेर म तिमीलाई यो आदेश दिन्छु:<verse eid="2TI 4:1"/></para>
<para style="p"><verse number="2" style="v" sid="2TI 4:2"/>वचन प्रचार गर, समय र बेसमयमा तयार भइबस, असीम धैर्यता र होसियारपूर्ण शिक्षासहित सुधार गर्दै हप्काऊ, हौसला देऊ।<verse eid="2TI 4:2"/></para>
<para style="p"><verse number="3" style="v" sid="2TI 4:3"/>किनकि यस्तो समय आउनेछ, जब मानिसहरू साँचो शिक्षालाई नसहने हुनेछन्; यसको सट्टा तिनीहरूले आफ्नै इच्छा पूरा गर्नलाई आफ्ना निम्ति शिक्षकहरू थुपार्नेछन्; जसले तिनीहरूका चिलाउने कानले सुन्‍न चाहेका कुराहरू भन्‍नेछन्।<verse eid="2TI 4:3"/></para>
<para style="p"><verse number="4" style="v" sid="2TI 4:4"/>तिनीहरूले आफ्ना कानहरू सत्यताबाट फर्काएर दन्त्यकथाहरूतिर लगाउनेछन्।<verse eid="2TI 4:4"/></para>
<para style="p"><verse number="5" style="v" sid="2TI 4:5"/>तर तिमीचाहिँ हरेक अवस्थामा आत्मसंयम होऊ, कष्‍ट भोग, प्रचारकको काम गर, र आफ्नो सेवाका सबै कामहरू पूरा गर।<verse eid="2TI 4:5"/></para>
<para style="p"><verse number="6" style="v" sid="2TI 4:6"/>किनकि म अर्घबलिझैँ चढाइन लागेको छु, र मेरो बिदाको बेला आइसकेको छ।<verse eid="2TI 4:6"/></para>
<para style="p"><verse number="7" style="v" sid="2TI 4:7"/>मैले उत्तम लडाइँ लडेको छु, मैले आफ्नो दौड सिद्ध्याएको छु, र मैले विश्‍वासलाई जोगाइराखेको छु।<verse eid="2TI 4:7"/></para>
<para style="p"><verse number="8" style="v" sid="2TI 4:8"/>अब मेरो निम्ति धार्मिकताको मुकुट राखिएको छ, जुन मुकुट धार्मिक न्यायकर्ता प्रभुले मलाई त्यस दिन दिनुहुनेछ, मलाई मात्र होइन, तर उहाँको दोस्रो आगमनको प्रतीक्षा गरिरहने सबैलाई पनि दिनुहुनेछ।<verse eid="2TI 4:8"/></para>
<para style="p"><verse number="9" style="v" sid="2TI 4:9"/>मकहाँ चाँडै आउने भरमग्दूर प्रयत्न गर;<verse eid="2TI 4:9"/></para>
<para style="p"><verse number="10" style="v" sid="2TI 4:10"/>किनकि डेमासले यस संसारलाई प्रेम गरेर मलाई त्यागिदिएको छ, र ऊ थेसलोनिकीमा गएको छ। क्रेसेन्स गलातियामा र तीतस दलमातिया गएका छन्।<verse eid="2TI 4:10"/></para>
<para style="p"><verse number="11" style="v" sid="2TI 4:11"/>अहिले लूका मात्र मसँग छन्। मर्कूसलाई भेट र तिमीसँगै लिएर आऊ; किनकि तिनी मेरो सेवाको निम्ति मलाई उपयोगी छन्।<verse eid="2TI 4:11"/></para>
<para style="p"><verse number="12" style="v" sid="2TI 4:12"/>मैले तुखिकसलाई एफिससमा पठाएँ।<verse eid="2TI 4:12"/></para>
<para style="p"><verse number="13" style="v" sid="2TI 4:13"/>तिमी आउँदा त्रोआसमा मैले कार्पससित छाडेका खास्टो र पुस्तकहरू खासगरी चर्मपत्रहरू लिएर आऊ।<verse eid="2TI 4:13"/></para>
<para style="p"><verse number="14" style="v" sid="2TI 4:14"/>तामाको काम गर्ने अलेक्जेन्डरले मलाई धेरै हानि पुर्‍याएको छ। त्यसले गरेको कामको बदला परमेश्‍वरले नै लिनुहुनेछ।<verse eid="2TI 4:14"/></para>
<para style="p"><verse number="15" style="v" sid="2TI 4:15"/>त्यसले हाम्रा सन्देशहरूको घोर विरोध गरेको हुनाले तिमी पनि ऊदेखि होसियार बस।<verse eid="2TI 4:15"/></para>
<para style="p"><verse number="16" style="v" sid="2TI 4:16"/>जब मलाई पहिलो पटक न्यायाधीशकहाँ ल्याइयो, कसैले मेरो पक्ष लिएनन्, तर हरेकले मलाई त्यागिदिए। यसको दोष तिनीहरूलाई नलागोस्।<verse eid="2TI 4:16"/></para>
<para style="p"><verse number="17" style="v" sid="2TI 4:17"/>तर प्रभुले मेरो पक्ष लिएर मलाई शक्ति दिनुभयो, ताकि मद्वारा सुसमाचार पूर्ण रूपले घोषणा गरिएको होस् र सारा गैरयहूदीहरूले ती सुन्‍न सकून्। मलाई सिंहको मुखबाट छुटकारा मिल्यो।<verse eid="2TI 4:17"/></para>
<para style="p"><verse number="18" style="v" sid="2TI 4:18"/>प्रभुले मलाई हरेक दुष्‍ट आक्रमणबाट छुटकारा दिनुहुनेछ र मलाई सुरक्षासाथ उहाँको स्वर्गीय राज्यमा ल्याउनुहुनेछ। उहाँलाई नै सदासर्वदा महिमा भइरहोस्! आमेन।<verse eid="2TI 4:18"/></para>
<para style="p"><verse number="19" style="v" sid="2TI 4:19"/>प्रिस्किला, अक्विला अनि ओनेसिफरसको परिवारलाई अभिवादन भनिदेऊ।<verse eid="2TI 4:19"/></para>
<para style="p"><verse number="20" style="v" sid="2TI 4:20"/>इरास्तस कोरिन्थमा नै बसे; अनि मैले त्रोफिमसलाई मिलेटसमा बिरामी अवस्थामा नै छोडेँ।<verse eid="2TI 4:20"/></para>
<para style="p"><verse number="21" style="v" sid="2TI 4:21"/>हिउँदको समयभन्दा पहिल्यै नै तिमी यहाँ आउने भरसक प्रयत्न गर। युबुलस, पुडेस, लिनस, क्लौडिया र सबै दाजुभाइ-दिदीबहिनीहरूले तिमीलाई अभिवादन पठाएका छन्।<verse eid="2TI 4:21"/></para>
<para style="p"><verse number="22" style="v" sid="2TI 4:22"/>प्रभु तिम्रो आत्मासँग रहून्! तिमीहरूसँग अनुग्रह रहोस्!<verse eid="2TI 4:22"/></para>
<chapter eid="2TI 4"/>
</usx>