<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="1CH" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">1 इतिहास</para>
<para style="toc1">1 इतिहास</para>
<para style="toc2">1 इतिहास</para>
<para style="mt1">1 इतिहास</para>
<chapter number="1" style="c" sid="1CH 1"/>
<para style="p"><verse number="1" style="v" sid="1CH 1:1"/>आदम, शेत, एनोश,<verse eid="1CH 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 1:2"/>केनान, महलालेल, येरेद,<verse eid="1CH 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 1:3"/>हनोक, मतूशेलह, लेमेक, नोआ थिए।<verse eid="1CH 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 1:4"/>नोआका छोराहरू: शेम, हाम र येपेत।<verse eid="1CH 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 1:5"/>येपेतका छोराहरू: गोमेर, मागोग, मादी, यावान, तूबल, मेशेक र तीरास।<verse eid="1CH 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 1:6"/>गोमेरका छोराहरू: अश्कनज, रिपत र तोगर्मा।<verse eid="1CH 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 1:7"/>यावानका छोराहरू: एलीशा, तर्शीश, कित्तीम र रोदानीम।<verse eid="1CH 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 1:8"/>हामका छोराहरू: कूश, इजिप्ट, पूत र कनान।<verse eid="1CH 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 1:9"/>कूशका छोराहरू: सेबा, हवीला, सब्ता, रामाह र सब्तेका। रामाहका छोराहरू: शेबा र ददान।<verse eid="1CH 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 1:10"/>कूश निम्रोदका पिता थिए; जो पृथ्वीमा एक शक्तिशाली योद्धा बने।<verse eid="1CH 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 1:11"/>इजिप्टचाहिँ यिनीहरूका पिता थिए: लूदीमहरू, अनामीहरू, लहाबीहरू, नप्‍तूहीहरू,<verse eid="1CH 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 1:12"/>पत्रुसीहरू, कस्लूहीहरू (जसबाट पलिश्तीहरू आए) र कप्‍तोरीहरू।<verse eid="1CH 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 1:13"/>कनानचाहिँ यिनीहरूका पिता थिए, आफ्ना जेठा छोरा सीदोन र हित्ती<verse eid="1CH 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 1:14"/>यबूसी, एमोरी, गिर्गाशी,<verse eid="1CH 1:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 1:15"/>हिव्वी, अरकी, सिनी,<verse eid="1CH 1:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 1:16"/>अर्वादी, सेमारी र हमातीहरू।<verse eid="1CH 1:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 1:17"/>शेमका छोराहरू: एलाम, अश्शूर, अर्पक्षद, लूद र अराम। अरामका छोराहरू: ऊज, हूल, गेतेर र मेशेक।<verse eid="1CH 1:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 1:18"/>अर्पक्षद शेलहका पिता थिए; अनि शेलहचाहिँ एबेरका पिता थिए।<verse eid="1CH 1:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 1:19"/>एबेरका दुई छोराहरू जन्मिए: एउटाको नाम पेलेग राखियो; किनकि पृथ्वी तिनकै पालोमा विभाजन भएको थियो। तिनको भाइको नाम योक्तान राखियो।<verse eid="1CH 1:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 1:20"/>योक्तान यिनीहरूका पिता थिए: अल्मोदद, शेलेप, हसर्मवेत, येरह,<verse eid="1CH 1:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 1:21"/>हदोराम, ऊजाल, दिक्ला,<verse eid="1CH 1:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 1:22"/>ओबाल, अबीमाएल, शेबा,<verse eid="1CH 1:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 1:23"/>ओपीर, हवीला र योबाब थिए। यी सबै योक्तानका छोराहरू थिए।<verse eid="1CH 1:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 1:24"/>शेम, अर्पक्षद, शेलह,<verse eid="1CH 1:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 1:25"/>एबेर, पेलेग, र रऊ,<verse eid="1CH 1:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 1:26"/>सरूग, नाहोर, तेरह,<verse eid="1CH 1:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 1:27"/>अनि अब्राम (जसलाई अब्राहाम पनि भनिन्छ)।<verse eid="1CH 1:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 1:28"/>अब्राहामका छोराहरू: इसहाक र इश्माएल।<verse eid="1CH 1:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 1:29"/>तिनीहरूका सन्तानहरू यिनै थिए: इश्माएलका जेठा छोरा नबायोत, केदार, अदबील, मिब्साम,<verse eid="1CH 1:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 1:30"/>मिश्मा, दुमा, मस्सा, हदद, तेमा,<verse eid="1CH 1:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 1:31"/>यतूर, नापीश र केदमा। यी सबै इश्माएलका छोराहरू थिए।<verse eid="1CH 1:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 1:32"/>अब्राहामकी उपपत्नी कतूराले जन्माएका छोराहरू: जिम्रान, योक्षान, मदान, मिद्यान, यिशबाक र शूह। योक्षानका छोराहरू: शेबा र ददान।<verse eid="1CH 1:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 1:33"/>मिद्यानका छोराहरू: एपा, एपेर, हनोक, अबीदा र एल्दा। यी सबै कतूराका सन्तानहरू थिए।<verse eid="1CH 1:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 1:34"/>अब्राहाम इसहाकका पिता थिए। इसहाकका छोराहरू: एसाव र इस्राएल।<verse eid="1CH 1:34"/></para>
<para style="p"><verse number="35" style="v" sid="1CH 1:35"/>एसावका छोराहरू: एलीपज, रूएल, येऊश, यालाम र कोरह।<verse eid="1CH 1:35"/></para>
<para style="p"><verse number="36" style="v" sid="1CH 1:36"/>एलीपजका छोराहरू: तेमान, ओमार, सपो, गाताम र कनज; अनि तिम्नाबाट: अमालेक।<verse eid="1CH 1:36"/></para>
<para style="p"><verse number="37" style="v" sid="1CH 1:37"/>रूएलका छोराहरू: नहत, जेरह, शम्मा र मिज्जा।<verse eid="1CH 1:37"/></para>
<para style="p"><verse number="38" style="v" sid="1CH 1:38"/>सेइरका छोराहरू: लोतान, शोबाल, सिबोन, अना, दीशोन, एसेर र दीशान।<verse eid="1CH 1:38"/></para>
<para style="p"><verse number="39" style="v" sid="1CH 1:39"/>लोतानका छोराहरू: होरी र होमान। तिम्नाचाहिँ लोतानकी बहिनी थिइन्।<verse eid="1CH 1:39"/></para>
<para style="p"><verse number="40" style="v" sid="1CH 1:40"/>शोबालका छोराहरू: अल्बान, मानहत, एबाल, शपो र ओनाम। सिबोनका छोराहरू: अय्या र अना।<verse eid="1CH 1:40"/></para>
<para style="p"><verse number="41" style="v" sid="1CH 1:41"/>अनाका छोरा: दीशोन। अनि दीशोनका छोराहरू: हेमदान, एश्बान, यित्रान र करान।<verse eid="1CH 1:41"/></para>
<para style="p"><verse number="42" style="v" sid="1CH 1:42"/>एसेरका छोराहरू: बिल्हान, जावान र अकान। दीशानका छोराहरू: ऊज र अरान।<verse eid="1CH 1:42"/></para>
<para style="p"><verse number="43" style="v" sid="1CH 1:43"/>कुनै इस्राएली राजाले राज्य गर्नुभन्दा अगि एदोममा राज्य गर्ने राजाहरू यिनै थिए: बओरका छोरा बेला, जसको सहरको नाम दिन्हावा राखियो।<verse eid="1CH 1:43"/></para>
<para style="p"><verse number="44" style="v" sid="1CH 1:44"/>बेलाको मृत्युपछि बोज्रामा बस्‍ने जेरहका छोरा योबाब तिनको ठाउँमा राजा भए।<verse eid="1CH 1:44"/></para>
<para style="p"><verse number="45" style="v" sid="1CH 1:45"/>योबाबको मृत्युपछि तेमानीहरूको देशमा बस्‍ने हूशाम तिनको ठाउँमा राजा भए।<verse eid="1CH 1:45"/></para>
<para style="p"><verse number="46" style="v" sid="1CH 1:46"/>हूशामको मृत्युपछि मोआबको देशमा मिद्यानलाई जित्ने बेददका छोरा हदद तिनको ठाउँमा राजा भए। तिनको सहरको नाम अवीत राखियो।<verse eid="1CH 1:46"/></para>
<para style="p"><verse number="47" style="v" sid="1CH 1:47"/>हददको मृत्युपछि मस्रेकामा बस्‍ने शम्‍ला तिनको ठाउँमा राजा भए।<verse eid="1CH 1:47"/></para>
<para style="p"><verse number="48" style="v" sid="1CH 1:48"/>शम्‍लाको मृत्युपछि, यूफ्रेटिस नदी नजिकै बस्‍ने रहोबोतका शौल तिनको ठाउँमा राजा भए।<verse eid="1CH 1:48"/></para>
<para style="p"><verse number="49" style="v" sid="1CH 1:49"/>शौलको मृत्युपछि अक्बोरका छोरा बाल-हानान तिनको ठाउँमा राजा भए।<verse eid="1CH 1:49"/></para>
<para style="p"><verse number="50" style="v" sid="1CH 1:50"/>बाल-हानानको मृत्युपछि हदद तिनको ठाउँमा राजा भए। तिनको सहरको नाम पाऊ राखियो। तिनकी पत्नीको नाम महेतबेल थियो; जो मत्रेदकी छोरी र मेजहाबकी नातिनी थिइन्।<verse eid="1CH 1:50"/></para>
<para style="p"><verse number="51" style="v" sid="1CH 1:51"/>हददको पनि मृत्यु भयो। एदोमका मुखियाहरू यिनीहरू नै थिए: तिम्ना, अल्वा, यतेत,<verse eid="1CH 1:51"/></para>
<para style="p"><verse number="52" style="v" sid="1CH 1:52"/>ओहोलीबामा, एलाह, पीनोन,<verse eid="1CH 1:52"/></para>
<para style="p"><verse number="53" style="v" sid="1CH 1:53"/>कनज, तेमान, मिब्सार,<verse eid="1CH 1:53"/></para>
<para style="p"><verse number="54" style="v" sid="1CH 1:54"/>मग्दीएल र ईराम थिए। यिनीहरू एदोमका मुखियाहरू थिए।<verse eid="1CH 1:54"/></para>
<chapter eid="1CH 1"/>
<chapter number="2" style="c" sid="1CH 2"/>
<para style="p"><verse number="1" style="v" sid="1CH 2:1"/>इस्राएलका छोराहरू यिनै थिए: रूबेन, शिमियोन, लेवी, यहूदा, इस्साखार, जबूलून,<verse eid="1CH 2:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 2:2"/>दान, योसेफ, बेन्यामीन, नप्‍ताली, गाद र आशेर थिए।<verse eid="1CH 2:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 2:3"/>यहूदाका छोराहरू: एर, ओनान र शेलह। यी तीन जना छोराहरूकी आमाचाहिँ कनानी स्त्री शूआ थिइन्। (यहूदाका जेठा छोरा एर याहवेहको दृष्‍टिमा दुष्‍ट थिए। यसकारण याहवेहले तिनलाई मार्नुभयो।)<verse eid="1CH 2:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 2:4"/>यहूदाकी बुहारी तामारले तिनको निम्ति पेरेस र जेरहलाई जन्माइन्। यहूदाका जम्मा पाँच जना छोराहरू थिए।<verse eid="1CH 2:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 2:5"/>पेरेसका छोराहरू: हेस्रोन र हामूल।<verse eid="1CH 2:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 2:6"/>जेरहका छोराहरू: जिम्री, एतान, हेमान, कलकोल र दर्दा, गरेर जम्मा पाँच जना।<verse eid="1CH 2:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 2:7"/>कर्मीका छोरा: आकार, जसले अर्पण गरिएका थोकहरू लिएर आज्ञा उल्‍लङ्घन गरी इस्राएलमाथि विपत्ति ल्याएका थिए।<verse eid="1CH 2:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 2:8"/>एतानका छोरा: अजर्याह।<verse eid="1CH 2:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 2:9"/>हेस्रोनका छोराहरू यिनै थिए: यरहमेल, राम र कालेब।<verse eid="1CH 2:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 2:10"/>राम अम्मीनादाबका पिता थिए; अनि अम्मीनादाबचाहिँ नहशोनका पिता थिए, जो यहूदाका मानिसहरूका अगुवा थिए।<verse eid="1CH 2:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 2:11"/>नहशोन सल्मोनका पिता थिए; सल्मोन बोअजका पिता थिए।<verse eid="1CH 2:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 2:12"/>बोअज ओबेदका पिता थिए; र ओबेद यिशैका पिता थिए।<verse eid="1CH 2:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 2:13"/>यिशै यिनीहरूका पिता थिए: पहिलो छोरा एलिआब; दोस्रो छोरा अबीनादाब, तेस्रो छोरा शिमेअ,<verse eid="1CH 2:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 2:14"/>चौथो नथनिएल, पाँचौँ रद्दै,<verse eid="1CH 2:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 2:15"/>छैटौँ ओसेम र सातौँचाहिँ दावीद थिए।<verse eid="1CH 2:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 2:16"/>तिनीहरूका बहिनीहरू सरूयाह र अबीगेल थिए। सरूयाहका तीन जना छोराहरू थिए—अबीशै, योआब र असाहेल थिए।<verse eid="1CH 2:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 2:17"/>अबीगेलचाहिँ अमासाकी आमा थिइन्। अमासाका पिता इश्माएली येतेर थिए।<verse eid="1CH 2:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 2:18"/>हेस्रोनका छोरा कालेबकी पत्नी अजूबा (र यरीओत) बाट छोराहरू भए। तिनका छोराहरू यिनै हुन्: येशेर, शोबाब र अर्दोन थिए।<verse eid="1CH 2:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 2:19"/>जब अजूबाको मृत्यु भयो, तब कालेबले एप्रातलाई विवाह गरे, जसले तिनका निम्ति हूरलाई जन्माइन्।<verse eid="1CH 2:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 2:20"/>हूर ऊरीका पिता थिए; अनि ऊरीचाहिँ बजलेलका पिता थिए।<verse eid="1CH 2:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 2:21"/>हेस्रोन साठी वर्ष पुग्दा, तिनले गिलादका पिता माकीरकी छोरीसँग विवाह गरे। हेस्रोनले तिनीसँग सहबास गरे, र तिनले हेस्रोनका निम्ति सगूबलाई जन्माइन्।<verse eid="1CH 2:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 2:22"/>सगूब याईरका पिता थिए, जसले गिलादका तेईस वटा सहरहरूमा शासन गर्दथे।<verse eid="1CH 2:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 2:23"/>(तर गेशूर र अरामले हव्वोत-याईर र केनातका, साथै त्यसका चारैतिरका गाउँहरू र साठी वटा नगरहरूसमेत कब्जा गरेका थिए।) यी सबै गिलादका पिता माकीरका सन्तानहरू थिए।<verse eid="1CH 2:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 2:24"/>कालेब-एप्रातामा हेस्रोनको मृत्यु भएको केही समयपछि तिनकी पत्नी अबीयाहले तिनका निम्ति अशहूरलाई जन्माइन्, जो तकोका पिता थिए।<verse eid="1CH 2:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 2:25"/>हेस्रोनका जेठा छोरा यरहमेलका छोराहरू: जेठा छोरा राम, र बूना, ओरेन, ओसेम र अहीयाह।<verse eid="1CH 2:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 2:26"/>यरहमेलकी अर्की पत्नी थिइन्, जसको नाम अतारा थियो; तिनी ओनामकी आमा थिइन्।<verse eid="1CH 2:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 2:27"/>यरहमेलका जेठा छोरा रामका छोराहरू: मास, यामीन र एकेर।<verse eid="1CH 2:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 2:28"/>ओनामका छोराहरू: शम्मै र यादा। शम्मैका छोराहरू: नादाब र अबीशूर।<verse eid="1CH 2:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 2:29"/>अबीशूरकी पत्नीको नाम अबीहेल राखिएको थियो, जसले तिनका निम्ति अहबान र मोलीदलाई जन्माइन्।<verse eid="1CH 2:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 2:30"/>नादाबका छोराहरू: सेलेद र अप्पेम। सेलेद निःसन्तान नै मरे।<verse eid="1CH 2:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 2:31"/>अप्पेमका छोरा: यिशी, जो शेशानका पिता थिए। शेशानचाहिँ अहलैका पिता थिए।<verse eid="1CH 2:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 2:32"/>शम्मैका भाइ यादाका छोराहरू: येतेर र जोनाथन। येतेरचाहिँ निःसन्तान नै मरे।<verse eid="1CH 2:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 2:33"/>जोनाथनका छोराहरू: पेलेत र जाजा। यरहमेलका सन्तानहरू यिनीहरू नै थिए।<verse eid="1CH 2:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 2:34"/>शेशानका छोराहरू थिएनन्, छोरीहरू मात्र थिए। तिनको यर्हा नाम भएको एउटा इजिप्टियन सेवक थियो।<verse eid="1CH 2:34"/></para>
<para style="p"><verse number="35" style="v" sid="1CH 2:35"/>अनि शेशानले यही यर्हासँग आफ्नी छोरीलाई विवाह गरिदिए। तब तिनले अत्तैलाई जन्माइन्।<verse eid="1CH 2:35"/></para>
<para style="p"><verse number="36" style="v" sid="1CH 2:36"/>अत्तै नातानका पिता थिए; र नातान जाबादका पिता थिए;<verse eid="1CH 2:36"/></para>
<para style="p"><verse number="37" style="v" sid="1CH 2:37"/>जाबाद एपलालका पिता थिए; एपलाल ओबेदका पिता थिए;<verse eid="1CH 2:37"/></para>
<para style="p"><verse number="38" style="v" sid="1CH 2:38"/>ओबेद येहूका पिता थिए; येहू अजर्याहका पिता थिए,<verse eid="1CH 2:38"/></para>
<para style="p"><verse number="39" style="v" sid="1CH 2:39"/>अजर्याह हेलेसका पिता थिए; हेलेस एलासाका पिता थिए,<verse eid="1CH 2:39"/></para>
<para style="p"><verse number="40" style="v" sid="1CH 2:40"/>एलासा सिस्मैका पिता थिए; सिस्मै शल्‍लूमका पिता थिए;<verse eid="1CH 2:40"/></para>
<para style="p"><verse number="41" style="v" sid="1CH 2:41"/>शल्‍लूम यकम्याहका पिता थिए; र यकम्याह एलीशामाका पिता थिए।<verse eid="1CH 2:41"/></para>
<para style="p"><verse number="42" style="v" sid="1CH 2:42"/>यरहमेलका भाइ कालेबका छोराहरू: जेठा छोरा मेशा, जो जीपका पिता थिए; अनि दोस्रो मारेशा, जो हेब्रोनका पिता थिए।<verse eid="1CH 2:42"/></para>
<para style="p"><verse number="43" style="v" sid="1CH 2:43"/>हेब्रोनका छोराहरू: कोरह, तप्पूह, रेकेम र शेमा।<verse eid="1CH 2:43"/></para>
<para style="p"><verse number="44" style="v" sid="1CH 2:44"/>शेमा रहमका पिता थिए; र रहमचाहिँ योर्कामका पिता थिए। रेकेम शम्मैका पिता थिए।<verse eid="1CH 2:44"/></para>
<para style="p"><verse number="45" style="v" sid="1CH 2:45"/>शम्मैका छोरा माओन थिए; र माओनचाहिँ बेथ-सूरका पिता थिए।<verse eid="1CH 2:45"/></para>
<para style="p"><verse number="46" style="v" sid="1CH 2:46"/>कालेबको उपपत्नी एपाचाहिँ हारान, मोस र गाजेजको आमा थिइन्। हारानचाहिँ गाजेजका पिता थिए।<verse eid="1CH 2:46"/></para>
<para style="p"><verse number="47" style="v" sid="1CH 2:47"/>यहदैका छोराहरू: रेगेम, योताम, गेशान, पेलेत, एपा र शाप।<verse eid="1CH 2:47"/></para>
<para style="p"><verse number="48" style="v" sid="1CH 2:48"/>कालेबकी उपपत्नी माकाचाहिँ शेबेर र तिर्हानाकी आमा थिइन्।<verse eid="1CH 2:48"/></para>
<para style="p"><verse number="49" style="v" sid="1CH 2:49"/>तिनले मदमन्‍नाका पिता शाप र मक्बेना र गेबाका पिता शेबालाई पनि जन्माइन्। कालेबकी छोरी अक्सा थिइन्।<verse eid="1CH 2:49"/></para>
<para style="p"><verse number="50" style="v" sid="1CH 2:50"/>कालेबका सन्तानहरू यिनै थिए। एप्राताका जेठा छोरा हूरका छोराहरू: किर्यत-यारीमका पिता शोबाल।<verse eid="1CH 2:50"/></para>
<para style="p"><verse number="51" style="v" sid="1CH 2:51"/>बेथलेहेमका पिता सल्मा र बेथ-गादेरका पिता हारेप।<verse eid="1CH 2:51"/></para>
<para style="p"><verse number="52" style="v" sid="1CH 2:52"/>किर्यत-यारीमका पिता शोबालका सन्तानहरू यिनै थिए: हारोए, मनुहोतीहरूका आधा भाग,<verse eid="1CH 2:52"/></para>
<para style="p"><verse number="53" style="v" sid="1CH 2:53"/>अनि किर्यत-यारीमका वंशहरू: यित्रीहरू, पूतवंशीहरू, शुमातीहरू र मिश्राईहरू। यिनीहरूबाट नै सोरातीहरू र एश्तोलीहरूका वंश आएका हुन्।<verse eid="1CH 2:53"/></para>
<para style="p"><verse number="54" style="v" sid="1CH 2:54"/>सल्माका सन्तानहरू: बेथलेहेम, नतोपातीहरू, अत्रोतबेथ-योआब, मानहतीहरूका आधा भाग, सोरीहरू,<verse eid="1CH 2:54"/></para>
<para style="p"><verse number="55" style="v" sid="1CH 2:55"/>अनि याबेसमा बस्‍ने शास्त्रीहरूका वंशहरू: तिरातीहरू, शिमातीहरू र सुकातीहरू। केनीहरू यिनै हुन्, जो रेकाबीहरूका पुर्खा हम्मतबाट आएका थिए।<verse eid="1CH 2:55"/></para>
<chapter eid="1CH 2"/>
<chapter number="3" style="c" sid="1CH 3"/>
<para style="p"><verse number="1" style="v" sid="1CH 3:1"/>हेब्रोनमा जन्मेका दावीदका छोराहरू यिनै हुन्: जेठा छोरा अमनोन, जसकी आमा यिजरेलकी अहीनोम थिइन्; माहिँलाचाहिँ दानिएल, जसकी आमा कर्मेलकी अबीगेल थिइन्;<verse eid="1CH 3:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 3:2"/>साहिँला अब्शालोम, जसकी आमा गेशूरका राजा तल्मैकी छोरी माका थिइन्; काहिँलो अदोनियाह, जसकी आमा हग्गीत थिइन्;<verse eid="1CH 3:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 3:3"/>ठाहिँलो शपत्याह, जसकी आमा अबीतल थिइन्; अनि कान्छो यित्राम, जसकी आमा एग्ला थिइन्।<verse eid="1CH 3:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 3:4"/>यी छ जना दावीदका छोराहरू हेब्रोनमा जन्मेका थिए, जहाँ तिनले सात वर्ष छ महिना राज्य गरे। दावीदले यरूशलेममा तेत्तीस वर्ष राज्य गरे।<verse eid="1CH 3:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 3:5"/>अनि त्यहाँ जन्मेका तिनका सन्तान यिनै हुन्: शिमेअ, शोबाब, नातान र सोलोमन। यी चार जनाचाहिँ अम्मीएलकी छोरी बेतशेबाबाट जन्मेका थिए।<verse eid="1CH 3:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 3:6"/>साथै अरू छोराहरू पनि थिए; यिभार, एलीशूअ, एलीपेलेत,<verse eid="1CH 3:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 3:7"/>नोगह, नेपेग, याफिया,<verse eid="1CH 3:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 3:8"/>एलीशामा, एल्यादा र एलीपेलेत—जम्मा नौ जना।<verse eid="1CH 3:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 3:9"/>यी सबै दावीदका छोराहरू थिए। यसबाहेक तिनका उपपत्नीहरूबाट पनि छोराहरू भएका थिए। अनि तामारचाहिँ तिनीहरूकी बहिनी थिइन्।<verse eid="1CH 3:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 3:10"/>सोलोमनका छोरा रहबाम थिए, रहबामका छोरा अबीयाह, अबीयाहहका छोरा आसा, आसाका छोरा यहोशापात,<verse eid="1CH 3:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 3:11"/>यहोशापातका छोरा यहोराम, यहोरामका छोरा अहज्याह, अहज्याहका छोरा योआश,<verse eid="1CH 3:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 3:12"/>योआशका छोरा अमस्याह, अमस्याहका छोरा अजर्याह, अजर्याहका छोरा योताम,<verse eid="1CH 3:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 3:13"/>योतामका छोरा आहाज, आहाजका छोरा हिजकिया, हिजकियाका छोरा मनश्शे,<verse eid="1CH 3:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 3:14"/>मनश्शेका छोरा आमोन, आमोनका छोरा योशियाह थिए,<verse eid="1CH 3:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 3:15"/>योशियाहका छोराहरू: जेठा योहानान, माहिला यहोयाकीम, साहिँला सिदकियाह र कान्छोचाहिँ शल्‍लूम।<verse eid="1CH 3:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 3:16"/>यहोयाकीमका उत्तराधिकारीहरू: तिनका छोरा यहोयाकीन र सिदकियाह।<verse eid="1CH 3:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 3:17"/>बेबिलोनीहरूले कैदमा लगेका यहोयाकीनका छोराहरू: शालतिएल,<verse eid="1CH 3:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 3:18"/>मल्कीराम, पदायाह, शेनस्सर, यकम्याह, होशामा र नदब्याह।<verse eid="1CH 3:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 3:19"/>पदायाहका छोराहरू: यरुबाबेल र शिमी। यरुबाबेलका छोराहरू: मशुल्‍लाम र हनन्याह। तिनीहरूकी बहिनी शलोमीत थिइन्।<verse eid="1CH 3:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 3:20"/>यरुबाबेलका अरू पाँच जना छोराहरू पनि थिए: हशूबा, ओहेल, बेरेक्याह, हसदयाह र यूशब-हेसेद थिए।<verse eid="1CH 3:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 3:21"/>हनन्याहका सन्तानहरू: पलत्याह र यशयाह, र रपायाहका, अर्नानका, ओबदियाका र शकन्याहका छोराहरू।<verse eid="1CH 3:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 3:22"/>शकन्याहका छोराहरू: शमायाह र तिनका छोराहरू: हत्तूश, यिगाल, बरियाह, नेरियाह र शापात—जम्मा छ जना।<verse eid="1CH 3:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 3:23"/>नेरियाहका छोराहरू: एल्योएनै, हिजकिया र अज्रीकाम—जम्मा तीन जना।<verse eid="1CH 3:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 3:24"/>एल्योएनैका छोराहरू: होदवियाह, एल्यासीब, पलायाह, अक्‍कूब, योहानान, दलायाह र अनानी—जम्मा सात जना।<verse eid="1CH 3:24"/></para>
<chapter eid="1CH 3"/>
<chapter number="4" style="c" sid="1CH 4"/>
<para style="p"><verse number="1" style="v" sid="1CH 4:1"/>यहूदाका छोराहरू: पेरेस, हेस्रोन, कर्मी, हूर र शोबाल।<verse eid="1CH 4:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 4:2"/>शोबालको छोरा रायाह, जो यहतका पिता थिए, र यहतचाहिँ अहूमै र लहदका पिता थिए। यिनीहरू नै सोरातीहरूका वंश थिए।<verse eid="1CH 4:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 4:3"/>एतामका छोराहरू यिनै थिए: यिजरेल, यिश्मा र यिदबश। तिनीहरूकी बहिनीको नाम हस्सलेलपोनी थियो।<verse eid="1CH 4:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 4:4"/>पनीएल, गदोरका पिता थिए र एजेर हूशाहका पिता थिए। एप्राताका जेठा छोरा र बेथलेहेमका पिता हूरका सन्तानहरू यिनीहरू नै थिए।<verse eid="1CH 4:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 4:5"/>तकोका पिता अशहूरका हेलाह र नारा नाम गरेका दुई पत्नीहरू थिए।<verse eid="1CH 4:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 4:6"/>नाराले तिनका निम्ति अहुज्जाम, हेपेर, तेमनी र हाहशतारीलाई जन्माइन्। यिनीहरू नाराका सन्तानहरू थिए।<verse eid="1CH 4:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 4:7"/>हेलाहका छोराहरू: सेरेत, सोहोर, एतनान,<verse eid="1CH 4:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 4:8"/>र कोस, जो अनूब र हज्जोबेबा अनि हारूमका छोरा अहर्हेलका वंशहरूका पिता थिए।<verse eid="1CH 4:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 4:9"/>याबेस नाम गरेका एक जना मानिस थिए। तिनी आफ्ना दाजुभाइहरूभन्दा प्रतिष्‍ठित थिए। तिनकी आमाले “मैले यसलाई कष्‍टमा जन्माएँ,” भनेर तिनको नाम याबेश, राखिन्।<verse eid="1CH 4:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 4:10"/>याबेसले इस्राएलका परमेश्‍वरलाई पुकार गरे, “हे प्रभु, तपाईंले मलाई आशिष् दिएर मेरो इलाका बढाइदिनुहोस्! तपाईंको हात ममाथि रहोस्; अनि मलाई हानिबाट बचाउनुहोस्, ताकि म पीडाबाट मुक्त हुन सकूँ।” परमेश्‍वरले तिनको बिन्ती सुन्‍नुभयो।<verse eid="1CH 4:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 4:11"/>शूहहका भाइ कलूब मेहीरका पिता थिए। मेहीरचाहिँ एश्तोनका पिता थिए।<verse eid="1CH 4:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 4:12"/>एश्तोनचाहिँ बेत-रापा, पसेह र तहिन्‍नाका पिता थिए। तहिन्‍नाचाहिँ इर-नहशका पिता थिए। यिनीहरू नै रेकाका सन्तानहरू थिए।<verse eid="1CH 4:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 4:13"/>कनजका छोराहरू: ओत्निएल र सरायाह। ओत्निएलका छोराहरू: हतात र मनोतै।<verse eid="1CH 4:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 4:14"/>मनोतै ओप्राका पिता थिए। सरायाह, योआबका पिता थिए, योआब गे-हरशीमका पिता थिए। तिनका मानिसहरू सिपालु कारिगरहरू भएका हुनाले तिनलाई बेँसीका कारिगर नाम दिइएको थियो।<verse eid="1CH 4:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 4:15"/>यपून्‍नेको छोरा कालेबका छोराहरू: ईरू, एलाह र नआम थिए। एलाहका छोरा: कनज।<verse eid="1CH 4:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 4:16"/>यहललेलका छोराहरू: जीप, जीपा, तीरया र असरेल।<verse eid="1CH 4:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 4:17"/>एज्राहका छोराहरू: येतेर, मेरेद, एपेर र यालोन। मेरेदका पत्नीहरूमध्ये एक जनाले मिरियम, शम्मै र एश्तमोका पिता यिश्बहलाई जन्माइन्।<verse eid="1CH 4:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 4:18"/>यीचाहिँ फारोकी छोरी बित्याहका छोराछोरीहरू थिए। तिनै बित्याहलाई मेरेदले विवाह गरेका थिए। तिनकी यहूदा कुलबाटकी पत्नीले गदोरका पिता येरेद, सोकोका पिता हेबेर र जानोहका पिता यकूतीएललाई जन्माइन्।<verse eid="1CH 4:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 4:19"/>नहमकी बहिनी होदिय्याहकी पत्नीका छोराहरू: गेरेमी कीलाहका पिता र माकाती एश्तमोका पिता थिए।<verse eid="1CH 4:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 4:20"/>शिमोनका छोराहरू: अमनोन, रिन्‍नाह, बेन-हानान र तीलोन। यिशीका छोराहरू: जोहेत र बेन-जोहेत।<verse eid="1CH 4:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 4:21"/>यहूदाका छोरा, शेलहका छोराहरू: लेकाहका पिता एर, मारेशाका पिता लादाह र बेथ-अश्बेयामा मलमल सुती वस्त्रका काम गर्ने मानिसहरूका वंशहरू,<verse eid="1CH 4:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 4:22"/>योकीम, कोजेबा, योआश र सारापका, मानिसहरू, जसले मोआब र यशूबी लेहेममा शासन गर्थे। (यी विवरणहरू प्राचीन कालदेखिका हुन्।)<verse eid="1CH 4:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 4:23"/>तिनीहरू नतैम र गदेरामा बस्‍ने कुमालेहरू थिए। तिनीहरू त्यहाँ बसेर राजाको निम्ति काम गर्थे।<verse eid="1CH 4:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 4:24"/>शिमियोनका सन्तानहरू: नमूएल, यामीन, यारीब, जेरह र शाऊल;<verse eid="1CH 4:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 4:25"/>शाउलका छोरा शल्‍लूम, नाति मिब्साम, र पनाति मिश्मा थिए।<verse eid="1CH 4:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 4:26"/>मिश्माका सन्तानहरू: तिनका छोरा हम्मूएल, हम्मूएलका छोरा जक्‍कूर, जक्‍कूरका छोरा शिमी।<verse eid="1CH 4:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 4:27"/>शिमीका सोह्र जना छोराहरू र छ जना छोरीहरू थिए। तर तिनका दाजुहरूका धेरै छोराछोरीहरू भएनन्। यसकारण तिनीहरूको सम्पूर्ण वंश यहूदाका मानिसहरूजस्तै संख्यामा धेरै भएनन्।<verse eid="1CH 4:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 4:28"/>तिनीहरू बेर्शेबा, मोलादाह, हसर-शूआल,<verse eid="1CH 4:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 4:29"/>बिल्हा, एसेम, तोलाद,<verse eid="1CH 4:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 4:30"/>बतूएल, होर्मा, सिक्लग,<verse eid="1CH 4:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 4:31"/>बेथ-मर्काबोत, हसर-शूसीम, बेथ-बिरी र शारैममा बस्थे। दावीदले शासन नगरेसम्म तिनीहरूका नगरहरू यिनै थिए।<verse eid="1CH 4:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 4:32"/>तिनीहरूका वरिपरिका गाउँहरू एताम, ऐन, रिम्मोन, तोकेन र आशान गरेर—जम्मा पाँच वटा नगरहरू थिए<verse eid="1CH 4:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 4:33"/>र ती नगरहरू वरिपरिका गाउँहरू बालातसम्मै थिए। तिनीहरूका बस्‍ने ठाउँहरू यिनै थिए। तिनीहरूले वंशावलीको विवरण पनि राखे।<verse eid="1CH 4:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 4:34"/>मशोबाब; यम्‍लेक; अमस्याहका छोरा योशा;<verse eid="1CH 4:34"/></para>
<para style="p"><verse number="35" style="v" sid="1CH 4:35"/>योएल; योशिब्याहका छोरा येहू, जो सरायाहका नाति र असीएलका पनाति थिए।<verse eid="1CH 4:35"/></para>
<para style="p"><verse number="36" style="v" sid="1CH 4:36"/>एल्योएनै; याकोबा; याशोहायाह; असायाह; अदीएल; यसीमीएल; बनायाह;<verse eid="1CH 4:36"/></para>
<para style="p"><verse number="37" style="v" sid="1CH 4:37"/>अनि शिपीका छोरा जीजा, जो अल्‍लोनका नाति, यदायाहका पनाति, शिम्रीका खनाति र शमायाहका जनाति थिए।<verse eid="1CH 4:37"/></para>
<para style="p"><verse number="38" style="v" sid="1CH 4:38"/>माथि उल्‍लेख गरिएका नामका मानिसहरू तिनीहरूका वंशहरूका अगुवाहरू थिए। तिनीहरूका परिवारहरू ज्यादै बढे।<verse eid="1CH 4:38"/></para>
<para style="p"><verse number="39" style="v" sid="1CH 4:39"/>तिनीहरू आफ्ना बगालका निम्ति खर्क खोज्न बेँसीको पूर्वपट्टि गदोरसम्म गए।<verse eid="1CH 4:39"/></para>
<para style="p"><verse number="40" style="v" sid="1CH 4:40"/>त्यहाँ तिनीहरूले प्रशस्त घाँस भएको असल खर्क, फराकिलो मैदान, शान्त र सुरक्षित ठाउँ भेट्टाए। तिनीहरूभन्दा पहिल्यै त्यहाँ केही हामवंशीहरू बसेका थिए।<verse eid="1CH 4:40"/></para>
<para style="p"><verse number="41" style="v" sid="1CH 4:41"/>माथि नाम उल्‍लेख गरिएका यी मानिसहरू यहूदाका राजा हिजकियाहको समयमा आएका थिए। तिनीहरूले हामवंशीहरूलाई तिनीहरू बसेकै ठाउँमा आक्रमण गरे। अनि त्यहाँ भएका मोनीहरूलाई पनि आक्रमण गरेर तिनीहरूलाई पूर्ण रूपमा नष्‍ट गरे। आजसम्म त्यहाँ तिनीहरूको नामनिशानै छैन। तब तिनीहरू उनीहरूका ठाउँमा बसोबास गर्न थाले। किनकि त्यहाँ तिनीहरूका बगालको निम्ति खर्क थियो।<verse eid="1CH 4:41"/></para>
<para style="p"><verse number="42" style="v" sid="1CH 4:42"/>अनि यी पाँच सय शिमियोनीहरूले यिशीका छोराहरू पलत्याह, नेरियाह, रपायाह र उज्जीएलको नेतृत्वमा सेइरको पहाडी मुलुकमाथि आक्रमण गरे।<verse eid="1CH 4:42"/></para>
<para style="p"><verse number="43" style="v" sid="1CH 4:43"/>तिनीहरूले बाँकी रहेका अमालेकीहरूलाई पनि मारे। तिनीहरू आजको दिनसम्म नै त्यहाँ बसेका छन्।<verse eid="1CH 4:43"/></para>
<chapter eid="1CH 4"/>
<chapter number="5" style="c" sid="1CH 5"/>
<para style="p"><verse number="1" style="v" sid="1CH 5:1"/>इस्राएलका जेठा छोरा रूबेन थिए, (तिनी जेठो छोरा भए तापनि तिनले आफ्ना पिताकी उपपत्नीसँग शारीरिक सम्बन्ध राखेर आफ्ना पिताको वैवाहिक ओछ्यानलाई अशुद्ध पारिदिएका हुनाले तिनको जेष्‍ठ अधिकार इस्राएलका छोरा योसेफका छोराहरूलाई दिइयो। यसकारण तिनलाई वंशावलीको सूचीमा जेठो छोरा गनिएको छैन।<verse eid="1CH 5:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 5:2"/>यहूदा आफ्ना दाजुभाइहरूमध्ये सबैभन्दा बलियो र तिनीबाट नै शासक आएको भए तापनि ज्येष्‍ठ अधिकारचाहिँ योसेफको भयो)।<verse eid="1CH 5:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 5:3"/>इस्राएलका जेठा छोरा रूबेनका छोराहरू: हानोक, पल्‍लू, हेस्रोन र कर्मी।<verse eid="1CH 5:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 5:4"/>योएलका सन्तानहरू: योएलका छोरा शमायाह, शमायाहका छोरा गोग, गोगका छोरा शिमी,<verse eid="1CH 5:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 5:5"/>शिमीका छोरा मीका, मीकाका छोरा रायाह, रायाहका छोरा बाल,<verse eid="1CH 5:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 5:6"/>बालका छोरा बीराह, जसलाई अश्शूरका राजा तिग्लत-पिलेसेरले कैद गरेर लगेका थिए। बेराचाहिँ रूबेनीहरूका अगुवा थिए।<verse eid="1CH 5:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 5:7"/>तिनीहरूका वंशावलीमा वंशअनुसार सूचित गरिएका तिनीहरूका आफन्तहरू: यीएल, जो मुखिया थिए; जकरिया,<verse eid="1CH 5:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 5:8"/>अनि अजाजका छोरा बेला, जो शेमाका नाति र योएलका पनाति थिए। तिनीहरू अरोएरदेखि नेबो र बाल-मोनसम्म फैलिएको क्षेत्रमा बसोबास गरे।<verse eid="1CH 5:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 5:9"/>तिनीहरूले पूर्वपट्टि यूफ्रेटिस नदीसम्म फैलिएको उजाडस्थानको किनारको जमिनसम्म नै कब्जा गरे। किनकि गिलादमा तिनीहरूका गाईबस्तुको संख्या बढेको थियो।<verse eid="1CH 5:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 5:10"/>शाऊलको शासनकालमा रूबेनीहरूले हग्रीहरूको विरुद्धमा युद्ध गरे। तिनीहरूले हग्रीहरूलाई परास्त गरे। अनि तिनीहरूले गिलादको पूर्वपट्टि हग्रीहरूका सम्पूर्ण इलाकामा रहेका छाउनीहरूलाई कब्जा गरे।<verse eid="1CH 5:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 5:11"/>गादीहरू रूबेनीहरूका नजिक बाशानमा बसे। तिनीहरूको इलाका सलेकासम्मै फैलिएको थियो:<verse eid="1CH 5:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 5:12"/>बाशानमा योएल मुखिया थिए। तिनीपछि दोस्रोमा शापान, त्यसपछि यानै र शापात थिए।<verse eid="1CH 5:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 5:13"/>तिनीहरूका आफन्तहरू परिवारअनुसार यिनै थिए: मिखाएल, मशुल्‍लाम, शेबा, योरै, याकान, जीआ र एबेर—जम्मा सात जना।<verse eid="1CH 5:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 5:14"/>यिनीहरू अबीहेलका छोराहरू थिए। अबीहेल हूरीका छोरा थिए। हूरी यारोहका छोरा थिए, यारोह गिलादका छोरा थिए; गिलाद मिखाएलका छोरा थिए; मिखाएल यशीशैका छोरा थिए, यशीशै यहदोका छोरा थिए र यहदो बूजका छोरा थिए।<verse eid="1CH 5:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 5:15"/>गुनीका नाति, अब्दीएलका छोरा अही तिनीहरूका परिवारका प्रमुख अगुवा थिए।<verse eid="1CH 5:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 5:16"/>गिलादीहरू गिलादमा बाशान र यसका वरपरका गाउँहरूमा र शारोनका सबै खर्कहरू फैलिएका ठाउँसम्म बसोबास गरे।<verse eid="1CH 5:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 5:17"/>यी सबै मानिसहरूका नामहरू यहूदाका राजा योताम र इस्राएलका राजा यारोबामका शासनकालमा वंशावलीको सूचीमा लेखिएको थियो।<verse eid="1CH 5:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 5:18"/>रूबेनीहरू, गादीहरू र मनश्शेको आधा कुलसित युद्धका निम्ति तयार रहेका 44,760 तालिम प्राप्‍त मानिसहरू थिए, जो ढाल र तरवार चलाउन सक्ने, धनु चलाउन सक्ने, र युद्धका निम्ति निपुण योद्धाहरू थिए।<verse eid="1CH 5:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 5:19"/>तिनीहरूले हग्रीहरू, यतूर, नापीश र नोदाबको विरुद्धमा युद्ध गरे।<verse eid="1CH 5:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 5:20"/>तिनीहरूले परमेश्‍वरबाट युद्धमा सहायता पाए। अनि परमेश्‍वरले हग्रीहरू र तिनीहरूका सबै मित्रराष्ट्रहरूलाई तिनीहरूको हातमा सुम्पिदिनुभयो। किनकि युद्धको समयमा तिनीहरूले उहाँलाई पुकारेका थिए। उहाँले तिनीहरूको पुकार सुन्‍नुभयो; किनकि तिनीहरूले उहाँमाथि भरोसा राखेका थिए।<verse eid="1CH 5:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 5:21"/>तिनीहरूले हग्रीहरूका गाईबस्तु, अर्थात् पचास हजार ऊँट, दुई लाख पचास हजार भेडा र दुई हजार गधा कब्जा गरे। तिनीहरूले एक लाख मानिसहरूलाई पनि कैद गरेर लगे।<verse eid="1CH 5:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 5:22"/>अनि अरू धेरैचाहिँ मारिए; किनकि त्यो लडाइँ परमेश्‍वरले नै हुन दिनुभएको थियो। निर्वासनमा नलगिएसम्म तिनीहरू त्यस देशमै बसोबास गरे।<verse eid="1CH 5:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 5:23"/>मनश्शेको आधा कुलका मानिसहरू अनगन्ती थिए। तिनीहरू त्यस देशमा बाशानदेखि बाल-हर्मोनसम्म, अर्थात् सेनीर (हेर्मोन पर्वत) सम्म बसोबास गरे।<verse eid="1CH 5:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 5:24"/>तिनीहरूका परिवारका अगुवाहरू यिनै थिए: एपेर, यिशी, एलीएल, अज्रीएल, यर्मिया, होदवियाह र यहदीएल। तिनीहरू साहसी लडाकु, प्रसिद्ध मानिसहरू, र तिनीहरूका परिवारका मुख्य अगुवाहरू थिए।<verse eid="1CH 5:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 5:25"/>तर तिनीहरू आफ्ना पितापुर्खाहरूका परमेश्‍वरप्रति विश्‍वासयोग्य भएनन्। अनि परमेश्‍वरले तिनीहरूकै सामु नष्‍ट पार्नुभएका देशका मानिसहरूका देवताहरूको पछि लागेर तिनीहरूले वेश्यावृत्ति गरे।<verse eid="1CH 5:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 5:26"/>यसकारण इस्राएलका परमेश्‍वरले अश्शूरका राजा पूललाई (अर्थात् अश्शूरका राजा तिग्लत-पिलेसेरलाई) उस्काउनुभयो, जसले रूबेनीहरू, गादीहरू र मनश्शेको आधा कुललाई निर्वासनमा लगे। राजाले तिनीहरूलाई हलह, हाबोर, हारा र गोजान नदीमा लगे, जहाँ तिनीहरू आजको दिनसम्म नै छँदैछन्।<verse eid="1CH 5:26"/></para>
<chapter eid="1CH 5"/>
<chapter number="6" style="c" sid="1CH 6"/>
<para style="p"><verse number="1" style="v" sid="1CH 6:1"/>लेवीका छोराहरू: गेर्शोन, कहात र मरारी थिए।<verse eid="1CH 6:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 6:2"/>कहातका छोराहरू: अम्राम, यिसहार हेब्रोन र उज्जीएल थिए।<verse eid="1CH 6:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 6:3"/>अम्रामका छोराछोरीहरू: हारून, मोशा र मिरियम थिए। हारूनका छोराहरू: नादाब, अबीहू, एलाजार र ईतामार थिए।<verse eid="1CH 6:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 6:4"/>एलाजार पीनहासका पिता, पीनहास अबीशूका पिता,<verse eid="1CH 6:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 6:5"/>अबीशू बुक्‍कीका पिता, बुक्‍की उज्जीका पिता,<verse eid="1CH 6:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 6:6"/>उज्जी जरयाहका पिता, जरयाह मरायोतका पिता,<verse eid="1CH 6:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 6:7"/>मरायोत अमर्याहका पिता, अमर्याह अहीतूबका पिता,<verse eid="1CH 6:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 6:8"/>अहीतूब सादोकका पिता, सादोक अहीमासका पिता,<verse eid="1CH 6:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 6:9"/>अहीमास अजर्याहका पिता, अजर्याह योहानानको पिता,<verse eid="1CH 6:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 6:10"/>योहानान अजर्याहका पिता थिए, त्यही अजर्याह, जसले यरूशलेममा सोलोमनले बनाएको मन्दिरमा पुजारीको काम गरेका थिए।<verse eid="1CH 6:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 6:11"/>अजर्याह अमर्याहका पिता, अमर्याह अहीतूबका पिता,<verse eid="1CH 6:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 6:12"/>अहीतूब सादोकका पिता, सादोक शल्‍लूमका पिता,<verse eid="1CH 6:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 6:13"/>शल्‍लूम हिल्कियाहका पिता, हिल्कियाह अजर्याहका पिता,<verse eid="1CH 6:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 6:14"/>अजर्याह सरायाहका पिता, अनि सरायाह यहोसादाकका पिता थिए।<verse eid="1CH 6:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 6:15"/>याहवेहले नबूकदनेसरको हातद्वारा यहूदा र यरूशलेमलाई निर्वासनमा लैजानुहुँदा यहोसादाकलाई पनि निर्वासनमा लगियो।<verse eid="1CH 6:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 6:16"/>लेवीका छोराहरू: गेर्शोन, कहात र मरारी थिए।<verse eid="1CH 6:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 6:17"/>गेर्शोनका छोराहरूका नाम यिनै हुन्: लिब्नी र शिमी थिए।<verse eid="1CH 6:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 6:18"/>कहातका छोराहरू: अम्राम, यिसहार, हेब्रोन र उज्जीएल थिए।<verse eid="1CH 6:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 6:19"/>मरारीका छोराहरू: महली र मूशी थिए। तिनीहरूका पिताको नामअनुसार सूचित गरिएका लेवीहरूका वंशहरू यिनै हुन्:<verse eid="1CH 6:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 6:20"/>गेर्शोन सन्तानहरू: गेर्शोनका छोरा लिब्नी, लिब्नीका छोरा यहत, यहतका छोरा जिम्माह,<verse eid="1CH 6:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 6:21"/>जिम्माहका छोरा योआ, योआका छोरा इद्दो, इद्दोका छोरा जेरह, र जेरहका छोरा यातरै थिए।<verse eid="1CH 6:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 6:22"/>कहातका सन्तानहरू: कहातका छोरा अम्मीनादाब, अम्मीनादाबका छोरा कोरह, कोरहका छोरा अस्सीर<verse eid="1CH 6:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 6:23"/>अस्सीरका छोरा एल्काना, एल्कनाका छोरा एब्यासाप, एब्यासापका छोरा अस्सीर,<verse eid="1CH 6:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 6:24"/>अस्सीरका छोरा तहत, तहतका छोरा ऊरीएल, उरीएलका छोरा उज्जियाह, र उज्जियाहका छोरा शौल थिए।<verse eid="1CH 6:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 6:25"/>एल्कानाका छोराहरू: अमासै र अहीमोत थिए।<verse eid="1CH 6:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 6:26"/>अहिमोतका छोरा एल्काना, एल्कनाका छोरा सोफै, सोपेका छोरा नहत,<verse eid="1CH 6:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 6:27"/>नहतका छोरा एलिआब, एलिआबका छोरा यरोहाम, यहोरामका छोरा एल्काना, अनि एल्कानाका छोरा शमूएल थिए।<verse eid="1CH 6:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 6:28"/>शमूएलका छोराहरू: पहिलो योएल र दोस्रो छोरा अबीयाह थिए।<verse eid="1CH 6:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 6:29"/>मरारीका सन्तानहरू: महली छोरा लिब्नी, लिब्नीका छोरा शिमी, शिमीका छोरा उज्जाह,<verse eid="1CH 6:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 6:30"/>उज्‍जाका छोरा शिमीअ, शिमेअका छोरा हग्गियाह र हग्गियाहका छोरा असायाह थिए।<verse eid="1CH 6:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 6:31"/>परमेश्‍वरको सन्दुक याहवेहको भवनमा राखेपछि दावीदले याहवेहको भवनमा सङ्गीतको निम्ति जिम्मा दिएका मानिसहरू यिनै हुन्।<verse eid="1CH 6:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 6:32"/>सोलोमनले यरूशलेममा याहवेहको मन्दिर नबनाएसम्म ती मानिसहरूले समागम पाल र भेट हुने पालको अगाडि सङ्गीतद्वारा सेवाको काम गरे। तिनीहरूका निम्ति बनाइएका नियमअनुसार तिनीहरूले जिम्मेवारी पूरा गरे।<verse eid="1CH 6:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 6:33"/>तिनीहरूका छोराहरूसँग सेवा गर्ने मानिसहरू यिनै हुन्: कहातीहरूबाट: सङ्गीतकार हेमान, जो योएलका छोरा थिए, जो शमूएलका छोरा,<verse eid="1CH 6:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 6:34"/>जो एल्कानाका छोरा, जो यरोहामका छोरा, जो एलीएलका छोरा, जो तोआहका छोरा,<verse eid="1CH 6:34"/></para>
<para style="p"><verse number="35" style="v" sid="1CH 6:35"/>जो सूपका छोरा, जो एल्कानाका छोरा, जो महतका छोरा, जो अमासैका छोरा,<verse eid="1CH 6:35"/></para>
<para style="p"><verse number="36" style="v" sid="1CH 6:36"/>जो एल्कानाका छोरा, जो योएलका छोरा, जो अजर्याहका छोरा, जो सपन्याहका छोरा,<verse eid="1CH 6:36"/></para>
<para style="p"><verse number="37" style="v" sid="1CH 6:37"/>जो तहतका छोरा, जो अस्सीरका छोरा, जो एब्यासापका छोरा, जो कोरहका छोरा,<verse eid="1CH 6:37"/></para>
<para style="p"><verse number="38" style="v" sid="1CH 6:38"/>जो यिसहारका छोरा, जो कहातका छोरा, जो लेवीका छोरा, जो इस्राएलका छोरा थिए।<verse eid="1CH 6:38"/></para>
<para style="p"><verse number="39" style="v" sid="1CH 6:39"/>अनि हेमानका सहकर्मी आसाप, जसले तिनको दाहिने हाततर्फ सेवा गर्थे: आसाप बेरेक्याहका छोरा, बेरेक्याह शिमेअका छोरा,<verse eid="1CH 6:39"/></para>
<para style="p"><verse number="40" style="v" sid="1CH 6:40"/>जो मिखाएलका छोरा, जो बासेयाहका छोरा, जो मल्कियाहका छोरा,<verse eid="1CH 6:40"/></para>
<para style="p"><verse number="41" style="v" sid="1CH 6:41"/>जो एत्नीका छोरा, जो जेरहका छोरा, जो अदायाहका छोरा,<verse eid="1CH 6:41"/></para>
<para style="p"><verse number="42" style="v" sid="1CH 6:42"/>जो एतानका छोरा, जो जिम्माहका छोरा, जो शिमीका छोरा,<verse eid="1CH 6:42"/></para>
<para style="p"><verse number="43" style="v" sid="1CH 6:43"/>जो यहतका छोरा, जो गेर्शोनका छोरा, जो लेवीका छोरा थिए।<verse eid="1CH 6:43"/></para>
<para style="p"><verse number="44" style="v" sid="1CH 6:44"/>अनि तिनका बायाँ हाततर्फ तिनीहरूका सहकर्मी मरारीहरू: एतान कीशीका छोरा, जो अब्दीका छोरा, जो मल्‍लूकका छोरा,<verse eid="1CH 6:44"/></para>
<para style="p"><verse number="45" style="v" sid="1CH 6:45"/>जो हशब्याहका छोरा, जो अमस्याहका छोरा, जो हिल्कियाहका छोरा,<verse eid="1CH 6:45"/></para>
<para style="p"><verse number="46" style="v" sid="1CH 6:46"/>जो अम्सीका छोरा, जो बानीका छोरा, जो शेमेरका छोरा,<verse eid="1CH 6:46"/></para>
<para style="p"><verse number="47" style="v" sid="1CH 6:47"/>जो महलीका छोरा, जो मूशीका छोरा, जो मरारीका छोरा, जो लेवीका छोरा थिए।<verse eid="1CH 6:47"/></para>
<para style="p"><verse number="48" style="v" sid="1CH 6:48"/>तिनीहरूका लेवी दाजुभाइहरूलाई परमेश्‍वरको भवन, समागम पालका अरू सबै कामहरूको जिम्मा दिएको थियो।<verse eid="1CH 6:48"/></para>
<para style="p"><verse number="49" style="v" sid="1CH 6:49"/>तर हारून र तिनका सन्तानहरूलेचाहिँ परमेश्‍वरको सेवक मोशाले दिएका सबै आज्ञाहरू बमोजिम इस्राएलको निम्ति प्रायश्‍चित गर्दै, महा-पवित्रस्थानमा गर्नुपर्ने सबै कामअनुसार होमबलिको वेदी र धूपको वेदीमा बलिदानहरू चढाउँथे।<verse eid="1CH 6:49"/></para>
<para style="p"><verse number="50" style="v" sid="1CH 6:50"/>हारूनका सन्तानहरू यिनै थिए: हारूनका छोरा एलाजार, तिनका छोरा पीनहास, तिनका छोरा अबीशू,<verse eid="1CH 6:50"/></para>
<para style="p"><verse number="51" style="v" sid="1CH 6:51"/>तिनका छोरा बुक्‍की, तिनका छोरा उज्जी, तिनका छोरा जरयाह,<verse eid="1CH 6:51"/></para>
<para style="p"><verse number="52" style="v" sid="1CH 6:52"/>तिनका छोरा मरायोत, तिनका छोरा अमर्याह, तिनका छोरा अहीतूब,<verse eid="1CH 6:52"/></para>
<para style="p"><verse number="53" style="v" sid="1CH 6:53"/>तिनका छोरा सादोक, तिनका छोरा अहीमास थिए।<verse eid="1CH 6:53"/></para>
<para style="p"><verse number="54" style="v" sid="1CH 6:54"/>तिनीहरूका निम्ति छुट्ट्याइएका तिनीहरूका बस्‍ने ठाउँहरू यिनै थिए। (ती वासस्थानहरू कहाती वंशहरूबाट आएका हारूनका सन्तानहरूलाई दिइयो; किनकि पहिलो चिट्ठा तिनीहरूका निम्ति परेको थियो)।<verse eid="1CH 6:54"/></para>
<para style="p"><verse number="55" style="v" sid="1CH 6:55"/>यहूदामा तिनीहरूलाई हेब्रोनका चारैतिरका खर्कहरूसमेत दिइयो।<verse eid="1CH 6:55"/></para>
<para style="p"><verse number="56" style="v" sid="1CH 6:56"/>(तर सहरका चारैतिरका खेतहरू र गाउँहरूचाहिँ यपून्‍नेको छोरा कालेबलाई दिइयो)।<verse eid="1CH 6:56"/></para>
<para style="p"><verse number="57" style="v" sid="1CH 6:57"/>यसरी हारूनका सन्तानहरूलाई हेब्रोन (शरण-नगर), लिब्ना, यत्तीर, एश्तमो,<verse eid="1CH 6:57"/></para>
<para style="p"><verse number="58" style="v" sid="1CH 6:58"/>हीलेन, दबीर,<verse eid="1CH 6:58"/></para>
<para style="p"><verse number="59" style="v" sid="1CH 6:59"/>आशान, युत्ता र बेथ-शेमेशलाई तिनीहरूका खर्कहरूसमेत दिइयो।<verse eid="1CH 6:59"/></para>
<para style="p"><verse number="60" style="v" sid="1CH 6:60"/>अनि तिनीहरूलाई बेन्यामीनको कुलबाट गेबा, आलेमेत र अनातोत, अनि तिनीहरूका खर्कहरूसमेत दिइयो। कहातीका वंशहरूलाई बाँडिएका यी नगरहरू तेह्र वटा थिए।<verse eid="1CH 6:60"/></para>
<para style="p"><verse number="61" style="v" sid="1CH 6:61"/>कहातका बाँकी रहेका सन्तानहरूलाई चाहिँ मनश्शेको आधा कुलबाट दश वटा नगरहरू भाग लगाइदिए।<verse eid="1CH 6:61"/></para>
<para style="p"><verse number="62" style="v" sid="1CH 6:62"/>गेर्शोनका सन्तानहरूलाई वंश-वंश गरी इस्साखार, आशेर, नप्‍ताली र बाशानमा बस्‍ने मनश्शे कुलको भागबाट तेह्र वटा नगरहरूलाई भाग लगाइदिए।<verse eid="1CH 6:62"/></para>
<para style="p"><verse number="63" style="v" sid="1CH 6:63"/>मरारीका सन्तानहरूलाई वंश-वंश गरी रूबेन, गाद र जबूलूनका कुलहरूबाट बाह्र वटा नगरहरू भाग लगाइदिए।<verse eid="1CH 6:63"/></para>
<para style="p"><verse number="64" style="v" sid="1CH 6:64"/>यसरी इस्राएलीहरूले लेवीहरूलाई यी नगरहरू र तिनीहरूका खर्कहरू दिए।<verse eid="1CH 6:64"/></para>
<para style="p"><verse number="65" style="v" sid="1CH 6:65"/>यहूदा, शिमियोन र बेन्यामीन कुलहरूबाट तिनीहरूलाई माथि उल्‍लेखित गरिएका नगरहरू भाग लगाइदिए।<verse eid="1CH 6:65"/></para>
<para style="p"><verse number="66" style="v" sid="1CH 6:66"/>कहातका केही वंशहरूलाई तिनीहरूका इलाकाको रूपमा एफ्राइम कुलका नगरहरूबाट दिइयो।<verse eid="1CH 6:66"/></para>
<para style="p"><verse number="67" style="v" sid="1CH 6:67"/>एफ्राइमको पहाडी मुलुकमा शेकेम (शरण-नगर), गेजेर,<verse eid="1CH 6:67"/></para>
<para style="p"><verse number="68" style="v" sid="1CH 6:68"/>योकमाम, बेथ-होरोन,<verse eid="1CH 6:68"/></para>
<para style="p"><verse number="69" style="v" sid="1CH 6:69"/>अय्यालोन र गात-रिम्मोनको साथै तिनीहरूका खर्कहरूसमेत दिइयो।<verse eid="1CH 6:69"/></para>
<para style="p"><verse number="70" style="v" sid="1CH 6:70"/>अनि इस्राएलीहरूले मनश्शेको आधा कुलबाट कहातका बाँकी वंशहरूलाई आनेर र बिलाम, तिनका खर्कहरूसमेत दिए।<verse eid="1CH 6:70"/></para>
<para style="p"><verse number="71" style="v" sid="1CH 6:71"/>गेर्शोनीहरूले पाएका ठाउँहरू: मनश्शेको आधा कुलबाट तिनीहरूले बाशानमा गोलान र अस्तारोत, र तिनीहरूका खर्कहरूसमेत पाए।<verse eid="1CH 6:71"/></para>
<para style="p"><verse number="72" style="v" sid="1CH 6:72"/>इस्साखारको कुलबाट तिनीहरूले पाएका नगरहरू: केदेश, दाबरत,<verse eid="1CH 6:72"/></para>
<para style="p"><verse number="73" style="v" sid="1CH 6:73"/>रामोत र अनेम अनि तिनीहरूका खर्कहरूसमेत पाए;<verse eid="1CH 6:73"/></para>
<para style="p"><verse number="74" style="v" sid="1CH 6:74"/>आशेरको कुलबाट तिनीहरूले पाएका ठाउँहरू: माशाल, अब्दोन,<verse eid="1CH 6:74"/></para>
<para style="p"><verse number="75" style="v" sid="1CH 6:75"/>हूक्‍कोक, रहोब र तिनीहरूका खर्कहरूसमेत पाए।<verse eid="1CH 6:75"/></para>
<para style="p"><verse number="76" style="v" sid="1CH 6:76"/>अनि नप्‍तालीको कुलबाट तिनीहरूले गालीलमा केदेश, हम्मोन, किर्यातैम, अनि तिनीहरूका खर्कहरूसमेत पाए।<verse eid="1CH 6:76"/></para>
<para style="p"><verse number="77" style="v" sid="1CH 6:77"/>मरारीहरूले (लेवीहरूका बाँकी रहेकाहरूले) पाएका ठाउँहरू यिनै हुन्: जबूलूनको कुलबाट तिनीहरूले योकन्याम, कर्ताह, रिम्मोनो र तबोर, र तिनीहरूका खर्कहरूसमेत पाए;<verse eid="1CH 6:77"/></para>
<para style="p"><verse number="78" style="v" sid="1CH 6:78"/>रूबेनको कुलबाट यरीहोको पूर्वमा यर्दनपारि उजाडस्थानमा बेसेर, यहसाह,<verse eid="1CH 6:78"/></para>
<para style="p"><verse number="79" style="v" sid="1CH 6:79"/>कदेमोत, मेपात र तिनीहरूका खर्कहरूसमेत पाए;<verse eid="1CH 6:79"/></para>
<para style="p"><verse number="80" style="v" sid="1CH 6:80"/>अनि गादको कुलबाट तिनीहरूले गिलादको रामोत, महनाइम,<verse eid="1CH 6:80"/></para>
<para style="p"><verse number="81" style="v" sid="1CH 6:81"/>हेश्बोन, याजेर र तिनीहरूका खर्कहरूसमेत पाए।<verse eid="1CH 6:81"/></para>
<chapter eid="1CH 6"/>
<chapter number="7" style="c" sid="1CH 7"/>
<para style="p"><verse number="1" style="v" sid="1CH 7:1"/>इस्साखारका छोराहरू: तोला, पुवा, याशूब र शिम्रोन—जम्मा चार जना थिए।<verse eid="1CH 7:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 7:2"/>तोलाका छोराहरू: उज्जी, रपायाह, यरीएल, यहमै, यिब्साम र शमूएल, अर्थात् तिनीहरूका परिवारका अगुवाहरू थिए। दावीदको शासनकालमा तिनीहरूको वंशावलीमा लडाकु मानिसहरू भनी सूचित गरिएका तोलाका सन्तानहरूको संख्या 22,600 थियो।<verse eid="1CH 7:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 7:3"/>उज्जीका छोरा: यिज्रयाह थिए। यिज्रयाहका छोराहरू: मिखाएल, ओबदियाह, योएल र यिश्याह थिए। ती पाँचै जना अगुवाहरू थिए।<verse eid="1CH 7:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 7:4"/>तिनीहरूका परिवारको वंशावलीअनुसार तिनीहरूसँग युद्धका निम्ति तयार रहेका 36,000 लडाकु मानिसहरू थिए। किनकि तिनीहरूका धेरै पत्नीहरू र छोराछोरीहरू थिए।<verse eid="1CH 7:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 7:5"/>अनि तिनीहरूका आफन्तहरूमा भएका लडाकु मानिसहरू, जो इस्साखारका वंशहरूबाट थिए। तिनीहरूका वंशावलीमा सूचित गरिएका सबै मानिसहरू 87,000 थिए।<verse eid="1CH 7:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 7:6"/>बेन्यामीनका तीन छोराहरू: बेला, बेकेर र यदीएल थिए।<verse eid="1CH 7:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 7:7"/>बेलाका छोराहरू: एसबोन, उज्जी, उज्जीएल, यरीमोत र इरी, अर्थात् परिवारका अगुवाहरू जम्मा पाँच जना थिए। तिनीहरूका वंशावली विवरणमा 22,034 जना लडाकु मानिसहरूको संख्या थियो।<verse eid="1CH 7:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 7:8"/>बेकेरका छोराहरू: जमीरा, योआश, एलीएजर, एल्योएनै, ओम्री, यरेमोत, अबीयाह, अनातोत र आलेमेत थिए। यी सबै जना बेकेरका छोराहरू थिए।<verse eid="1CH 7:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 7:9"/>तिनीहरूका परिवारका वंशावलीको विवरणमा अगुवाहरू र लडाकु मानिसहरू 20,200 सूचित थिए।<verse eid="1CH 7:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 7:10"/>यदीएलका छोरा: बिल्हान थिए। बिल्हानका छोराहरू: येऊश, बेन्यामीन, एहूद, कनानाह, जेतान, तर्शीश र अहीशहर थिए।<verse eid="1CH 7:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 7:11"/>यदीएलका यी सबै छोराहरू परिवारहरूका अगुवाहरू थिए। लडाइँमा जान तयार रहेका 17,200 जना लडाकु मानिसहरू त्यहाँ थिए।<verse eid="1CH 7:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 7:12"/>इरका छोराहरू शुप्पी र हुप्पी थिए, र हुशीमहरू अहेरका छोराहरू थिए।<verse eid="1CH 7:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 7:13"/>नप्‍तालीका छोराहरू: यहसेल, गुनी, येसेर र शिल्‍लेम, अर्थात् यिनीहरू बिल्हाका छोराहरू थिए।<verse eid="1CH 7:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 7:14"/>मनश्शेका सन्तानहरू: अस्रीएलचाहिँ मनश्शेका अरामी उपपत्नीबाट जन्मिएका सन्तान थिए। तिनले गिलादका पिता माकीरलाई पनि जन्माइन्।<verse eid="1CH 7:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 7:15"/>माकीरले हुप्पी र शुप्पीहरूमध्येबाट तिनीहरूकी बहिनी माकालाई पत्नी तुल्याए। मनश्शेको अर्को सन्तानको नाम सलोफाद थियो; र सलोफादका छोरीहरू मात्र थिए।<verse eid="1CH 7:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 7:16"/>माकीरकी पत्नी माकाले एउटा छोरा जन्माइन्, जसको नाम तिनले पेरेस राखिन्। अनि उसको भाइको नाम शेरेस थियो। अनि पेरेसका छोराहरूचाहिँ ऊलाम र राकेम थिए।<verse eid="1CH 7:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 7:17"/>ऊलामका छोरा: बदान थिए। मनश्शेको छोरा माकीर, माकीरका छोरा गिलादका छोराहरू यिनीहरू नै थिए।<verse eid="1CH 7:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 7:18"/>गिलादकी बहिनी हम्मोलेकेतले ईशोद, अबीएजेर र महलालाई जन्माएकी थिइन्।<verse eid="1CH 7:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 7:19"/>शमीदाका छोराहरू: अहियन, शेकेम, लिखी र अनीआम थिए।<verse eid="1CH 7:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 7:20"/>एफ्राइमका सन्तानहरू: एफ्राइमका छोरा शूतेलह, शूतेलहका छोरा बेरेद, बेरेदका छोरा तहत, तहतका छोरा एलादा, एलादाका छोरा तहत,<verse eid="1CH 7:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 7:21"/>तहतका छोरा जाबाद र जाबादका छोरा शूतेलह थिए। (एसेर र एलादचाहिँ गातका मानिसहरूका बस्तुभाउ लुट्न जाँदा, त्यहाँका स्थानीय बासिन्दाहरूद्वारा मारिएका थिए।<verse eid="1CH 7:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 7:22"/>तिनीहरूका पिता एफ्राइमले तिनीहरूका निम्ति धेरै दिनसम्म शोक गरे। अनि तिनका आफन्तहरू तिनलाई सान्त्वना दिन आए।<verse eid="1CH 7:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 7:23"/>त्यसपछि एफ्राइमले आफ्नी पत्नीसँग फेरि सहवास गरे। तब तिनी गर्भवती भइन्, र एउटा छोरा जन्माइन्; जसको नाम तिनले बेरियाह राखे; किनकि तिनको परिवारमा विपत्ति आएको थियो।<verse eid="1CH 7:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 7:24"/>एफ्राइमकी छोरी शेराह थिइन्, जसले माथिल्‍लो र तल्‍लो बेथ-होरोन र उज्जेन-शेराह नगरहरू निर्माण गरेकी थिइन्।)<verse eid="1CH 7:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 7:25"/>एफ्राइमका छोरा रपाह थिए, जसका छोरा रेशेप, जसका छोरा तेलह, जसका छोरा तहन,<verse eid="1CH 7:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 7:26"/>जसका छोरा लादान, जसका छोरा अम्मीहूद, जसका छोरा एलिशामा,<verse eid="1CH 7:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 7:27"/>जसका छोरा नुन, अनि नूनका छोरा यहोशू थिए।<verse eid="1CH 7:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 7:28"/>तिनीहरूको जमिन र बसोबास गरेका ठाउँहरूमा दक्षिणतिर बेथेल र त्यसका चारैतिरका बस्तीहरू, पूर्वतिर नारान, पश्‍चिमतिर गेजेर र त्यसका बस्तीहरू, उत्तरतिर अय्याह र त्यसका बस्तीहरूसमेत शेकेमसम्म नै र त्यसका बस्तीहरू सामेल थिए।<verse eid="1CH 7:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 7:29"/>मनश्शेका सिमानाहरू बेथ-शान, तानाक, मगिद्दो, डोर र तिनीहरूका बस्तीहरूसमेत थिए। इस्राएलका छोरा योसेफका सन्तानहरू यिनै नगरहरूमा बस्थे।<verse eid="1CH 7:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 7:30"/>आशेरका छोराहरू: यिम्ना, यिश्‍वा, यिश्‍वी र बेरियाह थिए। तिनीहरूकी बहिनी सेरह थिइन्।<verse eid="1CH 7:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 7:31"/>बेरियाहका छोराहरू: हेबेर र मल्कीएल, जो बिर्जेतका पिता थिए।<verse eid="1CH 7:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 7:32"/>हेबेरचाहिँ येप्लेत, शोमेर, होताम र तिनीहरूकी बहिनी शूआका पिता थिए।<verse eid="1CH 7:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 7:33"/>येप्लेतका छोराहरू: पासक, बिम्हाल र अश्‍वात थिए। यिनीहरू येप्लेतका छोराहरू थिए।<verse eid="1CH 7:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 7:34"/>शोमेरका छोराहरू: अही, रोहगा, हूब्बा र अराम थिए।<verse eid="1CH 7:34"/></para>
<para style="p"><verse number="35" style="v" sid="1CH 7:35"/>शोमेरका भाइ हेलेमका छोराहरू: सोपह, यिम्ना, शेलेश र आमाल थिए।<verse eid="1CH 7:35"/></para>
<para style="p"><verse number="36" style="v" sid="1CH 7:36"/>सोपहका छोराहरू: सूह, हर्नेपेर, शूआल, बेरी, यिम्राह,<verse eid="1CH 7:36"/></para>
<para style="p"><verse number="37" style="v" sid="1CH 7:37"/>बेसेर, होद, शम्मा, शिल्शा, यित्रान र बेरा थिए।<verse eid="1CH 7:37"/></para>
<para style="p"><verse number="38" style="v" sid="1CH 7:38"/>येतेरका छोराहरू: यपून्‍ने, पिस्पा र अरा थिए।<verse eid="1CH 7:38"/></para>
<para style="p"><verse number="39" style="v" sid="1CH 7:39"/>उल्‍लाका छोराहरू: अराह, हन्‍नीएल र रिसिया थिए।<verse eid="1CH 7:39"/></para>
<para style="p"><verse number="40" style="v" sid="1CH 7:40"/>आशेरका यी सबै सन्तानहरू—परिवारहरूका मुखियाहरू, चुनिएका मानिसहरू, वीर योद्धाहरू र विशिष्‍ट अगुवाहरू थिए। लडाइँमा जान सक्ने मानिसहरूको संख्या तिनीहरूको वंशावलीको सूचीअनुसार, 26,000 थिए।<verse eid="1CH 7:40"/></para>
<chapter eid="1CH 7"/>
<chapter number="8" style="c" sid="1CH 8"/>
<para style="p"><verse number="1" style="v" sid="1CH 8:1"/>बेन्यामीनका छोराहरू: पहिलो छोरा बेला; दोस्रो छोरा अश्बेल, तेस्रो अहरह,<verse eid="1CH 8:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 8:2"/>चौथो नोआ र पाँचौँ रफा।<verse eid="1CH 8:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 8:3"/>बेलाका छोराहरू यिनै हुन्: अद्दार, गेरा, अबिहूद,<verse eid="1CH 8:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 8:4"/>अबीशू, नामान, अहोह,<verse eid="1CH 8:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 8:5"/>गेरा, शपूपान र हूराम।<verse eid="1CH 8:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 8:6"/>एहूदका सन्तानहरू यिनै थिए, जो गेबामा बस्‍ने परिवारका अगुवाहरू थिए; र यिनीहरू मानहतमा कैदमा लगिएका थिए:<verse eid="1CH 8:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 8:7"/>एहूदका नामान, अहीयाह र गेरा नामका छोराहरू थिए। गेराले नै गेबाहरूलाई निर्वासनमा लगे, जो उज्जाह र अहीहूदका पिता थिए।<verse eid="1CH 8:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 8:8"/>सहरेमले आफ्ना पत्नीहरू हूशीम र बारासँग सम्बन्ध-विच्छेद गरिसकेपछि मोआबमा तिनका अरू छोराहरू जन्मेका थिए।<verse eid="1CH 8:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 8:9"/>तिनकी पत्नी होदेशबाट योबाब, सिब्या, मेशा, मल्काम,<verse eid="1CH 8:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 8:10"/>यूस, साकिया र मिर्मा नाम भएका छोराहरू भए। ती छोराहरू, परिवारहरूका मुखियाहरू भए।<verse eid="1CH 8:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 8:11"/>तिनकी पत्नी हूशीमबाट अबीतूब र एल्पाल छोराहरू भएका थिए।<verse eid="1CH 8:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 8:12"/>एल्पालका छोराहरू: एबेर, मिशाम, शेमेद, (जसले ओनो, लोद र यसका चारैतिरका बस्तीहरू निर्माण गरे)।<verse eid="1CH 8:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 8:13"/>अनि बेरियाह र शेमा, अय्यालोनमा बस्‍नेहरूका अगुवा थिए; तिनीहरूले गातका बासिन्दाहरूलाई धपाएका थिए।<verse eid="1CH 8:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 8:14"/>अहियो, शाशक, यरेमोत,<verse eid="1CH 8:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 8:15"/>जबदियाह, अराद, एदेर,<verse eid="1CH 8:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 8:16"/>मिखाएल, यिश्पा र योहा बेरियाहका छोराहरू थिए।<verse eid="1CH 8:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 8:17"/>जबदियाह, मशुल्‍लाम, हिज्की, हेबेर,<verse eid="1CH 8:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 8:18"/>यिश्मरै, यिज्लीअ र योबाब एल्पालका छोराहरू थिए।<verse eid="1CH 8:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 8:19"/>याकीम, जिक्री, जब्दी,<verse eid="1CH 8:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 8:20"/>एलीएनै, सिल्‍लतै, एलीएल,<verse eid="1CH 8:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 8:21"/>अदायाह, बरायाह र शिम्रात शिमीका छोराहरू थिए।<verse eid="1CH 8:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 8:22"/>यिश्पान, एबेर, एलीएल,<verse eid="1CH 8:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 8:23"/>अब्दोन, जिक्री, हानान,<verse eid="1CH 8:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 8:24"/>हनन्याह, एलाम, अन्तोतियाह,<verse eid="1CH 8:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 8:25"/>यिपदियाह र पनीएल शाशकका छोराहरू थिए।<verse eid="1CH 8:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 8:26"/>शम्शरै, शहर्याह, अतल्याह,<verse eid="1CH 8:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 8:27"/>यारेश्याह, एलिया र जिक्री यरोहामका छोराहरू थिए।<verse eid="1CH 8:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 8:28"/>यी सबै मानिसहरू वंशावलीको सूचीमा दर्ता गरिएअनुसार पुर्ख्यौली वंशका अगुवाहरू थिए। यिनीहरू यरूशलेममा बस्दथे।<verse eid="1CH 8:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 8:29"/>गिबोनका पिता यीएल गिबोनमा बस्थे। तिनकी पत्नीको नाम माका थियो।<verse eid="1CH 8:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 8:30"/>तिनका जेठा छोरा अब्दोन थिए, अब्दोनपछि सूर, कीश, बाल, नेर, नादाब,<verse eid="1CH 8:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 8:31"/>गदोर, अहियो, जेकेर<verse eid="1CH 8:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 8:32"/>अनि मिक्लोत थिए, जोचाहिँ शिमाहका पिता थिए। तिनीहरू पनि यरूशलेममा आफ्ना आफन्तहरूको नजिक बस्थे।<verse eid="1CH 8:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 8:33"/>नेर कीशका पिता थिए; कीश शाऊलका पिता, र शाऊलचाहिँ जोनाथन, मल्की-शूअ, अबीनादाब र एश-बालका पिता थिए।<verse eid="1CH 8:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 8:34"/>जोनाथनका छोरा: मरीब-बाल, जो मीकाका पिता थिए।<verse eid="1CH 8:34"/></para>
<para style="p"><verse number="35" style="v" sid="1CH 8:35"/>मीकाका छोराहरू: पीतोन, मेलेक, तारे र आहाज।<verse eid="1CH 8:35"/></para>
<para style="p"><verse number="36" style="v" sid="1CH 8:36"/>आहाज यहोयादाका पिता थिए; यहोयादा आलेमेत, अज्मावेत र जिम्रीका पिता थिए; र जिम्री मोसका पिता थिए।<verse eid="1CH 8:36"/></para>
<para style="p"><verse number="37" style="v" sid="1CH 8:37"/>मोस बिनेका पिता थिए; बिनेका छोरा रफाह थिए, रफाका छोरा एलासा र एलासाका छोरा आसेल थिए।<verse eid="1CH 8:37"/></para>
<para style="p"><verse number="38" style="v" sid="1CH 8:38"/>आसेलका छ जना छोराहरू थिए, र तिनीहरूका नाम यिनै थिए: अज्रीकाम, बोकेरू, इश्माएल, शार्याह, ओबदिया र हानान। यी सबै आसेलका छोराहरू थिए।<verse eid="1CH 8:38"/></para>
<para style="p"><verse number="39" style="v" sid="1CH 8:39"/>आसेलका भाइ एशेकका छोराहरू: पहिलो ऊलाम, दोस्रो येऊश र तेस्रो एलीपेलेत।<verse eid="1CH 8:39"/></para>
<para style="p"><verse number="40" style="v" sid="1CH 8:40"/>ऊलामका छोराहरू धनु चलाउन सक्ने वीर धनुर्धारी योद्धाहरू थिए। तिनीहरूका धेरै छोरा र नातिहरू थिए—सबै गरेर 150 जना। यी सबै मानिसहरू बेन्यामीनका सन्तानहरू थिए।<verse eid="1CH 8:40"/></para>
<chapter eid="1CH 8"/>
<chapter number="9" style="c" sid="1CH 9"/>
<para style="p"><verse number="1" style="v" sid="1CH 9:1"/>सारा इस्राएलीहरूको सूची इस्राएल र यहूदाका राजाहरूका वंशावलीहरूको पुस्तकमा दर्ता गरियो। तिनीहरूको अविश्‍वासको कारण यहूदालाई बेबिलोनमा कैद गरेर लगियो।<verse eid="1CH 9:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 9:2"/>अब निर्वासनबाट पहिले फर्केर आउनेहरू र तिनीहरूका आफ्नै सहरहरूमा भएका आफ्नै सम्पत्तिमा बसोबास गर्नेहरूमा केही इस्राएलीहरू, पुजारीहरू, लेवीहरू र मन्दिरका सेवकहरू थिए।<verse eid="1CH 9:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 9:3"/>तिनीहरू यहूदा, बेन्यामीन, एफ्राइम र मनश्शेबाट थिए, जो यरूशलेममा बस्दथे:<verse eid="1CH 9:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 9:4"/>ऊतै अम्मीहूदका छोरा, अम्मीहूद ओम्रीका छोरा, ओम्री इम्रीका छोरा, इम्री बानीका छोरा, जो यहूदाका छोरा पेरेसका सन्तान थिए।<verse eid="1CH 9:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 9:5"/>शीलोनीहरूबाट: जेठा छोरा असायाह र तिनका छोराहरू।<verse eid="1CH 9:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 9:6"/>जेरहातीहरूमा: यूएल। यहूदाका मानिसहरूको संख्या 690 थियो।<verse eid="1CH 9:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 9:7"/>बेन्यामीनीहरूमा: सल्‍लू मशुल्‍लामका छोरा, मशुल्‍लाम होदवियाहका छोरा, होदवियाह हस्सेनूअका छोरा।<verse eid="1CH 9:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 9:8"/>यरोहामका छोरा यिब्न्यियाह; एलाह उज्जीका छोरा, उज्जी मिक्रीका छोरा; अनि मशुल्‍लाम शपत्याहका छोरा, शपत्याह रूएलका छोरा, रूएल यिब्नियाहका छोरा थिए।<verse eid="1CH 9:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 9:9"/>बेन्यामीन वंशका मानिसहरू, तिनीहरूको वंशावलीमा सूचित गरिएअनुसार, तिनीहरूको संख्या 956 थियो। यी सबै मानिसहरू तिनीहरूका परिवारका अगुवाहरू थिए।<verse eid="1CH 9:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 9:10"/>पुजारीहरूमा: यदायाह; यहोयारीब; याकीन;<verse eid="1CH 9:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 9:11"/>अजर्याह हिल्कियाहका छोरा, हिल्कियाह मशुल्‍लामका छोरा, मशुल्‍लाम सादोकका छोरा, सादोक मरायोतका छोरा, मरायोत अहीतूबका छोरा, जो परमेश्‍वरको भवनको मुख्य अधिकारी थिए;<verse eid="1CH 9:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 9:12"/>अदायाह यरोहामका छोरा, यहोराम पशहूरका छोरा, पशहूर मल्कियाहका छोरा; अनि मासै अदीएलका छोरा, अदीएल यहजेराका छोरा, यहजेरा मशुल्‍लामका छोरा, मशुल्‍लाम मशिलेमीतका छोरा, मशिलेमीत इम्मेरका छोरा थिए।<verse eid="1CH 9:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 9:13"/>पुजारीहरू, जो परिवारका मुखियाहरू थिए तिनीहरूको संख्या 1,760 थियो। तिनीहरू परमेश्‍वरको भवनमा सेवा गर्न योग्यका जिम्मेवार मानिसहरू थिए।<verse eid="1CH 9:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 9:14"/>लेवीहरूमा: शमायाह हश्शूबका छोरा, हश्शूब अज्रीकामका छोरा, अज्रीकाम हशब्याहका छोरा, हशब्याह मरारीका छोरा थिए;<verse eid="1CH 9:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 9:15"/>बक्बक्‍कर, हेरेश, गलाल र मत्तन्याह थिए; मतन्याह मीकाका छोरा, मीका जिक्रीका छोरा, जिक्री आसापका छोरा थिए;<verse eid="1CH 9:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 9:16"/>ओबदियाह शमायाहका छोरा, शमायाह यदूतूनका छोरा, यदूतून गलालका छोरा; अनि बेरेक्याह आसाका छोरा, आसा एल्कानाका छोरा, जो नतोपातीहरूका गाउँहरूमा बस्थे।<verse eid="1CH 9:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 9:17"/>द्वारपालहरूमा: शल्‍लूम, अक्‍कूब, तल्मोन अहीमन र तिनीहरूका लेवी दाजुभाइहरू; अनि शल्‍लूमचाहिँ तिनीहरूका अगुवा थिए।<verse eid="1CH 9:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 9:18"/>यस बेलासम्म पूर्वपट्टि राजाको मूलढोकामा खटिएका द्वारपालहरू थिए। तिनीहरू लेवीहरूका छाउनीका द्वारपालहरू थिए।<verse eid="1CH 9:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 9:19"/>शल्‍लूम कोरेका छोरा, कोरे एब्यासापका छोरा, एब्यासाप कोरहका छोरा, र कोरहका सहकर्मी द्वारपालहरू तिनको परिवारबाट (कोरहवंशीहरू) तिनीहरूका पुर्खाहरू याहवेहको वासस्थानको प्रवेशद्वारको सुरक्षाको जिम्मेवारी भएझैँ, तिनीहरू छाउनीका सँघारको सुरक्षाको लागि जिम्मेवार थिए।<verse eid="1CH 9:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 9:20"/>पहिलेको समयमा एलाजारका छोरा पीनहास द्वारपालहरूका अधिकारी थिए; अनि याहवेह तिनीसँग हुनुहुन्थ्यो।<verse eid="1CH 9:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 9:21"/>मेशेलेम्याहको छोरा जकरियाचाहिँ भेट हुने पालको प्रवेशद्वारमा द्वारपाल थिए।<verse eid="1CH 9:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 9:22"/>द्वारपाल हुन चुनिएकाहरूको जम्मा संख्या 212 थियो। तिनीहरूको गाउँअनुसार तिनीहरूको वंशावली दर्ता गरिएको थियो। दावीद र दर्शी शमूएलले ती द्वारपालहरूलाई नियुक्त गरेका थिए; किनभने तिनीहरू विश्‍वासयोग्य थिए।<verse eid="1CH 9:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 9:23"/>तिनीहरू र तिनीहरूका सन्तानहरू याहवेहको भवन, अर्थात् भेट हुने पालका मूलढोकाहरूको सुरक्षा गर्ने जिम्मामा थिए।<verse eid="1CH 9:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 9:24"/>द्वारपालहरू चारै दिशामा: पूर्व, पश्‍चिम, उत्तर र दक्षिणमा थिए।<verse eid="1CH 9:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 9:25"/>तिनीहरूका गाउँहरूमा भएका लेवी दाजुभाइहरू आएर सात दिनका निम्ति तिनीहरूलाई सुरक्षाको काममा पालैपालो सहयोग गर्थे।<verse eid="1CH 9:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 9:26"/>तर चार जना मुख्य लेवी द्वारपालहरूलाई चाहिँ परमेश्‍वरको भवनमा भएका कोठाहरू र भण्डारहरूका लागि जिम्मेवारी दिइएको थियो।<verse eid="1CH 9:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 9:27"/>तिनीहरूले परमेश्‍वरको भवनको वरिपरि रात बिताउँथे; किनकि तिनीहरूले भवनको रक्षा गर्नुपर्थ्यो। भवनको चाबी तिनीहरूसँग नै हुन्थ्यो र प्रत्येक बिहान तिनीहरूले नै भवन खोल्ने गर्थे।<verse eid="1CH 9:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 9:28"/>तिनीहरूमध्ये कोहीचाहिँ मन्दिरको सेवामा प्रयोग गरिने सामग्रीहरूका अधिकारी थिए। ती सामग्रीहरू बाहिर निकालिँदा र भित्र लगिँदा तिनीहरूले गन्ती गर्थे।<verse eid="1CH 9:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 9:29"/>अरूहरूलाई चाहिँ सामानहरू र पवित्रस्थानका अरू सामग्रीहरूको साथमा विशेष पिठो, दाखमद्य, जैतुनको तेल, धूप र मसलाहरूको रेखदेख गर्ने जिम्मा दिइएको थियो।<verse eid="1CH 9:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 9:30"/>तर कति पुजारीहरूले चाहिँ मसलाहरूको मिश्रण बनाउने काम गर्थे।<verse eid="1CH 9:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 9:31"/>कोरहवंशी शल्‍लूमको जेठो छोरा मत्तीत्याह नाम भएका लेवीले भेटीको रूपमा चढाइने रोटी पकाउने जिम्मा पाएका थिए।<verse eid="1CH 9:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 9:32"/>तिनीहरूका केही कहातवंशी लेवी दाजुभाइहरूचाहिँ प्रत्येक विश्रामदिनमा मेचमाथि राखिने रोटी तयार गर्ने जिम्मामा थिए।<verse eid="1CH 9:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 9:33"/>सङ्गीतकारहरू, जो लेवी परिवारका मुखियाहरू थिए; तिनीहरू मन्दिरका कोठाहरूमा बस्थे, र तिनीहरूलाई अरू कामहरूको जिम्मा दिइँदैनथ्यो। किनकि दिनरात तिनीहरूको सङ्गीतको जिम्मेवारी थियो।<verse eid="1CH 9:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 9:34"/>यी सबै लेवी परिवारका अगुवाहरू थिए। अगुवाहरू तिनीहरूका वंशावलीको सूचीमा लेखिएका थिए; तिनीहरू यरूशलेममा बस्थे।<verse eid="1CH 9:34"/></para>
<para style="p"><verse number="35" style="v" sid="1CH 9:35"/>गिबोनका पिता यीएल गिबोनमा बस्थे। तिनकी पत्नीको नाम माका थियो।<verse eid="1CH 9:35"/></para>
<para style="p"><verse number="36" style="v" sid="1CH 9:36"/>अनि तिनका जेठा छोरा अब्दोन थिए; अब्दोनपछि सूर, कीश, बाल, नेर, नादाब,<verse eid="1CH 9:36"/></para>
<para style="p"><verse number="37" style="v" sid="1CH 9:37"/>गदोर, अहियो, जकरिया र मिक्लोत।<verse eid="1CH 9:37"/></para>
<para style="p"><verse number="38" style="v" sid="1CH 9:38"/>मिक्लोतचाहिँ शिमामका पिता थिए। तिनीहरू पनि यरूशलेममा तिनीहरूका आफन्तहरूका नजिक बस्थे।<verse eid="1CH 9:38"/></para>
<para style="p"><verse number="39" style="v" sid="1CH 9:39"/>नेर कीशका पिता थिए; कीश शाऊलका पिता, र शाऊलचाहिँ जोनाथन, मल्की-शूअ, अबीनादाब र एश-बालका पिता थिए।<verse eid="1CH 9:39"/></para>
<para style="p"><verse number="40" style="v" sid="1CH 9:40"/>जोनाथनका छोरा: मरीब-बाल, जो मीकाका पिता थिए।<verse eid="1CH 9:40"/></para>
<para style="p"><verse number="41" style="v" sid="1CH 9:41"/>मीकाका छोराहरू: पीतोन, मेलेक, तहरै र आहाज।<verse eid="1CH 9:41"/></para>
<para style="p"><verse number="42" style="v" sid="1CH 9:42"/>आहाज यादाहका पिता थिए; अनि यादाहचाहिँ, आलेमेत, अज्मावेत र जिम्रीका पिता थिए। जिम्रीचाहिँ मोसका पिता थिए।<verse eid="1CH 9:42"/></para>
<para style="p"><verse number="43" style="v" sid="1CH 9:43"/>तिनी बिनेका पिता थिए; अनि रपायाहचाहिँ बिनेका छोरा थिए। एलासा रपायाहका छोरा र आसेल एलासाका छोरा थिए।<verse eid="1CH 9:43"/></para>
<para style="p"><verse number="44" style="v" sid="1CH 9:44"/>आसेलका छ जना छोराहरू थिए, र तिनीहरूका नाम यिनै थिए; अज्रीकाम, बोकेरू, इश्माएल, शार्याह, ओबदिया र हानान। यी आसेलका छोराहरू थिए।<verse eid="1CH 9:44"/></para>
<chapter eid="1CH 9"/>
<chapter number="10" style="c" sid="1CH 10"/>
<para style="p"><verse number="1" style="v" sid="1CH 10:1"/>पलिश्तीहरूले इस्राएलीहरूको विरुद्धमा युद्ध गरे; इस्राएलीहरू पलिश्तीहरूको सामुबाट भागे र धेरै जना गिल्बो पर्वतमा मारिए।<verse eid="1CH 10:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 10:2"/>पलिश्तीहरूले शाऊल र तिनका छोराहरूलाई खेदेर पक्रे; अनि तिनीहरूले तिनका छोराहरू जोनाथन, अबीनादाब र मल्की-शूअलाई मारे।<verse eid="1CH 10:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 10:3"/>शाऊलको चारैतिर युद्धले भयङ्ककर रूप लियो। अनि जब धनुर्धारीहरू तिनीमाथि जाइलागे, तब उनीहरूले तिनलाई घाइते बनाए।<verse eid="1CH 10:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 10:4"/>शाऊलले आफ्ना हतियार बोक्नेलाई भने, “आफ्नो तरवार थुतेर मलाई रोप्, नत्रता यी खतना नभएकाहरू आएर मेरो खिल्‍ली उडाउनेछन् र मार्नेछन्।” तर तिनको हतियार बोक्ने डरायो र त्यसो गर्ने आँट गरेन। त्यसकारण शाऊलले आफ्नो तरवार थुते, र त्यसैमा उनिएर मरे।<verse eid="1CH 10:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 10:5"/>जब त्यस हतियार बोक्नेले शाऊललाई मरेको देख्यो, तब त्यसले पनि आफ्नो तरवारले आफैँलाई रोप्यो र मर्‍यो।<verse eid="1CH 10:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 10:6"/>यसरी शाऊल र तिनका तीन जना छोराहरू मरे। तिनको सम्पूर्ण घराना एकैसाथ मरे।<verse eid="1CH 10:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 10:7"/>जब बेँसीमा भएका सारा इस्राएलीहरूले सेनाहरू भागिरहेका, र शाऊल र तिनका छोराहरू मरेका देखे, तब तिनीहरू आफ्ना सहरहरू छोडेर भागे। अनि पलिश्तीहरू आएर तिनीहरूका सहरहरू कब्जा गरे।<verse eid="1CH 10:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 10:8"/>भोलिपल्ट जब पलिश्तीहरू मरेकाहरूका माल लुट्न आए, तब तिनीहरूले शाऊल र तिनका छोराहरूलाई गिल्बो पर्वतमा मारिएका भेट्टाए।<verse eid="1CH 10:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 10:9"/>तिनीहरूले तिनलाई नाङ्गो पारेर तिनको टाउको र हतियार लगे। यो खबर तिनीहरूका मूर्तिहरू र तिनीहरूका मानिसहरूका बीचमा घोषणा गर्नलाई पलिश्तीहरूको देशभरि दूतहरू पठाए।<verse eid="1CH 10:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 10:10"/>तिनीहरूले शाऊलका हतियार आफ्ना देवताहरूको मन्दिरमा राखे, र तिनको टाउकोलाई चाहिँ आफ्ना देवता दागोनको मन्दिरमा झुण्ड्याए।<verse eid="1CH 10:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 10:11"/>जब याबेश-गिलादका सबै बासिन्दाहरूले शाऊललाई पलिश्तीहरूले के गरेका थिए भन्‍ने सुने,<verse eid="1CH 10:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 10:12"/>तब तिनीहरूका सबै वीर मानिसहरू गएर शाऊल र तिनका छोराहरूका मृत शरीर याबेशमा ल्याए। त्यसपछि उनीहरूले तिनीहरूका हड्डीहरू याबेशको ठूलो रूखमुनि गाडे; र उनीहरू सात दिनसम्म उपवास बसे।<verse eid="1CH 10:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 10:13"/>शाऊलको मृत्यु भयो; किनकि तिनी याहवेहप्रति विश्‍वासयोग्य थिएनन्। त्यसकारण तिनले याहवेहको वचन पालन गरेनन्, तब तिनले अगुवाइको निम्ति तन्त्रमन्त्रको सल्‍लाह लिए;<verse eid="1CH 10:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 10:14"/>तर याहवेहसँग चाहिँ सल्‍लाह लिएनन्। यसकारण याहवेहको विरोध गरेको पापले गर्दा तिनी मर्नुपर्‍यो। अनि उहाँले तिनको राज्य यिशैका छोरा दावीदलाई दिनुभयो।<verse eid="1CH 10:14"/></para>
<chapter eid="1CH 10"/>
<chapter number="11" style="c" sid="1CH 11"/>
<para style="p"><verse number="1" style="v" sid="1CH 11:1"/>सारा इस्राएलीहरू हेब्रोनमा दावीदकहाँ आएर भने, “हामी तपाईंकै आफ्नै हाडनाता हौँ।<verse eid="1CH 11:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 11:2"/>विगतमा शाऊल राजा हुँदा पनि, इस्राएललाई सैनिक लडाइँमा डोर्‍याउने तपाईं नै हुनुहुन्थ्यो। याहवेह तपाईंका परमेश्‍वरले तपाईंलाई भन्‍नुभएको थियो, ‘तँ मेरा प्रजा इस्राएलको गोठालो हुनेछस्, र तँ तिनीहरूका शासक हुनेछस्।’ ”<verse eid="1CH 11:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 11:3"/>जब इस्राएलका सबै प्रधानहरू हेब्रोनमा राजा दावीदकहाँ आए, तब दावीदले हेब्रोनमा याहवेहको सामु तिनीहरूसित एउटा करार बाँधे। याहवेहले शमूएलद्वारा प्रतिज्ञा गर्नुभएजस्तै तिनीहरूले दावीदलाई इस्राएलमाथि राजा अभिषेक गरे।<verse eid="1CH 11:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 11:4"/>दावीद र सारा इस्राएलीहरू यरूशलेम (अर्थात् यबूस) तर्फ गए। त्यहाँ बस्‍ने यबूसीहरूले<verse eid="1CH 11:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 11:5"/>दावीदलाई भने, “तपाईं यहाँ कहिल्यै आउनुहुनेछैन।” तरै पनि दावीदले सियोनको किल्‍लालाई कब्जा गरे, अर्थात् जुन दावीदको सहर हो।<verse eid="1CH 11:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 11:6"/>दावीदले भनेका थिए, “जसले यबूसीहरूमाथि पहिले आक्रमण गर्छ, त्यो सेनापति हुनेछ।” तब सरूयाहका छोरा योआबले पहिले आक्रमण गरे, र तिनी सेनापति भए।<verse eid="1CH 11:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 11:7"/>दावीदले त्यस किल्‍लामा बसोबास गरे, र त्यसलाई दावीदको सहर भनियो।<verse eid="1CH 11:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 11:8"/>तिनले कौसीदेखि लिएर चारैतिरका पर्खालहरूसम्म वरिपरि सहरको निर्माण गरे; अनि योआबले चाहिँ बाँकी रहेको सहर पुनर्स्थापित गरे।<verse eid="1CH 11:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 11:9"/>दावीद झन्-झन् शक्तिशाली बन्दैगए; किनकि सेनाहरूका याहवेह तिनीसँग हुनुहुन्थ्यो।<verse eid="1CH 11:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 11:10"/>दावीदका वीर योद्धाहरूका अगुवाहरू यिनै थिए जसले सारा इस्राएलसँग मिलेर याहवेहले प्रतिज्ञा गर्नुभएझैँ, सम्पूर्ण देशमा दावीदको राज्य बलियो बनाउन दरिलो सहारा दिए।<verse eid="1CH 11:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 11:11"/>दावीदका वीर योद्धाहरूको सूची यही हो: हक्मोनी यशोबाम अधिकृतहरूका प्रमुख थिए; जसले एकै पटकमा तीन सय मानिसहरूलाई आफ्नो भालाले प्रहार गरेर मारे।<verse eid="1CH 11:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 11:12"/>यशोबामपछि अहोही दोदोका छोरा एलाजार, जो तीन जना वीरहरूमध्येका एक जना थिए।<verse eid="1CH 11:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 11:13"/>पलिश्तीहरू पास-दम्मीममा युद्ध गर्नका निम्ति भेला हुँदा एलाजार दावीदसँग थिए। त्यो ठाउँ जहाँ जौले भरिएको खेत थियो, र इस्राएली सेनाहरू पलिश्तीहरूदेखि भागेका थिए।<verse eid="1CH 11:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 11:14"/>तर इस्राएली सेनाहरू जौको खेतको बीचमा खडा भए। तिनीहरूले त्यस खेतलाई सुरक्षा दिइराखे; र पलिश्तीहरूलाई मारे। अनि याहवेहले सेनाहरूलाई ठूलो विजय दिनुभयो।<verse eid="1CH 11:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 11:15"/>तीसमध्ये तीन जना मुख्य वीरहरू अदुल्‍लामको गुफामा भएको चट्टानमा दावीदकहाँ आए। त्यही समयमा पलिश्तीहरूको एक दलचाहिँ रपाईमको बेँसीमा छाउनी हालेर बसेका थिए।<verse eid="1CH 11:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 11:16"/>त्यस बेला दावीद गढीमा थिए। अनि पलिश्ती सेनाहरूचाहिँ बेथलेहेममा थिए।<verse eid="1CH 11:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 11:17"/>दावीदले पानीको इच्छा गरेर भने, “अहो, कसैले बेथलेहेमको मूलढोकाको छेउको इनारबाट मलाई पानी पिउनलाई ल्याइदिए हुनेथियो!”<verse eid="1CH 11:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 11:18"/>यसकारण ती तीन जना पलिश्तीहरूको छाउनीबाट छिरेर गए। अनि बेथलेहेमको मूलढोकाको छेउको कुवाबाट पानी लिएर दावीदकहाँ फर्किआए। तर तिनले त्यो पानी पिउन इन्कार गरे। तिनले पिउनको सट्टा पानीलाई याहवेहको सामु खन्याइदिए।<verse eid="1CH 11:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 11:19"/>तिनले भने, “परमेश्‍वरले मलाई यसो गर्न नदेऊन्! के तिनीहरूको जीवन जोखिममा पारेर जाने यी मानिसहरूको रगत मैले पिऊँ?” तिनीहरूले आफ्नो जीवनलाई जोखिममा पारेर पानी ल्याएको कारणले दावीदले त्यो पानी पिएनन्। ती तीन जना वीर मानिसहरूका वीरताका कामहरू यस्ता थिए।<verse eid="1CH 11:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 11:20"/>ती तीन जनाका अगुवाचाहिँ योआबका भाइ अबीशै थिए। तिनले तीन सय मानिसहरूको विरुद्धमा आफ्नो भाला उठाए र मारे। यसैले तिनी पनि ती तीन जना वीरहरूझैँ प्रसिद्ध भए।<verse eid="1CH 11:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 11:21"/>अबीशैले ती तीन जनाले भन्दा दोबर सम्मान पाए। यद्यपि तिनी ती तीन जनामध्येका थिएनन्, तापनि तिनी उनीहरूका सेनापति भए।<verse eid="1CH 11:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 11:22"/>कब्सेलबाट यहोयादाका छोरा बनायाह एक जना वीर योद्धा थिए, जसले धेरै वीरताका कामहरू गरेका थिए। तिनले मोआबका दुई जना वीर योद्धाहरूलाई मारे। हिउँ परेको दिन एउटा खाडलमा तल ओर्लेर तिनले एउटा सिंहलाई मारे।<verse eid="1CH 11:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 11:23"/>अनि तिनले पाँच क्यूबिट अग्लो एक जना इजिप्टियनलाई मारे। त्यस इजिप्‍टियनको हातमा तान बुन्‍ने डण्डाजस्तो एउटा भाला थियो, तापनि त्यसको विरुद्धमा बनायाहले एउटा लहुरो लिएर गए। तिनले त्यस इजिप्‍टियनको हातबाट भाला खोसेर त्यसलाई त्यसकै भालाले मारे।<verse eid="1CH 11:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 11:24"/>यहोयादाका छोरा बनायाहका वीरताका कामहरू यस्तै थिए; तिनी पनि ती तीन वीर मानिसहरूजस्तै प्रसिद्ध थिए।<verse eid="1CH 11:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 11:25"/>तिनको पनि तीस जनाभन्दा बढी सम्मान भयो, तर ती तीन जना वीर मानिसहरूसँग गनिएनन्। दावीदले तिनलाई आफ्ना अङ्गरक्षकहरूमाथि सेनापति नियुक्त गरे।<verse eid="1CH 11:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 11:26"/>ती वीर मानिसहरू यी हुन्: योआबका भाइ असाहेल, बेथलेहेमबासी दोदोका छोरा एल्हानान,<verse eid="1CH 11:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 11:27"/>हरोरी शम्मोत, पेलोनी हेलेस,<verse eid="1CH 11:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 11:28"/>तकोईबाट इक्‍केशका छोरा ईरा, अनातोतका अबीएजेर,<verse eid="1CH 11:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 11:29"/>हूशातीका सिब्बकै, अहोही ईलै,<verse eid="1CH 11:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 11:30"/>नतोपाती महरै, नतोपाती बानाहका छोरा हेलेद,<verse eid="1CH 11:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 11:31"/>बेन्यामीनको गेबाबाट रीबैका छोरा इत्तै, पिरातोनी बनायाह,<verse eid="1CH 11:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 11:32"/>गाशका खोल्साहरूबाट हूरै, अर्बातीबाट अबीएल,<verse eid="1CH 11:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 11:33"/>बहूरीमी अज्मावेत, शाल्बोनी एल्याहबा,<verse eid="1CH 11:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 11:34"/>गीजोनी हाशेमका छोराहरू, हरारी शागेका छोरा जोनाथन,<verse eid="1CH 11:34"/></para>
<para style="p"><verse number="35" style="v" sid="1CH 11:35"/>हरारी साकारका छोरा अहीआम, ऊरका छोरा एलीपाल,<verse eid="1CH 11:35"/></para>
<para style="p"><verse number="36" style="v" sid="1CH 11:36"/>मकेराती हेपेर, पेलोनी अहीयाह,<verse eid="1CH 11:36"/></para>
<para style="p"><verse number="37" style="v" sid="1CH 11:37"/>कर्मेलबाट हेस्रो, एज्बैका छोरा नारै,<verse eid="1CH 11:37"/></para>
<para style="p"><verse number="38" style="v" sid="1CH 11:38"/>नातानका भाइ योएल, हग्रीका छोरा मिभार,<verse eid="1CH 11:38"/></para>
<para style="p"><verse number="39" style="v" sid="1CH 11:39"/>अम्मोनबाट सेलेक, बेरोती नहरै, जसले सरूयाहका छोरा योआबका हतियार बोक्ने गर्थे,<verse eid="1CH 11:39"/></para>
<para style="p"><verse number="40" style="v" sid="1CH 11:40"/>यित्री ईरा, यित्रीबाट गारेब,<verse eid="1CH 11:40"/></para>
<para style="p"><verse number="41" style="v" sid="1CH 11:41"/>हित्ती उरियाह, अहलैका छोरा जाबाद,<verse eid="1CH 11:41"/></para>
<para style="p"><verse number="42" style="v" sid="1CH 11:42"/>रूबेनी शीजाका छोरा अदीना, जो रूबेनीहरू र तिनीसँग भएका तीस जना मानिसहरूका प्रमुख थिए;<verse eid="1CH 11:42"/></para>
<para style="p"><verse number="43" style="v" sid="1CH 11:43"/>माकाहका छोरा हानान, मित्नी योशापात,<verse eid="1CH 11:43"/></para>
<para style="p"><verse number="44" style="v" sid="1CH 11:44"/>अश्तेराती उज्जीया, अरोएरबाट होतामका छोराहरू शामा र यीएल,<verse eid="1CH 11:44"/></para>
<para style="p"><verse number="45" style="v" sid="1CH 11:45"/>शिम्रीका छोरा यदीएल, तिनका भाइ तिजीबाट योहा,<verse eid="1CH 11:45"/></para>
<para style="p"><verse number="46" style="v" sid="1CH 11:46"/>महाबी एलीएल, एल्नामका छोराहरू, यरीबै र योशब्याह, मोआबी यित्मा,<verse eid="1CH 11:46"/></para>
<para style="p"><verse number="47" style="v" sid="1CH 11:47"/>एलीएल, ओबेद र मेजोबाई यासीएल।<verse eid="1CH 11:47"/></para>
<chapter eid="1CH 11"/>
<chapter number="12" style="c" sid="1CH 12"/>
<para style="p"><verse number="1" style="v" sid="1CH 12:1"/>दावीदलाई कीशका छोरा शाऊलको सामुबाट निष्कासन गरिएको बेलामा सिक्लगमा दावीदकहाँ आउने मानिसहरू यिनीहरू नै थिए। (तिनीहरू योद्धाहरू मध्येका थिए, जसले दावीदलाई लडाइँमा सघाएका थिए।<verse eid="1CH 12:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 12:2"/>तिनीहरू धनुर्धारी थिए, र काँड हान्‍न सक्ने अथवा दायाँ-बायाँ दुवै हातले घुँयेत्रोले ढुङ्गा हान्‍न सक्ने क्षमता भएका मानिसहरू थिए। तिनीहरू बेन्यामीनी कुलबाट शाऊलका आफन्तहरू थिए):<verse eid="1CH 12:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 12:3"/>गिबियाति शेमाहका छोराहरू अहीएजेर र योआश तिनीहरूका अगुवा थिए; अज्मावेतका छोराहरू यजीएल र पेलेत; बराकाह, अनातोती येहू;<verse eid="1CH 12:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 12:4"/>अनि गिबोनबाट यिश्मायाह, जो तीस जनामध्येका एक वीर मानिस थिए, जो ती तीस जना वीरहरूमध्येका अगुवा थिए; गदेराबाट यर्मिया, यहजीएल, योहानान, योजाबाद,<verse eid="1CH 12:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 12:5"/>एलूजै, यरीमोत, बाल्याह, शमर्याह, र हारूपीबाट शपत्याह;<verse eid="1CH 12:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 12:6"/>कोरहवंशीबाट एल्काना, यिश्याह, अजरेल, योएजेर र यशोबाम थिए;<verse eid="1CH 12:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 12:7"/>अनि गदोरबाट यरोहामका छोराहरू योएलह र जबदियाह थिए।<verse eid="1CH 12:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 12:8"/>केही गादीहरू दावीदसँग मिल्न भनी उजाडस्थानमा भएको गढमा तिनीकहाँ आए। तिनीहरू बहादुर योद्धाहरू थिए, लडाइँ गर्न तयार रहेका ढाल र भाला चलाउन सक्ने योद्धाहरू थिए। तिनीहरूका अनुहार सिंहका अनुहारझैँ र तिनीहरू पहाडहरूका घोरलहरूझैँ फूर्तिला थिए।<verse eid="1CH 12:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 12:9"/>एजेरचाहिँ तिनीहरूका मुखिया थिए; दोस्रोमा ओबदिया, तेस्रोमा एलिआब,<verse eid="1CH 12:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 12:10"/>चौथो मिश्मन्‍ना, पाँचौँ यर्मिया,<verse eid="1CH 12:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 12:11"/>छैटौँ अत्तै, सातौँ एलीएल,<verse eid="1CH 12:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 12:12"/>आठौँ योहानान, नवौँ एल्जाबाद,<verse eid="1CH 12:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 12:13"/>दसौँ यर्मिया र एघारौँचाहिँ मक्बन्‍ने।<verse eid="1CH 12:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 12:14"/>यी गादीहरू सेनाका सेनापतिहरू थिए; जसमा सबैभन्दा कमजोर एक सय सेना बराबर र सबैभन्दा बलियाचाहिँ एक हजार सेना बराबरका थिए।<verse eid="1CH 12:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 12:15"/>यिनीहरू ती नै मानिसहरू थिए, जसले पहिलो महिनामा यर्दन नदी तरेका थिए; जुन बेला नदीको पानी किनारसम्मै उर्लेर आएको थियो। अनि यिनीहरूले नै पूर्व र पश्‍चिमतिर बेँसीहरूमा बसेका सबै मानिसहरूलाई भगाएका थिए।<verse eid="1CH 12:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 12:16"/>बेन्यामीनी र यहूदाबाट पनि केही मानिसहरू दावीदलाई भेट्न तिनको गढमा आए।<verse eid="1CH 12:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 12:17"/>दावीद तिनीहरूलाई भेट्न बाहिर निस्केर आए, र तिनीहरूलाई भने, “यदि तिमीहरू मकहाँ मिलापको लागि र मेरो सहायताको लागि आएका हौ भने म तिमीहरूसँग मिलाप गर्न तयार छु; तर म निर्दोष हुँदा-हुँदै पनि तिमीहरूले मलाई धोका दिएर मेरा शत्रुहरूको हातमा सुम्पनलाई आएका हौ भने हाम्रा पुर्खाहरूका परमेश्‍वरले यो कुरा देखून्, र तिमीहरूको न्याय गरून्।”<verse eid="1CH 12:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 12:18"/>तब ती तीस जनाका मुखिया अमासैमाथि परमेश्‍वरको आत्मा आउनुभयो र तिनले भने: “हे दावीद, हामी तपाईंका हौँ! हे यिशैका छोरा, हामी तपाईंकै साथमा छौँ! शान्ति र सफलता तपाईंकै होस्, अनि तपाईंलाई सहायता गर्नेहरूको पनि सफलता होस्; किनकि तपाईंका परमेश्‍वरले तपाईंलाई सहायता गर्नुहुनेछ।” यसकारण दावीदले तिनीहरूलाई ग्रहण गरे, र तिनीहरूलाई आफ्ना लुटपाट गर्ने सेना दलहरूका अगुवाहरू बनाए।<verse eid="1CH 12:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 12:19"/>जब दावीद पलिश्तीहरूसँग शाऊलको विरुद्धमा लडाइँ गर्न गएका थिए, तब मनश्शेका केही मानिसहरूले शाऊललाई छाडेर दावीदलाई पछ्याए। (दावीद र तिनका मानिसहरूले पलिश्तीहरूलाई सहायता गरेनन्; किनकि पलिश्तीहरूको सरसल्‍लाहपछि तिनीहरूका शासकहरूले दावीदलाई फिर्ता पठाइदिए। तिनीहरूले भने, “यदि दावीदले आफ्ना मालिक शाऊलसँग मिलेर हामीलाई त्यागिदिए भने हामीले हाम्रा टाउकाको मूल्य चुकाउनुपर्नेछ।”)<verse eid="1CH 12:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 12:20"/>जब दावीद सिक्लगमा गए, तब उनीसँग मिल्न आएका मनश्शेका मानिसहरू यिनीहरू नै थिए: अदनाह, योजाबाद, यदीएल, मिखाएल, योजाबाद, एलीहू र सिल्‍लतै। मनश्शेको कुलबाट यिनीहरू हजार सैन्य दलमाथिका अगुवाहरू थिए।<verse eid="1CH 12:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 12:21"/>तिनीहरूले दावीदलाई लुटपाट गर्ने सैनिक दलहरूका विरुद्धमा सहायता गरे; किनकि तिनीहरू सबै वीर योद्धाहरू र तिनका सेनाका सेनापतिहरू थिए।<verse eid="1CH 12:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 12:22"/>दावीदसँग परमेश्‍वरका सेनाझैँ ठूलो सेना नभएसम्म दिन प्रतिदिन तिनलाई सहायता गर्न मानिसहरू आए।<verse eid="1CH 12:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 12:23"/>याहवेहले भन्‍नुभएझैँ शाऊलको राज्य दावीदलाई सुम्पन हेब्रोनमा दावीदकहाँ आएका लडाइँका निम्ति हतियारले सुसज्जित भई आउने मानिसहरूको संख्या यही हो:<verse eid="1CH 12:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 12:24"/>यहूदाबाट ढाल र भाला बोकेर लडाइँका निम्ति सुसज्जित भएका योद्धाहरू 6,800 थिए।<verse eid="1CH 12:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 12:25"/>शिमियोन कुलबाट लडाइँका निम्ति तयार भएका योद्धाहरू 7,100 थिए।<verse eid="1CH 12:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 12:26"/>लेवी कुलबाट 4,600 थिए।<verse eid="1CH 12:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 12:27"/>तीबाहेक हारूनको परिवारका अगुवा यहोयादा सहित 3,700 पुरुषहरू सामेल थिए,<verse eid="1CH 12:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 12:28"/>अनि एक जवान वीर योद्धा सादोक, जो आफ्ना परिवारका 22 अधिकृतहरूसहित थिए।<verse eid="1CH 12:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 12:29"/>शाऊलको कुल, बेन्यामीनका आफन्तहरूबाट 3,000 थिए, जसमध्ये धेरै जना त्यस बेलासम्म शाऊलका घरानाप्रति विश्‍वासयोग्य भई बसेका थिए।<verse eid="1CH 12:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 12:30"/>एफ्राइमको कुलबाट आफ्नै वंशहरूमा प्रसिद्ध रहेका 20,800 वीर योद्धाहरू थिए।<verse eid="1CH 12:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 12:31"/>मनश्शेका आधा कुलबाट, अर्थात् दावीदलाई राजा बनाउनलाई नाम नै तोकेर बोलाइएकाहरू 18,000 थिए।<verse eid="1CH 12:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 12:32"/>इस्साखारको कुलबाट ती मानिसहरू, जसले उचित समय बुझेका र इस्राएलले के गर्नुपर्छ भन्‍ने ठिक कुरा जान्‍नेहरू थिए। तिनीहरूका अधीनमा रहेका सबै आफन्तहरू समेत 200 मुखियाहरू थिए।<verse eid="1CH 12:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 12:33"/>जबूलूनको कुलबाट दावीदलाई पूर्ण रूपमा इमानदारीतासाथ सहायता गर्नलाई सबै प्रकारका हातहतियार भिरेर लडाइँ गर्न तयार रहेका निपुण 50,000 योद्धाहरू थिए।<verse eid="1CH 12:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 12:34"/>नप्‍तालीको कुलबाट ढाल र भाला बोकेका 37,000 मानिसहरूसहित 1,000 अधिकारीहरू थिए।<verse eid="1CH 12:34"/></para>
<para style="p"><verse number="35" style="v" sid="1CH 12:35"/>दानको कुलबाट लडाइँका निम्ति तयार रहेका 28,600 मानिसहरू थिए।<verse eid="1CH 12:35"/></para>
<para style="p"><verse number="36" style="v" sid="1CH 12:36"/>आशेरको कुलबाट लडाइँको निम्ति तयार रहेका अनुभवी योद्धाहरू 40,000 थिए।<verse eid="1CH 12:36"/></para>
<para style="p"><verse number="37" style="v" sid="1CH 12:37"/>अनि यर्दनको पूर्वपट्टिका रूबेन, गाद र मनश्शेको आधा कुलबाट हरेक किसिमका हातहतियारले सुसज्जित भएका 120,000 मानिसहरू थिए।<verse eid="1CH 12:37"/></para>
<para style="p"><verse number="38" style="v" sid="1CH 12:38"/>यी सबै लडाकु मानिसहरू थिए, र स्वेच्छापूर्वक सबै दर्जामा सेवा गर्न राजी थिए। तिनीहरू दावीदलाई इस्राएलमाथि राजा बनाउने दृढ संकल्प लिएर हेब्रोनमा आए। बाँकी सबै इस्राएलीहरू पनि दावीदलाई राजा बनाउन एउटै मनका भए।<verse eid="1CH 12:38"/></para>
<para style="p"><verse number="39" style="v" sid="1CH 12:39"/>ती मानिसहरूले दावीदसँग खाँदै र पिउँदै तीन दिन बिताए। किनभने तिनीहरूका परिवारले तिनीहरूका निम्ति सरसामानहरू जुटाइदिएका थिए।<verse eid="1CH 12:39"/></para>
<para style="p"><verse number="40" style="v" sid="1CH 12:40"/>तिनीहरूका इलाका नजिक रहेका इस्साखार, जबूलून र नप्‍तालीहरू पनि गधा, ऊँट, खच्‍चर र गोरुहरूमा भोजन लदाएर आए। इस्राएलमा खुशी छाएको कारणले त्यहाँ पिठो, सुकेको नेभारा, किसमिस, दाखमद्य, जैतुनको तेल, गोरुहरू र भेडाहरू प्रशस्त मात्रामा थिए।<verse eid="1CH 12:40"/></para>
<chapter eid="1CH 12"/>
<chapter number="13" style="c" sid="1CH 13"/>
<para style="p"><verse number="1" style="v" sid="1CH 13:1"/>दावीदले हजार-हजारमाथि र सय-सयमाथिका सेनापतिहरूसहित आफ्ना प्रत्येक अधिकारीहरूसँग सल्‍लाह लिए।<verse eid="1CH 13:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 13:2"/>त्यसपछि तिनले इस्राएलका सारा समुदायलाई भने, “यदि तपाईंहरूलाई असल लाग्यो, र याहवेह हाम्रा परमेश्‍वरको इच्छा यही हो भने हामी इस्राएलको प्रान्तभरि टाढा वा नजिक रहेका हाम्रा बाँकी दाजुभाइहरूकहाँ र तिनीहरूसँग तिनीहरूकै नगर र खर्कहरूमा रहेका पुजारीहरू र लेवीहरूलाई हामीकहाँ आउन र हामीसँग सामेल हुन खबर पठाऔँ।<verse eid="1CH 13:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 13:3"/>हामी परमेश्‍वरको सन्दुकलाई आफूकहाँ फर्काएर ल्याऔँ। किनकि हामीले शाऊलको शासनकालमा सन्दुकको खोजी गरेनौँ।”<verse eid="1CH 13:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 13:4"/>सबै मानिसहरूलाई यो ठिक लागेको कारण, सम्पूर्ण समुदाय त्यसमा सहमत भयो।<verse eid="1CH 13:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 13:5"/>यसकारण दावीदले इजिप्टमा भएको शीहोर नदीदेखि लेबो-हमातसम्मका सबै इस्राएलीहरूलाई किर्यत-यारीमबाट परमेश्‍वरको सन्दुक ल्याउन भनी भेला गराए।<verse eid="1CH 13:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 13:6"/>दावीद र तिनीसँग भएका सारा इस्राएलीहरू करूबहरूका बीच सिंहासनमा विराजमान हुनुहुने याहवेह परमेश्‍वरका नामले कहलाइएको सन्दुकलाई ल्याउन भनी यहूदाको बालाहमा (किर्यत-यारीम) गए।<verse eid="1CH 13:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 13:7"/>तिनीहरूले परमेश्‍वरको सन्दुकलाई अबीनादाबको घरबाट एउटा नयाँ गाडामा राखेर, उज्जाह र अहियोले त्यो गाडा हाँकेर त्यसलाई अगि बढाए।<verse eid="1CH 13:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 13:8"/>दावीद र सारा इस्राएलीहरूचाहिँ गीत, वीणा, सारङ्गी, खैँजडी, झ्याली र तुरहीको साथमा आफ्ना सारा शक्तिले परमेश्‍वरको सामु उत्सव मनाइरहेका थिए।<verse eid="1CH 13:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 13:9"/>जब तिनीहरू किदोनको खलामा आइपुगे, तब गोरुहरूले ठेस खाएको कारण सन्दुक नखसोस् भनी त्यसलाई थाम्न भनेर उज्जाहले आफ्नो हात बढाए।<verse eid="1CH 13:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 13:10"/>तब याहवेहको क्रोध उज्जाहमाथि दन्कियो। अनि तिनले आफ्नो हातले सन्दुकलाई छोएको कारण, उहाँले तिनलाई प्रहार गर्नुभयो। यसकारण त्यहीँ नै परमेश्‍वरको सामु तिनको मृत्यु भयो।<verse eid="1CH 13:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 13:11"/>यसरी याहवेहको क्रोध उज्जाहमाथि आइपरेको कारण दावीद दुःखित भए। अनि आजको दिनसम्मै त्यस ठाउँलाई पेरेस-उज्जाह भनिन्छ।<verse eid="1CH 13:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 13:12"/>त्यस दिन दावीद परमेश्‍वरसँग डराए, र तिनले सोधे, “मैले परमेश्‍वरको सन्दुक कसरी आफूकहाँ ल्याउन सकूँला?”<verse eid="1CH 13:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 13:13"/>दावीदले सन्दुकलाई दावीदको सहरमा आफूसँग लगेनन्, बरु तिनले सन्दुकलाई गित्ती ओबेद-एदोमको घरमा लगे।<verse eid="1CH 13:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 13:14"/>परमेश्‍वरको सन्दुक ओबेद-एदोमकहाँ तीन महिनासम्म रह्‍यो। याहवेहले तिनको घराना र तिनीसँग भएका हरेक कुरामा आशिष् दिनुभयो।<verse eid="1CH 13:14"/></para>
<chapter eid="1CH 13"/>
<chapter number="14" style="c" sid="1CH 14"/>
<para style="p"><verse number="1" style="v" sid="1CH 14:1"/>टायरका राजा हीरामले दावीदका निम्ति महल निर्माण गर्नलाई देवदारुका काठहरू, डकर्मीहरू र सिकर्मीहरूसहित दावीदकहाँ दूतहरू पठाए।<verse eid="1CH 14:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 14:2"/>अनि याहवेहले इस्राएलमाथि राजाको रूपमा आफूलाई स्थापित गर्नुभएको, र उहाँका प्रजा इस्राएलको खातिर तिनको राज्यको गौरव धेरै बढाइदिनुभएको कुरा दावीदलाई थाहा भयो।<verse eid="1CH 14:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 14:3"/>दावीदले यरूशलेममा अरू धेरै पत्नीहरू ल्याए। तिनी अरू पनि धेरै छोराछोरीहरूका पिता भए।<verse eid="1CH 14:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 14:4"/>यरूशलेममा जन्मिएका तिनका सन्तानका नाम यिनै हुन्: शम्मूअ, शोबाब, नातान, सोलोमन,<verse eid="1CH 14:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 14:5"/>यिभार, एलीशूअ, एल्पेलेत,<verse eid="1CH 14:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 14:6"/>नोगह, नेपेग, याफिया,<verse eid="1CH 14:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 14:7"/>एलीशामा, बेलीयादा र एलीपेलेत।<verse eid="1CH 14:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 14:8"/>जब दावीद सारा इस्राएलमाथि राजा अभिषेक भएको कुरा पलिश्तीहरूले सुने, तब तिनीहरू दावीदलाई खोज्न भनी पूरा फौज लिएर निस्के। तर त्यो कुरा सुनेर दावीद तिनीहरूसँग युद्ध गर्नलाई गए।<verse eid="1CH 14:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 14:9"/>तब पलिश्तीहरूचाहिँ आएर रपाईमको बेँसीलाई लुटपाट गरे।<verse eid="1CH 14:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 14:10"/>यसकारण दावीदले परमेश्‍वरसँग यसो भन्दै सल्‍लाह लिए, “के म गएर पलिश्तीहरूमाथि आक्रमण गरूँ? के तपाईंले तिनीहरूलाई मेरो हातमा सुम्पिदिनुहुनेछ?” याहवेहले तिनलाई जवाफ दिनुभयो, “जा, म तिनीहरूलाई तेरो हातमा सुम्पिदिनेछु।”<verse eid="1CH 14:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 14:11"/>यसकारण दावीद र तिनका मानिसहरू बाल-पराजीममा गए। अनि त्यहाँ तिनले तिनीहरूलाई जिते। तिनले भने, “बाँध फुटेर ओइरिएको पानीझैँ, परमेश्‍वरले मलाई मेरा शत्रुहरूको विरुद्धमा जाइलाग्न प्रयोग गर्नुभयो।” यसकारण त्यस ठाउँलाई बाल-पराजीम भनियो।<verse eid="1CH 14:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 14:12"/>पलिश्तीहरूले तिनीहरूका मूर्तिहरू त्यहीँ छोडेर भागे। तब दावीदले तिनीहरूलाई आगोमा जलाइदिने आदेश दिए।<verse eid="1CH 14:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 14:13"/>पलिश्तीहरू फेरि एक पटक बेँसीमा लुटपाट गर्न आए।<verse eid="1CH 14:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 14:14"/>यसकारण दावीदले फेरि परमेश्‍वरसित सल्‍लाह लिए। अनि परमेश्‍वरले तिनलाई जवाफ दिनुभयो, “तिमीहरू सीधै तिनीहरू माथि जाइनलाग, तर तिनीहरूलाई घेरा हालेर लहरे पीपलका रूखहरूको सामुबाट आक्रमण गर।<verse eid="1CH 14:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 14:15"/>तिमीहरूले ती लहरे पीपलको टुप्पोमा युद्ध-मोर्चाको आवाज सुन्‍नेबित्तिकै युद्धका निम्ति अगि बढ्नू। किनकि त्यसको अर्थ परमेश्‍वर पलिश्ती सेनाहरूलाई प्रहार गर्न तिमीहरूका अगि-अगि जानुहुनेछ।”<verse eid="1CH 14:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 14:16"/>यसकारण दावीदले परमेश्‍वरले तिनलाई आज्ञा गर्नुभएअनुसार गरे; अनि तिनीहरूले पलिश्ती सेनाहरूलाई गिबोनदेखि गेजेरसम्मै आक्रमण गरेर मारे।<verse eid="1CH 14:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 14:17"/>यसरी दावीदको कीर्ति सर्वत्र फैलियो। याहवेहले सबै राष्ट्रलाई दावीदसँग भयभीत हुने बनाउनुभयो।<verse eid="1CH 14:17"/></para>
<chapter eid="1CH 14"/>
<chapter number="15" style="c" sid="1CH 15"/>
<para style="p"><verse number="1" style="v" sid="1CH 15:1"/>दावीदले आफ्ना निम्ति दावीदको सहरमा भवन निर्माण गरे। तिनले परमेश्‍वरको सन्दुकको निम्ति एउटा ठाउँ तयार गरे; र त्यसको निम्ति एउटा पाल टाँगे।<verse eid="1CH 15:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 15:2"/>त्यसपछि दावीदले भने, “लेवीहरूले बाहेक अरू कसैले परमेश्‍वरको सन्दुक नबोकून्; किनकि याहवेहले तिनीहरूलाई नै याहवेहको सन्दुक बोक्न र सधैँका निम्ति उहाँको सामु सेवा गर्नलाई चुन्‍नुभएको छ।”<verse eid="1CH 15:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 15:3"/>दावीदले याहवेहको सन्दुकको निम्ति तयार गरेको ठाउँमा, त्यस सन्दुक ल्याउन सारा इस्राएललाई यरूशलेममा भेला गराए।<verse eid="1CH 15:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 15:4"/>तिनले हारून र लेवीका सन्तानहरूलाई एकसाथ बोलाए:<verse eid="1CH 15:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 15:5"/>कहातका सन्तानहरूबाट अगुवा ऊरीएल र 120 जना आफन्तहरू।<verse eid="1CH 15:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 15:6"/>मरारीका सन्तानहरूबाट अगुवा असायाह र 220 जना आफन्तहरू।<verse eid="1CH 15:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 15:7"/>गेर्शोनका सन्तानहरूबाट, अगुवा योएल र 130 जना आफन्तहरू।<verse eid="1CH 15:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 15:8"/>एलीशापानका सन्तानहरूबाट अगुवा शमायाह र 200 जना आफन्तहरू।<verse eid="1CH 15:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 15:9"/>हेब्रोनका सन्तानहरूबाट अगुवा एलीएल र 80 जना आफन्तहरू।<verse eid="1CH 15:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 15:10"/>उज्जीएलका सन्तानहरूबाट अगुवा अम्मीनादाब र 112 जना आफन्तहरू।<verse eid="1CH 15:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 15:11"/>त्यसपछि दावीदले पुजारीहरू सादोक र अबीयाथारलाई, र लेवीहरूमा ऊरीएल, असायाह, योएल, शमायाह, एलीएल र अम्मीनादाबलाई बोलाए।<verse eid="1CH 15:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 15:12"/>तिनले उनीहरूलाई भने, “तपाईंहरू लेवी परिवारका अगुवाहरू हुनुहुन्छ; तपाईंहरू र तपाईंहरूका लेवी दाजुभाइहरूले आफूलाई पवित्र गर्नुहोस्, र याहवेह इस्राएलका परमेश्‍वरको सन्दुकका निम्ति मैले तयार गरेको ठाउँमा सन्दुकलाई ल्याउनुपर्छ।<verse eid="1CH 15:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 15:13"/>किनकि पहिलो पटक सन्दुक ल्याउँदा तपाईं लेवीहरूले नबोकेको कारणले नै याहवेह हाम्रा परमेश्‍वरको क्रोध हाम्रो विरुद्धमा परेको थियो। हामीले ठिक तरिकाले सन्दुकलाई कसरी ल्याउने हो भनी उहाँसित सल्‍लाह लिएनौँ।”<verse eid="1CH 15:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 15:14"/>यसकारण पुजारीहरू र लेवीहरूले याहवेह इस्राएलका परमेश्‍वरको सन्दुक ल्याउन आ-आफूलाई पवित्र गरे।<verse eid="1CH 15:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 15:15"/>अनि याहवेहले मोशालाई आज्ञा दिएअनुसार नै लेवीहरूले आफ्ना काँधमाथि डण्डाहरू राखेर परमेश्‍वरको सन्दुक बोके।<verse eid="1CH 15:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 15:16"/>दावीदले लेवीहरूका अगुवाहरूलाई सारङ्गी, वीणा र झ्यालीहरूले हर्षोल्‍लासका गीत गाउन तिनीहरूका आफन्तहरूलाई सङ्गीतकारहरू नियुक्त गर्नू भनी आज्ञा गरे।<verse eid="1CH 15:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 15:17"/>यसकारण लेवीहरूले योएलका छोरा हेमानलाई नियुक्त गरे। तिनका आफन्तहरूबाट बेरेक्याहका छोरा आसाप र तिनीहरूका मरारी आफन्तहरूबाट कूशायाहका छोरा एतानलाई नियुक्त गरे।<verse eid="1CH 15:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 15:18"/>अनि तिनीहरूसँगै दोस्रो दर्जामा तिनीहरूका आफन्तहरू, जकरिया, बेन, याजीएल, शमीरामोत, यहीएल, उन्‍नी, एलिआब, बनायाह, मासेयाह, मत्तीत्याह, एलीपेलेहू, मिक्नेयाह, र द्वारपालहरूमा ओबेद-एदोम र यीएललाई नियुक्त गरे।<verse eid="1CH 15:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 15:19"/>सङ्गीतकार हेमान, आसाप र एतानले काँसाको झ्याली बजाउनुपर्थ्यो।<verse eid="1CH 15:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 15:20"/>जकरिया, आजीएल, शमीरामोत, यहीएल, उन्‍नी एलिआब, मासेयाह र बनायाहले अलामोत,* अनुसार सारङ्गी बजाउनुपर्थ्यो।<verse eid="1CH 15:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 15:21"/>अनि मत्तीत्याह, एलीपेलेहू, मिक्नेयाह, ओबेद-एदोम, यीएल र अजज्याहले शेमीनीत,* अनुसारको निर्देशनमा वीणा बजाउनुपर्थ्यो।<verse eid="1CH 15:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 15:22"/>लेवीहरूका अगुवा कनन्याहचाहिँ भजन गाउने प्रमुख थिए। तिनको जिम्मेवारी गाउने थियो; किनकि तिनी गाउनमा निपुण थिए।<verse eid="1CH 15:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 15:23"/>बेरेक्याह र एल्काना सन्दुकका द्वारपालहरू थिए।<verse eid="1CH 15:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 15:24"/>शबन्याह, योशापात, नथनिएल, अमासै, जकरिया, बनायाह र एलीएजर पुजारीहरूले परमेश्‍वरको सन्दुकको अगाडि तुरही बजाउनुपर्थ्यो। ओबेद-एदोम र यहियाह पनि सन्दुकका निम्ति द्वारपाल खटाइएका थिए।<verse eid="1CH 15:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 15:25"/>यसकारण दावीद र इस्राएलका प्रधानहरू र हजार-हजार सैन्यदलका सेनापतिहरू ओबेद-एदोमको घरबाट हर्षोल्‍लासकासाथ याहवेहको करारको सन्दुक ल्याउन गए।<verse eid="1CH 15:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 15:26"/>याहवेहको सन्दुक बोकेका लेवीहरूलाई परमेश्‍वरले सहायता गर्नुभएको हुनाले, लेवीहरूले सात वटा गोरु र सात वटा भेडा बलि चढाए।<verse eid="1CH 15:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 15:27"/>अब दावीदले पनि सन्दुक बोक्ने सबै लेवीहरू, सङ्गीतकारहरू र गायन झुण्डका मुखिया कनायाहले जस्तै मलमलको वस्त्र लगाएका थिए। दावीदले मलमलको एपोद पनि लगाएका थिए।<verse eid="1CH 15:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 15:28"/>यसकारण सारा इस्राएलीहरूले भेडाको सिङ, तुरही, झ्याली, सारङ्गी र वीणा बजाउँदै जयजयकार गर्दै याहवेहको करारको सन्दुक ल्याए।<verse eid="1CH 15:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 15:29"/>याहवेहको करारको सन्दुक दावीदको सहरमा प्रवेश हुँदै गर्दा, शाऊलकी छोरी मीकलले झ्यालबाट हेरिन् र दावीद राजालाई नाच्दै र उत्सव मनाइरहेका देखिन्, तब तिनले मनमनै तिनलाई अपमान गरिन्।<verse eid="1CH 15:29"/></para>
<chapter eid="1CH 15"/>
<chapter number="16" style="c" sid="1CH 16"/>
<para style="p"><verse number="1" style="v" sid="1CH 16:1"/>तिनीहरूले परमेश्‍वरको सन्दुक ल्याए र दावीदले सन्दुकको निम्ति तयार पारेको विशेष पालभित्र त्यसलाई राखे। तिनीहरूले याहवेहको सामु होमबलि र मेलबलि चढाए।<verse eid="1CH 16:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 16:2"/>दावीदले होमबलि र मेलबलि चढाइसकेपछि, तिनले याहवेहको नाममा मानिसहरूलाई आशिष् दिए।<verse eid="1CH 16:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 16:3"/>त्यसपछि तिनले हरेक इस्राएली पुरुष र स्त्रीलाई एउटा रोटी, खजूरको डल्‍ला र किसमिसको झुप्पा दिए।<verse eid="1CH 16:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 16:4"/>दावीदले केही लेवीहरूलाई याहवेहको सन्दुकको सामु सेवा गर्न, याहवेह इस्राएलका परमेश्‍वरलाई आह्वान गर्न, धन्यवाद दिन र प्रशंसा गर्न नियुक्त गरे।<verse eid="1CH 16:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 16:5"/>आसापचाहिँ अगुवा थिए; दोस्रो दर्जामा जकरिया, त्यसपछि यीएल, शमीरामोत, यहीएल, मत्तीत्याह, एलिआब, बनायाह, ओबेद-एदोम र यीएल थिए। तिनीहरूले सारङ्गी र वीणा बजाउँथे। आसापले चाहिँ झ्याली बजाउँथे।<verse eid="1CH 16:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 16:6"/>अनि बनायाह र यहजीएल पुजारीहरूले नियमित रूपले परमेश्‍वरको करारको सन्दुकको सामु तुरहीहरू बजाउँथे।<verse eid="1CH 16:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 16:7"/>त्यस दिन पहिलो पटक दावीदले याहवेहलाई धन्यवादको भजन चढाउन आसाप र तिनका सहयोगीहरूलाई नियुक्त गरे:<verse eid="1CH 16:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 16:8"/>याहवेहलाई प्रशंसा देओ, उहाँको नामको घोषणा गर; जाति-जातिहरूमा उहाँले गर्नुभएका कार्यहरूको बयान गर।<verse eid="1CH 16:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 16:9"/>उहाँको निम्ति गाओ; उहाँको प्रशंसाको गीत गाओ! उहाँका सबै अद्‌भुत कार्यहरूको वर्णन गर!<verse eid="1CH 16:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 16:10"/>उहाँको पवित्र नाममा गर्व गर; याहवेहलाई खोज्नेहरूका हृदय आनन्दित होऊन्।<verse eid="1CH 16:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 16:11"/>याहवेह र उहाँको शक्तिलाई हेर; उहाँको मुहारको निरन्तर खोजी गर।<verse eid="1CH 16:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 16:12"/>उहाँले गर्नुभएका अद्‌भुत कार्यहरू स्मरण गर, उहाँका अचम्मका कामहरू, र उहाँले गर्नुभएका फैसलाको सम्झना गर!<verse eid="1CH 16:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 16:13"/>हे याहवेहका सेवक इस्राएलका सन्तान हो! हे याकोबका छोराहरू, उहाँद्वारा चुनिएकाहरू हो!<verse eid="1CH 16:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 16:14"/>उहाँ नै याहवेह हाम्रा परमेश्‍वर हुनुहुन्छ; उहाँका न्यायका कामहरू सारा पृथ्वीमा छ।<verse eid="1CH 16:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 16:15"/>परमेश्‍वरले आफ्नो करार सदासर्वदा सम्झनुहुन्छ, त्यो प्रतिज्ञा, जो उहाँले हजार पुस्ताहरूलाई दिनुभएको थियो;<verse eid="1CH 16:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 16:16"/>त्यो करार, जो उहाँले अब्राहामसँग बाँध्नुभएको थियो; अनि त्यो शपथ, जो उहाँले इसहाकसँग गर्नुभएको थियो,<verse eid="1CH 16:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 16:17"/>त्यो उहाँले याकोबसँग उर्दीको रूपमा, र इस्राएलसँग अनन्त करारको रूपमा पक्‍का गर्नुभयो:<verse eid="1CH 16:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 16:18"/>“म तँलाई कनान देश दिनेछु, त्यो पैतृक सम्पत्तिको रूपमा तेरो भाग हुनेछ।”<verse eid="1CH 16:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 16:19"/>जब तिनीहरू संख्यामा थोरै थिए, अति थोरै र त्यसमाथि पनि परदेशीहरू थिए।<verse eid="1CH 16:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 16:20"/>तिनीहरू एउटा राष्ट्रबाट अर्को राष्ट्रमा, अनि एउटा राज्यबाट अर्को राज्यमा भौतारिँदै हिँड्थे।<verse eid="1CH 16:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 16:21"/>उहाँले कसैलाई तिनीहरूमाथि अत्याचार गर्न दिनुभएन; तिनीहरूको खातिर उहाँले राजाहरूलाई यसरी हप्काउनुभयो:<verse eid="1CH 16:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 16:22"/>“मेरा अभिषिक्त जनहरूलाई नछोओ; मेरा अगमवक्ताहरूलाई केही हानि नगर!”<verse eid="1CH 16:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 16:23"/>हे सारा पृथ्वीका मानिस हो, याहवेहको निम्ति गाओ; दिन प्रतिदिनै उहाँले गर्नुभएको उद्धारको घोषणा गर।<verse eid="1CH 16:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 16:24"/>जाति-जातिहरूका बीच उहाँका महिमाको घोषणा गर! सारा मानिसहरूका बीचमा उहाँका अचम्मका कामहरूको वर्णन गर!<verse eid="1CH 16:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 16:25"/>किनकि याहवेह महान् हुनुहुन्छ, र अति उच्‍च प्रशंसाको योग्य हुनुहुन्छ; सारा देवहरूभन्दा उहाँको भय मान्‍नुपर्छ।<verse eid="1CH 16:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 16:26"/>किनकि जाति-जातिहरूका सबै देवहरू केवल मूर्तिहरू मात्र हुन्; तर याहवेहले त स्वर्गहरू सृष्‍टि गर्नुभयो।<verse eid="1CH 16:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 16:27"/>उहाँको सामु गौरव र वैभव छन्; उहाँको वासस्थानमा शक्ति र आनन्द छन्।<verse eid="1CH 16:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 16:28"/>हे जाति-जातिहरूका परिवार हो, याहवेहलाई जान, याहवेहलाई महिमा र शक्तिको प्रशंसा चढाओ।<verse eid="1CH 16:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 16:29"/>याहवेहलाई उहाँको नाम सुहाउँदो महिमा देओ; भेटी लिएर उहाँको सामु आओ। याहवेहलाई उहाँको पवित्रताको वैभवमा आराधना गर!<verse eid="1CH 16:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 16:30"/>हे सारा पृथ्वी, उहाँको सामु थरथर काँप्! संसार दृढतासाथ स्थापित भएको छ; यसकारण यो हल्‍लिन सक्दैन।<verse eid="1CH 16:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 16:31"/>स्वर्गहरूले आनन्द मनाऊन्, पृथ्वी हर्षित होस्! तिनीहरूले राष्ट्रहरूको बीचमा भनून्, “याहवेहले शासन गर्नुहुन्छ!”<verse eid="1CH 16:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 16:32"/>समुद्र र त्यसमा भएका हरेक प्राणीले जयजयकार गरून्! खेतहरू र त्यसमा भएका हरेक थोक हर्षित होऊन्!<verse eid="1CH 16:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 16:33"/>तब वनका रूखहरूले गाऊन्, तिनीहरूले याहवेहको सामु आनन्दले गाऊन्; किनकि उहाँ संसारको न्याय गर्न आउनुहुन्छ।<verse eid="1CH 16:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 16:34"/>याहवेहलाई धन्यवाद देओ; किनकि उहाँ भलो हुनुहुन्छ; उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।<verse eid="1CH 16:34"/></para>
<para style="p"><verse number="35" style="v" sid="1CH 16:35"/>यसो भनेर कराओ, “हे हाम्रा उद्धारकर्ता परमेश्‍वर, हामीलाई बचाउनुहोस्; हामीलाई एक ठाउँमा भेला गर्नुहोस्, र हामीलाई अन्य राष्ट्रहरूबाट छुटकारा दिनुहोस्; ताकि हामी तपाईंको पवित्र नामलाई धन्यवाद दिन सकौँ, र तपाईंको प्रशंसामा गर्व गर्न सकौँ!”<verse eid="1CH 16:35"/></para>
<para style="p"><verse number="36" style="v" sid="1CH 16:36"/>याहवेह, इस्राएलका परमेश्‍वरलाई सदासर्वदा प्रशंसा होइरहोस्! तब सबै मानिसहरूले भने, “आमेन” र “याहवेहको प्रशंसा होस्।”<verse eid="1CH 16:36"/></para>
<para style="p"><verse number="37" style="v" sid="1CH 16:37"/>त्यसपछि दावीदले आसाप र तिनका सहयोगीहरूलाई विधिअनुसार हरेक दिन याहवेहको करारको सन्दुकको सामु नियमित रूपले गर्नुपर्ने सेवा गर्नलाई खटाए।<verse eid="1CH 16:37"/></para>
<para style="p"><verse number="38" style="v" sid="1CH 16:38"/>तिनले यदूतूनका छोरा ओबेद-एदोम र तिनका अठसट्ठी जना सहयोगीहरूलाई पनि तिनीहरूसँग सेवा गर्नलाई खटाए। ओबेद-एदोम र होसा द्वारपालहरू पनि थिए।<verse eid="1CH 16:38"/></para>
<para style="p"><verse number="39" style="v" sid="1CH 16:39"/>दावीदले पुजारी सादोक र तिनका अरू सङ्गी पुजारीहरूलाई गिबोनको अग्लो ठाउँमा याहवेहको समागम पालमा<verse eid="1CH 16:39"/></para>
<para style="p"><verse number="40" style="v" sid="1CH 16:40"/>याहवेहले इस्राएलीहरूलाई दिनुभएको व्यवस्थामा लेखिएबमोजिम, बिहान र बेलुकी याहवेहका निम्ति होमबलिको वेदीमा निरन्तर होमबलि चढाउन खटाए।<verse eid="1CH 16:40"/></para>
<para style="p"><verse number="41" style="v" sid="1CH 16:41"/>तिनीहरूसँग हेमान, यदूतून र याहवेहलाई धन्यवाद दिनलाई नामद्वारा चुनिएका र नियुक्त गरिएका अरू बाँकी जनहरू थिए, “किनभने उहाँको प्रेम सदासर्वदा रहिरहन्छ।”<verse eid="1CH 16:41"/></para>
<para style="p"><verse number="42" style="v" sid="1CH 16:42"/>हेमान र यदूतूनचाहिँ पवित्र भजनको निम्ति तुरही फुक्ने, झ्याली बजाउने र अरू बाजाहरू बजाउन जिम्मेवार थिए।<verse eid="1CH 16:42"/></para>
<para style="p"><verse number="43" style="v" sid="1CH 16:43"/>त्यसपछि बाँकी सबै मानिसहरू आ-आफ्ना घरतिर लागे; अनि दावीदचाहिँ आफ्नो परिवारलाई आशिष् दिन घर फर्के।<verse eid="1CH 16:43"/></para>
<chapter eid="1CH 16"/>
<chapter number="17" style="c" sid="1CH 17"/>
<para style="p"><verse number="1" style="v" sid="1CH 17:1"/>दावीद आफ्नो महलमा सरिसकेपछि तिनले अगमवक्ता नातानलाई भने, “यहाँ म देवदारुको महलमा बसिरहेको छु, तर याहवेहको करारको सन्दुकचाहिँ पालमा छ।”<verse eid="1CH 17:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 17:2"/>नातानले दावीदलाई जवाफ दिए, “तपाईंको मनमा जे छ, त्यो गर्नुहोस्; किनकि परमेश्‍वर तपाईंसँग हुनुहुन्छ।”<verse eid="1CH 17:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 17:3"/>तर त्यस रात परमेश्‍वरको यो वचन नातानकहाँ आयो:<verse eid="1CH 17:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 17:4"/>“जा, र मेरो सेवक दावीदलाई भन्, ‘याहवेह यसो भन्‍नुहुन्छ, मेरो वासस्थानको भवन बनाउने व्यक्ति तँ होइनस्।<verse eid="1CH 17:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 17:5"/>मैले इस्राएललाई इजिप्टबाट ल्याएको समयदेखि आजको दिनसम्म म कुनै भवनमा बसेको छैनँ। म एउटा पालदेखि अर्को पाल र एउटा वासस्थानदेखि अर्को वासस्थानमा सर्दैआएको छु।<verse eid="1CH 17:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 17:6"/>म इस्राएलीहरूसँग जहाँ-जहाँ गएँ, के मेरा प्रजा इस्राएलीहरूका गोठाला हुने आज्ञा दिएका तिनीहरूका अगुवाहरूमध्ये कसैलाई कहिल्यै भनेको छु, “तिमीहरूले मेरा निम्ति देवदारुको घर किन बनाएनौ?” ’<verse eid="1CH 17:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 17:7"/>“यसकारण अब मेरो सेवक दावीदलाई भन्, “सेनाहरूका याहवेह यसो भन्‍नुहुन्छ: मैले तँलाई भेडाको गोठबाट बगाललाई चराउने कामबाट ल्याएँ; र मेरा जाति इस्राएलमाथि शासक नियुक्त गरेँ।<verse eid="1CH 17:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 17:8"/>तँ जहाँ-जहाँ गइस्, म तेरो साथमा रहेँ, र मैले तेरा सारा शत्रुहरूलाई तेरो सामुबाट नष्‍ट गरिदिएको छु। अब म तेरो नामलाई संसारका अति महान् मानिसहरूका नामहरूझैँ बनाउनेछु।<verse eid="1CH 17:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 17:9"/>अनि म मेरो जाति इस्राएलको निम्ति एउटा ठाउँ तयार गर्नेछु; अनि तिनीहरूलाई बसाल्नेछु, ताकि तिनीहरूका निम्ति आफ्नै बस्‍ने घर होस्; ताकि अब उप्रान्त तिनीहरू विचलित नहुन्। दुष्‍ट जातिहरूले तिनीहरूलाई फेरि सताउने छैनन्, जसरी विगतमा तिनीहरूले गरेका थिए,<verse eid="1CH 17:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 17:10"/>मैले आफ्नो जाति इस्राएलमाथि अगुवाहरू नियुक्त गरेको समयदेखि सताउँदैआएका थिए। म तेरा सबै शत्रुहरूलाई तेरो अधीनमा पार्नेछु। “ ‘म तँलाई भन्दछु, याहवेह आफैँले तेरो निम्ति एउटा घर निर्माण गर्नुहुनेछ:<verse eid="1CH 17:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 17:11"/>जब तेरो दिन पूरा हुनेछ, र तँ आफ्ना पुर्खाहरूसित मिल्नलाई जान्छस्, तब म तेरो सन्तानलाई तँपछि तेरो ठाउँमा खडा गर्नेछु, अर्थात् म तेरा छोराहरूमध्ये एक जनाको राज्य स्थापित गर्नेछु।<verse eid="1CH 17:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 17:12"/>त्यसले नै मेरो निम्ति एउटा भवन बनाउनेछ; म त्यसको सिंहासन सदाका निम्ति स्थापित गर्नेछु।<verse eid="1CH 17:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 17:13"/>म त्यसको पिता हुनेछु, र त्यो मेरो छोरो हुनेछ। मैले शाऊलबाट आफ्नो अचुक प्रेम हटाएझैँ, म त्यसबाट आफ्नो अचुक प्रेम कहिल्यै हटाउनेछैन।<verse eid="1CH 17:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 17:14"/>म त्यसलाई सदाका निम्ति मेरो भवन र मेरो राज्यमा स्थिर गर्नेछु, र त्यसको सिंहासन सदासर्वदा स्थिर रहनेछ।’ ”<verse eid="1CH 17:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 17:15"/>नातानले यी सम्पूर्ण दर्शनका कुराहरू दावीदलाई सुनाइदिए।<verse eid="1CH 17:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 17:16"/>त्यसपछि राजा दावीद भित्र गएर याहवेहको सामु बसे, र तिनले भने: “हे याहवेह परमेश्‍वर, म को हुँ र? मेरो परिवार के हो र, तपाईंले मलाई यहाँसम्म ल्याउनुभएको छ?<verse eid="1CH 17:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 17:17"/>हे परमेश्‍वर, यो पनि तपाईंको दृष्‍टिमा कम भएझैँ, तपाईंले आफ्नो सेवकको घरको भविष्यको बारेमा भन्‍नुभएको छ। हे याहवेह परमेश्‍वर, तपाईंले मलाई एक अति उच्‍च प्रसिद्ध मानिसझैँ मसँग व्यवहार गर्नुभएको छ।<verse eid="1CH 17:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 17:18"/>“तपाईंले आफ्नो सेवकलाई सम्मान दिनुभएकोमा दावीदले अझ बढी के भन्‍न सक्छ र? किनकि तपाईं आफ्नो सेवकलाई जान्‍नुहुन्छ।<verse eid="1CH 17:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 17:19"/>हे याहवेह, आफ्नो सेवकको खातिर र तपाईंको इच्छाअनुसार तपाईंले यो महान् काम गर्नुभएको छ। अनि तपाईंले यी सबै महान् प्रतिज्ञाहरू जान्‍न दिनुभएको छ।<verse eid="1CH 17:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 17:20"/>“हे याहवेह, तपाईंजस्तो अरू कोही छैन; र हामीले आफ्नै कानले सुनेझैँ तपाईंबाहेक अर्को परमेश्‍वर छैन।<verse eid="1CH 17:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 17:21"/>तपाईंको प्रजा इस्राएलजस्तो अरू कुन जाति छ र? पृथ्वीमा भएको एउटा यस्तो जाति, जसका परमेश्‍वरले तिनीहरूलाई आफ्नो जाति बनाउन आफैँ गएर दासत्वबाट छुटाउनुभयो। तपाईंले त्यो जातिलाई इजिप्टबाट छुटकारा दिलाएर, आफ्नो महान् नाम बनाउनुभयो। तपाईंका जातिको सामुबाट अरू जातिहरूलाई धपाएर तपाईंले महान् र अद्‌भुत कार्यहरू गर्नुभयो।<verse eid="1CH 17:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 17:22"/>तपाईंले आफ्नो जाति इस्राएललाई सदाका निम्ति आफ्नै निजी प्रजा बनाउनुभयो; अनि हे याहवेह, तपाईं तिनीहरूका परमेश्‍वर हुनुभएको छ।<verse eid="1CH 17:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 17:23"/>“यसकारण अब हे याहवेह, तपाईंले आफ्नो सेवक र उसको घरानाको बारेमा गर्नुभएको प्रतिज्ञा, तपाईंले प्रतिज्ञा गर्नुभएझैँ, सदाको निम्ति कायम गर्नुहोस्।<verse eid="1CH 17:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 17:24"/>ताकि त्यो प्रतिज्ञा कायम रहोस्, र तपाईंको नाम सदाका निम्ति महान् होस्। तब मानिसहरूले भन्‍नेछन्, ‘सेनाहरूका याहवेह, इस्राएलमाथिका परमेश्‍वर नै, इस्राएलका परमेश्‍वर हुनुहुन्छ!’ अनि तपाईंको सेवक दावीदको घराना तपाईंको सामु स्थापित हुनेछ।<verse eid="1CH 17:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 17:25"/>“हे मेरा परमेश्‍वर, तपाईंले आफ्नो सेवकलाई उसको निम्ति एउटा घर बनाइदिनुहुनेछ भनी तपाईंले प्रकट गर्नुभएको छ। त्यसैले तपाईंको सेवकले तपाईंलाई प्रार्थना गर्ने हिम्मत गरेको छु।<verse eid="1CH 17:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 17:26"/>हे याहवेह, तपाईं नै परमेश्‍वर हुनुहुन्छ! तपाईंले आफ्नो सेवकलाई यी असल कुराहरू प्रतिज्ञा गर्नुभएको छ।<verse eid="1CH 17:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 17:27"/>अहिले तपाईं आफ्नो सेवकको घरलाई आशिष् दिन प्रसन्‍न हुनुभएको छ; ताकि यो तपाईंको दृष्‍टिमा सदा बनिरहोस्; किनभने, हे याहवेह, तपाईंले नै आशिष् दिनुभएको छ; यसकारण यो सदाका लागि आशिषित रहनेछ।”<verse eid="1CH 17:27"/></para>
<chapter eid="1CH 17"/>
<chapter number="18" style="c" sid="1CH 18"/>
<para style="p"><verse number="1" style="v" sid="1CH 18:1"/>केही समयपछि, दावीदले पलिश्तीहरूलाई परास्त गरे, र तिनीहरूलाई आफ्नो अधीनमा पारे; अनि तिनले पलिश्तीहरूको अधीनमा रहेका गात र त्यसका चारैतिरका गाउँहरूलाई पनि लिए।<verse eid="1CH 18:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 18:2"/>दावीदले मोआबीहरूलाई पनि परास्त गरे; अनि तिनीहरू तिनको अधीनमा भएर तिनलाई राजकर तिरे।<verse eid="1CH 18:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 18:3"/>यसबाहेक दावीदले सोबाका राजा हददेजेर यूफ्रेटिस नदीको किनारमा आफ्नो विजयको स्मारक खडा गर्न जाँदा तिनलाई हमातसम्मै जिते।<verse eid="1CH 18:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 18:4"/>दावीदले तिनका एक हजार रथ, सात हजार घोडचढीहरू र बीस हजार पैदल सेनाहरूलाई कैद गरे। तिनले एक सय घोडाबाहेक अरू सबै रथका घोडाहरूका खुट्टाका मूलनसा काटिदिए।<verse eid="1CH 18:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 18:5"/>जब सोबाका राजा हददेजेरलाई सघाउन दमस्कसका अरामीहरू आए, तब दावीदले तिनीहरूका बाइस हजार मानिसहरूलाई मारे।<verse eid="1CH 18:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 18:6"/>तिनले दमस्कसका अरामी सैनिकका बीच मोर्चा बसाले; अनि अरामीहरू तिनका अधीनमा भएर तिनलाई सलामी ल्याए। दावीद जहाँ गए तापनि याहवेहले तिनलाई विजय दिनुभयो।<verse eid="1CH 18:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 18:7"/>दावीदले हददेजेरका अधिकारीहरूले बोकेका सुनका ढालहरू लिए, र ती यरूशलेममा ल्याए।<verse eid="1CH 18:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 18:8"/>दावीदले हददेजेरका सहरहरू तेबाह र कूनबाट धेरै मात्रामा काँसा ल्याए, जसलाई सोलोमनले काँसाका खड्कुँलो, खम्बाहरू र काँसाका विभिन्‍न चीजहरू बनाउनमा प्रयोग गरे।<verse eid="1CH 18:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 18:9"/>जब हमातका राजा तोऊले सोबाका राजा हददेजेरका सम्पूर्ण सेनालाई दावीदले परास्त गरेको कुरा सुने,<verse eid="1CH 18:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 18:10"/>तब तिनले आफ्नो छोरा हदोरामलाई दावीदले हददेजेरमाथि विजय पाएकोमा दावीदलाई बधाई दिन भनी पठाए; किनभने हददेजेर तोऊसँग युद्ध लडिरहेका थिए। हदोरामले सबै प्रकारका सुन, चाँदी र काँसाका चीजहरू दावीद राजाकहाँ ल्याए।<verse eid="1CH 18:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 18:11"/>दावीद राजाले ती चीजहरू याहवेहलाई समर्पण गरे। तिनले यी सबै जातिहरू: एदोमीहरू, मोआबीहरू, अम्मोनीहरू, पलिश्तीहरू र अमालेकीहरूबाट लिएका सुन र चाँदीलाई याहवेहकहाँ अर्पण गरे।<verse eid="1CH 18:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 18:12"/>सरूयाहका छोरा अबीशैले नुनको बेँसीमा अठार हजार एदोमीहरूलाई मारे।<verse eid="1CH 18:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 18:13"/>तिनले एदोममा सैन्य छाउनीहरू बनाए; र सारा एदोमीहरू दावीदको अधीनमा भए। दावीद जहाँ-जहाँ गए, याहवेहले तिनलाई विजय दिनुभयो।<verse eid="1CH 18:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 18:14"/>दावीदले आफ्ना सबै मानिसहरूका निम्ति जे न्यायसङ्गत र जे ठिक थियो, त्यही गर्दै सम्पूर्ण इस्राएलमाथि राज्य गरे।<verse eid="1CH 18:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 18:15"/>सरूयाहका छोरा योआब सेनाहरूका सेनापति थिए; अहीलूदका छोरा यहोशापात लेखापाल थिए;<verse eid="1CH 18:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 18:16"/>अहीतूबका छोरा सादोक र अबीयाथारका छोरा अहीमेलेक पुजारीहरू थिए; शब्शा सचिव थिए;<verse eid="1CH 18:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 18:17"/>बनायाह यहोयादाका छोराचाहिँ करेतीहरू र पेलेथीहरूका प्रमुख थिए; अनि दावीदका छोराहरूचाहिँ राजाका मुख्य अधिकृतहरू थिए।<verse eid="1CH 18:17"/></para>
<chapter eid="1CH 18"/>
<chapter number="19" style="c" sid="1CH 19"/>
<para style="p"><verse number="1" style="v" sid="1CH 19:1"/>केही समयपछि, अम्मोनीहरूका राजा नाहाशको मृत्यु भयो, र तिनीपछि तिनका छोरा राजा भए।<verse eid="1CH 19:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 19:2"/>दावीदले सोचे, “तिनका बुबा नाहाशले मप्रति दया देखाएकाले, म पनि तिनको छोरा हानूनप्रति दया देखाउनेछु।” यसकारण दावीदले हानूनप्रति तिनका पिताको विषयमा सहानुभूति देखाउनलाई दूतहरू पठाए। जब दावीदका मानिसहरू अम्मोनीहरूको देशमा हानूनकहाँ तिनलाई सहानुभूति देखाउन आए,<verse eid="1CH 19:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 19:3"/>तब अम्मोनी भारदारहरूले हानूनलाई भने, “के तपाईं दावीदले तपाईंकहाँ सहानुभूति दर्शाउन मानिसहरू पठाएर तपाईंका पितालाई सम्मान दिइरहेका छन् भनी ठान्‍नुहुन्छ? होइन, तिनका मानिसहरू यस देशको भेद लिन र यस देशलाई परास्त गर्नलाई तपाईंकहाँ आएका हुन्।”<verse eid="1CH 19:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 19:4"/>यसकारण हानूनले दावीदका राजदूतहरूलाई पक्रे, तिनीहरूका दाह्री खौरिदिए, तिनीहरूका लुगा जाँघसम्म काटिदिए; र तिनीहरूलाई पठाइदिए।<verse eid="1CH 19:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 19:5"/>जब कसैले आएर दावीदलाई ती मानिसहरूको बारेमा भनिदिए, तब तिनले उनीहरूलाई भेट्न दूतहरू पठाए; किनकि तिनीहरूको ठूलो अपमान भएको थियो। राजाले भने, “तिमीहरूका फेरि दाह्री नबढुन्जेल यरीहोमै बस्‍नू, त्यसपछि मात्र फर्कनू।”<verse eid="1CH 19:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 19:6"/>जब अम्मोनीहरूले आफूहरू दावीदको दृष्‍टिमा घृणित भएको थाहा पाए, तब हानून र अम्मोनीहरूले अराम-नहरैम, अराम-माका र सोबाबाट रथहरू र घोडचढीहरू भाडामा लिनलाई एक हजार टालेन्ट चाँदी पठाए।<verse eid="1CH 19:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 19:7"/>तिनीहरूले बत्तीस हजार रथहरू र घोडचढीहरू, साथै माकाका राजालाई तिनका सेनासँगै भाडामा लिए, जसले आएर मेदेबा सहरको छेउमा छाउनी हाले। अम्मोनीहरू चाहिँ तिनीहरूका सहरहरूबाट भेला भएर लडाइँको निम्ति निस्किए।<verse eid="1CH 19:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 19:8"/>यो कुरा सुनेर दावीदले योआबसँग सम्पूर्ण लडाकु सेनाहरूलाई पठाए।<verse eid="1CH 19:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 19:9"/>अम्मोनीहरू आएर सहर जाने मूलढोकामा लडाइँको निम्ति तैनाथ भए; अनि तिनीहरूसित आएका अरू राजाहरूचाहिँ खुला मैदानमा लडाइँको निम्ति आफ्नो स्थान लिए।<verse eid="1CH 19:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 19:10"/>योआबले आफ्नो अगि र पछि युद्धका मोर्चाहरू खडा भएका देखे; यसकारण तिनले इस्राएलका सबैभन्दा उत्तम सेनाहरूलाई चुने, र तिनीहरूलाई अरामीहरूको विरुद्धमा खटाए।<verse eid="1CH 19:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 19:11"/>तिनले बाँकी रहेका सेनाहरूलाई आफ्ना भाइ अबीशैको अधीनमा दिए; अनि तिनीहरूलाई अम्मोनीहरूको विरुद्धमा खटाए।<verse eid="1CH 19:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 19:12"/>योआबले भने, “यदि अरामी सेनाहरूले मलाई जित्दै गए भने तिमीहरू मलाई बचाउन आउनू। तर यदि अम्मोनीहरूले तिमीहरूलाई जित्दै गए भने म तिमीहरूलाई बचाउनेछु।<verse eid="1CH 19:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 19:13"/>साहसी होऊ, र हाम्रा मानिसहरू र हाम्रा परमेश्‍वरका सहरहरूको निम्ति हिम्मतका साथ युद्ध गरौँ। याहवेहले आफ्नो दृष्‍टिमा जे असल छ, त्यो गर्नुहुनेछ।”<verse eid="1CH 19:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 19:14"/>तब योआब र तिनीसँग भएका सैन्यदल अरामीहरूसँग युद्ध गर्न अगि बढे; अनि अरामीहरू तिनीहरूको सामुबाट भागे।<verse eid="1CH 19:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 19:15"/>जब अम्मोनीहरूले अरामीहरू भागेका देखे, तब तिनीहरू पनि तिनका भाइ अबीशै र तिनका सेनाहरूको सामुबाट भागेर सहरभित्र पसे। त्यसपछि योआब यरूशलेममा फर्केर गए।<verse eid="1CH 19:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 19:16"/>जब अरामीहरूले आफूलाई इस्राएलद्वारा परास्त गरिएको देखे, तब तिनीहरूले दूतहरू पठाएर अरू अरामी सेनाहरूलाई यूफ्रेटिस नदी पारिबाट झिकाए। त्यसको नेतृत्वचाहिँ हददेजेरको सेनाको सेनापति शोपकले गरिरहेका थिए।<verse eid="1CH 19:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 19:17"/>जब यो कुरा दावीदलाई भनियो, तब तिनले सारा इस्राएललाई भेला गराएर यर्दन नदी तरे; दावीद उनीहरूको विरुद्धमा अगि बढे, र तिनीहरूको विरुद्धमा युद्धको मोर्चा बाँधे। दावीदले अरामीहरूसँग युद्ध गर्नलाई आफ्नो पङ्‌क्ति बाँधे, र तिनीहरूले दावीदको विरुद्धमा युद्ध गरे।<verse eid="1CH 19:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 19:18"/>तर अरामीहरू इस्राएलको सामुबाट भागे; अनि दावीदले तिनीहरूका सात हजार रथ-सवारहरू र चालीस हजार पैदल सेनाहरूलाई मारे। दावीदले तिनीहरूका सेनाका सेनापति शोपकलाई पनि मारे।<verse eid="1CH 19:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 19:19"/>जब हददेजेरका अधिकारीहरूले आफूहरू इस्राएलद्वारा परास्त भएको देखे, तब तिनीहरूले दावीदसँग सन्धि गरेर तिनका अधीनमा बसे। यसकारण अरामीहरूले अम्मोनीहरूलाई फेरि सहायता गर्नलाई राजी भएनन्।<verse eid="1CH 19:19"/></para>
<chapter eid="1CH 19"/>
<chapter number="20" style="c" sid="1CH 20"/>
<para style="p"><verse number="1" style="v" sid="1CH 20:1"/>बसन्त ऋतुमा जब राजाहरू युद्ध गर्न निस्कन्थे, तब योआबले हतियारधारी दलहरूको नेतृत्व गरे। तिनले अम्मोनीहरूको देशलाई सखाप पारे। अनि रब्बा सहरमा गए, र त्यस सहरलाई घेरा हाले; तर दावीदचाहिँ यरूशलेममै बसे। योआबले रब्बामाथि आक्रमण गरेर त्यसलाई ध्वस्त पारे।<verse eid="1CH 20:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 20:2"/>दावीदले तिनीहरूका राजा मिल्कोमको शिरबाट मुकुट लिए, जसको तौल एक टालेन्ट सुन थियो, र त्यसमा बहुमूल्य पत्थरहरू जडिएका थिए; अनि त्यो मुकुट दावीदको शिरमा लगाइयो। तिनले त्यस सहरबाट धेरै मात्रामा लुटका मालसामानहरू ल्याए,<verse eid="1CH 20:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 20:3"/>अनि त्यहाँ भएका मानिसहरूलाई निकालेर ल्याए; तिनीहरूलाई आरा, फलामका हतियारहरू र बन्चरोका कामहरू गर्न लगाए। दावीदले अम्मोनीहरूका सबै नगरहरूसित यस्तै गरे। तब दावीद र तिनका सम्पूर्ण सेना यरूशलेममा फर्के।<verse eid="1CH 20:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 20:4"/>त्यसपछि गेजेरमा पलिश्तीहरूसँग लडाइँ भयो। त्यस बेला हूशातीमा बस्‍ने सिब्बकैले रपाईहरूको एउटा सन्तान सिप्पैलाई मारे, जसले गर्दा पलिश्तीहरू अधीनमा आए।<verse eid="1CH 20:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 20:5"/>पलिश्तीहरूसँगको अर्को एउटा लडाइँमा याईरका छोरा एल्हानानले गित्ती गोल्यतको भाइ लहमीलाई मारे, जसको भालाको बिँड कपडा बुन्‍ने तानको डण्डाजस्तै थियो।<verse eid="1CH 20:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 20:6"/>गातमा अझ अर्को लडाइँ भयो। त्यहाँ दुवै हातमा छ-छ वटा औँलाहरू र दुवै खुट्टामा छ-छ वटा औँलाहरू भएको, जम्मा चौबीस वटा औँलाहरू भएको भयङ्कर मानिस थियो। त्यो मानिस पनि रफाको सन्तान नै थियो।<verse eid="1CH 20:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 20:7"/>जब त्यसले इस्राएललाई खिसी गर्‍यो, तब दावीदका दाजु शिमेअका छोरा जोनाथनले त्यसलाई मारे।<verse eid="1CH 20:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 20:8"/>यिनीहरू गातमा भएका रफाका सन्तानहरू थिए। तिनीहरू दावीद र तिनका सेनाहरूका हातबाट मारिए।<verse eid="1CH 20:8"/></para>
<chapter eid="1CH 20"/>
<chapter number="21" style="c" sid="1CH 21"/>
<para style="p"><verse number="1" style="v" sid="1CH 21:1"/>शैतान इस्राएलको विरुद्धमा उठ्यो र दावीदलाई इस्राएलको जनगणना गर्न सुर्‍यायो।<verse eid="1CH 21:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 21:2"/>यसकारण दावीदले योआब र सैन्यदलका सेनापतिहरूलाई भने, “जाओ, गएर बेर्शेबादेखि दानसम्मै इस्राएलीहरूको गन्ती गर; अनि आएर मलाई बताऊनू; ताकि म तिनीहरूका संख्या कति रहेछन्, म त्यो थाहा पाउन सकूँ।”<verse eid="1CH 21:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 21:3"/>तर योआबले जवाफ दिए, “याहवेहले उहाँको फौजलाई सय गुणा बढाऊन्। मेरा मालिक महाराजा, के तिनीहरू सबै मेरा मालिककै सेवकहरू होइनन् र? मेरा मालिकले किन यसो गर्न चाहनुहुन्छ? किन हजुरले इस्राएलमाथि दोष ल्याउनुहुन्छ?”<verse eid="1CH 21:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 21:4"/>तर राजाको वचनले योआबको कुरालाई रद्द गरिदियो। यसकारण योआब त्यहाँबाट निस्केर गए; र पूरा इस्राएलभरि घुमे। त्यसपछि यरूशलेममा फर्केर आए।<verse eid="1CH 21:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 21:5"/>योआबले दावीदलाई लडाकु मानिसहरूको संख्या बताइदिए: अनि सारा इस्राएलमा तरवार चलाउन सक्ने एघार लाख र यहूदामा चार लाख सत्तरी हजार मानिसहरू थिए।<verse eid="1CH 21:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 21:6"/>तर योआबले लेवी र बेन्यामीनलाई त्यस गणनामा सामेल गराएनन्; किनकि तिनलाई राजाको आदेश घृणित लागेको थियो।<verse eid="1CH 21:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 21:7"/>यो आदेश परमेश्‍वरको दृष्‍टिमा पनि दुष्‍ट काम थियो; यसकारण उहाँले इस्राएललाई दण्ड दिनुभयो।<verse eid="1CH 21:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 21:8"/>तब दावीदले परमेश्‍वरलाई भने, “मैले यो काम गरेर ठूलो पाप गरेको छु। अब म तपाईंलाई बिन्ती गर्दछु, आफ्नो सेवकको दोष क्षमा गरिदिनुहोस्, किनकि मैले ठूलो मूर्ख काम गरेको छु।”<verse eid="1CH 21:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 21:9"/>याहवेहले दावीदका भविष्यवक्ता गादलाई भन्‍नुभयो,<verse eid="1CH 21:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 21:10"/>“जा, गएर दावीदलाई भन्, ‘याहवेह यसो भन्‍नुहुन्छ, म तँलाई तीन वटा कुरा छान्‍न दिनेछु; तीमध्ये मैले तेरो विरुद्धमा लागू गराउने एउटा कुरा रोज्।’ ”<verse eid="1CH 21:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 21:11"/>यसकारण गाद गएर दावीदलाई भने, “याहवेह यसो भन्‍नुहुन्छ, ‘तैँले यीमध्ये एउटा चुन्:<verse eid="1CH 21:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 21:12"/>तीन वर्षको अनिकाल, अथवा तीन महिनासम्म तेरा शत्रुहरूका तरवारद्वारा विनाश भइरहनु, अथवा तीन दिनसम्म देशमा याहवेहको आफ्नो तरवारद्वारा विपत्ति ल्याइनु, अथवा याहवेहको दूतद्वारा इस्राएलका हरेक ठाउँमा विनाश आइलाग्नु।’ अब मैले आफूलाई पठाउनुहुनेकहाँ के जवाफ दिने, त्यो निर्णय दिनुहोस्।”<verse eid="1CH 21:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 21:13"/>दावीदले गादलाई भने, “म ठूलो सङ्कष्‍टमा परेको छु। मलाई याहवेहको हातमा पर्न दिनुहोस्; किनकि उहाँको कृपा महान् छ; तर मलाई मानिसको हातमा पर्न नदिनुहोस्।”<verse eid="1CH 21:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 21:14"/>यसकारण याहवेहले इस्राएलमा एउटा विपत्ति पठाउनुभयो, र इस्राएलमा सत्तरी हजार मानिसहरू मरे।<verse eid="1CH 21:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 21:15"/>परमेश्‍वरले यरूशलेमलाई नाश गर्नलाई एक जना दूत पठाउनुभयो। तर त्यस दूतले नष्‍ट गरिरहेको बेला याहवेहले देख्नुभयो, र त्यस विपत्तिको कारण उहाँ दुःखी हुनुभयो; अनि मानिसहरूलाई नाश गरिरहेका दूतलाई भन्‍नुभयो, “भयो, अब आफ्नो हात रोक।” त्यस बेला याहवेहका दूत यबूसी अरौनाको खलामा उभिरहेका थिए।<verse eid="1CH 21:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 21:16"/>दावीदले आफ्ना आँखा मास्तिर उठाउँदा याहवेहका ती दूतले हातमा थुतेको नाङ्गो तरवार यरूशलेममाथि पसारेर स्वर्ग र पृथ्वीको बीचमा उभिरहेका देखे। तब दावीद र प्रधानहरू भाङ्ग्रा लगाएर भुइँतिर घोप्टो परे।<verse eid="1CH 21:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 21:17"/>दावीदले परमेश्‍वरलाई भने, “के लडाकु मानिसहरूको गन्ती लिनु भनेर आदेश दिने म होइन र? म गोठालोले पाप गरेको हुँ, र मैले नै गलत काम गरेको हुँ। यिनीहरू त भेडाहरू मात्र हुन्। यिनीहरूले के गरेका छन् र? हे याहवेह मेरा परमेश्‍वर, तपाईंका हातका विपत्ति म र मेरा परिवारमाथि परोस्, तर यो विपत्ति तपाईंका मानिसहरूमाथि नपरोस्।”<verse eid="1CH 21:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 21:18"/>त्यसपछि याहवेहका दूतले गादलाई यसो भन्‍ने आज्ञा दिए, दावीद यबूसी अरौनाको खलामा जाओस् र याहवेहका निम्ति एउटा वेदी बनाओस्।<verse eid="1CH 21:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 21:19"/>यसकारण गादले याहवेहको नाममा भनेका कुरा पालन गरेर दावीद माथि उक्लेर गए।<verse eid="1CH 21:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 21:20"/>त्यस बेला अरौनाचाहिँ गहुँ कुटिरहेका थिए। तब तिनी फनक्‍क फर्के, र दूतलाई देखे; तिनीसँग भएका तिनका चार जना छोराहरूचाहिँ लुके।<verse eid="1CH 21:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 21:21"/>जब दावीद अरौनाकहाँ गए, तब अरौनाले तिनलाई आइरहेको देखे। तिनी खला छोडेर गए, र तिनको सामु भुइँतिर घोप्टो परेर दण्डवत् गरे।<verse eid="1CH 21:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 21:22"/>दावीदले तिनलाई भने, “मलाई तिम्रो खलामा ठाउँ देऊ, ताकि म याहवेहका निम्ति एउटा वेदी बनाउन सकूँ, र मेरा मानिसहरूमाथि आएको विपत्ति थामियोस्। मलाई पूरा दाममा खला बेच।”<verse eid="1CH 21:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 21:23"/>अरौनाले दावीदलाई भने, “हजुरले यो खला लिनुहोस्! अनि मेरा मालिक राजालाई जे असल लाग्छ, त्यही गर्नुहोस्। म होमबलिहरूका निम्ति गोरुहरू, दाउराका निम्ति दाइँ गर्ने काठहरू, र अन्‍नबलिको निम्ति गहुँ दिनेछु; म यी सबै चीजहरू दिनेछु।”<verse eid="1CH 21:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 21:24"/>तर राजा दावीदले अरौनालाई जवाफ दिए, “होइन, म पूरा मूल्य दिनेछु; म याहवेहका निम्ति तिम्रो कुनै पनि चीज, अर्थात् बलिदानका निम्ति होमबलिहरू सित्तैँमा लिनेछैनँ।”<verse eid="1CH 21:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 21:25"/>यसकारण दावीदले अरौनालाई त्यस खलाका निम्ति छ सय सेकेल सुन दिए।<verse eid="1CH 21:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 21:26"/>त्यहाँ दावीदले याहवेहका निम्ति एउटा वेदी बनाएर होमबलि र मेलबलि चढाए। तिनले याहवेहलाई पुकारे; तब याहवेहले होमबलिको वेदीमा स्वर्गबाट आगो बर्साएर दावीदलाई जवाफ दिनुभयो।<verse eid="1CH 21:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 21:27"/>त्यसपछि याहवेहले दूतसँग कुरा गर्नुभयो, र तिनले आफ्नो तरवार म्यानभित्र हाले।<verse eid="1CH 21:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 21:28"/>त्यसै बेला जब दावीदले यबूसी अरौनाको खलामा याहवेहले तिनलाई जवाफ दिनुभएको देखे, तब तिनले त्यहीँ बलिहरू चढाए।<verse eid="1CH 21:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 21:29"/>त्यस बेला मोशाले उजाडस्थानमा बनाएको याहवेहको समागम पाल र होमबलिको वेदी गिबोनको अग्लो ठाउँमा थिए।<verse eid="1CH 21:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 21:30"/>तर दावीद परमेश्‍वरसँग सल्‍लाह लिन त्यसको सामु जान सकेनन्; किनकि तिनी याहवेहका दूतको तरवारदेखि डराएका थिए।<verse eid="1CH 21:30"/></para>
<chapter eid="1CH 21"/>
<chapter number="22" style="c" sid="1CH 22"/>
<para style="p"><verse number="1" style="v" sid="1CH 22:1"/>तब दावीदले भने, “याहवेह परमेश्‍वरको भवन र इस्राएलको निम्ति होमबलिको वेदी पनि यहीँ हुनुपर्छ।”<verse eid="1CH 22:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 22:2"/>यसकारण दावीदले इस्राएलमा बस्दै आएका विदेशीहरूलाई भेला गर्ने हुकुम दिए। अनि तिनीहरूमध्येबाट परमेश्‍वरको भवन निर्माण गर्नलाई काटेका राम्रा ढुङ्गा तयार गर्न भनी ढुङ्गा काट्नेहरू नियुक्त गरे।<verse eid="1CH 22:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 22:3"/>तिनले मूलढोकाहरूका निम्ति काँटीहरू र चेपुवाहरू बनाउन धेरै मात्रामा फलाम प्रबन्ध गरिदिए; अनि तौलन नसकिने मात्रामा काँसाहरू दिए।<verse eid="1CH 22:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 22:4"/>तिनले असंख्य देवदारुका काठहरूको पनि प्रबन्ध गरिदिए; किनकि सीदोनी र टायरवासीहरूले धेरै संख्यामा दावीदकहाँ ती काठहरू ल्याएका थिए।<verse eid="1CH 22:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 22:5"/>दावीदले भने, “मेरो छोरा सोलोमन कलिलै र अनुभवहीन छ; अनि याहवेहको नामको निम्ति बनाउनुपर्ने भवनचाहिँ सबै जातिहरूको दृष्‍टिमा अति विशाल, अति प्रसिद्ध र अति नै सुन्दर हुनुपर्छ। यसकारण म निर्माणको तयारी गर्नेछु।” यसकारण दावीदले आफ्नो मृत्युअगि नै व्यापक तयारी गरे।<verse eid="1CH 22:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 22:6"/>त्यसपछि तिनले आफ्नो छोरा सोलोमनलाई बोलाए, र तिनलाई याहवेह इस्राएलका परमेश्‍वरको निम्ति एउटा भवन निर्माण गर्ने जिम्मा दिए।<verse eid="1CH 22:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 22:7"/>दावीदले सोलोमनलाई भने, “मेरो छोरा, याहवेह मेरो परमेश्‍वरको नामको खातिर एउटा भवन बनाउने इच्छा मेरो हृदयमा थियो।<verse eid="1CH 22:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 22:8"/>तर याहवेहको यसो भन्‍ने वचन मकहाँ आयो: ‘तैँले धेरै रगत बगाएको छस्, र धेरै युद्धहरू लडेको छस्। त्यसैले तैँले मेरो नामको खातिर भवन बनाउनेछैनस्; किनकि मेरो दृष्‍टिमा यस पृथ्वीमा तैँले धेरै रगत बगाएको छस्।<verse eid="1CH 22:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 22:9"/>तर तेरो एउटा छोरा जन्मनेछ, जो शान्ति र विश्रामको मानिस हुनेछ। अनि म त्यसलाई त्यसका चारै दिशाका शत्रुहरूबाट विश्राम दिनेछु। त्यसको नाम सोलोमन हुनेछ; म त्यसको शासनकालमा इस्राएललाई शान्ति र सुरक्षा दिनेछु।<verse eid="1CH 22:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 22:10"/>त्यसले नै मेरो नामको खातिर एउटा भवन बनाउनेछ। त्यो मेरो छोरो हुनेछ, र म त्यसको पिता हुनेछु। अनि म इस्राएलमा त्यसको राज्यको सिंहासन सदासर्वदाका निम्ति स्थापित गर्नेछु।’<verse eid="1CH 22:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 22:11"/>“अब हे मेरो छोरा, याहवेह तँसँग रहून्, र तँलाई सफलता मिलोस्; अनि उहाँले भन्‍नुभएजस्तै तैँले याहवेह तेरा परमेश्‍वरको भवन बनाउनू।<verse eid="1CH 22:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 22:12"/>जब उहाँले तँलाई इस्राएलमाथि अधिकार दिएर राख्नुहुन्छ, तब याहवेहले तँलाई बुद्धि र समझशक्ति देऊन्, ताकि तैँले याहवेह तेरा परमेश्‍वरको व्यवस्था पालन गर्न सक।<verse eid="1CH 22:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 22:13"/>अनि यदि तैँले याहवेहले मोशाद्वारा इस्राएललाई दिनुभएका आदेशहरू होसियारीसाथ पालन गरिस् भने तैँले सफलता पाउनेछस्। बलियो र साहसी हो। नडरा अथवा निराश नहो।<verse eid="1CH 22:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 22:14"/>“मैले याहवेहको भवनका निम्ति धेरै दुःख गरेर एक लाख टालेन्ट सुन, दश लाख टालेन्ट चाँदी, प्रशस्त मात्रामा काँसो र तौलन नसकिने फलाम, र काठ र ढुङ्गा प्रबन्ध गरेको छु। तैँले त्यसमा अझै थप्न सक्छस्।<verse eid="1CH 22:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 22:15"/>तँसँग धेरै कर्मचारीहरू छन्: ढुङ्गा काट्नेहरू, डकर्मीहरू र सिकर्मीहरूका साथमा हरेक प्रकारका काममा सिपालु मानिसहरू छन्,<verse eid="1CH 22:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 22:16"/>अर्थात् सुन र चाँदी, काँसो र फलामका काम गर्ने असंख्य कारिगरहरू छन्। अब काम सुरु गर्, र याहवेह तेरो साथमा रहून्।”<verse eid="1CH 22:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 22:17"/>त्यसपछि दावीदले इस्राएलका सारा अगुवाहरूलाई आफ्नो छोरा सोलोमनलाई सहायता गर्न आदेश दिए।<verse eid="1CH 22:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 22:18"/>दावीदले तिनीहरूलाई भने, “के याहवेह तिमीहरूका परमेश्‍वर तिमीहरूसँग हुनुहुन्‍न र? अनि के उहाँले तिमीहरूलाई चारैतिरबाट विश्राम दिनुभएको छैन र? किनकि उहाँले यस देशका बासिन्दाहरूलाई मकहाँ सुम्पनुभएको छ; अनि यो देश, याहवेह र उहाँका प्रजाहरूका अधीनमा रहेको छ।<verse eid="1CH 22:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 22:19"/>अब तिमीहरूका हृदय र आत्मालाई याहवेह तिमीहरूका परमेश्‍वरलाई खोज्नमा लगाओ। याहवेह परमेश्‍वरको पवित्रस्थानको निर्माण गर्न सुरु गर, ताकि याहवेहको नामको खातिर बनिने मन्दिरभित्र याहवेहको करारको सन्दुक र परमेश्‍वरका पवित्र चीजहरू तिमीहरूले ल्याउन सक।”<verse eid="1CH 22:19"/></para>
<chapter eid="1CH 22"/>
<chapter number="23" style="c" sid="1CH 23"/>
<para style="p"><verse number="1" style="v" sid="1CH 23:1"/>जब दावीद वृद्ध भए, र धेरै उमेरका भए, तब तिनले आफ्ना छोरा सोलोमनलाई इस्राएलमाथि राजा नियुक्त गरे।<verse eid="1CH 23:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 23:2"/>तिनले इस्राएलका सबै अगुवाहरू, पुजारीहरू र लेवीहरूलाई पनि एकसाथ भेला गराए।<verse eid="1CH 23:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 23:3"/>तीस वर्ष र त्यसभन्दा बढी उमेरका लेवी पुरुषहरूको गन्ती गरियो; अनि पुरुषहरूको कुल संख्या अठतीस हजार थियो।<verse eid="1CH 23:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 23:4"/>दावीदले भने, “यीमध्ये चौबीस हजारले याहवेहको मन्दिरको काममा रेखदेख गरून्; अनि छ हजारचाहिँ अगुवाहरू र न्यायकर्ताहरू होऊन्।<verse eid="1CH 23:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 23:5"/>चार हजारचाहिँ द्वारपालहरू होऊन्, र अरू चार हजारले चाहिँ मैले प्रशंसाको उद्देश्यले उपलब्ध गराएका वाद्य-वादनहरूद्वारा याहवेहको प्रशंसा गरून्।”<verse eid="1CH 23:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 23:6"/>दावीदले लेवीहरूलाई लेवीका छोराहरू: गेर्शोन, कहात र मरारीका समूहअनुसार विभाजन गरे।<verse eid="1CH 23:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 23:7"/>गेर्शोनीहरूका छोराहरू: लादान र शिमी।<verse eid="1CH 23:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 23:8"/>लादानका छोराहरू: पहिलो यहीएल, दोस्रो जेताम र तेस्रो योएल—जम्मा तीन जना।<verse eid="1CH 23:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 23:9"/>शिमीका छोराहरू: शलोमोत, हाजीएल र हारान—जम्मा तीन जना। लादानका परिवारहरूका अगुवाहरू यिनीहरू नै थिए।<verse eid="1CH 23:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 23:10"/>शिमीका छोराहरू: यहत, जीजा, येऊश र बेरियाह। शिमीका छोराहरू—जम्मा चार जना।<verse eid="1CH 23:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 23:11"/>यहत पहिलो थिए, जीजा दोस्रो, तर येऊश र बेरियाहका छोराहरू धेरै थिएनन्; यसकारण तिनीहरूलाई एउटै परिवारझैँ गनियो र एउटै जिम्मेवारी दिइयो।<verse eid="1CH 23:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 23:12"/>कहातका छोराहरू: अम्राम, यिसहार, हेब्रोन र उज्जीएल—जम्मा चार जना।<verse eid="1CH 23:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 23:13"/>अम्रामका छोराहरू: हारून र मोशा। हारूनचाहिँ अलग गरिएका थिए; हारून र तिनका सन्तानहरूलाई सधैँका निम्ति अति पवित्र चीजहरू अर्पण गर्न, याहवेहको सामु भेटीहरू चढाउन, उहाँको सामु सेवा गर्न र सधैँका निम्ति उहाँको नाममा आशिष् दिनलाई अलग गरिएका थिए।<verse eid="1CH 23:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 23:14"/>परमेश्‍वरका जन मोशाका छोराहरूलाई चाहिँ लेवी कुलको एउटा भागको रूपमा गनियो।<verse eid="1CH 23:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 23:15"/>मोशाका छोराहरू: गेर्शोम र एलीएजर।<verse eid="1CH 23:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 23:16"/>गेर्शोमका सन्तानहरू: पहिलो शूबाएल।<verse eid="1CH 23:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 23:17"/>एलीएजेरका सन्तानहरू: पहिलो छोरो रहब्याह। (एलीएजरका अरू छोराहरू थिएनन्, तर रहब्याहका छोराहरू अति धेरै थिए।)<verse eid="1CH 23:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 23:18"/>यिसहारका छोराहरू: पहिलो शलोमीत।<verse eid="1CH 23:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 23:19"/>हेब्रोनका छोराहरू: पहिलो यरियाह, दोस्रो अमर्याह, तेस्रो यहजीएल र चौथो यकमाम।<verse eid="1CH 23:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 23:20"/>उज्जीएलका छोराहरू: पहिलो मीका र दोस्रो यिशियाह।<verse eid="1CH 23:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 23:21"/>मरारीका छोराहरू: महली र मूशी। महलीका छोराहरू: एलाजार र कीश।<verse eid="1CH 23:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 23:22"/>(एलाजारका छोराहरू नभई तिनको मृत्यु भयो: तिनका छोरीहरू मात्र थिए। तिनीहरूलाई तिनका आफन्तहरू, कीशका छोराहरूले विवाह गरे।)<verse eid="1CH 23:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 23:23"/>मूशीका छोराहरू: महली, एदेर र यरेमोत—जम्मा तीन जना।<verse eid="1CH 23:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 23:24"/>लेवीका परिवारअनुसार तिनीहरूका सन्तानहरू यिनै थिए—तिनीहरूका परिवारका अगुवाका नामअनुसार र हरेक व्यक्तिहरू, जो याहवेहको मन्दिरमा काम गर्ने बीस वर्ष र त्यसभन्दा बढी उमेरका कर्मचारीहरूको नाम दर्ता गरियो।<verse eid="1CH 23:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 23:25"/>किनकि दावीदले भनेका थिए, “याहवेह इस्राएलका परमेश्‍वरले आफ्ना मानिसहरूलाई विश्राम दिनुभएको छ, र उहाँ यरूशलेममा सदासर्वदाको लागि बास गर्न आउनुभएको छ।<verse eid="1CH 23:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 23:26"/>यसैकारण लेवीहरूले फेरि समागम पाल र त्यसको सेवामा प्रयोग गरिने कुनै पनि सामानहरू बोकिरहन आवश्यक छैन।”<verse eid="1CH 23:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 23:27"/>दावीदको अन्तिम निर्देशनअनुसार, बीस वर्ष र त्यसभन्दा बढी उमेरका लेवीहरू गनिए।<verse eid="1CH 23:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 23:28"/>लेवीहरूको जिम्मेवारीचाहिँ याहवेहको मन्दिरको सेवामा हारूनका सन्तानहरूलाई सहायता गर्नुपर्नेथियो: आँगन, छेउछाउका कोठाहरू, सबै पवित्र चीजहरू शुद्ध गर्ने र परमेश्‍वरको भवनमा अरू कामहरू पनि गर्नुपर्ने जिम्मेवारी थियो।<verse eid="1CH 23:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 23:29"/>तिनीहरू टेबुलमा सजाइएको रोटी, अन्‍नबलिको विशेष पिठो, खमिरविनाको पातलो रोटी, पकाउने र मिसाउने, र सबै प्रकारका नाप-तौल, र आकारका जिम्मेवारीमा थिए।<verse eid="1CH 23:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 23:30"/>तिनीहरू हरेक बिहान याहवेहलाई धन्यवाद र प्रशंसा चढाउनलाई पनि खडा हुनुपर्थ्यो। तिनीहरूले साँझमा पनि त्यसै गर्नुपर्थ्यो;<verse eid="1CH 23:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 23:31"/>अनि तिनीहरूले विश्रामदिनमा, औँसीका चाडहरूमा र तोकिएका चाडहरूमा याहवेहकहाँ होमबलि चढाउनु पर्थ्यो। तिनीहरूले नियमित रूपले उचित संख्या र तिनीहरूलाई तोकिदिएको नियमअनुसार याहवेहको सामु सेवा गर्नुपर्थ्यो।<verse eid="1CH 23:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 23:32"/>यसरी लेवीहरूले भेट हुने पालको, पवित्रस्थान र हारूनका सन्तान आफ्ना दाजुभाइहरूका अधीनमा रहेर याहवेहको मन्दिरको सेवामा पुजारीहरूलाई सहायता गरे।<verse eid="1CH 23:32"/></para>
<chapter eid="1CH 23"/>
<chapter number="24" style="c" sid="1CH 24"/>
<para style="p"><verse number="1" style="v" sid="1CH 24:1"/>हारूनका सन्तानका दलहरू यिनै थिए: हारूनका छोराहरू नादाब, अबीहू, एलाजार र ईतामार थिए।<verse eid="1CH 24:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 24:2"/>तर नादाब र अबीहूचाहिँ तिनीहरूका पिताभन्दा पहिले मरेर गए, र तिनीहरूका छोराहरू थिएनन्। यसकारण एलाजार र ईतामारले पुजारी भएर सेवा गरे।<verse eid="1CH 24:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 24:3"/>एलाजारको सन्तान सादोक र ईतामारको सन्तान अहीमेलेकको सहायतामा, दावीदले तिनीहरूको निम्ति तोकिएको सेवाको नियमअनुसार तिनीहरूलाई दलहरूमा विभाजन गरिदिए।<verse eid="1CH 24:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 24:4"/>ईतामारका सन्तानहरूमा भन्दा एलाजारका सन्तानहरूमा धेरै संख्यामा अगुवाहरू पाइए। अनि तिनीहरूको संख्याअनुसार नै विभाजन गरिए: एलाजारका सन्तानबाट परिवारहरूका सोह्र जना अगुवाहरू र ईतामारका सन्तानबाट परिवारहरूका आठ जना अगुवाहरू थिए।<verse eid="1CH 24:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 24:5"/>दावीद, सादोक र अहीमेलेकले उनीहरूलाई पक्षपात नगरी चिट्ठा हालेर भाग गरे; किनकि एलाजार र ईतामार दुवैका सन्तानहरूसँग पवित्रस्थानमा सेवा गर्न योग्य अधिकृतहरू र परमेश्‍वरका अधिकृतहरू थिए।<verse eid="1CH 24:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 24:6"/>लेवी नथनिएलका छोरा शास्त्री शमायाहले राजा र अधिकृतहरू: पुजारी सादोक, अबीयाथारका छोरा अहीमेलेक र पुजारीहरू र लेवीहरूका परिवारका अगुवाहरूको उपस्थितिमा तिनीहरूका नामहरू दर्ता गरे। एउटा घराना एलाजारबाट र एउटा घराना ईतामारबाट गोला हालेर छानियो।<verse eid="1CH 24:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 24:7"/>पहिलो चिट्ठा यहोयारीबको नाममा आयो, दोस्रो यदायाहको नाममा,<verse eid="1CH 24:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 24:8"/>तेस्रो हारीमको नाममा, चौथो सोरीमको नाममा,<verse eid="1CH 24:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 24:9"/>पाँचौँ मल्कियाहको नाममा, छैटौँ मिय्यामीनको नाममा,<verse eid="1CH 24:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 24:10"/>सातौँ हक्‍कोसको नाममा, आठौँ अबीयाहको नाममा,<verse eid="1CH 24:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 24:11"/>नवौँ येशूअको नाममा, दसौँ शकन्याहको नाममा,<verse eid="1CH 24:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 24:12"/>एघाह्रौ एल्यासीबको नाममा, बाह्रौँ याकीमको नाममा,<verse eid="1CH 24:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 24:13"/>तेह्रौँ हूप्पाको नाममा, चौधौँ येशेबाबको नाममा,<verse eid="1CH 24:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 24:14"/>पन्ध्रौँ बिल्गाको नाममा, सोह्रौँ इम्मेरको नाममा,<verse eid="1CH 24:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 24:15"/>सत्रौँ हेजीरको नाममा, अठारौँ हप्पिसेसको नाममा,<verse eid="1CH 24:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 24:16"/>उन्‍नाइसौँ पतहयाहको नाममा, बीसौँ यहेजकेलको नाममा,<verse eid="1CH 24:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 24:17"/>एक्‍काइसौँ याकीनको नाममा, बाइसौँ गामूलको नाममा,<verse eid="1CH 24:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 24:18"/>तेईसौँ दलायाहको नाममा, चौबीसौँ मज्याहको नाममा निस्क्यो।<verse eid="1CH 24:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 24:19"/>याहवेह इस्राएलका परमेश्‍वरले, तिनीहरूका पुर्खा हारूनलाई आज्ञा दिएबमोजिम, हारूनले तिनीहरूका निम्ति तोकिदिएका नियमअनुसार याहवेहको मन्दिरमा सेवाको निम्ति प्रवेश गर्दा तिनीहरूको निम्ति तोकिएको क्रम यही थियो।<verse eid="1CH 24:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 24:20"/>लेवीहरूका बाँकी रहेका सन्तानहरूका निम्ति चाहिँ: अम्रामका छोराहरूबाट: शूबाएल; शूबाएलका छोराहरूबाट: येहेदियाह,<verse eid="1CH 24:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 24:21"/>रहब्याहको बारेमा, तिनका छोराहरूबाट: जेठा यिश्शिय्याह।<verse eid="1CH 24:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 24:22"/>यिसहारबाट: शलामोत; शलोमोतका छोराहरूबाट: यहत।<verse eid="1CH 24:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 24:23"/>हेब्रोनका छोराहरू: जेठो यरियाह, माहिलो अमर्याह, साहिँलो यहजीएल र कान्छो यकमाम।<verse eid="1CH 24:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 24:24"/>उज्जीएलका छोरा: मीका; मीकाका छोराहरूबाट: शामीर।<verse eid="1CH 24:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 24:25"/>यिशियाहका छोराहरूबाट: जकरिया।<verse eid="1CH 24:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 24:26"/>मरारीका छोराहरू: महली र मूशी। यजियाहबाट: बनो;<verse eid="1CH 24:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 24:27"/>मरारीका छोराहरू, यजियाहबाट: बनो, शोहम, जक्‍कूर र इब्री।<verse eid="1CH 24:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 24:28"/>महलीबाट: एलाजार जसका छोरा थिएन।<verse eid="1CH 24:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 24:29"/>कीशबाट: कीशका छोरा यरहमेल।<verse eid="1CH 24:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 24:30"/>अनि मूशीका छोराहरू: महली, एदेर र यरीमोत। तिनीहरूका परिवारअनुसार लेवीहरू यिनै थिए।<verse eid="1CH 24:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 24:31"/>तिनीहरूका दाजुभाइहरू र हारूनका सन्तानहरूले गरेझैँ तिनीहरूले दावीद राजाको उपस्थितिमा र सादोक, अहीमेलेक र पुजारीहरू र लेवीहरूका परिवारहरूका अगुवाहरूको उपस्थितिमा चिट्ठा हाले। परिवारको सबैभन्दा जेठो दाजु होस् वा सबैभन्दा सानो भाइ होस्, उमेर र पदको ख्याल नराखी समान व्यवहार गरियो।<verse eid="1CH 24:31"/></para>
<chapter eid="1CH 24"/>
<chapter number="25" style="c" sid="1CH 25"/>
<para style="p"><verse number="1" style="v" sid="1CH 25:1"/>दावीद र सेनापतिहरूले मिलेर आसाप, हेमान र यदूतूनका केही छोराहरूलाई सारङ्गी, वीणा र झ्यालीहरू बजाउँदै अगमवाणीको सेवाका निम्ति अलग गरे। अगमवाणीको सेवा गर्ने मानिसहरूको सूची यही हो:<verse eid="1CH 25:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 25:2"/>आसापका छोराहरूबाट: जक्‍कूर, योसेफ, नतन्याह र असारेला। आसापका यी छोराहरू आसापको निर्देशनमा काम गर्थे। आसापले चाहिँ राजाको निर्देशनमा अगमवाणी गर्थे।<verse eid="1CH 25:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 25:3"/>यदूतूनका छोराहरूबाट: गदल्याह, सेरी, यशयाह, शिमी, हशब्याह र मत्तीत्याह, जम्मा छ जना। यिनीहरू आफ्ना पिता यदूतूनका निर्देशनमा काम गर्थे, जसले याहवेहलाई धन्यवाद र प्रशंसा गर्दा वीणा बजाउँदै अगमवाणी गर्थे।<verse eid="1CH 25:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 25:4"/>हेमानका छोराहरूबाट: बुक्‍कियाह, मत्तन्याह, उज्जीएल, शूबाएल र यरीमोत, हनन्याह, हनानी, एलीआता, गिद्दलती र रोमम्ती-एजेर, योशब्काशा, मल्‍लोती, होतीर र महजीओत।<verse eid="1CH 25:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 25:5"/>(यी सबै राजाका दर्शी हेमानका छोराहरू थिए। यिनीहरूचाहिँ उनलाई उच्‍च तुल्याउनका निम्ति परमेश्‍वरको प्रतिज्ञाअनुसार दिइएको थियो। परमेश्‍वरले हेमानलाई चौध जना छोरा र तीन जना छोरी दिनुभयो।)<verse eid="1CH 25:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 25:6"/>यिनीहरू सबै याहवेहको भवनमा सङ्गीतका लागि आफ्ना पिताको निर्देशनमा काम गर्थे। तिनीहरूले झ्याली, सारङ्गी र वीणाको साथमा परमेश्‍वरको भवनमा सेवा गर्थे। आसाप, यदूतून र हेमानचाहिँ राजाको निर्देशनमा काम गर्थे।<verse eid="1CH 25:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 25:7"/>तिनीहरूका आफन्तहरूका साथै तिनीहरू सबै याहवेहको निम्ति सङ्गीतमा तालिम पाएका र निपूर्ण थिए। तिनीहरूको संख्या 288 थियो।<verse eid="1CH 25:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 25:8"/>जवान वा वृद्ध, शिक्षक वा विद्यार्थी तिनीहरूले आ-आफ्नो जिम्मेवारीको निम्ति चिट्ठा हाले।<verse eid="1CH 25:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 25:9"/>पहिलो चिट्ठाचाहिँ आसापको निम्ति थियो, र त्यो योसेफलाई पर्‍यो, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना, दोस्रोचाहिँ गदल्याहलाई, तिनका आफन्तहरू र छोराहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 25:10"/>तेस्रोचाहिँ जक्‍कूरलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 25:11"/>चौथो यिस्रीलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 25:12"/>पाँचौँ नतन्याहलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 25:13"/>छैटौँ बुक्‍कियाहलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 25:14"/>सातौँ यसरेलालाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 25:15"/>आठौँ यशयाहलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 25:16"/>नवौँ मत्तन्याह, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 25:17"/>दसौँ शिमीलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 25:18"/>एघाह्रौ अज्रेललाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 25:19"/>बाह्रौँ हशब्याहलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 25:20"/>तेह्रौँ शूबाएललाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 25:21"/>चौधौँ मत्तीत्याहलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 25:22"/>पन्ध्रौँ यरेमोतलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 25:23"/>सोह्रौँ हनन्याहलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 25:24"/>सत्रौँ योशब्काशालाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 25:25"/>अठारौँ हनानीलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 25:26"/>उन्‍नाइसौँ मल्‍लोतीलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 25:27"/>बीसौँ एलियातालाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 25:28"/>एक्‍काइसौँ होतीरलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 25:29"/>बाइसौँ गिद्दलतीलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 25:30"/>तेईसौँ महजीओतलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना,<verse eid="1CH 25:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 25:31"/>चौबीसौँ रोमम्ती-एजेरलाई, तिनका छोराहरू र आफन्तहरूका नाममा—जम्मा 12 जना थिए।<verse eid="1CH 25:31"/></para>
<chapter eid="1CH 25"/>
<chapter number="26" style="c" sid="1CH 26"/>
<para style="p"><verse number="1" style="v" sid="1CH 26:1"/>द्वारपालहरूका दलहरू यस प्रकारका थिए: कोरहवंशीहरूबाट: मेशेलेम्याह कोरेका छोरा, जो आसापका छोराहरूमध्ये एक थिए।<verse eid="1CH 26:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 26:2"/>मेशेलेम्याहका छोराहरू: पहिलो छोरो जकरिया, दोस्रो यदीएल, तेस्रो जबदियाह, चौथो यत्नीएल,<verse eid="1CH 26:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 26:3"/>पाँचौँ एलाम, छैटौँ यहोनान र सातौँ एल्यहोएनै।<verse eid="1CH 26:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 26:4"/>ओबेद-एदोमका पनि छोराहरू थिए: पहिलो शमायाह, दोस्रो यहोजाबाद, तेस्रो योआ, चौथो साकार, पाँचौँ नथनिएल,<verse eid="1CH 26:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 26:5"/>छैटौँ अम्मीएल, सातौँ इस्साखार र आठौँ पुल्‍लतै। (किनकि परमेश्‍वरले ओबेद-एदोमलाई आशिष् दिनुभएको थियो।)<verse eid="1CH 26:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 26:6"/>ओबेद-एदोमका छोरा शमायाहका पनि छोराहरू थिए, जो आफ्ना पिताका परिवारमा अगुवाहरू थिए; किनकि तिनीहरू धेरै योग्यता भएका मानिसहरू थिए।<verse eid="1CH 26:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 26:7"/>शमायाहका छोराहरू: ओत्नी, रपाएल, ओबेद र एल्जाबाद; तिनका आफन्तहरू एलीहू र समक्याह पनि योग्यता भएका मानिसहरू थिए।<verse eid="1CH 26:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 26:8"/>यी सबै ओबेद-एदोमका सन्तान थिए; तिनीहरू र तिनीहरूका छोराहरू र तिनीहरूका आफन्तहरू शक्तिशाली थिए। ओबेद-एदोमका सन्तानहरू जम्मा 62 जना थिए।<verse eid="1CH 26:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 26:9"/>मेशेलेम्याहका छोराहरू र आफन्तहरू, जो योग्य मानिसहरू थिए। तिनीहरू जम्मा 18 जना थिए।<verse eid="1CH 26:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 26:10"/>मरारी होसाका छोराहरू: पहिलो शिम्री, (यद्यपि तिनी जेठो छोरा नभए तापनि तिनका पिताले तिनलाई अगुवा तुल्याएका थिए);<verse eid="1CH 26:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 26:11"/>दोस्रो हिल्कियाह, तेस्रो तबल्याह र चौथो जकरिया। होसाका छोराहरू र आफन्तहरू जम्मा 13 जना थिए।<verse eid="1CH 26:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 26:12"/>द्वारपालहरूका दलहरूका यी अगुवाहरूद्वारा याहवेहको भवनमा आफ्ना आफन्तहरूले सेवा गरेझैँ तिनीहरूलाई पनि सेवा गर्न भनी जिम्मेवारी दिइएका थिए।<verse eid="1CH 26:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 26:13"/>जवान वा वृद्ध, आफ्ना घरानाअनुसार हरेक मूलढोकाका निम्ति चिट्ठा हाले।<verse eid="1CH 26:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 26:14"/>पूर्वपट्टिको मूलढोकाको चिट्ठा शेलेम्याहलाई पर्‍यो। त्यसपछि उत्तरपट्टिको मूलढोकाको चिट्ठा शलेम्याहका छोरा जकरियालाई पर्‍यो, जो बुद्धिमान् सल्‍लाहकार थिए।<verse eid="1CH 26:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 26:15"/>दक्षिणपट्टिको मूलढोकाको चिट्ठा ओबेद-एदोमलाई पर्‍यो, र भण्डारको चिट्ठाचाहिँ ओबेद-एदोमका छोराहरूलाई पर्‍यो।<verse eid="1CH 26:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 26:16"/>पश्‍चिमपट्टिको मूलढोका र माथिल्‍लो बाटोको शल्‍लेकेत मूलढोकाको चिट्ठा शुप्पीम र होसालाई पर्‍यो। एउटा पहरेदार अर्को पहरेदारको छेउमा उभिन्थे:<verse eid="1CH 26:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 26:17"/>पूर्वपट्टि प्रत्येक दिन छ जना लेवीहरू पहरा बस्थे; उत्तरपट्टि प्रत्येक दिन चार जना, दक्षिणपट्टि प्रत्येक दिन चार जना र भण्डार कोठामा चाहिँ एकै पटकमा दुई-दुई जना पहरेदार खटिएका थिए।<verse eid="1CH 26:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 26:18"/>पश्‍चिमपट्टि चोकतिरको बाटोमा चार जना र चोकमा चाहिँ दुई जना खटिएका थिए।<verse eid="1CH 26:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 26:19"/>कोरह र मरारीका सन्तानहरूमा द्वारपालका दलहरू यिनै थिए।<verse eid="1CH 26:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 26:20"/>तिनीहरूका लेवी दाजुभाइहरू परमेश्‍वरको भवनको खजाना र अर्पण गरिएका चीजहरूका भण्डारहरूका जिम्मेवार थिए।<verse eid="1CH 26:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 26:21"/>लादानका सन्तानहरू, जो लादानको वंशद्वारा आएका गेर्शोनीहरू र गेर्शोनी लादानका परिवारहरूका अगुवाहरू थिए। तिनीहरू यहीएली,<verse eid="1CH 26:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 26:22"/>यहीएलीका छोराहरू, जेताम र तिनका भाइ योएल थिए। तिनीहरू याहवेहको भवनको भण्डारहरूका अधिकारीहरू थिए।<verse eid="1CH 26:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 26:23"/>अम्रामीहरू, यिसहारीहरू, हेब्रोनीहरू र उज्जीएलीहरूबाट:<verse eid="1CH 26:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 26:24"/>मोशाका छोरा गेर्शोम, गेर्शोमका छोरा, शूबाएलचाहिँ भण्डारहरूका अधिकारी थिए।<verse eid="1CH 26:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 26:25"/>एलीएजरबाटका शूबाएलका आफन्तहरू: एलीएजेरका छोरा रहब्याह, रहब्याहका छोरा यसयाह, यसयाहका छोरा योराम, योरामका छोरा जिक्री र जिक्रीका छोरा शलोमीत।<verse eid="1CH 26:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 26:26"/>शलोमीत र तिनका आफन्तहरू ती सबै भण्डारहरूका जिम्मेवार थिए, जुन भण्डार राजा दावीदले, परिवारहरूका अगुवाहरूले, जो हजार-हजारमाथि र सय-सयमाथिका सेनापतिहरू थिए, र अरू सेनाका कप्‍तानहरूले अर्पण गरेका थोकहरू थिए।<verse eid="1CH 26:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 26:27"/>लडाइँमा लुटका केही मालसामानहरू याहवेहको मन्दिरको मरमतको निम्ति तिनीहरूले अर्पण गरेका थिए।<verse eid="1CH 26:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 26:28"/>दर्शी शमूएलले र कीशका छोरा शाऊलले नेरका छोरा अबनेर; अनि सरूयाहका छोरा योआबले अर्पण गरेका हरेक कुरा, र ती अर्पण गरिएका अरू सबै चीजहरूचाहिँ शलोमीत र तिनका आफन्तहरूका जिम्मामा थिए।<verse eid="1CH 26:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 26:29"/>यिसहारीहरूका वंशबाट: कनन्याह र तिनका छोराहरूलाई मन्दिरदेखि टाढा इस्राएलमाथि अधिकारी र न्यायकर्ताको रूपमा जिम्मेवारी दिइएको थियो।<verse eid="1CH 26:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 26:30"/>हेब्रोनीहरूबाट: हशब्याह र तिनका आफन्तहरू—सत्र सय योग्य मानिसहरूचाहिँ इस्राएलमा याहवेहका सबै कामका निम्ति र राजाको सेवाका निम्ति यर्दन नदीको पश्‍चिमपट्टिको अधिकारी थिए।<verse eid="1CH 26:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 26:31"/>हेब्रोन वंशीहरूको बारेमा चाहिँ तिनीहरूका परिवारका वंशावलीमा दर्ता भएअनुसार यरियाहचाहिँ अगुवा थिए। (दावीदको शासनको चालीसौँ वर्षमा वंशावलीहरूको बारेमा खोजी गरियो; अनि हेब्रोनीहरूका बीचमा योग्यका मानिसहरू गिलादको याजेरमा भेट्टाइयो।<verse eid="1CH 26:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 26:32"/>यरियाहका सत्ताइस सय आफन्तहरू थिए, जो योग्यका मानिसहरू थिए र परिवारहरूका अगुवाहरू थिए। राजा दावीदले तिनीहरूलाई रूबेनीहरू, गादीहरू र मनश्शेको आधा कुलमाथि परमेश्‍वर र राजासम्बन्धी हरेक कुराको निम्ति जिम्मा दिए।)<verse eid="1CH 26:32"/></para>
<chapter eid="1CH 26"/>
<chapter number="27" style="c" sid="1CH 27"/>
<para style="p"><verse number="1" style="v" sid="1CH 27:1"/>इस्राएलीहरूको सूची यही हो—परिवारहरूका अगुवाहरू, हजार-हजारमाथि र सय-सयमाथिका सेनापतिहरू र तिनीहरूका अधिकारीहरू, जसले वर्षको हरेक महिना पालैपालो सेनाका दलहरू सम्बन्धित सबै कुरामा राजाको सेवामा गर्थे। प्रत्येक सैनिक दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 27:2"/>पहिलो महिनाको निम्ति, पहिलो दलका सेनापति जब्दीएलका छोरा यशोबाम थिए। तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 27:3"/>तिनी पेरेसका सन्तान थिए, जो पहिलो महिनाको निम्ति सारा सेनाका सेनापतिहरूका अगुवा थिए।<verse eid="1CH 27:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 27:4"/>दोस्रो महिनाको निम्ति, दोस्रो दलका सेनापति अहोहीका दोदै थिए; अनि मिक्लोतचाहिँ तिनका दलका अगुवा थिए। तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 27:5"/>तेस्रो महिनाको निम्ति, तेस्रो दलका सेनापति पुजारी यहोयादाका छोरा बनायाह थिए। यहोयादा मुख्य पुजारी थिए; अनि तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 27:6"/>यिनी तिनै बनायाह थिए, जो तीस जना वीर मानिसहरूमध्ये एक र तीस जनामा माथि थिए। तिनका छोरा अम्मीजाबादचाहिँ तिनको दलका अगुवा थिए।<verse eid="1CH 27:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 27:7"/>चौथो महिनाको निम्ति, चौथो सेनापतिचाहिँ योआबका भाइ असाहेल थिए। तिनीपछि तिनका छोरा जबदियाहले जिम्मेवारी उठाए। तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 27:8"/>पाँचौँ महिनाको निम्ति, पाँचौँ सेनापति यिज्राहीका शम्हूत थिए। तिनको दलमा 24,000 मानिसहरू थिए।<verse eid="1CH 27:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 27:9"/>छैटौँ महिनाको निम्ति, छैटौँ सेनापति तकोका इक्‍केशका छोरा ईरा थिए। तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 27:10"/>सातौँ महिनाको निम्ति, सातौँ सेनापति एफ्राइमका पेलोनीका हेलेस थिए। तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 27:11"/>आठौँ महिनाको निम्ति, आठौँ सेनापति जेरह घरानाका हूशाती सिब्बकै थिए। तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 27:12"/>नवौँ महिनाको निम्ति, नवौँ सेनापति बेन्यामीन घरानाका अनातोती अबीएजेर थिए। तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 27:13"/>दसौँ महिनाको निम्ति, दसौँ सेनापति जेरह घरानाका नतोपाती महरै थिए। तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 27:14"/>एघारौँ महिनाको निम्ति, एघारौँ सेनापति एफ्राइम घरानाका पिरातोनी बनायाह थिए। तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 27:15"/>बाह्रौँ महिनाको निम्ति, बाह्रौँ सेनापति ओत्निएलका घरानाका नतोपाती हेल्दै थिए। तिनको दलमा 24,000 सेनाहरू थिए।<verse eid="1CH 27:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 27:16"/>इस्राएलका कुलहरूका अगुवाहरू यिनीहरू थिए: रूबेनको कुलबाट: एलीएजर जिक्रीका छोरा; शिमियोनको कुलबाट: माकाका छोरा शपत्याह;<verse eid="1CH 27:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 27:17"/>लेवीको कुलबाट: कमूएलका छोरा हशब्याह; हारूनको कुलबाट: सादोक;<verse eid="1CH 27:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 27:18"/>यहूदाको कुलबाट: दावीदका एक जना दाजु एलीहू; इस्साखारको कुलबाट: मिखाएलका छोरा ओम्री;<verse eid="1CH 27:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 27:19"/>जबूलूनको कुलबाट: ओबदियाका छोरा यिश्मायाह; नप्‍तालीको कुलबाट: अज्रीएलका छोरा यरीमोत;<verse eid="1CH 27:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 27:20"/>एफ्राइमको कुलबाट: अजज्याहका छोरा होशे; मनश्शेको आधा कुलबाट: पदायाहका छोरा योएल;<verse eid="1CH 27:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 27:21"/>गिलादमा भएका मनश्शेको आधा कुलबाट: जकरियाका छोरा इद्दो; बेन्यामीनको कुलबाट: अबनेरको छोरा यासीएल;<verse eid="1CH 27:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 27:22"/>दानको कुलबाट: यरोरामका छोरा अज्रेल। इस्राएलका कुलहरूमाथिका अधिकारीहरू यिनीहरू नै थिए।<verse eid="1CH 27:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 27:23"/>दावीदले बीस र त्यसभन्दा तलका मानिसहरूको गन्ती लिएनन्; किनभने याहवेहले इस्राएलको संख्या आकाशका ताराहरूझैँ बढाउने प्रतिज्ञा गर्नुभएको थियो।<verse eid="1CH 27:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 27:24"/>सरूयाहका छोरा योआबले मानिसहरूलाई गन्ती गर्न सुरु गरे, तर पूरा सकेनन्; किनभने यस गणनाको कारण परमेश्‍वरको क्रोध इस्राएलमाथि पर्‍यो; अनि दावीद राजाको इतिहासको पुस्तकमा त्यो संख्या लेखिएन।<verse eid="1CH 27:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 27:25"/>अदीएलका छोरा अज्मावेत, राजकीय भण्डारहरूका जिम्मामा थिए। उज्जियाहका छोरा जोनाथन, ग्रामीण जिल्‍लाहरूमा, सहरहरूमा, बस्तीहरूमा र धरहराहरूमा रहेका भण्डारहरूका जिम्मामा थिए।<verse eid="1CH 27:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 27:26"/>कलूबको छोरा एज्री, देशमा खेतीकिसान गर्नेहरूका जिम्मामा थिए।<verse eid="1CH 27:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 27:27"/>रामती शिमी, दाखबारीहरूका जिम्मामा थिए। दाखबारीका उब्जनीको दाखमद्य राख्ने भण्डारको अधिकारी शेपेमी जब्दी थिए।<verse eid="1CH 27:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 27:28"/>पश्‍चिमपट्टिको बेँसीमा भएका नेभारा र जैतुनका बोटहरूको हेरचाह गर्ने जिम्मा गेदेरी बाल-हानान थिए। योआश तेल राख्ने भण्डारको जिम्मामा थिए।<verse eid="1CH 27:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 27:29"/>शारोनका शित्रैचाहिँ शारोनमा चर्ने गाईबस्तुहरूका जिम्मामा थिए। बेँसीमा चर्ने गाईबस्तुहरूका अधिकारीचाहिँ अदलैका छोरा शापात थिए।<verse eid="1CH 27:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 27:30"/>ऊँटहरूका अधिकारी इश्माएली ओबील थिए। गधाहरूका अधिकारी मरोनोती येहेदियाह थिए।<verse eid="1CH 27:30"/></para>
<para style="p"><verse number="31" style="v" sid="1CH 27:31"/>बगालहरूका अधिकारी हग्री याजीज थिए। यिनीहरू नै राजा दावीदका सम्पत्तिको रेखदेख गर्ने अधिकारीहरू थिए।<verse eid="1CH 27:31"/></para>
<para style="p"><verse number="32" style="v" sid="1CH 27:32"/>दावीदका काका जोनाथन, एक सल्‍लाहकार, अन्तर्दृष्‍टि भएका मानिस र शास्त्री थिए। हक्मोनीका छोरा यहीएलले राजाका छोराहरूको हेरचाह गर्थे।<verse eid="1CH 27:32"/></para>
<para style="p"><verse number="33" style="v" sid="1CH 27:33"/>अहीतोपेल राजाका सल्‍लाहकार थिए। अरकी हूशैचाहिँ राजाका मित्र थिए।<verse eid="1CH 27:33"/></para>
<para style="p"><verse number="34" style="v" sid="1CH 27:34"/>(अहीतोपेलपछि तिनको जिम्मा बनायाहका छोरा यहोयादा र अबीयाथारले सम्हालेका थिए।) योआबचाहिँ राजकीय सेनाका सेनापति थिए।<verse eid="1CH 27:34"/></para>
<chapter eid="1CH 27"/>
<chapter number="28" style="c" sid="1CH 28"/>
<para style="p"><verse number="1" style="v" sid="1CH 28:1"/>दावीदले इस्राएलका सबै अधिकृतहरू: कुलहरूमाथिका अधिकारीहरू, राजाको सेवामा रहेका दलहरूका सेनापतिहरू, हजार-हजारमाथि र सय-सयमाथिका सेनापतिहरू, राजा र तिनका छोराहरूका सम्पत्ति र गाईबस्तुका अधिकारीहरू, साथै महलका अधिकृतहरू, वीर मानिसहरू र सबै वीर लडाकुहरूलाई यरूशलेममा भेला गरे।<verse eid="1CH 28:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 28:2"/>राजा दावीदले उभिएर भने, “मेरा दाजुभाइहरू र मेरा मानिसहरू, मेरा कुरा सुन्‍नुहोस्! याहवेहको करारको सन्दुकको वासस्थानका र हाम्रा परमेश्‍वरको पाउदानका निम्ति एउटा भवन बनाउने मेरो हृदयमा इच्छा थियो; तब मैले भवन बनाउने एउटा योजना बनाएको थिएँ।<verse eid="1CH 28:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 28:3"/>तर परमेश्‍वरले मलाई भन्‍नुभयो, ‘तैँले मेरो नामको आदरको निम्ति भवन बनाउनेछैनस्; किनकि तँ एउटा योद्धा होस्, र तैँले धेरै रगत बगाएको छस्।’ ”<verse eid="1CH 28:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 28:4"/>तर याहवेह इस्राएलका परमेश्‍वरले मेरा सारा परिवारबाट मलाई इस्राएलमाथि सदाका निम्ति राजा हुनलाई चुन्‍नुभयो र उहाँले यहूदाको घरानाबाट मेरो परिवारलाई चुन्‍नुभयो। मेरा पिताका छोराहरूबाट सारा इस्राएलमाथि मलाई राजा बनाउन उहाँले इच्छा गर्नुभयो।<verse eid="1CH 28:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 28:5"/>याहवेहले मलाई धेरै छोराहरू दिनुभएको छ। याहवेहको सिंहासनमा बसेर इस्राएलमाथि शासन गर्न उहाँले मेरा छोराहरूमध्ये सोलोमनलाई चुन्‍नुभएको छ।<verse eid="1CH 28:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 28:6"/>उहाँले मलाई भन्‍नुभयो: “तेरो छोरा सोलोमनले नै मेरो भवन र मेरा चोकहरू बनाउनेछ; किनभने मैले त्यसलाई मेरो छोरा हुनलाई चुनेको छु, र म त्यसको पिता हुनेछु।<verse eid="1CH 28:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 28:7"/>यदि त्यसले आजको दिनमा जस्तै गरी मेरा आज्ञाहरू र व्यवस्थाहरू होसियारीसाथ पालन गरिरह्‍यो भने, म त्यसको राज्य सदासर्वदाका निम्ति स्थिर पार्नेछु।”<verse eid="1CH 28:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 28:8"/>यसकारण अब तिमीहरूलाई सारा इस्राएल र याहवेहको समुदायको दृष्‍टिमा, साथै हाम्रा परमेश्‍वरले सुन्‍ने गरी म यो जिम्मा दिँदैछु: तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरका सबै आज्ञाहरू होसियारीसाथ पालन गर्नू; ताकि तिमीहरूले यो असल देशमाथि अधिकार गर्न सक, र यस देशलाई सदाका निम्ति तिमीहरूका सन्तानका निम्ति उत्तराधिकारको रूपमा सुम्पन सक।<verse eid="1CH 28:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 28:9"/>“अनि तँ, हे मेरो छोरा सोलोमन, तैँलेचाहिँ आफ्ना पिताका परमेश्‍वरलाई चिनेर साँचो हृदय र सारा मनले उहाँको सेवा गर्नू; किनकि याहवेहले प्रत्येकको हृदयलाई जाँच गर्नुहुन्छ; किनकि उहाँले मनको हरेक विचार बुझ्नुहुन्छ। यदि तैँले उहाँलाई खोजी गरिस् भने तैँले उहाँलाई भेट्टाउनेछस्; तर यदि तैँले उहाँलाई त्यागिस् भने उहाँले तँलाई सधैँका निम्ति त्याग्नुहुनेछ।<verse eid="1CH 28:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 28:10"/>अब होशियार बन्; किनकि याहवेहले तँलाई एउटा पवित्रस्थानको रूपमा भवन बनाउनका निम्ति चुन्‍नुभएको छ। अब साहसी बनेर यो काम सुरु गर्।”<verse eid="1CH 28:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 28:11"/>तब दावीदले मन्दिरको दलानको नमुना, त्यसको सेरोफेरो, त्यसका भण्डारहरू, त्यसका माथिल्‍ला कोठाहरू, त्यसका भित्री कोठाहरू र पाप समाधान-स्थानको ठाउँको नमुनाहरू आफ्ना छोरा सोलोमनलाई दिए।<verse eid="1CH 28:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 28:12"/>दावीदले याहवेहको मन्दिरका चोकहरू र चारैतिरका कोठाहरू, परमेश्‍वरको मन्दिरका भण्डारहरू र अर्पण गरिएका चीजहरूका भण्डारहरूको नमुना, ती सबै कुराहरूको निर्माणको नमुनाहरू, जुन तिनले आत्माद्वारा पाएका थिए, आफ्ना छोरा सोलोमनलाई दिए।<verse eid="1CH 28:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 28:13"/>दावीदले सोलोमनलाई पुजारीहरू र लेवीहरूका दलहरूको निम्ति, याहवेहको मन्दिरमा सेवाका सबै कामका निम्ति र साथै मन्दिरको सेवामा प्रयोग गरिने सबै चीजहरूका निम्ति निर्देशन दिए।<verse eid="1CH 28:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 28:14"/>तिनले विभिन्‍न प्रकारका सेवाहरूमा प्रयोग गरिने सुनका सामग्रीहरू, चाँदीका सामग्रीहरूका निम्ति चाहिने सुन र चाँदीको तौल तोकिदिए।<verse eid="1CH 28:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 28:15"/>सुनका पानसहरू र त्यसका बत्तीहरूका निम्ति प्रत्येक पानस र त्यसका बत्तीहरूका तौल बमोजिम सुन दिए; अनि चाँदीका पानसहरूको प्रयोगअनुसार प्रत्येक चाँदीको पानस र त्यसका बत्तीहरूका निम्ति चाँदीको तौल तोकिदिए।<verse eid="1CH 28:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 28:16"/>पवित्र रोटी राख्नलाई प्रयोग गरिने हरेक टेबुलका निम्ति सुनको तौल, चाँदीका टेबुलहरूका निम्ति चाँदीको तौल तोकिदिए;<verse eid="1CH 28:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 28:17"/>काँटाहरू, छर्कने कचौराहरू, सुराहीहरूका निम्ति निखुर सुनको तौल; प्रत्येक सुनको भाँडाको निम्ति सुनको तौल; प्रत्येक चाँदीको भाँडाको निम्ति चाँदीको तौल;<verse eid="1CH 28:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 28:18"/>अनि धूप वेदीको निम्ति खारिएको सुनको तौल दिए। तिनले सुनको रथ बनाउने नमुना पनि तिनलाई दिए, अर्थात् पखेटा फैलाएका सुनका करूबहरू, जसले याहवेहको करारको सन्दुकमाथि छाया पार्दथे; त्यो रथ बनाउनका निम्ति चाहिने निखुर सुन दिए।<verse eid="1CH 28:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 28:19"/>दावीदले भने, “याहवेहको हात ममाथि भएको कारण यी सम्पूर्ण लिखित कुरा मसँग छन्। अनि उहाँले मलाई यस योजनाको सम्पूर्ण विवरण बुझ्नलाई समझ दिनुभयो छ।”<verse eid="1CH 28:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 28:20"/>दावीदले आफ्ना छोरा सोलोमनलाई पनि भने, “बलियो र साहसी भएर यो काम गर्! नडरा र निराश नहो, किनकि याहवेह परमेश्‍वर, मेरा परमेश्‍वर तेरो साथमा हुनुहुनेछ। याहवेहको मन्दिरको सेवाका निम्ति सबै कामहरू पूरा नभएसम्म उहाँले तँलाई छोड्नुहुनेछैन, अर्थात् त्याग्नुहुनेछैन।<verse eid="1CH 28:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 28:21"/>परमेश्‍वरको मन्दिरको सबै कामका निम्ति पुजारीहरू र लेवीहरूका दलहरू तयार छन्; अनि हरेक कलामा निपुण इच्छुक कारिगरहरूले तँलाई सबै कामहरूमा सहायता गर्नेछन्। अनि अधिकारीहरू र सबै मानिसहरूले तेरो प्रत्येक हुकुम पालन गर्नेछन्।”<verse eid="1CH 28:21"/></para>
<chapter eid="1CH 28"/>
<chapter number="29" style="c" sid="1CH 29"/>
<para style="p"><verse number="1" style="v" sid="1CH 29:1"/>तब राजा दावीदले सारा समुदायलाई भने: “परमेश्‍वरले चुन्‍नुभएको मेरो छोरा सोलोमन, त्यो कलिलो र अनुभवहीन छ। तर त्यसले गर्नुपर्ने काम ठूलो छ; किनकि यो भवन मानिसहरूका निम्ति होइन, तर याहवेह परमेश्‍वरका निम्ति हो।<verse eid="1CH 29:1"/></para>
<para style="p"><verse number="2" style="v" sid="1CH 29:2"/>मैले आफ्नो शक्तिले भ्याएसम्म मेरा परमेश्‍वरको भवनका निम्ति आवश्यक सरसामानहरू सकभर जुटाएको छु—सुनका कामको निम्ति सुन, चाँदीका निम्ति चाँदी, काँसाको निम्ति काँसा, फलामको निम्ति फलाम र काठको निम्ति काठ। यसकासाथै जडान जड्न गोमेद, नीलमणि, विभिन्‍न रङ्गका बहुमूल्य पत्थरहरू, विभिन्‍न प्रकारका ढुङ्गाहरू र सिङ्गमरमरहरू, सबै कुराहरू प्रशस्त मात्रामा छन्।<verse eid="1CH 29:2"/></para>
<para style="p"><verse number="3" style="v" sid="1CH 29:3"/>यसबाहेक मेरा परमेश्‍वरको मन्दिरका निम्ति मेरो गहिरो अभिरुचि भएकोले माथि जुटाएका सबै कुराहरूभन्दा धेरै आफ्ना व्यक्तिगत भण्डारबाट सुन र चाँदी मैले यस पवित्र मन्दिरका निम्ति दिएको छु;<verse eid="1CH 29:3"/></para>
<para style="p"><verse number="4" style="v" sid="1CH 29:4"/>अर्थात् भवनको भित्ताहरू मोहोर्न अर्थात् सिगार्नलाई तीन हजार टालेन्ट सुन (ओपीरको सुन) र सात हजार टालेन्ट खारिएको चाँदी,<verse eid="1CH 29:4"/></para>
<para style="p"><verse number="5" style="v" sid="1CH 29:5"/>सुन र चाँदीको कामका निम्ति र कारिगरहरूले गर्नुपर्ने सबै कामका निम्ति दिएको छु। अब आजको दिन याहवेहकहाँ आफूलाई अर्पण गर्न को राजी छ?”<verse eid="1CH 29:5"/></para>
<para style="p"><verse number="6" style="v" sid="1CH 29:6"/>तब परिवारहरूका अगुवाहरू, इस्राएल कुलहरूका अधिकारीहरू, हजार-हजारमाथि र सय-सयमाथिका सेनापतिहरू; अनि राजाको कामको जिम्मामा खटिएका अधिकृतहरूले राजीखुशीसाथ दिए।<verse eid="1CH 29:6"/></para>
<para style="p"><verse number="7" style="v" sid="1CH 29:7"/>तिनीहरूले परमेश्‍वरको मन्दिरका कामको निम्ति पाँच हजार टालेन्ट सुन, दश हजार दारिक सुन र दश हजार टालेन्ट चाँदी, अठार हजार टालेन्ट काँसा र एक लाख टालेन्ट फलाम दिए।<verse eid="1CH 29:7"/></para>
<para style="p"><verse number="8" style="v" sid="1CH 29:8"/>बहुमूल्य पत्थरहरू हुनेहरूले त्यो गेर्शोनी यहीएलको जिम्मामा रहेका याहवेहको मन्दिरको भण्डारमा दिए।<verse eid="1CH 29:8"/></para>
<para style="p"><verse number="9" style="v" sid="1CH 29:9"/>मानिसहरूले तिनीहरूका अगुवाहरूलाई राजीखुशीसाथ दिएकोमा खुशी भए; किनकि तिनीहरूले राजीखुशी र सम्पूर्ण हृदयले याहवेहलाई दिएका थिए। राजा दावीद पनि साह्रै आनन्दित भए।<verse eid="1CH 29:9"/></para>
<para style="p"><verse number="10" style="v" sid="1CH 29:10"/>दावीदले सारा समुदायको उपस्थितिमा याहवेहको प्रशंसा गर्दै भने: “हे हाम्रा इस्राएलका परमेश्‍वर, याहवेह, अनन्तदेखि अनन्तसम्म तपाईंको प्रशंसा भइरहोस्।<verse eid="1CH 29:10"/></para>
<para style="p"><verse number="11" style="v" sid="1CH 29:11"/>हे याहवेह, महानता, शक्ति, महिमा, वैभव र प्रताप तपाईंकै हुन्; किनकि स्वर्गमा र पृथ्वीमा भएका सबै थोकहरू सदासर्वदाका निम्ति तपाईंकै हुन्। हे याहवेह, राज्य, तपाईंकै हो; तपाईं सबैमाथि सर्वोच्‍च हुनुहुन्छ।<verse eid="1CH 29:11"/></para>
<para style="p"><verse number="12" style="v" sid="1CH 29:12"/>धनसम्पत्ति र मान-सम्मान तपाईंबाट नै आउँछन्; तपाईं सबै कुराहरूको शासक हुनुहुन्छ। सबैलाई उच्‍च पार्न र सामर्थ्य तुल्याउन, पराक्रम र सामर्थ्य तपाईंकै हातमा छन्।<verse eid="1CH 29:12"/></para>
<para style="p"><verse number="13" style="v" sid="1CH 29:13"/>अनि अब, हे हाम्रा परमेश्‍वर, हामी तपाईंलाई धन्यवाद चढाउँछौँ, र तपाईंको महिमित नामको प्रशंसा गर्छौँ।<verse eid="1CH 29:13"/></para>
<para style="p"><verse number="14" style="v" sid="1CH 29:14"/>“तर म को हुँ र? मेरा मानिसहरू के हुन् र? कि यस प्रकारले उदार चित्तले दिन सक्ने? हरेक कुराहरू तपाईंबाटै आउँछन्। हामीले त तपाईंका हातबाट आएका कुरा नै दिएका छौँ।<verse eid="1CH 29:14"/></para>
<para style="p"><verse number="15" style="v" sid="1CH 29:15"/>हामी तपाईंको दृष्‍टिमा हाम्रा सबै पुर्खाहरूझैँ परदेशी र प्रवासीहरू हौँ। यस पृथ्वीमा हाम्रा दिनहरू छायाजस्तै छन् र कुनै आशा छैन।<verse eid="1CH 29:15"/></para>
<para style="p"><verse number="16" style="v" sid="1CH 29:16"/>हे याहवेह हाम्रा परमेश्‍वर, तपाईंको पवित्र नामको खातिर मन्दिर बनाउनका निम्ति हामीले प्रबन्ध गरेका यी सबै प्रशस्त कुराहरू तपाईंकै हातबाट आएको हो, र यी सबै कुराहरू तपाईंकै हो।<verse eid="1CH 29:16"/></para>
<para style="p"><verse number="17" style="v" sid="1CH 29:17"/>मेरा परमेश्‍वर, तपाईंले हृदय जाँच्नुहुन्छ र इमानदारीसँग तपाईं खुशी हुनुहुन्छ भनी म जान्दछु। यी सबै कुराहरू मैले राजीखुशीसाथ र साँचो मनले दिएको हुँ। अनि अहिले यहाँ भएका तपाईंका मानिसहरूले कति राजीखुशीसँग आनन्दसाथ तपाईंलाई दिएका छन्, त्यो मैले देखेको छु।<verse eid="1CH 29:17"/></para>
<para style="p"><verse number="18" style="v" sid="1CH 29:18"/>हे याहवेह, हाम्रा पुर्खा अब्राहाम, इसहाक र इस्राएलका परमेश्‍वर, तपाईंका मानिसहरूका हृदयमा यो विचार सदासर्वदा कायम राख्नुहोस्; अनि तिनीहरूका हृदय तपाईंप्रति विश्‍वासयोग्य बनाइराख्नुहोस्।<verse eid="1CH 29:18"/></para>
<para style="p"><verse number="19" style="v" sid="1CH 29:19"/>मेरो छोरा सोलोमनलाई तपाईंका आज्ञाहरू, तपाईंका नियमहरू र उर्दीहरू पालन गर्न; अनि मैले जुटाएका यी सबै कुराले यस भवनको ढाँचा निर्माण गर्न सम्पूर्ण हृदयले गर्ने इच्छा दिनुहोस्।”<verse eid="1CH 29:19"/></para>
<para style="p"><verse number="20" style="v" sid="1CH 29:20"/>तब दावीदले सम्पूर्ण समुदायलाई भने, “याहवेह तिमीहरूका परमेश्‍वरको प्रशंसा गर!” यसकारण तिनीहरू सबैले याहवेह, तिनीहरूका पुर्खाहरूका परमेश्‍वरको प्रशंसा गरे; तिनीहरूले याहवेह र राजाको सामु भुइँमा लम्पसार परेर दण्डवत् गरे।<verse eid="1CH 29:20"/></para>
<para style="p"><verse number="21" style="v" sid="1CH 29:21"/>भोलिपल्ट तिनीहरूले याहवेहलाई बलिदानहरू र अन्‍नबलि चढाए: सारा इस्राएलको तर्फबाट एक हजार गोरु, एक हजार भेडा, एक हजार थुमा र अर्घबलिको साथमा प्रशस्त मात्रामा अरू बलिदानहरू चढाए।<verse eid="1CH 29:21"/></para>
<para style="p"><verse number="22" style="v" sid="1CH 29:22"/>त्यस दिन तिनीहरूले याहवेहको उपस्थितिमा अति आनन्दसाथ खानपिन गरे। तब तिनीहरूले दावीदका छोरा सोलोमनलाई दोस्रो पटक राजा घोषणा गरे। अनि तिनलाई शासक हुन र सादोकलाई पुजारी हुन याहवेहको सामु अभिषेक गरे।<verse eid="1CH 29:22"/></para>
<para style="p"><verse number="23" style="v" sid="1CH 29:23"/>यसरी सोलोमन आफ्ना पिता दावीदको स्थानमा राजाको रूपमा याहवेहको सिंहासनमा बसे। तिनी सफल राजा भए, र सारा इस्राएलले तिनको आज्ञापालन गर्थे।<verse eid="1CH 29:23"/></para>
<para style="p"><verse number="24" style="v" sid="1CH 29:24"/>सबै अधिकारी र वीर योद्धाहरू, साथै दावीद राजाका छोराहरूले समेत तिनीहरू राजा सोलोमनको अधीनमा रहने प्रतिज्ञा गरे।<verse eid="1CH 29:24"/></para>
<para style="p"><verse number="25" style="v" sid="1CH 29:25"/>याहवेहले सोलोमनलाई सम्पूर्ण इस्राएलको दृष्‍टिमा अति उच्‍च पार्नुभयो। अनि इस्राएलका अगिका कुनै राजाले पनि नपाएको राजकीय वैभव तिनलाई दिनुभयो।<verse eid="1CH 29:25"/></para>
<para style="p"><verse number="26" style="v" sid="1CH 29:26"/>दावीद यिशैको छोरा सम्पूर्ण इस्राएलभरि राजा थिए।<verse eid="1CH 29:26"/></para>
<para style="p"><verse number="27" style="v" sid="1CH 29:27"/>तिनले इस्राएलमा चालीस वर्ष राज्य गरे—हेब्रोनमा सात वर्ष र यरूशलेममा तेत्तीस वर्ष।<verse eid="1CH 29:27"/></para>
<para style="p"><verse number="28" style="v" sid="1CH 29:28"/>तिनले दीर्घकालीन जीवन, धनसम्पत्ति र मान-सम्मान उपभोग गरेर पूरा वृद्ध उमेरमा मरे; अनि तिनीपछि तिनका छोरा सोलोमन राजा भए।<verse eid="1CH 29:28"/></para>
<para style="p"><verse number="29" style="v" sid="1CH 29:29"/>दावीद राजाको शासनकालका घटनाहरू, सुरुदेखि अन्त्यसम्म दर्शी शमूएलका लेखहरूमा, अगमवक्ता नातानका लेखहरूमा र दर्शी गादका लेखहरूमा लेखिएका छन्;<verse eid="1CH 29:29"/></para>
<para style="p"><verse number="30" style="v" sid="1CH 29:30"/>साथै तिनको शासन र शक्तिको बारेमा तिनका अरू चारैतिरका सबै छिमेकी देशका राज्यहरूमा के कस्ता परिस्थितिहरू आइपरे भन्‍ने बारेमा इस्राएल र अरू छिमेकी राज्यहरूको बारेमा पनि सम्पूर्ण विवरणहरू लेखिएका छन्।<verse eid="1CH 29:30"/></para>
<chapter eid="1CH 29"/>
</usx>