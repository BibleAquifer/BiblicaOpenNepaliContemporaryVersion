<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="DEU" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">व्यवस्था</para>
<para style="toc1">व्यवस्था</para>
<para style="toc2">व्यवस्था</para>
<para style="mt1">व्यवस्था</para>
<chapter number="1" style="c" sid="DEU 1"/>
<para style="p"><verse number="1" style="v" sid="DEU 1:1"/>मोशाले यर्दनको पूर्वको उजाडस्थानमा अर्थात् अराबामा सूपको सामु—पारान एकापट्टि र अर्कोपट्टि तोफेल, लाबान, हसेरोत र दीसाहाबको बीचमा सबै इस्राएलीहरूलाई भनेका वचनहरू यिनै हुन्।<verse eid="DEU 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 1:2"/>(सेइर पर्वतको बाटोबाट होरेब पर्वतहुँदै कादेश-बर्नेसम्म जानलाई एघार दिन लाग्छ)।<verse eid="DEU 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 1:3"/>चालीसौँ वर्षको एघारौँ महिनाको पहिलो दिन याहवेहले इस्राएलीहरूको बारेमा मोशालाई आज्ञा दिनुभएका सबै कुरा तिनले तिनीहरूलाई घोषणा गरे।<verse eid="DEU 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 1:4"/>योचाहिँ मोशाले हेश्बोनमा राज्य गर्ने एमोरीहरूका राजा सीहोन र अस्तारोतमा राज्य गर्ने बाशानको राजा ओगलाई एद्रईमा जितेपछिको कुरा हो।<verse eid="DEU 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 1:5"/>यर्दन नदीको पूर्वपट्टि मोआबको प्रान्तमा मोशाले यही व्यवस्था व्याख्या गर्दै भने:<verse eid="DEU 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 1:6"/>होरेब पर्वतमा याहवेह हाम्रा परमेश्‍वरले हामीलाई भन्‍नुभयो, “तिमीहरू यस पर्वतमा बसेको धेरै समय भइसक्यो।<verse eid="DEU 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 1:7"/>अब तिमीहरूको छाउनी तोडेर एमोरीहरूको पहाडी मुलुकतिर अगि बढ। अराबाका सबै छिमेकी प्रान्तहरूमा, पर्वतहरूमा, पश्‍चिमका तराईहरूमा, दक्षिणमा र किनारका ठाउँहरूहुँदै, कनानीहरूको देश र लेबनान र महानदी यूफ्रेटिससम्म जाओ।<verse eid="DEU 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 1:8"/>हेर, मैले यो देश तिमीहरूलाई दिएको छु। मैले तिमीहरूका पुर्खाहरू अब्राहाम, इसहाक, याकोब र तिनीहरूका सन्ततिलाई दिन्छु भनी प्रतिज्ञा गरेको देशमा तिमीहरू गएर अधिकार गर।”<verse eid="DEU 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 1:9"/>मोशाले भने, “त्यस समय मैले तिमीहरूलाई भनेको थिएँ, म एकलै तिमीहरूको बोझ उठाउन सक्दिनँ।<verse eid="DEU 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 1:10"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूको संख्यामा वृद्धि गरिदिनुभएको छ। आज तिमीहरू आकाशका ताराहरूझैँ अनगन्ती भएका छौ।<verse eid="DEU 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 1:11"/>तिमीहरूका पितापुर्खाहरूका परमेश्‍वर याहवेहले प्रतिज्ञा गर्नुभएअनुसार उहाँले तिमीहरूलाई हजार गुणा वृद्धि गरिदेऊन्, र आशिष् देऊन्।<verse eid="DEU 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 1:12"/>तर म आफैँले मात्र तिमीहरूका समस्याहरू, तिमीहरूका बोझहरू र तिमीहरूका झगडाहरू कसरी झेल्न सक्छु र?<verse eid="DEU 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 1:13"/>तिमीहरूका कुलहरूबाट केही बुद्धिमान्, समझदार र अनुभवी मानिसहरूलाई रोज। अनि म तिनीहरूलाई तिमीहरूमाथि अगुवा नियुक्त गर्नेछु।”<verse eid="DEU 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 1:14"/>तिमीहरूले मलाई जवाफ दियौ, “तपाईंले दिनुभएको प्रस्ताव असल छ।”<verse eid="DEU 1:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 1:15"/>यसकारण मैले तिमीहरूका कुलहरूबाट मुख्य व्यक्ति, बुद्धिमान् र अनुभवी मानिसहरूलाई लिएर तिनीहरूलाई हजार-हजार, सय-सय, पचास-पचासमाथि र दश-दशमाथि प्रशासकको रूपमा तिमीहरूमाथि अधिकार गर्नलाई नियुक्त गरेँ।<verse eid="DEU 1:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 1:16"/>अनि त्यस बेला मैले तिमीहरूका न्यायकर्ताहरूलाई यसो भनेर जिम्मा दिएको थिएँ, “तिमीहरूका मानिसहरूका बीचका झगडा सुन। चाहे त्यो मुद्दा इस्राएलीहरूका बीचमा होस् अथवा तिनीहरूमध्ये एक जना इस्राएली र अर्कोचाहिँ तिमीहरूसँग बसोबास गर्ने विदेशीको बीचमा होस्। न्याय उचित रूपले गर।<verse eid="DEU 1:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 1:17"/>न्याय गर्दा पक्षपात नगर्नू। ठूला र साना दुवैका कुरा तिमीहरूले समान रूपले सुन्‍नू। न्याय परमेश्‍वरबाट भएको हुनाले कुनै मानिससँग नडराउनू। तिमीहरूका निम्ति अति कठिन भएको मुद्दा मकहाँ ल्याउनू। म त्यसको फैसला गर्नेछु।”<verse eid="DEU 1:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 1:18"/>अनि मैले त्यस बेला तिमीहरूले गर्नुपर्ने हरेक कुरा तिमीहरूलाई भनेको थिएँ।<verse eid="DEU 1:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 1:19"/>त्यसपछि याहवेह हाम्रा परमेश्‍वरले हामीलाई आज्ञा गर्नुभएझैँ, हामी होरेब पर्वतबाट निस्क्यौँ। अनि तिमीहरूले देखेका डरलाग्दो र ठूलो उजाडस्थानबाट भएर हामी एमोरीहरूको पहाडी देशतिर गयौँ। यसरी हामी कादेश-बर्नेमा पुग्यौँ।<verse eid="DEU 1:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 1:20"/>तब मैले तिमीहरूलाई भनेँ, “तिमीहरू एमोरीहरूको पहाडी देशमा आइपुगेका छौ, जुन देश याहवेह हाम्रा परमेश्‍वरले हामीलाई दिनुहुनेछ।<verse eid="DEU 1:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 1:21"/>हेर, याहवेह तिमीहरूका परमेश्‍वरले यो देश तिमीहरूलाई दिनुभएको छ। याहवेह तिमीहरूका पितापुर्खाहरूका परमेश्‍वरले तिनीहरूलाई भन्‍नुभएझैँ त्यस देशमा तिमीहरू उक्लेर जाओ, र अधिकार गर। तिमीहरू नडराओ; हतोत्साहित नहोओ।”<verse eid="DEU 1:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 1:22"/>तब तिमीहरू सबै मकहाँ आएर भन्यौ, “हाम्रा निम्ति त्यस देशको जासुस गर्नलाई हामीले जानुपर्ने बाटो र हामी पुग्ने सहरहरूको बारेमा जानकारी ल्याउनलाई हाम्रा अगि जासुसी गर्ने मानिसहरू पठाऔँ।”<verse eid="DEU 1:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 1:23"/>यो कुरो मलाई असल लाग्यो; अनि मैले हरेक कुलबाट एक-एक जना गरी बाह्र जनालाई छानेँ।<verse eid="DEU 1:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 1:24"/>तिनीहरू हिँडे, र पहाडी इलाकातिर पुगे। तब तिनीहरू एश्कोलको बेँसीमा आए, र त्यस ठाउँको जासुस गरे।<verse eid="DEU 1:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 1:25"/>तिनीहरूले साथमा त्यस देशका केही फलफूल हामीहरूकहाँ ल्याए, र तिनीहरूले जानकारी दिए, “याहवेह हाम्रा परमेश्‍वरले हामीलाई दिनुहुने देश असल रहेछ।”<verse eid="DEU 1:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 1:26"/>तर तिमीहरूले अगि जाने इच्छा गरेनौ; तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको आज्ञाको विरुद्ध विद्रोह गर्‍यौ।<verse eid="DEU 1:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 1:27"/>तिमीहरूले आफ्ना पालहरूमा गनगन गर्दै भन्यौ, “याहवेहले हामीलाई घृणा गर्नुहुन्छ। यसैकारण उहाँले हामीलाई एमोरीहरूका हातद्वारा नष्‍ट गर्नलाई इजिप्टबाट निकालेर ल्याउनुभयो।<verse eid="DEU 1:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 1:28"/>हामी कहाँ जाऔँ? हाम्रा दाजुभाइहरूले हामीलाई भयभीत बनाएका छन्। तिनीहरू भन्छन्, ‘ती मानिसहरू हामीभन्दा बलिया र अग्ला छन्। त्यहाँका सहरहरू ठूला आकाशसम्म पुग्ने पर्खाल भएका छन्। हामीले त्यहाँ अनाकीहरूलाई पनि देख्यौँ।’ ”<verse eid="DEU 1:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 1:29"/>तब मैले तिमीहरूलाई भनेँ, “तिमीहरू भयभीत नहोओ; र तिनीहरूसँग नडराओ।<verse eid="DEU 1:29"/></para>
<para style="p"><verse number="30" style="v" sid="DEU 1:30"/>याहवेह तिमीहरूका परमेश्‍वर तिमीहरूका अगि जानुहुनेछ। अनि तिमीहरूका पक्षमा लड्नुहुनेछ; जसरी इजिप्टमा तिमीहरूका निम्ति तिमीहरूकै आँखाको अगि उजाडस्थानमा लड्नुभएको थियो।<verse eid="DEU 1:30"/></para>
<para style="p"><verse number="31" style="v" sid="DEU 1:31"/>अनि तिमीहरू यस ठाउँसम्म नआइपुगुन्जेल याहवेह तिमीहरूका परमेश्‍वरले आफ्ना छोराछोरीलाई बुबाले बोकेझैँ उहाँले बाटोभरि उजाडस्थानमा तिमीहरूलाई कसरी बोक्नुभयो, त्यो तिमीहरूले देख्यौ।”<verse eid="DEU 1:31"/></para>
<para style="p"><verse number="32" style="v" sid="DEU 1:32"/>तर अझ पनि याहवेह तिमीहरूका परमेश्‍वरमाथि तिमीहरूले भरोसा गरेनौ।<verse eid="DEU 1:32"/></para>
<para style="p"><verse number="33" style="v" sid="DEU 1:33"/>उहाँ तिमीहरूले छाउनी बनाउने ठाउँहरू खोज्न र तिमीहरूले हिँड्नुपर्ने बाटो देखाउन राति आगोमा र दिउँसो बादलमा भई तिमीहरूलाई बाटो देखाउन अगि-अगि जानुभयो।<verse eid="DEU 1:33"/></para>
<para style="p"><verse number="34" style="v" sid="DEU 1:34"/>जब तिमीहरूको गनगन याहवेहले सुन्‍नुभयो, तब उहाँ रिसाउनुभयो। अनि उहाँले शपथ लिनुभयो,<verse eid="DEU 1:34"/></para>
<para style="p"><verse number="35" style="v" sid="DEU 1:35"/>“मैले तिमीहरूका पितापुर्खाहरूलाई दिन्छु भनी प्रतिज्ञा गरेको असल देशलाई यस दुष्‍ट पुस्ताको एउटै मानिसले पनि देख्नेछैन।<verse eid="DEU 1:35"/></para>
<para style="p"><verse number="36" style="v" sid="DEU 1:36"/>यपून्‍नेको छोरा कालेबचाहिँ अपवाद हो। उसले मात्र त्यो देश देख्नेछ। अनि म त्यसलाई र त्यसका सन्तानलाई त्यसले आफ्नो पाइला टेकेको देश दिनेछु। किनकि त्यसले याहवेहलाई आफ्नो सारा हृदयले पछ्याएको छ।”<verse eid="DEU 1:36"/></para>
<para style="p"><verse number="37" style="v" sid="DEU 1:37"/>तिमीहरूकै कारण याहवेह मसँग पनि रिसाउनुभयो र भन्‍नुभयो, “तँ पनि त्यो देशमा प्रवेश गर्नेछैनस्।<verse eid="DEU 1:37"/></para>
<para style="p"><verse number="38" style="v" sid="DEU 1:38"/>तर तेरो सहायक नूनका छोरा यहोशूले त्यहाँ प्रवेश गर्नेछ। त्यसलाई उत्साह दे। किनकि त्यसले त्यस देशमा अधिकार गर्नलाई इस्राएलीहरूलाई डोर्‍याउनेछ।<verse eid="DEU 1:38"/></para>
<para style="p"><verse number="39" style="v" sid="DEU 1:39"/>अनि तिमीहरूका छोराछोरीहरू, जसलाई कैदमा लगिनेछ भनी तिमीहरू भन्छौ, जो असल र खराब अहिले छुट्याउन सक्दैनन्, तिनीहरू त्यस देशमा प्रवेश गर्नेछन्। म त्यो देश तिनीहरूलाई दिनेछु र तिनीहरूले त्यस देशमा अधिकार गर्नेछन्।<verse eid="DEU 1:39"/></para>
<para style="p"><verse number="40" style="v" sid="DEU 1:40"/>तर तिमीहरूचाहिँ फर्केर लाल समुद्रतिर जाने उजाडस्थानको बाटोतिर लाग।”<verse eid="DEU 1:40"/></para>
<para style="p"><verse number="41" style="v" sid="DEU 1:41"/>तब तिमीहरूले मलाई भन्यौ, “हामीले याहवेहको विरुद्धमा पाप गरेका छौँ। याहवेह हाम्रा परमेश्‍वरले आज्ञा गर्नुभएझैँ हामी अगि जानेछौँ र लडाइँ गर्नेछौँ।” यसरी तिमीहरू हरेकले त्यस पहाडी मुलुकमा उक्लेर जान सजिलो छ भनेर आफ्ना हातहतियारहरू भिर्‍यौ।<verse eid="DEU 1:41"/></para>
<para style="p"><verse number="42" style="v" sid="DEU 1:42"/>तर याहवेहले मलाई भन्‍नुभयो, “तिनीहरूलाई भन्, ‘तिमीहरू लडाइँ गर्न नजाओ; किनकि म तिमीहरूसँग हुनेछैन। तिमीहरू आफ्ना शत्रुहरूद्वारा पराजित हुनेछौ।’ ”<verse eid="DEU 1:42"/></para>
<para style="p"><verse number="43" style="v" sid="DEU 1:43"/>यसैकारण मैले तिमीहरूलाई भनेँ, तर तिमीहरूले सुनेनौ। तिमीहरूले याहवेहको आज्ञाको विरोध गर्‍यौ र तिमीहरूको घमण्डमा त्यस पहाडी मुलुकको टुप्पोमा युद्ध गर्न तिमीहरू मोर्चा बाँधेर उक्लियौ।<verse eid="DEU 1:43"/></para>
<para style="p"><verse number="44" style="v" sid="DEU 1:44"/>तब त्यस पहाडी मुलुकमा बस्‍ने एमोरीहरू तिमीहरूको विरुद्धमा निस्किआए। तिनीहरूले तिमीहरूलाई मौरीहरूका हूलले झैँ खेदे, र तिमीहरूलाई सेइरदेखि होर्मासम्मै खेदेर तिमीहरूलाई जिते।<verse eid="DEU 1:44"/></para>
<para style="p"><verse number="45" style="v" sid="DEU 1:45"/>तिमीहरू फर्केर आयौ र याहवेहको सामु रोयौ। तर उहाँले तिमीहरूको रुवाइमा ध्यानै दिनुभएन, र तिमीहरूको पुकार सुन्‍नुभएन।<verse eid="DEU 1:45"/></para>
<para style="p"><verse number="46" style="v" sid="DEU 1:46"/>यसकारण तिमीहरू कादेशमा धेरै दिन बस्यौ—वास्तवमा तिमीहरूले सबै समय त्यहाँ बितायौ।<verse eid="DEU 1:46"/></para>
<chapter eid="DEU 1"/>
<chapter number="2" style="c" sid="DEU 2"/>
<para style="p"><verse number="1" style="v" sid="DEU 2:1"/>त्यसपछि हामी फेरि फर्क्यौँ, र याहवेहले मलाई आज्ञा गर्नुभएअनुसार लाल समुद्र जाने बाटो भएर उजाडस्थानतिर लाग्यौँ। धेरै लामो समयसम्म हामी सेइरको पहाडी देशको वरपर भौँतारी हिँड्यौँ।<verse eid="DEU 2:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 2:2"/>तब याहवेहले मलाई भन्‍नुभयो,<verse eid="DEU 2:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 2:3"/>“तिमीहरू यस पहाडी देशको वरपर घुमिरहेको धेरै भयो। अब तिमीहरू उत्तरतर्फ लाग।<verse eid="DEU 2:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 2:4"/>मानिसहरूलाई यो आज्ञा दे: ‘तिमीहरू आफ्ना आफन्त एसावका सन्तानका इलाकाबाट भएर जान लागेका छौ, जो सेइरमा बस्छ। तिनीहरू तिमीहरूसँग डराउनेछन्, तर तिमीहरू होशियार रहनू।<verse eid="DEU 2:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 2:5"/>तिनीहरूलाई लडाइँ गर्न नउक्साउनू। किनकि म तिमीहरूलाई तिनीहरूका कुनै पनि जमिनको खुट्टा टेक्ने भागधरि दिनेछैनँ। मैले सेइरको पहाडी देश एसावलाई त्यसको आफ्नो अधीनमा हुनलाई दिएको छु।<verse eid="DEU 2:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 2:6"/>तिमीहरूले खाएका भोजन र पिएका पानीको लागि तिमीहरूले तिनीहरूलाई मूल्यको रूपमा चाँदी तिर्नुपर्छ।’ ”<verse eid="DEU 2:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 2:7"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका हातका सबै कामहरूमा आशिष् दिनुभएको छ। यस विशाल उजाडस्थानबाट भएर जाने तिमीहरूका यात्रामा उहाँले तिमीहरूलाई हेरचाह गर्नुभएको छ। यी चालीस वर्षहरूमा याहवेह तिमीहरूका परमेश्‍वर तिमीहरूसँग रहनुभएको छ। अनि तिमीहरूलाई कुनै पनि कुराको अभाव भएको छैन।<verse eid="DEU 2:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 2:8"/>यसरी हामीले एसावका सन्तानहरू हाम्रा आफन्तहरूलाई पार गर्‍यौँ, जो सेइरमा बस्दछन्। एलात र एस्योन-गेबेरबाट माथि पर्ने अराबाको बाटोबाट हामी फर्केर मोआबको उजाडस्थानको बाटोतिर यात्रा गर्‍यौँ।<verse eid="DEU 2:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 2:9"/>तब याहवेहले मलाई भन्‍नुभयो, “मोआबलाई दुःख-कष्‍ट नदिनू, अथवा तिनीहरूलाई लडाइँका निम्ति नउक्साउनू। किनकि म तिमीहरूलाई तिनीहरूका जमिनको कुनै भागसमेत दिनेछैनँ। मैले लोतका सन्ततिलाई आर जमिन अधिकारको रूपमा दिएको छु।”<verse eid="DEU 2:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 2:10"/>(पहिले त्यहाँ एमी भनिने जातिहरू बस्दथे—अनाकीजस्तै अग्ला, बलिया र असंख्य।<verse eid="DEU 2:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 2:11"/>अनाकीहरूजस्तै, तिनीहरूलाई पनि रपाईहरू भनिन्थ्यो। तर मोआबीहरूले तिनीहरूलाई एमीहरू भन्‍ने गर्थे।<verse eid="DEU 2:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 2:12"/>होरीहरू सेइरमा बस्‍ने गर्दथे। तर एसावका सन्ततिले तिनीहरूलाई धपाए। याहवेहले अधिकार गर्न दिनुभएको देशका मानिसहरूलाई इस्राएलीहरूले नाश पारेझैँ, तिनीहरूले पनि होरवंशीहरूलाई नाश पारे। अनि तिनीहरूका ठाउँमा बसोबास गरेका थिए।)<verse eid="DEU 2:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 2:13"/>अनि याहवेहले भन्‍नुभयो, “अब उठ र जेरेदको बेँसी पार गर।” यसकारण हामीले जेरेद बेँसीलाई पार गर्‍यौँ।<verse eid="DEU 2:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 2:14"/>हामीले कादेश-बर्ने छोडेको समयदेखि जेरेद बेँसी पार गर्दासम्म अठतीस वर्ष बितिसकेको थियो। त्यस बेलासम्म याहवेहले तिनीहरूसँग शपथ खानुभएझैँ लडाइँ गर्न सक्ने सबै मानिसहरू छाउनीमा नाश भइसकेका थिए।<verse eid="DEU 2:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 2:15"/>तिनीहरू छाउनीबाट सम्पूर्ण रूपले नाश नहोउन्जेल याहवेहको हात तिनीहरूको विरुद्धमा थियो।<verse eid="DEU 2:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 2:16"/>जब लडाइँ गर्न सक्ने ती मानिसहरूबाट अन्तिम मानिस मरे,<verse eid="DEU 2:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 2:17"/>तब याहवेहले मलाई भन्‍नुभयो,<verse eid="DEU 2:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 2:18"/>“आज तिमीहरूले मोआबको इलाका भएर आरको जमिन पार गर्नुपर्छ।<verse eid="DEU 2:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 2:19"/>जब तिमीहरू अम्मोनीकहाँ आउँछौ, तब तिनीहरूलाई दुःख नदिनू, अथवा लडाइँका लागि नउक्साउनू। किनकि म तिमीहरूलाई अम्मोनीहरूको देशको कुनै पनि भाग अधिकार गर्न दिनेछैनँ। मैले अम्मोन देश लोतका सन्ततिलाई अधिकार गर्न दिएको छु।”<verse eid="DEU 2:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 2:20"/>(त्यो देश पनि रपाईहरूको देश थियो। तिनीहरू त्यहाँ बस्दथे। तर अम्मोनीहरूले तिनीहरूलाई जमजुम्मीहरू भन्‍ने गर्थे।<verse eid="DEU 2:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 2:21"/>तिनीहरू बलिया, असंख्य र अनाकीहरूजस्तै अग्ला थिए। याहवेहले तिनीहरूलाई अम्मोनीहरूको सामुबाट नष्‍ट गरिदिनुभयो। अम्मोनीहरूले तिनीहरूलाई धपाए। अनि तिनीहरूको ठाउँमा बसोबास गर्न थाले।<verse eid="DEU 2:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 2:22"/>याहवेहले एसावका सन्ततिलाई पनि त्यसै गर्नुभयो, जो सेइरमा बस्दथे। उहाँले होरीहरूलाई तिनीहरूको सामुबाट नष्‍ट गरिदिनुभयो। एदोमीहरूले तिनीहरूलाई धपाइदिए। तिनीहरू आजसम्म त्यहाँ बसेका छन्।<verse eid="DEU 2:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 2:23"/>अनि गाजा सहरसम्म रहेका टाढाका गाउँहरूमा बस्‍ने अव्वीहरूलाई चाहिँ कप्‍तोरबाट आएका कप्‍तोरीहरूले नाश गरे, र तिनीहरूका ठाउँमा बसोबास गरे।)<verse eid="DEU 2:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 2:24"/>“अब यात्रा सुरु गर, र अर्नोन बेँसी पार गर। हेर, मैले हेश्बोनको राजा एमोरी सीहोन र त्यसको देशलाई तिमीहरूका हातमा दिएको छु। त्यसलाई अधिकार गर्न सुरु गर, र त्यससँग युद्ध गर।<verse eid="DEU 2:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 2:25"/>आजको दिनबाट म आकाशमुनि भएका सबै जातिहरूमाथि तिमीहरूको डर र भय हालिदिनेछु। जब तिनीहरूले तिमीहरूको बारेमा सुन्‍नेछन्, तब तिनीहरू डर, भय र तनावले काम्नेछन्।”<verse eid="DEU 2:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 2:26"/>कदेमोतको उजाडस्थानबाट मैले हेश्बोनको राजा सीहोनकहाँ शान्ति प्रस्तावसहित राजदूतहरूद्वारा यो सन्देश पठाएँ,<verse eid="DEU 2:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 2:27"/>“हामीलाई तपाईंको देशबाट भएर जान दिनुहोस्। हामी राजमार्गबाट भएर जानेछौँ। हामी दाहिने अथवा देब्रेतिर फर्कनेछैनौँ।<verse eid="DEU 2:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 2:28"/>तपाईंले हामीलाई चाँदीको मूल्यमा खानेकुरा र पिउने पानी बेच्नुहोस्। हामीलाई यस देशबाट पैदल जान अनुमति दिनुहोस्,<verse eid="DEU 2:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 2:29"/>जसरी सेइरवासी एसावका सन्तान र आरको जमिनमा बस्‍ने मोआबीहरूले हामीलाई जान दिए; ताकि हामी यर्दन पार गरेर याहवेह हाम्रा परमेश्‍वरले हामीलाई दिनुभएको देशमा पुग्न सकौँ।”<verse eid="DEU 2:29"/></para>
<para style="p"><verse number="30" style="v" sid="DEU 2:30"/>तर हेश्बोनका राजा सीहोनले हामीलाई त्यस देशबाट भएर जान दिएनन्। किनकि याहवेह तिमीहरूका परमेश्‍वरले तिनलाई तिमीहरूको हातमा सुम्पिदिनका लागि तिनको मन कठोर र हृदय अटेरी बनाउनुभएको थियो; जस्तो आज पनि छ।<verse eid="DEU 2:30"/></para>
<para style="p"><verse number="31" style="v" sid="DEU 2:31"/>याहवेहले मलाई भन्‍नुभयो, “हेर्, मैले सीहोन र त्यसको देशलाई तेरो हातमा सुम्पिदिन थालेको छु। अब त्यसलाई आक्रमण गर्न र अधिकार गर्न सुरु गर्।”<verse eid="DEU 2:31"/></para>
<para style="p"><verse number="32" style="v" sid="DEU 2:32"/>जब सीहोन र तिनका सबै सेना यहसाको जमिनमा हामीसँग युद्ध गर्न आए,<verse eid="DEU 2:32"/></para>
<para style="p"><verse number="33" style="v" sid="DEU 2:33"/>तब याहवेह हाम्रा परमेश्‍वरले तिनलाई हाम्रो हातमा सुम्पिदिनुभयो। अनि हामीले तिनलाई, तिनका छोराहरू र सारा सेनाहरूसमेत मार्‍यौँ।<verse eid="DEU 2:33"/></para>
<para style="p"><verse number="34" style="v" sid="DEU 2:34"/>त्यस बेला हामीले तिनका सबै सहरहरू लियौँ। तिनीहरूका मानिसहरू, स्त्रीहरू र छोराछोरीहरू सबैलाई सम्पूर्ण रूपले नष्‍ट गर्‍यौँ। हामीले कसैलाई पनि जीवित छोडेनौँ।<verse eid="DEU 2:34"/></para>
<para style="p"><verse number="35" style="v" sid="DEU 2:35"/>तर हामीले कब्जा गरेका सहरहरूका गाईबस्तु र लुटको मालसामानचाहिँ आफ्नै लागि लिएर गयौँ।<verse eid="DEU 2:35"/></para>
<para style="p"><verse number="36" style="v" sid="DEU 2:36"/>अर्नोन बेँसीको छेउमा भएको अरोएरदेखि र बेँसीमा भएको सहरदेखि गिलाद प्रान्तसम्मै भएका कुनै पनि सहर हाम्रा लागि शक्तिशाली थिएनन्। याहवेह हाम्रा परमेश्‍वरले ती सबै देशहरू हामीलाई दिनुभयो।<verse eid="DEU 2:36"/></para>
<para style="p"><verse number="37" style="v" sid="DEU 2:37"/>तर याहवेह हाम्रा परमेश्‍वरको आज्ञाअनुसार तिमीहरूले अम्मोनीहरूका कुनै पनि ठाउँ मिचेनौ, न त यब्बोक नदीका किनारका देश वा पहाडका वरपरका सहरहरूलाई मिच्यौ।<verse eid="DEU 2:37"/></para>
<chapter eid="DEU 2"/>
<chapter number="3" style="c" sid="DEU 3"/>
<para style="p"><verse number="1" style="v" sid="DEU 3:1"/>त्यसपछि हामी फर्केर बाशान जाने बाटोतिर उक्ल्यौँ। अनि बाशानका राजा ओग आफ्नो सारा फौज लिएर हामीलाई एद्रईमा युद्ध गर्न निस्किआए।<verse eid="DEU 3:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 3:2"/>याहवेहले मलाई भन्‍नुभयो, “त्यससँग नडरा; किनकि मैले त्यसलाई, त्यसका सबै सेनालाई र त्यसको देशसमेत तेरो हातमा सुम्पिदिएको छु। तैँले त्यसलाई हेश्बोनमा शासन गर्ने एमोरीहरूका राजा सीहोनलाई गरेजस्तै गर्नू।”<verse eid="DEU 3:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 3:3"/>यसरी याहवेह हाम्रा परमेश्‍वरले बाशानका राजा ओग र तिनका सारा सेनालाई हाम्रा हातमा सुम्पिदिनुभयो। हामीले तिनीहरूलाई एउटै पनि मानिस जीवित नरहुन्जेल मार्‍यौँ।<verse eid="DEU 3:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 3:4"/>त्यसै बेला हामीले त्यसका सबै सहरहरू कब्जा गर्‍यौँ। हामीले एउटै पनि सहर नछोडी त्यसका सबै साठी वटा सहरहरू कब्जा गर्‍यौँ। बाशानमा ओगको राज्य अर्गोबको सम्पूर्ण इलाकासमेत कब्जा गर्‍यौँ।<verse eid="DEU 3:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 3:5"/>ती सबै सहरहरू अग्ला-अग्ला पर्खालहरूले घेरिएका, आग्ला सहितका ढोकाहरू र मूलढोकाहरूले बनाइएका थिए। त्यहाँ पर्खाल नभएका धेरै गाउँहरू पनि थिए।<verse eid="DEU 3:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 3:6"/>अनि हामीले हेश्बोनका राजा सीहोनलाई गरेझैँ उनीहरूका सबै सहरहरू, पुरुषहरू, स्त्रीहरू र बालबालिकाहरूलाई सम्पूर्ण रूपले नाश गर्‍यौँ।<verse eid="DEU 3:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 3:7"/>तर सहरका सबै गाईबस्तु र लुटका मालसामानचाहिँ हामीले आफ्नै निम्ति लियौँ।<verse eid="DEU 3:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 3:8"/>यसरी त्यस बेला हामीले यी दुई एमोरी राजाहरूबाट यर्दनका पूर्वपट्टि भएको प्रान्त, अर्नोन बेँसीबाट हेर्मोन पर्वतसम्मै अधीनमा पार्‍यौँ।<verse eid="DEU 3:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 3:9"/>(सीदोनीहरूले हेर्मोन पर्वतलाई सिरिओन र एमोरीहरूले सेनीर भन्दछन्)।<verse eid="DEU 3:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 3:10"/>हामीले तराईका सबै सहरहरू, सम्पूर्ण गिलाद, सलेका र एद्रईसम्मका सम्पूर्ण बाशानमा भएका ओगको राज्य अधीनमा लियौँ।<verse eid="DEU 3:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 3:11"/>(रपाईहरूमा बाशानका राजा ओग मात्र जीवित रहेका थिए। तिनको चिहान फलामबाट बनिएको थियो। त्यो नौ क्यूबिट लामो, चार क्यूबिट चौडा थियो। यो अझसम्म अम्मोनीहरूको रब्बामा छ।)<verse eid="DEU 3:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 3:12"/>त्यस बेला हामीले अधिकार लिएको देशबाट मैले रूबेन र गादका घरानाहरूलाई गिलादको पहाडी मुलुकको आधा भागसँगै त्यसका सहरहरूसमेत गरी अर्नोन बेँसीको छेउमा भएका अरोएरका उत्तरको प्रान्त दिएँ।<verse eid="DEU 3:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 3:13"/>गिलादको बाँकी रहेको भाग र ओगको राज्य बाशान पनि मैले मनश्शेको कुललाई दिएँ। (बाशानमा अर्गोबका सम्पूर्ण इलाकालाई रपाईहरूको देश भनिन्थ्यो।<verse eid="DEU 3:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 3:14"/>मनश्शेको सन्तान याईरले अर्गोबको समस्त इलाका, गेशूरी र माकातीहरूका सिमानासम्मै कब्जा गरे। बाशान प्रान्तलाई आफ्नै नाम दिए। आजसम्मै बाशानलाई हब्बोत-याईर भनिन्छ)।<verse eid="DEU 3:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 3:15"/>अनि मैले गिलादचाहिँ माकीरलाई दिएँ।<verse eid="DEU 3:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 3:16"/>तर रूबेनी र गादीहरूलाई मैले गिलाददेखि फैलिएर अर्नोन बेँसीसम्म गएको प्रान्त दिएँ (बेँसीको मध्य भागचाहिँ सिमाना थियो) र अम्मोनीहरूको सिमाना यब्बोक नदीसम्मै तिनीहरूलाई दिएँ।<verse eid="DEU 3:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 3:17"/>त्यसको पश्‍चिमी सिमानाचाहिँ अराबा थियो, जहाँ यर्दन नदी बग्दथ्यो। किन्‍नरेतदेखि पिसगाको भिरको तल अराबाको समुद्र (अराबा समुद्रको अर्को नाम मृत सागर पनि हो) सम्म थियो।<verse eid="DEU 3:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 3:18"/>त्यस समयमा मैले तिमीहरूलाई यसरी आज्ञा दिएँ: “याहवेह तिमीहरूका परमेश्‍वरले यो देश तिमीहरूले अधिकार गर्नु भनी दिनुभएको छ। तर तिमीहरूका सबै बलिया मानिसहरू युद्धका निम्ति हतियार भिरेर तिमीहरूका इस्राएली दाजुभाइहरूको अगि यर्दन नदी पार गरेर जानुपर्छ।<verse eid="DEU 3:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 3:19"/>तरै पनि तिमीहरूका पत्नीहरू, तिमीहरूका छोराछोरीहरू र तिमीहरूका गाईबस्तु (तिमीहरूसँग धेरै गाईबस्तु छन् भनी म जान्दछु) चाहिँ मैले दिएको सहरमा बस्‍न सक्छन्।<verse eid="DEU 3:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 3:20"/>जबसम्म याहवेहले तिमीहरूलाई दिनुभएजस्तै तिमीहरूका दाजुभाइहरूलाई विश्राम दिनुहुन्‍न, र तिनीहरूले याहवेह तिनीहरूका परमेश्‍वरले तिनीहरूलाई यर्दनपारि दिनुहुने देश प्राप्‍त गर्दैनन्, तिमीहरूले तिनीहरूलाई मदत गर्नुपर्नेछ। त्यसपछि तिमीहरू हरेक मैले तिमीहरूलाई अधिकार गर्न दिएको देशमा फर्केर जान सक्छौ।”<verse eid="DEU 3:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 3:21"/>त्यस बेला मैले यहोशूलाई आज्ञा गरेँ: “याहवेह तिमीहरूका परमेश्‍वरले ती दुई राजाहरूलाई के गर्नुभयो, सो तिमीहरू सबैले आफ्नै आँखाले देखेका छौ। तिमीहरू जहाँ गइरहेका छौ, त्यहाँका सबै राज्यहरूलाई पनि याहवेहले त्यसै गर्नुहुनेछ।<verse eid="DEU 3:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 3:22"/>तिनीहरूसँग नडराओ; याहवेह तिमीहरूका परमेश्‍वर आफैँ तिमीहरूका निम्ति लड्नुहुनेछ।”<verse eid="DEU 3:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 3:23"/>अनि मैले त्यस बेला याहवेहसँग यसरी बिन्ती गरे:<verse eid="DEU 3:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 3:24"/>“हे प्रभु याहवेह, आफ्नो सेवकलाई आफ्नो महानता र आफ्नो शक्ति तपाईंले देखाउन थाल्नुभएको छ। किनकि स्वर्ग वा पृथ्वीमा कुनचाहिँ देव छ, जसले तपाईंले गर्नुभएका शक्तिशाली कार्यहरू र कामहरू गर्न सक्छन्?<verse eid="DEU 3:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 3:25"/>मलाई यर्दन नदी पारिको त्यो उत्तम देशमा जान, त्यो सुन्दर पहाडी मुलुक र लेबनानलाई हेर्न दिनुहोस्।”<verse eid="DEU 3:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 3:26"/>तर तिमीहरूको कारण याहवेह मसँग रिसाउनुभएको थियो, र उहाँले मेरो कुरा सुन्‍नुभएन। याहवेहले भन्‍नुभयो, “अब भयो, मसँग यस बारेमा फेरि कुरा नगर्।<verse eid="DEU 3:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 3:27"/>पिसगाको चुचुरोमा चढ्, र पूर्व, पश्‍चिम, उत्तर र दक्षिण चारैतिर हेर्। तैँले त्यस देशलाई आफ्नै आँखाले हेर्। किनकि तैँले यर्दन नदी पार गरेर जान पाउनेछैनस्।<verse eid="DEU 3:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 3:28"/>तर यहोशूलाई नियुक्त गर्, र त्यसलाई उत्साह दिएर बलियो बना। किनकि यस जातिलाई त्यसले पारि लैजानेछ र तैँले देख्न लागेको त्यो देश अधिकार गर्न लगाउनेछ।”<verse eid="DEU 3:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 3:29"/>यसकारण हामी बेथ-पोरको बेँसीको छेउमा नै बस्यौँ।<verse eid="DEU 3:29"/></para>
<chapter eid="DEU 3"/>
<chapter number="4" style="c" sid="DEU 4"/>
<para style="p"><verse number="1" style="v" sid="DEU 4:1"/>अब हे इस्राएलीहरू हो, मैले तिमीहरूलाई सिकाउन लागेका उर्दीहरू र व्यवस्थाहरू सुन। त्यसअनुसार चल्यौ भने तिमीहरू बाँच्नेछौ। अनि याहवेह तिमीहरूका पुर्खाहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने त्यस देशमा अधिकार गर्न सक्नेछौ।<verse eid="DEU 4:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 4:2"/>मैले तिमीहरूलाई दिएका आज्ञाहरूमा केही नथप्नू, न त त्यसबाट केही घटाउनू। तर मैले तिमीहरूलाई दिएका याहवेह तिमीहरूका परमेश्‍वरका आज्ञाहरू पालन गर्नू।<verse eid="DEU 4:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 4:3"/>बाल-पिओरमा याहवेहले के गर्नुभएको थियो, त्यो तिमीहरूले आफ्नै आँखाले देखेका छौ। पिओरमा बालको पछि लाग्ने हरेकलाई तिमीहरूका बीचबाट याहवेह तिमीहरूका परमेश्‍वरले नाश गर्नुभयो।<verse eid="DEU 4:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 4:4"/>तर याहवेह तिमीहरूका परमेश्‍वरसँग विश्‍वासयोग्य रहेका जति सबै आजसम्म जीवितै छौ।<verse eid="DEU 4:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 4:5"/>हेर, मैले याहवेह मेरा परमेश्‍वरले मलाई आज्ञा गर्नुभएझैँ, तिमीहरूलाई उर्दीहरू र व्यवस्थाहरू सिकाएको छु, ताकि तिमीहरूले अधिकार गर्न गइरहेको देशमा तिमीहरूले पालन गर्न सक।<verse eid="DEU 4:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 4:6"/>तिमीहरूले ती होसियारीसाथ पालन गर; किनकि ती पालन गर्नाले जाति-जातिहरूले तिमीहरूका बुद्धि र समझशक्ति देख्नेछन्, र तिनीहरूले यी उर्दीहरू सुनेर भन्‍नेछन्, “वास्तवमै यो महान् जाति बुद्धिमान् र समझदार मानिसहरू रहेछन्।”<verse eid="DEU 4:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 4:7"/>हामीले प्रार्थना गर्दा याहवेह हाम्रा परमेश्‍वर नजिक हुनुभएजस्तै, अरू कुनचाहिँ जाति यति महान् होला, जसको ईश्‍वर तिनीहरूका नजिक रहन्छ?<verse eid="DEU 4:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 4:8"/>अनि मैले आज तिमीहरूलाई दिएका व्यवस्थाहरूजस्तै धार्मिक उर्दीहरू र व्यवस्थाहरू भएका अर्को कुनचाहिँ महान् जाति छ र?<verse eid="DEU 4:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 4:9"/>केवल होशियार बस, र आफूलाई नियालेर हेर; ताकि तिमीहरू बाँचुन्जेल तिमीहरूका आँखाले देखेका कुराहरू नबिर्सिऊन् अथवा ती तिमीहरूका हृदयबाट हराएर नजाऊन्। ती आफ्ना छोराछोरीहरू र नातिनातिनाहरूलाई सिकाओ।<verse eid="DEU 4:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 4:10"/>तिमीहरू होरेब पर्वतमा याहवेह तिमीहरूका परमेश्‍वरको सामु खडा भएको दिन नबिर्सनू; जुन दिन उहाँले मलाई यसरी भन्‍नुभएको थियो, “समुदायलाई मेरो कुरा सुन्‍न मेरो सामु भेला गर्; ताकि तिनीहरू यस देशमा बाँचुन्जेल मेरो आदर गर्न सिकून्। अनि तिनीहरूले आफ्ना भावी सन्तानहरूलाई पनि सिकाऊन्।”<verse eid="DEU 4:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 4:11"/>तिमीहरू नजिक आएर पर्वतको फेदमा उभियौ। त्यस पर्वतमा घोर अन्धकार र कालो बादल घोर अन्धकारसँगै आगोको ज्वाला आकाशसम्मै उठिरहेको थियो।<verse eid="DEU 4:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 4:12"/>तब याहवेह तिमीहरूसँग त्यस आगोबाट बोल्नुभयो। तिमीहरूले बोल्दै गरेका शब्दहरूको आवाज सुन्यौ; र कुनै आकृति देखेनौ, तर त्यहाँ आवाज मात्र सुनियो।<verse eid="DEU 4:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 4:13"/>उहाँले आफ्नो करार, आफ्ना दश आज्ञाहरू तिमीहरूले पालन गर्नू भनेर तिमीहरूलाई घोषणा गर्नुभयो। त्यसपछि ती आज्ञाहरूलाई ढुङ्गाका दुई वटा पाटीहरूमा लेखिदिनुभयो।<verse eid="DEU 4:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 4:14"/>अनि त्यस बेला याहवेहले मलाई तिमीहरूले यर्दन नदी पार गरेर अधिकार गर्ने देशमा पुगेर पालन गर्न उर्दीहरू र व्यवस्थाहरू सिकाउनू भन्‍ने आज्ञा दिनुभयो।<verse eid="DEU 4:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 4:15"/>होरेब पर्वतमा याहवेह तिमीहरूसँग आगोबाट कुरा गर्नुभएको दिन तिमीहरूले कुनै आकृति देखेनौ। यसकारण तिमीहरू आफैँ होशियार बस।<verse eid="DEU 4:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 4:16"/>यसकारण भ्रष्‍ट भएर आफ्ना निम्ति कुनै प्रकारको प्रतिमूर्ति, पुरुष अथवा स्त्रीको रूपमा,<verse eid="DEU 4:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 4:17"/>अथवा पृथ्वीमा भएको कुनै पशुको अथवा आकाशमा उड्ने कुनै चराको,<verse eid="DEU 4:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 4:18"/>अथवा जमिनमा हिँड्ने कुनै जन्तुको अथवा पानीमा भएको माछाको प्रतिमूर्ति नबनाउनू।<verse eid="DEU 4:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 4:19"/>अनि तिमीहरूले आकाशतिर हेर्दा घाम, जुन र ताराहरू सबै शक्तिहरू देख्यौ भने तिनीहरूका अगि ननिहुरनू। अनि याहवेह तिमीहरूका परमेश्‍वरले आकाशमुनि भएका सबै जातिहरूलाई दिनुभएका सबै चीजहरू पूजा गर्नलाई तिमीहरू नलोभिनू।<verse eid="DEU 4:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 4:20"/>तर तिमीहरूका निम्ति याहवेहले तिमीहरूलाई अहिले भएजस्तै उहाँको उत्तराधिकारका मानिसहरू बन्‍न तिमीहरूलाई त्यस फलाम पगाल्ने भट्टीजस्तो इजिप्टबाट निकालेर ल्याउनुभयो।<verse eid="DEU 4:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 4:21"/>तर तिमीहरूको कारण याहवेह मसँग रिसाउनुभयो। याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई पैतृक अधिकारझैँ दिनुहुने उत्तम देशमा जानलाई मैले यर्दन पार गर्न पाउनेछैन भनी उहाँले शपथ खानुभयो।<verse eid="DEU 4:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 4:22"/>म त यसै देशमा मर्नेछु। म यर्दन नदी पार गर्नेछैन; तर तिमीहरू यर्दन पार भएर त्यस उत्तम देशमा अधिकार गर्न लागेका छौ।<verse eid="DEU 4:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 4:23"/>यसैले याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूसँग गर्नुभएको करार नबिर्सनू। याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई मनाही गर्नुभएको कुनै पनि कुराको प्रतिमूर्ति नबनाउनू।<verse eid="DEU 4:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 4:24"/>किनकि याहवेह तिमीहरूका परमेश्‍वर भस्म पार्ने आगो, डाह गर्ने परमेश्‍वर हुनुहुन्छ।<verse eid="DEU 4:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 4:25"/>तिमीहरूका छोराछोरी र नातिनातिना जन्मिसकेपछि र त्यस देशमा धेरै समय बसिसकेपछि, अर्थात् यदि तिमीहरू भ्रष्‍ट भएर कुनै किसिमका प्रतिमूर्ति बनायौ र याहवेह तिमीहरूका परमेश्‍वरको दृष्‍टिमा दुष्‍ट काम गरेर उहाँलाई रिस उठायौ भने,<verse eid="DEU 4:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 4:26"/>म आज स्वर्ग र पृथ्वीलाई तिमीहरूको विरुद्धमा साक्षी राख्दछु। तिमीहरू अधिकार गर्नलाई यर्दन नदी पार गरेर जान लागेको त्यस देशबाट चाँडै नष्‍ट हुनेछौ। तिमीहरू त्यहाँ लामो समयसम्म बस्‍न पाउनेछैनौ, तर निश्‍चय नै नष्‍ट पारिनेछौ।<verse eid="DEU 4:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 4:27"/>याहवेहले तिमीहरूलाई जाति-जातिहरूका बीचमा छरपस्ट पार्नुहुनेछ। अनि जुन जाति-जातिहरूका बीचमा तिमीहरूलाई धपाउनुहुनेछ, त्यहाँ तिमीहरू थोरै मात्र जीवित रहनेछौ।<verse eid="DEU 4:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 4:28"/>त्यहाँ तिमीहरूले मानिसहरूले काठ र ढुङ्गाबाट बनाएका देख्न नसक्ने, सुन्‍न नसक्ने, खान नसक्ने र सुँघ्न नसक्ने देवी-देवताहरूका पूजा गर्नेछौ।<verse eid="DEU 4:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 4:29"/>तर यदि त्यहाँबाट पनि तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरलाई तिमीहरूका सारा हृदयले र सारा प्राणले खोजी गर्‍यौ भने तिमीहरूले उहाँलाई भेट्टाउनेछौ।<verse eid="DEU 4:29"/></para>
<para style="p"><verse number="30" style="v" sid="DEU 4:30"/>जब तिमीहरू सङ्कष्‍टमा पर्छौ र यी सबै कुराहरू तिमीहरूमा आइपर्नेछन्, तब आखिरमा तिमीहरू याहवेह तिमीहरूका परमेश्‍वरतिर फर्कनेछौ। अनि उहाँका आज्ञाहरू पालन गर्नेछौ।<verse eid="DEU 4:30"/></para>
<para style="p"><verse number="31" style="v" sid="DEU 4:31"/>किनकि याहवेह तिमीहरूका परमेश्‍वर कृपालु परमेश्‍वर हुनुहुन्छ। उहाँले तिमीहरूलाई त्याग्नुहुनेछैन; न त नाश गर्नुहुनेछ अथवा तिमीहरूका पुर्खाहरूसँग शपथद्वारा निश्‍चित गर्नुभएको करार उहाँले बिर्सनुहुनेछैन।<verse eid="DEU 4:31"/></para>
<para style="p"><verse number="32" style="v" sid="DEU 4:32"/>अब पहिलेका दिनहरूको बारेमा तिमीहरूका समयभन्दा धेरै पहिलेका समयको, जुन दिन परमेश्‍वरले पृथ्वीमा मानिसलाई सृष्‍टि गर्नुभयो, त्यस बारेमा सोधिहेर। आकाशका एक छेउदेखि अर्को छेउसम्मका कुराहरू सोधपुछ गरिहेर। के यस्तो महान् कुरा कहिल्यै भएको छ, अथवा के यस्तो कुनै कुरा कहिल्यै सुनिएको छ?<verse eid="DEU 4:32"/></para>
<para style="p"><verse number="33" style="v" sid="DEU 4:33"/>के कुनै अरू मानिसहरूले तिमीहरूले सुनेको जस्तै परमेश्‍वर आगोबाट बोल्नुभएको आवाज सुनेर तिमीहरूजस्तै जीवित रहेका छन्?<verse eid="DEU 4:33"/></para>
<para style="p"><verse number="34" style="v" sid="DEU 4:34"/>याहवेह तिमीहरूका परमेश्‍वरले इजिप्टमा तिमीहरूकै आँखाको सामु गर्नुभएका विपत्तिद्वारा, अलौकिक चिन्हहरूद्वारा, अद्‌भुत कार्यहरूद्वारा, चमत्कारद्वारा, युद्धद्वारा, शक्तिशाली हात र फैलिएको पाखुराद्वारा अथवा महान् र उदेकका कामहरूद्वारा के कुनै देवताले यी कार्यद्वारा अरू जातिहरूबाट आफ्ना निम्ति एउटा जातिलाई कहिल्यै लिएको छ?<verse eid="DEU 4:34"/></para>
<para style="p"><verse number="35" style="v" sid="DEU 4:35"/>याहवेह नै परमेश्‍वर हुनुहुन्छ; उहाँबाहेक अर्को परमेश्‍वर कोही छैन भनी बुझाउनलाई यी सबै कुराहरू तिमीहरूलाई देखाइएका हुन्।<verse eid="DEU 4:35"/></para>
<para style="p"><verse number="36" style="v" sid="DEU 4:36"/>तिमीहरूलाई शिक्षा दिनलाई स्वर्गबाट उहाँले तिमीहरूलाई आफ्नो सोर सुन्‍न लगाउनुभयो। पृथ्वीमा उहाँले तिमीहरूलाई आफ्नो महान् आगो देखाउनुभयो र आगोको बीचबाट तिमीहरूले उहाँका शब्दहरू सुन्यौ।<verse eid="DEU 4:36"/></para>
<para style="p"><verse number="37" style="v" sid="DEU 4:37"/>उहाँले तिमीहरूका पितापुर्खाहरूलाई प्रेम गर्नुभएको कारण तिनीहरूका सन्तानहरूलाई चुन्‍नुभयो। उहाँले तिमीहरूलाई उहाँको उपस्थिति र उहाँको महान् शक्तिद्वारा इजिप्टबाट बाहिर निकालेर ल्याउनुभयो।<verse eid="DEU 4:37"/></para>
<para style="p"><verse number="38" style="v" sid="DEU 4:38"/>उहाँले तिमीहरूभन्दा महान् र शक्तिशाली जातिहरूलाई तिमीहरूकै सामु धपाउन र तिनीहरूको देशमा तिमीहरूलाई ल्याउनुभएको थियो, र त्यो तिमीहरूलाई पैतृक अधिकारको रूपमा दिनलाई यस्तो गर्नुभएको थियो; जुन आजसम्मै तिमीहरूसँग छँदैछ।<verse eid="DEU 4:38"/></para>
<para style="p"><verse number="39" style="v" sid="DEU 4:39"/>माथि स्वर्गमा र तल पृथ्वीमा याहवेह परमेश्‍वर हुनुहुन्छ। उहाँबाहेक अर्को कोही छैन भनी आजको दिन यो कुरा हृदयमा मनन गर, र स्वीकार गर।<verse eid="DEU 4:39"/></para>
<para style="p"><verse number="40" style="v" sid="DEU 4:40"/>मैले आज तिमीहरूलाई दिएका उहाँका उर्दीहरू र आज्ञाहरू पालन गर; ताकि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई सधैँका निम्ति दिनुभएको देशमा तिमीहरू र तिमीहरूका भावी सन्तानहरूलाई असल होस्।<verse eid="DEU 4:40"/></para>
<para style="p"><verse number="41" style="v" sid="DEU 4:41"/>तब मोशाले यर्दन नदीको पूर्वपट्टि तीन वटा सहरहरू अलग गरे।<verse eid="DEU 4:41"/></para>
<para style="p"><verse number="42" style="v" sid="DEU 4:42"/>यदि कसैले योजना गरेर जानाजानी होइन, तर अनजानमा आफ्नो छिमेकीलाई मारेको छ भने त्यो मानिस ती सहरहरूमा भागेर जाओस्। हत्याराले यी सहरहरूमध्ये कुनै एक सहरमा भागेर आफ्नो प्राण बचाओस्।<verse eid="DEU 4:42"/></para>
<para style="p"><verse number="43" style="v" sid="DEU 4:43"/>ती शरणका सहरहरू यिनै थिए: रूबेनीहरूका निम्ति उजाडस्थानको मरुभूमिमा रहेको बेसेर सहर; गादीहरूका निम्ति गिलादमा भएको रामोत सहर र मनश्शेहरूका निम्ति बाशानमा भएको गोलान सहर।<verse eid="DEU 4:43"/></para>
<para style="p"><verse number="44" style="v" sid="DEU 4:44"/>मोशाले इस्राएलीहरूको सामु राखिदिएको व्यवस्था यही हो।<verse eid="DEU 4:44"/></para>
<para style="p"><verse number="45" style="v" sid="DEU 4:45"/>तिनीहरू इजिप्टबाट निस्केर आएपछि मोशाले तिनीहरूलाई दिएका नियमहरू, उर्दीहरू र व्यवस्थाहरू यिनै हुन्।<verse eid="DEU 4:45"/></para>
<para style="p"><verse number="46" style="v" sid="DEU 4:46"/>त्यस बेला तिनीहरू हेश्बोनमा राज्य गर्ने एमोरीहरूका राजा सीहोनको देशमा यर्दन नदीको पूर्वपट्टिको बेथ-पोर सहरको नजिक बेँसीमा थिए। इस्राएलीहरू इजिप्टबाट निस्केर आउँदा मोशाले सीहोन राजालाई पराजित गरेका थिए।<verse eid="DEU 4:46"/></para>
<para style="p"><verse number="47" style="v" sid="DEU 4:47"/>तिनीहरूले यर्दन नदीको पूर्वपट्टि भएका एमोरीहरूका दुई जना राजाहरू अर्थात् सीहोन र बाशानका राजा ओगका देशहरूलाई अधीनमा लिए।<verse eid="DEU 4:47"/></para>
<para style="p"><verse number="48" style="v" sid="DEU 4:48"/>यो देश अर्नोन बेँसीमा भएको अरोएर सहरदेखि सिरियोन पर्वत (अर्थात् हेर्मोन) सम्म फैलिएको थियो।<verse eid="DEU 4:48"/></para>
<para style="p"><verse number="49" style="v" sid="DEU 4:49"/>अनि पिसगाको भीरदेखि मुन्तिर मृत सागर हुँदै यर्दन नदीको पूर्वपट्टिको सम्पूर्ण अराबा मैदानसम्म थियो।<verse eid="DEU 4:49"/></para>
<chapter eid="DEU 4"/>
<chapter number="5" style="c" sid="DEU 5"/>
<para style="p"><verse number="1" style="v" sid="DEU 5:1"/>मोशाले सबै इस्राएलका मानिसहरूलाई भेला गराएर भने: हे इस्राएलीहरू हो, आज मैले तिमीहरूलाई दिँदैगरेका उर्दी र व्यवस्थाहरू सुन। ती सिक र होसियारीसाथ पालन गर।<verse eid="DEU 5:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 5:2"/>याहवेह हाम्रा परमेश्‍वरले होरेब पर्वतमा हामीसँग करार बाँध्नुभयो।<verse eid="DEU 5:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 5:3"/>यो करार याहवेहले हाम्रा पितापुर्खाहरूसँग मात्र होइन, तर हामीहरूसँग अर्थात् आजसम्म जीवित रहेका हामीहरूसँग बाँध्नुभएको हो।<verse eid="DEU 5:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 5:4"/>त्यस पर्वतमा तिमीहरूसँग याहवेहले आगोबाट आमने-सामने कुरा गर्नुभयो।<verse eid="DEU 5:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 5:5"/>(त्यस बेला म याहवेहको वचन तिमीहरूलाई घोषणा गर्नलाई याहवेह र तिमीहरूका बीचमा खडा भएको थिएँ; किनकि तिमीहरू आगोदेखि डराएर पर्वतमाथि गएनौ।) अनि उहाँले भन्‍नुभयो:<verse eid="DEU 5:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 5:6"/>“म नै याहवेह, तेरा परमेश्‍वर हुँ; जसले तँलाई इजिप्टबाट, दासत्वको देशबाट निकालेर ल्याएँ।<verse eid="DEU 5:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 5:7"/>“मबाहेक तैँले अरू कुनै देवी-देवताहरू नमान्‍नू।<verse eid="DEU 5:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 5:8"/>आफ्ना निम्ति खोपेर माथि आकाशको, तल पृथ्वीको, र पानी मुनिको कुनै पनि वस्तुको कुनै मूर्ति नबनाउनू।<verse eid="DEU 5:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 5:9"/>तिनीहरूका सामु ननिहुरनू अथवा तिनीहरूको आराधना नगर्नू; किनकि म, याहवेह तेरा परमेश्‍वर, डाह गर्ने परमेश्‍वर हुँ; मलाई घृणा गर्नेहरूका पापको दण्ड तिनीहरूका छोराछोरीका तेस्रो र चौथो पुस्तामाथि दिन्छु;<verse eid="DEU 5:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 5:10"/>तर मलाई प्रेम गर्ने र मेरा आज्ञाहरू पालन गर्नेका हजारौँ पुस्तामाथि प्रेम देखाउँछु।<verse eid="DEU 5:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 5:11"/>तैँले याहवेह, आफ्ना परमेश्‍वरको नामको गलत प्रयोग नगर्नू; किनकि उहाँको नाम व्यर्थैमा लिनेलाई याहवेहले निर्दोष ठहराउनुहुनेछैन।<verse eid="DEU 5:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 5:12"/>शब्बाथलाई पवित्र राखेर त्यसको सम्झना गर्नू।<verse eid="DEU 5:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 5:13"/>छ दिनसम्म तैँले परिश्रम गरेर आफ्ना सबै काम गर्नू;<verse eid="DEU 5:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 5:14"/>तर सातौँ दिन याहवेह तेरा परमेश्‍वरका निम्ति शब्बाथ हो। यस दिन तैँले केही काम नगर्नू, न त तैँले, तेरा छोरा वा छोरीले, न तेरा सेवक वा सेविकाले, न त तेरा गोरुले, गधाले, वा तेरा कुनै पशुले, न तेरा सहरभित्र भएका परदेशीले, न त कसैले केही काम गर्नू, ताकि तँसँगै तेरा सेवक-सेविकाले आराम पाऊन्।<verse eid="DEU 5:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 5:15"/>तिमीहरू इजिप्टमा दास हुँदा कसरी याहवेह तिमीहरूका परमेश्‍वरले आफ्नो शक्तिशाली हात र फैलिएको पाखुरा प्रयोग गरी तिमीहरूलाई निकालेर ल्याउनुभयो, सो याद राख। यसैकारण याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई शब्बाथ मान्‍न आज्ञा गर्नुभएको हो।<verse eid="DEU 5:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 5:16"/>तैँले आफ्ना बुबा र आफ्नी आमालाई आदर गर्नू, जसरी याहवेह तेरा परमेश्‍वरले तँलाई आज्ञा दिनुभएको छ, ताकि याहवेह तेरा परमेश्‍वरले दिनुहुने देशमा तेरो आयु लामो होस् र तेरो भलो होस्।<verse eid="DEU 5:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 5:17"/>तैँले मानव हत्या नगर्नू।<verse eid="DEU 5:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 5:18"/>तैँले व्यभिचार नगर्नू।<verse eid="DEU 5:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 5:19"/>तैँले चोरी नगर्नू।<verse eid="DEU 5:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 5:20"/>तैँले आफ्नो छिमेकीको विरुद्धमा झूटो साक्षी नदिनू।<verse eid="DEU 5:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 5:21"/>तैँले आफ्नो छिमेकीको घर वा जमिनको लालच नगर्नू। तैँले आफ्नो छिमेकीको पत्नीको लालच नगर्नू, अथवा आफ्नो छिमेकीको सेवक वा सेविका, गोरु वा गधा, अथवा त्यससित भएको कुनै कुराको पनि लालच नगर्नू।”<verse eid="DEU 5:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 5:22"/>याहवेहले पर्वतमा भेला भएका सारा समुदायलाई आगो, बादल र घोर अन्धकारबाट चर्को सोरले घोषणा गर्नुभएका आज्ञाहरू यिनै हुन्; अनि उहाँले अरू केही थप्नुभएन। त्यसपछि उहाँले दुई वटा ढुङ्गाका पाटीहरूमा ती लेख्नुभयो, र मलाई दिनुभयो।<verse eid="DEU 5:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 5:23"/>जब पर्वतमा आगो जलिरहेको अवस्था थियो, तब तिमीहरूले अन्धकारबाट आवाज सुन्यौ; तिमीहरूका कुलका सबै अगुवाहरू र प्रधानहरू मकहाँ आए।<verse eid="DEU 5:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 5:24"/>अनि तिमीहरूले भन्यौ, “याहवेह हाम्रा परमेश्‍वरले हामीलाई उहाँको महिमा र महानता देखाउनुभएको छ, र हामीले आगोबाट उहाँको सोर सुनेका छौँ। परमेश्‍वरले मानिससँग कुरा गर्नुहुँदा पनि त्यो मानिस जीवितै रहेको कुरा आज हामीले देख्यौँ।<verse eid="DEU 5:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 5:25"/>तर अब हामी किन मरौँ? यस डरलाग्दो आगोले हामीलाई भस्म पार्नेछ। अनि यदि हामीले याहवेह हाम्रा परमेश्‍वरको सोर अझै सुन्यौँ भने हामी मर्नेछौँ।<verse eid="DEU 5:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 5:26"/>किनकि आगोबाट जीवित परमेश्‍वर बोल्नुभएको सुनेर हामीझैँ जीवितै रहने कुनचाहिँ मरणशील मानिस होला?<verse eid="DEU 5:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 5:27"/>मोशा, तपाईं नै माथि उक्लेर जानुहोस्, र याहवेह हाम्रा परमेश्‍वरले भन्‍नुभएको सबै कुराहरू सुन्‍नुहोस्। तब याहवेह हाम्रा परमेश्‍वरले तपाईंलाई के भन्‍नुहुन्छ, त्यो हामीलाई भन्‍नुहोस्। हामी ती सुन्‍नेछौँ, र पालन गर्नेछौँ।”<verse eid="DEU 5:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 5:28"/>तिमीहरूले मसँग कुरा गरेको याहवेहले सुन्‍नुभयो, र याहवेहले मलाई भन्‍नुभयो, “मैले यी मानिसहरूले तँलाई भनेका कुरा सुनेको छु। तिनीहरूले भनेका कुरा असल छ।<verse eid="DEU 5:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 5:29"/>ओह, यसरी नै तिनीहरूका हृदयले मेरो डर मानिदिए र मेरा आज्ञाहरू सधैँ पालन गरिदिए, तिनीहरू र तिनीहरूका सन्तानहरूलाई सधैँभरि भलो हुनेथियो!<verse eid="DEU 5:29"/></para>
<para style="p"><verse number="30" style="v" sid="DEU 5:30"/>“जा, गएर तिनीहरूलाई आ-आफ्ना पालहरूमा फर्केर जानू भन्।<verse eid="DEU 5:30"/></para>
<para style="p"><verse number="31" style="v" sid="DEU 5:31"/>तर तँचाहिँ यहीँ मसँग बस्। म तँलाई मेरा सबै आज्ञा, उर्दी र व्यवस्थाहरू दिनेछु। तैँले ती सबै तिनीहरूलाई सिकाउनू; ताकि मैले अधिकारमा दिन लागेको देशमा तिनीहरूले पालन गरून्।”<verse eid="DEU 5:31"/></para>
<para style="p"><verse number="32" style="v" sid="DEU 5:32"/>यसकारण याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आज्ञा गर्नुभएका कुराहरू होसियारीसाथ पालन गर्नू। तिमीहरू त्यसबाट दाहिने अथवा देब्रेतिर नफर्कनू।<verse eid="DEU 5:32"/></para>
<para style="p"><verse number="33" style="v" sid="DEU 5:33"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आज्ञा गर्नुभएअनुसार सबै मार्गहरूमा आज्ञाकारी भएर हिँडिरहनू; ताकि तिमीहरूले अधिकार गर्ने देशमा तिमीहरूको समृद्धि होस्, र तिमीहरूको आयु लामो होस्।<verse eid="DEU 5:33"/></para>
<chapter eid="DEU 5"/>
<chapter number="6" style="c" sid="DEU 6"/>
<para style="p"><verse number="1" style="v" sid="DEU 6:1"/>तिमीहरूले यर्दन पार गरेर अधिकार गर्ने देशमा पालन गर्नलाई सिकाउनू भनेर याहवेह तिमीहरूका परमेश्‍वरले मलाई निर्देशन गर्नुभएका विधि-विधानहरू र उर्दीहरू यिनै हुन्,<verse eid="DEU 6:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 6:2"/>ताकि तिमीहरू, तिमीहरूका सन्तानहरू र तिनीहरूका छोराछोरीहरूले आफू बाँचुन्जेल मैले तिमीहरूलाई दिएका उहाँका सबै उर्दीहरू र आज्ञाहरू पालन गरून्। अनि याहवेह आफ्ना परमेश्‍वरको डर राखून् र तिनीहरूले लामो जीवन उपभोग गरून्।<verse eid="DEU 6:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 6:3"/>हे इस्राएलीहरू हो, सुन र होसियारीसाथ पालन गर, ताकि तिमीहरूको भलो होस्। याहवेह, तिमीहरूका पितापुर्खाहरूका परमेश्‍वरले तिमीहरूलाई प्रतिज्ञा गर्नुभएझैँ दूध र मह बग्ने देशमा तिमीहरूको वृद्धि होस्।<verse eid="DEU 6:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 6:4"/>हे इस्राएलीहरू हो, सुन! याहवेह हाम्रा परमेश्‍वर, एक मात्र याहवेह हुनुहुन्छ।<verse eid="DEU 6:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 6:5"/>याहवेह तिमीहरूका परमेश्‍वरलाई तिमीहरूका सम्पूर्ण हृदयले, सम्पूर्ण प्राणले र सम्पूर्ण बलले प्रेम गर।<verse eid="DEU 6:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 6:6"/>आज मैले तिमीहरूलाई दिएका यी आज्ञाहरू आफ्ना हृदयभित्र राखिराख।<verse eid="DEU 6:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 6:7"/>यी तिमीहरूका छोराछोरीहरूलाई सिकाओ। तिमीहरू घरमा बस्दा, बाटोमा हिँड्दा, ढल्कँदा र उठ्दा यसको बारेमा चर्चा गर।<verse eid="DEU 6:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 6:8"/>यी आज्ञाहरूलाई तिमीहरूका हातमा र निधारमा चिन्हको रूपमा बाँधिराख।<verse eid="DEU 6:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 6:9"/>यी आज्ञाहरूलाई तिमीहरूका घरको ढोकाको चौकसमा र मूलढोकाहरूमा लेखिराख।<verse eid="DEU 6:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 6:10"/>जब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरू, तिमीहरूका पितापुर्खाहरू अब्राहाम, इसहाक र याकोबसँग शपथ खानुभएको देशमा अर्थात् तिमीहरूले नबनाएका विशाल र सम्पन्‍न सहरहरू भएको देश तिमीहरूलाई दिनलाई ल्याउनुहुन्छ,<verse eid="DEU 6:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 6:11"/>तब तिमीहरूले प्रबन्ध नगरेका असल कुराहरूले भरिएका घरहरू, तिमीहरूले नखनेका इनारहरू, तिमीहरूले नलगाएका दाखबारीहरू र जैतुनका बारीहरूमा ल्याउनुहुन्छ। जब तिमीहरूले ती खानेछौ र तृप्‍त हुनेछौ,<verse eid="DEU 6:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 6:12"/>तब तिमीहरूलाई इजिप्टबाट दासत्वको देशबाट निकालेर ल्याउनुहुने याहवेहलाई कहिल्यै पनि नबिर्सनू।<verse eid="DEU 6:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 6:13"/>याहवेह तिमीहरूका परमेश्‍वरको भय मान्‍नू। उहाँको मात्र सेवा गर्नू, र उहाँको नाममा मात्र तिमीहरूले शपथ खानू।<verse eid="DEU 6:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 6:14"/>तिमीहरूका वरिपरि भएका मानिसहरूका देवी-देवताहरू अर्थात् अरू देवी-देवताहरूको पछि नलाग्नू;<verse eid="DEU 6:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 6:15"/>किनकि तिमीहरूको बीचमा हुनुभएका याहवेह तिमीहरूका परमेश्‍वर डाह गर्ने परमेश्‍वर हुनुहुन्छ। उहाँको रिस तिमीहरूका विरुद्धमा दन्किनेछ, र उहाँले तिमीहरूलाई पृथ्वीबाट नाश पार्नुहुनेछ।<verse eid="DEU 6:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 6:16"/>तिमीहरूले मस्साहमा गरेझैँ याहवेह तिमीहरूका परमेश्‍वरको परीक्षा नगर्नू।<verse eid="DEU 6:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 6:17"/>याहवेह तिमीहरूका परमेश्‍वरका आज्ञाहरू र उहाँले तिमीहरूलाई दिनुभएका नीति-नियम र उर्दीहरू होसियारीसाथ पालन गर्नू।<verse eid="DEU 6:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 6:18"/>याहवेहको दृष्‍टिमा जे ठिक र असल छ, त्यही गर्नू; ताकि तिमीहरूलाई भलो होस्, र याहवेहले तिमीहरूका पितापुर्खाहरूलाई शपथ खाएर प्रतिज्ञा गर्नुभएको उत्तम देशमा तिमीहरूले अधिकार गर्न सक।<verse eid="DEU 6:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 6:19"/>अनि याहवेहले भन्‍नुभएझैँ तिमीहरूले आफ्ना सामुबाट तिमीहरूका शत्रुहरूलाई धपाउनेछौ।<verse eid="DEU 6:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 6:20"/>भविष्यमा जब तिमीहरूका छोराछोरीले तिमीहरूलाई सोध्नेछन्, “याहवेह हाम्रा परमेश्‍वरले तपाईंहरूलाई पालन गर्नू भनी दिनुभएका यी नीति-नियमहरू, उर्दीहरू र व्यवस्थाहरूको अर्थ के हो?”<verse eid="DEU 6:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 6:21"/>तब तिनीहरूलाई यसो भन, “हामी इजिप्टमा फारो राजाका दासहरू थियौँ; तर याहवेहका शक्तिशाली हातले हामीलाई इजिप्टबाट निकालेर ल्याउनुभयो।<verse eid="DEU 6:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 6:22"/>हाम्रो आँखाको सामु याहवेहले इजिप्टमा फारो र तिनका सबै घरानामाथि अलौकिक चिन्हहरू, अथवा महान् र डरलाग्दा कामहरू गर्नुभयो।<verse eid="DEU 6:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 6:23"/>तर उहाँले हामीलाई त्यहाँबाट निकालेर हाम्रा पितापुर्खाहरूसँग शपथ खाएर प्रतिज्ञा गर्नुभएको देश दिनलाई यहाँ ल्याउनुभयो।<verse eid="DEU 6:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 6:24"/>याहवेहले हामीलाई यी सबै उर्दीहरू पालन गर्नू र याहवेह हाम्रा परमेश्‍वरको डर मान्‍नू भनी आज्ञा दिनुभयो; ताकि त्यसरी नै सधैँभरि उन्‍नति गर्दै बाँचिरहन सकौँ, जसरी आज हामी समृद्ध छौँ।<verse eid="DEU 6:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 6:25"/>अनि उहाँले आज्ञा गर्नुभएझैँ याहवेह हाम्रा परमेश्‍वरको सामु यी सबै आज्ञाहरू हामीले होसियारीसाथ पालन गर्‍यौँ भने त्यो नै हाम्रो धार्मिकता ठहरिनेछ।”<verse eid="DEU 6:25"/></para>
<chapter eid="DEU 6"/>
<chapter number="7" style="c" sid="DEU 7"/>
<para style="p"><verse number="1" style="v" sid="DEU 7:1"/>जब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई अधिकार गर्न त्यस देशमा ल्याउनुहुनेछ, तब तिमीहरूका अगि तिमीहरूभन्दा ठूला, बलवान् यी सात जातिहरूलाई धपाइदिनुहुनेछ—हित्तीहरू, गिर्गाशीहरू, एमोरीहरू, कनानीहरू, परिज्जीहरू, हिव्वीहरू र यबूसीहरू।<verse eid="DEU 7:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 7:2"/>अनि जब याहवेह तिमीहरूका परमेश्‍वरले उनीहरूलाई तिमीहरूका अधीनमा पारिदिनुहुन्छ र तिमीहरूले उनीहरूलाई परास्त गर्छौ, तब तिमीहरूले उनीहरूलाई सम्पूर्ण रूपले नाश पार्नू। उनीहरूसँग सम्झौता नगर्नू, र उनीहरूलाई दया नदेखाउनू।<verse eid="DEU 7:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 7:3"/>तिनीहरूसँग विवाह नगर्नू। तिमीहरूले आफ्ना छोरीहरू तिनीहरूका छोराहरूलाई नदिनू, न त तिनीहरूका छोरीहरू आफ्ना छोराहरूका लागि ल्याउनू।<verse eid="DEU 7:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 7:4"/>किनकि तिनीहरूले तिमीहरूका छोराछोरीहरूलाई मेरो साटो अरू देवी-देवताहरूको सेवा गर्न लगाउनेछन्। अनि याहवेहको रिस तिमीहरूको विरुद्धमा दन्कनेछ, र उहाँले तिमीहरूलाई तुरुन्तै नाश गर्नुहुनेछ।<verse eid="DEU 7:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 7:5"/>तिमीहरूले तिनीहरूलाई यसो गर्नू: तिनीहरूका वेदीहरू भत्काइदिनू। तिनीहरूका चोखा ढुङ्गाहरू चकनाचुर पारिदिनू। तिनीहरूका अशेराको खाँबो काटेर ढालिदिनू र तिनीहरूका मूर्तिहरू आगोमा जलाइदिनू।<verse eid="DEU 7:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 7:6"/>किनकि तिमीहरू याहवेह तिमीहरूका परमेश्‍वरका निम्ति एउटा पवित्र जाति हौ। याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई उहाँका जाति र बहुमूल्य सम्पत्ति हुनलाई यस पृथ्वीका सबै जातिहरूका बीचबाट चुन्‍नुभएको छ।<verse eid="DEU 7:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 7:7"/>तिमीहरू संख्यामा अरू जातिहरूभन्दा धेरै भएको कारण याहवेहले तिमीहरूप्रति आफ्नो प्रेम देखाउनुभएको होइन। तिमीहरू त सबै जातिहरूभन्दा थोरै थियौ।<verse eid="DEU 7:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 7:8"/>तर याहवेहले तिमीहरूलाई प्रेम गर्नुभएको कारण र उहाँले तिमीहरूका पितापुर्खाहरूसँग शपथ खानुभएको कारण, यसकासाथै उहाँको महान् शक्तिद्वारा तिमीहरूलाई दासत्वको देश इजिप्टको राजा फारोको शक्तिबाट छुटकारा दिएर निकालेर ल्याउनुभयो।<verse eid="DEU 7:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 7:9"/>यसकारण याहवेह तिमीहरूका परमेश्‍वर नै परमेश्‍वर हुनुहुन्छ भनी याद राख। उहाँलाई प्रेम गर्नेहरू र उहाँका आज्ञापालन गर्नेहरूका हजारौँ पुस्तासम्म आफ्नो प्रेमको करार पूरा गर्ने विश्‍वासयोग्य परमेश्‍वर उहाँ हुनुहुन्छ।<verse eid="DEU 7:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 7:10"/>तर, उहाँलाई घृणा गर्नेहरूलाई उहाँले तिनीहरूका आँखाकै सामु नाश गरेर बदला लिनुहुनेछ; उहाँलाई घृणा गर्नेहरूलाई तिनीहरूका मुखकै सामु बदला लिन उहाँ ढिलो गर्नुहुनेछैन।<verse eid="DEU 7:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 7:11"/>यसकारण मैले आज तिमीहरूलाई दिएका आज्ञाहरू, उर्दीहरू र व्यवस्थाहरू होसियारीसाथ पालन गर्नू।<verse eid="DEU 7:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 7:12"/>यदि तिमीहरूले यी व्यवस्थाहरूमा ध्यान दियौ, र यिनलाई होसियारीसाथ पालन गर्‍यौ भने याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका पितापुर्खाहरूसँग शपथ खानुभएको प्रेमको करार तिमीहरूसँग पूरा गर्नुहुनेछ।<verse eid="DEU 7:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 7:13"/>उहाँले तिमीहरूलाई प्रेम गर्नुहुनेछ; आशिष् दिनुहुनेछ र तिमीहरूको संख्यामा वृद्धि गराइदिनुहुनेछ। उहाँले तिमीहरूका गर्भका फलमा, खेतका फसलमा, अन्‍नबालीमा, नयाँ दाखमद्यमा, जैतुन तेलमा, तिमीहरूका बथानका बाछाहरू र तिमीहरूका बगालका थुमाहरूलाई तिमीहरूका पितापुर्खाहरूलाई दिन्छु भनी शपथ खानुभएको देशमा आशिष् दिनुहुनेछ।<verse eid="DEU 7:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 7:14"/>तिमीहरू अरू जातिहरूभन्दा धेरै आशिषित हुनेछौ। तिमीहरूका कुनै पुरुष वा स्त्री निःसन्तान हुनेछैनन्, न त तिमीहरूका गाईबस्तु थारो हुनेछ।<verse eid="DEU 7:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 7:15"/>याहवेहले तिमीहरूलाई सबै किसिमका रोगहरूबाट अलग राख्नुहुनेछ। तिमीहरूले इजिप्टमा देखेका कुनै पनि डरलाग्दा रोगहरू उहाँले तिमीहरूमाथि ल्याउनुहुनेछैन। तर उहाँले ती रोगहरू तिमीहरूलाई घृणा गर्नेहरूमाथि ल्याउनुहुनेछ।<verse eid="DEU 7:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 7:16"/>याहवेहले तिमीहरूलाई सुम्पिदिनुभएका सबै मानिसहरूलाई तिमीहरूले नाश गर्नुपर्छ। तिनीहरूमाथि दया नदेखाउनू र तिनीहरूका देवी-देवताहरूको सेवा नगर्नू। किनकि त्यो त तिमीहरूका निम्ति पासो हुनेछ।<verse eid="DEU 7:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 7:17"/>तिमीहरू आफैँले यसरी सोचौला, “यी जातिहरू हामीभन्दा बलवान् छन्। हामी तिनीहरूलाई कसरी धपाउन सक्छौँ?”<verse eid="DEU 7:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 7:18"/>तर तिनीहरूसँग नडराओ; याहवेह तिमीहरूका परमेश्‍वरले फारो र सारा इजिप्टलाई के गर्नुभएको थियो, त्यो स्मरण गर।<verse eid="DEU 7:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 7:19"/>याहवेह तिमीहरूका परमेश्‍वरले ठूला-ठूला सङ्कष्‍टहरू, अलौकिक चिन्हहरू र अद्‌भुत कार्यहरू, शक्तिशाली हात र फैलिएको पाखुराद्वारा तिमीहरूलाई निकालेर ल्याउनुभएको तिमीहरूले आफ्नै आँखाले देखेका थियौ। यसरी नै याहवेह तिमीहरूका परमेश्‍वरले तिमीहरू अहिले डराएका सबै जातिहरूलाई त्यस्तै गर्नुहुनेछ।<verse eid="DEU 7:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 7:20"/>यसबाहेक याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूबाट लुकेर बाँचेकाहरू सबै नाश नभएसम्म तिनीहरूको माझ अरिङ्गाल पठाउनुहुनेछ।<verse eid="DEU 7:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 7:21"/>तिनीहरूसँग नडराओ; किनकि तिमीहरूसँग हुनुहुने, याहवेह तिमीहरूका परमेश्‍वर महान् र भययोग्य परमेश्‍वर हुनुहुन्छ।<verse eid="DEU 7:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 7:22"/>याहवेह तिमीहरूका परमेश्‍वरले ती जातिहरूलाई तिमीहरूकै सामु, अलि-अलि गर्दै धपाउनुहुनेछ। तिनीहरूलाई एकैचोटि निकाल्ने अनुमति तिमीहरूलाई दिइनेछैन, नत्रता तिमीहरूको चारैतिर जङ्गली पशुहरूको संख्या बढ्न सक्छ।<verse eid="DEU 7:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 7:23"/>तर याहवेह तिमीहरूका परमेश्‍वरले तिनीहरूलाई तिमीहरूका अधीनमा सुम्पिदिनुहुनेछ। तिनीहरू नाश नभएसम्म ठूलो अन्योलमा पारेर राख्नुहुनेछ।<verse eid="DEU 7:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 7:24"/>उहाँले तिनीहरूका राजाहरूलाई तिमीहरूका अधीनमा दिनुहुनेछ, र तिमीहरूले तिनीहरूका नामनिशानै आकाशमुनिबाट मेटिदिनेछौ। तिमीहरूको विरुद्धमा कोही पनि खडा हुन सक्नेछैन। तिमीहरूले तिनीहरूलाई नाश गर्नेछौ।<verse eid="DEU 7:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 7:25"/>तिमीहरूले तिनीहरूका देवी-देवताहरूको मूर्तिहरूलाई आगोमा जलाइदिनू। तिनीहरूसँग भएका चाँदी र सुनको लालच नगर्नू। अनि ती तिमीहरूले आफ्नै लागि नलिनू, नत्रता तिमीहरू त्यसद्वारा पासोमा पर्नेछौ। किनकि याहवेह तिमीहरूका परमेश्‍वरका निम्ति त्यो घृणित कुरा हो।<verse eid="DEU 7:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 7:26"/>कुनै घृणित कुरा आफ्नो घरमा नल्याउनू, नत्रता तिमीहरू पनि त्योजस्तै विनाशका लागि अलग गरिनेछौ। त्यसलाई घृणा गर्नू, र एकदमै तिरस्कार गर्नू; किनकि त्यो विनाशका निम्ति अलग गरिएको हो।<verse eid="DEU 7:26"/></para>
<chapter eid="DEU 7"/>
<chapter number="8" style="c" sid="DEU 8"/>
<para style="p"><verse number="1" style="v" sid="DEU 8:1"/>मैले आज तिमीहरूलाई दिइरहेका हरेक आज्ञालाई होसियारीसाथ पालन गर, ताकि तिमीहरू जीवित रहन सक, र वृद्धि हुन सक। अनि याहवेहले तिमीहरूका पितापुर्खाहरूसँग शपथद्वारा प्रतिज्ञा गर्नुभएको देशमा प्रवेश गर्न सक; र त्यस देशमा अधिकार गर्न सक।<verse eid="DEU 8:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 8:2"/>तिमीहरूले उहाँका आज्ञाहरू पालन गर्छौ कि गर्दैनौ भनेर तिमीहरूका हृदय जान्‍न, तिमीहरूलाई नम्र बनाउन अनि जाँच्नलाई कसरी याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई उजाडस्थानभरि यी चालीस वर्षसम्म डोर्‍याउनुभयो, सो स्मरण गर।<verse eid="DEU 8:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 8:3"/>उहाँले तिमीहरूलाई नम्र तुल्याउन भोकाउन दिनुभयो। त्यसपछि मन्‍न खुवाउनुभयो; जसलाई न तिमीहरूले, न त तिमीहरूका पितापुर्खाहरूले नै जानेका थिए। मानिस भोजनले मात्र जीवित रहँदैन, तर याहवेहको मुखबाट निस्केको हरेक वचनले जीवित रहन्छ भनेर सिकाउनलाई त्यसो गर्नुभयो।<verse eid="DEU 8:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 8:4"/>यी चालीस वर्षहरूमा तिमीहरूका लुगा फाटेनन्, र तिमीहरूका खुट्टा पनि सुनिएनन्।<verse eid="DEU 8:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 8:5"/>यसकारण जसरी मानिसले आफ्ना छोरालाई अनुशासनमा राख्छ, त्यसरी नै याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई अनुशासनमा राख्नुहुन्छ भनी याद राख।<verse eid="DEU 8:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 8:6"/>याहवेह तिमीहरूका परमेश्‍वरका आज्ञाहरू पालन गर। उहाँका आज्ञामा हिँड र उहाँको आदर गर।<verse eid="DEU 8:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 8:7"/>किनकि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई यस्तो उत्तम देशमा ल्याउनुहुँदैछ, जुन देशमा नदीनालाहरू, पानीका धाराहरू र पानीका मूलहरू पहाड र बेँसीहरूबाट बगेर निस्कन्छन्।<verse eid="DEU 8:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 8:8"/>यस्तो देश, जहाँ गहुँ र जौ, अङ्‌गुर र नेभाराका रूखहरू, अनार, जैतुनको तेल र मह उत्पादन हुँदछन्।<verse eid="DEU 8:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 8:9"/>यस्तो देश, जहाँ भोजनको अभाव हुनेछैन। त्यहाँ तिमीहरूलाई कुनै कुराको अभाव हुनेछैन। यस्तो देश, जहाँ चट्टानहरूमा फलाम छन्, र तिमीहरूले पहाडहरूबाट तामा खनेर निकाल्न सक्छौ।<verse eid="DEU 8:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 8:10"/>जब तिमीहरूले खाएर तृप्‍त हुन्छौ, तब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई उत्तम देश दिनुभएको निम्ति उहाँलाई प्रशंसा गर।<verse eid="DEU 8:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 8:11"/>आज मैले तिमीहरूलाई याहवेह तिमीहरूका परमेश्‍वरका आज्ञाहरू, उहाँका व्यवस्थाहरू र उहाँका उर्दीहरू दिइरहेको छु, तिमीहरूले उहाँलाई नभुल<verse eid="DEU 8:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 8:12"/>नत्रता तिमीहरू खाएर तृप्‍त हुनेछौ, तब तिमीहरूले राम्रा घरहरू बनाएर बसोबास गर्छौ।<verse eid="DEU 8:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 8:13"/>अनि जब तिमीहरूका बथान र बगालहरू वृद्धि हुँदै जानेछन्; तिमीहरूका चाँदी र सुन प्रशस्त हुनेछ। अनि तिमीहरूसँग भएका सबै कुराहरू वृद्धि हुनेछ,<verse eid="DEU 8:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 8:14"/>तब तिमीहरूका हृदयमा घमण्ड आउनेछ, र तिमीहरूलाई इजिप्टको दासत्वबाट निकालेर ल्याउनुहुने याहवेह तिमीहरूका परमेश्‍वरलाई तिमीहरूले बिर्सनेछौ।<verse eid="DEU 8:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 8:15"/>उहाँले तिमीहरूलाई विशाल र डरलाग्दो उजाडस्थानद्वारा त्यस सुक्खा र पानीविनाको भूमिबाट अनि विषालु सर्पहरू र बिच्छीहरू भएको ठाउँबाट डोर्‍याउनुभयो। उहाँले तिमीहरूका निम्ति त्यस कडा चट्टानबाट पानी निकाल्नुभयो।<verse eid="DEU 8:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 8:16"/>अन्त्यमा उहाँले तिमीहरूलाई सबै अशल कुराहरू दिन सक्नुभएको होस् भनेर उहाँले तिमीहरूलाई नम्र बनाउन र जाँच गर्न तिमीहरूका पितापुर्खाहरूले कहिल्यै नजानेका मन्‍न उजाडस्थानमा खानलाई दिनुभयो।<verse eid="DEU 8:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 8:17"/>तिमीहरूले आफ्नो मनमा सोचौला, “मेरा आफ्ना हातका शक्ति र मेरा हातका बलले आफ्ना निम्ति यो धन कमाएको हुँ।”<verse eid="DEU 8:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 8:18"/>तर याहवेह तिमीहरूका परमेश्‍वरलाई स्मरण गर; किनकि उहाँले नै तिमीहरूलाई धन कमाउने क्षमता दिनुभएको छ। अनि उहाँले तिमीहरूका पुर्खाहरूसँग शपथद्वारा गर्नुभएको करार निश्‍चित गर्नुहुन्छ, जसरी आजको दिनसम्म गर्नुभएको छ।<verse eid="DEU 8:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 8:19"/>यदि कुनै दिन तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरलाई बिर्सेर अरू देवी-देवताहरूलाई पछ्याएर तिनीहरूलाई पूजा गर्‍यौ र तिनीहरूको सामु निहुर्‍यौ भने म आज तिमीहरूको विरुद्धमा साक्षी दिन्छु; तिमीहरू निश्‍चय नै नष्‍ट हुनेछौ।<verse eid="DEU 8:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 8:20"/>तिमीहरूकै सामु याहवेहले जातिहरूलाई नाश गर्नुभएझैँ, तिमीहरूले पनि याहवेह तिमीहरूका परमेश्‍वरको आज्ञापालन नगरेको कारण नष्‍ट हुनेछौ।<verse eid="DEU 8:20"/></para>
<chapter eid="DEU 8"/>
<chapter number="9" style="c" sid="DEU 9"/>
<para style="p"><verse number="1" style="v" sid="DEU 9:1"/>सुन, इस्राएली हो! आज तिमीहरू यर्दन नदी पार गर्नेछौ। तिमीहरूभन्दा महान् र शक्तिशाली, आकाशसम्म छुने अग्ला पर्खाल भएका ठूला सहरहरूमा रहेका जातिहरूलाई तिमीहरूले अधिकार गर्न लागेका छौ।<verse eid="DEU 9:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 9:2"/>त्यहाँका अनाकी जातिहरू बलवान् र अग्ला छन्। तिनीहरूका बारेमा तिमीहरू जान्दछौ र यस्तो भनेको सुनेका छौ: “अनाकीहरूको विरुद्धमा को खडा हुन सक्छ?”<verse eid="DEU 9:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 9:3"/>तर आज तिमीहरू निश्‍चय जानी राख, कि याहवेह तिमीहरूका परमेश्‍वर तिमीहरूका अगि-अगि भस्म गर्ने आगोझैँ जानुहुने परमेश्‍वर हुनुहुन्छ। उहाँले तिनीहरूलाई नाश गर्नुहुनेछ। उहाँले तिनीहरूलाई तिमीहरूको सामु पराजित गराउनुहुनेछ। याहवेहले प्रतिज्ञा गर्नुभएझैँ तिमीहरूले तिनीहरूलाई धपाउनेछौ र चाँडै नाश पार्नेछौ।<verse eid="DEU 9:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 9:4"/>याहवेह तिमीहरूका परमेश्‍वरले तिनीहरूलाई तिमीहरूको सामुबाट धपाइसक्नुभएपछि तिमीहरूले यसो नभन्‍नू, “याहवेहले हाम्रो धार्मिकताको कारण यस देशलाई अधिकार गर्न भनी हामीलाई यहाँ ल्याउनुभएको हो।” यस्तो होइन, तर यी जातिहरूका दुष्‍टताको कारण याहवेहले तिनीहरूलाई तिमीहरूको सामुबाट धपाउनुहुनेछ।<verse eid="DEU 9:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 9:5"/>यो त तिमीहरूको धार्मिकता अथवा इमानदारीताको कारण तिमीहरूले तिनीहरूको देश अधिकार गर्न गइरहेका होइनौ: तर ती जातिहरूको दुष्‍टताको कारण याहवेहले तिमीहरूका पितापुर्खाहरू, अब्राहाम, इसहाक र याकोबसँग शपथ खानुभएको प्रतिज्ञा पूरा गर्नलाई उहाँले तिनीहरूलाई तिमीहरूको सामुबाट धपाउनुहुनेछ।<verse eid="DEU 9:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 9:6"/>यसकारण यो कुरा याद राख, तिमीहरूको धार्मिकताको कारण याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई यो उत्तम देश अधिकार गर्नलाई दिनुभएको होइन; किनकि तिमीहरू त हठी मानिसहरू हौ।<verse eid="DEU 9:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 9:7"/>तिमीहरूले उजाडस्थानमा कसरी याहवेह तिमीहरूका परमेश्‍वरलाई रिस उठायौ भनी स्मरण गर, र कहिल्यै नबिर्स। तिमीहरूले इजिप्ट छोडेको दिनदेखि यहाँ आइपुग्दासम्म याहवेहको विरुद्धमा धेरै विद्रोह गरेका छौ।<verse eid="DEU 9:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 9:8"/>होरेब पर्वतमा तिमीहरूले याहवेहलाई रिस उठायौ; यसकारण तिमीहरूलाई नाश गर्न उहाँ साह्रै रिसाउनुभएको थियो।<verse eid="DEU 9:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 9:9"/>याहवेहले तिमीहरूसँग गर्नुभएको करारका ती ढुङ्गाका पाटीहरू लिनलाई जब म पर्वतमा गएँ, तब म त्यस पर्वतमा चालीस दिन र चालीस रात बसेँ। त्यहाँ मैले न रोटी खाएँ, न त पानी नै पिएँ।<verse eid="DEU 9:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 9:10"/>याहवेहले मलाई आफ्नो औँलाले खोपेर लेख्नुभएका ढुङ्गाका दुई वटा पाटीहरू दिनुभयो। ती पाटीहरूमा याहवेहले पर्वतमा आगोबाट तिमीहरूलाई सभाको दिनमा घोषणा गर्नुभएका सबै आज्ञाहरू लेखिएका थिए।<verse eid="DEU 9:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 9:11"/>चालीस दिन र चालीस रातको अन्त्यमा याहवेहले मलाई ढुङ्गाका ती दुई पाटीहरू अर्थात् करारका पाटीहरू दिनुभयो।<verse eid="DEU 9:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 9:12"/>तब याहवेहले मलाई भन्‍नुभयो, “यहाँबाट तुरुन्तै तल गइहाल; किनकि तैँले इजिप्टबाट निकालेर ल्याएका तेरा मानिसहरू भ्रष्‍ट भएका छन्। मैले तिनीहरूलाई आज्ञा गरेका कुराबाट तिनीहरू चाँडै नै तर्किगएका छन्। तिनीहरूले आफ्ना लागि मूर्ति बनाएका छन्।”<verse eid="DEU 9:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 9:13"/>अनि याहवेहले मलाई भन्‍नुभयो, “मैले यस जातिलाई देखेको छु र यिनीहरू साँच्‍चै हठी जाति हुन्।<verse eid="DEU 9:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 9:14"/>मलाई एकलै छाडिदे, ताकि म तिनीहरूलाई नाश गरूँ। म तिनीहरूका नाम आकाशमुनिबाट मेटिदिनेछु। अनि म तँलाई नै तिनीहरूभन्दा शक्तिशाली र ठूलो संख्याको जाति बनाउनेछु।”<verse eid="DEU 9:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 9:15"/>यसकारण म फर्केँ, र पर्वत आगोले जलिरहेकै बेला त्यहाँबाट तल ओर्लेर आएँ। अनि करारका ती दुई ढुङ्गाका पाटीहरू मेरा हातमै थिए।<verse eid="DEU 9:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 9:16"/>जब मैले हेरेँ, तब तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको विरुद्धमा पाप गरेका देखेँ। तिमीहरूले आफ्ना निम्ति बाछाको आकारमा एउटा मूर्ति बनाएका थियौ। याहवेहले दिनुभएको आज्ञाबाट तिमीहरू चाँडै तर्किगएका थियौ।<verse eid="DEU 9:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 9:17"/>यसकारण मैले ती दुई पाटीहरू लिएर आफ्ना हातबाट फ्याँकिदिएँ, र तिमीहरूका आँखाकै सामु टुक्रा-टुक्रा गरेर फुटाइदिएँ।<verse eid="DEU 9:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 9:18"/>त्यसपछि याहवेहको सामु चालीस दिन र चालीस रातसम्म लम्पसार परेँ। त्यहाँ मैले न रोटी खाएँ, न त पानी नै पिएँ। किनकि तिमीहरूले याहवेहको दृष्‍टिमा जे खराब थियो, ती सबै पाप गर्‍यौ र उहाँलाई रिस उठायौ।<verse eid="DEU 9:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 9:19"/>याहवेहको रिस र क्रोधदेखि मलाई डर लाग्यो। किनकि उहाँ तिमीहरूलाई नाश गर्नलाई साह्रै क्रोधित हुनुभएको थियो। तर फेरि पनि याहवेहले मेरो कुरा सुन्‍नुभयो।<verse eid="DEU 9:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 9:20"/>अनि त्यस बेला याहवेह हारूनलाई नाश गर्न तिनीसँग साह्रै रिसाउनुभएको थियो। तर त्यस बेला मैले हारूनका निम्ति पनि प्रार्थना गरेँ।<verse eid="DEU 9:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 9:21"/>मैले तिमीहरूको त्यो पापपूर्ण वस्तु, तिमीहरूले बनाएका बाछा पनि लिएँ, र त्यसलाई आगोमा जलाइदिएँ। त्यसपछि मैले त्यसलाई कुच्‍च्‍याएर धुलोपिठो पारिदिएँ। अनि त्यस धुलोलाई पहाडबाट बगिरहेको खोलामा बगाइदिएँ।<verse eid="DEU 9:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 9:22"/>तिमीहरूले तबेरा, मस्साह र किब्रोत-हत्तावामा पनि याहवेहलाई रिस उठाएका थियौ।<verse eid="DEU 9:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 9:23"/>अनि याहवेहले तिमीहरूलाई कादेश-बर्नेबाट पठाउनुहुँदा उहाँले भन्‍नुभयो, “माथि उक्लेर जाओ, र मैले तिमीहरूलाई दिएको देशमा अधिकार गर।” तर तिमीहरू याहवेह तिमीहरूका परमेश्‍वरको आज्ञाको विरुद्धमा विद्रोही भयौ। तिमीहरूले उहाँमाथि भरोसा राखेनौ, र उहाँको आज्ञापालन गरेनौ।<verse eid="DEU 9:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 9:24"/>मैले तिमीहरूलाई चिनेको दिनदेखि नै तिमीहरू याहवेहको विरुद्धमा विद्रोही भएका छौ।<verse eid="DEU 9:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 9:25"/>म ती चालीस दिन र चालीस रातभरि याहवेहको सामु लम्पसार परिरहेँ। किनकि याहवेहले तिमीहरूलाई नाश गर्छु भन्‍नुभएको थियो।<verse eid="DEU 9:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 9:26"/>मैले याहवेहलाई प्रार्थना गरेर भनेँ, “हे प्रभु याहवेह, तपाईंले आफ्नो महान् शक्तिले छुटाउनुभएको र शक्तिशाली हातले इजिप्टबाट निकालेर ल्याउनुभएको आफ्ना जाति र आफ्ना निज उत्तराधिकारलाई नाश नगर्नुहोस्।<verse eid="DEU 9:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 9:27"/>तपाईंका सेवकहरू अब्राहाम, इसहाक र याकोबलाई सम्झनुहोस्। यी मानिसहरूका हठीपन, तिनीहरूका दुष्‍टता र तिनीहरूका पापको वास्ता नगर्नुहोस्।”<verse eid="DEU 9:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 9:28"/>नत्रता तपाईंले हामीलाई निकालेर ल्याउनुभएको देशले यसो भन्‍नेछ, “याहवेहले तिनीहरूलाई प्रतिज्ञा गर्नुभएको देशमा उहाँले तिनीहरूलाई लैजान सक्नुभएन। अनि उहाँले तिनीहरूलाई घृणा गर्नुभएको कारण तिनीहरूलाई उजाडस्थानमा मार्न भनी निकालेर ल्याउनुभयो।<verse eid="DEU 9:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 9:29"/>तर तिनीहरू तपाईंका जाति हुन्, तपाईंका निज उत्तराधिकार, जसलाई तपाईंले आफ्नो महान् शक्ति र आफ्नो फैलिएको हात निकालेर ल्याउनुभएको।”<verse eid="DEU 9:29"/></para>
<chapter eid="DEU 9"/>
<chapter number="10" style="c" sid="DEU 10"/>
<para style="p"><verse number="1" style="v" sid="DEU 10:1"/>त्यस बेला याहवेहले मलाई भन्‍नुभयो, “पहिलेको जस्तै ढुङ्गाका दुई वटा पाटीहरू काटेर मकहाँ माथि पर्वतमा लिएर आइज। एउटा काठको सन्दुक पनि बना।<verse eid="DEU 10:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 10:2"/>म तिनीहरूमा तैँले फुटाएको पहिलो पाटीहरूमा भएकै शब्दहरू लेखिदिनेछु। त्यसपछि तैँले ती ढुङ्गाका पाटीहरूलाई त्यस सन्दुकमा राख्।”<verse eid="DEU 10:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 10:3"/>यसकारण मैले बबुल काठको सन्दुक बनाएँ। अनि पहिलेको जस्तै ढुङ्गाका दुई वटा पाटीहरू खोपेर निकालेँ। त्यसपछि ती दुई पाटीहरू आफ्ना हातमा बोकेर पर्वतमा उक्लेर गएँ।<verse eid="DEU 10:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 10:4"/>याहवेहले ती दुई ढुङ्गाका पाटीहरूमा पहिलाको जस्तै जे लेख्नुभएको थियो, त्यही नै सभाको दिन पर्वतमा आगोबाट तिमीहरूलाई घोषणा गर्नुभएका दश आज्ञाहरू लेखिदिनुभयो। अनि ती ढुङ्गाका पाटीहरू मलाई दिनुभयो।<verse eid="DEU 10:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 10:5"/>त्यसपछि म पर्वतबाट ओर्लिआएँ। अनि याहवेहले मलाई आज्ञा गर्नुभएझैँ ती पाटीहरूलाई मैले बनाएको सन्दुकमा राखिदिएँ। ती पाटीहरू अहिलेसम्म त्यहीँ छँदैछन्।<verse eid="DEU 10:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 10:6"/>(इस्राएलीहरू बेरोतको बेने-याकानहरूको इनारहरूदेखि मोसेरासम्म यात्रा गरे। त्यहाँ हारून मरे, र त्यहीँ तिनी गाडिए। अनि तिनका छोरा एलाजारले तिनीपछि प्रधान पुजारीको जिम्मेवारी सम्हाले।<verse eid="DEU 10:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 10:7"/>त्यहाँबाट तिनीहरू गुदगोदासम्म यात्रा गरेर पानीको खोलाहरू भएको ठाउँ योतबातामा गए।<verse eid="DEU 10:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 10:8"/>त्यस बेला याहवेहले लेवीको कुललाई उहाँको करारको सन्दुक बोक्न, उहाँको सामु खडा भई सेवा गर्न र उहाँको नाममा आशिष्‌को घोषणा गर्नको लागि अलग गर्नुभयो, जुन काममा तिनीहरू आज पनि छँदैछन्।<verse eid="DEU 10:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 10:9"/>यसैकारण तिनीहरूका दाजुभाइहरूबीच लेवीहरूको सम्पत्तिको अधिकारको भाग छैन। याहवेह तिमीहरूका परमेश्‍वरले तिनीहरूलाई भन्‍नुभएझैँ उहाँ नै तिनीहरूका उत्तराधिकार हुनुहुन्छ)।<verse eid="DEU 10:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 10:10"/>पहिलो पल्ट जस्तै म पर्वतमा चालीस दिन र चालीस रात बसेँ। अनि यस पटक पनि याहवेहले मेरो बिन्ती सुन्‍नुभयो। उहाँको इच्छा तिमीहरूलाई नाश गर्नलाई थिएन।<verse eid="DEU 10:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 10:11"/>याहवेहले मलाई भन्‍नुभयो, “उठेर जा, र यी मानिसहरूलाई तिनीहरूको मार्गमा अगुवाइ गर्। मैले तिनीहरूका पितापुर्खाहरूलाई दिन्छु भनी शपथ खाएको देशमा तिनीहरू प्रवेश गरून्। अनि त्यस देशमा अधिकार गरून्।”<verse eid="DEU 10:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 10:12"/>यसकारण हे इस्राएलीहरू हो, याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूबाट यति नै चाहनुहुन्छ, कि याहवेह तिमीहरूका परमेश्‍वरप्रति श्रद्धा राख्नु, उहाँका मार्गहरूमा आज्ञाकारी भई हिँड्नु, उहाँलाई प्रेम गर्नु, आफ्ना सारा हृदयले र सारा प्राणले याहवेह आफ्ना परमेश्‍वरको सेवा गर्नु,<verse eid="DEU 10:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 10:13"/>र मैले आज तिमीहरूकै भलाइका लागि दिइरहेका याहवेहका आज्ञाहरू र उर्दीहरू पालन गर्नु।<verse eid="DEU 10:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 10:14"/>आकाश र सर्वोच्‍च स्वर्ग, साथै पृथ्वी र त्यसमा भएका सबै कुराहरू याहवेह तिमीहरूका परमेश्‍वरकै हुन्।<verse eid="DEU 10:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 10:15"/>तरै पनि याहवेहले तिमीहरूका पितापुर्खाहरूलाई यति धेरै वास्ता गर्नुभयो र तिनीहरूलाई प्रेम गर्नुभयो; र उहाँले सबै जाति-जातिहरूबाट तिनीहरूका सन्तानलाई अर्थात् तिमीहरूलाई चुन्‍नुभयो, जुन आज तिमीहरूका अगि स्पष्‍ट छ।<verse eid="DEU 10:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 10:16"/>यसकारण तिमीहरूका हृदयको खतना गर। अनि अब उसो हठी नहोओ।<verse eid="DEU 10:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 10:17"/>किनकि याहवेह तिमीहरूका परमेश्‍वर, देवी-देवताहरूका परमेश्‍वर, प्रभुहरूका प्रभु, महान् परमेश्‍वर, शक्तिशाली र भययोग्य हुनुहुन्छ; जसले पक्षपात गर्नुहुन्‍न र घूस लिनुहुन्‍न।<verse eid="DEU 10:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 10:18"/>उहाँले अनाथ र विधवाहरूको पक्षमा न्याय गर्नुहुन्छ। अनि तिमीहरूसँग रहने विदेशीलाई प्रेम गरेर तिनीहरूलाई भोजन र वस्त्र दिनुहुन्छ।<verse eid="DEU 10:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 10:19"/>यसैले तिमीहरूले पनि विदेशीहरूलाई प्रेम गर्नुपर्छ; किनकि तिमीहरू आफैँ पनि इजिप्टमा परदेशी थियौ।<verse eid="DEU 10:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 10:20"/>याहवेह तिमीहरूका परमेश्‍वरको डर मान्‍नू; उहाँको सेवा गर्नू। उहाँलाई पक्री राख्नू र तिमीहरूले उहाँको नाममा मात्र शपथ खानू।<verse eid="DEU 10:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 10:21"/>याहवेह मात्र तिमीहरूका प्रशंसाको योग्य हुनुहुन्छ। उहाँ नै तिमीहरूका परमेश्‍वर हुनुहुन्छ, जसले तिमीहरूका निम्ति महान् र अद्‌भुत कार्यहरू गर्नुभयो, जुन तिमीहरूका आफ्नै आँखाले देखेका छन्।<verse eid="DEU 10:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 10:22"/>तिमीहरूका पितापुर्खाहरू जम्मा सत्तरी जना इजिप्टमा गएका थिए। अहिले याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आकाशका ताराहरूझैँ असंख्य बनाइदिनुभएको छ।<verse eid="DEU 10:22"/></para>
<chapter eid="DEU 10"/>
<chapter number="11" style="c" sid="DEU 11"/>
<para style="p"><verse number="1" style="v" sid="DEU 11:1"/>याहवेह तिमीहरूका परमेश्‍वरलाई प्रेम गर, र उहाँका नियमहरू, उहाँका उर्दीहरू, उहाँका व्यवस्थाहरू र उहाँका आज्ञाहरू सधैँ पालन गर।<verse eid="DEU 11:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 11:2"/>आज यो कुरा याद राख कि तिमीहरूका छोराछोरीहरूले याहवेह तिमीहरूका परमेश्‍वरको अनुशासन अनुभव गरेका छैनन्, न त देखेका छन्। उहाँको महानता, उहाँको पराक्रमी वा शक्तिशाली हात, उहाँका फैलिएको पाखुरा;<verse eid="DEU 11:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 11:3"/>इजिप्टमा त्यसका राजा फारो र त्यसका सम्पूर्ण देशको माझमा उहाँले देखाउनुभएको अलौकिक चिन्हहरू र गर्नुभएका कामहरू,<verse eid="DEU 11:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 11:4"/>उहाँले इजिप्टको सेनाहरूलाई, त्यसका घोडाहरू र रथहरूलाई के गर्नुभयो, र तिनीहरूले तिमीहरूलाई खेदेर आउँदा उहाँले कसरी तिनीहरूलाई लाल समुद्रको पानीको बीचमा डुबाइदिनुभयो। अनि कसरी याहवेहले तिनीहरूलाई सधैँका निम्ति नाश गरिदिनुभयो।<verse eid="DEU 11:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 11:5"/>तिमीहरू यहाँ नआएसम्म तिमीहरूका निम्ति उहाँले उजाडस्थानमा के गर्नुभयो, त्यो तिमीहरूका छोराछोरीहरूले देखेका छैनन्।<verse eid="DEU 11:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 11:6"/>अनि उहाँले रूबेनी एलिआबका छोराहरू दातान र अबीरामलाई के गर्नुभयो, जब इस्राएलको बीचमा धर्ती फाटेर तिनीहरूका परिवार, तिनीहरूका पालहरू र तिनीहरूका हरेक चीजसहित निलिदिएको कुराहरू देखेकै छैनन्।<verse eid="DEU 11:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 11:7"/>तर तिमीहरूले याहवेहले गर्नुभएका यी सबै महान् कामहरू आफ्नै आँखाले देखेका छौ।<verse eid="DEU 11:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 11:8"/>यसकारण मैले आज तिमीहरूलाई दिइरहेका आज्ञाहरू सबै पालन गर, ताकि तिमीहरूले यर्दन पार गरेर जाने बल प्राप्‍त गर्न सक। अनि देशभित्र गएर अधिकार प्राप्‍त गर्न सक।<verse eid="DEU 11:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 11:9"/>अनि याहवेहले तिमीहरूका पितापुर्खाहरू र तिनीहरूका सन्तानलाई दिनेछु भनी शपथ खानुभएको त्यो दूध र मह बग्ने देशमा तिमीहरू दीर्घायु भई बाँच्न सक।<verse eid="DEU 11:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 11:10"/>तिमीहरूले गएर अधिकार गर्न लागेको देश तिमीहरूले छोडेर आएको इजिप्टजस्तो छैन, जहाँ तिमीहरूले बिउ छरेर करेसाबारीमा खुट्टाको प्रयोगले सिँचाइ गर्नुपर्थ्यो।<verse eid="DEU 11:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 11:11"/>तर तिमीहरू यर्दन पार गरेर अधिकार गर्न गइरहेको देशका डाँडा र बेँसीहरूलाई आकाशबाट परेको झरीले भिजाउँछ।<verse eid="DEU 11:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 11:12"/>त्यो देश याहवेह तिमीहरूका परमेश्‍वरले रेखदेख गर्नुहुन्छ; त्यस देशमा याहवेह तिमीहरूका परमेश्‍वरका आँखा वर्षको सुरुदेखि अन्त्यसम्मै निरन्तर रहिरहन्छ।<verse eid="DEU 11:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 11:13"/>यसकारण यदि आज मैले तिमीहरूलाई दिइरहेका आज्ञाहरू तिमीहरूले इमानदारीतासाथ पालन गर्‍यौ भने याहवेह तिमीहरूका परमेश्‍वरलाई प्रेम गर्‍यौ र आफ्ना सारा हृदय र सारा प्राणले उहाँको सेवा गर्‍यौ भने,<verse eid="DEU 11:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 11:14"/>म तिमीहरूको देशमा शरद र बसन्त दुवै ऋतुमा वर्षा पठाउनेछु, ताकि तिमीहरूले आफ्ना अन्‍न, नयाँ दाखमद्य र जैतुनको तेल बटुल्न सक।<verse eid="DEU 11:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 11:15"/>म तिमीहरूका गाईबस्तुका निम्ति जमिनमा घाँस जुटाइदिनेछु। अनि तिमीहरू खानेछौ र तृप्‍त हुनेछौ।<verse eid="DEU 11:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 11:16"/>होशियार रहो, नत्रता तिमीहरू तर्केर अरू देवी-देवताहरूको सेवा गरौला र आराधना गरौला।<verse eid="DEU 11:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 11:17"/>यसो गर्‍यौ भने याहवेहको रिस तिमीहरूको विरुद्धमा दन्कनेछ; अनि उहाँले पानी नपरोस् भनेर आकाश बन्द गरिदिनुहुनेछ। तब जमिनले उब्जनी दिनेछैन र याहवेहले तिमीहरूलाई दिनुहुने उत्तम देशबाट तिमीहरू चाँडै नष्‍ट हुनेछौ।<verse eid="DEU 11:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 11:18"/>मेरा यी वचनहरू तिमीहरूका हृदय र मनमा राख; यिनलाई तिमीहरूका आफ्ना हातमा र आफ्ना निधारमा चिन्हको रूपमा बाँधिराख।<verse eid="DEU 11:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 11:19"/>आफ्ना घरमा बस्दा, बाटोमा हिँड्दा, ढल्कँदा र उठ्दा यिनको विषयमा चर्चा गर्दै आफ्ना छोराछोरीहरूलाई सिकाओ।<verse eid="DEU 11:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 11:20"/>यी आज्ञाहरूलाई तिमीहरूका घरको ढोकाको चौकसमा र मूलढोकाहरूमा लेखिराख;<verse eid="DEU 11:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 11:21"/>ताकि याहवेहले तिमीहरूका पितापुर्खाहरूलाई दिन्छु भनी शपथ खानुभएको देशमा तिमीहरू र तिमीहरूका छोराछोरीहरू पृथ्वीमाथि आकाश रहुन्जेल बाँचिरहून्।<verse eid="DEU 11:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 11:22"/>यदि मैले तिमीहरूलाई दिइरहेका सबै आज्ञाहरू तिमीहरूले होसियारीसाथ पालन गर्‍यौ, याहवेह तिमीहरूका परमेश्‍वरलाई प्रेम गर्न, उहाँका सबै मार्गहरूमा आज्ञाकारी भई हिँड्न र उहाँमा लागिरहनका निम्ति सबै आज्ञाहरू पालन गर्‍यौ भने,<verse eid="DEU 11:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 11:23"/>याहवेहले यी सबै जातिहरूलाई तिमीहरूका सामुबाट धपाउनुहुनेछ; अनि तिमीहरूभन्दा ठूला र शक्तिशाली जातिहरूलाई तिमीहरूले अधीनमा लिनेछौ।<verse eid="DEU 11:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 11:24"/>तिमीहरूले आफ्ना खुट्टाले टेकेका हरेक ठाउँ तिमीहरूको हुनेछ: तिमीहरूको प्रान्त उजाडस्थानदेखि लेबनानसम्म र यूफ्रेटिस नदीदेखि भूमध्य सागरसम्म फैलिनेछ।<verse eid="DEU 11:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 11:25"/>कुनै पनि मानिस तिमीहरूको विरुद्धमा खडा हुन सक्नेछैन। याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई प्रतिज्ञा गर्नुभएझैँ तिमीहरू जहाँ गए तापनि सारा देशभरि तिमीहरूको डर र आतङ्क हालिदिनुहुनेछ।<verse eid="DEU 11:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 11:26"/>हेर, मैले आज तिमीहरूका सामु आशिष् र श्राप राखिदिएको छु।<verse eid="DEU 11:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 11:27"/>मैले आज तिमीहरूलाई दिइरहेका याहवेह तिमीहरूका परमेश्‍वरका आज्ञाहरू यदि तिमीहरूले पालन गर्‍यौ भने आशिष् पाउनेछौ।<verse eid="DEU 11:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 11:28"/>तर यदि तिमीहरूले नजानेका अरू देवी-देवताहरूलाई पछ्याएर आज मैले तिमीहरूलाई दिएका याहवेह तिमीहरूका परमेश्‍वरका आज्ञाहरू तिमीहरूले पालन गरेनौ भने श्राप पाउनेछौ।<verse eid="DEU 11:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 11:29"/>जब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूले अधिकार गर्न पस्‍न लागेको देशमा तिमीहरूलाई ल्याउनुहुनेछ, तब तिमीहरूले गीरीज्जीम डाँडामा आशिष् र एबाल डाँडामा श्राप घोषणा गर्नू।<verse eid="DEU 11:29"/></para>
<para style="p"><verse number="30" style="v" sid="DEU 11:30"/>तिमीहरूलाई थाहै छ, यी पर्वतहरू गिलगालको छेउका अराबामा बस्‍ने कनानीहरूको प्रान्तमा मोरेको फलाँटहरूका छेउमा घाम अस्ताउने दिशापट्टि, बाटोको पश्‍चिम भागमा यर्दनको पारि छन्।<verse eid="DEU 11:30"/></para>
<para style="p"><verse number="31" style="v" sid="DEU 11:31"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशमा तिमीहरू प्रवेश गर्न र त्यस देशमा अधिकार गर्नलाई यर्दन पार गर्न लागेका छौ। जब तिमीहरूले त्यस देशलाई अधीनमा लिएर त्यसमा बस्‍नेछौ,<verse eid="DEU 11:31"/></para>
<para style="p"><verse number="32" style="v" sid="DEU 11:32"/>तब मैले आज तिमीहरूका अगि राखिदिएका सबै उर्दीहरू र व्यवस्थाहरू होसियारीसाथ पालन गर्नू।<verse eid="DEU 11:32"/></para>
<chapter eid="DEU 11"/>
<chapter number="12" style="c" sid="DEU 12"/>
<para style="p"><verse number="1" style="v" sid="DEU 12:1"/>याहवेह तिमीहरूका पितापुर्खाहरूका परमेश्‍वरले तिमीहरूलाई अधिकार गर्न दिनुभएको देशमा बाँचुन्जेल तिमीहरूले होसियारीसाथ पालन गर्नुपर्ने उर्दीहरू र व्यवस्थाहरू यिनै हुन्।<verse eid="DEU 12:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 12:2"/>उनीहरूका अल्गा डाँडाहरू, हरेक पर्वत र प्रत्येक झ्याम्म परेको रूखमुनि, जुन स्थानहरूमा तिमीहरूले अधिकार गर्न लागेका जातिहरूले तिनीहरूका देवी-देवताहरूलाई पूजा गर्छन्, ती सबै ठाउँहरू तिमीहरूले पूर्ण रूपले ध्वस्त पारिदिनू।<verse eid="DEU 12:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 12:3"/>तिनीहरूका वेदीहरू भत्काइदिनू। तिनीहरूका चोखा ढुङ्गाहरू टुक्रा-टुक्रा पारिदिनू, र तिनीहरूका अशेराको खाँबो आगोमा जलाइदिनू। तिनीहरूका देवी-देवताहरूका मूर्तिहरू काटेर ढालिदिनू, र ती ठाउँहरूबाट तिनीहरूका नामसमेत मेटाइदिनू।<verse eid="DEU 12:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 12:4"/>तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको आराधना उनीहरूको तरिकाले नगर्नू।<verse eid="DEU 12:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 12:5"/>तर तिमीहरूले चाहिँ याहवेह तिमीहरूका परमेश्‍वरले आफ्नो वासस्थानको निम्ति तिमीहरूका कुलहरूबीचबाट चुन्‍नुभएको ठाउँलाई खोज्नुपर्छ। अनि त्यस ठाउँमा तिमीहरू जानुपर्छ।<verse eid="DEU 12:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 12:6"/>त्यहाँ तिमीहरूले आफ्ना अन्‍नबलि र बलिदानहरू, तिमीहरूका दशांश र विशेष भेटीहरू, भाकल भेटीहरू, स्वेच्छा-भेटीहरू र तिमीहरूका बगालहरू र बथानहरूका पहिला जन्मेका पशुहरू ल्याउनू।<verse eid="DEU 12:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 12:7"/>त्यहाँ तिमीहरूले आफ्ना याहवेह परमेश्‍वरको उपस्थितिमा तिमीहरू र तिमीहरूका परिवारहरूले खानपिन गर्नेछौ। अनि तिमीहरूले हात लगाएका हरेक कुराहरूमा रमाउनेछौ; किनकि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आशिष् दिनुभएको छ।<verse eid="DEU 12:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 12:8"/>आज तिमीहरू आफूलाई जे ठिक लाग्छ, त्यही गरिरहेका छौ, तर तिमीहरू त्यहाँ गएपछि त्यस्तै नगर्नू;<verse eid="DEU 12:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 12:9"/>किनकि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने विश्रामस्थान र अधिकार गर्ने देशमा तिमीहरू अझसम्म पुगेका छैनौ।<verse eid="DEU 12:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 12:10"/>तर तिमीहरू यर्दन पार गरेर जानेछौ र याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई अधिकारको रूपमा दिनुहुने देशमा बसोबास गर्नेछौ। अनि उहाँले तिमीहरूका वरिपरि भएका शत्रुहरूदेखि विश्राम दिनुहुनेछ, ताकि तिमीहरू सुरक्षित बस्‍न सक।<verse eid="DEU 12:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 12:11"/>अनि याहवेह तिमीहरूका परमेश्‍वरले आफ्नो नामको खातिर चुन्‍नुहुने ठाउँमा—त्यहाँ मैले तिमीहरूलाई आज्ञा दिएका हरेक थोक तिमीहरूले ल्याउनू। तिमीहरूका होमबलिहरू र बलिदानहरू, तिमीहरूका दशांश र विशेष भेटीहरू, तिमीहरूले याहवेहसँग भाकल गरेका सबै उत्तम कुराहरू।<verse eid="DEU 12:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 12:12"/>अनि त्यहाँ तिमीहरू, तिमीहरूका छोराछोरीहरू, तिमीहरूका सेवक-सेविकाहरू र तिमीहरूका सहरहरूका लेवीहरू, जसका आफ्ना कुनै पनि भाग वा अधिकार छैन, त्यहाँ सबैले याहवेह तिमीहरूका परमेश्‍वरको सामु आनन्द मनाओ।<verse eid="DEU 12:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 12:13"/>होसियारी हुनु र तिमीहरूका होमबलिहरू तिमीहरूलाई मनपर्ने जुनसुकै ठाउँमा नचढाउनू।<verse eid="DEU 12:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 12:14"/>याहवेहले तिमीहरूका कुलहरूमध्ये चुनेको ठाउँमा मात्र ती होमबलि चढाउनू, र मैले तिमीहरूलाई आज्ञा दिएका सबै कुरा पालना गर्नू।<verse eid="DEU 12:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 12:15"/>तरै पनि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुभएको आशिष्अनुसार तिमीहरूले हरिण अथवा मृग खाएझैँ आफ्ना पशुहरूलाई तिमीहरूका कुनै पनि सहरमा इच्छा लागेअनुसार मारेर चाहेजति खान सक्छौ। विधिपूर्वक शुद्ध अथवा अशुद्ध दुवै व्यक्तिले खान सक्छन्।<verse eid="DEU 12:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 12:16"/>तर तिमीहरूले रगतचाहिँ नखानू; रगतलाई पानीजस्तै भुइँमा खन्याइदिनू।<verse eid="DEU 12:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 12:17"/>तिमीहरूले तिमीहरूका अन्‍न, नयाँ दाखमद्य र जैतुन तेलको दशांश, बथान र बगालका पहिला जन्मेका पशु, तिमीहरूले दिन्छु भनी भाकल गरेका जुनसुकै थोक वा तिमीहरूका स्वेच्छा-भेटीहरू अथवा विशेष भेटीहरूचाहिँ तिमीहरूका आफ्नै सहरहरूमा नखानू।<verse eid="DEU 12:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 12:18"/>त्यसको सट्टामा तिमीहरू आफ्ना छोराछोरीहरू, तिमीहरूका सेवक-सेविकाहरू र तिमीहरूका सहरहरूका लेवीहरूले याहवेह तिमीहरूका परमेश्‍वरको उपस्थितिमा याहवेह तिमीहरूका परमेश्‍वरले चुन्‍नुभएको ठाउँमा ती खानू। अनि याहवेह तिमीहरूका परमेश्‍वरको सामु तिमीहरूले हात लगाएका हरेक काममा आनन्द मनाउनू।<verse eid="DEU 12:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 12:19"/>सावधान रहो! जबसम्म आफ्नो देशमा रहन्छौ, तबसम्म लेवीहरूको बेवास्ता नगर्नू।<verse eid="DEU 12:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 12:20"/>जब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई प्रतिज्ञा गर्नुभएझैँ तिमीहरूको प्रान्त ठूलो बनाइदिनुहुनेछ; अनि तिमीहरूले मासु खान ज्यादै इच्छा गर्नेछौ र भन्‍नेछौ, “मलाई मासु खान मन लाग्यो,” तब तिमीहरूले चाहेजति खान सक्छौ।<verse eid="DEU 12:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 12:21"/>यदि याहवेह तिमीहरूका परमेश्‍वरले आफ्नो नाम राख्नलाई चुन्‍नुहुने ठाउँ तिमीहरूदेखि अति टाढा छ भने याहवेहले तिमीहरूलाई दिनुभएका आफ्ना बथानहरू र बगालहरूबाट मैले तिमीहरूलाई आज्ञा दिएझैँ पशुहरू मार्न सक्छौ। अनि तिमीहरूका आफ्नै सहरहरूमा आफूलाई मन परेजति सक्दो ती खान सक्छौ।<verse eid="DEU 12:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 12:22"/>तिमीहरूले हरिण वा मृग खाएझैँ ती खानू। विधिपूर्वक शुद्ध र अशुद्ध दुवै व्यक्तिले ती खान सक्छन्।<verse eid="DEU 12:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 12:23"/>तर रगतचाहिँ कहिल्यै नखानू; किनकि रगत नै प्राण हो। त्यसैले तिमीहरूले प्राणसँगै मासु खानुहुँदैन।<verse eid="DEU 12:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 12:24"/>तिमीहरूले रगत नखानू; तर रगतलाई पानीजस्तै भुइँमा बगाइदिनू।<verse eid="DEU 12:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 12:25"/>रगतलाई नखानू, ताकि तिमीहरूले याहवेहको दृष्‍टिमा जे ठिक छ, त्यो गरिरहेका हुनेछौ। अनि तिमीहरू र तिमीहरूका छोराछोरीहरूलाई भलो हुनेछ।<verse eid="DEU 12:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 12:26"/>तर तिमीहरूले अर्पण गरेका कुराहरू र तिमीहरूले दिन्छु भनी भाकल गरेका सबै कुरासमेत लिएर याहवेहले छान्‍नुहुने ठाउँमा जाओ।<verse eid="DEU 12:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 12:27"/>याहवेह तिमीहरूका परमेश्‍वरको वेदीमा तिमीहरूका होमबलि, मासु र रगत दुवै चढाउनू। तिमीहरूका बलिदानहरूको रगत याहवेह तिमीहरूका परमेश्‍वरको वेदीको छेउमा पोखाउनुपर्छ, तर मासुचाहिँ तिमीहरूले खान सक्छौ।<verse eid="DEU 12:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 12:28"/>मैले तिमीहरूलाई दिइरहेका यी सबै नीति-नियमहरू होसियारीसाथ पालन गर्न तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको दृष्‍टिमा जे ठिक छ त्यो गर्नु, ताकि तिमीहरू र तिमीहरूका छोराछोरीहरूलाई सधैँ भलो होस्।<verse eid="DEU 12:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 12:29"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूले आक्रमण गरेर धपाउन लागेका जातिहरूलाई तिमीहरूको सामुबाट नाश गर्नुहुनेछ। तर जब तिमीहरूले तिनीहरूलाई बाहिर धपाएर तिनीहरूको देशमा बसोबास गर्नेछौ,<verse eid="DEU 12:29"/></para>
<para style="p"><verse number="30" style="v" sid="DEU 12:30"/>अनि तिमीहरूको सामुबाट तिनीहरू नष्‍ट भएपछि तिमीहरू होसियारी बस। अनि तिमीहरूले तिनीहरूका चालचलनको चासो राखेर उनीहरूका देवी-देवताको बारेमा यसो भन्दै नफस, “यी जातिहरूले आफ्ना देवी-देवताहरूको पूजा कसरी गर्छन्? हामी पनि त्यसै गरौँ।”<verse eid="DEU 12:30"/></para>
<para style="p"><verse number="31" style="v" sid="DEU 12:31"/>तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरलाई तिनीहरूको तरिकाले नपुज्नू; किनकि तिनीहरूले आफ्ना देवी-देवताहरूलाई पुज्दा याहवेहले घृणा गर्नुहुने हरप्रकारको घृणित कुराहरू गर्दछन्। तिनीहरूले आफ्ना देवी-देवताहरूका निम्ति बलिदानको रूपमा आफ्ना छोराछोरीहरूलाई समेत आगोमा बलि चढाउँछन्।<verse eid="DEU 12:31"/></para>
<para style="p"><verse number="32" style="v" sid="DEU 12:32"/>मैले तिमीहरूलाई आज्ञा दिएका सबै कुराहरू होसियारीसाथ पालन गर; त्यसमा केही नथप्नू र त्यसबाट केही नघटाउनू।<verse eid="DEU 12:32"/></para>
<chapter eid="DEU 12"/>
<chapter number="13" style="c" sid="DEU 13"/>
<para style="p"><verse number="1" style="v" sid="DEU 13:1"/>यदि तिमीहरूमध्ये कोही अगमवक्ता वा स्वप्नदर्शी निस्केर कुनै अचम्मको चिन्ह वा अद्‌भुत कार्यको घोषणा गर्छ भने,<verse eid="DEU 13:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 13:2"/>अनि यदि त्यसले भनेका कुराहरू, अलौकिक चिन्ह वा अद्‌भुत कार्य साँचो भयो भने त्यस अगमवक्ताले यसो भन्छ, “हामी अरू देवी-देवताहरूका पछि लागौँ, (तिमीहरूले नजानेका देवी-देवताहरू) र तिनीहरूलाई पूजौँ,”<verse eid="DEU 13:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 13:3"/>तिमीहरूले त्यस अगमवक्ता अथवा स्वप्नदर्शीका कुरा नसुन्‍नू। किनकि उहाँलाई तिमीहरूका सारा हृदयले, सारा प्राणले प्रेम गर्छौ कि गर्दैनौ भनेर याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई जाँच गरिरहनुभएको हुनेछ।<verse eid="DEU 13:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 13:4"/>याहवेह तिमीहरूका परमेश्‍वरलाई तिमीहरूले पछ्याउनू। अनि तिमीहरूले उहाँकै आदर गर्नू; उहाँका आज्ञाहरू पालन गर्नू र आज्ञाकारी हुनू; उहाँकै सेवा गर्नू। अनि उहाँमा विश्‍वासयोग्य भइरहनू।<verse eid="DEU 13:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 13:5"/>त्यस अगमवक्ता अथवा स्वप्नदर्शीलाई चाहिँ मार्नू; किनकि त्यसले तिमीहरूलाई इजिप्टबाट निकालेर ल्याउनुहुने र तिमीहरूलाई दासत्वको देशबाट मोल तिरेर छुटकारा दिएर ल्याउनुहुने याहवेह तिमीहरूका परमेश्‍वरको विरुद्धमा विद्रोही बन्‍नलाई उक्साएको छ। याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई मान्‍नू भनेर आज्ञा गर्नुभएका मार्गहरूबाट त्यसले तर्काएर लैजाने कोसिस गर्‍यो। तिमीहरूले आफ्नो बीचबाट दुष्‍टतालाई हटाउनैपर्छ।<verse eid="DEU 13:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 13:6"/>यदि तिमीहरूका आफ्नै दाजुभाइले, अथवा तिमीहरूका छोराछोरीले, अथवा तिमीहरूले प्रेम गरेकी पत्नी अथवा तिमीहरूका घनिष्‍ठ मित्रले तिमीहरूलाई यसो भनेर गुप्‍तमा बहकाउँछ भने, “हामी जाऔँ, र अरू देवी-देवताहरूलाई पूजा गरौँ” (तिमीहरू र तिमीहरूका पितापुर्खाहरूले नजानेका देवी-देवताहरू,<verse eid="DEU 13:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 13:7"/>तिमीहरूका वरिपरि भएका मानिसहरू, नजिक अथवा टाढा भएका, देशको एक छेउदेखि अर्को छेउसम्म भएका),<verse eid="DEU 13:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 13:8"/>तिमीहरू तिनीहरूका कुरामा नलाग्नू, वा तिनीहरूको कुरा नसुन्‍नू। तिनीहरूलाई दया नदेखाउनू। तिनीहरूलाई बाँकी नराख्नू वा नजोगाउनू।<verse eid="DEU 13:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 13:9"/>तिमीहरूले तिनीहरूलाई निश्‍चय नै मार्नू। तिनीहरूलाई मार्नका लागि तिमीहरूका हात पहिला उठोस्, र त्यसपछि अरू सबैका हातहरू उठून्।<verse eid="DEU 13:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 13:10"/>तिनीहरूलाई ढुङ्गाले हिर्काएर मार्नू; किनकि तिनीहरूले तिमीहरूलाई इजिप्टबाट, दासत्वको देशबाट निकालेर ल्याउनुहुने याहवेह तिमीहरूका परमेश्‍वरदेखि बहकाउन खोजे।<verse eid="DEU 13:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 13:11"/>तब सारा इस्राएलीहरूले यो सुन्‍नेछन् र डर मान्‍नेछन्। अनि तिमीहरूको बीचमा कहिल्यै कसैले पनि यस्तो दुष्‍ट काम फेरि गर्नेछैन।<verse eid="DEU 13:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 13:12"/>यदि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने सहरहरूमध्ये कुनै एउटा सहरको बारेमा तिमीहरूले यस्तो कुरा सुन्यौ,<verse eid="DEU 13:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 13:13"/>कि तिमीहरूबीच दुष्‍ट मानिसहरू निस्केर सहरका मानिसहरूलाई बहकाएर यसो भन्दैछन्, “हामी जाऔँ, र अरू देवी-देवताहरूलाई पूजा गरौँ”, (तिमीहरूले नचिनेका देवी-देवताहरू),<verse eid="DEU 13:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 13:14"/>तब तिमीहरूले त्यस बारेमा सावधानीसाथ सोधपुछ गर्नू, जाँच गर्नू र छानबिन गर्नू। यदि तिमीहरूका बीचमा यस्तो घृणित काम गरिएको साँचो हो भन्‍ने प्रमाणित भयो भने,<verse eid="DEU 13:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 13:15"/>तिमीहरूले त्यस सहरमा बस्‍ने सबैलाई निश्‍चित रूपमा तरवारले मार्नुपर्छ। तिमीहरूले तिनीहरूका मानिसहरू र गाईबस्तु दुवैलाई पूर्ण रूपले नाश गर्नू।<verse eid="DEU 13:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 13:16"/>त्यस सहरका सबै लुटका मालसामानहरू सार्वजनिक चोकको माझमा जम्मा गर्नू। अनि त्यस सहर र त्यसका सबै लुटका मालसामानहरूलाई याहवेह तिमीहरूका परमेश्‍वरको निम्ति होमबलिको रूपमा जलाइदिनू। त्यो सहर सदाका निम्ति भग्नावशेषको रूपमा रहोस्। अनि त्यस सहरको पुनर्निर्माण कहिल्यै नहोस्।<verse eid="DEU 13:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 13:17"/>विनाशका लागि तय गरिएका कुनै पनि चीजहरू तिमीहरूसँग नरहोस्। तब याहवेह आफ्नो डरलाग्दो रिसबाट फर्केर तिमीहरूमाथि कृपा देखाउनुहुनेछ, र दयालु हुनुहुनेछ। उहाँले तिमीहरूका पितापुर्खाहरूसँग शपथ खाएर प्रतिज्ञा गर्नुभएझैँ तिमीहरूको संख्यामा वृद्धि गराउनुहुनेछ;<verse eid="DEU 13:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 13:18"/>किनकि आज मैले तिमीहरूलाई दिइरहेका उहाँका सबै आज्ञाहरू तिमीहरूले पालन गर्दै उहाँको दृष्‍टिमा जे ठिक छ, त्यही गरिरहेका छौ।<verse eid="DEU 13:18"/></para>
<chapter eid="DEU 13"/>
<chapter number="14" style="c" sid="DEU 14"/>
<para style="p"><verse number="1" style="v" sid="DEU 14:1"/>तिमीहरू याहवेह तिमीहरूका परमेश्‍वरका सन्तान हौ। मरेकाहरूका निम्ति शोक मनाउन तिमीहरूले आफूलाई नकाट्नू वा आफ्नो शिरको अगाडिको कपाल नखौरनू;<verse eid="DEU 14:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 14:2"/>किनकि तिमीहरू याहवेह तिमीहरूका परमेश्‍वरका निम्ति एक पवित्र जाति हौ। सारा पृथ्वीभरिका सबै जातिहरूबाट याहवेहले तिमीहरूलाई उहाँको निज सम्पत्ति हुन चुन्‍नुभएको छ।<verse eid="DEU 14:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 14:3"/>कुनै पनि घृणित चीज नखाओ।<verse eid="DEU 14:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 14:4"/>तिमीहरूले यी पशुहरू खान सक्छौ: गोरु, भेडा, बाख्रा,<verse eid="DEU 14:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 14:5"/>मृग, बराँठ, हरिण, जङ्गली बाख्रा, पहाडी बाख्रा, चित्तल र हिमाली भेडा।<verse eid="DEU 14:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 14:6"/>पशुहरूमध्ये दुई भागमा खुर चिरिएको र उग्राउने पशुजति खान सक्छौ।<verse eid="DEU 14:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 14:7"/>तरै पनि उग्राउने पशुहरूमध्ये तिमीहरूले ऊँट, खरायो वा शापान नखानू। यद्यपि तिनीहरूले उग्राएर खाए तापनि तिनीहरूका खुर चिरिएका हुँदैनन्। तिनीहरू तिमीहरूका निम्ति विधिपूर्वक अशुद्ध हुन्।<verse eid="DEU 14:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 14:8"/>सुँगुर पनि अशुद्ध हो; यद्यपि त्यसका खुर चिरिएको हुन्छ; तर त्यसले उग्राउँदैन। तिमीहरूले त्यसको मासु नखाओ, अथवा त्यसको सिनो नछोओ।<verse eid="DEU 14:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 14:9"/>पानीमा भएका सबै प्राणीहरूमध्ये पखेटा र कत्ला भएकाहरू तिमीहरूले खान सक्छौ।<verse eid="DEU 14:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 14:10"/>तर तिमीहरूले पखेटा र कत्ला नभएका पानीका कुनै पनि प्राणी नखानू; तिमीहरूका निम्ति यी अशुद्ध हुन्।<verse eid="DEU 14:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 14:11"/>कुनै पनि शुद्ध चरा तिमीहरूले खान सक्छौ।<verse eid="DEU 14:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 14:12"/>तर तिमीहरूले यी चराहरू नखानू: गरुड, गिद्ध, कालो गिद्ध,<verse eid="DEU 14:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 14:13"/>रातो चील, कालो चील, सबै जातका बाज,<verse eid="DEU 14:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 14:14"/>सबै किसिमका काग,<verse eid="DEU 14:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 14:15"/>शुतुरमुर्ग, उल्‍लु र समुद्री चरो, सबै किसिमका बाज,<verse eid="DEU 14:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 14:16"/>सानो उल्‍लु, विशाल उल्‍लु, सेतो उल्‍लु,<verse eid="DEU 14:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 14:17"/>मरुभूमिको उल्‍लु, समुद्री बाज, माछा खाने चील,<verse eid="DEU 14:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 14:18"/>सारस, सबै किसिमका बकुल्‍ला, फाप्रेचरो र चमेरो।<verse eid="DEU 14:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 14:19"/>सबै उड्ने किराफट्याङ्ग्रा तिमीहरूका निम्ति अशुद्ध हुन्; तिनीहरूलाई नखाओ।<verse eid="DEU 14:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 14:20"/>तर पखेटा भएका कुनै पनि शुद्ध प्राणी तिमीहरूले खान सक्छौ।<verse eid="DEU 14:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 14:21"/>मरिसकेको कुनै पनि पशुप्राणी तिमीहरूले नखाओ। त्यो तिमीहरूले आफ्ना सहरमा बस्‍ने विदेशीलाई दिन सक्छौ। अनि त्यसले त्यो खान सक्छ, अथवा त्यो तिमीहरूले कुनै विदेशीलाई बेच्न सक्छौ। तर तिमीहरू आफ्ना याहवेह परमेश्‍वरका निम्ति एउटा पवित्र जाति हौ। तिमीहरूले बाख्राको पाठो, त्यसको मासुलाई माउको दूधमा नपकाउनू।<verse eid="DEU 14:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 14:22"/>तिमीहरूका जमिनबाट उब्जाएका सबै कुराहरूको दशांश प्रत्येक वर्ष छुट्याउन नबिर्सनू।<verse eid="DEU 14:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 14:23"/>तिमीहरूका अन्‍न, नयाँ दाखमद्य, जैतुन तेल अनि तिमीहरूका बथान र बगालहरूका पहिला जन्मेका पशुहरूका दशांश याहवेह तिमीहरूका परमेश्‍वरको उपस्थितिमा उहाँले आफ्नो नामको खातिर चुन्‍नुहुने ठाउँमा खानू, ताकि तिमीहरूले याहवेह आफ्ना परमेश्‍वरलाई सधैँ आदर गर्न सिक्न सक।<verse eid="DEU 14:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 14:24"/>तर यदि त्यो ठाउँ धेरै टाढा छ, र याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई यति धेरै आशिष् दिनुभएको छ कि तिमीहरूले आफ्ना दशांश बोकेर लैजान सकेनौ भने (याहवेहले आफ्नो नाम राख्नका लागि चुन्‍नुहुने ठाउँ अति टाढो भएको कारण),<verse eid="DEU 14:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 14:25"/>तब तिमीहरूले आफ्ना दशांश चाँदीसँग साट्नू, र त्यो चाँदी आफूसँग लिएर याहवेह तिमीहरूका परमेश्‍वरले चुन्‍नुहुने ठाउँमा जानू।<verse eid="DEU 14:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 14:26"/>तिमीहरूको मनपर्ने कुरा किन्‍न त्यस चाँदीलाई प्रयोग गर्न सक्छौ—गाईबस्तु, भेडा, दाखमद्य वा अरू मद्य वा तिमीहरूलाई इच्छा लागेअनुसार कुनै पनि कुरा। तब त्यहाँ याहवेह तिमीहरूका परमेश्‍वरको उपस्थितिमा तिमीहरू सपरिवार खाएर आनन्द मनाउनू।<verse eid="DEU 14:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 14:27"/>अनि तिमीहरूका सहरहरूमा बास गर्ने लेवीहरूलाई नबिर्सनू; किनकि तिनीहरूका आफ्ना व्यक्तिगत कुनै अंश अथवा उत्तराधिकारको भाग छैन।<verse eid="DEU 14:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 14:28"/>प्रत्येक तेस्रो वर्षको अन्त्यमा त्यस वर्षको उब्जनीको सबै दशांशहरू ल्याएर तिमीहरूका सहरहरूमा जम्मा गर्नू,<verse eid="DEU 14:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 14:29"/>ताकि लेवीहरू, जसको आफ्नै अंश र उत्तराधिकारको भाग छैन, र तिमीहरूका सहरहरूमा बसेका विदेशीहरू, अनाथ र विधवाहरूले आएर अघाउन्जेल खाऊन्; र याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका हातका सबै कामहरूमा तिमीहरूलाई आशिष् देऊन्।<verse eid="DEU 14:29"/></para>
<chapter eid="DEU 14"/>
<chapter number="15" style="c" sid="DEU 15"/>
<para style="p"><verse number="1" style="v" sid="DEU 15:1"/>प्रत्येक सात वर्षको अन्त्यमा तिमीहरूले ऋण माफी गरिदिनुपर्छ।<verse eid="DEU 15:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 15:2"/>त्यो यस प्रकारले गरिनुपर्छ: हरेक ऋणदाताले आफ्नो सङ्गी इस्राएलीलाई दिएको ऋण माफी गरोस्। तिनीहरूले आफ्नो सङ्गी इस्राएलीबाट ऋण चुक्ता गर्न नलगाओस्। किनकि याहवेहको ऋण माफी गर्ने समयको घोषणा भइसकेको छ।<verse eid="DEU 15:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 15:3"/>तिमीहरूले विदेशीबाट ऋण चुक्ता गरी माग्न सक्छौ, तर तिमीहरूका आफ्ना इस्राएली दाजुभाइले तिर्नुपर्ने ऋण माफी गरिदिनुपर्छ।<verse eid="DEU 15:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 15:4"/>तरै पनि तिमीहरूको बीचमा कोही पनि गरिब हुनुहुँदैन। किनकि तिमीहरूले अधिकार गर्नलाई याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई उत्तराधिकारको रूपमा दिनुहुने देशमा उहाँले तिमीहरूलाई प्रशस्त गरी आशिष् दिनुहुनेछ—<verse eid="DEU 15:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 15:5"/>यदि तिमीहरूले पूर्ण रूपले याहवेह तिमीहरूका परमेश्‍वरका आज्ञाहरू पालन गर्‍यौ र आज मैले तिमीहरूलाई दिइरहेका यी सबै आज्ञाहरू होसियारीसाथ पालन गर्‍यौ भने मात्र।<verse eid="DEU 15:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 15:6"/>उहाँले प्रतिज्ञा गर्नुभएझैँ याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आशिष् दिनुहुनेछ। अनि तिमीहरूले धेरै जातिहरूलाई ऋण दिनेछौ, तर कसैबाट ऋण लिनेछैनौ। तिमीहरूले धेरै जातिहरूमाथि शासन गर्नेछौ, तर तिमीहरूमाथि कसैले पनि शासन गर्न सक्नेछैन।<verse eid="DEU 15:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 15:7"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशको कुनै पनि सहरमा यदि तिमीहरूका दाजुभाइहरूमध्ये कोही गरिब छ भने तिनीप्रति तिमीहरूका हृदय कठोर नबनाओ, न त मदत गर्न कन्जुस होओ।<verse eid="DEU 15:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 15:8"/>बरु उदार चित्तको भएर तिनलाई चाहिए जति ऋण देओ।<verse eid="DEU 15:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 15:9"/>होशियार होओ, र यस्तो दुष्‍ट विचार मनमा नलेओ: “ऋण माफी गर्ने सातौँ वर्ष नजिकै छ,” भनी तिमीहरूले अभावमा परेको तिमीहरूका दाजुभाइप्रति दुष्‍ट भावना राखेर कुनै पनि कुरा दिन इन्कार नगर; नत्रता तिनीहरूले याहवेहसँग तिमीहरूको विरुद्धमा आवाज उठाऊलान्, र तिमीहरू पापको दोषी ठहरिनेछौ।<verse eid="DEU 15:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 15:10"/>तिनीहरूलाई उदार चित्तले दिनू; तर दुःख मन गर्दै अथवा दुःखी हृदयले नगर्नू; तब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका सबै काममा र तिमीहरूले हात लगाएका हरेक कुरामा तिमीहरूलाई आशिष् दिनुहुनेछ।<verse eid="DEU 15:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 15:11"/>देशमा गरिब मानिसहरू सधैँ भइरहनेछन्। यसकारण म तिमीहरूलाई आफ्ना इस्राएली दाजुभाइहरू र तिमीहरूका देशमा भएका गरिब र खाँचोमा परेकाहरूलाई उदार मनले दिनू भनेर आज्ञा दिन्छु।<verse eid="DEU 15:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 15:12"/>यदि तिमीहरूका सङ्गी हिब्रू पुरुष अथवा स्त्रीले आफूलाई तिमीहरूकहाँ दास वा दासी बन्‍न बेचिएको छ भने, र छ वर्षसम्म तिमीहरूको सेवा गरेको छ भन, सातौँ वर्षमा तिमीहरूले त्यसलाई स्वतन्त्र गरिदिनुपर्छ।<verse eid="DEU 15:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 15:13"/>अनि जब तिमीहरूले तिनीहरूलाई स्वतन्त्र तुल्याउँछौ, तब तिनीहरूलाई रित्तो हात नपठाउनू।<verse eid="DEU 15:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 15:14"/>तिमीहरूका बगाल, खला र दाखरसको कोलबाट तिनीहरूलाई उदार चित्तले दिनू। याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आशिष् दिनुभएझैँ तिनीहरूलाई प्रशस्त दिईकन पठाउनू।<verse eid="DEU 15:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 15:15"/>यो कुरा याद राख, तिमीहरू पनि इजिप्टमा दास थियौ। अनि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई छुटकारा दिनुभयो। यसैकारण म आज तिमीहरूलाई यो आज्ञा दिँदछु।<verse eid="DEU 15:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 15:16"/>तर यदि तिम्रो दासले तिमी र तिम्रो परिवारलाई प्रेम गर्छ; उसलाई तिमीहरूसँग बस्दा एकदमै खुशी मिलेको छ, र उसले यसरी भन्छ भने, “म तपाईंहरूलाई छोड्न चाहन्‍नँ,”<verse eid="DEU 15:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 15:17"/>तब एउटा सुतारी लिनू, र त्यसलाई घरको ढोकामा लगेर त्यसको कानको लोती छेडिदिनू। अनि त्यो जीवनभरि नै तिमीहरूका दास हुनेछ। तिमीहरूका दासीहरूसँग पनि यसरी नै गर्नू।<verse eid="DEU 15:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 15:18"/>तिमीहरूका दासलाई स्वतन्त्र भएर जान दिँदा गाह्रो नमान्‍नू; किनकि त्यसले तिमीहरूका निम्ति छ वर्ष सेवा गरेको छ, र त्यस ज्यालामा काम गर्ने कामदारहरूभन्दा दोबर ज्यालाको योग्यको हुन्छ। अनि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूले गर्ने हरेक काममा आशिष् दिनुहुनेछ।<verse eid="DEU 15:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 15:19"/>तिमीहरूका बथान अथवा बगालका पहिला जन्मेका हरेक पाठालाई याहवेह तिमीहरूका परमेश्‍वरका निम्ति छुट्याउनू। तिमीहरूका पहिलो जन्मेको गोरुलाई काममा नलगाउनू। अनि पहिले जन्मेको भेडाको ऊन नकत्रनू।<verse eid="DEU 15:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 15:20"/>प्रत्येक वर्ष तिमीहरू र आफ्ना परिवारले ती पशुहरूलाई याहवेह तिमीहरूका परमेश्‍वरको उपस्थितिमा उहाँले चुन्‍नुभएको ठाउँमा लगेर खानू।<verse eid="DEU 15:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 15:21"/>यदि कुनै पशुमा खोट छ, लङ्गडो वा अन्धो छ, अर्थात् त्यसका अरू कुनै खोट छ भने त्यसलाई याहवेह तिमीहरूका परमेश्‍वरका निम्ति बलिदान नचढाउनू।<verse eid="DEU 15:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 15:22"/>त्यसलाई तिमीहरूको आफ्नै सहरहरूमा खाओ। विधिपूर्वक शुद्ध र अशुद्ध दुवै व्यक्तिले त्यसलाई हरिण र मृग खाएझैँ खान सक्छौ।<verse eid="DEU 15:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 15:23"/>तर तिमीहरूले रगतचाहिँ नखाओ। त्यसलाई पानीजस्तै भुइँमा खन्याइदिनू।<verse eid="DEU 15:23"/></para>
<chapter eid="DEU 15"/>
<chapter number="16" style="c" sid="DEU 16"/>
<para style="p"><verse number="1" style="v" sid="DEU 16:1"/>आबीब महिनालाई पालन गर्नू, र याहवेह तिमीहरूका परमेश्‍वरको निस्तार चाड उत्सव मान्‍नू। किनकि उहाँले आबीब महिनामा तिमीहरूलाई इजिप्टबाट राति नै निकालेर ल्याउनुभएको थियो।<verse eid="DEU 16:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 16:2"/>अनि तिमीहरूले याहवेह आफ्ना परमेश्‍वरका निम्ति बथान अथवा बगालबाट एउटा पशु निस्तार चाडको रूपमा त्यस ठाउँमा बलिदान चढाउनू; जुन याहवेहले त्यहाँ आफ्नो नाम राख्नका निम्ति चुन्‍नुहुनेछ।<verse eid="DEU 16:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 16:3"/>त्यसलाई खमिर हालेको रोटीसँग नखानू, तर सात दिनसम्म अखमिरी रोटी, अर्थात् कष्‍टको रोटी खानू। किनकि तिमीहरूले इजिप्ट देशलाई हतार-हतारमा छाडेर आएका थियौ; ताकि तिमीहरूका जीवनभरि इजिप्टबाट निस्केको समयलाई तिमीहरूले स्मरण गर्न सक।<verse eid="DEU 16:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 16:4"/>तिमीहरूका सारा देशभरि सात दिनसम्म तिमीहरूसँग खमिर नभेट्टाइयोस्। तिमीहरूले पहिलो दिनको साँझमा बलिदान चढाएको मासुको कुनै पनि भाग बिहानसम्म नरहोस्।<verse eid="DEU 16:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 16:5"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने कुनै पनि सहरमा तिमीहरूले निस्तार चाडको बलिदान चढाउनुहुँदैन।<verse eid="DEU 16:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 16:6"/>उहाँले आफ्नो नामको खातिर वासस्थानको रूपमा चुन्‍नुहुने त्यस ठाउँमा मात्र चढाउनुपर्छ। त्यहाँ तिमीहरू इजिप्टबाट निस्केर आएको दिनको सम्झनामा वार्षिक उत्सवको निस्तार चाड साँझपख, घाम अस्ताउन लागेको बेला बलिदान चढाउनू।<verse eid="DEU 16:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 16:7"/>याहवेह तिमीहरूका परमेश्‍वरले चुन्‍नुहुने त्यही ठाउँमा तिमीहरूले त्यसलाई पोलेर खाओ। त्यसपछि तिमीहरू बिहानपख आफ्ना पालहरूमा फर्कनू।<verse eid="DEU 16:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 16:8"/>छ दिनसम्म अखमिरी रोटी खानू; अनि सातौँ दिनमा चाहिँ याहवेह तिमीहरूका परमेश्‍वरका निम्ति एउटा पवित्र भेला राख्नू; र त्यस दिन केही काम नगर्नू।<verse eid="DEU 16:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 16:9"/>तिमीहरूले खेतको अन्‍नबाली काट्न थालेको दिनदेखि सात हप्‍ता गन्‍नू।<verse eid="DEU 16:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 16:10"/>त्यसपछि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुभएको आशिष् अनुसारको स्वेच्छा-भेटी चढाएर याहवेह तिमीहरूका परमेश्‍वरका निम्ति साताहरूका चाड मनाउनू।<verse eid="DEU 16:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 16:11"/>अनि तिमीहरू आफ्ना छोराछोरीहरू, आफ्ना सेवक वा सेविकाहरू, तिमीहरूका सहरहरूमा भएका लेवीहरू, विदेशीहरू, अनाथहरू र तिमीहरूसँग बस्‍ने विधवाहरूले आफ्नो नामको खातिर याहवेह तिमीहरूका परमेश्‍वरले चुन्‍नुहुने वासस्थानको ठाउँमा उहाँको सामु आनन्द मनाउनू।<verse eid="DEU 16:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 16:12"/>तिमीहरू पनि इजिप्टमा दास थियौ भन्‍ने कुरा याद राख्नू। अनि यी उर्दीहरू होसियारीसाथ पालन गर्नू।<verse eid="DEU 16:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 16:13"/>तिमीहरूले आफ्ना खला र आफ्ना दाखरसको कोलका उब्जनी बाली बटुलिसकेपछि सात दिनसम्म छाप्रोबासको चाड मनाउनू।<verse eid="DEU 16:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 16:14"/>तिमीहरू, तिमीहरूका छोराछोरीहरू, तिमीहरूका सेवक र सेविकाहरू, लेवीहरू, विदेशीहरू, अनाथहरू र तिमीहरूका सहरहरूमा बस्‍ने विधवाहरू तिमीहरू सबैले छाप्रोबासको चाडमा आनन्द मनाऊन्।<verse eid="DEU 16:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 16:15"/>याहवेहले चुन्‍नुहुने ठाउँमा सात दिनसम्म याहवेह तिमीहरूका परमेश्‍वरको निम्ति यो चाड मनाउनू। किनकि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका सबै खेतीबाली र तिमीहरूका हातका सबै कामहरूमा तिमीहरूलाई आशिष् दिनुहुनेछ। अनि तिमीहरूको आनन्द पूरा हुनेछ।<verse eid="DEU 16:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 16:16"/>तिमीहरूका सबै पुरुषहरू वर्षमा तीन पल्ट याहवेह तिमीहरूका परमेश्‍वरले चुन्‍नुहुने ठाउँमा उहाँको सामु देखा पर्नुपर्छ: अर्थात् अखमिरी रोटीको चाडमा, साताहरूका चाडमा र छाप्रोबासको चाडमा तिमीहरूका सबै पुरुषहरू देखा परून्। याहवेहको सामु कोही पनि रित्तो हात देखा नपरोस्।<verse eid="DEU 16:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 16:17"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आशिष् दिनुभएअनुसार हरेकले भेटी ल्याउनुपर्छ।<verse eid="DEU 16:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 16:18"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने हरेक सहरमा तिमीहरूले प्रत्येक कुलका निम्ति न्यायकर्ताहरू र अधिकृतहरू नियुक्त गर्नू। अनि तिनीहरूले मानिसहरूलाई ठिकसँग न्याय गर्नेछन्।<verse eid="DEU 16:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 16:19"/>न्यायमा भ्रष्‍टता नगर्नू, अर्थात् पक्षपात नगर्नू; न त घूस नै लिनू। किनकि घूसले बुद्धिमान्‌को आँखा अन्धा तुल्याइदिन्छ र निर्दोषका कुरालाई बङ्ग्याइदिन्छ।<verse eid="DEU 16:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 16:20"/>न्याय, केवल न्यायलाई मात्र पालन गर; ताकि तिमीहरू जीवित रहन सक। अनि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशमा तिमीहरूले अधिकार गर्न सक्नेछौ।<verse eid="DEU 16:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 16:21"/>याहवेह तिमीहरूका परमेश्‍वरका निम्ति तिमीहरूले बनाएको वेदीको छेउमा काठको अशेरा देवीको कुनै खम्बा खडा नगर्नू।<verse eid="DEU 16:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 16:22"/>अनि कुनै चोखो ढुङ्गा खडा नगर्नू; किनकि याहवेह तिमीहरूका परमेश्‍वरले यी कुराहरूलाई घृणा गर्नुहुन्छ।<verse eid="DEU 16:22"/></para>
<chapter eid="DEU 16"/>
<chapter number="17" style="c" sid="DEU 17"/>
<para style="p"><verse number="1" style="v" sid="DEU 17:1"/>याहवेह तिमीहरूका परमेश्‍वरलाई खोट अथवा दाग भएको कुनै गोरु अथवा भेडा तिमीहरूले नचढाउनू; किनकि उहाँले त्यो घृणा गर्नुहुन्छ।<verse eid="DEU 17:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 17:2"/>यदि याहवेहले तिमीहरूलाई दिनुहुने कुनै पनि सहरमा तिमीहरूबीच बस्‍ने कुनै पुरुष अथवा स्त्रीले याहवेह तिमीहरूका परमेश्‍वरको दृष्‍टिमा उहाँको करार भङ्ग गर्दै दुष्‍ट काम गरिरहेको भेट्टाइयो भने,<verse eid="DEU 17:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 17:3"/>अनि मेरा आज्ञाहरूको विरुद्धमा अरू देवी-देवताहरूलाई पूजा गरेर तिनीहरूका सामु अर्थात् सूर्य वा चन्द्र र आकाशका ताराहरूको सामु दण्डवत् गरेको छ भने,<verse eid="DEU 17:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 17:4"/>र यी कुरा तिमीहरूले थाहा पायौ भने यस बारेमा तिमीहरूले एकदमै राम्रोसँग छानबिन गर्नुपर्छ। यदि यो कुरा सत्य हो, र यस्तो घिनलाग्दो काम इस्राएलमा भएको प्रमाणित भयो भने,<verse eid="DEU 17:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 17:5"/>यस्तो दुष्‍ट काम गर्ने त्यस पुरुष अथवा स्त्रीलाई तिमीहरूका सहरका मूलढोकामा लैजानू; र त्यसलाई ढुङ्गाले हानेर मार्नू।<verse eid="DEU 17:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 17:6"/>दुई वा तीन जनाको साक्षीद्वारा ती मानिसहरूलाई मार्नू। तर एउटै मात्र साक्षीको गवाहीद्वारा चाहिँ कसैलाई नमार्नू।<verse eid="DEU 17:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 17:7"/>त्यसलाई मार्न साक्षीहरूकै हातद्वारा पहिले ढुङ्गाले हानून्; अनि मात्र अरू मानिसहरूले ढुङ्गाले हानून्। यसरी तिमीहरूका बीचबाट तिमीहरूले नै दुष्‍टतालाई हटाउनू।<verse eid="DEU 17:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 17:8"/>यदि तिमीहरूको सामु हत्याकाण्ड, कानुनी-विवाद अथवा झैझगडाजस्ता तिमीहरूलाई न्याय गर्न गाह्रो पर्ने खालका मुद्दा-मामिलाहरू उठे भने तिनीहरूलाई याहवेह तिमीहरूका परमेश्‍वरले चुन्‍नुहुने ठाउँमा लैजानू।<verse eid="DEU 17:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 17:9"/>अनि लेवी पुजारीहरूकहाँ र त्यस समयमा कार्यभार सम्हालेर बस्‍ने न्यायकर्ताकहाँ जानू। तिनीहरूलाई सोधपुछ गर्नू, र तिनीहरूले फैसला सुनाउनेछन्।<verse eid="DEU 17:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 17:10"/>याहवेहले चुन्‍नुहुने ठाउँमा न्यायकर्ताहरूले दिएका निर्णयअनुसार तिमीहरूले काम गर्नुपर्छ। तिनीहरूले तिमीहरूलाई जे गर्नू भनेका छन्, त्यही हरेक कुरा होसियारीसाथ गर्नुपर्छ।<verse eid="DEU 17:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 17:11"/>तिनीहरूले तिमीहरूलाई सिकाएका नियम र तिमीहरूलाई दिएका निर्णयअनुसार काम गर्नू। तिनीहरूले तिमीहरूलाई भनेका कुरादेखि दायाँ अथवा बायाँ नलाग्नू।<verse eid="DEU 17:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 17:12"/>याहवेह तिमीहरूका परमेश्‍वरको सेवा गर्नलाई उभिएका पुजारी अथवा न्यायकर्ताको आज्ञालाई जसले उल्‍लङ्घन गर्छ, त्यो मानिस मारिनुपर्छ। यसरी तिमीहरूले इस्राएलबाट दुष्‍टता हटाउनुपर्छ।<verse eid="DEU 17:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 17:13"/>यो कुरा सबै मानिसहरूले सुन्‍नेछन्, र फेरि अनाज्ञाकारी हुनेछैनन्।<verse eid="DEU 17:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 17:14"/>जब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशमा तिमीहरू पुग्नेछौ, र त्यसमाथि अधिकार गरेर त्यस देशमा बसोबास गर्नेछौ; अनि तिमीहरूले भन्‍नेछौ, “हाम्रा चारैतिर भएका सबै जातिहरूले झैँ हामीमाथि एउटा राजा खडा गरौँ,”<verse eid="DEU 17:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 17:15"/>तब तिमीहरूले निश्‍चित रूपमा याहवेह तिमीहरूका परमेश्‍वरले चुन्‍नुभएका राजा नै आफूमाथि नियुक्त गर्नू। ती राजा तिमीहरूकै इस्राएली दाजुभाइहरूको बीचबाट हुनुपर्छ। तिमीहरूका राजा कुनै विदेशी, अथवा इस्राएल बाहिरकोलाई नियुक्त नगर्नू।<verse eid="DEU 17:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 17:16"/>यसबाहेक राजाले आफ्ना निम्ति धेरै संख्यामा घोडाहरू नराखून्, अथवा अझ धेरै प्राप्‍त गर्न मानिसहरूलाई इजिप्टमा फर्केर जान नलगाऊन्। किनकि याहवेहले तिमीहरूलाई यसो भन्‍नुभएको छ, “तिमीहरू फेरि त्यो बाटोतिर फर्केर नजाओ।”<verse eid="DEU 17:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 17:17"/>तिनले धेरै पत्नीहरू नराखून्; नत्रता तिनको मन बरालिनेछ। तिनले आफ्ना निम्ति प्रशस्त सुन र चाँदी नथुपारून्।<verse eid="DEU 17:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 17:18"/>जब तिनी आफ्नो राज्यको सिंहासनमाथि बस्छन्, तब तिनले एउटा चर्मपत्रमा लेवी पुजारीबाट लिइएको व्यवस्थाको एक प्रति नक्‍कल आफ्ना निम्ति लेखेर राख्नुपर्छ।<verse eid="DEU 17:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 17:19"/>योचाहिँ तिनीसँग हुनुपर्छ, र तिनले त्यस व्यवस्थालाई आफ्नो जीवनभरि पढ्नुपर्छ, ताकि तिनले याहवेह तिनको परमेश्‍वरलाई आदर गर्न, र यस व्यवस्थाका सबै वचन र उर्दीहरू होसियारीसाथ पालन गर्न सिकून्।<verse eid="DEU 17:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 17:20"/>अनि राजाले आफूलाई आफ्ना दाजुभाइहरूभन्दा श्रेष्‍ठ ठानेर व्यवस्थाभन्दा दायाँ तथा बायाँ नफर्कून्। तब तिनी र तिनका सन्तानहरूले इस्राएलमा भएको आफ्नो राज्यमाथि लामो समयसम्म राज्य गर्नेछन्।<verse eid="DEU 17:20"/></para>
<chapter eid="DEU 17"/>
<chapter number="18" style="c" sid="DEU 18"/>
<para style="p"><verse number="1" style="v" sid="DEU 18:1"/>वास्तवमा लेवीको पुजारीहरू कुलले इस्राएलसँग कुनै अंश र उत्तराधिकारको भाग पाउनेछैनन्। तिनीहरू याहवेहलाई चढाइएको भेटीद्वारा नै जिउनेछन्। किनकि तिनीहरूले पाउने अंश त्यही हो।<verse eid="DEU 18:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 18:2"/>तिनीहरूका इस्राएली दाजुभाइहरूका बीचमा तिनीहरूको कुनै उत्तराधिकार हुनेछैन। याहवेहले प्रतिज्ञा गर्नुभएझैँ उहाँ नै तिनीहरूका उत्तराधिकारको भाग हुनुहुन्छ।<verse eid="DEU 18:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 18:3"/>गोरु अथवा भेडा बलिदान गर्दा मानिसहरूबाट पुजारीहरूले पाउने भाग यही हो: काँध, टाउकोको मासु र भित्री भागहरू।<verse eid="DEU 18:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 18:4"/>तिमीहरूले तिनीहरूलाई तिमीहरूका अन्‍न, नयाँ दाखमद्य, जैतुन तेलको पहिलो फल, र तिमीहरूका भेडाको कत्रेको ऊनको पहिलो भाग दिनुपर्छ।<verse eid="DEU 18:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 18:5"/>किनकि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका सबै कुलहरूबाट लेवीहरूलाई याहवेहको नाममा खडा भई सेवा गर्नलाई सधैँका निम्ति चुन्‍नुभएको छ।<verse eid="DEU 18:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 18:6"/>यदि लेवीहरू इस्राएलमा आफू बसेको कुनै पनि सहरबाट सरेर याहवेहले चुन्‍नुहुने ठाउँमा सेवाको भावना लिएर आउँछन् भने,<verse eid="DEU 18:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 18:7"/>तिनीहरूले याहवेहको उपस्थितिमा आफ्ना सङ्गी-लेवीहरूले सेवा गरेझैँ याहवेह तिनीहरूका परमेश्‍वरको नाममा सेवा गर्न सक्छन्।<verse eid="DEU 18:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 18:8"/>तिनीहरूले आफ्नो परिवारको सम्पत्तिको बिक्रीबाट रकम पाए तापनि तिनीहरूले पुजारीहरूका बराबर थप हिस्सा पाउनुपर्छ।<verse eid="DEU 18:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 18:9"/>जब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशमा तिमीहरू पुग्छौ, तब त्यहाँका जातिहरूका घृणित चालहरूको अनुसरण गर्न नसिक।<verse eid="DEU 18:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 18:10"/>तिमीहरूमध्ये कसैले पनि आफ्ना छोरा वा छोरीलाई आगोमा बलिदान गरेको, जोखना हेरेको वा तन्त्रमन्त्र गरेको, जोखना हेर्ने, तन्त्रमन्त्र गर्ने कार्यमा संलग्न रहेको नभेट्टाइयोस्,<verse eid="DEU 18:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 18:11"/>अथवा टुनामुना गर्ने, प्रेत-आत्मा जगाउने, तन्त्रमन्त्रको काम गर्ने वा प्रेत-आत्मासँग कुरा गर्ने कोही पनि नभेट्टाइयोस्।<verse eid="DEU 18:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 18:12"/>यी कुराहरू गर्ने जोसुकै होस्, याहवेहले घृणा गर्नुहुन्छ। यस्ता घिनलाग्दा कामहरूको कारण नै याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका सामुबाट ती जातिहरूलाई धपाउँदैहुनुहुन्छ।<verse eid="DEU 18:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 18:13"/>तिमीहरूचाहिँ याहवेह तिमीहरूका परमेश्‍वरको सामु निर्दोष हुनुपर्छ।<verse eid="DEU 18:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 18:14"/>तिमीहरूले अधीनमा पार्ने जातिहरूले चाहिँ जोखना हेर्ने र तन्त्रमन्त्र गर्नेहरूका कुरा सुन्छन्। तर तिमीहरूलाई चाहिँ याहवेह तिमीहरूका परमेश्‍वरले यसो गर्न निषेध गर्नुभएको छ।<verse eid="DEU 18:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 18:15"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका निम्ति तिमीहरूकै इस्राएली दाजुभाइहरूका बीचबाट मजस्तै एक जना अगमवक्ता खडा गर्नुहुनेछ। तिमीहरूले तिनको कुरा सुन्‍नुपर्छ।<verse eid="DEU 18:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 18:16"/>किनकि तिमीहरूले सभाको दिन होरेब पर्वतमा याहवेह तिमीहरूका परमेश्‍वरसँग यसो भनेर बिन्ती गरेका थियौ, “अब उसो याहवेह हाम्रा परमेश्‍वरको सोर हामीले सुन्‍न नपरोस्, न त यस्तो भयङ्ककर आगो नै देख्न परोस्; नत्रता हामी मर्नेछौँ।”<verse eid="DEU 18:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 18:17"/>याहवेहले मलाई भन्‍नुभयो: “तिनीहरूले ठिकै भनेका छन्।<verse eid="DEU 18:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 18:18"/>म तिनीहरूका निम्ति तिनीहरूकै इस्राएली दाजुभाइहरू बीचबाट तँजस्तै एउटा अगमवक्ता खडा गर्नेछु। अनि म मेरा वचनहरू त्यसका मुखमा हालिदिनेछु। मैले त्यसलाई आज्ञा गरेका हरेक कुरा त्यसले तिनीहरूलाई भन्‍नेछन्।<verse eid="DEU 18:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 18:19"/>यदि त्यस अगमवक्ताले मेरो नाममा भनेका मेरा वचनहरू कसैले सुन्दैन भने म आफैँले त्यसको लेखा लिनेछु।<verse eid="DEU 18:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 18:20"/>तर कुनै अगमवक्ताले मैले त्यसलाई नभनेका कुराहरू पनि मेरो नाममा बोल्ने साहस गर्छ, अथवा कुनै अगमवक्ताले अरू देवी-देवताहरूका नाममा बोल्छ भने त्यो अगमवक्तालाई मारिनुपर्छ।”<verse eid="DEU 18:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 18:21"/>तिमीहरूले यसरी सोचौला, “याहवेहबाट आएको सन्देश हो कि होइन भनी हामीले कसरी जान्‍ने?”<verse eid="DEU 18:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 18:22"/>यदि कुनै अगमवक्ताले याहवेहको नाममा घोषणा गरेको कुरा पूरा भएन अथवा सत्य ठहरिएन भने त्यो सन्देश याहवेहबाट आएको होइन। त्यस अगमवक्ताले मनगढन्ते कुरा भनेको हो। यसकारण त्यससँग नडराओ।<verse eid="DEU 18:22"/></para>
<chapter eid="DEU 18"/>
<chapter number="19" style="c" sid="DEU 19"/>
<para style="p"><verse number="1" style="v" sid="DEU 19:1"/>जब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशका जातिहरूलाई नाश गरी सक्नुहुन्छ, र जब तिमीहरूले तिनीहरूलाई धपाएर तिनीहरूका सहरहरू र घरहरूमा बसोबास गर्छौ,<verse eid="DEU 19:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 19:2"/>तब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई अधिकार गर्न दिनुहुने देशमा तिमीहरूले आफ्ना लागि तीन वटा सहरहरू अलग गर्नू।<verse eid="DEU 19:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 19:3"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई उत्तराधिकारको रूपमा दिनुहुने देशलाई तीन भागमा विभाजन गर्नू। ती सहरहरूमा पुग्नलाई बाटोहरू बनाउनू, ताकि कुनै पनि ज्यानमारा शरण-नगरमा भागेर जान सकोस्।<verse eid="DEU 19:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 19:4"/>यो नियम कुनै व्यक्तिलाई मार्ने कुनै पनि हत्यारा सम्बन्धी हो: जो आफ्नो प्राण बचाउनलाई त्यहाँ भागेर जान्छ; जसले आफ्नो छिमेकीलाई कुनै दुश्मनीको कारणविना अनजानमा मार्दछ।<verse eid="DEU 19:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 19:5"/>मानौँ कुनै मानिस आफ्नो छिमेकीसँग दाउरा काट्न वनमा जान्छ, र त्यसले रूख ढाल्नलाई आफ्नो बन्चरो चलाउँदा त्यसको बिँडबाट बन्चरो खुस्केर त्यस छिमेकीलाई लागेर मर्‍यो भने त्यो मानिस यी शरण-नगरहरूमध्ये एउटामा भागेर आफ्नो प्राण बचाउन सक्छ।<verse eid="DEU 19:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 19:6"/>नत्रता शरणस्थानको बाटो लामो भएको कारण बदला लिनेले आफ्नो क्रोधमा उसलाई खेदेर भेट्टाउन सक्छ र मार्न सक्छ; जबकि ऊ मृत्युदण्डको योग्य नै थिएन। किनकि उसको मनमा मृतक छिमेकीप्रति कुनै रिस-राग नै थिएन।<verse eid="DEU 19:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 19:7"/>यसैकारण मैले तिमीहरूलाई आफ्ना निम्ति तीन वटा सहरहरू अलग गर्नू भन्‍ने आज्ञा दिँदैछु।<verse eid="DEU 19:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 19:8"/>यदि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका पितापुर्खाहरूसँग शपथ खाएर प्रतिज्ञा गर्नुभएझैँ, तिमीहरूका इलाका बढाइदिनुभयो, र उहाँले तिनीहरूसँग प्रतिज्ञा गर्नुभएको सम्पूर्ण देश तिमीहरूलाई दिनुभयो भने,<verse eid="DEU 19:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 19:9"/>आज मैले तिमीहरूलाई आज्ञा दिएका सबै नियमहरू होसियारीसाथ पालन गर्‍यौ, अर्थात् याहवेह तिमीहरूका परमेश्‍वरलाई प्रेम गर्‍यौ र उहाँका मार्गमा सधैँ आज्ञाकारी भयौ भने तिमीहरूले अझ तीन वटा सहरहरू थप्नू।<verse eid="DEU 19:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 19:10"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई उत्तराधिकारको रूपमा दिनुहुने तिमीहरूको देशमा निर्दोषको रगत नबगोस् भनेर तिमीहरूले यसो गर्नू; ताकि तिमीहरू रगतको दोषी हुन नपरोस्।<verse eid="DEU 19:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 19:11"/>तर यदि कुनै मानिसले आफ्नो छिमेकीलाई घृणाको भावनाले ढुकेर कुटपिट गरेर मार्‍यो; अनि यी कुनै सहरहरूमा भागेर गयो भने,<verse eid="DEU 19:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 19:12"/>त्यस सहरका प्रधानहरूले हत्यारालाई त्यस सहरबाट फर्काएर ल्याउनेछन् र त्यस दोषीलाई रगतको बदला लिनेको हातमा मार्नको लागि सुम्पिदिनेछन्।<verse eid="DEU 19:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 19:13"/>त्यस हत्यारालाई दया नदेखाउनू। तिमीहरूले इस्राएलबाट निर्दोषको रगत बगाउनेको दोष हटाउनुपर्छ, ताकि तिमीहरूको भलो होस्।<verse eid="DEU 19:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 19:14"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई अधिकार गर्नू भनी दिनुहुने देशमा तिमीहरूले पाएको अधिकारको भागमा तिमीहरूका पुर्खाहरूले लगाएका तिमीहरूका छिमेकीका साँधसिमानाको ढुङ्गा नहटाउनू।<verse eid="DEU 19:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 19:15"/>कुनै अपराध वा अभियोग लगाइएको व्यक्तिलाई दोषी ठहराउन एक जना साक्षी मात्र पर्याप्‍त हुँदैन। दुई वा तीन जना व्यक्तिहरूको साक्षीद्वारा मात्र अपराधीलाई दोषी प्रमाणित गर्न सकिन्छ।<verse eid="DEU 19:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 19:16"/>यदि कसैलाई अपराधको अभियोग लगाउन कोही झूटो साक्षी खडा भयो भने,<verse eid="DEU 19:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 19:17"/>त्यस झगडामा संलग्न रहने ती दुई मानिसहरूलाई त्यस बेलाका पुजारीहरू र न्यायकर्ताहरूको सामु याहवेहको उपस्थितिमा खडा गराउनुपर्छ।<verse eid="DEU 19:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 19:18"/>ती न्यायकर्ताहरूले पूरा रूपले जाँच गर्नुपर्छ। यदि त्यस साक्षीले आफ्नो इस्राएली दाजुभाइको विरुद्धमा झूटो साक्षी दिएर दोष लगाएको कुरा प्रमाणित भयो भने,<verse eid="DEU 19:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 19:19"/>त्यसलाई दोष लगाएको व्यक्तिले पाउनुपर्ने सजायजस्तै सजाय दिनू। यसरी तिमीहरूका बीचबाट तिमीहरूले दुष्‍टता हटाउनुपर्छ।<verse eid="DEU 19:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 19:20"/>बाँकी रहेका मानिसहरूले यस कुरालाई सुन्‍नेछन् र डराउनेछन्। अनि तिमीहरूको बीचमा यस्तो दुष्‍ट कुरा कहिल्यै हुनेछैन।<verse eid="DEU 19:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 19:21"/>तिमीहरूले अपराधीलाई दया नदेखाओ: प्राणको सट्टा प्राण, आँखाको सट्टा आँखा, दाँतको सट्टा दाँत, हातको सट्टा हात, खुट्टाको सट्टा खुट्टा हुनुपर्छ।<verse eid="DEU 19:21"/></para>
<chapter eid="DEU 19"/>
<chapter number="20" style="c" sid="DEU 20"/>
<para style="p"><verse number="1" style="v" sid="DEU 20:1"/>जब तिमीहरू आफ्ना शत्रुहरूका विरुद्धमा युद्ध गर्न जान्छौ, र आफ्नोभन्दा बढी घोडा, रथ र फौज देख्छौ, तब तिनीहरूदेखि नडराओ; किनकि तिमीहरूलाई इजिप्टबाट बाहिर निकालेर ल्याउनुहुने याहवेह तिमीहरूका परमेश्‍वर तिमीहरूसँग हुनुहुनेछ।<verse eid="DEU 20:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 20:2"/>जब तिमीहरू युद्धमा जान लाग्छौ, तब तिमीहरूको अगि पुजारी आउनेछ, र सेनाहरूलाई सम्बोधन गर्नेछ।<verse eid="DEU 20:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 20:3"/>त्यसले यसो भन्‍नेछ, “हे इस्राएलीहरू हो, सुन! आज तिमीहरू आफ्ना शत्रुहरूको विरुद्धमा युद्ध लड्न जाँदैछौ। आफ्नो मन सानो नगर, वा नडराओ; नआत्तिओ अथवा तिनीहरूसँग भयभीत नहोओ।<verse eid="DEU 20:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 20:4"/>किनकि याहवेह तिमीहरूका परमेश्‍वर नै तिमीहरूलाई विजयी तुल्याउन तिमीहरूका निम्ति तिमीहरूका शत्रुहरूको विरुद्धमा युद्ध गर्न तिमीहरूसँगै जानुहुन्छ।”<verse eid="DEU 20:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 20:5"/>तब अधिकृतहरूले सेनाहरूलाई यसो भनून्, “कसैले नयाँ घर बनाएर त्यसलाई समर्पण नगरी आएको कोही छ? त्यो घर जाओस्; नत्रता त्यो युद्धमा मर्ला, र अरू कसैले त्यस घरको समर्पण गर्नुपर्ला।<verse eid="DEU 20:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 20:6"/>कसैले दाखबारी लगाएर फल उपभोग गर्न पाएको छैन? त्यो घर जाओस्; नत्रता त्यो युद्धमा मर्ला, र अरू कसैले फललाई उपभोग गर्ला।<verse eid="DEU 20:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 20:7"/>कसैले कुनै स्त्रीसँग विवाहको वाचा गरेको छ र त्यसलाई विवाह नगरी आएको छ? त्यो घर जाओस्; नत्रता त्यो युद्धमा मर्ला, र अरू कसैले त्यस स्त्रीलाई विवाह गर्ला।”<verse eid="DEU 20:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 20:8"/>त्यसपछि अधिकृतहरूले यसो पनि भन्‍नेछन्, “के कुनै मानिस डरपोक र कातर छ? त्यो घर जाओस्; ताकि त्यसका कारणले त्यसका दाजुभाइहरू पनि हताश नहोऊन्।”<verse eid="DEU 20:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 20:9"/>अधिकृतहरूले सेनाहरूसँग कुरा गरिसकेपछि तिनीहरूले सेनाहरूमाथि सेनापतिहरू नियुक्त गरून्।<verse eid="DEU 20:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 20:10"/>जब तिमीहरू कुनै सहरमाथि मोर्चा बाँधेर आक्रमण गर्न जान्छौ, तब त्यहाँका मानिसहरूसँग शान्तिको प्रस्ताव राख्नू।<verse eid="DEU 20:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 20:11"/>यदि तिनीहरूले त्यो प्रस्ताव स्वीकार गरे, र तिनीहरूका मूलढोकाहरू खोलिदिए भने त्यहाँका सबै मानिसहरू तिमीहरूका बेगारी हुनेछन्। अनि तिमीहरूका निम्ति काम गर्नेछन्।<verse eid="DEU 20:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 20:12"/>यदि तिनीहरूले शान्तिको प्रस्ताव स्वीकार गरेनन्, तर लडाइँ गर्न तयार भए भने त्यस सहरलाई घेरा हाल्नू।<verse eid="DEU 20:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 20:13"/>जब याहवेह तिमीहरूका परमेश्‍वरले तिनीहरूलाई तिमीहरूको हातमा सुम्पिदिनुहुन्छ, तब त्यहाँ भएका सबै पुरुषहरूलाई तरवारले मार्नू।<verse eid="DEU 20:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 20:14"/>तर सहरमा भएका स्त्रीहरू, बालबालिकाहरू, गाईबस्तु र हरेक थोक तिमीहरूले लुटको मालसामानको रूपमा आफ्ना निम्ति लिन सक्छौ। अनि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका शत्रुहरूबाट तिमीहरूलाई दिनुभएको लुटको मालसामान प्रयोग गर्न सक्छौ।<verse eid="DEU 20:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 20:15"/>तिमीहरूबाट टाढा रहेका सहरहरूसँग यस्तो व्यवहार गर्नू, जुन सहरहरू तिमीहरूका छेउछाउका जातिहरूका होइनन्।<verse eid="DEU 20:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 20:16"/>तरै पनि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई अधिकारको रूपमा दिनुहुने जातिहरूका सहरहरूमा सास हुने कुनै पनि प्राणीलाई जीवित नछोड्नू।<verse eid="DEU 20:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 20:17"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आज्ञा गर्नुभएझैँ तिनीहरूलाई अर्थात् हित्ती, एमोरी, कनानी, परिज्जी, हिव्वी र यबूसीहरूलाई सम्पूर्ण रूपले नाश गर्नू।<verse eid="DEU 20:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 20:18"/>नत्रता तिनीहरूले तिमीहरूलाई आफ्ना देवी-देवताहरूका पूजा गर्दा गरिने सबै घृणित कुराहरूका अनुसरण गर्नलाई सिकाउनेछन्। अनि तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको विरुद्धमा पाप गर्नेछौ।<verse eid="DEU 20:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 20:19"/>जब तिमीहरू कुनै सहरलाई कब्जा गर्न त्यसको विरुद्धमा लामो समयसम्म लडाइँ गर्छौ, तब त्यस सहरलाई घेरामा राख्दा त्यहाँका रूखहरूलाई काटेर नाश नगर। किनकि तिमीहरूले तिनका फलहरू खान सक्छौ। ती काटेर नढाल्नू। के खेतका रूखहरू मानिसहरू हुन्, र तिमीहरूले तिनीहरूलाई नष्‍ट गर्छौ?<verse eid="DEU 20:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 20:20"/>तरै पनि, तिमीहरूले फल नफल्ने रूखहरूलाई चाहिँ काटेर ढाल्न सक्छौ। अनि तिमीहरूसँग युद्धमा रहेको सहर परास्त नभएसम्म घेरा हाल्ने कामहरूमा प्रयोग गर्न सक्छौ।<verse eid="DEU 20:20"/></para>
<chapter eid="DEU 20"/>
<chapter number="21" style="c" sid="DEU 21"/>
<para style="p"><verse number="1" style="v" sid="DEU 21:1"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई अधिकार गर्न दिनुहुने देशमा, यदि कुनै मानिसको हत्या भएर त्यो खेतमा लडिरहेको पाइयो, र त्यसलाई कसले मारेको हो भन्‍ने हत्यारा पत्तो लागेन भने,<verse eid="DEU 21:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 21:2"/>तिमीहरूका प्रधानहरू र न्यायकर्ताहरू गएर त्यस मृत शरीरको छेउछाउमा रहेका छिमेकी सहरहरूको दूरी नापून्।<verse eid="DEU 21:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 21:3"/>त्यसपछि त्यस मृत शरीरको सबैभन्दा नजिकमा रहेको सहरका प्रधानहरूले कहिल्यै नजोतेको र जुवा नपरेको एउटा कोरली ल्याऊन्।<verse eid="DEU 21:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 21:4"/>अनि त्यसलाई कहिल्यै नजोतिएको, नरोपिएको अनि पानी बग्दै गरेको बेँसीमा लैजाऊन्। त्यस बेँसीमा तिनीहरूले त्यस कोरलीको घाँटी भाँचिदेऊन्।<verse eid="DEU 21:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 21:5"/>तब लेवी पुजारीहरू अगि सरेर आऊन्; किनकि याहवेह तिमीहरूका परमेश्‍वरले तिनीहरूलाई सेवा गर्न र याहवेहको नाममा आशिष् दिन, झैझगडा र कुटपिटका सबै मुद्दा-मामिला मिलाउन चुन्‍नुभएको छ।<verse eid="DEU 21:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 21:6"/>तब त्यस मृत शरीरको सबैभन्दा नजिकको सहरका प्रधानहरूले त्यस बेँसीमा घाँटी भाँचिदिएको कोरलीमाथि आफ्ना हातहरू धोऊन्।<verse eid="DEU 21:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 21:7"/>तब तिनीहरूले यसरी घोषणा गरून्, “हामीले यस मानिसको हत्या गरेनौँ, न त हाम्रा आँखाले हत्या भएको देखेका छन्।<verse eid="DEU 21:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 21:8"/>हे याहवेह, तपाईंले छुटकारा दिनुभएका तपाईंको इस्राएली मानिसका निम्ति यो प्रायश्‍चित ग्रहण गर्नुहोस्। तब निर्दोष मानिसको रगतको दोष तपाईंका मानिसहरूलाई नलागोस्।” अनि त्यस हत्याको लागि प्रायश्‍चित हुनेछ।<verse eid="DEU 21:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 21:9"/>यसरी याहवेहको दृष्‍टिमा जे ठिक छ, तिमीहरूले सो गरेका हुनाले निर्दोषको रगत बगाएको दोषबाट आफूलाई शुद्ध पार्नेछौ।<verse eid="DEU 21:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 21:10"/>जब तिमीहरू आफ्ना शत्रुहरूका विरुद्धमा युद्ध गर्न जान्छौ, र याहवेह तिमीहरूका परमेश्‍वरले तिनीहरूलाई तिमीहरूका हातमा सुम्पिदिनुहुनेछ, तब तिमीहरूले तिनीहरूलाई कैदी बनाएर ल्याउनेछौ।<verse eid="DEU 21:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 21:11"/>यदि ती कैदीहरूमध्ये कुनै एउटी सुन्दरी स्त्रीलाई देखेर तिमीहरूमध्ये कोही त्यसप्रति आकर्षित भयौ भने त्यसलाई पत्नीको रूपमा लिन सक्छौ।<verse eid="DEU 21:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 21:12"/>त्यस स्त्रीलाई आफ्नो घरमा ल्याउनू। अनि त्यसका केश खौरिदिनू र त्यसका नङहरू काटिदिनू।<verse eid="DEU 21:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 21:13"/>अनि त्यसलाई कैदमा ल्याउँदा त्यसले लगाएको लुगा फेर्न लगाउनू। त्यो स्त्री तिम्रो घरमा बसोस्, र त्यसको आफ्ना आमाबुबाका निम्ति एक महिनासम्म विलाप गरोस्; अनि तिमी त्यसकहाँ जान सक्छौ, र त्यसको पति हुन सक्छौ। अनि त्यो तिम्री पत्नी हुनेछे।<verse eid="DEU 21:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 21:14"/>यदि तिमी त्योसँग खुशी रहन सकेनौ भने त्यो स्त्रीले जहाँ जान इच्छा गर्छे, त्यसलाई जान दिनू। तिमीले त्यसलाई बेच्नुहुँदैन वा दासीलाई झैँ व्यवहार गर्नुहुँदैन। किनकि तिमीले त्यसलाई अपमानित गरिसकेका छौ।<verse eid="DEU 21:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 21:15"/>यदि कुनै मानिसका दुई जना पत्नीहरू छन् र त्यसले एउटीलाई प्रेम गर्छ; तर अर्कीलाई चाहिँ गर्दैन, र दुवैले त्यसका निम्ति छोराहरू जन्माए, तर त्यसले प्रेम नगर्ने पत्नीबाट चाहिँ जेठा छोरा भयो भने,<verse eid="DEU 21:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 21:16"/>जब त्यसले आफ्ना छोराहरूलाई आफ्नो सम्पत्तिको अंशबण्डा गर्छ, तब त्यसले मन नपराएको पत्नीबाट जन्मेको खास जेठा छोराको अधिकार खोसेर मन पराएकी पत्नीको छोरालाई दिनुहुँदैन।<verse eid="DEU 21:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 21:17"/>त्यसले आफूले मन नपराएको पत्नीको छोरालाई आफूसँग भएका सबै कुराको दोबर भाग दिएर त्यसलाई जेठा छोराको मान्यता दिनुपर्छ। किनभने त्यो आफ्नो बुबाको शक्तिको पहिलो चिन्ह हो। जेठो अधिकार त्यसको नै हुनेछ।<verse eid="DEU 21:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 21:18"/>यदि कुनै मानिसको हठी र विद्रोही छोरा छ; जसले आफ्ना आमा वा बुबाको आज्ञापालन गर्दैन; र त्यसलाई अनुशासन गर्दा मान्दैन भने,<verse eid="DEU 21:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 21:19"/>त्यसका आमाबुबाले त्यसलाई समातेर त्यस सहरका प्रधानहरूकहाँ मूलढोकामा ल्याऊन्।<verse eid="DEU 21:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 21:20"/>तिनीहरूले प्रधानहरूलाई भनून्, “हाम्रो यो छोरा हठी र विद्रोही छ। यसले हाम्रो आज्ञापालन गर्दैन। यो घिचुवा र मताहा छ।”<verse eid="DEU 21:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 21:21"/>तब सहरका सबै मानिसहरूले त्यसलाई ढुङ्गाले हानेर मारून्। तिमीहरूले आफ्नो बीचबाट दुष्‍टता हटाउनुपर्छ। यस कुरालाई सारा इस्राएलीहरूले सुन्‍नेछन् र डर मान्‍नेछन्।<verse eid="DEU 21:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 21:22"/>यदि कोही मानिस मृत्युदण्डको दोष लागेर मारियो, र त्यसको शरीर रूखमा झुण्ड्याइएको छ भने,<verse eid="DEU 21:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 21:23"/>तिमीहरूले त्यस मृत शरीरलाई रातभरि रूखमा झुण्डाएर नराख्नू। त्यसलाई त्यही दिन गाडिहाल्नू; किनकि रूखमा झुण्ड्याइएको लासले परमेश्‍वरबाट श्राप ल्याउँदछ। याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई उत्तराधिकारको रूपमा दिनुहुने देशलाई तिमीहरूले अशुद्ध पार्नेछैनौ।<verse eid="DEU 21:23"/></para>
<chapter eid="DEU 21"/>
<chapter number="22" style="c" sid="DEU 22"/>
<para style="p"><verse number="1" style="v" sid="DEU 22:1"/>यदि तिमीहरूले इस्राएली दाजुभाइको गोरु वा भेडा यताउता लागेको देख्यौ भने त्यसको बेवास्ता नगर। तर त्यसलाई त्यसको मालिककहाँ लगिदेऊ।<verse eid="DEU 22:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 22:2"/>यदि तिमीहरूका दाजुभाइ तिमीहरूका नजिक बस्दैन वा मालिक को हो भनी तिमीहरूलाई थाहा भएन भने त्यसका मालिक खोज्न नआएसम्म त्यसलाई आफ्नो घरमा ल्याउनू। त्यसपछि त्यसलाई फर्काइदिनू।<verse eid="DEU 22:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 22:3"/>तिमीहरूले आफ्ना दाजुभाइको गधा वा लुगा वा तिनीहरूले हराएका कुनै पनि थोक भेट्टायौ भने फर्काइदिनू। ती तिमीहरूले बेवास्ता नगर्नू।<verse eid="DEU 22:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 22:4"/>यदि तिमीहरूले आफ्ना इस्राएली दाजुभाइका गधा वा गोरुलाई बाटोमा लडेको देख्यौ भने त्यसलाई बेवास्ता नगर्नू। त्यस पशुलाई उठाउन त्यसका मालिकलाई सहायता गर्नू।<verse eid="DEU 22:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 22:5"/>स्त्रीहरूले पुरुषको लुगा नलगाउनू, न त पुरुषले स्त्रीहरूको लुगा लगाउनू। किनकि याहवेह तिमीहरूका परमेश्‍वरले यसो गर्नेहरूलाई घृणा गर्नुहुन्छ।<verse eid="DEU 22:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 22:6"/>यदि तिमीहरूले बाटोको छेउको रूखमा वा भुइँमा चराको गुँड भेट्टायौ र माउचाहिँ बचेरासँग वा अण्डामा बसिरहेको भेट्यौ भने तिमीहरूले बचेरासँगै त्यस माउलाई नलैजानू।<verse eid="DEU 22:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 22:7"/>तिमीहरूले बचेरालाई लैजान सक्छौ। तर माउलाई चाहिँ छोडिदिनुपर्छ, ताकि तिमीहरूको भलो होस्, र तिमीहरूको आयु लामो होस्।<verse eid="DEU 22:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 22:8"/>जब तिमीहरूले नयाँ घर बनाउँछौ, तब घरको छतमा चारैतिर बार लगाउनू। ताकि कोही मानिस छतबाट खसेर मर्‍यो भने तिमीहरूलाई अपराधको दोष नलागोस्।<verse eid="DEU 22:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 22:9"/>तिमीहरूको दाखबारीमा दुई किसिमका बिउ नलगाउनू। यदि त्यसो गर्‍यौ भने बोट मात्र होइन, तर त्यस दाखबारीको फल समेत अशुद्ध हुनेछ।<verse eid="DEU 22:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 22:10"/>गोरु र गधालाई सँगै नारेर जुवामा नजोत्नू।<verse eid="DEU 22:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 22:11"/>ऊन र सुती मिलाएर बुनेको कपडा नलगाउनू।<verse eid="DEU 22:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 22:12"/>तिमीहरूले लगाउने लुगाको चारै कुनामा झुम्काहरू बनाउनू।<verse eid="DEU 22:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 22:13"/>यदि कुनै मानिसले पत्नी ल्याएर त्यससँग सुतेपछि त्यसलाई मन पराएन,<verse eid="DEU 22:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 22:14"/>र पत्नीको निन्दा गरेर त्यसलाई बदनाम गरी यसो भन्यो भने, “मैले यस स्त्रीसँग विवाह गरेँ, तर सुत्दा मैले उसमा कुमारीत्वको प्रमाण पाइनँ,”<verse eid="DEU 22:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 22:15"/>तब स्त्रीका बुबा र आमाले सहरको मूलढोकामा प्रधानहरूकहाँ त्यो केटी कुमारी नै थिई भन्‍ने प्रमाण ल्याऊन्।<verse eid="DEU 22:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 22:16"/>त्यस स्त्रीका बुबाले प्रधानहरूसँग यसो भनोस्, “मैले मेरो छोरीलाई यस मानिससँग विवाह गरिदिएँ, तर यसले छोरीलाई मन पराउँदैन।”<verse eid="DEU 22:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 22:17"/>अब हेर्नुहोस्, यसले छोरीलाई निन्दापूर्ण दोष लगाउँदै यसो भन्छ, “मैले तपाईंको छोरीमा कुमारीपन पाइनँ। तर मेरी छोरीको कुमारीपनको प्रमाण यहाँ छ।” त्यसपछि केटीका बुबाआमाले सहरका प्रधानहरूका सामु त्यो कपडा देखाऊन्।<verse eid="DEU 22:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 22:18"/>अनि सहरका प्रधानहरूले त्यस पुरुषलाई लगेर सजाय देऊन्।<verse eid="DEU 22:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 22:19"/>तिनीहरूले त्यस पुरुषलाई एक सय सेकेल चाँदी जरिमाना गरेर त्यो केटीको बुबालाई देऊन्। किनभने त्यस पुरुषले इस्राएलका कुमारीहरूको नाम बदनाम गरेको छ। त्यो केटी त्यसको पत्नी भएर रहिरहोस्। अनि पुरुषले आफू बाँचुन्जेल त्यो केटीलाई त्याग्न पाउनेछैन।<verse eid="DEU 22:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 22:20"/>तापनि यदि त्यो दोष साँचो हो, र त्यस केटीको कुमारीपनको कुनै प्रमाण पाइएन भने,<verse eid="DEU 22:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 22:21"/>त्यस केटीलाई आफ्नो बुबाको घरको ढोकामा ल्याएर त्यसका सहरका मानिसहरूले त्यसलाई ढुङ्गाले हानेर मारून्। आफ्नो बुबाको घरमा हुँदै बिग्रिएर त्यसले इस्राएलमा घृणित काम गरेकी छे। यस प्रकारले तिमीहरूले आफ्ना बीचबाट दुष्‍टता हटाउनुपर्छ।<verse eid="DEU 22:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 22:22"/>यदि कुनै पुरुष अर्को पुरुषको पत्नीसँग सुतिरहेको भेट्टाइयो भने त्यससँग सुत्ने पुरुष र त्यो स्त्री दुवैलाई मारिनुपर्छ। यसरी तिमीहरूले इस्राएलबाट दुष्‍टता हटाउनुपर्छ।<verse eid="DEU 22:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 22:23"/>यदि कुनै पुरुष सहरमा कसैसँग मगनी भइसकेकी कन्यालाई भेटेर त्यससँग सुतेको भेट्टाइयो भने,<verse eid="DEU 22:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 22:24"/>तिमीहरूले ती दुवैलाई त्यस सहरको मूलढोकामा लगेर ढुङ्गाले हानेर मार्नू। यसकारण कि त्यो केटी त्यो सहरमै थिई, र पनि सहायताको लागि चिच्याइन, र त्यस पुरुषले चाहिँ अर्को पुरुषको पत्नीलाई बिगारेको छ। यसरी तिमीहरूको बीचबाट तिमीहरूले दुष्‍टतालाई हटाउनुपर्छ।<verse eid="DEU 22:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 22:25"/>तर यदि कुनै पुरुषले गाउँको बाहिर निर्जन ठाउँमा मगनी भएकी केटीलाई भेट्यो र त्यसलाई बलात्कार गर्‍यो भने बलात्कार गर्ने मानिसलाई मात्र मार्नू।<verse eid="DEU 22:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 22:26"/>त्यस केटीलाई चाहिँ केही नगर्नू; त्यसले मर्न लायकको कुनै पाप गरेकी छैन। यो मुद्दाचाहिँ कसैले आफ्नो छिमेकीलाई आक्रमण गरेर त्यसलाई हत्या गरेको जस्तै हो।<verse eid="DEU 22:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 22:27"/>किनकि त्यस पुरुषले त्यस केटीलाई गाउँको बाहिर बलात्कार गर्‍यो, र त्यस मगनी भएकी केटी चिच्याउँदा पनि त्यसलाई बचाउने कोही थिएन।<verse eid="DEU 22:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 22:28"/>यदि कुनै मानिसले मगनी नभएकी कन्यालाई भेटेर त्यसलाई बलात्कार गर्‍यो र तिनीहरू फेला परे भने,<verse eid="DEU 22:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 22:29"/>त्यस मानिसले त्यस केटीको बुबालाई पचास सेकेल चाँदी तिर्नुपर्नेछ। त्यसले त्यस केटीलाई विवाह गर्नुपर्छ। किनकि त्यसले उसलाई बलात्कार गरेको छ। त्यसले आफू बाँचुन्जेल उसलाई कहिल्यै त्याग्न पाउनेछैन।<verse eid="DEU 22:29"/></para>
<para style="p"><verse number="30" style="v" sid="DEU 22:30"/>कुनै पनि मानिसले आफ्नो बुबाकी पत्नीलाई विवाह नगरोस्। त्यसले आफ्नो बुबाको ओछ्यानको अनादर गर्नुहुँदैन।<verse eid="DEU 22:30"/></para>
<chapter eid="DEU 22"/>
<chapter number="23" style="c" sid="DEU 23"/>
<para style="p"><verse number="1" style="v" sid="DEU 23:1"/>गुप्‍त अङ्ग किच्याइएको अथवा काटिएर नपुंसक भएको कोही पनि व्यक्ति याहवेहको सभामा प्रवेश गर्न पाउनेछैन।<verse eid="DEU 23:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 23:2"/>निषेध गरिएको विवाहबाट जन्मेको मानिस याहवेहको सभामा प्रवेश गर्नुहुँदैन, अथवा तिनीहरूका सन्तानहरू दश पुस्तासम्म याहवेहको सभामा प्रवेश गर्न पाउनेछैन।<verse eid="DEU 23:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 23:3"/>कुनै अम्मोनी र मोआबी अथवा तिनीहरूका सन्तानहरू दश पुस्तासम्म याहवेहको सभामा प्रवेश गर्न पाउनेछैनन्।<verse eid="DEU 23:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 23:4"/>किनकि तिमीहरू इजिप्टबाट निस्केर आउँदा तिमीहरूलाई बाटोमा तिनीहरूले रोटी र पानी दिन इन्कार गरे। अनि तिनीहरूले अरामको पतोरमा बस्‍ने बओरको छोरा बालामलाई भाडामा बोलाएर तिमीहरूलाई सराप्न लगाएका थिए।<verse eid="DEU 23:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 23:5"/>तरै पनि याहवेह तिमीहरूका परमेश्‍वरले बालामको कुरा सुन्‍नुभएन। तर त्यस सरापलाई आशिष्‌मा परिणत गरिदिनुभयो; किनकि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई प्रेम गर्नुहुन्छ।<verse eid="DEU 23:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 23:6"/>तिमीहरूले आजीवन अम्मोनी र मोआबीहरूसँग मित्रताको सन्धि नगर्नू।<verse eid="DEU 23:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 23:7"/>एदोमीहरूलाई घृणा नगर; किनकि तिनीहरू तिमीहरूका दाजुभाइहरू हुन्। इजिप्टियनहरूलाई घृणा नगर; किनकि तिमीहरू तिनीहरूको देशमा परदेशी भएर बास गरेका थियौ।<verse eid="DEU 23:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 23:8"/>एदोमी र इजिप्टियनहरूबाट जन्मेका तेस्रो पुस्ताका सन्तानहरू याहवेहको सभामा पस्‍न पाउनेछन्।<verse eid="DEU 23:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 23:9"/>जब तिमीहरू आफ्ना शत्रुहरूका विरुद्धमा छाउनी हालेर बस्छौ, तब हरेक अशुद्ध कुराबाट अलग रहनू।<verse eid="DEU 23:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 23:10"/>यदि तिमीहरूमध्ये कुनै मानिस स्वप्न-दोषको कारण अशुद्ध छ भने त्यो मानिस छाउनीबाहिर जाओस्, र त्यहीँ बसोस्।<verse eid="DEU 23:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 23:11"/>तर साँझपख त्यसले नुहाओस्; अनि घाम अस्ताएपछि त्यो मानिस छाउनीभित्र पस्‍न पाउनेछ।<verse eid="DEU 23:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 23:12"/>तिमीहरूले छाउनीबाहिर दिसा-पिसाब गर्ने एउटा ठाउँ बनाओ।<verse eid="DEU 23:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 23:13"/>तिमीहरूसँग खन्‍ने औजार पनि रहोस्। अनि दिसा गरिसकेपछि तिमीहरूले त्यस औजारले खाल्डो खनेर दिसालाई पुरिदिनू।<verse eid="DEU 23:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 23:14"/>किनकि याहवेह तिमीहरूका परमेश्‍वर तिमीहरूलाई रक्षा गर्न र तिमीहरूका शत्रुहरूलाई तिमीहरूका हातमा सुम्पिदिनका लागि तिमीहरूका छाउनीको चारैतिर हिँड्‍डुल गर्नुहुन्छ। तिमीहरूको छाउनी पवित्र हुनुपर्छ; ताकि उहाँले तिमीहरूमा कुनै घिनलाग्दो कुरा देख्न नपरोस् र तिमीहरूबाट टाढा जान नपरोस्।<verse eid="DEU 23:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 23:15"/>यदि कुनै दासले तिमीहरूसँग आश्रय लिएर बसेको छ भने त्यसलाई त्यसको मालिकको हातमा नसुम्पिनू।<verse eid="DEU 23:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 23:16"/>त्यसले रुचाएको जुनसुकै ठाउँ वा त्यसले छानेको जुनसुकै सहरमा त्यसलाई तिमीहरूसँग बस्‍न देओ। त्यसलाई शोषण नगर्नू।<verse eid="DEU 23:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 23:17"/>इस्राएलका कुनै पनि पुरुष अथवा स्त्री देवस्थानमा देवदास वा देवदासी नबनून्।<verse eid="DEU 23:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 23:18"/>तिमीहरूले कुनै भाकल पूरा गर्न देवदासी अथवा देवदासको कमाइलाई याहवेह तिमीहरूका परमेश्‍वरको भवनमा नल्याउनू; किनकि याहवेह तिमीहरूका परमेश्‍वरले ती दुवैलाई घृणा गर्नुहुन्छ।<verse eid="DEU 23:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 23:19"/>तिमीहरूले इस्राएली दाजुभाइबाट रकम अथवा भोजन, ब्याज वा कमाउन मिल्ने कुनै पनि कुराबाट ब्याज नलिनू।<verse eid="DEU 23:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 23:20"/>तिमीहरूले विदेशीबाट ब्याज लिन सक्छौ, तर आफ्नो इस्राएली दाजुभाइबाट नलिनू। तिमीहरूले अधिकार गर्न गइरहेको देशमा याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका हातका सबै कामहरूमा आशिष् दिनुहुनेछ।<verse eid="DEU 23:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 23:21"/>यदि तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरसँग केही भाकल गर्‍यौ भने त्यो भाकल पूरा गर्न ढिलो नगर। किनकि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूबाट निश्‍चय नै माग गर्नुहुनेछ; र तिमीहरू पापको दोषी हुनेछौ।<verse eid="DEU 23:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 23:22"/>तर भाकल गरेकै छैनौ भने तिमीहरूलाई पापको दोष लाग्नेछैन।<verse eid="DEU 23:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 23:23"/>तिमीहरूका मुखले जे कुरा भाकल गरेका छन्, ती तिमीहरूले अवश्य पूरा गर्नुपर्छ। किनकि तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरका निम्ति यो राजीखुशीले गरेका हौ।<verse eid="DEU 23:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 23:24"/>यदि तिमीहरू आफ्ना दाजुभाइको दाखबारीमा पस्यौ भने तिमीहरूले चाहेजति पेटभरि अङ्‌गुर खान सक्छौ। तर तिमीहरूले आफ्नो डालोमा एउटै पनि नहाल्नू।<verse eid="DEU 23:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 23:25"/>यदि तिमीहरूको छिमेकीको अन्‍नको खेतमा तिमीहरू पस्यौ भने तिमीहरूले आफ्ना हातले बाला टिप्न सक्छौ। तर तिमीहरूले पाकेको बालीमा हँसिया लगाएर अन्‍न काट्नुहुँदैन।<verse eid="DEU 23:25"/></para>
<chapter eid="DEU 23"/>
<chapter number="24" style="c" sid="DEU 24"/>
<para style="p"><verse number="1" style="v" sid="DEU 24:1"/>यदि कुनै मानिसले कुनैलाई विवाह गर्छ; अनि त्यसको बारेमा कमी कमजोरी थाहा पाएका कारण त्यस स्त्रीलाई मन नपराएर त्यागपत्र लेखी आफ्नो घरबाट त्यसलाई पठाइदियो भने,<verse eid="DEU 24:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 24:2"/>अनि यदि त्यो स्त्री त्यस मानिसको घर छाडेर अर्को मानिसको पत्नी भई भने,<verse eid="DEU 24:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 24:3"/>त्यसको दोस्रो पतिले पनि त्यसलाई मन नपराएर त्यागपत्र लेखेर दियो, र आफ्नो घरबाट पठाइदियो वा तिनको दोस्रो पति मर्‍यो भने,<verse eid="DEU 24:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 24:4"/>त्यो स्त्री अशुद्ध भइसकेको कारण त्यसलाई त्याग्ने पहिलो पतिले फेरि त्यसलाई विवाह गर्ने अनुमति पाउनेछैन। त्यो याहवेहको दृष्‍टिमा घिनलाग्दो कुरा हुन्छ। याहवेह तिमीहरूका परमेश्‍वरले उत्तराधिकारको रूपमा तिमीहरूलाई दिनुहुने देशमा तिमीहरूले यो पाप नल्याओ।<verse eid="DEU 24:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 24:5"/>यदि कुनै मानिसले भर्खरै विवाह गरेको छ भने त्यसलाई युद्धमा नपठाइयोस्, र त्यसलाई अरू कुनै जिम्मेवारी नदिइयोस्। किनकि एक वर्षसम्म घरमा बस्‍न र आफूले विवाह गरेकी पत्नीलाई खुशी पार्नलाई त्यो स्वतन्त्र हुनुपर्छ।<verse eid="DEU 24:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 24:6"/>कसैले ऋणको धरौटीको रूपमा जाँतो वा त्यसको माथिल्‍लो भाग मात्र पनि नलिनू। किनकि त्यो कुनै मानिसको जीविका चलाउने उपाय नै धरौटीको रूपमा लिइएको हुनेछ।<verse eid="DEU 24:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 24:7"/>यदि कुनै मानिसले आफ्नो इस्राएली दाजुभाइलाई अपहरण गर्‍यो, र त्यसलाई दासझैँ व्यवहार गरेको अथवा बेचेको भेट्टाइयो भने त्यो अपहरणकर्तालाई मार्नैपर्छ। यसरी तिमीहरूको बीचबाट तिमीहरूले दुष्‍टता हटाउनुपर्छ।<verse eid="DEU 24:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 24:8"/>कुष्‍ठरोगको विषयमा लेवी पुजारीहरूले तिमीहरूलाई आदेश दिएजस्तै होसियारीसाथ पालन गर्नू। मैले तिनीहरूलाई आज्ञा दिएका कुराहरू तिमीहरूले होसियारीसाथ पालन गर्नू।<verse eid="DEU 24:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 24:9"/>तिमीहरू इजिप्टबाट निस्किआएपछि बाटोमा याहवेह तिमीहरूका परमेश्‍वरले मिरियमलाई के गर्नुभयो, सो सम्झना राख्नू।<verse eid="DEU 24:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 24:10"/>जब तिमीहरूले आफ्नो छिमेकीलाई कुनै किसिमको ऋण दिन्छौ, तब त्यसले धरौटीको रूपमा दिन लागेका जुनसुकै कुरा पनि लिन त्यसको घरभित्र नपस्‍नू।<verse eid="DEU 24:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 24:11"/>तिमीहरू घर बाहिरै बस्‍नू। अनि तिमीहरूले ऋण दिएका मानिस आफैँले धरौटी लिएर तिमीहरूकहाँ बाहिर आओस्।<verse eid="DEU 24:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 24:12"/>यदि त्यो मानिस गरिब छ भने तिमीहरूसँग भएको त्यसको धरौटी, जुन त्यसको लुगा हो, त्यसलाई लिएर सुत्न नजाओ।<verse eid="DEU 24:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 24:13"/>त्यसको लुगा घाम अस्ताउनुभन्दा पहिले नै फर्काइदेओ। ताकि त्यसले त्यो ओढेर सुत्न सकोस्। तब त्यसले तिमीहरूलाई धन्यवाद दिनेछ। अनि त्योचाहिँ याहवेह तिमीहरूका परमेश्‍वरको दृष्‍टिमा एउटा धार्मिकताको काम ठहरिनेछ।<verse eid="DEU 24:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 24:14"/>तिमीहरूका इस्राएली दाजुभाइ होस् या तिमीहरूका कुनै सहरमा बसोबास गर्ने विदेशी; कुनै गरिब र अभावमा भएका ज्यालादारीबाट फाइदा नलेओ।<verse eid="DEU 24:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 24:15"/>तिनीहरूको ज्याला प्रत्येक दिन घाम अस्ताउनु अगि नै दिइहाल्नू। किनभने तिनीहरू गरिब हुन्, र तिनीहरूको मन ज्यालामाथि लगाएका हुन्छन्। नत्रता तिनीहरूले तिमीहरूका विरुद्धमा याहवेहलाई पुकार्नेछन् र तिमीहरूलाई पापको दोष लाग्नेछ।<verse eid="DEU 24:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 24:16"/>छोराछोरीहरूका पापको कारण आमाबुबाहरू र आमाबुबाहरूका पापको कारण छोराछोरीहरूलाई नमार्नू। हरेक मानिस आफ्नै पापको कारण मर्नैपर्छ।<verse eid="DEU 24:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 24:17"/>विदेशी अथवा अनाथलाई न्यायबाट बञ्चित नगर्नू; अथवा कुनै विधवाको लुगा बन्धकको रूपमा नलिनू।<verse eid="DEU 24:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 24:18"/>यो कुरा याद राख, तिमीहरू पनि इजिप्टमा दास थियौ। याहवेह तिमीहरूका परमेश्‍वरले नै तिमीहरूलाई त्यहाँबाट छुटाउनुभयो। यसैकारण मैले तिमीहरूलाई यो आज्ञा दिँदैछु।<verse eid="DEU 24:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 24:19"/>तिमीहरूले आफ्नो खेतमा कटनी गर्दा यदि एक बिटा छोडियो भने त्यो लिन फर्केर नजाओ। त्यो परदेशी, अनाथ र विधवाहरूका लागि छोडिदिनू। तब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका हातका सबै कामहरूमा आशिष् दिनुहुनेछ।<verse eid="DEU 24:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 24:20"/>जब तिमीहरूले आफ्ना जैतुनका बोटहरूबाट फलहरू झार्छौ, तब फेरि दोस्रो पटक बोटबाट फलहरू झार्न नजानू। ती छोडिएका फलहरूचाहिँ परदेशी, अनाथ र विधवाहरूका निम्ति छोडिदिनू।<verse eid="DEU 24:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 24:21"/>जब तिमीहरू आफ्ना दाखबारीबाट अङ्‌गुर बटुल्छौ, तब फेरि दोहोर्‍याएर नबटुल्नू। बाँकी रहेका फलहरू जति परदेशी, अनाथ र विधवाहरूलाई छोडिदिनू।<verse eid="DEU 24:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 24:22"/>यो कुरा याद राख, तिमीहरू पनि इजिप्टमा दास थियौ। यसैकारण मैले तिमीहरूलाई यसो गर्नू भनी आज्ञा दिँदैछु।<verse eid="DEU 24:22"/></para>
<chapter eid="DEU 24"/>
<chapter number="25" style="c" sid="DEU 25"/>
<para style="p"><verse number="1" style="v" sid="DEU 25:1"/>जब मानिसहरूमा झगडा हुन्छ, तब त्यस विषयलाई लिएर अदालतमा लैजानू। अनि न्यायकर्ताहरूले त्यस मुद्दाको फैसला गर्नेछन्। निर्दोषलाई छोडिनेछ र अपराधीलाई चाहिँ दोषी ठहराइनेछ।<verse eid="DEU 25:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 25:2"/>यदि दोषी मानिसले कुटाइ खानुपर्ने सजाय भयो भने न्यायकर्ताले त्यसलाई आफ्नै सामु घोप्टाएर अपराधअनुसार कोर्राको संख्या गनेर लगाऊन्।<verse eid="DEU 25:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 25:3"/>तर न्यायकर्ताले चालीस कोर्राभन्दा बढी लगाउन दिनुहुँदैन। यदि त्यसलाई चालीसभन्दा बढी कोर्रा लगाइयो भने तिमीहरू आफ्ना दाजुभाइका दृष्‍टिमा अपमानित हुनेछौ।<verse eid="DEU 25:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 25:4"/>अन्‍नबाली दाइँ गर्दा गोरुको मुखमा मोहोलो नलगाउनू।<verse eid="DEU 25:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 25:5"/>यदि दाजुभाइहरू एकसाथ बसेका छन्, तब तीमध्ये एक भाइको छोरा नभई नै मृत्यु भयो भने त्यस विधवाले त्यस परिवारभन्दा बाहिर विवाह नगरोस्। त्यसको देवर वा जेठाजुले त्यसलाई विवाह गरोस्, र त्यसप्रति आफ्नो कर्तव्य पूरा गरोस्।<verse eid="DEU 25:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 25:6"/>त्यसले जन्माएको पहिलो छोराले मृत दाजु वा भाइको नाम बोक्नेछ। अनि त्यसको नाम इस्राएलबाट नमेटियोस्।<verse eid="DEU 25:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 25:7"/>तरै पनि यदि कुनै मानिसले आफ्नो दाजु वा भाइकी पत्नीसँग विवाह गर्न चाहँदैन भने त्यस स्त्रीले सहरको मूलढोकामा रहेका प्रधानहरूकहाँ गएर भनोस्, “मेरा पतिका भाइले आफ्नो दाजुको नाम इस्राएलमा राख्न इन्कार गर्छ। उसले मप्रति देवरले गर्नुपर्ने कर्तव्य पूरा गर्दैन।”<verse eid="DEU 25:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 25:8"/>तब सहरका प्रधानहरूले त्यसलाई बोलाएर त्यससँग कुरा गरून्। यदि त्यसले ढिपी गर्दै यसो भन्छ भने, “म उसलाई विवाह गर्दिनँ,”<verse eid="DEU 25:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 25:9"/>तब त्यसको दाजुको विधवाले प्रधानहरूको उपस्थितिमा त्यसकहाँ गएर त्यसको एउटा जुत्ता फुकालेर त्यसको मुखमा थुकेर यसो भनोस्, “आफ्नो दाजुको वंश राख्न नचाहने मानिसलाई यसै गर्नुपर्छ।”<verse eid="DEU 25:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 25:10"/>त्यस मानिसको घरानालाई इस्राएलमा “जुत्ता फुकालिएको घराना भनिनेछ।”<verse eid="DEU 25:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 25:11"/>यदि दुई जना मानिसहरू झगडा गर्दैगरेको बेला तीमध्येका एक जनाकी पत्नीले आएर आफ्नो पतिलाई आक्रमणबाट बचाउन विरोधीको गुप्‍त अङ्गमा अँठ्याइ भने,<verse eid="DEU 25:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 25:12"/>तिमीहरूले त्यस स्त्रीको हात काटिदिनू; त्यसलाई दया नदेखाउनू।<verse eid="DEU 25:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 25:13"/>तिमीहरूले नापको लागि थैलोमा एउटा कम र अर्को ज्यादा दुई फरक किसिमका ढकहरू नराख्नू।<verse eid="DEU 25:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 25:14"/>तिमीहरूका घरमा एउटा ठूलो र अर्को सानो दुई फरक किसिमका नाप्‍ने ढकहरू नराख्नू।<verse eid="DEU 25:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 25:15"/>तिमीहरूसँग ठिक, छलरहित र मापन अनुसारको ढक हुनुपर्छ। ताकि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशमा तिमीहरू धेरै वर्षसम्म बाँच्न सक।<verse eid="DEU 25:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 25:16"/>किनकि याहवेह तिमीहरूका परमेश्‍वरले यस्ता छल काम गर्ने र बेइमान मानिस, जोसुकैलाई पनि घृणा गर्नुहुन्छ।<verse eid="DEU 25:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 25:17"/>तिमीहरू इजिप्टबाट निस्केर आउँदा बाटोमा अमालेकीहरूले तिमीहरूलाई के गरे, त्यो सम्झना गर।<verse eid="DEU 25:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 25:18"/>जब तिमीहरू थाकेर शिथिल भएका थियौ, तब त्यस समयमा तिमीहरूका यात्रामा तिनीहरूले भेटे। अनि पछिल्तिर हिँड्नेहरूलाई तिनीहरूले काटेर मारे। ती अमालेकीहरूमा परमेश्‍वरको डरै थिएन।<verse eid="DEU 25:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 25:19"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई उत्तराधिकारको रूपमा दिनुहुने देशमा, जब उहाँले तिमीहरूका वरिपरि रहेका शत्रुहरूबाट तिमीहरूलाई विश्राम दिनुहुनेछ, तब तिमीहरूले अमालेकीहरूको नामनिशानै पृथ्वीबाट मेटाइदिनू। तिमीहरूले यो कुरा नबिर्सनू।<verse eid="DEU 25:19"/></para>
<chapter eid="DEU 25"/>
<chapter number="26" style="c" sid="DEU 26"/>
<para style="p"><verse number="1" style="v" sid="DEU 26:1"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई उत्तराधिकारको रूपमा दिनुहुने देशमा जब तिमीहरू पसेर अधिकार गर्नेछौ र त्यहाँ बसोबास गर्नेछौ,<verse eid="DEU 26:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 26:2"/>तब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशको माटोबाट तिमीहरूले उब्जाएका सबै पहिलो फलहरूबाट केही भाग लिएर डालोमा राख्नू। त्यसपछि याहवेह तिमीहरूका परमेश्‍वरले आफ्नो नामको खातिर वासस्थानको रूपमा चुन्‍नुहुने ठाउँमा तिमीहरूले लगेर जानू।<verse eid="DEU 26:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 26:3"/>अनि त्यस बेला सेवामा रहेका पुजारीलाई यसो भन्‍नू, “याहवेहले हाम्रा पितापुर्खाहरूसँग हामीलाई दिन्छु भनी शपथ खानुभएको देशमा म आइपुगेँ भनी आज म याहवेह तपाईंका परमेश्‍वरकहाँ स्वीकार गर्छु।”<verse eid="DEU 26:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 26:4"/>पुजारीले तिमीहरूका हातबाट त्यो डालो लिएर याहवेह तिमीहरूका परमेश्‍वरको वेदीको अगि राख्नेछन्।<verse eid="DEU 26:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 26:5"/>तब तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको सामु यसो भनेर घोषणा गर्नू: “मेरा पितापुर्खा फिरन्ते अरामी निबासी थिए। तिनी केही मानिसहरूसँग इजिप्टमा गए, र त्यहाँ बसोबास गरे। अनि शक्तिशाली, ठूलो र धेरै संख्या भएका एउटा जाति भए।<verse eid="DEU 26:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 26:6"/>तर इजिप्टियनहरूले हामीसँग दुर्व्यवहार गरे। हामीलाई दुःख दिए, र कठोर परिश्रम गर्न लगाए।<verse eid="DEU 26:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 26:7"/>त्यसपछि हामीले हाम्रा पितापुर्खाहरूका परमेश्‍वरलाई पुकार गर्‍यौँ, तब याहवेहले हाम्रो सोर सुन्‍नुभयो। अनि हाम्रो दुर्दशा, परिश्रम र थिचोमिचो देख्नुभयो।<verse eid="DEU 26:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 26:8"/>यसकारण याहवेहको महान् शक्तिशाली हात र फैलिएका पाखुरा, र भयङ्कर आतङ्क, अलौकिक चिन्हहरू र अद्‌भुत कार्यहरूद्वारा हामीलाई इजिप्टबाट निकालेर ल्याउनुभयो।<verse eid="DEU 26:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 26:9"/>उहाँले हामीलाई यस ठाउँमा ल्याउनुभयो। अनि दूध र मह बग्ने यो देश दिनुभयो।<verse eid="DEU 26:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 26:10"/>यसकारण हे याहवेह, तपाईंले दिनुभएको जमिनबाट पहिलो फलहरू मैले ल्याएको छु।” याहवेह तिमीहरूका परमेश्‍वरको अगि त्यो डालो राख र उहाँलाई दण्डवत् गर।<verse eid="DEU 26:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 26:11"/>तब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरू र तिमीहरूका घरानालाई दिनुभएका सबै असल कुराहरूमा तिमीहरू, लेवीहरू र तिमीहरूका बीचमा बसोबास गर्ने विदेशीहरूले आनन्द मनाऊन्।<verse eid="DEU 26:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 26:12"/>जब तिमीहरूले आफ्ना उब्जनीका दशांश तेस्रो वर्ष, अर्थात् दशांशको वर्षमा अलग गर्छौ, तब तिमीहरूले त्यो लेवी, परदेशी, अनाथ, विधवालाई दिनुपर्नेछ; ताकि तिनीहरूले तिमीहरूका सहरहरूमा खाऊन् र सन्तुष्‍ट होऊन्।<verse eid="DEU 26:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 26:13"/>तब याहवेह तिमीहरूका परमेश्‍वरलाई यसो भन्‍नू: “मैले मेरो घरबाट पवित्र अंश छुटाएर त्यो लेवी, विदेशी, अनाथ र विधवालाई तपाईंका सबै आज्ञाहरूअनुसार दिएको छु। म तपाईंका आज्ञाहरूबाट तर्किगएको छैनँ, न त मैले बिर्सेको नै छु।<verse eid="DEU 26:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 26:14"/>मेरो शोकको समयमा मैले पवित्र अंशबाट केही पनि खाएको छैनँ; न म अशुद्ध हुँदा त्यसबाट केही हटाएको छु; न त मैले मरेकालाई त्यसबाट केही चढाएको छु। मैले याहवेह मेरा परमेश्‍वरको आज्ञापालन गरेको छु। तपाईंले मलाई आज्ञा गर्नुभएको हरेक कुरा मैले पालन गरेको छु।<verse eid="DEU 26:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 26:15"/>तपाईंको पवित्र वासस्थान स्वर्गबाट तल हेर्नुहोस्। तपाईंले हाम्रा पितापुर्खाहरूलाई शपथ खाएर प्रतिज्ञा गर्नुभएझैँ, तपाईंको जाति इस्राएललाई र तपाईंले हामीलाई दिनुभएको दूध र मह बग्ने प्रतिज्ञाको देशलाई आशिष् दिनुहोस्।”<verse eid="DEU 26:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 26:16"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आज यी उर्दीहरू र नियमहरू पालन गर्नू भनी आज्ञा दिनुहुन्छ; यी तिमीहरूले आफ्नो सारा हृदयले र आफ्नो सारा प्राणले होसियारीसाथ पालन गर।<verse eid="DEU 26:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 26:17"/>तिमीहरूले आजको दिन याहवेह तिमीहरूका परमेश्‍वर हुनुहुन्छ भनी घोषणा गरेका छौ। अनि तिमीहरू उहाँका मार्गहरूमा हिँड्नेछौ। उहाँका उर्दीहरू, आज्ञाहरू र नियमहरू मान्‍नेछौ। अनि उहाँमा आज्ञाकारी हुनेछौ।<verse eid="DEU 26:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 26:18"/>अनि याहवेहले आजको दिन घोषणा गर्नुभएको छ: तिमीहरू उहाँका मानिसहरू हौ। उहाँले प्रतिज्ञा गर्नुभएझैँ तिमीहरू उहाँका निजी धन हौ। उहाँका सबै आज्ञाहरू तिमीहरूले पालन गर्नुपर्छ।<verse eid="DEU 26:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 26:19"/>उहाँले तिमीहरूलाई आफैँले बनाउनुभएका सबै जातिहरूभन्दा बढी प्रशंसा, ख्याति र उच्‍च सम्मान दिएर राख्नेछु भनी घोषणा गर्नुभएको छ। अनि उहाँले प्रतिज्ञा गर्नुभएझैँ, याहवेह तिमीहरूका परमेश्‍वरका निम्ति तिमीहरू पवित्र जाति हुनेछौ।<verse eid="DEU 26:19"/></para>
<chapter eid="DEU 26"/>
<chapter number="27" style="c" sid="DEU 27"/>
<para style="p"><verse number="1" style="v" sid="DEU 27:1"/>मोशा र इस्राएलका प्रधानहरूले मानिसहरूलाई आज्ञा दिए, “आज मैले तिमीहरूलाई दिएका यी सबै आज्ञाहरू पालन गर।<verse eid="DEU 27:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 27:2"/>जब तिमीहरू यर्दन पार गरेर याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशमा पुग्छौ, तब केही ठूला-ठूला ढुङ्गाहरू खडा गरेर तिनीहरूलाई कमेरोले पोत्नू।<verse eid="DEU 27:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 27:3"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका पितापुर्खालाई प्रतिज्ञा गर्नुभएझैँ, जब तिमीहरू यर्दन पार गरेर याहवेह तिमीहरूका परमेश्‍वरले दिनुहुने दूध र मह बग्ने देशमा प्रवेश गर्नेछौ, तब ती ढुङ्गाहरूमा यस व्यवस्थाका सबै वचनहरू लेख्नू।<verse eid="DEU 27:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 27:4"/>अनि जब तिमीहरूले यर्दन पार गरिसक्छौ, तब मैले तिमीहरूलाई आज आज्ञा दिएझैँ यी ढुङ्गाहरूलाई एबाल पर्वतमा खडा गरेर ती ढुङ्गाहरूलाई कमेरोले पोत्नू।<verse eid="DEU 27:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 27:5"/>त्यहाँ तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरका निम्ति ढुङ्गाहरूको एउटा वेदी बनाउनू। ती ढुङ्गाहरूमाथि कुनै फलामको औजार प्रयोग नगर्नू।<verse eid="DEU 27:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 27:6"/>याहवेह तिमीहरूका परमेश्‍वरका निम्ति तिमीहरूले नकाटिएका ढुङ्गाहरूको वेदी बनाउनू। त्यसपछि तिमीहरूले याहवेह आफ्ना परमेश्‍वरका निम्ति होमबलि चढाउनू।<verse eid="DEU 27:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 27:7"/>त्यहाँ मेलबलि चढाउनू र याहवेह तिमीहरूका परमेश्‍वरको उपस्थितिमा ती खानू, र तिमीहरूले रमाइलो मनाउनू।<verse eid="DEU 27:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 27:8"/>अनि तिमीहरूले खडा गरेका ती ढुङ्गाहरूमा यस व्यवस्थाका शब्दहरू स्पष्‍टसँग लेख्नू।”<verse eid="DEU 27:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 27:9"/>तब मोशा र लेवी पुजारीहरूले सारा इस्राएलीहरूलाई भने, “हे इस्राएल, शान्त भएर सुन! आज तिमीहरू याहवेह तिमीहरूका परमेश्‍वरका जाति भएका छौ।<verse eid="DEU 27:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 27:10"/>याहवेह तिमीहरूका परमेश्‍वरको आज्ञापालन गर्नू। अनि आज मैले तिमीहरूलाई दिने उहाँका आज्ञा र उर्दीहरू पालन गर्नू।”<verse eid="DEU 27:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 27:11"/>त्यसै दिन मोशाले मानिसहरूलाई आज्ञा दिए:<verse eid="DEU 27:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 27:12"/>जब तिमीहरूले यर्दन पार गर्छौ, यी कुलहरू गीरीज्जीम डाँडामा मानिसहरूलाई आशिष् दिनलाई खडा होऊन्: शिमियोन, लेवी, यहूदा, इस्साखार, योसेफ र बेन्यामीन<verse eid="DEU 27:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 27:13"/>अनि रूबेन, गाद, आशेर, जबूलून, दान र नप्‍तालीका कुलहरूचाहिँ एबाल डाँडामा श्राप दिनलाई खडा होऊन्।<verse eid="DEU 27:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 27:14"/>लेवीहरूले इस्राएलका सारा मानिसहरूका निम्ति चर्को सोरले यसरी भनून्:<verse eid="DEU 27:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 27:15"/>“मूर्ति बनाउने जो कोही पनि श्रापित होस्। याहवेहले घृणा गर्नुहुने कुरा खोपेर, ढालेर बनाउने र त्यसलाई गुप्‍तमा स्थापित गर्ने मानिस श्रापित होस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 27:16"/>“आफ्ना आमाबुबालाई आदर नगर्ने मानिस श्रापित होस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 27:17"/>“आफ्नो छिमेकीको साँधसिमानाको ढुङ्गा हटाउने मानिसमाथि श्राप परोस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 27:18"/>“दृष्‍टिविहीनलाई उल्टो बाटोतिर डोर्‍याउने मानिस श्रापित होस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 27:19"/>“विदेशी, अनाथ र विधवाहरूलाई न्याय नदिने मानिस श्रापित होस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 27:20"/>“आफ्नो बुबाकी पत्नीसँग सुत्ने मानिस श्रापित होस्; किनकि त्यसले आफ्नो बुबाको ओछ्यानको अनादर गरेको छ।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 27:21"/>“पशुसँग यौन सम्पर्क राख्ने मानिस श्रापित होस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 27:22"/>“आफ्नो बहिनी अथवा आफ्नो आमा वा बुबाकी छोरीसँग सुत्ने मानिस श्रापित होस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 27:23"/>“आफ्नो सासुसँग सुत्ने मानिस श्रापित होस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 27:24"/>“आफ्नो छिमेकीलाई गुप्‍तमा मार्ने व्यक्ति श्रापित होस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 27:25"/>“कुनै निर्दोष व्यक्तिलाई मार्नका निम्ति घूस लिने मानिस श्रापित होस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 27:26"/>“यस व्यवस्थाको वचन पूरा रूपमा पालन गर्न नचाहने र समर्थन नगर्ने, जो कोही पनि श्रापित होस्।” तब सबै मानिसहरूले भनून्, “आमेन!”<verse eid="DEU 27:26"/></para>
<chapter eid="DEU 27"/>
<chapter number="28" style="c" sid="DEU 28"/>
<para style="p"><verse number="1" style="v" sid="DEU 28:1"/>यदि याहवेह तिमीहरूका परमेश्‍वरप्रति तिमीहरू पूर्ण आज्ञाकारी भयौ, र आज मैले तिमीहरूलाई दिइरहेका उहाँका सबै आज्ञाहरूलाई होसियारीसाथ पालन गर्‍यौ भने याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई पृथ्वीका सबै जातिहरूभन्दा महान् तुल्याउनुहुनेछ।<verse eid="DEU 28:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 28:2"/>यदि तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको आज्ञापालन गर्‍यौ भने यी सबै आशिष्‌हरू तिमीहरूले पाउनेछौ, र यी तिमीहरूसँग रहिरहनेछन्:<verse eid="DEU 28:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 28:3"/>याहवेहले तिमीहरूका सहर र खेतबारीमा आशिष् दिनुहुनेछ।<verse eid="DEU 28:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 28:4"/>याहवेहले तिमीहरूका गर्भ, तिमीहरूका देशका अन्‍नबाली, तिमीहरूका बथान र बगालका बच्‍चाहरूमा आशिष् दिनुहुनेछ।<verse eid="DEU 28:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 28:5"/>तिमीहरूका डालो र तिमीहरूका पिठो मुछ्ने भाँडोमा आशिष् दिनुहुनेछ।<verse eid="DEU 28:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 28:6"/>तिमीहरू भित्र आउँदा र बाहिर जाँदा आशिषित हुनेछौ।<verse eid="DEU 28:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 28:7"/>तिमीहरूको विरुद्धमा खडा हुने शत्रुहरूलाई याहवेहले तिमीहरूकै सामु परास्त गर्नुहुनेछ। तिनीहरू तिमीहरूमाथि एउटा बाटो आउनेछन्, तर तिमीहरूबाट सात बाटो भएर भाग्नेछन्।<verse eid="DEU 28:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 28:8"/>याहवेहले तिमीहरूका ढुकुटीहरूमा, र तिमीहरूका हातका हरेक काममा आशिष् दिनुहुनेछ। याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशमा तिमीहरूलाई आशिष् दिनुहुनेछ।<verse eid="DEU 28:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 28:9"/>याहवेह तिमीहरूका परमेश्‍वरका आज्ञाहरू तिमीहरूले पालन गर्‍यौ, र उहाँका मार्गहरूमा हिँड्यौ भने उहाँले तिमीहरूसँग शपथ खाएर प्रतिज्ञा गर्नुभएझैँ तिमीहरूलाई उहाँका पवित्र जातिको रूपमा स्थापित गर्नुहुनेछ।<verse eid="DEU 28:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 28:10"/>तब तिमीहरू याहवेहको नामद्वारा बोलाइएका हौ भनी यस पृथ्वीका सबै मानिसहरूले देख्नेछन्, र तिमीहरूसँग डराउनेछन्।<verse eid="DEU 28:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 28:11"/>तिमीहरूलाई दिन्छु भनी तिमीहरूका पितापुर्खाहरूलाई प्रतिज्ञा गर्नुभएको देशमा अर्थात् तिमीहरूका गर्भमा, गाईबस्तुका बाछा-बाछीमा र भूमिको उब्जनीमा याहवेहले प्रशस्त मात्रमा समृद्धि गराउनुहुनेछ।<verse eid="DEU 28:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 28:12"/>तिमीहरूका देशमा ठिक समयमा झरी पठाउन र तिमीहरूका हातका सबै कामहरूमा आशिष् दिन याहवेहले आकाश र उहाँका प्रशस्तताको भण्डारलाई खोलिदिनुहुनेछ। तिमीहरूले धेरै जातिहरूलाई ऋण दिनेछौ, तर तिमीहरूले चाहिँ कसैबाट पनि ऋण लिनेछैनौ।<verse eid="DEU 28:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 28:13"/>याहवेहले तिमीहरूलाई शिर बनाउनुहुनेछ, पुच्छर होइन। यदि तिमीहरूले आज मैले तिमीहरूलाई दिइरहेका याहवेह तिमीहरूका परमेश्‍वरका आज्ञाहरूमा ध्यान दियौ, र ती होसियारीसाथ पालन गर्‍यौ भने तिमीहरू सधैँ उच्‍चमा हुनेछौ, कहिल्यै फेदमा पर्नेछैनौ।<verse eid="DEU 28:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 28:14"/>मैले आज तिमीहरूलाई दिइरहेका आज्ञाहरूमध्ये कुनै एउटैबाट पनि दायाँ र बायाँतिर अन्य देवी-देवताहरूका पछि लागेर तिनीहरूको सेवा नगर।<verse eid="DEU 28:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 28:15"/>तर यदि तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको आज्ञापालन गरेनौ, र मैले आज तिमीहरूलाई दिइरहेका आज्ञाहरू र उर्दीहरू होसियारीसाथ पालन गरेनौ भने यी सबै श्रापहरू तिमीहरूमाथि आइपर्नेछन्:<verse eid="DEU 28:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 28:16"/>तिमीहरू सहरमा र खेतबारीमा श्रापित हुनेछौ।<verse eid="DEU 28:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 28:17"/>तिमीहरूको डालो र पिठो मुछ्ने भाँडोमा श्राप पर्नेछ।<verse eid="DEU 28:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 28:18"/>तिमीहरूका गर्भमा, तिमीहरूका जमिनको अन्‍नबालीमा, गाईबस्तुका बाछाबाछीमाथि र भेडाबाख्राका पाठापाठीमाथि श्राप पर्नेछ।<verse eid="DEU 28:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 28:19"/>तिमीहरू भित्र आउँदा र बाहिर जाँदा श्रापित हुनेछौ।<verse eid="DEU 28:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 28:20"/>तिमीहरूले याहवेहलाई त्यागेर दुष्‍ट काम गरेका हुनाले तिमीहरू नष्‍ट नभएसम्म; र चाँडै बरबाद नभएसम्म उहाँले तिमीहरूका हातका हरेक काममा श्राप, गोलमाल र निराशा पठाउनुहुनेछ।<verse eid="DEU 28:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 28:21"/>तिमीहरू अधिकार गर्न गइरहेको देशमा तिमीहरू नष्‍ट नभएसम्म याहवेहले तिमीहरूमाथि महामारी र रोगहरू फैलाउनुहुनेछ।<verse eid="DEU 28:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 28:22"/>तिमीहरू नष्‍ट नभएसम्म याहवेहले तिमीहरूमाथि यस्ता रोगहरूले प्रहार गर्नुहुनेछः जरो, सुनिने रोग, प्रचण्ड ताप, खडेरी, वृक्ष ओइल्याउने र ढुसी पर्ने रोग।<verse eid="DEU 28:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 28:23"/>तिमीहरूका टाउको माथिको आकाश काँसो र तिमीहरूमुनि भएको जमिन फलाम हुनेछन्।<verse eid="DEU 28:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 28:24"/>याहवेहले तिमीहरूको देशको झरीलाई धुलो र बालुवामा परिणत गरिदिनुहुनेछ। ती तिमीहरू नष्‍ट नभएसम्म आकाशबाट झर्नेछन्।<verse eid="DEU 28:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 28:25"/>याहवेहले तिमीहरूलाई आफ्ना शत्रुहरूका सामु हार्न दिनुहुनेछ। तिमीहरू तिनीहरूमाथि एक बाटोबाट आउनेछौ र सात बाटो भएर भाग्नेछौ। अनि तिमीहरूको अवस्था देखेर पृथ्वीका समस्त जातिहरू डराउनेछन्।<verse eid="DEU 28:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 28:26"/>तिमीहरूका मृत शरीरहरू आकाशका सबै चराहरू र पृथ्वीका जङ्गली जनावरहरूका निम्ति भोजन हुनेछन्; र तिनीहरूलाई धपाउने कोही पनि हुनेछैन।<verse eid="DEU 28:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 28:27"/>याहवेहले तिमीहरूलाई इजिप्टको पिलो, घाउखटिरा, दाद र लूतोले सताउनुहुनेछ, जसबाट तिमीहरू निको हुन सक्नेछैनौ।<verse eid="DEU 28:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 28:28"/>याहवेहले तिमीहरूलाई पागलपन, अन्धोपन र हृदयमा बेचैन पारिदिनुहुनेछ।<verse eid="DEU 28:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 28:29"/>तिमीहरू अन्धा मानिसले जस्तै मध्यदिनमै अँध्यारोमा जस्तै छामछाम-छुमछुम गर्नेछौ। तिमीहरू आफूले गरेका हरेक कुरामा असफल हुनेछौ। तिमीहरू प्रत्येक दिन सताइनेछौ, लुटिनेछौ र तिमीहरूलाई उद्धार गर्ने कोही हुनेछैन।<verse eid="DEU 28:29"/></para>
<para style="p"><verse number="30" style="v" sid="DEU 28:30"/>जुन केटीसँग तिमीहरूको मगनी हुन्छ, त्यसलाई अर्को मानिसले लगेर बलात्कार गर्नेछ। तिमीहरूले घर बनाउनेछौ, तर त्यसमा बस्‍न पाउनेछैनौ। तिमीहरूले दाखबारी लगाउनेछौ, तर त्यसको फल चाख्न पनि पाउनेछैनौ।<verse eid="DEU 28:30"/></para>
<para style="p"><verse number="31" style="v" sid="DEU 28:31"/>तिमीहरूका गोरु तिमीहरूका आँखाकै अगि मारिनेछ; तर तिमीहरूले त्यसको मासु खान पाउनेछैनौ। तिमीहरूका गधा तिमीहरूबाट जबरजस्ती खोसेर लगिनेछ र त्यो फर्काइनेछैन। तिमीहरूका भेडाहरू तिमीहरूका शत्रुहरूलाई दिइनेछ, र ती भेडाहरूलाई छुटाउने कोही हुनेछैन।<verse eid="DEU 28:31"/></para>
<para style="p"><verse number="32" style="v" sid="DEU 28:32"/>तिमीहरूका छोराछोरीहरू अर्कै जातिलाई दिइनेछन्; अनि दिनदिनै तिनीहरूको बाटो हेर्दा-हेर्दा तिमीहरूका आँखा टट्टाउनेछन्। तर तिमीहरू निरीह भएको कारण केही गर्न सक्नेछैनौ।<verse eid="DEU 28:32"/></para>
<para style="p"><verse number="33" style="v" sid="DEU 28:33"/>तिमीहरूले नचिनेको जातिले तिमीहरूका जमिन र परिश्रमले उब्जाएका अन्‍नबाली खानेछन्। तर तिमीहरूसँग चाहिँ सधैँ कठोर थिचोमिचोमा पर्नबाहेक केही पनि हुनेछैन।<verse eid="DEU 28:33"/></para>
<para style="p"><verse number="34" style="v" sid="DEU 28:34"/>तिमीहरूले देखेका ती डरलाग्दा दृष्यहरूले तिमीहरूलाई बौलाहा बनाइदिनेछन्।<verse eid="DEU 28:34"/></para>
<para style="p"><verse number="35" style="v" sid="DEU 28:35"/>याहवेहले तिमीहरूका घुँडा र खुट्टाहरूमा पीडादायक निको नहुने पिलोले प्रहार गर्नुहुनेछ। ती तिमीहरूका पैतालादेखि शिरको टुप्पोसम्म फैलिएर जानेछन्।<verse eid="DEU 28:35"/></para>
<para style="p"><verse number="36" style="v" sid="DEU 28:36"/>याहवेहले तिमीहरूले नियुक्त गरेका राजालाई तिमीहरूले र आफ्ना पितापुर्खाहरूले नचिनेको जातिकहाँ धपाउनुहुनेछ। त्यहाँ तिमीहरूले अरू देवी-देवताहरू, काठ र ढुङ्गाका देवताहरूलाई पूजा गर्नेछौ।<verse eid="DEU 28:36"/></para>
<para style="p"><verse number="37" style="v" sid="DEU 28:37"/>तिमीहरू याहवेहले धपाउनुभएका सबै जातिको बीचमा त्रास, उखान र हाँसोका पात्रहरू बन्‍नेछौ।<verse eid="DEU 28:37"/></para>
<para style="p"><verse number="38" style="v" sid="DEU 28:38"/>तिमीहरूले जमिनमा धेरै बिउ छर्नेछौ, तर कटनीचाहिँ थोरै गर्नेछौ; किनकि ती सलहहरूले खानेछन्।<verse eid="DEU 28:38"/></para>
<para style="p"><verse number="39" style="v" sid="DEU 28:39"/>तिमीहरूले दाखबारी लगाएर त्यसको खेती गर्नेछौ, तर त्यसको रस पिउनेछैनौ वा अङ्‌गुर बटुल्नेछैनौ; किनकि किराहरूले ती खानेछन्।<verse eid="DEU 28:39"/></para>
<para style="p"><verse number="40" style="v" sid="DEU 28:40"/>तिमीहरूका देशभरि जैतुनका रूखहरू त हुनेछन्, तर तिमीहरूले जैतुनको तेल प्रयोग गर्न पाउनेछैनौ; किनकि जैतुनहरू झरेर जानेछन्।<verse eid="DEU 28:40"/></para>
<para style="p"><verse number="41" style="v" sid="DEU 28:41"/>तिमीहरूले छोराछोरीहरू त जन्माउनेछौ, तर ती तिमीहरूसँग रहनेछैनन्; किनकि तिनीहरूलाई कैदमा लगिनेछ।<verse eid="DEU 28:41"/></para>
<para style="p"><verse number="42" style="v" sid="DEU 28:42"/>तिमीहरूका जमिनका रूखहरू र अन्‍नबालीहरूलाई सलहका हुलले नाश पार्नेछन्।<verse eid="DEU 28:42"/></para>
<para style="p"><verse number="43" style="v" sid="DEU 28:43"/>तिमीहरूका बीचमा बसोबास गर्ने विदेशीहरू तिमीहरूभन्दा उच्‍च-उच्‍च स्थानमा पुग्नेछन्। तर तिमीहरूचाहिँ तल-तल झर्नेछौ।<verse eid="DEU 28:43"/></para>
<para style="p"><verse number="44" style="v" sid="DEU 28:44"/>तिनीहरूले तिमीहरूलाई ऋण दिनेछन्, तर तिमीहरूले तिनीहरूलाई ऋण दिनेछैनौ। तिनीहरू शिर हुनेछन्, तर तिमीहरूचाहिँ पुच्छर हुनेछौ।<verse eid="DEU 28:44"/></para>
<para style="p"><verse number="45" style="v" sid="DEU 28:45"/>तिमीहरूमाथि यी सबै श्रापहरू आउनेछन्। याहवेह तिमीहरूका परमेश्‍वरमा तिमीहरू आज्ञाकारी नभएका अनि उहाँले तिमीहरूलाई दिनुभएका आज्ञा र उर्दीहरू तिमीहरूले पालन नगरेको हुनाले, तिमीहरू नष्‍ट नभएसम्म यी श्रापले तिमीहरूलाई लखेट्नेछन् र हराउनेछन्।<verse eid="DEU 28:45"/></para>
<para style="p"><verse number="46" style="v" sid="DEU 28:46"/>तिमीहरू र तिमीहरूका सन्तानमाथि तिनीहरू सधैँको निम्ति चिन्ह र चमत्कार हुनेछन्।<verse eid="DEU 28:46"/></para>
<para style="p"><verse number="47" style="v" sid="DEU 28:47"/>किनभने तिमीहरूले आफ्नो प्रशस्तताको समयमा याहवेह आफ्ना परमेश्‍वरको सेवा खुशी र आनन्दसाथ गरेनौ।<verse eid="DEU 28:47"/></para>
<para style="p"><verse number="48" style="v" sid="DEU 28:48"/>यसकारण तिमीहरू भोक, प्यास, नग्नता र गरिबीमा आफ्ना विरुद्धमा याहवेहले पठाउनुभएका शत्रुहरूको सेवा गर्नेछौ। तिमीहरूलाई नष्‍ट नगरेसम्म उहाँले तिमीहरूका काँधमा फलामको जुवा राखिदिनुहुनेछ।<verse eid="DEU 28:48"/></para>
<para style="p"><verse number="49" style="v" sid="DEU 28:49"/>याहवेहले तिमीहरूका विरुद्धमा टाढाबाट, पृथ्वीको पल्‍लो छेउबाट बेगसँग उडेर तल झर्ने चीलजस्तै एउटा देशलाई ल्याउनुहुनेछ, जसको भाषा तिमीहरूले बुझ्नेछैनौ।<verse eid="DEU 28:49"/></para>
<para style="p"><verse number="50" style="v" sid="DEU 28:50"/>त्यो निष्‍ठुर देखिने जाति, जसले वृद्धहरूको आदर गर्दैन, र बालकहरूमाथि दया देखाउँदैन।<verse eid="DEU 28:50"/></para>
<para style="p"><verse number="51" style="v" sid="DEU 28:51"/>तिमीहरू नष्‍ट नभएसम्म तिनीहरूले तिमीहरूका गाईबस्तुका बगाल र तिमीहरूका जमिनका अन्‍नबालीहरू खानेछन्। तिमीहरू बरबाद नभएसम्म तिनीहरूले तिमीहरूका निम्ति कुनै अन्‍न, नयाँ दाखरस र जैतुनको तेल, न त तिमीहरूका बथानका बाछाबाछीहरू अथवा बगालका पाठापाठीहरू नै राख्नेछन्।<verse eid="DEU 28:51"/></para>
<para style="p"><verse number="52" style="v" sid="DEU 28:52"/>तिमीहरूले भरोसा राखेका अग्ला र सुरक्षित पर्खालहरू नभत्किएसम्म तिनीहरूले तिमीहरूका देशभरि रहेका सबै सहरहरूलाई घेराबन्दी गर्नेछन्। याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुहुने देशभरिका सबै सहरहरूलाई तिनीहरूले घेरा हाल्नेछन्।<verse eid="DEU 28:52"/></para>
<para style="p"><verse number="53" style="v" sid="DEU 28:53"/>घेरामा परेको समयमा तिमीहरूका शत्रुले तिमीहरूलाई दिएको कष्‍टको कारण तिमीहरूले आफ्ना गर्भका फल, याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुभएका छोराछोरीहरूका मासु खानेछौ।<verse eid="DEU 28:53"/></para>
<para style="p"><verse number="54" style="v" sid="DEU 28:54"/>तिमीहरूका बीचमा रहेका अति कोमल हृदय भएका र संवेदनशील मानिसले समेत आफ्नै दाजुभाइ अथवा त्यसले प्रेम गरेकी पत्नी र त्यसका बाँचेका छोराछोरीलाई टिठ्याउनेछैन।<verse eid="DEU 28:54"/></para>
<para style="p"><verse number="55" style="v" sid="DEU 28:55"/>अनि त्यसले आफूले खाँदैगरेको आफ्ना छोरा वा छोरीको मासु कसैलाई पनि बाँड्नेछैन; किनकि तिमीहरूका शत्रुहरूले तिमीहरूका सबै सहरहरू घेरामा पारेका समयमा दिएका कष्‍टले गर्दा, तिमीहरूसँग खानेकुरा अरू केही पनि बाँकी रहेको हुनेछैन।<verse eid="DEU 28:55"/></para>
<para style="p"><verse number="56" style="v" sid="DEU 28:56"/>तिमीहरूका माझमा रहेकी अति कोमल र संवेदनशील हृदय भएकी स्त्री, कोमलता र संवेदनशीलताको कारण आफ्नो खुट्टाले भुइँसम्म छुन नचाहने स्त्रीले समेत आफूले प्रेम गरेको पति र आफ्नै छोराछोरीहरूसँग बाँडेर खानेछैन।<verse eid="DEU 28:56"/></para>
<para style="p"><verse number="57" style="v" sid="DEU 28:57"/>आफ्नै कोखबाट जन्माएका शिशु र सालनालसमेत त्यसले लुकाएर आफैँले खानेछे। किनकि तिमीहरूका शत्रुले तिमीहरूका सहरहरूलाई घेरा लगाएको बेलामा ल्याएका विपत्तिको कारणले गर्दा त्यसले तिनीहरूलाई गुप्‍तमा खाने इच्छा गर्नेछे।<verse eid="DEU 28:57"/></para>
<para style="p"><verse number="58" style="v" sid="DEU 28:58"/>यदि तिमीहरूले यस पुस्तकमा लेखिएका यस व्यवस्थाका वचनहरू होसियारीसाथ पालन गरेनौ, र याहवेह आफ्ना परमेश्‍वरको महिमित र भययोग्य नामको आदर गरेनौ भने,<verse eid="DEU 28:58"/></para>
<para style="p"><verse number="59" style="v" sid="DEU 28:59"/>याहवेहले तिमीहरू र तिमीहरूका सन्तानमाथि भयानक र डरलाग्दा विपत्तिहरू, गम्भीर र लामो समयसम्म रहने रोगहरू पठाउनुहुनेछ।<verse eid="DEU 28:59"/></para>
<para style="p"><verse number="60" style="v" sid="DEU 28:60"/>तिमीहरूलाई डर लाग्ने इजिप्टियनका सबै रोगहरू उहाँले तिमीहरूमाथि ल्याउनुहुनेछ। अनि ती रोगहरू तिमीहरूमा रहिरहनेछन्।<verse eid="DEU 28:60"/></para>
<para style="p"><verse number="61" style="v" sid="DEU 28:61"/>याहवेहले तिमीहरूमाथि यस व्यवस्थाको पुस्तकमा नलेखिएका हरेक किसिमका रोग र विपत्ति पनि तिमीहरू नष्‍ट नभएसम्म ल्याउनुहुनेछ।<verse eid="DEU 28:61"/></para>
<para style="p"><verse number="62" style="v" sid="DEU 28:62"/>तिमीहरूले याहवेह आफ्ना परमेश्‍वरको आज्ञापालन नगरेका हुनाले आकाशका ताराहरूझैँ असंख्य भएका तिमीहरू घटेर संख्यामा थोरै हुनेछौ।<verse eid="DEU 28:62"/></para>
<para style="p"><verse number="63" style="v" sid="DEU 28:63"/>जसरी तिमीहरूलाई वृद्धि गराउन र संख्यामा बढाउन परमेश्‍वरलाई आनन्द लागेको थियो, त्यसरी नै तिमीहरूलाई ध्वस्त पार्न र नाश गर्न उहाँलाई आनन्द लाग्नेछ। तिमीहरूले अधिकार गर्नलाई प्रवेश गरिरहेको देशबाट तिमीहरू जरैसमेत उखेलिनेछौ।<verse eid="DEU 28:63"/></para>
<para style="p"><verse number="64" style="v" sid="DEU 28:64"/>त्यसपछि याहवेहले तिमीहरूलाई पृथ्वीको एक छेउदेखि अर्को छेउसम्म सबै जातिहरूको बीचमा छरपस्ट पार्नुहुनेछ। त्यहाँ तिमीहरूले आफैँले र आफ्ना पुर्खाहरूले नजानेका अरू देवी-देवताहरू, काठ र ढुङ्गाका देवी-देवताहरूलाई पूजा गर्नेछौ।<verse eid="DEU 28:64"/></para>
<para style="p"><verse number="65" style="v" sid="DEU 28:65"/>ती देशहरूमा तिमीहरूले आफ्ना खुट्टाको पैतालाको निम्ति शान्ति र विश्राम लिने ठाउँ पाउनेछैनौ। त्यहाँ याहवेहले तिमीहरूका मनमा फिक्री, आँखामा प्रतीक्षाको कारण थकाइ र हृदयमा निराशा दिनुहुनेछ।<verse eid="DEU 28:65"/></para>
<para style="p"><verse number="66" style="v" sid="DEU 28:66"/>तिमीहरू जीवनको अनिश्‍चितताको कारण दिनरात डरले भरिएर हर समय मृत्युको डरमा जिउनेछौ।<verse eid="DEU 28:66"/></para>
<para style="p"><verse number="67" style="v" sid="DEU 28:67"/>तिमीहरूको हृदय डरले भरिएको र तिमीहरूका आँखाले देखेका दृश्यहरूको कारण बिहान तिमीहरूले भन्‍नेछौ, “यदि साँझ भइदिएको भए हुनेथियो!” र साँझमा भन्‍नेछौ, “यदि बिहान भइदिएको भए हुनेथियो।”<verse eid="DEU 28:67"/></para>
<para style="p"><verse number="68" style="v" sid="DEU 28:68"/>याहवेहले तिमीहरूलाई इजिप्ट, जहाँ फेरि कहिल्यै फर्केर नजानू भनी मैले भनेको थिएँ, जहाजबाट फर्काएर पठाउनुहुनेछ। त्यहाँ तिमीहरूले आफूलाई आफ्ना शत्रुहरूका हातमा कमरा-कमारीहरूझैँ दिनलाई राजी हुनेछौ। तर तिमीहरूलाई कसैले पनि किन्‍नेछैन।<verse eid="DEU 28:68"/></para>
<chapter eid="DEU 28"/>
<chapter number="29" style="c" sid="DEU 29"/>
<para style="p"><verse number="1" style="v" sid="DEU 29:1"/>याहवेहले इस्राएलीहरूसँग होरेबमा बाँध्नुभएको करारबाहेक उहाँले मोआबमा मोशालाई इस्राएलीहरूसँग बाँध्नुभएको करारका शर्तहरू यिनै हुन्।<verse eid="DEU 29:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 29:2"/>मोशाले सारा इस्राएलीहरूलाई भेला गराएर तिनीहरूलाई भने: याहवेहले इजिप्टमा फारो र तिनका भारदारहरूसँग, र तिनका सारा देशसँग गर्नुभएका सबै कुरा तिमीहरूका आँखाले देखेका छन्।<verse eid="DEU 29:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 29:3"/>तिमीहरूले आफ्नै आँखाले ती डरलाग्दा सङ्कष्‍टहरू, अलौकिक चिन्हहरू र अद्‌भुत कार्यहरू देखेका छौ।<verse eid="DEU 29:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 29:4"/>तर आजको दिनसम्म याहवेहले तिमीहरूलाई बुझ्ने मन, देख्ने आँखा र सुन्‍ने कान दिनुभएको छैन।<verse eid="DEU 29:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 29:5"/>याहवेहले भन्‍नुहुन्छ, “मैले तिमीहरूलाई उजाडस्थानमा चालीस वर्षसम्म डोर्‍याएको समयमा तिमीहरूले लगाएका लुगा र तिमीहरूका जुत्ता फाटेनन्।<verse eid="DEU 29:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 29:6"/>तिमीहरूले रोटी खाएनौ र मद्य पिएनौ, वा अरू मादक पदार्थ पिएनौ। तिमीहरूले म नै याहवेह तिमीहरूका परमेश्‍वर हुँ भनी बुझ्न सक भनेर नै मैले यसो गरेँ।”<verse eid="DEU 29:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 29:7"/>जब तिमीहरू यस ठाउँमा आइपुग्यौ, तब हेश्बोनका राजा सीहोन र बाशानका राजा ओग हामीसँग लडाइँ गर्न आए; तर हामीले तिनीहरूलाई परास्त गर्‍यौँ।<verse eid="DEU 29:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 29:8"/>हामीले तिनीहरूको देशलाई कब्जा गर्‍यौँ, र त्यस देशलाई उत्तराधिकारको रूपमा रूबेनीहरू, गादीहरू अनि मनश्शेको आधा कुललाई दियौँ।<verse eid="DEU 29:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 29:9"/>यस करारका शर्तहरूलाई होसियारीसाथ पालन गर, र तिमीहरूले गरेका हरेक काममा सफल हुनेछौ।<verse eid="DEU 29:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 29:10"/>आज तिमीहरू सबै, अर्थात् तिमीहरूका अधिकृतहरू र मुख्य व्यक्तिहरू, तिमीहरूका धर्मगुरुहरू र प्रधानहरू सबै याहवेह तिमीहरूका परमेश्‍वरको अगि खडा छौ।<verse eid="DEU 29:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 29:11"/>अनि तिमीहरूका छोराछोरीहरू र तिमीहरूका पत्नीहरू, र तिमीहरूका निम्ति दाउरा काट्ने र पानी बोक्ने तिमीहरूका छाउनीमा बस्‍ने विदेशीहरू पनि साथमा छन्।<verse eid="DEU 29:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 29:12"/>तिमीहरू यहाँ याहवेह आफ्ना परमेश्‍वरसँग त्यो करारमा प्रवेश गर्नलाई खडा छौ, जुन आज उहाँले शपथद्वारा छाप लगाउँदै तिमीहरूसँग बाँध्दैहुनुहुन्छ।<verse eid="DEU 29:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 29:13"/>उहाँले तिमीहरूलाई प्रतिज्ञा गर्नुभएझैँ, र तिमीहरूका पितापुर्खाहरू अब्राहाम, इसहाक र याकोबसँग शपथ खानुभएझैँ, तिमीहरू उहाँका मानिसहरू र उहाँ तिमीहरूका परमेश्‍वर हुनुहुन्छ भनी पक्‍का हुन सकोस्।<verse eid="DEU 29:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 29:14"/>मैले शपथ खाएर यो करार तिमीहरूसँग मात्र बाँधिरहेको छैनँ;<verse eid="DEU 29:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 29:15"/>जो आज यहाँ याहवेह आफ्ना परमेश्‍वरको उपस्थितिमा उभिरहेका छौ, तर आज यहाँ उपस्थिति नहुनेहरूसँग पनि बाँधिरहेको छु।<verse eid="DEU 29:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 29:16"/>हामी इजिप्टमा कसरी बस्यौँ, र यहाँ आइपुग्नको लागि हामीले कसरी देशहरू पार गर्‍यौँ भनी तिमीहरू आफैँले जान्दछौ।<verse eid="DEU 29:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 29:17"/>तिनीहरूका बीचमा तिमीहरूले तिनीहरूका घृणित थोकहरू, काठ, ढुङ्गा, चाँदी र सुनका मूर्तिहरू देख्यौ।<verse eid="DEU 29:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 29:18"/>याहवेह हाम्रा परमेश्‍वरबाट तर्किगएर ती जातिहरूका देवी-देवताहरू पूजा गर्ने हृदय भएको कुनै पनि पुरुष अथवा स्त्रीका कुल वा वंश तिमीहरूको बीचमा छैन भन्‍ने कुरा पक्‍का गर। तिमीहरूको बीचमा तितो विष उमार्ने कुनै पनि जरा नहोस् भनी निश्‍चित गर।<verse eid="DEU 29:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 29:19"/>जब यस्ता व्यक्तिले यस शपथका शब्दहरू सुन्छन्; अनि तिनीहरू आफैँले आशिष् पाउन चाहन्छन् र सोच्दछन्, “म आफ्नै तरिकाले चलिरहे तापनि म सुरक्षित नै रहनेछु,” यसले गर्दा तिनीहरूले भिजेको जमिन अथवा ओबानो जमिनमा विपत्ति ल्याउनेछन्।<verse eid="DEU 29:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 29:20"/>तिनीहरूलाई याहवेहले कहिल्यै क्षमा दिने मन गर्नुहुनेछैन। उहाँको क्रोध र डाहको जलन तिनीहरूको विरुद्धमा दन्कनेछ। यस व्यवस्थाका पुस्तकमा लेखिएका सबै श्रापहरू तिनीहरूमाथि पर्नेछन्। अनि याहवेहले तिनीहरूको नाम आकाशमुनिबाट मेटिदिनुहुनेछ।<verse eid="DEU 29:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 29:21"/>व्यवस्थाको यो पुस्तकमा लेखिएका करारका सबै श्रापअनुसार याहवेहले तिनीहरूलाई इस्राएलका सबै कुलहरूबाट नाशको निम्ति अलग गर्नुहुनेछ।<verse eid="DEU 29:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 29:22"/>तिमीहरूका भावी पुस्ताका छोराछोरीहरू र टाढा देशहरूबाट आउने विदेशीहरूले यस देशमा आइपरेका विपत्तिहरू अनि याहवेहले देशमा पठाउनुभएका रोगहरू देख्नेछन्।<verse eid="DEU 29:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 29:23"/>सारा देशलाई नुन र गन्धकले जलाएर बरबाद गर्नेछ—त्यहाँ केही पनि रोपिनेछैन, उम्रनेछैन र कुनै रूखबिरुवा केही पनि उम्रनेछैन। त्यो देश याहवेहले आफ्नो भयानक क्रोधमा नष्‍ट पार्नुभएको सदोम र गमोरा, अदमा र सबोयीमजस्तै हुनेछ।<verse eid="DEU 29:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 29:24"/>सबै जाति-जातिहरूले सोध्नेछन्: “याहवेहले यस देशलाई किन यस्तो गर्नुभयो? किन यस्तो डरलाग्दो र दन्कने रिस गर्नुभयो?”<verse eid="DEU 29:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 29:25"/>अनि जवाफचाहिँ यस्तो हुनेछ, “किनकि यस जातिले याहवेह तिनीहरूका पितापुर्खाहरूका परमेश्‍वरको करार, उहाँले तिनीहरूलाई इजिप्टबाट ल्याउनुहुँदा तिनीहरूसँग गर्नुभएको करारलाई तोडेका छन्।<verse eid="DEU 29:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 29:26"/>तिनीहरू तर्केर गएका छन्, र अरू देवी-देवताहरू, तिनीहरूले नजानेका र उहाँले तिनीहरूलाई मनाही गर्नुभएका देवी-देवताहरूलाई दण्डवत् गरेका छन्।<verse eid="DEU 29:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 29:27"/>यसकारण यस देशको विरुद्धमा याहवेहको क्रोध दन्कियो। त्यसैले उहाँले यस व्यवस्थाको पुस्तकमा लेखिएका सबै श्रापहरू यस देशमाथि ल्याउनुभयो।<verse eid="DEU 29:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 29:28"/>याहवेहले तिनीहरूलाई भयानक रिस र डरलाग्दो क्रोधमा आफ्नो देशबाट उखेलेर अर्को देशमा फालिदिनुभयो; अनि तिनीहरू अहिलेसम्म छँदैछन्।”<verse eid="DEU 29:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 29:29"/>गुप्‍त कुराहरू याहवेह हाम्रा परमेश्‍वरकै हुन्, तर प्रकट गरिएका कुराहरूचाहिँ हामी र हाम्रा सन्तानहरूका लागि सदाका निम्ति हुन्; ताकि हामीले यस व्यवस्थाका सबै कुराहरू पालन गर्न सकौँ।<verse eid="DEU 29:29"/></para>
<chapter eid="DEU 29"/>
<chapter number="30" style="c" sid="DEU 30"/>
<para style="p"><verse number="1" style="v" sid="DEU 30:1"/>जब मैले तिमीहरूका सामु राखिदिएका यी सबै आशिष् र श्रापहरू तिमीहरूमाथि आइपर्नेछन्, तब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई जातिहरूका बीचमा छरपस्ट पार्नुभएपछि तिमीहरूले ती हृदयमा लिनेछौ।<verse eid="DEU 30:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 30:2"/>अनि जब तिमीहरू र तिमीहरूका छोराछोरीहरू याहवेह आफ्ना परमेश्‍वरकहाँ फर्कनेछौ, र आज मैले तिमीहरूलाई आज्ञा दिएअनुसार हरेक कुरामा आफ्ना सारा हृदयले र आफ्ना सारा प्राणले उहाँका आज्ञाहरू पालन गर्छौ,<verse eid="DEU 30:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 30:3"/>तब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका सुदिन फर्काइदिनुहुनेछ, र तिमीहरूमाथि दया देखाउनुहुनेछ। अनि उहाँले तिमीहरूलाई छरपस्ट पार्नुभएका सबै जातिहरूका बीचबाट फेरि भेला गराउनुहुनेछ।<verse eid="DEU 30:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 30:4"/>तिमीहरू पृथ्वीका धेरै टाढा-टाढाका देशमा धपाइएका भए तापनि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई त्यहाँबाट भेला गराएर तिमीहरूलाई फर्काइ ल्याउनुहुनेछ।<verse eid="DEU 30:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 30:5"/>याहवेहले तिमीहरूलाई तिमीहरूका पितापुर्खाहरूका देशमा ल्याउनुहुनेछ, र त्यस देशमा तिमीहरूले अधिकार गर्नेछौ। उहाँले तिमीहरूलाई तिमीहरूका पितापुर्खाहरूभन्दा अझै धेरै समृद्ध र असंख्य बनाउनुहुनेछ।<verse eid="DEU 30:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 30:6"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका र तिमीहरूका सन्तानहरूका हृदयको खतना गर्नुहुनेछ, जसले गर्दा तिमीहरूले उहाँलाई आफ्ना सारा हृदयले र आफ्ना सारा प्राणले प्रेम गर्न सक र त्यस देशमा तिमीहरू जीवित रहन सक।<verse eid="DEU 30:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 30:7"/>याहवेह तिमीहरूका परमेश्‍वरले यी सबै श्रापहरू तिमीहरूलाई घृणा गर्ने र सताउने तिमीहरूका शत्रुहरूमाथि ल्याउनुहुनेछ।<verse eid="DEU 30:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 30:8"/>तिमीहरूले याहवेहको वचन फेरि पालन गर्नेछौ, र आज मैले तिमीहरूलाई दिइरहेका उहाँका सबै आज्ञाहरूको अनुसरण गर्नेछौ।<verse eid="DEU 30:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 30:9"/>तब याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका हातका सबै कामहरूमा र तिमीहरूका सन्तानमा, गाईबस्तुका बाछाबाछीहरूमा र जमिनका अन्‍नबालीहरूमा अति धेरै समृद्धि प्रदान गर्नुहुनेछ। याहवेह तिमीहरूका पितापुर्खाहरूसँग प्रसन्‍न हुनुभएझैँ तिमीहरूसँग फेरि प्रसन्‍न हुनुहुनेछ, र तिमीहरूलाई समृद्धि प्रदान गर्नुहुनेछ।<verse eid="DEU 30:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 30:10"/>यदि तिमीहरूले याहवेह आफ्ना परमेश्‍वरका आज्ञाहरू पालन गर्‍यौ र व्यवस्थाको यस पुस्तकमा लेखिएका उहाँका आज्ञाहरू र उर्दीहरू पालन गर्‍यौ भने, र यदि आफ्ना सारा हृदय र सारा प्राणले याहवेह तिमीहरूका परमेश्‍वरकहाँ फर्क्यौ भने उहाँ तिमीहरूसित प्रसन्‍न हुनुहुनेछ, र तिमीहरूलाई समृद्धि प्रदान गर्नुहुनेछ।<verse eid="DEU 30:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 30:11"/>आज मैले तिमीहरूलाई जे आज्ञा दिइरहेको छु, यो तिमीहरूका निम्ति अति कठिन वा पालन गर्न नसक्ने किसिमको छैन।<verse eid="DEU 30:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 30:12"/>यो आज्ञा स्वर्गमा राखिएको छैन, ताकि तिमीहरूले यसो भन्‍नुपरोस्, “स्वर्गमा उक्लिएर को जाला र यसलाई हामीकहाँ ल्याएर घोषणा गर्ला, र हामी यसलाई पालन गरौँला?”<verse eid="DEU 30:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 30:13"/>न त यो समुद्रपारि नै छ, र तिमीहरूले यसो भन्‍नुपरोस्, “समुद्रपार गरेर यसलाई कसले ल्याउला, र हामीलाई घोषणा गर्ला, र हामी यसलाई पालन गरौँला।”<verse eid="DEU 30:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 30:14"/>होइन, वचन त तिमीहरूको एकदम नजिकै छ; तिमीहरूकै मुखमा र तिमीहरूका हृदयमा छ, ताकि तिमीहरूले यसलाई पालन गर्न सक।<verse eid="DEU 30:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 30:15"/>हेर, आज मैले तिमीहरूका अगि जीवन र समृद्धि, मृत्यु र विनाश राखिदिएको छु।<verse eid="DEU 30:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 30:16"/>किनकि आज म तिमीहरूलाई आज्ञा दिन्छु, तिमीहरूले याहवेह आफ्ना परमेश्‍वरलाई प्रेम गर्नू, उहाँका मार्गहरूमा हिँड्नू र उहाँका आज्ञाहरू, उर्दीहरू र नियमहरू पालन गर्नू; तब तिमीहरू जीवित रहनेछौ र संख्यामा बढ्नेछौ। अनि तिमीहरूले अधिकार गर्नलाई प्रवेश गरिरहेको देशमा याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आशिष् दिनुहुनेछ।<verse eid="DEU 30:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 30:17"/>तर यदि तिमीहरूका हृदय तर्केर गयो र तिमीहरू अनाज्ञाकारी भयौ, र तिमीहरू अरू देवी-देवताहरूका अगि दण्डवत् गर्न र तिनीहरूलाई पुज्नलाई आकर्षित भयौ भने,<verse eid="DEU 30:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 30:18"/>म आज तिमीहरूलाई यो घोषणा गर्दछु, तिमीहरू अवश्य नाश हुनेछौ। तिमीहरूले यर्दन पार गरेर अधिकार गर्न जाने देशमा तिमीहरू लामो समयसम्म जीवित रहनेछैनौ।<verse eid="DEU 30:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 30:19"/>आजको दिन म आकाश र पृथ्वीलाई तिमीहरूको विरुद्धमा साक्षीको रूपमा राख्दछु, मैले तिमीहरूको अगि जीवन र मृत्यु, आशिष् र श्राप राखिदिएको छु। अब जीवन नै रोज, ताकि तिमीहरू र तिमीहरूका छोराछोरीहरू जीवित रहन सक।<verse eid="DEU 30:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 30:20"/>अनि तिमीहरूले याहवेह आफ्ना परमेश्‍वरलाई प्रेम गर्न सक, उहाँको सोर सुन्‍न र उहाँमा लागिरहन सक। किनकि याहवेह नै तिमीहरूका जीवन हुनुहुन्छ; अनि उहाँले तिमीहरूका पितापुर्खाहरू अब्राहाम, इसहाक र याकोबसँग दिन्छु भनी शपथ खानुभएको देशमा उहाँले तिमीहरूलाई लामो जीवन दिनुहुनेछ।<verse eid="DEU 30:20"/></para>
<chapter eid="DEU 30"/>
<chapter number="31" style="c" sid="DEU 31"/>
<para style="p"><verse number="1" style="v" sid="DEU 31:1"/>तब मोशा बाहिर गए, र सारा इस्राएलीहरूलाई यी कुराहरू भने:<verse eid="DEU 31:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 31:2"/>“अहिले म एक सय बीस वर्ष पुगेँ; अब तिमीहरूलाई अगुवाइ गर्ने क्षमता मसँग छैनँ। याहवेहले मलाई भन्‍नुभएको छ, ‘तैँले यर्दन पार गर्नेछैनस्।’<verse eid="DEU 31:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 31:3"/>याहवेह तिमीहरूका परमेश्‍वर आफैँ तिमीहरूको अगि यर्दनपारि जानुहुनेछ। उहाँले तिमीहरूका सामु यी जातिहरूलाई नष्‍ट गर्नुहुनेछ र तिमीहरूले तिनीहरूका देशलाई कब्जा गर्नेछौ। याहवेहले भन्‍नुभएअनुसार यहोशू पनि तिमीहरूका अगि यर्दनपारि जानेछ।<verse eid="DEU 31:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 31:4"/>अनि जसरी याहवेहले एमोरीहरूका राजाहरू सीहोन र ओगलाई तिनीहरूका राज्यसँगै नाश पार्नुभएको थियो, त्यसरी नै उहाँले तिनीहरूलाई नाश गर्नुहुनेछ।<verse eid="DEU 31:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 31:5"/>याहवेहले तिनीहरूलाई तिमीहरूका हातमा सुम्पिदिनुहुनेछ। अनि तिमीहरूलाई मैले दिएका सबै आज्ञाअनुसार तिनीहरूलाई गर्नुपर्छ।<verse eid="DEU 31:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 31:6"/>तिमीहरू बलिया र साहसी होओ। तिनीहरूका कारण नडराओ र भयभीत नहोओ; किनकि याहवेह तिमीहरूका परमेश्‍वर तिमीहरूसँग जानुहुनेछ। उहाँले तिमीहरूलाई कहिल्यै पनि छोड्नुहुनेछैन, न त त्याग्नुहुनेछ।”<verse eid="DEU 31:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 31:7"/>तब मोशाले यहोशूलाई बोलाइपठाए, र सारा इस्राएलीहरूको उपस्थितिमा तिनलाई भने, “बलियो र साहसी होऊ; किनकि यी मानिसहरूसँग याहवेहले तिनीहरूका पितापुर्खाहरूलाई दिन्छु भनी शपथ खानुभएको देशमा तिमी जानुपर्छ। अनि तिमीले त्यस देशलाई यिनीहरूका अधिकारको रूपमा यिनीहरूलाई बाँडिदिनुपर्छ।<verse eid="DEU 31:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 31:8"/>याहवेह आफैँ तिम्रो अगि जानुहुनेछ र तिमीसँग हुनुहुनेछ। उहाँले तिमीलाई कहिल्यै पनि छोड्नुहुनेछैन, न त त्याग्नुहुनेछ। यसकारण तिमी नडराऊ; हतोत्साहित नहोऊ।”<verse eid="DEU 31:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 31:9"/>यसकारण मोशाले यो व्यवस्था लेखे, र त्यो लेवी पुजारीहरू, याहवेहको करारका सन्दुक बोक्ने पुजारीहरू र इस्राएलका सबै प्रधानहरूलाई सुम्पिदिए।<verse eid="DEU 31:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 31:10"/>तब मोशाले तिनीहरूलाई यसरी आज्ञा दिए: “प्रत्येक सात वर्षको अन्त्यमा, छाप्रोबास चाडको समय, ऋण माफ गरिदिने समयमा,<verse eid="DEU 31:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 31:11"/>जब सारा इस्राएलीहरू याहवेह आफ्ना परमेश्‍वरको उपस्थितिमा, उहाँले चुन्‍नुभएको ठाउँमा देखा पर्न आउँछन्, तब तिमीहरूले यो व्यवस्थालाई तिनीहरूले सुन्‍ने गरी पढ्नू।<verse eid="DEU 31:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 31:12"/>सबै मानिसहरूलाई भेला गर्नू; पुरुष, स्त्री, छोराछोरी र तिमीहरूका सहरहरूमा बसोबास गर्ने विदेशीहरू; ताकि तिनीहरूले पनि सुनून् र याहवेह तिमीहरूका परमेश्‍वरको डर मान्‍न र यस व्यवस्थाका सबै वचन होसियारीसाथ पालन गर्न सिकून्।<verse eid="DEU 31:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 31:13"/>यस व्यवस्थालाई नजान्‍ने तिनीहरूका छोराछोरीहरूले यसलाई सुन्‍नैपर्छ। अनि तिमीहरूले यर्दनपारि अधिकार गर्न जाँदैगरेको देशमा बाँचुन्जेल याहवेह तिमीहरूका परमेश्‍वरको डर मान्‍न सिकून्।”<verse eid="DEU 31:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 31:14"/>याहवेहले मोशालाई भन्‍नुभयो, “अब तेरो मृत्युको दिन नजिकै छ। यहोशूलाई बोला, र तँ आफैँ पनि भेट हुने पालमा उपस्थित हुनु। त्यहाँ म त्यसलाई जिम्मेवारी सुम्पनेछु।” यसकारण मोशा र यहोशूले आफूलाई भेट हुने पालमा उपस्थित गराए।<verse eid="DEU 31:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 31:15"/>तब याहवेह पालमा बादलको खम्बामा देखा पर्नुभयो; र त्यो बादल भेट हुने पालको प्रवेशद्वारमा खडा भयो।<verse eid="DEU 31:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 31:16"/>अनि याहवेहले मोशालाई भन्‍नुभयो: “सुन्, तँ अब आफ्ना पितापुर्खाहरूसँग विश्राम गर्न जाँदैछस्। अनि यी मानिसहरूले चाँडै नै तिनीहरू प्रवेश गर्न लागेको देशमा विदेशी देवी-देवताहरूसँग व्यभिचार गर्नेछन्। तिनीहरूले मलाई त्याग्नेछन् र मैले तिनीहरूसँग बाँधेको मेरो करार भङ्ग गर्नेछन्।<verse eid="DEU 31:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 31:17"/>त्यस दिन म तिनीहरूसँग रिसाउनेछु र तिनीहरूलाई त्याग्नेछु; म आफ्नो अनुहार तिनीहरूदेखि लुकाउनेछु। अनि तिनीहरू नाश हुनेछन्। तिनीहरूमाथि धेरै प्रकोपहरू र विपत्तिहरू आइपर्नेछन्; र त्यस दिन तिनीहरूले सोध्नेछन्, ‘के हाम्रा परमेश्‍वर हामीसँग नहुनुभएकोले नै यी प्रकोपहरू हामीमाथि आएका होइनन् र?’<verse eid="DEU 31:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 31:18"/>अनि तिनीहरूले अरू देवी-देवताहरूतिर लागेर गरेका सबै दुष्‍टताको कारण म त्यस दिन तिनीहरूदेखि निश्‍चय नै आफ्नो मुहार लुकाउनेछु।<verse eid="DEU 31:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 31:19"/>“अब यो गीत लेख्, र इस्राएलीहरूलाई सिका; अनि तिनीहरूलाई गाउन लगा; ताकि तिनीहरूको विरुद्धमा यो मेरो निम्ति एउटा साक्षी हुनेछ।<verse eid="DEU 31:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 31:20"/>जब मैले तिनीहरूलाई दूध र मह बग्ने देशमा, तिनीहरूका पितापुर्खाहरूलाई शपथ खाएर प्रतिज्ञा गरेको देशमा ल्याउँछु, तिनीहरूले अघाउन्जेल खाएर मोटाउनेछन्। अनि मलाई तिरस्कार गरेर मेरा करार भङ्ग गर्दै तिनीहरू अरू देवी-देवताहरूतिर लाग्नेछन्; र तिनीहरूलाई आराधना गर्नेछन्।<verse eid="DEU 31:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 31:21"/>अनि जब तिनीहरूमाथि धेरै प्रकोपहरू र विपत्तिहरू आइपर्नेछन्, तब यस गीतले तिनीहरूको विरुद्धमा साक्षी दिनेछ। किनकि तिनीहरूका सन्तानले यसलाई बिर्सेका हुनेछैनन्। मैले तिनीहरूलाई शपथ खाएर प्रतिज्ञा गरेको देशमा मैले तिनीहरूलाई ल्याउन अगि नै तिनीहरूले के गर्ने विचार गरेका छन् भनी म जान्दछु।”<verse eid="DEU 31:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 31:22"/>यसकारण मोशाले त्यही दिन यो गीत लेखे, र इस्राएलीहरूलाई त्यो सिकाए।<verse eid="DEU 31:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 31:23"/>याहवेहले नूनका छोरा यहोशूलाई यो आज्ञा दिनुभयो: “बलियो बन् र साहस गर्; किनकि मैले शपथ खाएर प्रतिज्ञा गरेको देशमा इस्राएलीहरूलाई तैँले ल्याउनेछस्, र म आफैँ तँसँग हुनेछु।”<verse eid="DEU 31:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 31:24"/>मोशाले एउटा पुस्तकमा व्यवस्थाका यी वचनहरू सुरुदेखि अन्त्यसम्म लेखिसके,<verse eid="DEU 31:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 31:25"/>तब मोशाले याहवेहका करारको सन्दुक बोक्ने लेवीहरूलाई यो आज्ञा दिए:<verse eid="DEU 31:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 31:26"/>“यो व्यवस्थाको पुस्तक लिएर याहवेह तिमीहरूका परमेश्‍वरको करारको सन्दुकको छेउमा राख। अनि त्यो तिमीहरूको विरुद्धमा साक्षीको रूपमा त्यहाँ रहनेछ।<verse eid="DEU 31:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 31:27"/>किनकि तिमीहरू कति विद्रोही र हठी छौ भनी म जान्दछु। म जीवित हुँदा-हुँदै र तिमीहरूसँगै हुँदासमेत तिमीहरू याहवेहको विरुद्धमा बागी भएका छौ भने म मरेपछि तिमीहरूले झन् कति विद्रोह गरौला!<verse eid="DEU 31:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 31:28"/>मेरो अगि तिमीहरूका कुलका सबै प्रधानहरू र तिमीहरूका सबै अधिकृतहरूलाई भेला गर; ताकि म तिनीहरूले सुन्‍ने गरी यी वचनहरू बोल्न सकूँ; अनि आकाश र पृथ्वीलाई तिनीहरूको विरुद्धमा साक्षी राख्न सकूँ।<verse eid="DEU 31:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 31:29"/>किनकि मेरो मृत्युपछि तिमीहरू निश्‍चय नै अति भ्रष्‍ट हुनेछौ; र मैले तिमीहरूलाई आज्ञा गरेको मार्गबाट तर्किजानेछौ भनी म जान्दछु। आउँदा दिनहरूमा तिमीहरूमाथि विपत्ति आइपर्नेछ; किनकि तिमीहरूले याहवेहको दृष्‍टिमा दुष्‍ट काम गरेर तिमीहरूका हातले बनाएका कुराहरूद्वारा उहाँलाई रिस उठाउनेछौ।”<verse eid="DEU 31:29"/></para>
<para style="p"><verse number="30" style="v" sid="DEU 31:30"/>अनि मोशाले यस गीतका शब्दहरू इस्राएलका सारा समुदायले सुन्‍ने गरी सुरुदेखि अन्त्यसम्म सुनाइदिए:<verse eid="DEU 31:30"/></para>
<chapter eid="DEU 31"/>
<chapter number="32" style="c" sid="DEU 32"/>
<para style="p"><verse number="1" style="v" sid="DEU 32:1"/>हे आकाश, सुन र म बोल्नेछु; हे पृथ्वी, मेरा मुखका वचनहरू सुन।<verse eid="DEU 32:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 32:2"/>मेरो शिक्षा वर्षाजस्तै झर्नेछ, र मेरा शब्दहरू शीतजस्तै खस्‍नेछ, नयाँ घाँसमा पानीका थोपाझैँ; कलिला बोटबिरुवाहरूमाथि परेको झरीजस्तै।<verse eid="DEU 32:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 32:3"/>म याहवेहको नामको घोषणा गर्नेछु, अहो! हाम्रा परमेश्‍वरको महानताको प्रशंसा गर!<verse eid="DEU 32:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 32:4"/>उहाँ चट्टान हुनुहुन्छ; उहाँका कामहरू सिद्ध छन्, र उहाँका सबै मार्गहरू न्यायपूर्ण छन्। उहाँ विश्‍वासयोग्य परमेश्‍वर, जसले भूल गर्नुहुन्‍न; उहाँ सोझा र न्यायपूर्ण हुनुहुन्छ।<verse eid="DEU 32:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 32:5"/>तिनीहरू भ्रष्‍ट भएका छन् र तिनीहरू उहाँका सन्तान होइनन्; तिनीहरू पतित र भ्रष्‍ट पुस्ता हुन्।<verse eid="DEU 32:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 32:6"/>हे मूर्ख र निर्बुद्धि मानिसहरू हो, के तिमीहरूले याहवेहलाई गर्ने व्यवहार यही हो? तिमीहरूलाई सृष्‍टि गर्नुहुने र गर्भमा रच्नुहुने, के उहाँ नै तिमीहरूका पिता, तिमीहरूका सृष्‍टिकर्ता हुनुहुन्‍न र?<verse eid="DEU 32:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 32:7"/>ती पुराना दिनहरूलाई सम्झ; धेरै अगिका पुस्ताहरूलाई विचार गर। तिमीहरूका बुबालाई सोध, र तिनले तिमीहरूलाई भन्‍नेछन्; तिमीहरूका प्रधानहरूलाई सोध र तिनीहरूले तिमीहरूलाई बताइदिनेछन्।<verse eid="DEU 32:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 32:8"/>जब सर्वोच्‍चले जातिहरूलाई तिनीहरूका उत्तराधिकार दिनुभयो, जब उहाँले सबै मानव-जातिलाई विभाजन गर्नुभयो, तब उहाँले इस्राएलका छोराहरूका संख्याअनुसार मानिसहरूका सिमाना तोकिदिनुभयो।<verse eid="DEU 32:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 32:9"/>किनकि याहवेहको भाग उहाँका मानिसहरू नै हुन्; याकोबचाहिँ उहाँको भागको उत्तराधिकार हो।<verse eid="DEU 32:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 32:10"/>उहाँले तिनलाई उजाडस्थानमा भेट्टाउनुभयो; बाँझो र गर्जने बतास भएको निर्जन स्थानमा भेट्टाउनुभयो। उहाँले तिनको रक्षा गर्नुभयो र तिनको हेरचाह गर्नुभयो; उहाँले तिनलाई आफ्नै आँखाको नानीलाई झैँ जोगाउनुभयो।<verse eid="DEU 32:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 32:11"/>चीलले आफ्नो गुँडलाई चलाएझैँ, र आफ्नो बचेरालाई पखेटाले ढाकेझैँ, त्यसले तिनीहरूलाई पक्रनको लागि आफ्ना पखेटा फैलाएझैँ, र तिनीहरूलाई उचाइमा बोकेझैँ।<verse eid="DEU 32:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 32:12"/>याहवेह आफैँले तिनलाई डोर्‍याउनुभयो; उहाँसँग कुनै पनि विदेशी देवी-देवता थिएन।<verse eid="DEU 32:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 32:13"/>उहाँले तिनलाई पृथ्वीको अग्लो ठाउँहरूमा सवार गराउनुभयो; र तिनलाई खेतबारीमा उब्जेका फलहरू खुवाउनुभयो। उहाँले तिनलाई पहराबाट निकालेको मह र चट्टाने ठाउँमा उम्रेको जैतुन बोटबाट निकालेको तेलले,<verse eid="DEU 32:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 32:14"/>बथान र बगालबाटको दही र दूधले, र मोटा थुमाहरू र बाख्राहरूले बाशानका सबैभन्दा असल भेडाहरूले र गहुँका सर्वोत्तम दानाले पालनपोषण गर्नुभयो। तिमीहरूले दाखबाट तयार भएको दाखरस पियौ।<verse eid="DEU 32:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 32:15"/>यशूरून मोटो भयो, र त्यसले लात हान्यो; भोजनले टन्‍न अघाए, तिनीहरू मोटा र चिल्‍ला भए। तिनीहरूले आफूलाई सृष्‍टि गर्नुहुने परमेश्‍वरलाई त्यागे, र तिनीहरूका उद्धारको चट्टानलाई इन्कार गरे।<verse eid="DEU 32:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 32:16"/>तिनीहरूले उहाँलाई आफ्ना विदेशी देवी-देवताहरूको कारण डाही तुल्याए; र तिनीहरूका घृणित मूर्तिहरूले उहाँलाई रिस उठाए।<verse eid="DEU 32:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 32:17"/>तिनीहरूले भूतहरूका निम्ति बलिदान चढाए, जो परमेश्‍वर होइनन्; आफूले नचिनेका देवी-देवताहरू, भर्खरै देखा परेका नयाँ देवी-देवताहरू, तिमीहरूका पितापुर्खाहरूले डर नमानेका देवी-देवताहरू।<verse eid="DEU 32:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 32:18"/>तिमीहरूलाई जन्माउने चट्टानलाई तिमीहरूले बिरानो तुल्यायौ; तिमीहरूलाई जन्माउने परमेश्‍वरलाई तिमीहरूले बिर्सिदियौ।<verse eid="DEU 32:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 32:19"/>याहवेहले यो कुरा देख्नुभयो; र तिनीहरूलाई त्यागिदिनुभयो। किनकि उहाँलाई आफ्ना छोराछोरीहरूले रिस उठाएका थिए।<verse eid="DEU 32:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 32:20"/>उहाँले भन्‍नुभयो, “म आफ्नो मुहार तिनीहरूबाट लुकाउनेछु,” र तिनीहरूको अन्त्य कस्तो हुनेछ म हेर्छु; किनकि तिनीहरू भ्रष्‍ट पुस्ता हुन्, विश्‍वासघाती सन्तानहरू हुन्।<verse eid="DEU 32:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 32:21"/>जो ईश्‍वर नै होइन, त्यसैद्वारा तिनीहरूले मलाई डाही तुल्याए र तिनीहरूका व्यर्थको मूर्तिहरूद्वारा मलाई रिस उठाए। म तिनीहरूलाई कमजोर जातिद्वारा डाही तुल्याउनेछु; समझशक्ति नै नभएको जातिद्वारा म तिनीहरूलाई रिस उठाउनेछु।<verse eid="DEU 32:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 32:22"/>किनकि मेरो क्रोधद्वारा आगो सल्केको छ। जसद्वारा मृतकहरूको ठाउँ तल पातालसम्मै आगो लगाउनेछ। जसले पृथ्वी र त्यसको उब्जनीलाई भस्म पार्नेछ, अनि पर्वतहरूको जगमा आगो लगाउनेछ।<verse eid="DEU 32:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 32:23"/>म तिनीहरूमाथि विपत्तिहरू खडा गरिदिनेछु, र मेरो काँडहरू तिनीहरूको विरुद्धमा चलाउनेछु।<verse eid="DEU 32:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 32:24"/>म तिनीहरूका विरुद्धमा विनाशकारी अनिकाल, भस्म गर्ने महामारी र घातक रूढी पठाउनेछु; तिनीहरू विरुद्ध डरलाग्दो दाह्रा भएका जङ्गली जनावरहरू हमला गर्न पठाउनेछु, र जमिनमा घस्रने विषालु सर्पहरू तिनीहरूलाई मार्न पठाउनेछु।<verse eid="DEU 32:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 32:25"/>तिनीहरूलाई सडकहरूमा तरवारले निःसन्तान बनाउनेछ; घरहरूमा चाहिँ तिनीहरूका बीचमा आतङ्क फैलिनेछ। जवान पुरुष र स्त्रीहरू नाश हुनेछन्। शिशुहरू र केश फूलेका बुढापाकाहरू पनि नाश हुनेछन्।<verse eid="DEU 32:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 32:26"/>“मैले भनेँ, म तिनीहरूलाई छरपस्ट पार्नेछु; र मानिस जातिहरूको बीचबाट तिनीहरूको नामनिशानै मेटिदिनेछु।<verse eid="DEU 32:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 32:27"/>तर म शत्रुको गिल्‍लादेखि डराएँ; कहीँ विरोधीहरूले गलत बुझ्लान् र भन्लान्, ‘हामीले विजय पायौँ; याहवेहले यो सबै गर्नुभएको होइन।’ ”<verse eid="DEU 32:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 32:28"/>तिनीहरू त विवेक नभएका जाति हुन्। तिनीहरूमा अलिकति पनि अन्तर्दृष्‍टि छैन।<verse eid="DEU 32:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 32:29"/>यदि तिनीहरू अलिकति मात्र बुद्धिमानी भए त! यो कुरा बुझिदिएको भए, र तिनीहरूको अन्त्य कस्तो हुनेछ, सो बुझ्न सकेको भए!<verse eid="DEU 32:29"/></para>
<para style="p"><verse number="30" style="v" sid="DEU 32:30"/>कसरी एक जना मानिसले एक हजारलाई खेद्न सक्ला र? अथवा कसरी दुई जनाले दश हजारसँग युद्ध गर्न सक्ला र? तिनीहरूका चट्टानले तिनीहरूलाई नबेचिदिनुभए, तिनीहरूका याहवेहले तिनीहरूलाई नत्याग्नुभए?<verse eid="DEU 32:30"/></para>
<para style="p"><verse number="31" style="v" sid="DEU 32:31"/>किनकि हाम्रा शत्रुहरूले सोचेझैँ, तिनीहरूका चट्टान हाम्रो चट्टानजस्तो होइन।<verse eid="DEU 32:31"/></para>
<para style="p"><verse number="32" style="v" sid="DEU 32:32"/>तिनीहरूका दाखरस त सदोमको दाखबाट, र गमोराका खेतहरूबाट आउँछ। तिनीहरूका अङ्‌गुरहरू विषले भरिएका, र तिनीहरूका झुप्पाहरू तितोपनाले भरिएका छन्।<verse eid="DEU 32:32"/></para>
<para style="p"><verse number="33" style="v" sid="DEU 32:33"/>तिनीहरूका दाखरस सर्पका विष हो, गोमनहरूको घातक विष हो।<verse eid="DEU 32:33"/></para>
<para style="p"><verse number="34" style="v" sid="DEU 32:34"/>के मैले यो जोगाएर राखेको छैनँ, र मेरो भण्डारमा छाप लगाएर राखेको छैनँ र?<verse eid="DEU 32:34"/></para>
<para style="p"><verse number="35" style="v" sid="DEU 32:35"/>बदला लिने काम मेरो हो; म बदला लिनेछु, ठिक समयमा तिनीहरूका खुट्टा चिप्लनेछ; तिनीहरूको विपत्तिको दिन नजिकै छ, र तिनीहरूको विनाश तिनीहरूमाथि आइपर्न लागेको छ।<verse eid="DEU 32:35"/></para>
<para style="p"><verse number="36" style="v" sid="DEU 32:36"/>जब याहवेहले आफ्नो जातिको बल घटेको अनि कमारा वा स्वतन्त्र शेष नरहेको देख्नुहुनेछ, तब उहाँले तिनीहरूको न्याय गर्नुहुनेछ; र आफ्ना सेवकहरूप्रति दया देखाउनुहुनेछ।<verse eid="DEU 32:36"/></para>
<para style="p"><verse number="37" style="v" sid="DEU 32:37"/>उहाँले भन्‍नुहुनेछ, “अहिले तिनीहरूका देवी-देवताहरू तिनीहरूले शरण लिएको चट्टान कहाँ छ,<verse eid="DEU 32:37"/></para>
<para style="p"><verse number="38" style="v" sid="DEU 32:38"/>तिनीहरूका बलिदानका बोसोहरू खाने देवी-देवताहरू अनि तिनीहरूका अर्घबलिका मद्य पिउने देवी-देवताहरू कहाँ छन्? तिमीहरूलाई सहायता गर्न तिनीहरू उठून्! तिमीहरूलाई तिनीहरूले शरण देऊन्!<verse eid="DEU 32:38"/></para>
<para style="p"><verse number="39" style="v" sid="DEU 32:39"/>“अब हेर, म उही हुँ! मबाहेक अरू कुनै ईश्‍वर छैन। म नै मार्छु, र म नै जीवित पार्छु, मैले नै चोट दिन्छु, र म नै निको पार्छु; अनि मेरो हातबाट कसैले पनि छुटाउन सक्दैन।<verse eid="DEU 32:39"/></para>
<para style="p"><verse number="40" style="v" sid="DEU 32:40"/>म आफ्नो हात स्वर्गतिर उठाउँछु, र शपथ खान्छु: म सदाकालका निम्ति जीवित रहन्छु;<verse eid="DEU 32:40"/></para>
<para style="p"><verse number="41" style="v" sid="DEU 32:41"/>जब म मेरो चम्किलो तरवारमा धार लगाउँछु, र न्यायको निम्ति मेरो हातले त्यो पक्रन्छ, म मेरो विरोधीहरूसँग बदला लिनेछु; अनि मलाई घृणा गर्नेहरूलाई बदला लिनेछु।<verse eid="DEU 32:41"/></para>
<para style="p"><verse number="42" style="v" sid="DEU 32:42"/>म मेरा काँडहरूलाई रगतले मताउनेछु; अनि मेरा तरवारले चाहिँ मासु खानेछ: मारिएका र कैदमा परेकाहरूको रगत, र शत्रुहरूका अगुवाहरूका शिरहरू हुनेछन्।”<verse eid="DEU 32:42"/></para>
<para style="p"><verse number="43" style="v" sid="DEU 32:43"/>हे जातिहरू हो, उहाँका मानिसहरूसँग रमाओ! किनकि उहाँले आफ्ना सेवकहरूको रगतको बदला लिनुहुनेछ; उहाँले आफ्ना शत्रुहरूमाथि बदला लिनुहुनेछ; अनि उहाँले आफ्नो देश र मानिसहरूका निम्ति प्रायश्‍चित गर्नुहुनेछ।<verse eid="DEU 32:43"/></para>
<para style="p"><verse number="44" style="v" sid="DEU 32:44"/>मोशा र नूनका छोरा यहोशू आएर मानिसहरूले सुन्‍ने गरी यस गीतका सबै वचनहरू सुनाए।<verse eid="DEU 32:44"/></para>
<para style="p"><verse number="45" style="v" sid="DEU 32:45"/>जब मोशाले सारा इस्राएलीहरूलाई यी सबै वचनहरू वाचन गरी सुनाए,<verse eid="DEU 32:45"/></para>
<para style="p"><verse number="46" style="v" sid="DEU 32:46"/>तब तिनले तिनीहरूलाई भने, “मैले आजको दिन तिमीहरूलाई गम्भीर रूपले घोषणा गरेका यी सबै वचनहरू हृदयमा लिनू; ताकि तिमीहरूले आफ्ना छोराछोरीहरूलाई यस व्यवस्थाका सबै वचन होसियारीसाथ पालन गर्नलाई आज्ञा दिन सक।<verse eid="DEU 32:46"/></para>
<para style="p"><verse number="47" style="v" sid="DEU 32:47"/>यी तिमीहरूका निम्ति व्यर्थका वचनहरू होइनन्, तर यी तिमीहरूका जीवन हुन्। यीद्वारा नै तिमीहरूले यर्दन पार गरेर अधिकार गर्नलाई जान लागेको देशमा तिमीहरू धेरै वर्षसम्म जिउनेछौ।”<verse eid="DEU 32:47"/></para>
<para style="p"><verse number="48" style="v" sid="DEU 32:48"/>त्यही दिन याहवेहले मोशालाई भन्‍नुभयो,<verse eid="DEU 32:48"/></para>
<para style="p"><verse number="49" style="v" sid="DEU 32:49"/>यरीहोको पारिपट्टि मोआब देशमा भएको अबारीमको नेबो पर्वतमा उक्लेर जा, र मैले इस्राएलीहरूलाई तिनीहरूका आफ्नै अधिकारको रूपमा दिन लागेको कनान देशलाई हेर्।<verse eid="DEU 32:49"/></para>
<para style="p"><verse number="50" style="v" sid="DEU 32:50"/>तँ उक्लेको पर्वतमा तँ मर्नेछस्; र त्यहाँ तेरा मानिसहरूसँग तँ मिल्नेछस्, जसरी होर पर्वतमा तेरा दाजु हारून मरे, र आफ्ना मानिसहरूसँग मिलेका थिए।<verse eid="DEU 32:50"/></para>
<para style="p"><verse number="51" style="v" sid="DEU 32:51"/>किनभने तिमीहरू दुवैले जीनको उजाडस्थानमा भएको कादेश मेरीबाको पानीमा इस्राएलीहरूको उपस्थितिमा मप्रति विश्‍वासघात गरेका थियौ; तिमीहरूले इस्राएलीहरूको बीचमा मेरो पवित्रतालाई कायम राखेनौ।<verse eid="DEU 32:51"/></para>
<para style="p"><verse number="52" style="v" sid="DEU 32:52"/>यसकारण तैँले टाढैबाट मात्र त्यस देशलाई देख्नेछस्; मैले इस्राएलीहरूलाई दिने देशमा तँ पस्‍न पाउनेछैनस्।<verse eid="DEU 32:52"/></para>
<chapter eid="DEU 32"/>
<chapter number="33" style="c" sid="DEU 33"/>
<para style="p"><verse number="1" style="v" sid="DEU 33:1"/>परमेश्‍वरका जन मोशाले आफ्नो मृत्युभन्दा अगि इस्राएलीहरूलाई दिएका आशीर्वाद यही हो।<verse eid="DEU 33:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 33:2"/>तिनले भने: “याहवेह सीनै पर्वतबाट आउनुभयो, र तिनीहरूमाथि सेइरमा झुल्कनुभयो; उहाँ पारान पर्वतबाट चम्कनुभयो। उहाँको पर्वतको ओरालो, दक्षिणबाट दशौँ हजार पवित्र जनहरूसँग उहाँ आउनुभयो।<verse eid="DEU 33:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 33:3"/>निश्‍चय नै तपाईं, जसले मानिसहरूलाई प्रेम गर्नुहुन्छ; सबै पवित्र जनहरू तपाईंका हातमा छन्। तिनीहरू सबै तपाईंको पाउमा दण्डवत् गर्नेछन्; र तपाईंबाट नै अर्तीहरू प्राप्‍त गर्दछन्।<verse eid="DEU 33:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 33:4"/>याकोबका मानिसहरूका सम्पत्ति भनेको नै मोशाले हामीलाई दिएका व्यवस्थाहरू हुन्।<verse eid="DEU 33:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 33:5"/>उहाँ यशूरूनमाथि राजा हुनुहुन्थ्यो, जब इस्राएलका कुलहरूको साथमा मानिसहरूका अगुवाहरू भेला भएका थिए।<verse eid="DEU 33:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 33:6"/>“रूबेन बाँचिरहून्, र कहिल्यै नमरून्; न त त्यसका मानिसहरू थोरै होऊन्।”<verse eid="DEU 33:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 33:7"/>अनि यहूदाको बारेमा तिनले यो भने: “हे याहवेह यहूदाको पुकार सुन्‍नुहोस्; त्यसलाई आफ्ना मानिसहरूकहाँ ल्याउनुहोस्; त्यसले आफ्नै हातले आफ्नो रक्षा गर्छ। हे प्रभु, त्यसका शत्रुहरूको विरुद्धमा त्यसको सहायक हुनुहोस्!”<verse eid="DEU 33:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 33:8"/>लेवीको बारेमा तिनले भने: “तपाईंको तुम्मीम र ऊरीम तपाईंको विश्‍वासयोग्य सेवकका हुन्। तपाईंले त्यसलाई मस्साहमा जाँच्नुभयो; तपाईंले त्यससँग मेरीबाको पानीमा लड्नुभयो।<verse eid="DEU 33:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 33:9"/>त्यसले आफ्नो बुबा र आमालाई भन्यो, ‘म तिनीहरूको कुनै वास्ता गर्दिनँ।’ त्यसले आफ्ना दाजुभाइहरूलाई चिनेन, र आफ्नै छोराछोरीहरूलाई स्वीकार गरेन; तर त्यसले तपाईंको वचनमा ध्यान दियो, र तपाईंको करारको रक्षा गर्‍यो।<verse eid="DEU 33:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 33:10"/>त्यसले याकोबलाई तपाईंको विधि र इस्राएललाई तपाईंको व्यवस्था सिकाउँछ। त्यसले तपाईंको सामु धूप र तपाईंको वेदीमा सम्पूर्ण होमबलि चढाउँछ।<verse eid="DEU 33:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 33:11"/>हे याहवेह, त्यसका सबै धनसम्पत्तिहरूमा आशिष् दिनुहोस्, र त्यसका हातका परिश्रमहरूमा प्रसन्‍न हुनुहोस्। त्यसको विरुद्धमा उठ्ने शत्रुहरूलाई प्रहार गर्नुहोस्, र त्यसका शत्रुहरू फेरि कहिल्यै उठ्न नसकून्!”<verse eid="DEU 33:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 33:12"/>बेन्यामीनको बारेमा तिनले भने: “याहवेहको प्रिय उहाँमा सुरक्षित रहून्; किनकि त्यसको दिनभरिको ढाल उहाँ हुनुहुन्छ। अनि याहवेहले प्रेम गर्नुहुनेचाहिँ उहाँका काँधमा विश्राम लिन्छन्।”<verse eid="DEU 33:12"/></para>
<para style="p"><verse number="13" style="v" sid="DEU 33:13"/>योसेफको बारेमा तिनले भने: “याहवेहले त्यसको भूमिलाई माथि आकाशका बहुमूल्य शीत र तल रहेको गहिरो पानीले आशिष् दिनुहुन्छ;<verse eid="DEU 33:13"/></para>
<para style="p"><verse number="14" style="v" sid="DEU 33:14"/>सूर्यले ल्याउने उत्तम कुराहरूले, र चन्द्रमाबाट प्राप्‍त हुने अति असल कुराहरूले;<verse eid="DEU 33:14"/></para>
<para style="p"><verse number="15" style="v" sid="DEU 33:15"/>प्राचीन पहाडहरूका मूल्यवान् उपहारहरूले, अनि अनन्तका पर्वतहरूको फलदायक परिपूर्णताले;<verse eid="DEU 33:15"/></para>
<para style="p"><verse number="16" style="v" sid="DEU 33:16"/>पृथ्वीका सर्वोत्तम उपहारहरू र त्यसको प्रसस्ताले, अनि जल्दैगरेको पोथ्रामा बास गर्नुहुनेको कृपाले। यी सबै योसेफको शिरमाथि, तिनका दाजुभाइहरूमध्येका राजकुमारको निधारमा रहून्।<verse eid="DEU 33:16"/></para>
<para style="p"><verse number="17" style="v" sid="DEU 33:17"/>वैभवमा त्यो पहिले जन्मेको साँढेजस्तै छ; त्यसका सिङहरू जङ्गली गोरुका सिङहरूझैँ छन्। ती सिङहरूद्वारा त्यसले जातिहरूलाई हान्‍नेछ; पृथ्वीका अन्तिम भागसम्म रहेकाहरूलाई पनि, ती सिङहरू एफ्राइमका दश हजारजस्तै छन्; मनश्शेका हजारौँ-हजारझैँ छन्।”<verse eid="DEU 33:17"/></para>
<para style="p"><verse number="18" style="v" sid="DEU 33:18"/>जबूलूनको बारेमा तिनले भने: “जबूलून, तँ बाहिर जाँदा आनन्द गर्, अनि इस्साखार, तँ आफ्नो पालभित्र आनन्द गर्।<verse eid="DEU 33:18"/></para>
<para style="p"><verse number="19" style="v" sid="DEU 33:19"/>तिनीहरूले मानिसहरूलाई पर्वतमा बोलाउनेछन्। र त्यहाँ धार्मिकताका बलिदानहरू चढाउनेछन्। तिनीहरूले समुद्रका प्रचुरतामा र बालुवामा लुकेका गुप्‍त धनमा भोज गर्नेछन्।”<verse eid="DEU 33:19"/></para>
<para style="p"><verse number="20" style="v" sid="DEU 33:20"/>गादको बारेमा तिनले भने: “गादको राज्य विस्तार गर्ने जन धन्यको हो! गादचाहिँ पाखुरा वा शिर चिथोर्ने सिंहझैँ बस्छ।<verse eid="DEU 33:20"/></para>
<para style="p"><verse number="21" style="v" sid="DEU 33:21"/>त्यसले आफ्ना निम्ति सबैभन्दा असल ठाउँ छान्यो; अगुवाको भाग त्यसका निम्ति राखिएको थियो। जब मानिसहरूका मुख्य व्यक्तिहरू भेला भए, तब त्यसले याहवेहका धार्मिक इच्छा र इस्राएल सम्बन्धी उहाँका नीति-नियमहरू कार्यान्वयन गरायो।”<verse eid="DEU 33:21"/></para>
<para style="p"><verse number="22" style="v" sid="DEU 33:22"/>दानको बारेमा तिनले भने: “दान बाशानबाट उफ्रँदै आउने सिंहको डमरुजस्तै हो।”<verse eid="DEU 33:22"/></para>
<para style="p"><verse number="23" style="v" sid="DEU 33:23"/>नप्‍तालीको बारेमा तिनले भने: “नप्‍ताली याहवेहको कृपाको प्रशस्ततामा छ, र त्यो उहाँको आशिष्‌ले भरिपूर्ण छ। त्यसले गालील तालको दक्षिणतिरको भाग अधिकार गर्नेछ।”<verse eid="DEU 33:23"/></para>
<para style="p"><verse number="24" style="v" sid="DEU 33:24"/>आश्शेरको बारेमा तिनले भने: छोराहरूमध्ये सबैभन्दा आशिषित चाहिँ आशेर हो; त्यसका दाजुभाइहरूले त्यसमाथि कृपा देखाऊन्; र त्यसले आफ्ना पाउ जैतुनको तेलमा चोपोस्।<verse eid="DEU 33:24"/></para>
<para style="p"><verse number="25" style="v" sid="DEU 33:25"/>तेरा मूलढोकाका आग्लाहरू फलाम र काँसो होऊन्। अनि तेरो बलचाहिँ तेरा दिनहरू बराबर होस्।<verse eid="DEU 33:25"/></para>
<para style="p"><verse number="26" style="v" sid="DEU 33:26"/>यशूरूनका परमेश्‍वरसमान अरू कोही छैन; जो तँलाई सहायता गर्नलाई आकाशबाट आउनुहुन्छ। अनि आफ्नो महिमाको बादलमा सवार गर्नुहुन्छ।<verse eid="DEU 33:26"/></para>
<para style="p"><verse number="27" style="v" sid="DEU 33:27"/>अनन्तका परमेश्‍वर तेरो शरणस्थान हुनुहुन्छ, र तलतिर चाहिँ अनन्तका बाहुलीहरू तेरो सहारा छन्। उहाँले तेरा शत्रुहरूलाई तेरो सामुबाट धपाउनुहुनेछ। उहाँले भन्‍नुहुन्छ, “तिनीहरूलाई नष्‍ट पार्!”<verse eid="DEU 33:27"/></para>
<para style="p"><verse number="28" style="v" sid="DEU 33:28"/>यसकारण इस्राएल सुरक्षित रहनेछ; याकोबको मूल सुरक्षित रहनेछ; अन्‍न र नयाँ दाखमद्यको देशमा, आकाशबाट शीत झर्ने ठाउँमा।<verse eid="DEU 33:28"/></para>
<para style="p"><verse number="29" style="v" sid="DEU 33:29"/>हे इस्राएल, तँ धन्यको छस्! याहवेहद्वारा बचाइएको, तँजस्तो अरू जाति को छ र? “उहाँ तेरो ढाल र सहायक, अनि तेरा महिमित तरवार हुनुहुन्छ। तेरा शत्रुहरू तेरो सामु डराउनेछन्; अनि तैँले तिनीहरूका अल्गा स्थानहरू टेक्नेछस्।”<verse eid="DEU 33:29"/></para>
<chapter eid="DEU 33"/>
<chapter number="34" style="c" sid="DEU 34"/>
<para style="p"><verse number="1" style="v" sid="DEU 34:1"/>तब मोशा मोआबको मैदानबाट यरीहोको वारिपट्टि भएको नेबो पर्वतको पिसगाको टाकुरामा उक्ले। त्यहाँ याहवेहले तिनलाई सम्पूर्ण देश, अर्थात् गिलाददेखि दानसम्म,<verse eid="DEU 34:1"/></para>
<para style="p"><verse number="2" style="v" sid="DEU 34:2"/>नप्‍ताली, मनश्शे र एफ्राइमको समस्त प्रान्त, र पश्‍चिमी भूमध्य सागरसम्म यहूदाको सबै प्रदेश,<verse eid="DEU 34:2"/></para>
<para style="p"><verse number="3" style="v" sid="DEU 34:3"/>दक्षिणतिर र यरीहोको क्षेत्रदेखिको समस्त इलाका र सोअरसम्मका खजूरका सहरहरूसमेत देखाउनुभयो।<verse eid="DEU 34:3"/></para>
<para style="p"><verse number="4" style="v" sid="DEU 34:4"/>तब याहवेहले तिनलाई भन्‍नुभयो, “यही देश, तेरो भावी सन्तानलाई दिनेछु भनी मैले अब्राहाम, इसहाक र याकोबलाई शपथ खाएर प्रतिज्ञा गरेको थिएँ। मैले तँलाई आफ्नै आँखाले यो हेर्न दिएँ; तर तँ त्यहाँ पार गरेर जानेछैनस्।”<verse eid="DEU 34:4"/></para>
<para style="p"><verse number="5" style="v" sid="DEU 34:5"/>याहवेहको वचनअनुसार मोआबको त्यही देशमा याहवेहका सेवक मोशाको मृत्यु भयो।<verse eid="DEU 34:5"/></para>
<para style="p"><verse number="6" style="v" sid="DEU 34:6"/>याहवेहले तिनलाई बेथ-पोरको पारिपट्टिको क्षेत्रमा गाड्नुभयो; तर आजको दिनसम्म तिनको चिहान कहाँ छ भनी कसैले जान्दैनन्।<verse eid="DEU 34:6"/></para>
<para style="p"><verse number="7" style="v" sid="DEU 34:7"/>जब मोशाको मृत्यु भयो, तब तिनी एक सय बीस वर्ष पुगेका थिए। तर तिनको आँखाको ज्योति कमजोर भएको थिएन, न त तिनको बल नै घटेको थियो।<verse eid="DEU 34:7"/></para>
<para style="p"><verse number="8" style="v" sid="DEU 34:8"/>इस्राएलीहरूले मोशाको निम्ति मोआबको मैदानमा रुने र विलाप गर्ने समय अन्त्य नभएसम्म तीस दिनसम्म शोक गरे।<verse eid="DEU 34:8"/></para>
<para style="p"><verse number="9" style="v" sid="DEU 34:9"/>अब नूनका छोरा यहोशू बुद्धिका आत्माले भरिपूर्ण थिए। किनभने मोशाले तिनीमाथि आफ्ना हात राखेका थिए। यसकारण इस्राएलीहरूले यहोशूका कुरा सुने। अनि याहवेहले मोशालाई दिनुभएका आज्ञाहरू पालन गरे।<verse eid="DEU 34:9"/></para>
<para style="p"><verse number="10" style="v" sid="DEU 34:10"/>त्यस समयदेखि इस्राएलमा मोशाजस्तो अर्को कुनै अगमवक्ता खडा भएको छैन, जसलाई याहवेहले आमने-सामने गरी जान्‍नुहुन्थ्यो।<verse eid="DEU 34:10"/></para>
<para style="p"><verse number="11" style="v" sid="DEU 34:11"/>मोशा, जसलाई याहवेहले इजिप्टमा अर्थात् फारो र उनका सबै अधिकारीहरू र उनको समस्त देशमा अलौकिक चिन्हहरू र अद्‌भुत कार्यहरू देखाउनलाई पठाउनुभयो, र तिनले ती सबै गरे।<verse eid="DEU 34:11"/></para>
<para style="p"><verse number="12" style="v" sid="DEU 34:12"/>किनकि इस्राएलको दृष्‍टिमा मोशाले देखाएका महान् शक्ति र गरेका भयानक कामहरू कहिल्यै कसैले गर्न सकेका छैनन्।<verse eid="DEU 34:12"/></para>
<chapter eid="DEU 34"/>
</usx>