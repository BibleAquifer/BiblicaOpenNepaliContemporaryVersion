<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="1KI" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">1राजाहरू</para>
<para style="toc1">1राजाहरू</para>
<para style="toc2">1राजाहरू</para>
<para style="mt1">1राजाहरू</para>
<chapter number="1" style="c" sid="1KI 1"/>
<para style="p"><verse number="1" style="v" sid="1KI 1:1"/>अब राजा दावीद धेरै वृद्ध भइसकेका थिए। तिनलाई जति लुगा ओढाइदिए तापनि तिनलाई न्यानो हुँदैनथ्यो।<verse eid="1KI 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 1:2"/>यसकारण तिनका सल्‍लाहकारहरूले तिनलाई भने, “राजालाई रेखदेख गर्न र उहाँको स्याहार-सुसार गर्नलाई हामी एउटी कन्ये-केटी खोजौँ। त्यो हाम्रा मालिक महाराजासँग सुतोस् र हजुरलाई न्यानो पारोस्।”<verse eid="1KI 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 1:3"/>तब तिनीहरूले इस्राएलभरि एउटी सुन्दरी कन्ये-केटीको खोजी गरे। अनि शूनेमबाट अबीशगलाई भेट्टाए, र त्यसलाई राजाकहाँ ल्याए।<verse eid="1KI 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 1:4"/>ती केटी अति सुन्दरी थिइन्। तिनले राजाको स्याहार-सुसार र सेवा गरिन्। तर राजाले तिनीसँग सहबास गरेनन्।<verse eid="1KI 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 1:5"/>त्यो समयमा दावीदका छोरा अदोनियाह, जसकी आमा हग्गीत थिइन्, तिनले अगि सरेर भने, “म राजा हुनेछु।” यसकारण तिनले रथहरू, घोडचढीहरू र आफ्ना अगि-अगि दौडनलाई पचास मानिसहरू ठिक पारे।<verse eid="1KI 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 1:6"/>तिनका पिता दावीदले “तँ किन यस्तो व्यवहार गर्छस्?” भनेर कहिल्यै पनि तिनलाई हस्तक्षेप गरेनन्। तिनी पनि अति सुन्दर थिए, र अब्शालोमको ठिक पछि जन्मेका थिए।<verse eid="1KI 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 1:7"/>अदोनियाहले सरूयाहका छोरा योआब र पुजारी अबीयाथारलाई आफ्नो हातमा लिए। तिनीहरूले तिनलाई आफ्नो समर्थन दिए।<verse eid="1KI 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 1:8"/>तर पुजारी सादोक, यहोयादाका छोरा बनायाह, अगमवक्ता नातान, शिमी, रेई र दावीदका विशेष अङ्गरक्षकचाहिँ अदोनियाहसित सहमत भएनन्।<verse eid="1KI 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 1:9"/>तब अदोनियाहले एन-रोगेलको छेउमा भएको जोहेलेतको ढुङ्गामा भेडा, गाईबस्तु र पोसिएका बाछाहरू बलिदान गरे। तिनले राजाका छोराहरू, अर्थात् आफ्ना सबै दाजुभाइहरूलाई र यहूदाका सबै राजकीय अधिकारीहरूलाई निम्त्याए।<verse eid="1KI 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 1:10"/>तर तिनले अगमवक्ता नातान, बनायाह, विशेष अङ्गरक्षक, अथवा तिनका भाइ सोलोमनलाई चाहिँ निम्त्याएनन्।<verse eid="1KI 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 1:11"/>तब नातानले सोलोमनकी आमा बतशेबालाई सोधे, “के हग्गीतका छोरा अदोनियाह राजा भएको तिमीले सुनेकी छैनौ? यसको बारेमा तिम्रा स्वामी दावीदलाई थाहै छैन।<verse eid="1KI 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 1:12"/>अब तिमीले आफ्नो जीवन र तिम्रा छोरा सोलोमनको जीवन कसरी बचाउन सकिन्छ, सो म तिमीलाई सल्‍लाह दिनेछु।<verse eid="1KI 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 1:13"/>अब दावीद राजाकहाँ गएर तिनलाई यसो भन्‍नू, ‘मेरा स्वामी महाराजा, के तपाईंले म तपाईंकी सेविकालाई मपछि तिम्रो छोरा सोलोमन निश्‍चय नै राजा हुनेछ, र त्यो मेरो सिंहासनमा बस्‍नेछ भनेर शपथ खानुभएको थिएन र? त्यसो भए अहिले अदोनियाह नै किन राजा भए त?’<verse eid="1KI 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 1:14"/>तिमी राजासित कुरा गर्दैगर्दा म भित्र आउनेछु, र तिमीले भनेको कुरामा म समर्थन गरिदिनेछु।”<verse eid="1KI 1:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 1:15"/>यसकारण बतशेबा वृद्ध भएका राजालाई भेट्न भित्र तिनको कोठामा गइन्, जहाँ शूनम्मी अबीशगले तिनको स्याहार-सुसार गरिरहेकी थिइन्।<verse eid="1KI 1:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 1:16"/>तब बतशेबाले राजाको सामु निहुरेर दण्डवत् गरिन्। राजाले सोधे, “तिमी के चाहन्छ्यौ?”<verse eid="1KI 1:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 1:17"/>तिनले राजालाई भनिन्, “मेरा प्रभु, हजुर आफैँले म तपाईंकी सेविकालाई ‘तिम्रो छोरा सोलोमन मपछि राजा हुनेछ, र त्यो मेरो सिंहासनमा बस्‍नेछ’ भनी याहवेह तपाईंका परमेश्‍वरको नाममा शपथ खानुभएको थियो।<verse eid="1KI 1:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 1:18"/>तर अब अदोनियाह राजा भइसकेका छन् र हजुर मेरा प्रभु, महाराजालाई यो कुरा थाहै छैन।<verse eid="1KI 1:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 1:19"/>तिनले धेरै संख्यामा पशुहरू, पोसिएका बाछाहरू र भेडाहरू बलिदान गरेर राजाका छोराहरूलाई, पुजारी अबीयाथारलाई र तपाईंका फौजका सेनापति योआबलाई निम्तो दिएका छन्। तर तिनले हजुरको सेवक सोलोमनलाई निम्त्याएका छैनन्।<verse eid="1KI 1:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 1:20"/>मेरा स्वामी महाराजा, हजुरपछि सिंहासनमा को बस्‍ने हो, सो जान्‍नलाई सारा इस्राएलले तपाईंतिर हेरिरहेका छन्।<verse eid="1KI 1:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 1:21"/>नत्रता मेरा स्वामी महाराजा आफ्ना पुर्खाहरूसित विश्राममा प्रवेश गर्नसाथ, म र मेरो छोरो सोलोमन अपराधीहरूझैँ गनिनेछौँ।”<verse eid="1KI 1:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 1:22"/>तिनी राजासित कुरा गर्दैगर्दा अगमवक्ता नातान आइपुगे।<verse eid="1KI 1:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 1:23"/>अनि तिनीहरूले राजालाई “अगमवक्ता नातान यहाँ हुनुहुन्छ” भनिदिए। यसकारण तिनी राजाको सामु गए; अनि भुइँतिर निहुरेर दण्डवत् गरे।<verse eid="1KI 1:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 1:24"/>नातानले भने, “के मेरा मालिक महाराजाले तपाईंपछि अदोनियाह राजा हुनेछन् र तिनी तपाईंको सिंहासनमा बस्‍नेछन् भनी घोषणा गर्नुभएको हो?<verse eid="1KI 1:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 1:25"/>आज तल गएर तिनले धेरै संख्यामा पशुहरू, पोसिएका बाछाहरू र भेडाहरू बलिदान गरेका छन्। तिनले राजाका सबै छोराहरू, फौजका सेनापतिहरू र पुजारी अबीयाथारलाई पनि निम्त्याएका छन्। ठिक यसै बेला तिनीहरू उनीसित खाँदै, पिउँदै यसो भनिरहेका छन्, ‘राजा अदोनियाह अमर रहून्!’<verse eid="1KI 1:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 1:26"/>तर तिनले म तपाईंको सेवकलाई र पुजारी सादोकलाई अनि यहोयादाका छोरा बनायाहलाई र तपाईंको सेवक सोलोमनलाई निम्त्याएनन्।<verse eid="1KI 1:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 1:27"/>मेरा मालिक महाराजापछि उहाँको सिंहासनमा को बस्‍ने हो, भन्‍ने कुरा आफ्ना सेवकहरूलाई नबताई, के राजाले नै यसो गर्नुभएको हो?”<verse eid="1KI 1:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 1:28"/>तब राजा दावीदले भने, “बतशेबालाई भित्र बोलाऊ।” यसकारण तिनी राजाको उपस्थितिमा आएर तिनको सामु उभिइन्।<verse eid="1KI 1:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 1:29"/>तब राजाले शपथ खाए: “मलाई प्रत्येक सङ्कष्‍टबाट छुटाउनुहुने जीवित याहवेहलाई साक्षी राखेर म भन्दछु,<verse eid="1KI 1:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 1:30"/>याहवेह इस्राएलका परमेश्‍वरको नाममा मैले तिमीसँग शपथ खाएको कुरा आज अवश्य म पालन गर्नेछु। तिम्रो छोरा सोलोमन नै मपछि राजा हुनेछ; अनि ऊ नै मेरो सट्टामा मेरो सिंहासनमा बस्‍नेछ।”<verse eid="1KI 1:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 1:31"/>तब बतशेबाले भुइँतिर निहुरेर राजाको सामु दण्डवत् गर्दै भनिन्, “मेरा प्रभु, महाराजा दावीद सदासर्वदा अमर रहून्!”<verse eid="1KI 1:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 1:32"/>दावीद राजाले भने, “पुजारी सादोक, नातान अगमवक्ता र यहोयादाका छोरा बनायाहलाई भित्र बोलाऊ।” जब तिनीहरू राजाको सामु आए,<verse eid="1KI 1:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 1:33"/>राजाले तिनीहरूलाई भने, “आफ्ना मालिकका सेवकहरूलाई आफूसित लैजाओ, र मेरो छोरा सोलोमनलाई मेरो आफ्नै खच्‍चरमा चढाएर तल गीहोनमा लैजाओ।<verse eid="1KI 1:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 1:34"/>त्यहाँ पुजारी सादोक र अगमवक्ता नातानले त्यसलाई इस्राएलमाथि राजा अभिषेक गरून्। तब तुरही फुक र ‘सोलोमन राजा अमर रहून्!’ भनेर कराओ।<verse eid="1KI 1:34"/></para>
<para style="p"><verse number="35" style="v" sid="1KI 1:35"/>तब तिमीहरू उसित जाओ, र ऊ आएर मेरो सिंहासनमाथि बसोस्। अनि मेरो ठाउँमा शासन गरोस्। मैले त्यसलाई इस्राएल र यहूदामाथि शासन गर्न नियुक्त गरेको छु।”<verse eid="1KI 1:35"/></para>
<para style="p"><verse number="36" style="v" sid="1KI 1:36"/>यहोयादाका छोरा बनायाहले राजालाई जवाफ दिए, “आमेन! याहवेह मेरा मालिक महाराजाका परमेश्‍वरले पनि यसरी नै घोषणा गरून्।<verse eid="1KI 1:36"/></para>
<para style="p"><verse number="37" style="v" sid="1KI 1:37"/>जसरी याहवेह मेरा मालिक महाराजासित हुनुहुन्थ्यो, उहाँ सोलोमनको साथमा पनि होऊन् र तिनको सिंहासन मेरा मालिक महाराजा दावीदको भन्दा पनि महान् बनाऊन्!”<verse eid="1KI 1:37"/></para>
<para style="p"><verse number="38" style="v" sid="1KI 1:38"/>यसकारण पुजारी सादोक, अगमवक्ता नातान यहोयादाका छोरा बनायाह, करेतीहरू र पेलेथीहरू तल झरे। तब सोलोमनलाई राजा दावीदको खच्‍चरमाथि चढाएर तिनलाई गीहोनसम्म सुरक्षापूर्वक लगे।<verse eid="1KI 1:38"/></para>
<para style="p"><verse number="39" style="v" sid="1KI 1:39"/>पुजारी सादोकले पवित्र पालबाट तेलको सिङ लिए। अनि सोलोमनलाई अभिषेक गरे। तब तिनीहरूले तुरही फुके, र सबै मानिसहरूले “राजा सोलोमन अमर रहून्!” भनेर कराए।<verse eid="1KI 1:39"/></para>
<para style="p"><verse number="40" style="v" sid="1KI 1:40"/>तब सबै मानिसहरू सोलोमनको पछि-पछि बाँसुरीहरू बजाउँदै गए, र आनन्दको आवाज यति ठूलो थियो, कि त्यस आवाजको कारण जमिन पनि थर्कियो।<verse eid="1KI 1:40"/></para>
<para style="p"><verse number="41" style="v" sid="1KI 1:41"/>अदोनियाह र तिनका सबै पाहुनाहरू भोज खाइसक्‍न लागेका थिए, तब अदोनियाह र तिनीसित भएका सबै पाहुनाहरूले त्यो आवाज सुने। तुरहीको आवाज सुनेर योआबले भने, “सहरमा भएको यो खैलाबैलाको अर्थ के हो?”<verse eid="1KI 1:41"/></para>
<para style="p"><verse number="42" style="v" sid="1KI 1:42"/>तिनी बोलिरहेकै बेला अबीयाथार पुजारीका छोरा जोनाथन आइपुगे। अदोनियाहले भने, “भित्र आऊ। तिमीजस्तो योग्य मानिसले असल खबर नै ल्याएको हुनुपर्छ।”<verse eid="1KI 1:42"/></para>
<para style="p"><verse number="43" style="v" sid="1KI 1:43"/>जोनाथनले अदोनियाहलाई जवाफ दिए, “अहँ, पटक्‍कै होइन! हाम्रा मालिक राजा दावीदले सोलोमनलाई राजा बनाउनुभएको छ।<verse eid="1KI 1:43"/></para>
<para style="p"><verse number="44" style="v" sid="1KI 1:44"/>अनि राजाले तिनीसित पुजारी सादोक, अगमवक्ता नातान, यहोयादाका छोरा बनायाह, करेती र पेलेथीहरूलाई पठाउनुभएको छ। अनि तिनीहरूले उनलाई राजाको खच्‍चरमा चढाएका छन्।<verse eid="1KI 1:44"/></para>
<para style="p"><verse number="45" style="v" sid="1KI 1:45"/>पुजारी सादोक र अगमवक्ता नातानले तिनलाई गीहोनमा राजा अभिषेक गरेका छन्। त्यहाँबाट तिनीहरू आनन्द मनाउँदै उकालो गएका छन्; र सहर पनि त्यससितै गुञ्जायमान भएको छ। तपाईंले सुन्‍नुभएको हल्‍ला यही हो।<verse eid="1KI 1:45"/></para>
<para style="p"><verse number="46" style="v" sid="1KI 1:46"/>त्यति मात्र होइन, सोलोमनले आफ्नो आसन राज सिंहासनमाथि जमाएका छन्।<verse eid="1KI 1:46"/></para>
<para style="p"><verse number="47" style="v" sid="1KI 1:47"/>राजकीय अधिकृतहरू पनि ‘तपाईंका परमेश्‍वरले सोलोमनको नाम तपाईंको नामभन्दा महान् बनाऊन्। उहाँको सिंहासन तपाईंको भन्दा महान् बनाऊन्’ भन्दै मालिक महाराजा दावीदलाई बधाई दिन आएका छन्! अनि आफ्नो पलङमा आराधनाकासाथ निहुरेर राजाले भने,<verse eid="1KI 1:47"/></para>
<para style="p"><verse number="48" style="v" sid="1KI 1:48"/>‘याहवेह इस्राएलका परमेश्‍वरलाई प्रशंसा होस्, जसले आज मेरो सिंहासनमा एक जना उत्तराधिकारीलाई मेरो आँखाले देख्न दिनुभएको छ।’ ”<verse eid="1KI 1:48"/></para>
<para style="p"><verse number="49" style="v" sid="1KI 1:49"/>यसमा अदोनियाहका सबै पाहुनाहरू आत्तिएर उठे, र यताउता लागे।<verse eid="1KI 1:49"/></para>
<para style="p"><verse number="50" style="v" sid="1KI 1:50"/>तर अदोनियाहले चाहिँ सोलोमनको डरले गएर वेदीका सिङहरू पक्रे।<verse eid="1KI 1:50"/></para>
<para style="p"><verse number="51" style="v" sid="1KI 1:51"/>तब सोलोमनलाई यसो भनियो, “अदोनियाह राजा सोलोमनसित डराएर वेदीका सिङहरू समातेर बसिरहेका छन्। तिनी भन्छन्, ‘राजा सोलोमनले उहाँको सेवकलाई तरवारले मार्नुहुनेछैन भनी मसित शपथ खाऊन्।’ ”<verse eid="1KI 1:51"/></para>
<para style="p"><verse number="52" style="v" sid="1KI 1:52"/>सोलोमनले जवाफ दिए, “यदि तिनले आफूलाई योग्य मानिसझैँ देखाउँछन् भने तिनको टाउकाको एउटै केश पनि भुइँमा खस्‍नेछैन; तर तिनमा दुष्‍टता पाइयो भने तिनी मर्नेछन्।”<verse eid="1KI 1:52"/></para>
<para style="p"><verse number="53" style="v" sid="1KI 1:53"/>तब राजा सोलोमनले मानिसहरू पठाए; अनि तिनीहरूले तिनलाई वेदीबाट तल ल्याए। अदोनियाहले आएर राजा सोलोमनलाई दण्डवत् गरे, र सोलोमनले तिनलाई भने, “आफ्नो घरमा जाऊ!”<verse eid="1KI 1:53"/></para>
<chapter eid="1KI 1"/>
<chapter number="2" style="c" sid="1KI 2"/>
<para style="p"><verse number="1" style="v" sid="1KI 2:1"/>दावीदको मृत्युको समय नजिक आयो, तब तिनले आफ्ना छोरा सोलोमनलाई यो आदेश दिए।<verse eid="1KI 2:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 2:2"/>तिनले यसो भने, “म संसारको नियमअनुसार जान लागिरहेको छु। यसकारण तँ बलियो हुनू, र आफैँलाई पुरुषार्थी बनाउनू।<verse eid="1KI 2:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 2:3"/>याहवेह तेरा परमेश्‍वरले चाहनुभएका सबै कुरा पालन गर्नू: उहाँमा आज्ञाकारी हुनू, र मोशाको व्यवस्थामा लेखिएझैँ, उहाँका सबै उर्दीहरू र आदेशहरू, उहाँका नियमहरू अनि विधिहरू पालन गर्नू; ताकि तैँले जे गर्छस्, र तँ जहाँ जान्छस्, त्यहाँ तेरो उन्‍नति होस्।<verse eid="1KI 2:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 2:4"/>तब याहवेहले ‘तेरा सन्तानहरू होसियारीसाथ हिँडे भने र मेरो सामु आफ्ना सारा हृदय र प्राणले विश्‍वासयोग्य भएर हिँडे भने तँलाई इस्राएलको सिंहासनमाथि बस्‍ने मानिसको अभाव हुनेछैन’ भनी मसित गर्नुभएको प्रतिज्ञा उहाँले पूरा गर्नुहुनेछ।<verse eid="1KI 2:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 2:5"/>“सरूयाहका छोरा योआबले मलाई र इस्राएलका दुई सेनापति नेरका छोरा अबनेर र येतेरका छोरा अमासालाई के गर्‍यो, त्यो तँलाई थाहै छ। त्यसले लडाइँको समयमा जस्तै गरेर, शान्तिकै समयमा तिनीहरूको रगत बगाएर तिनीहरूलाई मार्‍यो अनि त्यो रगतले आफ्नो कम्मरपेटी र खुट्टाका जुत्ता रङ्गायो।<verse eid="1KI 2:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 2:6"/>त्यससित आफ्नो बुद्धिअनुसार व्यवहार गर्नू, तर त्यसको फुलेको कपाल शान्तिसित चिहानमा नजाओस्।<verse eid="1KI 2:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 2:7"/>“तर गिलादमा हुने बर्जिल्‍लैका छोराहरूप्रति दया देखाउनू र तिनीहरू तँसित तेरो टेबुलमा खानेहरूमध्येकै होऊन्। तेरा दाजु अब्शालोम मदेखि भागेर जाँदा तिनीहरू मेरो पक्षमा थिए।<verse eid="1KI 2:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 2:8"/>“यो याद राख्नू, म महनाइममा गएको दिन बहूरीमको बेन्यामीनी गेराको छोरा शिमीले मलाई सराप्नुसम्म सरापेको थियो। जब त्यो मलाई यर्दनमा भेट्न आयो, तब मैले त्यससित याहवेहको नाममा ‘म तँलाई तरवारले मार्नेछैनँ’ भनी शपथ खाएँ।<verse eid="1KI 2:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 2:9"/>तर अब त्यसलाई निर्दोष नठान्‍नू। तँ बुद्धिमान् मानिस होस्। त्यसलाई के गर्नुपर्छ, सो तैँले जान्‍नेछस्। त्यसको शिर रगतसितै चिहानमा जाओस्।”<verse eid="1KI 2:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 2:10"/>तब दावीद आफ्ना पुर्खाहरूसित विश्राममा सुते, र दावीदको सहरमा गाडिए।<verse eid="1KI 2:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 2:11"/>तिनले इस्राएलमाथि चालीस वर्षसम्म राज्य गरे—सात वर्ष हेब्रोनमा र तेत्तीस वर्ष यरूशलेममा।<verse eid="1KI 2:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 2:12"/>यसरी सोलोमन आफ्ना पिता दावीदको सिंहासनमा बसे, र तिनको शासन दृढतापूर्वक स्थापित भयो।<verse eid="1KI 2:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 2:13"/>एक दिन हग्गीतको छोरा अदोनियाह सोलोमनकी आमा बतशेबाकहाँ गए। बतशेबाले तिनलाई सोधिन्, “के तिमी शान्तिपूर्वक आएका हौ?” तिनले जवाफ दिए, “हजुर, शान्तिपूर्वक आएको हुँ।”<verse eid="1KI 2:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 2:14"/>तब तिनले अझ भने, “मैले तपाईंसित केही कुरा भन्‍नु छ।” तिनले जवाफ दिइन्, “अँ, भन!”<verse eid="1KI 2:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 2:15"/>तिनले भने, “यो राज्य मेरो थियो भनी तपाईं जान्‍नुहुन्छ। सारा इस्राएलले मलाई आफ्नो राजाको रूपमा हेरेका थिए। तर कुरा बदलियो र राज्य मेरो भाइ सोलोमनको हातमा गयो। किनकि यो त याहवेहबाटै तिनीकहाँ आएको हो।<verse eid="1KI 2:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 2:16"/>अब मैले तपाईंसित एउटा बिन्ती गर्दछु, मलाई अस्वीकार नगर्नुहोला।” तिनले भनिन्, “अँ, भन न।”<verse eid="1KI 2:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 2:17"/>यसकारण तिनले भन्‍न थाले, “तपाईं शूनम्मी अबीशगलाई मेरी पत्नी हुनलाई मलाई दिइयोस् भनी राजा सोलोमनलाई भनिदिनुहोस्। किनकि उनले तपाईंलाई इन्कार गर्न सक्दैनन्।”<verse eid="1KI 2:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 2:18"/>बतशेबाले जवाफ दिइन्, “हुन्छ, म तिम्रा निम्ति राजासित कुरा गर्नेछु।”<verse eid="1KI 2:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 2:19"/>जब तिनी अदोनियाहको निम्ति राजा सोलोमनसित कुरा गर्न गइन्, तब राजा तिनलाई भेट्न उठे। अनि तिनलाई दण्डवत् गरे, र सिंहासनमा बसे। तिनले राजाकी आमाका निम्ति एउटा सिंहासन ल्याउन लगाए, अनि बतशेबा तिनको दाहिने हातपट्टि बसिन्।<verse eid="1KI 2:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 2:20"/>तब तिनले भनिन्, “म तिमीसित एउटा सानो बिन्ती गर्दछु, मलाई इन्कार नगरिदेऊ!” राजाले जवाफ दिए, “भन्‍नुहोस्, मेरी आमा! म तपाईंलाई इन्कार गर्नेछैनँ।”<verse eid="1KI 2:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 2:21"/>यसकारण तिनले भनिन्, “शूनम्मी अबीशगलाई तिम्रा दाजु अदोनियाहसित विवाह हुन देऊ।”<verse eid="1KI 2:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 2:22"/>तब राजा सोलोमनले आफ्नी आमालाई जवाफ दिए, “तपाईंले शूनम्मी अबीशगलाई अदोनियाहको निम्ति किन बिन्ती गर्नुहुन्छ? तपाईंले तिनका लागि राज्य पनि माग्न सक्नुहुन्छ। किनकि जे भए तापनि तिनी मेरो ठूलो दाजु हुन्। तिनका निम्ति अनि पुजारी अबीयाथार र सरूयाहका छोरा योआबका निम्ति पनि माग्न सक्नुहुन्छ!”<verse eid="1KI 2:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 2:23"/>तब राजा सोलोमनले याहवेहको नाममा यसरी शपथ खाए: “यस बिन्तीको निम्ति अदोनियाहले आफ्नो प्राण गुमाएनन् भने परमेश्‍वरले मसित कठोर व्यवहार गरून्!<verse eid="1KI 2:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 2:24"/>यसकारण अब म शपथ खान्छु, जसले मलाई आफ्ना पिता दावीदको सिंहासनमा दृढतासाथ स्थापित गर्नुभयो र आफूले प्रतिज्ञा गर्नुभएझैँ, मेरा निम्ति एउटा वंश स्थापित गर्नुहुने जीवित याहवेहलाई साक्षी राखेर म भन्दछु, अदोनियाह आजै मारिनेछ!”<verse eid="1KI 2:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 2:25"/>यसकारण राजा सोलोमनले यहोयादाका छोरा बनायाहलाई हुकुम दिए। अनि तिनले अदोनियाहलाई प्रहार गरे, र तिनको मृत्यु भयो।<verse eid="1KI 2:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 2:26"/>तब पुजारी अबीयाथारलाई राजाले भने, “तपाईं आफ्नो खेत अनातोतमा फर्केर जानुहोस्। तपाईं मारिने योग्यका हुनुहुन्छ; तर म अहिले तपाईंलाई मार्दिनँ। किनकि तपाईंले मेरा पिता दावीदको सामु सर्वशक्तिमान् याहवेहको सन्दुक बोक्नुभएको थियो। मेरा पिताका सबै सङ्कष्‍टमा साथ दिनुभएको थियो।”<verse eid="1KI 2:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 2:27"/>यसकारण सोलोमनले अबीयाथारलाई याहवेहको पुजारी पदबाट हटाइदिए। यसरी याहवेहले शीलोमा एलीको घरानाको विषयमा भन्‍नुभएको कुरा पूरा गरे।<verse eid="1KI 2:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 2:28"/>जब यो खबर योआबकहाँ पुग्यो, जसले पहिले अब्शालोमसित त होइन, तर अदोनियाहसित मिलेर षड्यन्त्र गरेका थिए। तब योआब याहवेहको पालमा भागेर गए; अनि वेदीका सिङहरू समाते।<verse eid="1KI 2:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 2:29"/>योआब पालमा भागेर गई वेदीको छेउमा बसेको कुरा राजा सोलोमनलाई बताइयो। तब सोलोमनले यहोयादाका छोरा बनायाहलाई “जाऊ गएर तिनलाई मार” भनेर आज्ञा दिए।<verse eid="1KI 2:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 2:30"/>यसकारण बनायाहले याहवेहको पालमा गएर योआबलाई भने, “राजा भन्‍नुहुन्छ, ‘बाहिर आऊ!’ ” तर तिनले जवाफ दिए, “होइन, म यहीँ मर्नेछु।” बनायाहले राजालाई योआबले भनेका कुरा भनिदिए।<verse eid="1KI 2:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 2:31"/>तब राजाले बनायाहलाई हुकुम दिए, “तिनले भनेझैँ गर। तिनलाई मारेर गाडिदेऊ, र म र मेरा पिताका घरानालाई योआबले बगाएको निर्दोष रगतको दोषबाट शुद्ध गरिदेऊ।<verse eid="1KI 2:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 2:32"/>याहवेहले तिनले बगाएको रगतको साटो फेर्नुहुनेछ। किनकि मेरा पिता दावीदको जानकारीविना नै तिनले दुई जना मानिसहरूमाथि आक्रमण गरेर तिनीहरूलाई तरवारले मारे। ती दुवैलाई अर्थात् इस्राएलको फौजका सेनापति नेरका छोरा अबनेर अनि येतेरका छोरा, यहूदाको फौजका सेनापति अमासा, जो तिनीभन्दा असल र सोझा मानिसहरू थिए।<verse eid="1KI 2:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 2:33"/>तिनीहरूको रगतको दोष सदाका निम्ति योआब र त्यसका सन्ततिमाथि रहोस्। तर दावीद र तिनका सन्तति, तिनका घराना र तिनको सिंहासनमाथि चाहिँ सदाको निम्ति याहवेहको शान्ति होइरहोस्।”<verse eid="1KI 2:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 2:34"/>यसकारण यहोयादाका छोरा बनायाह माथि गए, र योआबलाई प्रहार गरेर मारे। अनि तिनलाई मरुभूमिमा तिनकै जमिनमा गाडिदिए।<verse eid="1KI 2:34"/></para>
<para style="p"><verse number="35" style="v" sid="1KI 2:35"/>राजाले योआबको ठाउँमा यहोयादाका छोरा बनायाहलाई आफ्नो फौजको जिम्मा सुम्पिदिए। अनि अबीयाथारको स्थानमा पुजारी सादोकलाई राखिदिए।<verse eid="1KI 2:35"/></para>
<para style="p"><verse number="36" style="v" sid="1KI 2:36"/>त्यसपछि राजाले शिमीलाई बोलाए, र तिनलाई भने, “आफ्ना लागि यरूशलेममा घर बनाऊ, र त्यहीँ बस, अरू कुनै ठाउँमा नजानू।<verse eid="1KI 2:36"/></para>
<para style="p"><verse number="37" style="v" sid="1KI 2:37"/>किद्रोनको बेँसी पार गरेको दिन तिमी अवश्य मर्नेछौ। तिम्रो रगत तिम्रै शिरमाथि पर्नेछ।”<verse eid="1KI 2:37"/></para>
<para style="p"><verse number="38" style="v" sid="1KI 2:38"/>शिमीले राजालाई जवाफ दिए, “तपाईंले भन्‍नुभएको कुरा असल हो। हजुरको सेवकले मेरा मालिक राजाले भन्‍नुभएझैँ गर्नेछ।” अनि शिमी धेरै समयसम्म यरूशलेममा बसे।<verse eid="1KI 2:38"/></para>
<para style="p"><verse number="39" style="v" sid="1KI 2:39"/>तर तीन वर्षपछि शिमीका दुई जना दासहरू गातका राजा माकाको छोरा आकीशकहाँ भागेर गए। शिमीलाई यसो भनियो, “तपाईंका दासहरू गातमा छन्।”<verse eid="1KI 2:39"/></para>
<para style="p"><verse number="40" style="v" sid="1KI 2:40"/>यो सुनेर तिनी आफ्नो गधामा काठी कसेर आफ्ना दासहरूलाई खोज्न आकीशकहाँ गातमा गए। यसरी शिमीले आफ्ना दासहरूलाई गातबाट फर्काइल्याए।<verse eid="1KI 2:40"/></para>
<para style="p"><verse number="41" style="v" sid="1KI 2:41"/>जब सोलोमनलाई शिमी यरूशलेमबाट गातमा गएर फर्केको कुरा बताइयो,<verse eid="1KI 2:41"/></para>
<para style="p"><verse number="42" style="v" sid="1KI 2:42"/>तब राजाले शिमीलाई बोलाउन पठाए, र तिनलाई भने, “के मैले तिमीलाई याहवेहको नाममा शपथ खान लगाएर ‘तिमी आफ्नो ठाउँ छोडेर अरू ठाउँमा गएको दिन निश्‍चय नै मर्नेछौ’ भनेर चेतावनी दिएको थिइनँ? त्यस बेला तिमीले ‘तपाईंले भन्‍नुभएको कुरा असल हो। म यसलाई पालन गर्नेछु’ भनेर मलाई भन्यौ।<verse eid="1KI 2:42"/></para>
<para style="p"><verse number="43" style="v" sid="1KI 2:43"/>तर अहिले किन तिमीले याहवेहसितको तिम्रो शपथ पालन गरेनौ र मैले तिमीलाई दिएको हुकुम सुनेनौ?”<verse eid="1KI 2:43"/></para>
<para style="p"><verse number="44" style="v" sid="1KI 2:44"/>राजाले शिमीलाई यो पनि भने, “तिमीले मेरा पिता दावीदप्रति गरेका सबै कुकर्महरू तिमीलाई थाहै छ। अब याहवेहले तिम्रा सबै कुकर्महरूको साटो लिनुहुनेछ।<verse eid="1KI 2:44"/></para>
<para style="p"><verse number="45" style="v" sid="1KI 2:45"/>तर राजा सोलोमनले भने आशिष् पाउनेछन्, र दावीदको सिंहासन याहवेहको सामु सदा सुरक्षित रहनेछ।”<verse eid="1KI 2:45"/></para>
<para style="p"><verse number="46" style="v" sid="1KI 2:46"/>तब राजाले यहोयादाका छोरा बनायाहलाई हुकुम दिए। अनि तिनले शिमीलाई प्रहार गरेर मारे। यसरी राज्य सोलोमनको हातमा स्थापित भयो।<verse eid="1KI 2:46"/></para>
<chapter eid="1KI 2"/>
<chapter number="3" style="c" sid="1KI 3"/>
<para style="p"><verse number="1" style="v" sid="1KI 3:1"/>सोलोमनले इजिप्टका राजा फारोसित मित्रता बाँधे र तिनकी छोरीलाई विवाह गरे। तिनले आफ्नो महल, याहवेहको भवन र यरूशलेमका चारैतिरका पर्खाल बनाई नसकेसम्म तिनलाई दावीदको सहरमा नै राखे।<verse eid="1KI 3:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 3:2"/>अझै पनि मानिसहरूले अल्गा देवस्थानहरूमा बलिदान चढाइरहेका थिए। किनकि त्यति बेलासम्म याहवेहको नामको निम्ति मन्दिर निर्माण गरिएको थिएन।<verse eid="1KI 3:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 3:3"/>सोलोमनले आफ्ना पिता दावीदले दिएका निर्देशनअनुसार हिँडेर याहवेहप्रति आफ्नो प्रेम देखाए। तर तिनले अल्गा देवस्थानहरूमा बलिदान चढाउन र धूप बाल्न भने छोडेनन्।<verse eid="1KI 3:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 3:4"/>राजा बलिदान चढाउनलाई गिबोनमा गए। किनकि त्यो सबैभन्दा महत्वपूर्ण अल्गो देवस्थान थियो। सोलोमनले त्यस वेदीमाथि एक हजार होमबलि चढाए।<verse eid="1KI 3:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 3:5"/>गिबोनमा याहवेह राति सपनामा सोलोमनकहाँ देखा पर्नुभयो, र परमेश्‍वरले भन्‍नुभयो, “तँलाई जे इच्छा लाग्छ माग्, म तँलाई दिनेछु।”<verse eid="1KI 3:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 3:6"/>सोलोमनले जवाफ दिए, “तपाईंले आफ्नो सेवक, मेरा पिता दावीदमाथि ठूलो दया देखाउनुभएको छ। किनकि उहाँ तपाईंप्रति विश्‍वासयोग्य, धर्मी र हृदयमा सोझो हुनुहुन्थ्यो। तपाईंले आजको दिन उहाँको सिंहासनमा बस्‍नलाई उहाँलाई एउटा छोरा दिनुभएर तपाईंले उहाँप्रतिको यो ठूलो दया कायम राख्नुभएको छ।<verse eid="1KI 3:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 3:7"/>“अब हे याहवेह मेरा परमेश्‍वर, तपाईंले मेरा पिता दावीदको ठाउँमा आफ्नो सेवकलाई राजा बनाउनुभएको छ। तर म त एउटा सानो बालक मात्र हुँ। अनि आफ्नो कर्तव्य कसरी पालन गर्ने, त्यो पनि जान्दिनँ।<verse eid="1KI 3:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 3:8"/>यहाँ म तपाईंका आफ्नै चुनिएका मानिसहरूको बीचमा छु। यो यस्तो एउटा विशाल जाति हो, जो असंख्य छन्, तिनीहरूलाई गणना गर्न सकिँदैन।<verse eid="1KI 3:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 3:9"/>यसकारण तपाईंको सेवकलाई ठिक र बेठीक छुट्याउन सक्ने तपाईंको जातिलाई सही शासन गर्ने समझदार हृदय दिनुहोस्। किनकि कसले तपाईंको यो महान् जातिलाई शासन गर्न सक्छ र?”<verse eid="1KI 3:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 3:10"/>सोलोमनले यो कुरा मागेकोमा प्रभु तिनीसँग प्रसन्‍न हुनुभयो।<verse eid="1KI 3:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 3:11"/>यसकारण परमेश्‍वरले भन्‍नुभयो, “तैँले आफ्नो लागि जीवन, धन वा आफ्ना शत्रुहरूको मृत्यु मागिनस्, तर न्याय प्रशासनमा ठिक र बेठीक छुट्याउने हृदय मागिस्।<verse eid="1KI 3:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 3:12"/>तैँले मागेको कुरा म पूरा गर्नेछु। म तँलाई बुद्धि र ठिक र बेठीक छुट्याउने हृदय दिनेछु, ताकि तेरो अगि न कोही थिए; न त तेरो पछि कहिल्यै तेरो बराबरी अरू कोही हुनेछ।<verse eid="1KI 3:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 3:13"/>यसबाहेक तैँले नमागेको कुरा पनि म तँलाई दिनेछु, अर्थात् धन र सम्मान दुवै दिनेछु। यसरी तेरो जीवनकालमा तेरो बराबरीका राजा कोही पनि हुनेछैन।<verse eid="1KI 3:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 3:14"/>यदि तँ मेरा मार्गहरूमा हिँडिस् र तेरा पिताले झैँ मेरा उर्दीहरू र आज्ञाहरू पालन गरिस् भने म तँलाई दीर्घायु तुल्याउनेछु।”<verse eid="1KI 3:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 3:15"/>तब सोलोमन बिउँझेँ; अनि यो त सपना रहेछ भनी थाहा पाए। तिनी यरूशलेममा फर्के, र प्रभुको करारको सन्दुकको सामु खडा भए। अनि होमबलि र मेलबलि चढाए। त्यसपछि तिनले आफ्ना सबै भारदारहरूलाई भोज खुवाए।<verse eid="1KI 3:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 3:16"/>एक दिन दुई जना वेश्याहरू आएर राजाको सामु उभिए।<verse eid="1KI 3:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 3:17"/>तीमध्ये एक जनाले भनी, “मेरा मालिक, यो स्त्री र म एउटै घरमा बस्छौँ। यो मसित हुँदै मैले एउटा शिशुलाई जन्म दिएँ।<verse eid="1KI 3:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 3:18"/>मेरो शिशु जन्मेको तीन दिनपछि यस स्त्रीले पनि एउटा शिशुलाई जन्माई। हामी दुई मात्रै थियौँ; घरमा हामी दुईबाहेक अरू कोही पनि थिएन।<verse eid="1KI 3:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 3:19"/>“राति सुतेको बेला त्यस स्त्रीले आफ्नो छोरालाई थिचिछ, र त्यो मरेछ।<verse eid="1KI 3:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 3:20"/>यसकारण यो आधा रातमा उठी, र म निदाइरहेकी बेलामा मेरो छेउबाट मेरो छोरालाई लगेर आफ्नो छातीमा राखिछ। अनि आफ्नो मरेको छोरालाई मेरो छातीमा राखिदिइछ।<verse eid="1KI 3:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 3:21"/>भोलिपल्ट बिहानै जब म आफ्नो छोरालाई दूध खुवाउन उठेँ, तब मैले त्यसलाई मरेको भेट्टाएँ! तर जब मैले त्यसलाई बिहान उज्यालोमा नियालेर हेरेँ, तब त्यो त मैले जन्माएको मेरो छोरो होइन रहेछ!”<verse eid="1KI 3:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 3:22"/>तब अर्की स्त्रीले भनी, “होइन, त्यो जिउँदोचाहिँ मेरो हो, मरेकोचाहिँ तेरो हो।” तर पहिलेकीले ढिपी गरी, “होइन, मरेकोचाहिँ तेरो छोरा हो; अनि जिउँदोचाहिँ मेरो छोरा हो।” अनि यसरी ती दुईले राजाको सामु बहस गरे।<verse eid="1KI 3:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 3:23"/>तब राजाले भने, “एउटीले भन्छे, ‘यो जिउँदोचाहिँ मेरो छोरा हो, तर मरेको छोराचाहिँ तेरो हो।’ अनि अर्कीले फेरि भन्छे, ‘होइन, मरेको छोरा तेरो हो, तर जिउँदोचाहिँ मेरो छोरा हो।’ ”<verse eid="1KI 3:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 3:24"/>तब राजाले भने, “मलाई एउटा तरवार ल्याइदेओ।” यसकारण तिनीहरूले राजाका निम्ति एउटा तरवार ल्याइदिए।<verse eid="1KI 3:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 3:25"/>तिनले हुकुम गरे: “त्यस जिउँदो बालकलाई काटेर दुई टुक्रा पार, र आधा एउटीलाई र आधा अर्कीलाई देओ।”<verse eid="1KI 3:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 3:26"/>जसको छोरा जिउँदो थियो, त्यो आफ्नो छोराको निम्ति मायाले भरिएर राजालाई भनी, “हे मेरा मालिक, दया गरी त्यस जिउँदो बालक त्यसलाई नै दिनुहोस्! त्यसलाई नमार्नुहोस्!” तर अर्कीचाहिँले यसो भनी, “यो बालक न त मेरो, न त तेरो नै होस्। त्यसलाई दुई टुक्रा पारिदिनुहोस्।”<verse eid="1KI 3:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 3:27"/>तब राजाले आफ्नो निर्णय सुनाए, “यो बालक पहिलो स्त्रीलाई देओ। यसलाई नमार! यस बालककी आमा त्यही हो।”<verse eid="1KI 3:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 3:28"/>जब सारा इस्राएलले राजाले गरेको यस्तो फैसला सुने, तब तिनीहरूको हृदयमा राजाप्रति श्रद्धाको भावना जाग्यो। किनकि तिनमा न्याय गर्नका लागि परमेश्‍वरको बुद्धि रहेछ भनी तिनीहरूले देखे।<verse eid="1KI 3:28"/></para>
<chapter eid="1KI 3"/>
<chapter number="4" style="c" sid="1KI 4"/>
<para style="p"><verse number="1" style="v" sid="1KI 4:1"/>यसरी सोलोमन राजाले इस्राएलभरि शासन गरे।<verse eid="1KI 4:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 4:2"/>तिनका प्रमुख अधिकारीहरू यिनै थिए: सादोकका छोरा अजर्याह, जो पुजारी थिए;<verse eid="1KI 4:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 4:3"/>शीशाका छोराहरू एलीहोरेफ र अहीयाह, जो सचिवहरू थिए; अहीलूदका छोरा यहोशापात, जो लेखापाल थिए।<verse eid="1KI 4:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 4:4"/>यहोयादाका छोरा बनायाह, जो मुख्य सेनापति थिए; सादोक र अबीयाथार, जो पुजारी थिए।<verse eid="1KI 4:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 4:5"/>नातानका छोरा अजर्याह, जो राज्यपालहरूका अधिकारी थिए; नातानका छोरा याबूद, जो पुजारी र राजाका निजी सल्‍लाहकार थिए।<verse eid="1KI 4:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 4:6"/>अहीशार, जो दरबारका प्रशासक थिए; अब्दाका छोरा अदोनीराम, जो ज्यालाविना काम गर्नेहरूलाई खटाउनेका प्रमुख थिए।<verse eid="1KI 4:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 4:7"/>इस्राएलभरि सोलोमनका बाह्र जना जिल्‍ला राज्यपालहरू थिए, जसले राजा र राजकीय घरानाका निम्ति सामान जुटाउँथे। प्रत्येकले वर्षमा एक-एक महिनाको खानेकुरा जुटाउनुपर्थ्यो।<verse eid="1KI 4:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 4:8"/>तिनीहरूका नाम यिनै हुन्: एफ्राइमको पहाडी मुलुकमा बेन-हूर,<verse eid="1KI 4:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 4:9"/>माकाज, शाल्बीम, बेथ-शेमेश र एलोन-बेथहानानमा, बेन-देकेर।<verse eid="1KI 4:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 4:10"/>अरूब्बोतमा, बन-हेसेद (तिनको जिम्मामा सोकोह र हेपेरका सबै ठाउँ पर्दथे);<verse eid="1KI 4:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 4:11"/>नापोत-डोरमा, बेन-अबीनादाब (तिनको विवाह सोलोमनकी छोरी तापतसित भएको थियो);<verse eid="1KI 4:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 4:12"/>तानाक, मगिद्दो र यिजरेलको मन्दिरको सार्तानको छेउमा भएको बेथ-शान, अर्थात् बेथ-शानदेखि अबेल-महोला र योक्मामसम्म सम्पूर्ण इलाकाको निम्ति अहीलूदका छोरा बाना;<verse eid="1KI 4:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 4:13"/>रामोत-गिलादमा, बेन-गेबेर (गिलादमा मनश्शेको छोरा याईरका सबै इलाका साथसाथै बाशानको अर्गोब जिल्‍ला र त्यसका पर्खाल भएका अनि काँसोका मूलढोका भएका साठी वटा सहरहरू तिनको अधीनमा थिए);<verse eid="1KI 4:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 4:14"/>महनाइममा इद्दोका छोरा अहीनादाब;<verse eid="1KI 4:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 4:15"/>नप्‍तालीमा, अहीमास (तिनले सोलोमनकी छोरी बासमतलाई विवाह गरेका थिए);<verse eid="1KI 4:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 4:16"/>आशेर र बालोतमा, हूशैका छोरा बाना;<verse eid="1KI 4:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 4:17"/>इस्साखारमा, परूवाका छोरा यहोशापात;<verse eid="1KI 4:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 4:18"/>बेन्यामीनमा, एलाका छोरा शिमी;<verse eid="1KI 4:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 4:19"/>गिलादमा, ऊरीका छोरा गेबेर (एमोरीहरूका राजा सीहोनको देश अनि बाशानका राजा ओगको देश)। जिल्‍लामा तिनी एउटै मात्र राज्यपाल थिए।<verse eid="1KI 4:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 4:20"/>यहूदा र इस्राएलका मानिसहरू समुद्रका किनारका बालुवासरह असंख्य थिए। तिनीहरू खान्थे, पिउँथे र तिनीहरू खुशी थिए।<verse eid="1KI 4:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 4:21"/>सोलोमनले यूफ्रेटिस नदीदेखि पलिश्तीहरूको देशका साथसाथै इजिप्टको सिमानासम्म सबै राज्यमा शासन गर्थे। यी देशहरूले राजकर ल्याउँथे। तिनीहरू सोलोमनको जीवनकालभरि तिनका अधीनमा रहे।<verse eid="1KI 4:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 4:22"/>सोलोमनका दैनिक चाहिने सामान तीस कोर्स मसिनो पिठो र साठी कोर्स अन्‍न,<verse eid="1KI 4:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 4:23"/>दश वटा पालेका गोरुहरू, बीस वटा चरनमा पालिएका गोरुहरू, र एक सय वटा भेडाबाख्राका साथमा मृग, चित्तल, जरायो र पालेका पक्षीहरू थिए।<verse eid="1KI 4:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 4:24"/>किनकि तिनले नदीको पश्‍चिमपट्टिका सबै राज्यहरू, अर्थात् तिप्सादेखि गाजासम्म राज्य गर्थे। तिनको चारैतिर शान्ति थियो।<verse eid="1KI 4:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 4:25"/>सोलोमनको जीवनकालभरि दानदेखि बेर्शेबासम्म यहूदा र इस्राएलमा प्रत्येक मानिस आफ्नै दाख र नेभाराको रूखमुनि सुरक्षित थिए।<verse eid="1KI 4:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 4:26"/>सोलोमनका रथ घोडाहरू र तिनका बाह्र हजार घोडाहरूका निम्ति चार हजार तबेलाहरू थिए।<verse eid="1KI 4:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 4:27"/>प्रत्येक महिना जिल्‍ला राज्यपालहरूले आफ्नो पालोमा सोलोमन राजा र तिनका मेचमा खानेहरूका निम्ति आवश्यक सामान जुटाउँथे। तिनीहरूले कुनै कुराको अभाव हुन दिँदैन थिए।<verse eid="1KI 4:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 4:28"/>तिनीहरूले रथका घोडाहरू र अरू घोडाहरूका निम्ति आवश्यकता अनुसारको जौ र पराल ल्याउँथे।<verse eid="1KI 4:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 4:29"/>परमेश्‍वरले सोलोमनलाई बुद्धि र अति महान् अन्तर्दृष्‍टि अनि समुद्रको किनारमा भएको बालुवासरह नाप्‍न नसकिने समझशक्ति दिनुभयो।<verse eid="1KI 4:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 4:30"/>सोलोमनको बुद्धि पूर्वका सारा मानिसहरू र इजिप्टका सम्पूर्ण जनहरूको बुद्धिभन्दा महान् थियो।<verse eid="1KI 4:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 4:31"/>तिनी एज्री एतान र माहोलका छोराहरू हेमान, कलकोल, दर्दा र सबै मानिसहरूभन्दा बढी बुद्धिमान् थिए। तिनको ख्याति चारैतिरका राष्ट्रहरूमा फिँजियो।<verse eid="1KI 4:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 4:32"/>तिनले तीन हजार हितोपदेशहरू बोले, र तिनले एक हजार पाँच वटा गीतहरू लेखे।<verse eid="1KI 4:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 4:33"/>तिनले लेबनानका देवदारुदेखि लिएर पर्खालबाहिर उम्रने हिसपसम्मका सबै वृक्षहरूको बारेमा वर्णन गरे। तिनले पशुहरू, चराहरू, घस्रने जन्तु र माछाहरूको विषयमा पनि बताए।<verse eid="1KI 4:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 4:34"/>सोलोमनको बुद्धिका कुरा सुन्‍न भनेर हरेक देशका राजाहरूले आफ्ना राजदूतहरूलाई पठाउँथे।<verse eid="1KI 4:34"/></para>
<chapter eid="1KI 4"/>
<chapter number="5" style="c" sid="1KI 5"/>
<para style="p"><verse number="1" style="v" sid="1KI 5:1"/>जब सोलोमनलाई आफ्ना पिता दावीदको उत्तराधिकारीको रूपमा राजा अभिषेक गरिएको कुरा टायरका राजा हीरामले सुने, तब तिनले सोलोमनकहाँ आफ्ना दूतहरू पठाए। किनकि तिनी सधैँ दावीदसँग मित्रतामा थिए।<verse eid="1KI 5:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 5:2"/>सोलोमनले हीरामलाई यो सन्देश पठाए:<verse eid="1KI 5:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 5:3"/>“मेरा पिता दावीदको विरुद्धमा चारैतिरबाट युद्ध भएको कारण, याहवेह आफ्ना परमेश्‍वरको नामका निम्ति उहाँले एउटा मन्दिर बनाउन सक्नुभएन भन्‍ने कुरा त तपाईंलाई थाहै छ। किनकि याहवेहले उहाँका शत्रुहरूलाई आफ्नो अधीनमा नपारेसम्म उहाँले त्यो बनाउन सक्नुभएन।<verse eid="1KI 5:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 5:4"/>तर अब याहवेह मेरा परमेश्‍वरले मलाई चारैतिरबाट विश्राम दिनुभएको छ। अनि कतै पनि विरोधी अथवा विपत्ति छैन।<verse eid="1KI 5:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 5:5"/>यसकारण याहवेह मेरा परमेश्‍वरले मेरा पिता दावीदलाई ‘मैले तेरो ठाउँमा, तेरो सिंहासनमा राखेको तेरो छोराले मेरो नामको निम्ति मन्दिर बनाउनेछ’ भन्‍नुभएअनुसार मैले उहाँको निम्ति एउटा मन्दिर बनाउने विचार गरेको छु।<verse eid="1KI 5:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 5:6"/>“यसकारण मेरा लागि लेबनानका देवदारुको काठ काट्नको निम्ति हुकुम गर्नुहोस्। मेरा मानिसहरूले तपाईंसित काम गर्नेछन्। अनि म तपाईंका मानिसहरूलाई तपाईंले तोक्नुभएको ज्याला दिनेछु। सीदोनीहरूजस्ता रूख ढाल्ने सिपालु मानिस हामीसित छैनन् भनी तपाईंलाई थाहै छ।”<verse eid="1KI 5:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 5:7"/>जब हीरामले सोलोमनको सन्देश सुने, तब तिनी अति प्रसन्‍न भएर भने, “आज याहवेहको प्रशंसा होस्; किनकि उहाँले यो महान् जातिमाथि शासन गर्न दावीदलाई एउटा बुद्धिमान् छोरा दिनुभएको छ।”<verse eid="1KI 5:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 5:8"/>यसकारण हीरामले सोलोमनकहाँ यो खबर पठाए: “तपाईंले पठाउनुभएको समाचार मैले पाएँ। अनि देवदारु र सल्‍लाका काठ दिने विषयमा म तपाईंले भन्‍नुभएझैँ सबै कुरा गर्नेछु।<verse eid="1KI 5:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 5:9"/>मेरा मानिसहरूले ती लेबनानबाट समुद्रमा खसाइदिनेछन्। अनि तिनीहरूलाई बाँधेर समुद्रमा तपाईंले भन्‍नुभएको ठाउँसम्म म बगाइदिनेछु। त्यहाँ म तिनीहरूलाई अलग गरिदिनेछु; र तपाईंले ती लान सक्नुहुन्छ। तपाईंले चाहिँ मेरो राजकीय घरानाको निम्ति भोजनको जिम्मा लिइदिनुहोस्।”<verse eid="1KI 5:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 5:10"/>यस किसिमले हीरामले सोलोमनलाई तिनलाई चाहिएका सबै देवदारु र सल्‍लाका काठहरू दिइरहे।<verse eid="1KI 5:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 5:11"/>सोलोमनले हीरामलाई तिनको घरानाको भोजनका निम्ति बीस हजार कोर्स गहुँको साथमा बीस हजार बाथ जैतुनको पेलिएको तेल दिए। सोलोमनले हीरामका निम्ति वर्षेनी यसो गरिरहे।<verse eid="1KI 5:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 5:12"/>याहवेहले सोलोमनलाई आफूले प्रतिज्ञा गर्नुभएझैँ बुद्धि दिनुभयो। हीराम र सोलोमनको बीचमा शान्तिपूर्ण सम्बन्ध थियो, अनि दुवैले आपसमा सन्धि गरे।<verse eid="1KI 5:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 5:13"/>राजा सोलोमनले सारा इस्राएलबाट तीस हजार मानिसहरूलाई मजदुरी गर्न लगाए।<verse eid="1KI 5:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 5:14"/>राजाले हरेक महिना तिनीहरूलाई दश-दश हजार गरेर पालैपालो एक महिनाको लागि लेबनानमा पठाउँथे। यसरी तिनीहरू एक महिना लेबनानमा काम गर्थे; र दुई महिना आफ्नै घरमा बस्दथे। अनि अदोनीराम बेतलबी श्रमिकहरूको जिम्मावाल थिए।<verse eid="1KI 5:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 5:15"/>सोलोमनका भारी बोक्ने भरियाहरू पहाडमा सत्तरी हजार र ढुङ्गा काट्नेहरू असी हजार थिए।<verse eid="1KI 5:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 5:16"/>साथसाथै सोलोमनले तेत्तीस सय मानिसहरूलाई मजदुरहरूका कामको रेखदेख गर्नलाई खटाए।<verse eid="1KI 5:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 5:17"/>राजाको आज्ञाअनुसार तिनीहरूले मन्दिरको जगको निम्ति कुँदिएका असल र ठूला ढुङ्गाहरू खानीबाट निकाले।<verse eid="1KI 5:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 5:18"/>सोलोमन र हीरामका कारिगरहरू र गेबालका मानिसहरूले मन्दिर निर्माणका निम्ति काठ र ढुङ्गाहरू तयार पारे।<verse eid="1KI 5:18"/></para>
<chapter eid="1KI 5"/>
<chapter number="6" style="c" sid="1KI 6"/>
<para style="p"><verse number="1" style="v" sid="1KI 6:1"/>सोलोमनले इस्राएलमाथि शासन गरेको चौथो वर्षको दोस्रो महिना, अर्थात् जीव नामक दोस्रो महिनामा तिनले याहवेहको मन्दिर निर्माण गर्न सुरु गरे। यो कार्य इस्राएलीहरू इजिप्टबाट निस्किआएको चार सय असी वर्षमा भएको थियो।<verse eid="1KI 6:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 6:2"/>याहवेहको निम्ति राजा सोलोमनले बनाएको मन्दिर साठी क्यूबिट लामो, बीस क्यूबिट चौडा र तीस क्यूबिट अग्लो थियो।<verse eid="1KI 6:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 6:3"/>मन्दिरको सामुको मुख्य कोठाको दलान मन्दिरको चौडाइ बराबरको, लगभग बीस क्यूबिट थियो अनि मन्दिरको अगाडिबाट दश क्यूबिट बाहिर निस्केको थियो।<verse eid="1KI 6:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 6:4"/>तिनले मन्दिरका भित्ताहरूमा आँखीझ्यालहरू बनाए।<verse eid="1KI 6:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 6:5"/>तिनले भवनको मुख्य कोठा र भित्री पवित्रस्थानको भित्तामा जोडिने गरी भवनको वरिपरि एउटा संरचना बनाए। जसका छेउ-छेउमा कोठाहरू थिए।<verse eid="1KI 6:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 6:6"/>यो भवन तीन तले थियो। सबैभन्दा तल्‍लो तला पाँच क्यूबिट चौडा, बीचको तला छ क्यूबिट चौडा, र तेस्रो तला सात क्यूबिट चौडा थियो। मन्दिरका भित्ताहरूमा केही पनि छेड्न नपरोस् भनेर तिनले मन्दिरको बाहिर चारैतिर पालीहरू बनाए।<verse eid="1KI 6:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 6:7"/>मन्दिर बनाउँदा खानीमा कुँदिएका ठूला ढुङ्गाहरू प्रयोग गरिए। मन्दिर बनिँदै गर्दा त्यस ठाउँमा कुनै घन, छिनो अथवा कुनै फलामको औजारको आवाज सुनिएन।<verse eid="1KI 6:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 6:8"/>भुइँतलाको प्रवेशद्वार मन्दिरको दक्षिणतिर थियो। त्यसबाट बीचको तलामा र त्यहाँबाट तेस्रो तलामा जानलाई घुमेको भर्‍याङ बनाइएको थियो।<verse eid="1KI 6:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 6:9"/>यसरी तिनले मन्दिर बनाएर सिद्ध्याए। अनि त्यसमा देवदारुका दलिन र फल्याकहरूबाट छानो बनाए।<verse eid="1KI 6:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 6:10"/>तिनले मन्दिरको वरिपरि कोठाहरू बनाए। प्रत्येकको उचाइ पाँच क्यूबिट थियो, र तिनीहरू देवदारुका काठले मन्दिरसित जोडिएका थिए।<verse eid="1KI 6:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 6:11"/>त्यसपछि याहवेहको वचन सोलोमनकहाँ आयो:<verse eid="1KI 6:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 6:12"/>“तैँले बनाइरहेको यस भवनको विषयमा चाहिँ यसो हुनेछ, यदि तैँले मेरा आदेशहरूअनुसार मेरा आज्ञाहरू र नियमहरू पालन गरिस् अनि आज्ञाकारी भइस् भने म तेरा पिता दावीदलाई गरेको प्रतिज्ञा तँद्वारा पूरा गर्नेछु।<verse eid="1KI 6:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 6:13"/>अनि म इस्राएलीहरूका बीचमा बास गर्नेछु र आफ्नो जाति इस्राएललाई त्याग्नेछैनँ।”<verse eid="1KI 6:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 6:14"/>अब यसरी सोलोमनले मन्दिर बनाएर सिद्ध्याए।<verse eid="1KI 6:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 6:15"/>तिनले त्यसका भित्री भित्ताहरूमा भुइँदेखि छानासम्मै देवदारुका काठहरू लगाए। मन्दिरको भुइँचाहिँ सल्‍लाका फल्याकहरूले ढाकिदिए।<verse eid="1KI 6:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 6:16"/>तिनले भवनको पछिल्‍लो भागपट्टि बीस क्यूबिट छुट्याएर भुइँदेखि छानासम्मै देवदारुका फल्याकहरूले बारे। अनि त्यस भवनको भित्रपट्टि भित्री पवित्रस्थान, लगभग महा-पवित्रस्थान बनाए।<verse eid="1KI 6:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 6:17"/>त्यस कोठाको सामुको मुख्य कोठा चालीस क्यूबिट लामो थियो।<verse eid="1KI 6:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 6:18"/>मन्दिरको भित्री भागचाहिँ देवदारुको काठमा बेलबुट्टा र फक्रेका फूलका आकारहरू कुँदेर बनाइएका थिए। सबै कुरामा देवदारु नै थिए; कुनैमा पनि ढुङ्गा देखिँदैनथ्यो।<verse eid="1KI 6:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 6:19"/>तिनले याहवेहको करारको सन्दुक राख्नको निम्ति मन्दिर भित्रपट्टि पवित्रस्थान तयार पारे।<verse eid="1KI 6:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 6:20"/>त्यो भित्री पवित्रस्थान बीस क्यूबिट लम्बाइ, बीस क्यूबिट चौडाइ, र बीस क्यूबिट उचाइ भएको थियो। तिनले भित्री भागलाई सुनले मोहोरे, र देवदारुको वेदीलाई पनि सुनले मोहोरे।<verse eid="1KI 6:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 6:21"/>सोलोमनले मन्दिरको भित्री भागलाई निखुर सुनले ढाकिदिए। अनि सुनले मोहोरेको भित्री पवित्रस्थानको अगाडि सुनका सिक्रीहरू टाँगे।<verse eid="1KI 6:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 6:22"/>यसरी तिनले सम्पूर्ण भित्री भागलाई सुनले मोहोरे। तिनले भित्री पवित्रस्थानको वेदीलाई पनि सुनले मोहोरे।<verse eid="1KI 6:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 6:23"/>तिनले भित्री पवित्रस्थानमा जैतुनको काठका दश क्यूबिट अग्ला दुई वटा करूबहरू बनाए।<verse eid="1KI 6:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 6:24"/>पहिलो करूबको पहिलो पखेटा पाँच क्यूबिट लामो र अर्को पखेटा पनि पाँचै क्यूबिट लामो थियो, अर्थात् एउटा पखेटाको टुप्पादेखि अर्को पखेटाको टुप्पासम्म दश क्यूबिट थियो।<verse eid="1KI 6:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 6:25"/>दोस्रो करूबको नाप पनि दश क्यूबिट नै थियो। किनकि दुवै करूबहरूको नाप र आकार उस्तै थियो।<verse eid="1KI 6:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 6:26"/>प्रत्येक करूबको उचाइ दश क्यूबिट थियो।<verse eid="1KI 6:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 6:27"/>तिनले करूबहरूलाई मन्दिरको सबैभन्दा भित्री कोठामा तिनीहरूका पखेटा फैलिएको अवस्थामा राखिदिए। एउटा करूबको पखेटाले एउटा भित्तालाई छोएको थियो भने अर्कोको पखेटाले अर्को भित्तालाई छोएको थियो। अनि तिनीहरूका पखेटाहरूले कोठाको बीचमा एक-अर्कालाई छोएका थिए।<verse eid="1KI 6:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 6:28"/>तिनले करूबहरूलाई सुनले मोहोरे।<verse eid="1KI 6:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 6:29"/>मन्दिरका भित्री र बाहिरी कोठाहरूका चारैतिरका भित्ताहरूमा तिनले करूबहरू, खजूरका रूखहरू र फक्रेका फूलहरूका बुट्टाहरू खोपे।<verse eid="1KI 6:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 6:30"/>तिनले मन्दिरका भित्री र बाहिरी कोठाहरूका भुइँलाई सुनले ढाकिदिए।<verse eid="1KI 6:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 6:31"/>भित्री पवित्रस्थानका प्रवेशद्वारका निम्ति तिनले पाँचकुने खापा भएका जैतुनको काठका दुई ढोकाहरू बनाए।<verse eid="1KI 6:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 6:32"/>अनि जैतुनको काठका दुई ढोकाहरूमा करूबहरू र खजूरका रूखहरू अनि फक्रेका फूलहरूका बुट्टाहरू खोपे। अनि करूबहरू र खजूरका रूखहरूलाई सुन पिटेर मोहोरे।<verse eid="1KI 6:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 6:33"/>त्यही प्रकारले तिनले मुख्य कोठाको प्रवेशद्वारका निम्ति जैतुनको काठका चारकुने चौखट बनाए।<verse eid="1KI 6:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 6:34"/>तिनले सल्‍लाको काठबाट दुई वटा ढोकाहरू बनाए; प्रत्येक ढोकामा दुई-दुई वटा खापा थिए। अनि ढोका खोल्दा ती खापाहरू एक-अर्कामा खप्टिन्थे।<verse eid="1KI 6:34"/></para>
<para style="p"><verse number="35" style="v" sid="1KI 6:35"/>तिनले तिनीहरूमाथि करूबहरू, खजूरका रूखहरू र फक्रेका फूलहरूका बुट्टाहरू खोपे। अनि ती बुट्टाहरूमाथि एकैनासले सुन पिटेर मोहोरे।<verse eid="1KI 6:35"/></para>
<para style="p"><verse number="36" style="v" sid="1KI 6:36"/>तिनले काटेका ढुङ्गाका तीन लहर र छाँटेका देवदारुका काठका एक लहरबाट भित्री चोक बनाए।<verse eid="1KI 6:36"/></para>
<para style="p"><verse number="37" style="v" sid="1KI 6:37"/>याहवेहको भवनको जग चौथो वर्षको जीव महिनामा बसालियो।<verse eid="1KI 6:37"/></para>
<para style="p"><verse number="38" style="v" sid="1KI 6:38"/>एघारौँ वर्षको आठौँ महिना, अर्थात् बूल महिनामा त्यसको हरेक भाग त्यसकै नमुनाअनुसार मन्दिर बनाइसिद्ध्याइयो। यसरी त्यस भवनलाई बनाउन तिनलाई सात वर्ष लाग्यो।<verse eid="1KI 6:38"/></para>
<chapter eid="1KI 6"/>
<chapter number="7" style="c" sid="1KI 7"/>
<para style="p"><verse number="1" style="v" sid="1KI 7:1"/>सोलोमनले आफ्नो निम्ति महल निर्माण गरे। यो निर्माण गर्न तेह्र वर्ष लाग्यो।<verse eid="1KI 7:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 7:2"/>तिनले जङ्गलको लेबनानको काठले एक सय क्यूबिट लामो, पचास क्यूबिट चौडा र तीस क्यूबिट अग्लो राजमहल बनाए; जसमा देवदारुका दलिनलाई थाम्ने देवदारुकै चार लहर खम्बाहरू थिए।<verse eid="1KI 7:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 7:3"/>खम्बाहरूमा अडिएका दलिनहरूमाथि देवदारुको छाना लगाइयो, र एक लहरमा पन्ध्र वटा गरी जम्मा पैँतालीस वटा दलिनहरू थिए।<verse eid="1KI 7:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 7:4"/>त्यसका झ्यालहरू एक-अर्कापट्टि फर्किएका तीन पङ्‌क्तिमा अग्लो गरी बनाइएका थिए।<verse eid="1KI 7:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 7:5"/>सबै ढोकाहरूका चौकसहरू चारकुने थिए। तिनीहरू तीन लहरमा अगाडिपट्टि एक-अर्कातिर फर्किएका थिए।<verse eid="1KI 7:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 7:6"/>तिनले पचास क्यूबिट लामो र तीस क्यूबिट चौडा भएको खम्बाहरूको एउटा दलान बनाए। त्यसको अगिल्तिर एउटा दलान थियो। त्यसको अर्कोतर्फ खम्बाहरू र तिनीहरूलाई ढाक्ने एउटा छाना थियो।<verse eid="1KI 7:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 7:7"/>त्यसपछि तिनले सिंहासनका निम्ति एउटा ठूलो कोठा, अर्थात् न्याय गर्ने कोठा बनाए; जहाँ तिनले न्याय गर्थे। तिनले त्यसलाई भुइँदेखि छानासम्म देवदारुका फल्याकहरूले छोपिदिए।<verse eid="1KI 7:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 7:8"/>अनि त्यस भवनको पछिल्तिर तिनले आफू बस्‍नको लागि महल बनाए, जुन राजमहल त्यही ढाँचाको थियो। सोलोमनले आफूले विवाह गरेकी फारोकी छोरीका निम्ति पनि त्यस्तै ठूलो राजमहल बनाइदिए।<verse eid="1KI 7:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 7:9"/>बाहिरदेखि ठूलो चोकसम्म र जगदेखि छतसम्म यी सबै बनोटहरू भित्र र बाहिरपट्टि आराले काटिएका, ठिक नापमा काटिएका बहुमूल्य पत्थरले बनिएका थिए।<verse eid="1KI 7:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 7:10"/>ती भवनका जगहरू कुनै दश क्यूबिट अनि कुनै आठ क्यूबिट नापका ठूला र उच्‍च गुणस्तरका ढुङ्गाहरूद्वारा बनाइएका थिए।<verse eid="1KI 7:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 7:11"/>त्यसमाथि ठिक नापमा काटिएका उच्‍च स्तरका ढुङ्गाहरू र देवदारुका दलिनहरू थिए।<verse eid="1KI 7:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 7:12"/>ठूलो चोकलाई काटिएका तीन लहर ढुङ्गाहरू र एक लहर देवदारुका खम्बाका पर्खालले घेरिएको थियो। याहवेहको भवनको भित्री चोक र त्यसको दलान पनि त्यस्तै थिए।<verse eid="1KI 7:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 7:13"/>राजा सोलोमनले टायरबाट हूरामलाई बोलाउन पठाए।<verse eid="1KI 7:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 7:14"/>तिनकी आमा नप्‍ताली कुलकी एउटी विधवा थिइन्। अनि बुबाचाहिँ टायरमा बस्‍ने काँसोका सिपालु कारिगर थिए। हूराम काँसको सबै कार्यमा अति सिपालु र अनुभवी थिए। तिनले राजा सोलोमनकहाँ आएर तिनलाई सुम्पिएका सबै कामहरू गरे।<verse eid="1KI 7:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 7:15"/>तिनले अठार क्यूबिट अग्ला र बाह्र क्यूबिट गोलाइ भएका दुई वटा काँसका खम्बाहरू बनाए।<verse eid="1KI 7:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 7:16"/>तिनले ती खम्बाहरूका टुप्पामा राख्न काँसोले ढालेका दुई वटा स्तम्भ-शिरहरू बनाए। प्रत्येक स्तम्भ-शिर पाँच क्यूबिट अग्लो थियो।<verse eid="1KI 7:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 7:17"/>प्रत्येक स्तम्भ-शिरमा सात वटा र खम्बाहरूका टुप्पामा सात वटा साङ्लाका जाली सजाइएको थियो।<verse eid="1KI 7:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 7:18"/>तिनले खम्बाहरूका टुप्पामा भएका स्तम्भ-शिरहरूलाई सजाउने प्रत्येक जालीको चारैपट्टि दुई लहरमा दारिमहरू बनाए।<verse eid="1KI 7:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 7:19"/>दलानभित्र खम्बाहरूका टुप्पामा भएका स्तम्भ-शिरहरू लिली फूलका आकारमा थिए, जसको उचाइ चार क्यूबिट थियो।<verse eid="1KI 7:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 7:20"/>जालीको छेउको कचौरा आकारको भागको मास्तिर भएका दुवै खम्बाहरूका शिरमा चारैपट्टिका लहरमा दुई सय दारिमहरू थिए।<verse eid="1KI 7:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 7:21"/>तिनले यी खम्बाहरू मन्दिरको दलानको अगाडि खडा गरे। दक्षिणपट्टिका खम्बाहरूलाई तिनले याकीन भनी नाम राखे; अनि उत्तरपट्टिकालाई बोअज नाम राखे।<verse eid="1KI 7:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 7:22"/>टुप्पामा भएका स्तम्भ-शिरहरू लिली फूलको आकारका थिए। यसरी खम्बाहरूको काम सिद्धाइयो।<verse eid="1KI 7:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 7:23"/>तिनले ढालेको धातुको एउटा गोलाकार खड्कुँलो एक छेउदेखि अर्को छेउ दश क्यूबिट र पाँच क्यूबिट अग्लो बनाए। त्यसको चारैतिरको नाप तीस क्यूबिट थियो।<verse eid="1KI 7:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 7:24"/>किनारको मुन्तिर प्रत्येक क्यूबिटमा दश वटा गरी लौका आकारहरूका घेरा थिए। ती आकारहरू खड्कुँलोसितै जोडिएर दुई लहरमा बनिएका थिए।<verse eid="1KI 7:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 7:25"/>त्यो खड्कुँलो तीन वटा उत्तरतिर, तीन वटा पश्‍चिमतिर, तीन वटा दक्षिणतिर अनि तीन वटा पूर्वपट्टि फर्किएका बाह्र वटा साँढेहरूमाथि अड्याइएको थियो। खड्कुँलोचाहिँ तिनीहरूको टुप्पामाथि अडिएको थियो। तिनीहरूको पछिल्‍लो भागचाहिँ भित्रपट्टि फर्किएको थियो।<verse eid="1KI 7:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 7:26"/>त्यसको मोटाइ एक बित्ता थियो, र त्यसको किनार लिली फूलको बिटजस्तै र कचौराको किनारजस्तो थियो। त्यसमा दुई हजार बाथ अटाउँथ्यो।<verse eid="1KI 7:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 7:27"/>हूरामले काँसाका दश वटा ठेला गाडाहरू बनाए। जसमा प्रत्येक गाडाको लम्बाइ चार क्यूबिट, चौडाइ चार क्यूबिट र उचाइ तीन क्यूबिट थियो।<verse eid="1KI 7:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 7:28"/>ती यसरी बनाइएका थिए: ती ठेलागाडाका चारैतिर पाताहरू थिए। ती पाताहरू ठाडो डण्डीको बीच-बीचमा जोडिएका थिए।<verse eid="1KI 7:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 7:29"/>ती ठाडो डण्डीहरूका बीच-बीचका पाताहरूमा सिंह, साँढे र करूबहरूका आकृतिहरू थिए। अनि ती ठाडो डण्डीहरूमा पनि त्यस्तै आकृतिहरू थिए। सिंह र साँढेहरूका आकृतिहरूको तल्तिर र मास्तिर पिटेर बनाइएका मालाका हारहरू थिए।<verse eid="1KI 7:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 7:30"/>प्रत्येक ठेलागाडामा काँसका चार वटा चक्‍का र काँसोका चार वटा धुराहरू थिए। अनि ठेलागाडाको चारै कुनामा भएका ती चार वटा टेकोहरूमाथि त्यो भाँडो अड्याइएको थियो, जुनचाहिँ प्रत्येक पाटाका हारहरूसहित थिए।<verse eid="1KI 7:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 7:31"/>गाडाका भित्रपट्टि एक क्यूबिट गहिरो गोलाकार फ्रेमसहितको एउटा बाटा थियो। अनि त्यसको पीँधसित नाप्दा त्यो डेढ क्यूबिट थियो। त्यसको खुला भागको वरिपरि बुट्टाहरू थिए। गाडाका फल्याकहरू गोलो नभएर वर्गाकार थिए।<verse eid="1KI 7:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 7:32"/>ती चार चक्‍काहरू फल्याकमुनि थिए। अनि चक्‍काका धुराहरू गाडासित जोडिएका थिए। प्रत्येक चक्‍काको उचाइ डेढ क्यूबिट थियो।<verse eid="1KI 7:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 7:33"/>ती चक्‍काहरू रथका चक्‍काझैँ बनाइएका थिए। अनि धुरा, घेरा, सुइरा र नाभिहरू धातु ढालेर बनाइएका थिए।<verse eid="1KI 7:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 7:34"/>प्रत्येक गाडाका चार कुनामा चारै वटा बिँडहरू थिए; अनि ती बिँडहरूलाई गाडासँगै एउटै धातुको टुक्रा ढालेर बनाइएको थियो।<verse eid="1KI 7:34"/></para>
<para style="p"><verse number="35" style="v" sid="1KI 7:35"/>प्रत्येक गाडाको टुप्पामा एउटा आधा क्यूबिट गहिरो घेरा बनाइएको थियो। ती टेकोहरू र फल्याकलाई गाडाका टुप्पामा त्यस घेरासँग जोडिएको थियो।<verse eid="1KI 7:35"/></para>
<para style="p"><verse number="36" style="v" sid="1KI 7:36"/>तिनले टेकोहरूमा र फल्याकहरूमा करूबहरू, सिंहहरू र खजूरका रूखहरू खोपे र चारैतिर हारहरू बनाइदिए।<verse eid="1KI 7:36"/></para>
<para style="p"><verse number="37" style="v" sid="1KI 7:37"/>यस किसिमले तिनले दश वटा गाडाहरू बनाए। ती सबैलाई एउटै साँचोमा, एउटै नाप र एउटै आकारमा ढालेर बनाइएका थिए।<verse eid="1KI 7:37"/></para>
<para style="p"><verse number="38" style="v" sid="1KI 7:38"/>त्यसपछि हूरामले चालीस बाथ पानी अटाउने काँसाका दश वटा बाटाहरू बनाए। जुन नापमा चार क्यूबिट फराकिलो थियो। ती दशै वटा गाडाहरू हरेकमा एक-एक वटा बाटा थिए।<verse eid="1KI 7:38"/></para>
<para style="p"><verse number="39" style="v" sid="1KI 7:39"/>तिनले पाँच वटा गाडाहरू मन्दिरको दक्षिणपट्टि अनि पाँच वटा चाहिँ उत्तरपट्टि राखे। तिनले खड्कुँलोलाई मन्दिरको दक्षिण-पूर्वपट्टिको कुनामा दक्षिणपट्टि राखे।<verse eid="1KI 7:39"/></para>
<para style="p"><verse number="40" style="v" sid="1KI 7:40"/>तिनले भाँडाहरू, बेल्चाहरू र छर्कने कचौराहरू पनि बनाए। यसरी हूरामले याहवेहको मन्दिरमा राजा सोलोमनका निम्ति आफूले जिम्मा लिएका सबै कामहरू गरेर सिद्ध्याए:<verse eid="1KI 7:40"/></para>
<para style="p"><verse number="41" style="v" sid="1KI 7:41"/>दुई स्तम्भहरू; र ती स्तम्भहरूका टुप्पामा बाटाजस्तै आकारका दुई वटा स्तम्भ-शिरहरू; स्तम्भहरूका टुप्पामाथि कचौरा आकारका दुई वटा स्तम्भ-शिरहरूलाई सिँगार्ने दुई वटा जालीहरू;<verse eid="1KI 7:41"/></para>
<para style="p"><verse number="42" style="v" sid="1KI 7:42"/>दुई जालीहरूका निम्ति चार सय दारिमहरू (खम्बाहरूका टुप्पामाथि भएका बाटा आकारका स्तम्भ-शिरलाई सिँगार्ने प्रत्येक जालीका निम्ति दुई लहर दारिमहरू);<verse eid="1KI 7:42"/></para>
<para style="p"><verse number="43" style="v" sid="1KI 7:43"/>दश वटा गाडाहरूसहित तिनीहरूका बाटाहरू;<verse eid="1KI 7:43"/></para>
<para style="p"><verse number="44" style="v" sid="1KI 7:44"/>खड्कुँलो र त्यस मुनिका बाह्र वटा साँढेहरू;<verse eid="1KI 7:44"/></para>
<para style="p"><verse number="45" style="v" sid="1KI 7:45"/>भाँडाहरू, बेल्चाहरू र छर्कने भाँडाहरू। हूरामले राजा सोलोमनको लागि याहवेहको भवनका निम्ति बनाइदिएका यी सबै सामानहरू टल्काइएका काँसाका थिए।<verse eid="1KI 7:45"/></para>
<para style="p"><verse number="46" style="v" sid="1KI 7:46"/>राजाले तिनीहरूलाई सुक्‍कोत र सार्तानको बीचको यर्दन मैदानमा माटोको साँचोमा ढाल्न लाए।<verse eid="1KI 7:46"/></para>
<para style="p"><verse number="47" style="v" sid="1KI 7:47"/>सोलोमनले सबै कुराहरूको तौल राखेनन्; किनकि ती अति धेरै थिए। काँसाको तौल नाप्‍न असम्भव थियो।<verse eid="1KI 7:47"/></para>
<para style="p"><verse number="48" style="v" sid="1KI 7:48"/>सोलोमनले याहवेहको मन्दिरमा भएका सबै श्रृङ्गारका सामानहरू पनि बनाए: सुनको वेदी; उपस्थितिको रोटी राख्ने सुनको टेबुल;<verse eid="1KI 7:48"/></para>
<para style="p"><verse number="49" style="v" sid="1KI 7:49"/>निखुर सुनका सामदानहरू (भित्री पवित्रस्थानको सामु पाँच वटा दाहिनेपट्टि र पाँच वटा देब्रेपट्टि); सुनका फूलहरू र बत्तीहरू र चिम्टाहरू;<verse eid="1KI 7:49"/></para>
<para style="p"><verse number="50" style="v" sid="1KI 7:50"/>निखुर सुनका बाटाहरू, सलेदोका चिम्टाहरू; छर्कने भाँडाकुँडाहरू र धूपदानीहरू; अनि सबैभन्दा भित्री कोठा अर्थात् महा-पवित्रस्थानका ढोकाहरूका निम्ति र मन्दिरका मुख्य कोठाका ढोकाहरूका निम्ति सुनका कब्जाहरू।<verse eid="1KI 7:50"/></para>
<para style="p"><verse number="51" style="v" sid="1KI 7:51"/>जब राजा सोलोमनले याहवेहको मन्दिरको निम्ति गर्नुपर्ने सम्पूर्ण कामहरू गरिसिद्ध्याए, तब तिनले आफ्ना पिता दावीदले अर्पण गरेका चीजहरू, अर्थात् चाँदी र सुन अनि सबै सजावटका सामानहरू भित्र ल्याए। अनि तिनले ती याहवेहको मन्दिरका भण्डारहरूमा राखे।<verse eid="1KI 7:51"/></para>
<chapter eid="1KI 7"/>
<chapter number="8" style="c" sid="1KI 8"/>
<para style="p"><verse number="1" style="v" sid="1KI 8:1"/>तब राजा सोलोमनले इस्राएलका प्रधानहरू, कुलहरूका सबै अगुवाहरू र इस्राएली परिवारहरूका मुखियाहरूलाई सियोन, अर्थात् दावीदको सहरबाट याहवेहको करारको सन्दुक ल्याउनलाई आफ्नो उपस्थितिमा यरूशलेममा भेला हुन बोलाए।<verse eid="1KI 8:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 8:2"/>इस्राएलका सबै मानिसहरू सातौँ महिना एतानीमको चाडको समयमा एकसाथ राजा सोलोमनकहाँ भेला भए।<verse eid="1KI 8:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 8:3"/>इस्राएलका सबै प्रधानहरू आइपुगेपछि पुजारीहरूले याहवेहको सन्दुक उठाए।<verse eid="1KI 8:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 8:4"/>पुजारीहरू र लेवीहरूले याहवेहको सन्दुक, भेट हुने पाल र त्यसमा भएका सबै पवित्र सजावटहरू बोकेर माथि ल्याए,<verse eid="1KI 8:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 8:5"/>अनि सन्दुकको सामु उपस्थित भएका राजा सोलोमन अनि तिनका चारैतिर भेला भएका इस्राएलका सम्पूर्ण समुदायले यति धेरै भेडाहरू र पशुहरू बलिदान चढाइरहेका थिए, कि त्यसलाई दर्ता गर्न अथवा गन्‍न पनि सकिँदैनथ्यो।<verse eid="1KI 8:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 8:6"/>त्यसपछि पुजारीहरूले याहवेहको करारको सन्दुकलाई त्यसकै ठाउँमा मन्दिरको भित्री पवित्रस्थानमा, अर्थात् महा-पवित्रस्थानमा ल्याए। अनि त्यसलाई करूबहरूका पखेटामुनि राखिदिए।<verse eid="1KI 8:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 8:7"/>सन्दुक राखिएको ठाउँको माथिपट्टि करूबहरूका पखेटाको छाया सन्दुक र त्यसलाई बोक्ने डण्डाहरूमाथि पर्दथ्यो।<verse eid="1KI 8:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 8:8"/>ती डण्डाहरू यति लामा थिए, कि सन्दुकबाट निस्किएका तिनीहरूका छेउहरू पवित्रस्थानको अगिबाट देखिन्थे; तर पवित्रस्थानको बाहिरबाट देख्न सकिँदैनथिए। ती आज पनि त्यहीँ छन्।<verse eid="1KI 8:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 8:9"/>त्यस सन्दुकभित्र ढुङ्गाका दुई पाटीहरूबाहेक अरू केही थिएन, जसमा पाटीहरू मोशाले होरेबमा राखेका थिए, जहाँ इस्राएलीहरू इजिप्टबाट निस्किआएपछि याहवेहले तिनीहरूसित करार बाँध्नुभएको थियो।<verse eid="1KI 8:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 8:10"/>जब पुजारीहरू पवित्रस्थानबाट हटे, तब याहवेहको मन्दिरभित्र बादल भरियो।<verse eid="1KI 8:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 8:11"/>अनि बादलको कारण पुजारीहरूले आफ्ना सेवा गर्न सकेनन्; किनकि याहवेहको महिमाले उहाँको मन्दिर भरियो।<verse eid="1KI 8:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 8:12"/>तब सोलोमनले भने, “याहवेहले भन्‍नुभएको छ, कि उहाँ घोर बादलको अँध्यारोमा बास गर्नुहुन्छ;<verse eid="1KI 8:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 8:13"/>मैले साँच्‍चै तपाईंका निम्ति एउटा भव्य भवन निर्माण गरेको छु—तपाईं सदासर्वदा बास गर्नलाई तपाईंको निम्ति एक वासस्थान।”<verse eid="1KI 8:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 8:14"/>इस्राएलका सारा समुदाय त्यहाँ उभिरहेका बेला राजा तिनीहरूतिर फर्किए, र तिनीहरूलाई आशीर्वाद दिए।<verse eid="1KI 8:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 8:15"/>त्यसपछि तिनले भने: “याहवेह इस्राएलका परमेश्‍वरको प्रशंसा होस्, जसले आफ्नै मुखले मेरा पिता दावीदलाई प्रतिज्ञा गर्नुभएको कुरा आफ्नै हातले पूरा गर्नुभएको छ। किनकि उहाँले भन्‍नुभएको थियो,<verse eid="1KI 8:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 8:16"/>‘मैले आफ्ना मानिसहरूलाई इजिप्टबाट बाहिर निकालेर ल्याएको दिनदेखि उसो, मेरो नाम त्यहाँ रहोस् भनेर मेरो नाममा मन्दिर बनाउनलाई मैले इस्राएलको कुनै पनि कुलबाट सहर चुनिनँ, तर मैले मेरो जाति इस्राएलमाथि शासन गर्न दावीदलाई चुनेँ।’<verse eid="1KI 8:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 8:17"/>“मेरा पिता दावीदको हृदयमा याहवेह इस्राएलका परमेश्‍वरको नामको खातिर एउटा मन्दिर निर्माण गर्ने विचार थियो।<verse eid="1KI 8:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 8:18"/>तर याहवेहले मेरा पिता दावीदलाई भन्‍नुभयो, ‘मेरो नामको खातिर तेरो हृदयमा एउटा मन्दिर बनाउने विचार राखेर तैँले आफ्नो हृदयमा असल गरिस्।<verse eid="1KI 8:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 8:19"/>तापनि तैँले त्यो मन्दिर बनाउनेछैनस्, तर तेरो आफ्नै मासु र रगत—तेरो छोराले मेरो नामको खातिर मन्दिर बनाउनेछ।’<verse eid="1KI 8:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 8:20"/>“याहवेहले आफ्नो प्रतिज्ञा कायम राख्नुभयो: म मेरा पिता दावीदपछि राजा भएँ। अनि अहिले म याहवेहले प्रतिज्ञा गर्नुभएझैँ इस्राएलको सिंहासनमा बसेको छु; र मैले याहवेह इस्राएलका परमेश्‍वरको नामका निम्ति यो मन्दिर बनाएको छु।<verse eid="1KI 8:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 8:21"/>मैले सन्दुकको निम्ति त्यहाँ एउटा ठाउँ राखेको छु, जसमा याहवेहले हाम्रा पितापुर्खाहरूलाई इजिप्टबाट निकालेर ल्याउनुहुँदा तिनीहरूसित बाँध्नुभएको करार छ।”<verse eid="1KI 8:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 8:22"/>तब सोलोमन सम्पूर्ण इस्राएली समुदायको अगि याहवेहको वेदीको सामु उभिए, र आफ्ना हातहरू स्वर्गतिर फैलाए,<verse eid="1KI 8:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 8:23"/>अनि तिनले भने: “हे याहवेह, इस्राएलका परमेश्‍वर, माथि स्वर्गमा अनि तल पृथ्वीमा तपाईंजस्तै अरू कुनै ईश्‍वर छैन। तपाईं, जसले तपाईंको मार्गमा सम्पूर्ण हृदयले चल्ने आफ्ना सेवकहरूसँग बाँध्नुभएको करार सदा कायम राख्नुहुन्छ।<verse eid="1KI 8:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 8:24"/>तपाईंले आफ्नो सेवक मेरा पिता दावीदसित आफ्नो मुखले गर्नुभएको प्रतिज्ञा आफ्ना हातले पूरा गर्नुभएको छ, जो आजको दिनसम्मै छँदैछ।<verse eid="1KI 8:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 8:25"/>“अब हे याहवेह, इस्राएलका परमेश्‍वर, तपाईंले आफ्नो सेवक मेरा पिता दावीदको खातिर उहाँलाई यसो भन्‍नुभएको प्रतिज्ञा पूरा गर्नुहोस् ‘तेरा छोराहरू आफ्ना कामहरू र चालहरूमा तँजस्तै होसियार रहे भने मेरो सामु इस्राएलको सिंहासनमा बस्‍नलाई तँलाई कुनै मानिसको अभाव हुनेछैन’।<verse eid="1KI 8:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 8:26"/>अब हे इस्राएलका परमेश्‍वर, तपाईंले आफ्नो सेवक मेरा पिता दावीदसित गर्नुभएको आफ्नो प्रतिज्ञा पूरा होस्।<verse eid="1KI 8:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 8:27"/>“तर के परमेश्‍वर साँच्‍चै पृथ्वीमा बास गर्नुहुन्छ? स्वर्गहरू र सबैभन्दा उच्‍च स्वर्गहरूमा पनि तपाईं अटाउन सक्नुहुन्‍न भने मैले बनाएको यस मन्दिरमा त झन् कसरी अटाउनुहोला र!<verse eid="1KI 8:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 8:28"/>तरै पनि हे याहवेह मेरा परमेश्‍वर, आफ्नो सेवकको प्रार्थना र दयाको निम्ति चढाएको अर्जबिन्तीमा ध्यान दिनुहोस्। तपाईंको उपस्थितिमा तपाईंको सेवकले आज गरेको पुकार र प्रार्थना सुन्‍नुहोस्।<verse eid="1KI 8:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 8:29"/>यस मन्दिरमा तपाईंको दृष्‍टि दिनरात रहिरहोस्। यो ठाउँ, जसको बारेमा तपाईंले ‘मेरो नाम त्यहाँ हुनेछ’ भन्‍नुभएको थियो, ताकि तपाईंको सेवकले यस ठाउँतिर फर्किएर चढाएको प्रार्थना सुन्‍नुभएको होस्।<verse eid="1KI 8:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 8:30"/>तपाईंको सेवक र तपाईंको जाति इस्राएलले यस ठाउँतिर फर्केर प्रार्थना गर्दा तिनीहरूको अर्जबिन्ती सुनिदिनुहोस्। तपाईंको वासस्थान स्वर्गबाट सुन्‍नुहोस्; र तपाईंले सुन्‍नुभएपछि क्षमा गर्नुहोस्।<verse eid="1KI 8:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 8:31"/>“कुनै मानिसले आफ्नो छिमेकीको विरुद्धमा अपराध गर्‍यो, र उसलाई शपथ खान लगाइयो; अनि उसले यस मन्दिरमा तपाईंको वेदीको सामु आएर शपथ खायो भने,<verse eid="1KI 8:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 8:32"/>तब तपाईंले स्वर्गबाट सुनेर काम गर्नुहोस्। आफ्ना सेवकहरूको बीचमा न्याय गर्नुहोस्, र त्यस दोषीलाई अपराधी ठहर्‍याउँदै त्यसले गरेको काम त्यसकै शिरमाथि खन्याइदिनुहोस्। अनि निर्दोषलाई त्यसको निर्दोषता प्रमाणित गरिदिनुहोस्।<verse eid="1KI 8:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 8:33"/>“जब तपाईंको जाति इस्राएलले तपाईंको विरुद्धमा पाप गरेको कारणले तिनीहरू आफ्ना शत्रुहरूद्वारा हार्लान्, र तिनीहरू फेरि तपाईंतिर फर्केर यस मन्दिरमा आएर तपाईंलाई प्रार्थना र बिन्ती गर्दै तपाईंको नामलाई प्रशंसा चढाए भने,<verse eid="1KI 8:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 8:34"/>तब स्वर्गबाट सुन्‍नुहोस् र तपाईंले आफ्नो जाति इस्राएललाई क्षमा दिनुहोस्, र तिनीहरूलाई तपाईंले तिनीहरूका पितापुर्खाहरूलाई दिनुभएको देशमा फर्काएर ल्याउनुहोस्।<verse eid="1KI 8:34"/></para>
<para style="p"><verse number="35" style="v" sid="1KI 8:35"/>“तपाईंको जातिले पाप गरेको कारण आकाश बन्द भएर पानी परेन र तिनीहरूले यस ठाउँतिर फर्किएर प्रार्थना गर्दै तपाईंको नामलाई प्रशंसा चढाए। अनि तपाईंले तिनीहरूलाई दण्ड दिनुभएको कारण तिनीहरू आफ्ना पापबाट फर्किए भने,<verse eid="1KI 8:35"/></para>
<para style="p"><verse number="36" style="v" sid="1KI 8:36"/>तब स्वर्गबाट सुन्‍नुहोस् र आफ्ना सेवकहरू, इस्राएल तपाईंको जातिलाई क्षमा गर्नुहोस्। तिनीहरूलाई ठिकसित जिउने मार्ग सिकाउनुहोस्। अनि तपाईंले आफ्नो जातिलाई उत्तराधिकारस्वरूप दिनुभएको देशमा वर्षा पठाइदिनुहोस्।<verse eid="1KI 8:36"/></para>
<para style="p"><verse number="37" style="v" sid="1KI 8:37"/>“जब देशमा अनिकाल वा रूढी आउँछ, सुकाउने अथवा ढुसी पर्ने रोग लाग्छ, सलह अथवा फट्याङ्ग्राहरू आउँछन्, अथवा कुनै शत्रुले तिनीहरूको कुनै सहरमा घेरा हाल्यो भने जस्तोसुकै आपत् वा रोग आयो भने पनि,<verse eid="1KI 8:37"/></para>
<para style="p"><verse number="38" style="v" sid="1KI 8:38"/>तपाईंको जाति इस्राएलले आफ्ना हात यस मन्दिरतिर फैलाउँदै आफ्नो हृदयको कष्‍टलाई थाहा पाएर प्रार्थना र विनय चढायो भने<verse eid="1KI 8:38"/></para>
<para style="p"><verse number="39" style="v" sid="1KI 8:39"/>तब तपाईंको वासस्थान स्वर्गबाट सुन्‍नुहोस्। तिनीहरूलाई क्षमा दिनुहोस् र काम गर्नुहोस्; तपाईंले तिनीहरूका हृदय जान्‍नुभएकोले (किनकि तपाईंले मात्र मानिसहरूको हृदय जान्‍नुहुन्छ), प्रत्येकसित तिनीहरूको कामअनुसारको व्यवहार गर्नुहोस्।<verse eid="1KI 8:39"/></para>
<para style="p"><verse number="40" style="v" sid="1KI 8:40"/>यसरी तपाईंले हाम्रा पितापुर्खाहरूलाई दिनुभएको देशमा तिनीहरूले तपाईंको भय मानून्।<verse eid="1KI 8:40"/></para>
<para style="p"><verse number="41" style="v" sid="1KI 8:41"/>“ती विदेशीहरू, जो तपाईंका प्रजा इस्राएलबाट होइनन्, तर तपाईंको नाम सुनेर टाढा देशबाट आएका छन् भने,<verse eid="1KI 8:41"/></para>
<para style="p"><verse number="42" style="v" sid="1KI 8:42"/>किनभने मानिसहरूले तपाईंको महान् नाम, तपाईंको शक्तिशाली बाहुली र तपाईंको फैलिएको पाखुराको विषयमा सुन्‍नेछन्। जब तिनीहरूले यस मन्दिरतिर फर्केर प्रार्थना गर्छन्,<verse eid="1KI 8:42"/></para>
<para style="p"><verse number="43" style="v" sid="1KI 8:43"/>तब आफ्नो वासस्थान स्वर्गबाट सुन्‍नुहोस। अनि त्यस परदेशीले जे माग्छ, त्यही गर्नुहोस्; ताकि यस पृथ्वीका सबै मानिसहरूले तपाईंको जाति इस्राएलले झैँ तपाईंको नाम जानून् र तपाईंको भय मानून्। अनि मैले बनाएको यस भवनमा तपाईंको नाम रहेछ भनी जानून्।<verse eid="1KI 8:43"/></para>
<para style="p"><verse number="44" style="v" sid="1KI 8:44"/>“जब तपाईंका मानिसहरू आफ्ना शत्रुहरूको विरुद्धमा तपाईंले पठाउनुभएको ठाउँमा जान्छन्, तब तिनीहरूले तपाईंले चुन्‍नुभएको सहर र मैले तपाईंको नामका निम्ति बनाएको यस मन्दिरतिर फर्केर याहवेहलाई प्रार्थना गरे भने,<verse eid="1KI 8:44"/></para>
<para style="p"><verse number="45" style="v" sid="1KI 8:45"/>स्वर्गबाट तिनीहरूका प्रार्थना र तिनीहरूका अर्जबिन्ती सुनिदिनुहोस्, र तिनीहरूको पक्ष लिनुहोस्।<verse eid="1KI 8:45"/></para>
<para style="p"><verse number="46" style="v" sid="1KI 8:46"/>“जब तिनीहरूले तपाईंको विरुद्धमा पाप गर्छन्, किनकि पाप नगर्ने कोही पनि छैन; र तिनीहरूसित रिसाउनुभएर तपाईंले तिनीहरूलाई तिनीहरूका शत्रुको हातमा सुम्पिदिनुभएर उनीहरूले तिनीहरूलाई कैद गरेर आफ्नै देश, टाढा वा नजिक लगे भने,<verse eid="1KI 8:46"/></para>
<para style="p"><verse number="47" style="v" sid="1KI 8:47"/>तिनीहरू कैद भएको ठाउँमा तिनीहरूको हृदय परिवर्तन भएर तिनीहरूले आफू कैद गरिएकाहरूका देशमा पश्‍चात्ताप गरेर तपाईंसित अर्जबिन्ती गर्दै ‘हामीले पाप गरेका छौँ, हामीले भूल गरेर दुष्‍ट काम गरेका छौँ’ भन्छन् भने,<verse eid="1KI 8:47"/></para>
<para style="p"><verse number="48" style="v" sid="1KI 8:48"/>अनि तिनीहरू आफूलाई कैद गरेर लैजाने शत्रुहरूको देशमा आफ्ना हृदय र प्राणले तपाईंतिर फर्कन्छन् र तिनीहरूका पितापुर्खाहरूलाई दिनुभएको देशतिर फर्केर र तपाईंले चुन्‍नुभएको सहरतिर फर्केर, र मैले तपाईंको नामको खातिर बनाएको मन्दिरतिर फर्केर तपाईंलाई प्रार्थना गरे भने;<verse eid="1KI 8:48"/></para>
<para style="p"><verse number="49" style="v" sid="1KI 8:49"/>तपाईंको वासस्थान स्वर्गबाट तिनीहरूका प्रार्थना र अर्जबिन्ती सुनिदिनुहोस् र तिनीहरूको पक्ष लिइदिनुहोस्।<verse eid="1KI 8:49"/></para>
<para style="p"><verse number="50" style="v" sid="1KI 8:50"/>तपाईंको विरुद्धमा पाप गर्ने तपाईंको प्रजालाई क्षमा दिनुहोस्। तिनीहरूले तपाईंका विरुद्धमा गरेका सबै अपराधहरू क्षमा गर्नुहोस्। तिनीहरूलाई जित्नेहरूलाई तिनीहरूमाथि दया देखाउने बनाइदिनुहोस्।<verse eid="1KI 8:50"/></para>
<para style="p"><verse number="51" style="v" sid="1KI 8:51"/>किनकि तिनीहरू इजिप्टबाट अर्थात् फलाम गाल्ने भट्टीबाट तपाईंले निकालेर ल्याउनुभएका तपाईंका जाति र तपाईंका उत्तराधिकारी हुन्।<verse eid="1KI 8:51"/></para>
<para style="p"><verse number="52" style="v" sid="1KI 8:52"/>“तपाईंका नजर आफ्नो सेवकको अर्जबिन्ती र तपाईंको प्रजा इस्राएलको अर्जबिन्तीको लागि खुला रहून्। तिनीहरूले जहिले तपाईंमा पुकार गर्दा पनि तपाईंले ध्यानसित सुन्‍नुहोस्।<verse eid="1KI 8:52"/></para>
<para style="p"><verse number="53" style="v" sid="1KI 8:53"/>किनकि हे प्रभु याहवेह, तपाईंले हाम्रा पितापुर्खाहरूलाई इजिप्टबाट निकालेर ल्याउनुहुँदा आफ्नो सेवक मोशासित घोषणा गर्नुभएझैँ, तपाईंले तिनीहरूलाई आफ्ना उत्तराधिकार बनाउनलाई पृथ्वीका सबै जातिहरूबाट अलग गर्नुभएको थियो।”<verse eid="1KI 8:53"/></para>
<para style="p"><verse number="54" style="v" sid="1KI 8:54"/>जब सोलोमनले याहवेहलाई यो प्रार्थना र अर्जबिन्ती गरिसके, तब तिनी याहवेहको वेदीको सामुबाट उठे, जहाँ तिनी घुँडा टेकेर स्वर्गतिर हात फैलाएर बसेका थिए।<verse eid="1KI 8:54"/></para>
<para style="p"><verse number="55" style="v" sid="1KI 8:55"/>तिनी खडा भए, र इस्राएलका सारा समुदायलाई चर्को सोरले यसो भनेर आशीर्वाद दिए:<verse eid="1KI 8:55"/></para>
<para style="p"><verse number="56" style="v" sid="1KI 8:56"/>“याहवेहको प्रशंसा होस्, जसले आफ्नो प्रतिज्ञाअनुसार आफ्ना जाति इस्राएललाई विश्राम दिनुभएको छ। उहाँले आफ्नो सेवक मोशाद्वारा गर्नुभएका असल प्रतिज्ञाहरूमध्ये एउटै पनि असफल भएका छैनन्।<verse eid="1KI 8:56"/></para>
<para style="p"><verse number="57" style="v" sid="1KI 8:57"/>याहवेह हाम्रा परमेश्‍वर हाम्रा पितापुर्खाहरूसित रहनुभएझैँ हामीसित पनि रहून्। उहाँले हामीलाई कहिल्यै नछोडून्, र हामीलाई नत्यागून्।<verse eid="1KI 8:57"/></para>
<para style="p"><verse number="58" style="v" sid="1KI 8:58"/>उहाँले हाम्रा पितापुर्खाहरूलाई दिनुभएका आज्ञाहरू, उर्दीहरू र नियमहरू पालन गर्नलाई अनि उहाँकै चालमा हिँड्नलाई उहाँले हाम्रा हृदयहरू आफूतिर फर्काऊन्।<verse eid="1KI 8:58"/></para>
<para style="p"><verse number="59" style="v" sid="1KI 8:59"/>मैले याहवेहको सामु प्रार्थनामा बोलेका मेरा यी वचनहरू याहवेह हाम्रा परमेश्‍वरको नजिक दिनरात रहिरहून्। उहाँले प्रत्येक दिनको खाँचोअनुसार आफ्नो सेवकको र आफ्नो जाति इस्राएलको पक्ष लिऊन्।<verse eid="1KI 8:59"/></para>
<para style="p"><verse number="60" style="v" sid="1KI 8:60"/>ताकि पृथ्वीका सारा जातिहरूले याहवेह नै परमेश्‍वर हुनुहुन्छ, र अरू कुनै ईश्‍वर छैन भनी जानून्।<verse eid="1KI 8:60"/></para>
<para style="p"><verse number="61" style="v" sid="1KI 8:61"/>तिमीहरूका हृदय उहाँका आदेशहरूअनुसार अहिलेझैँ हिँड्न र उहाँका उर्दीहरू पालन गर्नका निम्ति पूर्ण रूपमा समर्पित होऊन्।”<verse eid="1KI 8:61"/></para>
<para style="p"><verse number="62" style="v" sid="1KI 8:62"/>तब राजा र तिनीसँग भएका सारा इस्राएलले याहवेहको सामु बलिदानहरू चढाए।<verse eid="1KI 8:62"/></para>
<para style="p"><verse number="63" style="v" sid="1KI 8:63"/>सोलोमनले मेलबलिको रूपमा बाइस हजार गाईबस्तु र एक लाख बीस हजार भेडाबाख्राहरू चढाए। यसरी राजा र सारा इस्राएलीहरूले याहवेहको मन्दिरलाई समर्पण गरे।<verse eid="1KI 8:63"/></para>
<para style="p"><verse number="64" style="v" sid="1KI 8:64"/>त्यसै दिन राजाले याहवेहको मन्दिरको सामु चोकको बीच भागलाई पवित्र गरे। अनि त्यहाँ तिनले होमबलि, अन्‍नबलि र मेलबलिको बोसो चढाए; किनभने होमबलि, अन्‍नबलि र मेलबलिको बोसो अटाउनलाई याहवेहको सामु भएको काँसाको वेदी साह्रै सानो थियो।<verse eid="1KI 8:64"/></para>
<para style="p"><verse number="65" style="v" sid="1KI 8:65"/>यसकारण सोलोमन र त्यस बेला तिनको साथमा भएका सम्पूर्ण इस्राएलले, त्यो विशाल समुदाय, जो लेबो-हमातदेखि लिएर इजिप्टको खोल्सासम्मका मानिसहरूसित चाड मनाए। तिनले याहवेह हाम्रा परमेश्‍वरकै सामु सात दिन र फेरि सात दिन, जम्मा चौध दिन उत्सव मनाए।<verse eid="1KI 8:65"/></para>
<para style="p"><verse number="66" style="v" sid="1KI 8:66"/>भोलिपल्ट तिनले मानिसहरूलाई पठाइदिए। तिनीहरूले राजालाई आशीर्वाद दिए। याहवेहले आफ्ना सेवक दावीद र आफ्ना मानिसहरू इस्राएलप्रति गर्नुभएका सबै असल कुराहरूको कारण आनन्दित र खुशी हृदय लिएर तिनीहरू आ-आफ्ना घरतिर गए।<verse eid="1KI 8:66"/></para>
<chapter eid="1KI 8"/>
<chapter number="9" style="c" sid="1KI 9"/>
<para style="p"><verse number="1" style="v" sid="1KI 9:1"/>जब राजा सोलोमनले याहवेहको मन्दिर र राजमहल बनाइसके, तब तिनले इच्छा गरेका सबै कुराहरू हासिल गरे।<verse eid="1KI 9:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 9:2"/>अनि याहवेह तिनीकहाँ गिबोनमा देखापर्नुभएझैँ दोस्रो पल्ट तिनीकहाँ देखा पर्नुभयो।<verse eid="1KI 9:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 9:3"/>याहवेहले तिनलाई भन्‍नुभयो: “तैँले मेरो सामु चढाएको प्रार्थना र अर्जबिन्ती मैले सुनेको छु। तैँले बनाएको यस मन्दिरलाई मैले त्यहाँ सदाका निम्ति आफ्नो नाम राखेर पवित्र गरेको छु। मेरो नजर र मेरो हृदय सधैँभरि त्यहाँ रहनेछ।<verse eid="1KI 9:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 9:4"/>“तेरो विषयमा चाहिँ, तँ तेरा पिता दावीदझैँ, हृदयको इमानदारी र सोझोपनमा विश्‍वासयोग्य भएर मेरो सामु हिँडिस्। अनि मैले आज्ञा गरेका सबै आदेश र व्यवस्थाहरू पालन गरिस् भने,<verse eid="1KI 9:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 9:5"/>‘इस्राएलको सिंहासनमाथि बस्‍नलाई तँलाई कुनै मानिसको अभाव हुनेछैन’ भनेर मैले तेरा पिता दावीदलाई प्रतिज्ञा गरेझैँ, म इस्राएलमाथि तेरो सिंहासन सदाका लागि स्थापित गर्नेछु।<verse eid="1KI 9:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 9:6"/>“तर तँ अथवा तेरा छोराहरू मदेखि तर्केर गए, र मैले तँलाई दिएका आज्ञाहरू र आदेशहरू मानेनन् भने, र अन्य देवी-देवताहरूको सेवा गर्दै तिनीहरूलाई पूजा गरे भने,<verse eid="1KI 9:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 9:7"/>मैले इस्राएललाई दिएको यस देशबाट म तिनीहरूलाई हटाउनेछु। अनि मैले आफ्नो नामको निम्ति पवित्र गरेको यस मन्दिरलाई म इन्कार गर्नेछु। तब इस्राएल सबै जातिहरूका बीचमा एउटा निन्दा र हाँसोको पात्र बन्‍नेछ।<verse eid="1KI 9:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 9:8"/>अहिले यो मन्दिर भव्य भए तापनि यसको छेउबाट जाने सबैले चकित हुँदै खिसी गरेर यसो भन्‍नेछन्, ‘याहवेहले यस देश र यस मन्दिरलाई किन यसो गर्नुभएको होला?’<verse eid="1KI 9:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 9:9"/>तब मानिसहरूले यसो भनेर जवाफ दिनेछन्, ‘किनकि तिनीहरूका पितापुर्खाहरूलाई इजिप्टबाट निकालेर ल्याउनुहुने याहवेह आफ्ना परमेश्‍वरलाई तिनीहरूले त्यागेका छन्, र अरू देवी-देवताहरूलाई स्वीकार गरेर तिनीहरूलाई पुजिरहेका छन्। यसैकारण याहवेहले यी सबै विपत्तिहरू तिनीहरूमाथि ल्याउनुभयो।’ ”<verse eid="1KI 9:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 9:10"/>याहवेहको मन्दिर र राजमहल, यी दुई वटा भवनहरू बनाउन सोलोमनलाई बीस वर्ष लाग्यो। त्यो समयको अन्त्यमा,<verse eid="1KI 9:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 9:11"/>राजा सोलोमनले टायरका राजा हीरामलाई गालीलका बीस वटा नगरहरू दिए। किनकि हीरामले तिनलाई चाहिए जति देवदारु, सल्‍लाका काठ र सुन दिएका थिए।<verse eid="1KI 9:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 9:12"/>तर जब सोलोमनले हीरामलाई दिएका नगरहरू हेर्नलाई तिनी टायरबाट त्यहाँ गए, तिनले ती सहरहरू मन पराएनन्।<verse eid="1KI 9:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 9:13"/>अनि तिनले सोधे, “मेरा भाइ, तपाईंले मलाई यी कस्ता किसिमका नगरहरू दिनुभयो?” अनि तिनले तिनीहरूलाई काबूल देश भन्‍ने नाम दिए; जुन नाम आजको दिनसम्मै छँदैछ।<verse eid="1KI 9:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 9:14"/>हीरामले सोलोमनलाई 120 टालेन्ट सुन पठाएका थिए।<verse eid="1KI 9:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 9:15"/>राजा सोलोमनले याहवेहको मन्दिर, उनको राजमहल, कौसीहरू, यरूशलेमको पर्खाल, हासोर, मगिद्दो र गेजेर बनाउँदा ज्यालाविना खटाएका मानिसहरूको विवरण यस्तो छ।<verse eid="1KI 9:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 9:16"/>(इजिप्टका राजा फारोले गेजेरलाई आक्रमण गरेर जितेका थिए। अनि त्यसलाई आगो लगाइदिएका थिए। तिनले त्यस सहरमा बस्‍ने कनानीहरूलाई मारेर त्यो आफ्नी छोरी, अर्थात् सोलोमनकी पत्नीलाई उपहारस्वरूप दिए।<verse eid="1KI 9:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 9:17"/>अनि सोलोमनले गेजेरलाई पुनर्निर्माण गरे।) तिनले यी कुराहरू बनाए: तल्‍लो बेथ-होरोन,<verse eid="1KI 9:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 9:18"/>तिनको देशभित्र मरुभूमिमा भएको बालात र तादमोर,<verse eid="1KI 9:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 9:19"/>यसको साथमा आफ्ना रथहरू र घोडाहरू राख्न तिनले भण्डार सहरहरू र नगरहरू बनाए। अनि यरूशलेममा, लेबनानमा र तिनले शासन गरेका सबै प्रान्तहरूमा तिनले जे जति बनाउने इच्छा गरेका थिए, ती सबै पूरा गरे।<verse eid="1KI 9:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 9:20"/>बाँकी रहेका एमोरीहरू, हित्तीहरू, परिज्जीहरू, हिव्वीहरू, यबूसीहरू (यी मानिसहरू इस्राएली थिएनन्),<verse eid="1KI 9:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 9:21"/>अर्थात् तिनीहरूका देशमा बाँकी रहेका सन्तानहरू, जसलाई इस्राएलीहरूले नष्‍ट पार्न सकेका थिएनन्। सोलोमनले तिनीहरूलाई दासको रूपमा काम गर्न बाध्य बनाएका थिए, जुन आजको दिनससम्मै कायम छँदैछ।<verse eid="1KI 9:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 9:22"/>तर सोलोमनले इस्राएलीहरूबाट कसैलाई पनि दास बनाएनन्। तिनीहरू तिनका लडाकु मानिसहरू, सरकारी अधिकारीहरू, तिनका अधिकृतहरू र तिनका रथहरू र घोडचढीहरूका सेनापतिहरू थिए।<verse eid="1KI 9:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 9:23"/>सोलोमनले आफ्ना परियोजनाहरूमा काम गर्ने मानिसहरूमाथि रेखदेख गर्न 550 जना अधिकारीहरूलाई नियुक्त गरे।<verse eid="1KI 9:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 9:24"/>दावीदको सहरबाट फारोकी छोरी सोलोमनले तिनका निम्ति बनाएको राजमहलमा आएपछि तिनले कौसीहरू बनाए।<verse eid="1KI 9:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 9:25"/>सोलोमनले वर्षमा तीन पल्ट याहवेहका निम्ति आफूले बनाएको वेदीमा होमबलि र मेलबलि चढाउँथे। अनि यसका साथसाथै याहवेहको सामु धूप बाल्थे। यसरी तिनले मन्दिरमा गर्नुपर्ने कर्तव्यहरू पूरा गरे।<verse eid="1KI 9:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 9:26"/>राजा सोलोमनले लाल समुद्रको किनारमा, एदोमको एलोतको छेउमा भएको एस्योन-गेबेरमा जहाजहरू पनि बनाए।<verse eid="1KI 9:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 9:27"/>अनि हीरामले आफ्ना मानिसहरू, अर्थात् समुद्रका अनुभवी नाविकहरूलाई सोलोमनका मानिसहरूसित जहाजको बेडामा सेवा गर्न पठाए।<verse eid="1KI 9:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 9:28"/>तिनीहरू समुद्री यात्रा गरेर ओपीरमा गए। अनि चार सय बीस टालेन्ट सुन ल्याए, र ती सुन राजा सोलोमनलाई सुम्पिदिए।<verse eid="1KI 9:28"/></para>
<chapter eid="1KI 9"/>
<chapter number="10" style="c" sid="1KI 10"/>
<para style="p"><verse number="1" style="v" sid="1KI 10:1"/>जब शेबाकी रानीले सोलोमनको ख्याति अनि याहवेहप्रतिको तिनको भक्तिभावको बारेमा सुनिन्, तब तिनी कठिन प्रश्नहरू सहित तिनको जाँच गर्नलाई आइन्।<verse eid="1KI 10:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 10:2"/>तिनी मसलाहरू, धेरै मात्रामा सुन र मूल्यवान् पत्थरहरू लादिएका ऊँटहरू लिएर अति लामो लावालस्करका साथमा यरूशलेममा आइपुगिन्। जब तिनले सोलोमनलाई भेटिन्, तब आफ्नो मनमा भएका सबै कुराहरूको विषयमा तिनीसित कुरा गरिन्।<verse eid="1KI 10:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 10:3"/>सोलोमनले तिनका सबै प्रश्नहरूको उत्तर दिए। तिनका सबै कुरा वर्णन गर्न राजालाई कुनै कठिन थिएन।<verse eid="1KI 10:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 10:4"/>जब शेबाकी रानीले सोलोमनका सबै बुद्धि र तिनले बनाएको राजमहल,<verse eid="1KI 10:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 10:5"/>तिनको टेबुलको भोजन, तिनका अधिकारीहरूको बसाइ, भव्य पोशाक पहिरिएका सेवकहरू, तिनका प्याला टक्राउनेहरू अनि याहवेहको मन्दिरमा तिनले चढाएका होमबलिहरू देखेर छक्‍क परिन्।<verse eid="1KI 10:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 10:6"/>तब तिनले राजालाई भनिन्, “मैले आफ्नो देशमा तपाईंको सफलता र बुद्धिको विषयमा सुनेको कुरा ठिक रहेछ।<verse eid="1KI 10:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 10:7"/>तर पनि आइकन आफ्नै आँखाले नदेखेसम्म मैले यी कुराहरू पत्याएकै थिइनँ। वास्तवमा मलाई त यसको आधा पनि बताइएको रहेनछ; तपाईं बुद्धिमा र धनमा मैले सुनेको चर्चाभन्दा पनि धेरै माथि हुनुहुँदोरहेछ।<verse eid="1KI 10:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 10:8"/>तपाईंका मानिसहरू कत्ति सुखी होलान्! तपाईंको सामु उभिएर तपाईंका बुद्धिका कुराहरू लगातार सुन्‍ने तपाईंका अधिकारीहरू कत्ति सुखी होलान्!<verse eid="1KI 10:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 10:9"/>याहवेह तपाईंका परमेश्‍वरलाई प्रशंसा होस्, जसले तपाईंसित प्रसन्‍न भएर तपाईंलाई इस्राएलको सिंहासनमा राख्नुभयो। इस्राएलप्रति याहवेहको अनन्त प्रेमको कारण उहाँले तपाईंलाई न्याय र धार्मिकता कायम राख्नलाई राजा बनाउनुभएको छ।”<verse eid="1KI 10:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 10:10"/>तब तिनले राजालाई 120 टालेन्ट सुन, धेरै मात्रामा मसलाहरू र बहुमूल्य पत्थरहरू दिइन्। शेबाकी रानीले राजा सोलोमनलाई जति धेरै मात्रामा मसाला दिइन्, त्यति धेरै फेरि कहिल्यै आएन।<verse eid="1KI 10:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 10:11"/>(ओपीरबाट सुन ल्याउने हीरामका जहाजहरूले त्यहाँबाट धेरै चन्दनको काठ र बहुमूल्य पत्थरहरू ल्याए।<verse eid="1KI 10:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 10:12"/>राजाले चन्दनका काठहरू याहवेहको मन्दिर अनि राजमहलमा टेको बनाउन र वाद्य-वादकहरूका निम्ति वीणा र सारङ्गी बनाउने काममा प्रयोग गरे। त्यस दिनदेखि यता त्यत्तिको मात्रामा चन्दनको काठ भित्र्याइएको वा देखिएको छैन।)<verse eid="1KI 10:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 10:13"/>शेबाकी रानीलाई पनि तिनले इच्छा गरेका र मागेका सबै चीज दिए, र तीबाहेक राजा सोलोमनले आफ्नो राजकीय प्रशस्तताबाट पनि दिए। त्यसपछि तिनी आफ्ना लावालस्करसित आफ्नै देशमा फर्किन्।<verse eid="1KI 10:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 10:14"/>सोलोमनले प्रतिवर्ष पाउने सुनको तौल छ सय छयसट्ठी टालेन्ट थियो।<verse eid="1KI 10:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 10:15"/>यसमा व्यापारी र व्यवसायीहरू, अरबका राजाहरू र देशका राज्यपालहरूद्वारा ल्याइएको राजकर सामेल थिएन।<verse eid="1KI 10:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 10:16"/>राजा सोलोमनले पिटेको सुनका दुई सय वटा ठूला-ठूला ढालहरू बनाए। हरेक ढालमा छ सय शेकेल पिटिएको सुन लागेको थियो।<verse eid="1KI 10:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 10:17"/>तिनले तीन सय वटा पिटेको सुनका स-साना ढालहरू बनाए, जसमा प्रत्येक ढालमा तीन मीना सुन थियो। राजाले ती लेबनानको वनमा भएको महलमा राखे।<verse eid="1KI 10:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 10:18"/>त्यसपछि राजाले एउटा ठूलो सिंहासन बनाए; अनि त्यसलाई हस्तीदन्त र निखुर सुनले मोहोरे।<verse eid="1KI 10:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 10:19"/>त्यस सिंहासनमा छ वटा खुड्किलाहरू थिए। त्यसको पछिल्तिर गोलाकार टुप्पो बनाइएको थियो। आसनका दुवैतिर हात राख्ने बाहु थिए। प्रत्येक बाहुको छेउ-छेउमा एक-एक वटा सिंह खडा गरिएको थियो।<verse eid="1KI 10:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 10:20"/>ती छ वटा खुड्किलाहरूमा, प्रत्येक खुड्किलामा दुई-दुई गरी जम्मा बाह्र वटा सिंहहरू थिए। कुनै पनि राज्यमा योजस्तो कहिल्यै बनाइएको थिएन।<verse eid="1KI 10:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 10:21"/>राजा सोलोमनका सबै कचौराहरू सुनका थिए। लेबनानको वनको महलका सबै घरका सामानहरू निखुर सुनका थिए। कुनै पनि चीज चाँदीको बनाइएको थिएन; किनकि सोलोमनको समयमा चाँदी कम मूल्यको गनिन्थ्यो।<verse eid="1KI 10:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 10:22"/>हीरामका जहाजहरूको साथमा, राजाका व्यापारी जहाजहरूको एक दल थियो। प्रत्येक तीन वर्षमा ती जहाजहरूले सुन, चाँदी, हस्तीदन्त, ढेढुहरू र मयूरहरू लिएर आउँथे।<verse eid="1KI 10:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 10:23"/>यसरी राजा सोलोमन धन र बुद्धिमा संसारका सबै राजाहरूभन्दा महान् थिए।<verse eid="1KI 10:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 10:24"/>परमेश्‍वरले तिनको हृदयमा राखिदिनुभएको बुद्धि सुन्‍नका निम्ति सारा जगत् तिनको सामु जाने इच्छा गर्दथ्यो।<verse eid="1KI 10:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 10:25"/>वर्षैपिच्छे आउने हरेकले उपहारस्वरूप चाँदी र सुनका सामानहरू, वस्त्रहरू, हतियारहरू, मसलाहरू, घोडाहरू र खच्‍चरहरू ल्याउँथे।<verse eid="1KI 10:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 10:26"/>सोलोमनले रथहरू र घोडाहरू जम्मा गरे। तिनीसित चौध सय रथ र बाह्र हजार घोडा थिए; जसलाई तिनले सहरहरूमा र आफूसित पनि यरूशलेममा राखे।<verse eid="1KI 10:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 10:27"/>राजाले यरूशलेममा चाँदीलाई ढुङ्गा जतिकै साधारण अनि देवदारुलाई चाहिँ पहाडका फेदीहरूका अञ्जीर जतिकै प्रशस्त बनाए।<verse eid="1KI 10:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 10:28"/>सोलोमनका घोडाहरू इजिप्टबाट र क्यूएबाट आयात गरिन्थे। राजाका व्यापारीहरूले ती क्यूएबाट राम्रो दाममा किन्थे।<verse eid="1KI 10:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 10:29"/>तिनीहरूले इजिप्टबाट एउटा रथ चाँदीका छ सय शेकेलमा र एउटा घोडाचाहिँ एक सय पचास शेकेलमा किन्थे। तिनीहरूले ती हित्तीहरूका र अरामीहरूका सबै राजाहरूलाई निर्यात पनि गर्थे।<verse eid="1KI 10:29"/></para>
<chapter eid="1KI 10"/>
<chapter number="11" style="c" sid="1KI 11"/>
<para style="p"><verse number="1" style="v" sid="1KI 11:1"/>राजा सोलोमनले धेरै विदेशी स्त्रीहरूसित प्रेम गरे। तिनले फारोकी छोरीबाहेक मोआबी, अम्मोनी, एदोमी, सीदोनी र हित्तीहरूसित विवाह गरे।<verse eid="1KI 11:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 11:2"/>तिनीहरू ती राष्ट्रहरूका थिए, जसको विषयमा याहवेहले इस्राएलीहरूलाई, “तिमीहरूले तिनीहरूसित अन्तर-विवाह नगर्नू। किनकि निश्‍चय नै तिनीहरूले तिमीहरूका हृदयलाई तिनीहरूका देवी-देवताहरूतिर फर्काइदिनेछन्।” भन्‍नुभएको थियो, तैपनि सोलोमन तिनीहरूको प्रेममा आसक्त भए।<verse eid="1KI 11:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 11:3"/>तिनका राज घरानामा जन्मिएका सात सय पत्नीहरू, र तीन सय उपपत्नीहरू थिए। तिनका पत्नीहरूले तिनलाई याहवेहबाट बहकाए।<verse eid="1KI 11:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 11:4"/>सोलोमनको उमेर ढल्कँदै जाँदा तिनका पत्नीहरूले तिनको हृदय अन्य देवी-देवताहरूतिर फर्काइदिए र तिनको हृदय तिनका पिता दावीदको जस्तै सम्पूर्ण रूपले परमेश्‍वरप्रति विश्‍वासयोग्य भएन।<verse eid="1KI 11:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 11:5"/>तिनले सीदोनीहरूकी देवी अश्तोरेत र अम्मोनीहरूका घिनलाग्दा देवता मोलेखको आराधना गरे।<verse eid="1KI 11:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 11:6"/>यसरी सोलोमनले याहवेहको दृष्‍टिमा दुष्‍टता गरे; तिनले आफ्ना पिता दावीदले झैँ पूर्ण रूपले याहवेहलाई पछ्याएनन्।<verse eid="1KI 11:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 11:7"/>सोलोमनले यरूशलेमको पूर्वपट्टिको पहाडमा मोआबको घृणित देवता कमोश र अम्मोनीहरूको घृणित देवता मोलेखका निम्ति एउटा उच्‍च देवस्थान बनाइदिए।<verse eid="1KI 11:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 11:8"/>यसरी तिनले तिनका सबै विदेशी पत्नीहरूका निम्ति उनीहरूका आ-आफ्ना देवताहरूका सामु धूप बाल्ने र बलिदान चढाउने ठाउँ बनाइदिए।<verse eid="1KI 11:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 11:9"/>सोलोमनकहाँ दुई पल्ट देखा पर्नुहुने याहवेह, इस्राएलका परमेश्‍वरदेखि तिनी तर्किगएकाले याहवेह तिनीसित रिसाउनुभयो।<verse eid="1KI 11:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 11:10"/>याहवेहले अन्य देवी-देवताहरूको पछि लाग्नदेखि मनाही गर्नुभएको भए तापनि सोलोमनले उहाँको आज्ञापालन गरेनन्।<verse eid="1KI 11:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 11:11"/>यसकारण याहवेहले सोलोमनलाई भन्‍नुभयो, “तेरो व्यवहार यस्तो भएकोले, र मैले तँलाई आज्ञा गरेका मेरो करार र उर्दीहरू पालन नगरेकोले, म निश्‍चय नै तेरो यो राज्य तँबाट खोसेर तेरो एक जना सेवकलाई दिनेछु।<verse eid="1KI 11:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 11:12"/>तैपनि तेरो पिता दावीदको कारण, म तेरो जीवनकालमा यसो गर्नेछैनँ। म यो राज्य तेरो छोराको हातबाट खोस्‍नेछु।<verse eid="1KI 11:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 11:13"/>तापनि म त्यसबाट सम्पूर्ण राज्य खोस्‍नेछैनँ; तर मेरो सेवक दावीदको खातिर र मैले चुनेको यरूशलेमको खातिर म त्यसलाई एउटा कुलचाहिँ दिनेछु।”<verse eid="1KI 11:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 11:14"/>तब याहवेहले एदोमको राजकीय घरानाको एदोमी हददलाई सोलोमनको विरुद्धमा खडा गराउनुभयो।<verse eid="1KI 11:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 11:15"/>सुरुमा जब दावीदले एदोमसित लडाइँ गर्दैगर्दा, फौजका सेनापति योआबले मरेकाहरूलाई गाड्न गएको बेला, एदोमका सबै पुरुषहरूलाई मारेका थिए।<verse eid="1KI 11:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 11:16"/>एदोममा भएका सबै मानिसहरूलाई नष्‍ट नपारेसम्म, योआब र सारा इस्राएलीहरू छ महिनासम्म त्यहीँ बसेका थिए।<verse eid="1KI 11:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 11:17"/>तर त्यस बेला हददचाहिँ सानै थिए। अनि आफ्ना पिताको सेवा गर्ने केही एदोमी अधिकृतहरूसित भागेर तिनी इजिप्टमा पुगे।<verse eid="1KI 11:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 11:18"/>तिनीहरू मिद्यानबाट हिँडे, र पारानमा गए। तब आफूसित पारानका मानिसहरू लिएर तिनीहरू इजिप्टमा त्यहाँका राजा फारोकहाँ गए, जसले हददलाई एउटा घर, जमिन र भोजन जुटाइदिए।<verse eid="1KI 11:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 11:19"/>हददसित फारो यति खुशी भए कि तिनले आफ्नी पत्नी रानी तहपनेसकी बहिनीलाई तिनीसित विवाह गरिदिए।<verse eid="1KI 11:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 11:20"/>तहपनेसकी बहिनीले गनूबत नाम गरेको एउटा छोरा जन्माइन् र गनूबतलाई राजकीय महलमा फारोका छोराछोरीसित हुर्काइन्।<verse eid="1KI 11:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 11:21"/>हदद इजिप्टमा हुँदा तिनले दावीद आफ्ना पुर्खाहरूसित विश्राममा प्रवेश गरेको र फौजका सेनापति योआबको पनि मृत्यु भएको कुरा सुने। तब हददले फारोलाई भने, “मलाई आफ्नै देशमा फर्केर जान दिनुहोस्।”<verse eid="1KI 11:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 11:22"/>फारोले सोधे, “तपाईंलाई यहाँ के कुराको अभाव छ र तपाईं आफ्नै देशमा जान चाहनुहुन्छ?” हददले जवाफ दिए, “केही कुराको अभाव छैन; तैपनि बिन्ती छ, मलाई जान दिनुहोस्!”<verse eid="1KI 11:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 11:23"/>परमेश्‍वरले सोलोमनको विरुद्धमा अर्को विरोधीलाई खडा गर्नुभयो, जो एल्यादाको छोरो रेसोन थियो, र त्यो आफ्ना मालिक सोबाका राजा हददेजेरबाट भागेको थियो।<verse eid="1KI 11:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 11:24"/>जब दावीदले सोबाको फौजलाई ध्वस्त पारे, तब रेसोनले आफ्ना चारैतिर मानिसहरू जम्मा गरे, र लुटेराहरूका दल बनाए। अनि आफूचाहिँ तिनीहरूका अगुवा बने। तिनीहरू दमस्कसमा गए; जहाँ तिनीहरू बसोबास गरे, र त्यसलाई आफ्नो अधीनमा लिए।<verse eid="1KI 11:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 11:25"/>सोलोमन बाँचुन्जेल रेसोन इस्राएलका विरोधी नै भइरहे, जसले हददले निम्त्याएका समस्यामा अझ थपिदिए। तसर्थ रेसोनले अराममा राज्य गरे र इस्राएलसँग शत्रुता राखे।<verse eid="1KI 11:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 11:26"/>नबातका छोरा यारोबाम पनि राजाको विरुद्धमा बागी भए। तिनी सार्तानको एक एफ्राइमी र सोलोमनका एक अधिकारी थिए। तिनकी सेरूआ नाम भएकी विधवा आमा थिइन्।<verse eid="1KI 11:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 11:27"/>यारोबामले किन राजाको विरोध गरे, त्यसको वृतान्त यस्तो छ: सोलोमनले आधारका लागि कौसीहरू बनाए र तिनका पिता दावीदको सहरको पर्खालका खाली ठाउँलाई भरिदिएका थिए।<verse eid="1KI 11:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 11:28"/>यारोबामचाहिँ होनहार जवान थिए। ती जवान मानिसको परिश्रम देखेर सोलोमनले तिनलाई योसेफको घरानाका सम्पूर्ण मजदुरहरूका नाइके बनाइदिए।<verse eid="1KI 11:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 11:29"/>त्यस बेला यारोबामचाहिँ यरूशलेमबाट बाहिर जाँदैथिए, र तिनलाई नयाँ खास्टो ओढेका शीलोका अगमवक्ता अहीयाहले बाटोमा भेटे। त्यस मैदानमा तिनीहरू दुई जना मात्र थिए।<verse eid="1KI 11:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 11:30"/>अहीयाहले आफूले ओढेको नयाँ खास्टो समाते र त्यसलाई च्यातेर बाह्र टुक्रा पारे।<verse eid="1KI 11:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 11:31"/>तब तिनले यारोबामलाई भने, “तिमीले आफ्ना निम्ति दश टुक्रा लेऊ; किनकि याहवेह इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘हेर्, म सोलोमनको हातबाट राज्य खोसेर तँलाई दश वटा कुल दिनेछु।<verse eid="1KI 11:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 11:32"/>तर मेरो सेवक दावीद र यरूशलेम सहरको खातिर, जसलाई मैले इस्राएलका कुलहरूबाट चुनेँ, एउटा कुल त्यससित रहनेछ।<verse eid="1KI 11:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 11:33"/>म यो गर्नेछु, किनकि तिनीहरूले मलाई त्यागेर सीदोनीहरूकी देवी अश्तोरेत, मोआबीहरूको देवता कमोश र अम्मोनीमहरूको देवता मोलेखलाई पुजेका छन्; अनि मेरा मार्गहरूमा हिँडेका छैनन्। न त मेरो दृष्‍टिमा जे ठिक छ, ती गरेका छन्; न त सोलोमनका पिता दावीदले झैँ मेरा उर्दीहरू, व्यवस्थाहरू पालन गरेका छन्।<verse eid="1KI 11:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 11:34"/>“ ‘तर म सोलोमनको हातबाट सम्पूर्ण राज्य लानेछैनँ। मैले चुनेको मेरो दास दावीदको खातिर म सोलोमनलाई त्यसको जीवनकालभरिको लागि शासक बनाइराख्नेछु। किनकि उसले मेरा आज्ञाहरू र उर्दीहरू पालन गरेको थियो।<verse eid="1KI 11:34"/></para>
<para style="p"><verse number="35" style="v" sid="1KI 11:35"/>म त्यसको छोराको हातबाट राज्य लिएर तँलाई दश कुल दिनेछु।<verse eid="1KI 11:35"/></para>
<para style="p"><verse number="36" style="v" sid="1KI 11:36"/>म त्यसको छोरालाई एक कुल दिनेछु; ताकि मैले आफ्नो नाम राख्न चुनेको यरूशलेम सहरमा मेरो सेवक दावीदको निम्ति एउटा बत्ती सधैँभरि मेरो सामु बलिरहोस्।<verse eid="1KI 11:36"/></para>
<para style="p"><verse number="37" style="v" sid="1KI 11:37"/>तैपनि तेरो विषयमा चाहिँ म तँलाई लिनेछु, र तेरो हृदयले इच्छा गरेका सबैमाथि तैँले शासन गर्नेछस्; र तँ इस्राएलको राजा हुनेछस्।<verse eid="1KI 11:37"/></para>
<para style="p"><verse number="38" style="v" sid="1KI 11:38"/>मैले आज्ञा दिएका सबै कुराहरू तैँले पालन गरिस् र मेरा सेवक दावीदले गरेझैँ मेरा मार्गहरूमा हिँडिस्, मेरा उर्दीहरू र आज्ञाहरू पालन गरेर मेरो दृष्‍टिमा जे ठिक छ, त्यो गरिस् भने म तँसित हुनेछु। मैले दावीदको निम्ति गरेझैँ म तेरो निम्ति एउटा वंश खडा गरिदिनेछु, र इस्राएल तँलाई दिनेछु।<verse eid="1KI 11:38"/></para>
<para style="p"><verse number="39" style="v" sid="1KI 11:39"/>यसैकारण म दावीदको सन्तानलाई नम्र तुल्याउनेछु, तर सधैँभरिका लागि होइन।’ ”<verse eid="1KI 11:39"/></para>
<para style="p"><verse number="40" style="v" sid="1KI 11:40"/>सोलोमनले यारोबामलाई मार्न खोजे, तर यारोबाम इजिप्टमा राजा शीशककहाँ भागेर गए। सोलोमनको मृत्यु नभएसम्म त्यहीँ बसे।<verse eid="1KI 11:40"/></para>
<para style="p"><verse number="41" style="v" sid="1KI 11:41"/>सोलोमनको शासनकालका अरू घटनाहरूको विषयमा, र तिनले गरेका सबै कामहरू अनि देखाएका सबै बुद्धिहरूको विषयमा सोलोमनको इतिहासको पुस्तकमा ती लेखिएका छन्।<verse eid="1KI 11:41"/></para>
<para style="p"><verse number="42" style="v" sid="1KI 11:42"/>सोलोमनले सारा इस्राएलमाथि यरूशलेममा चालीस वर्ष राज्य गरे।<verse eid="1KI 11:42"/></para>
<para style="p"><verse number="43" style="v" sid="1KI 11:43"/>त्यसपछि तिनी आफ्ना पुर्खाहरूसित सुते, र आफ्ना पिता दावीदको सहरका चिहानमा गाडिए। तिनीपछि तिनका छोरा रहबाम राजा भए।<verse eid="1KI 11:43"/></para>
<chapter eid="1KI 11"/>
<chapter number="12" style="c" sid="1KI 12"/>
<para style="p"><verse number="1" style="v" sid="1KI 12:1"/>सारा इस्राएलले तिनलाई शेकेममा राजा बनाउन गएकाले रहबाम त्यहाँ गए।<verse eid="1KI 12:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 12:2"/>जब नबातका छोरा यारोबामले यो कुरा सुने, (तिनी राजा सोलोमनदेखि भागेर गएदेखि इजिप्टमा नै थिए), तब तिनी इजिप्टबाट फर्किए।<verse eid="1KI 12:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 12:3"/>यसकारण तिनीहरूले यारोबामलाई बोलाउन पठाए। अनि तिनी र इस्राएलको समुदाय रहबामकहाँ गएर तिनलाई भने:<verse eid="1KI 12:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 12:4"/>“तपाईंका पिताले हामीमाथि गह्रौँ जुवा राखिदिनुभएको थियो। अब उहाँले हामीमाथि लगाइदिनुभएको त्यस कठोर परिश्रम र गह्रौँ जुवालाई हलुङ्गो पारिदिनुहोस्; र हामी तपाईंको सेवा गर्नेछौँ।”<verse eid="1KI 12:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 12:5"/>रहबामले जवाफ दिए, “मलाई सोच्नको लागि तीन दिन दिनुहोस्। त्यसपछि मकहाँ फर्केर आउनुहोस्।” यसकारण मानिसहरू गए।<verse eid="1KI 12:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 12:6"/>तब राजा रहबामले तिनका पिता सोलोमन जीवित छँदा, तिनका सेवा गर्ने प्रधानहरूसित यसो भनेर सल्‍लाह मागे, “यी मानिसहरूलाई म के जवाफ दिऊँ? तपाईंहरूले मलाई के सल्‍लाह दिनुहुन्छ?”<verse eid="1KI 12:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 12:7"/>तिनीहरूले उत्तर दिए, “यदि आज तपाईं यी मानिसहरूका सेवक बन्‍नुभयो र तिनीहरूलाई मनपर्दो जवाफ दिनुभयो भने तिनीहरू सधैँभरि नै तपाईंका सेवक हुनेछन्।”<verse eid="1KI 12:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 12:8"/>तर रहबामले प्रधानहरूले दिएका सल्‍लाह इन्कार गरे; अनि तिनीसितै हुर्केका र तिनकै सेवा गरिरहेका जवान मानिसहरूसित सल्‍लाह लिए।<verse eid="1KI 12:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 12:9"/>तिनले तिनीहरूलाई सोधे, “तिमीहरूले के सल्‍लाह दिन्छौ? ‘तपाईंका पिताले हामीमाथि राखिदिनुभएको बोझ अलिक हल्का पारिदिनुहोस्’ भन्‍ने यी मानिसहरूलाई कसरी जवाफ दिऊँ?”<verse eid="1KI 12:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 12:10"/>तिनीसितै हुर्केका ती जवान मानिसहरूले जवाफ दिए, “तपाईंलाई ‘तपाईंका पिताले हामीमाथि गह्रौँ जुवा राखिदिनुभयो; तर हाम्रा जुवा हल्का पारिदिनुहोस्’ भन्‍ने यी मानिसहरूलाई यसो भन्‍नुहोस्, ‘मेरो कान्छी औँला मेरा पिताको कम्मरभन्दा झन् मोटो छ।<verse eid="1KI 12:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 12:11"/>मेरा पिताले तिमीहरूमाथि गह्रौँ जुवा राखिदिनुभयो; म त्यसलाई अझ गह्रौँ पारिदिनेछु। मेरा पिताले तिमीहरूलाई कोर्राले ताडना दिनुभयो, तर मचाहिँ तिमीहरूलाई बिच्छीहरूले डस्‍न लगाउनेछु।’<verse eid="1KI 12:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 12:12"/>“तीन दिनमा मकहाँ फर्केर आउनुहोस्” भनी राजाले भनेझैँ, तीन दिनपछि यारोबाम र सबै मानिसहरू रहबामकहाँ आए।<verse eid="1KI 12:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 12:13"/>राजाले ती मानिसहरूलाई कठोरतापूर्वक जवाफ दिए। ती प्रधानहरूले तिनलाई दिएको सल्‍लाहलाई इन्कार गरे।<verse eid="1KI 12:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 12:14"/>तिनले जवान मानिसहरूको सल्‍लाह सुनेर यसो भने, “मेरा पिताले तपाईंहरूमाथि गह्रौँ जुवा राखिदिनुभयो; म त्यसलाई झन् गह्रौँ पारिदिनेछु। मेरा पिताले तपाईंहरूलाई कोर्राले ताडना दिनुभयो; तर मचाहिँ तपाईंहरूलाई बिच्छीहरूले डस्‍न लाउनेछु।”<verse eid="1KI 12:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 12:15"/>यसरी राजाले मानिसहरूका कुरा सुनेनन्; किनकि याहवेहले शीलोका अहीयाहद्वारा नबातका छोरा यारोबामलाई भन्‍नुभएको वचन यसरी नै पूरा हुनुपर्थ्यो।<verse eid="1KI 12:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 12:16"/>जब सारा इस्राएलले राजाले तिनीहरूका कुरा नसुनेका देखे; तिनीहरूले राजालाई जवाफ दिए: “दावीदमा हाम्रो के हिस्सा छ, यिशैका छोरामा के भाग छ? हे इस्राएल, आफ्ना पालहरूमा जाओ! हे दावीद, तिमी आफ्नै घर सम्हाल!” यसरी इस्राएलीहरू आ-आफ्ना घरतिर गए।<verse eid="1KI 12:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 12:17"/>तर यहूदाका सहरहरूमै बसिरहेका इस्राएलीहरूमाथि रहबामले नै शासन गरे।<verse eid="1KI 12:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 12:18"/>राजा रहबामले ज्यालाविना काममा लगाउनेका जिम्मावाल अदोनीरामलाई पठाए; तर सारा इस्राएलले तिनलाई ढुङ्गाले हानेर मारे। तर राजा रहबाम आफ्नो रथमा चढेर यरूशलेममा भागेर जान सफल भए।<verse eid="1KI 12:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 12:19"/>यसकारण इस्राएल आजको दिनसम्मै दावीदको घरानाको विरुद्धमा छ।<verse eid="1KI 12:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 12:20"/>जब सारा इस्राएलीहरूले यारोबाम फर्किआएको कुरा सुने, तब तिनीहरूले खबर पठाएर तिनलाई सभामा बोलाए। अनि तिनलाई सारा इस्राएलमाथि राजा तुल्याए; र यहूदाको कुल मात्र दावीदको घरानाप्रति विश्‍वासयोग्य भइरहे।<verse eid="1KI 12:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 12:21"/>जब रहबाम यरूशलेममा आइपुगे, तब आफ्नो राज्य फिर्ता ल्याउने उद्देश्यले इस्राएलको विरुद्धमा लडाइँ गर्नलाई सारा यहूदा र बेन्यामीनका घरानाबाट एक लाख असी हजार लडाकु मानिसहरू बटुले।<verse eid="1KI 12:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 12:22"/>तर परमेश्‍वरको यो वचन उहाँको जन शमायाहकहाँ आयो:<verse eid="1KI 12:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 12:23"/>“यहूदाका राजा सोलोमनका छोरा रहबाम, यहूदा र बेन्यामीनका सम्पूर्ण घरानालाई अनि बाँकी रहेका मानिसहरूलाई यसो भन्:<verse eid="1KI 12:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 12:24"/>याहवेह यसो भन्‍नुहुन्छ, ‘आफ्ना दाजुभाइ इस्राएलीहरूको विरुद्धमा लडाइँ गर्न नजानू। तिमीहरू प्रत्येक आ-आफ्ना घरमा फर्केर जाओ; किनकि यो कुरा मैले नै गरेको हुँ।’ ” यसकारण तिनीहरूले याहवेहको वचन माने; अनि याहवेहले आज्ञा गर्नुभएझैँ तिनीहरू फेरि आ-आफ्ना घर फर्के।<verse eid="1KI 12:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 12:25"/>तब यारोबामले एफ्राइमको पहाडी देशमा भएको शेकेमलाई सुदृढ पारे र त्यहीँ नै बसोबास गरे। त्यहाँबाट गएर तिनले पनीएल सहर निर्माण गरे।<verse eid="1KI 12:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 12:26"/>यारोबामले यसरी विचार गरे, “यो राज्य अब दावीदको घरानाकहाँ नै फर्किजानेछ।<verse eid="1KI 12:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 12:27"/>यी मानिसहरू बलिदान चढाउन यरूशलेममा याहवेहको मन्दिरमा गए भने यिनीहरूले आफ्नो राजभक्ति यिनीहरूका मालिक यहूदाका राजा रहबामलाई फेरि दिनेछन्। यिनीहरूले मलाई मारेर राजा रहबामतिर फर्कनेछन्।”<verse eid="1KI 12:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 12:28"/>राजाले सरसल्‍लाह लिइसकेपछि, तिनले सुनका दुई वटा बाछाहरू बनाए। तब तिनले मानिसहरूलाई भने, “यरूशलेममा जान तिमीहरूलाई अति गाह्रो पर्छ। हे इस्राएल हो, तिमीहरूलाई इजिप्टबाट बाहिर निकालेर ल्याउने देवी-देवताहरू यहाँ छन्।”<verse eid="1KI 12:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 12:29"/>तिनले एउटालाई बेथेलमा र अर्कोलाई दानमा खडा गरे।<verse eid="1KI 12:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 12:30"/>योचाहिँ पाप भयो; मानिसहरू दानमा भएको बाछालाई पुज्न त्यति टाढासम्म पनि गए।<verse eid="1KI 12:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 12:31"/>यारोबामले अग्ला ठाउँहरूमा देवस्थानहरू बनाए। सबै किसिमका मानिसहरूबाट पुजारीहरू नियुक्त गरे, जो लेवी कुलका थिएनन्।<verse eid="1KI 12:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 12:32"/>तिनले यहूदामा मनाइने चाडजस्तै बेथेलमा पनि आठौँ महिनाको पन्ध्रौँ दिनमा एउटा चाड स्थापना गरे। अनि वेदीमा बलिदानहरू चढाए। यसरी तिनले बेथेलमा आफूले बनाएका बाछाहरूका निम्ति बलिदान चढाए। बेथेलमा आफूले बनाएका अग्ला देवस्थानहरूमा तिनले पुजारीहरू पनि नियुक्त गरे।<verse eid="1KI 12:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 12:33"/>आठौँ महिनाको पन्ध्रौँ दिनमा आफूले रोजेको महिनामा, तिनले बेथेलमा आफूले बनाएको वेदीमा बलिदानहरू चढाए। यसरी तिनले इस्राएलीहरूका निम्ति त्यो चाड स्थापना गरे, र भेटीहरू चढाउन वेदीमा गए।<verse eid="1KI 12:33"/></para>
<chapter eid="1KI 12"/>
<chapter number="13" style="c" sid="1KI 13"/>
<para style="p"><verse number="1" style="v" sid="1KI 13:1"/>जब यारोबाम भेटी चढाउनलाई वेदीको छेउमा उभिरहेका थिए, तब याहवेहको वचनद्वारा यहूदाबाट परमेश्‍वरका एक जन बेथेलमा आए।<verse eid="1KI 13:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 13:2"/>याहवेहको वचनद्वारा तिनले त्यस वेदीको विरुद्धमा कराएर यसो भने, “हे वेदी, वेदी! याहवेह यसो भन्‍नुहुन्छ: ‘दावीदको घरानामा योशियाह नाम भएको एउटा छोरा जन्मनेछ। त्यसले अहिले यहाँ अल्गा देवस्थानहरूमा बलिदान चढाइरहेका पुजारीहरूलाई तँमाथि नै बलिदान चढाउनेछ। अनि मानिसका हड्डीहरू तँमाथि जलाइनेछन्।’ ”<verse eid="1KI 13:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 13:3"/>त्यही दिन परमेश्‍वरका जनले एउटा चिन्ह दिए, “याहवेहले घोषणा गर्नुभएको चिन्हचाहिँ यही हो: यो वेदी दुई फ्याक हुनेछ। यसमा भएको खरानी बाहिर पोखिनेछ।”<verse eid="1KI 13:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 13:4"/>परमेश्‍वरका जनले बेथेलमा भएको वेदीको विरुद्धमा कराएर भनेको कुरा जब राजा यारोबामले सुने, तब तिनले वेदीबाट आफ्नो हात परमेश्‍वरको जन अगमवक्तातिर पसारेर भने, “त्यसलाई पक्र!” तर तिनीतिर पसारिएको राजाको हात सुक्यो। अनि राजाले फेरि आफ्नो हात आफूतिर तान्‍न सकेनन्।<verse eid="1KI 13:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 13:5"/>याहवेहको वचनद्वारा परमेश्‍वरका जनले दिएका चिन्हअनुसार वेदी पनि दुई भाग भयो; अनि खरानी बाहिर पोखियो।<verse eid="1KI 13:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 13:6"/>तब राजाले परमेश्‍वरका जनलाई भने, “मेरो हात ठिक भइजाओस् भनेर याहवेह तपाईंको परमेश्‍वरसित मेरा निम्ति प्रार्थना गरिदिनुहोस्!” यसकारण परमेश्‍वरका जनले परमेश्‍वरसित तिनको निम्ति बिन्ती गरिदिए। तब राजाको हात ठिक भएर पहिलेको जस्तै भयो।<verse eid="1KI 13:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 13:7"/>राजाले परमेश्‍वरका जनलाई भने, “मसित घरमा आएर केही खानुहोस्, र म तपाईंलाई एउटा उपहार दिनेछु।”<verse eid="1KI 13:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 13:8"/>तर परमेश्‍वरका जनले राजालाई जवाफ दिए, “तपाईंले मलाई आफ्नो सम्पत्तिको आधा भागै दिनुभयो भने पनि म तपाईंसित जानेछैनँ, न त यहाँ खाना खानेछु; न पानी नै पिउनेछु।<verse eid="1KI 13:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 13:9"/>किनकि मलाई याहवेहको वचनद्वारा ‘तैँले केही नखानू र पानी पनि नपिउनू; अनि तँ आएको बाटो भएर नफर्कनू’ भन्‍ने हुकुम भएको छ।”<verse eid="1KI 13:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 13:10"/>यसकारण तिनी जुन बाटोबाट बेथेलमा आएका थिए, त्यो बाटोबाट होइन, तर अर्कै बाटो भएर फर्किगए।<verse eid="1KI 13:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 13:11"/>बेथेलमा एक जना वृद्ध अगमवक्ता बस्थे। उनका छोराहरूले परमेश्‍वरका जनले त्यस दिन जे गरेका थिए, ती सबै आएर तिनलाई सुनाइदिए। तिनीहरूले आफ्ना पितालाई तिनले राजालाई भनेको कुरा पनि सुनाइदिए।<verse eid="1KI 13:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 13:12"/>तिनीहरूका पिताले तिनीहरूलाई सोधे, “तिनी कतातिर गए?” अनि तिनका छोराहरूले तिनलाई यहूदाबाट आएका परमेश्‍वरका जन कुन बाटो भएर गए, त्यो तिनलाई देखाइदिए।<verse eid="1KI 13:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 13:13"/>यसकारण तिनले आफ्ना छोराहरूलाई भने, “मेरा निम्ति गधामा काठी कसिदेओ।” तिनीहरूले उनका निम्ति गधामा काठी कसिदिए। तब तिनी त्यसमाथि चढे,<verse eid="1KI 13:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 13:14"/>अनि परमेश्‍वरका जनको खोजीमा लागे। तिनले उनलाई एउटा फलाँटको रूखमुनि बसिरहेको भेट्टाए, र सोधे, “के यहूदाबाट आउने परमेश्‍वरका जन तपाईं नै हुनुहुन्छ?” तिनले जवाफ दिए, “हजुर, म नै हुँ।”<verse eid="1KI 13:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 13:15"/>यसकारण ती अगमवक्ताले तिनलाई भने, “मसित घरमा आएर खानपान गर्नुहोस्।”<verse eid="1KI 13:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 13:16"/>परमेश्‍वरका जनले भने, “म तपाईंसित फर्केर जान सक्दिनँ। यस ठाउँमा म तपाईंसित न त केही खान सक्छु, न त पानी नै पिउन सक्छु।<verse eid="1KI 13:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 13:17"/>मलाई याहवेहको वचनद्वारा ‘तैँले त्यहाँ केही नखानू, र पानी पनि नपिउनू र तँ आएको बाटो भएर नजानू’ भनिएको छ।”<verse eid="1KI 13:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 13:18"/>ती वृद्ध अगमवक्ताले भने, “म पनि तपाईंझैँ एक अगमवक्ता हुँ। एक जना स्वर्गदूतले याहवेहको वचनद्वारा ‘तिनलाई आफूसित तिम्रो घरमा फर्काएर ल्याउनू र तिनले खाना खाऊन् र पानी पिऊन्’ भनी मलाई भनेका छन्।” (तर तिनले उनलाई झूटो बोलेका थिए।)<verse eid="1KI 13:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 13:19"/>यसकारण परमेश्‍वरका जनले तिनीसित गएर तिनको घरमा खानपान गरे।<verse eid="1KI 13:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 13:20"/>तिनीहरू टेबुलमा बसिरहेका बेला याहवेहको वचन तिनलाई फर्काएर ल्याउने ती वृद्ध अगमवक्ताकहाँ आयो।<verse eid="1KI 13:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 13:21"/>तिनले यहूदाबाट आउने परमेश्‍वरको जनलाई कराएर भने, “याहवेह यसो भन्‍नुहुन्छ: ‘तैँले याहवेहको वचनलाई अशुद्ध तुल्याइस्, र याहवेह तेरा परमेश्‍वरले तँलाई दिनुभएका आज्ञाहरू पालन गरिनस्।<verse eid="1KI 13:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 13:22"/>तँ फर्केर आइस्, र उहाँले तँलाई नखानू र नपिउनू भनेको ठाउँमा तैँले खाइस् र पिइस्। यसकारण तेरो शरीर तेरा पितापुर्खाहरूसित गाडिनेछैन।’ ”<verse eid="1KI 13:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 13:23"/>जब परमेश्‍वरका जनले खानपान गरे, तब तिनलाई फर्काएर ल्याउने ती अगमवक्ताले तिनका निम्ति गधामा काठी कसिदिए।<verse eid="1KI 13:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 13:24"/>जब तिनी आफ्नो बाटोमा अगि बढिरहेका थिए, तब एउटा सिंहले बाटोमा तिनलाई फेला पार्‍यो, र मार्‍यो। तिनको लास बाटोमा फ्याँकियो। अनि त्यो गधा र सिंहचाहिँ त्यस लासको छेउमा उभिरहे।<verse eid="1KI 13:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 13:25"/>त्यो बाटो भएर जाने केही मानिसहरूले त्यस शरीरलाई बाटोमा फ्याँकिएको र त्यो सिंहचाहिँ त्यस लासको छेउमा उभिरहेको देखे। तिनीहरूले गएर ती वृद्ध अगमवक्ता बसेको सहरमा त्यो खबर सुनाए।<verse eid="1KI 13:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 13:26"/>तिनलाई आफ्नो यात्राबाट फर्काएर ल्याउने ती अगमवक्ताले यस विषयमा सुनेपछि तिनले भने, “तिनी परमेश्‍वरका जन नै हुन्, जसले याहवेहको वचनलाई अवहेलना गरेका थिए। याहवेहले तिनलाई सिंहकहाँ सुम्पिदिनुभएको छ। याहवेहको वचनले चेताउनी दिएझैँ त्यस सिंहले उनलाई फहराएर मारेछ।”<verse eid="1KI 13:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 13:27"/>ती अगमवक्ताले आफ्ना छोराहरूलाई भने, “मेरा निम्ति गधामा काठी कसिदेओ,” अनि तिनीहरूले त्यसै गरे।<verse eid="1KI 13:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 13:28"/>तब तिनी निस्केर गए, र तिनको लास बाटोमै फ्याँकिएको; अनि गधा र सिंह त्यस लासको छेउमा उभिरहेको भेट्टाए। त्यो सिंहले त्यस लासलाई खाएको थिएन, न त त्यस गधालाई नै फहराएको थियो।<verse eid="1KI 13:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 13:29"/>यसकारण ती अगमवक्ताले परमेश्‍वरका जनको लासलाई उठाएर गधामाथि राखे। अनि उनका निम्ति शोक गर्न र उनलाई गाड्न आफ्नो सहरमा ल्याए।<verse eid="1KI 13:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 13:30"/>तब तिनले त्यस लासलाई आफ्नै चिहानमा गाडे; अनि तिनीहरूले यसो भनेर विलाप गरे, “हाय, मेरो भाइ!”<verse eid="1KI 13:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 13:31"/>तिनलाई गाडेपछि तिनले आफ्ना छोराहरूलाई भने, “म मरेपछि मलाई परमेश्‍वरका जन गाडिएको ठाउँमा गाड्नू। मेरा हड्डीहरू तिनका हड्डीहरूको छेउमै राख्नू।<verse eid="1KI 13:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 13:32"/>किनकि तिनले याहवेहको वचनद्वारा बेथेलमा भएको वेदी र सामरियाका सहरहरूका अग्ला ठाउँहरूमा देवस्थानहरूका विरुद्धमा घोषणा गरेको वचन निश्‍चय पूरा हुनेछ।”<verse eid="1KI 13:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 13:33"/>यसपछि पनि यारोबाम आफ्ना दुष्‍ट चालहरूबाट फर्केनन्। तिनले सबै किसिमका मानिसहरूबाट अल्गा देवस्थानहरूका निम्ति पुजारीहरू नियुक्त गरे। पुजारी हुन इच्छुक जोसुकैलाई पनि तिनले अग्ला देवस्थानहरूका निम्ति अभिषेक गरे।<verse eid="1KI 13:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 13:34"/>यही पापको कारण सारा संसारबाट यारोबामको घरानाको पतन भयो र त्यसको सर्वनाश भयो।<verse eid="1KI 13:34"/></para>
<chapter eid="1KI 13"/>
<chapter number="14" style="c" sid="1KI 14"/>
<para style="p"><verse number="1" style="v" sid="1KI 14:1"/>त्यस बेला यारोबामको छोरा अबीयाह बिरामी भयो।<verse eid="1KI 14:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 14:2"/>यारोबामले आफ्नी पत्नीलाई भने, “जाऊ, आफ्नो भेष बदल, ताकि तिमी यारोबामकी पत्नी हौ भनी मानिसहरूले नचिनून्। त्यसपछि शीलोमा जाऊ, जहाँ मलाई ‘तिमी यी मानिसहरूमाथि राजा हुनेछौ’ भन्‍ने अगमवक्ता अहीयाह छन्।<verse eid="1KI 14:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 14:3"/>तिम्रो साथमा दश वटा रोटी, केही फुरौलाहरू र एक भाँडो मह लिएर तिनीकहाँ जाऊ। अनि हाम्रो छोरालाई के हुनेछ, सो तिनले बताइदिनेछन्।”<verse eid="1KI 14:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 14:4"/>यसकारण यारोबामकी पत्नीले तिनले भनेझैँ गरिन्, र शीलोमा अहीयाहको घरमा गइन्। त्यस बेला अहीयाहले देख्न सक्दैनथिए; किनकि वृद्धावस्थाले गर्दा तिनका आँखा धमिलिएका थिए।<verse eid="1KI 14:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 14:5"/>तर याहवेहले अहीयाहलाई भन्‍नुभएको थियो, “यारोबामकी पत्नी आफ्नो बिरामी छोराको विषयमा तँलाई सोध्न आउँदैछे। तैँले त्यसलाई यस्तो जवाफ दिनू। त्यो आउँदा आफूलाई अरू कोही हुँ भनी भान पार्नेछे।”<verse eid="1KI 14:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 14:6"/>यसकारण तिनको खुट्टाको आवाज सुनेर अहीयाहले भने, “हे यारोबामकी पत्नी, भित्र आऊ। यस्तो बहाना किन गर्दैछ्यौ? म तिमीलाई एउटा खराब खबर दिन पठाइएको छु।<verse eid="1KI 14:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 14:7"/>जाऊ, गएर यारोबामलाई भन, कि याहवेह इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘तँलाई मानिसहरूबाट मैले खडा गरेँ, र तँलाई मेरा जाति इस्राएलमाथि अगुवा बनाएँ।<verse eid="1KI 14:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 14:8"/>मैले दावीदको घरानाबाट राज्य खोसेँ, र त्यो तँलाई दिएँ। तर तँ मेरा सेवक दावीदजस्तो भइनस्, जसले मेरा आज्ञाहरू पालन गर्‍यो, र मेरो दृष्‍टिमा जे ठिक थियो, त्यही मात्र गर्नलाई आफ्नो सम्पूर्ण हृदयले मलाई पछ्यायो।<verse eid="1KI 14:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 14:9"/>तर तँभन्दा अगिका सबैभन्दा बढी दुष्‍टता तैँले गरिस्। तैँले आफ्ना निम्ति अरू देवताहरू र ढालेर बनाइएका धातुका मूर्तिहरू बनाइस्। तैँले मलाई रिस उठाएको छस्, र मलाई आफ्नो पिठिउँ फर्काएको छस्।<verse eid="1KI 14:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 14:10"/>“ ‘त्यसैले म यारोबामको घरानामा विपत्ति ल्याउँदैछु। म यारोबामबाट कमारा होस् वा फुक्‍का होस्; इस्राएलका प्रत्येक पुरुषलाई नाश गर्नेछु। म यारोबामको घरलाई कसैले गोबर जलाएझैँ ती सबै भस्म नभएसम्म जलाइदिनेछु।<verse eid="1KI 14:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 14:11"/>यारोबामका जोसुकै होस्, ती सबै सहरमा मर्नेछन्। तिनीहरूलाई कुकुरहरूले खानेछन्। सहरदेखि बाहिर मर्नेहरू सबैलाई आकाशका पक्षीहरूले खानेछन्। याहवेहले भन्‍नुभएको छ!’<verse eid="1KI 14:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 14:12"/>“तिमीचाहिँ घर फर्केर जाऊ। जब तिमीले आफ्नो सहरमा पाइला टेक्नेछौ, तब त्यो बालक मर्नेछ।<verse eid="1KI 14:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 14:13"/>सारा इस्राएलले त्यसका निम्ति बिलौना गर्नेछ र त्यसलाई गाड्नेछ। यारोबामको सन्तानमा त्यो एक जना मात्र गाडिनेछ; किनकि यारोबामको घरानाबाट त्यसमा मात्र याहवेह इस्राएलका परमेश्‍वरले केही असल पाउनुभएको छ।<verse eid="1KI 14:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 14:14"/>“याहवेहले आफ्नै निम्ति इस्राएलमाथि एउटा राजा खडा गर्नुहुनेछ, जसले यारोबामको परिवारलाई सखाप पार्नेछ। त्यो आजै हुनेछ! अहिले नै हुनेछ।<verse eid="1KI 14:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 14:15"/>याहवेहले इस्राएलमाथि प्रहार गर्नुहुनेछ, र त्यो पानीमा यताउता हल्‍लिरहने निगालोझैँ हुनेछ। उहाँले इस्राएललाई तिनीहरूका पितापुर्खाहरूलाई दिनुभएको यस असल देशबाट उखेल्नुहुनेछ। तिनीहरूलाई नदीपारि तितरबितर गरिदिनुहुनेछ। किनकि तिनीहरूले अशेरा देवीका खम्बाहरू बनाएर याहवेहलाई रिस उठाएका छन्।<verse eid="1KI 14:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 14:16"/>उहाँले यारोबामले गरेका पापहरूको कारण र तिनले इस्राएललाई गर्न लगाएका पापहरूको कारण इस्राएललाई त्याग्नुहुनेछ।”<verse eid="1KI 14:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 14:17"/>तब यारोबामकी पत्नी उठिन् र तिर्सामा गइन्। तिनले आफ्नो घरको सँघारमा पाइला टेक्नसाथ त्यो केटो मर्‍यो।<verse eid="1KI 14:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 14:18"/>याहवेहले आफ्नो सेवक अगमवक्ता अहीयाहद्वारा भन्‍नुभएझैँ तिनीहरूले त्यसलाई गाडे; अनि सारा इस्राएलले त्यसका निम्ति शोक गरे।<verse eid="1KI 14:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 14:19"/>यारोबामको शासनका अरू घटनाहरू, तिनले लडेका युद्धहरू र तिनले कसरी शासन गरे, ती इस्राएलका राजाहरूका इतिहासको पुस्तकमा लेखिएका छन्।<verse eid="1KI 14:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 14:20"/>तिनले बाइस वर्ष राज्य गरे, अनि आफ्ना पुर्खाहरूसित विश्राममा प्रवेश गरे। तिनीपछि तिनका छोरा नादाब राजा भए।<verse eid="1KI 14:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 14:21"/>यहूदामा सोलोमनका छोरा रहबाम राजा थिए। तिनी राजा हुँदा एकचालीस वर्षका थिए; अनि तिनले याहवेहले आफ्नो नाम राख्नलाई इस्राएलका सबै कुलहरूबाट चुन्‍नुभएको सहर यरूशलेममा सत्र वर्ष राज्य गरे। तिनकी आमाको नाम नामा थियो; जो अम्मोनी थिइन्।<verse eid="1KI 14:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 14:22"/>यहूदाले याहवेहको दृष्‍टिमा दुष्‍टता गर्‍यो। तिनीहरूले गरेका पापहरूद्वारा तिनीहरूले उहाँलाई आफ्ना पितापुर्खाहरूले भन्दा बढी डाही तुल्याए।<verse eid="1KI 14:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 14:23"/>तिनीहरूले आफ्नो लागि प्रत्येक अग्लो डाँडामा र प्रत्येक झ्याम्म परेको रूखमुनि अल्गा देवस्थानहरू, पवित्र ढुङ्गाहरू, अशेराका खम्बाहरू खडा गरे।<verse eid="1KI 14:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 14:24"/>देशमा पूजा गर्ने देवस्थानहरूमा देवदासहरू पनि थिए। इस्राएलीहरूको सामुबाट याहवेहद्वारा धपाइएका जातिहरूका घिनलाग्दा रीतिहरू गर्न मानिसहरू व्यस्त थिए।<verse eid="1KI 14:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 14:25"/>राजा रहबामको पाँचौँ वर्षमा इजिप्टका राजा शीशकले यरूशलेममाथि आक्रमण गरे।<verse eid="1KI 14:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 14:26"/>तिनले याहवेहको मन्दिर र राजमहलका बहुमूल्य चीजहरू लुटेर लगे। सोलोमन राजाले बनाएका सुनका ढालहरू लगायत प्रत्येक कुरो तिनले लुटेर लगे।<verse eid="1KI 14:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 14:27"/>यसकारण राजा रहबामले तिनीहरूका सट्टामा काँसाका ढालहरू बनाए, र ती राजमहलको प्रवेशद्वारका काममा खटिएका पहरेदारहरूका सेनापतिहरूको जिम्मामा दिए।<verse eid="1KI 14:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 14:28"/>राजा जहिले-जहिले याहवेहको मन्दिरमा जान्थे, ती पहरेदारहरू ढालहरू बोकेर तिनीसित जान्थे। त्यसपछि तिनीहरूले ती पहरेदारहरूको कोठामा फर्काइदिन्थे।<verse eid="1KI 14:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 14:29"/>रहबामको शासनका अरू घटनाहरू र तिनले गरेका सबै विषयमा ती यहूदाका राजाहरूका पुस्तकहरूमा लेखिएका छन्।<verse eid="1KI 14:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 14:30"/>रहबाम र यारोबामका बीचमा निरन्तर युद्ध भइरह्‍यो।<verse eid="1KI 14:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 14:31"/>अनि रहबाम आफ्ना पुर्खाहरूसित सुते, र तिनीहरूसितै दावीदको सहरमा गाडिए। तिनकी आमाको नाम नामा थियो, जो एक अम्मोनी थिइन्। तिनीपछि तिनका छोरा अबीयाह राजा भए।<verse eid="1KI 14:31"/></para>
<chapter eid="1KI 14"/>
<chapter number="15" style="c" sid="1KI 15"/>
<para style="p"><verse number="1" style="v" sid="1KI 15:1"/>नबातका छोरा यारोबामको शासनकालको अठारौँ वर्षमा अबीयाह यहूदाका राजा भए।<verse eid="1KI 15:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 15:2"/>तिनले यरूशलेममा तीन वर्ष राज्य गरे। तिनकी आमाको नाम माका थियो, जो अबीशालोमकी छोरी थिइन्।<verse eid="1KI 15:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 15:3"/>तिनले आफूअगिका तिनका पिताले गरेका सबै पापहरू गरे। तिनको हृदय तिनका पुर्खा दावीदको झैँ याहवेहप्रति सम्पूर्ण रूपले समर्पित थिएन।<verse eid="1KI 15:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 15:4"/>तैपनि दावीदको खातिर याहवेह तिनका परमेश्‍वरले उहाँको उत्तराधिकारी हुनको लागि एउटा छोरा दिनुभएर यरूशलेममा एउटा बत्ती दिनुभयो, अनि यरूशलेमलाई बलियो बनाउनुभयो।<verse eid="1KI 15:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 15:5"/>किनकि दावीदले याहवेहको दृष्‍टिमा जे ठिक थियो, त्यही गरेका थिए। तिनले आफ्नो जीवनकालभरि हित्ती उरियाहको विषयमा बाहेक याहवेहका कुनै आज्ञापालन गर्न चुकेका थिएनन्।<verse eid="1KI 15:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 15:6"/>अबीयाहको जीवनकालभरि रहबाम र यारोबामको बीचमा लडाइँ भइरह्‍यो।<verse eid="1KI 15:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 15:7"/>अबीयाहको शासनकालका अरू घटनाहरू र तिनले गरेका सबै कामहरूको विषयमा ती यहूदाका राजाहरूका पुस्तकमा लेखिएका छन्। अबीयाह र यारोबामको बीचमा निरन्तर युद्ध भइरह्‍यो।<verse eid="1KI 15:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 15:8"/>अबीयाह आफ्ना पुर्खाहरूसित विश्राममा प्रवेश गरे; र दावीदको सहरमा गाडिए। तिनीपछि तिनका छोरा आसा राजा भए।<verse eid="1KI 15:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 15:9"/>इस्राएलका राजा यारोबामको बीसौँ वर्षमा आसा यहूदाका राजा भए।<verse eid="1KI 15:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 15:10"/>तिनले यरूशलेममा एकचालीस वर्ष राज्य गरे। तिनकी हजुरआमाको नाम माका थियो, जो अबीशालोमकी छोरी थिइन्।<verse eid="1KI 15:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 15:11"/>आसाले आफ्ना पिता दावीदले गरेझैँ याहवेहको दृष्‍टिमा जे ठिक थियो, त्यही गरे।<verse eid="1KI 15:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 15:12"/>तिनले देशबाट देवस्थानहरूमा भएका देवदासहरूलाई निकालिदिए। देशलाई आफ्ना पिताले बनाएका मूर्तिहरूदेखि मुक्त गरे।<verse eid="1KI 15:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 15:13"/>राजा आसाले आफ्नी हजुरआमा माकालाई राजमाताको पदबाट हटाइदिए; किनकि उनले अशेराको घिनलाग्दो मूर्ति बनाएकी थिइन्। आसाले त्यस मूर्तिलाई काटेर ढालिदिए; र त्यसलाई टुक्रा-टुक्रा पारेर किद्रोन खोल्सामा जलाइदिए।<verse eid="1KI 15:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 15:14"/>तिनले अल्गा देवस्थानहरू नहटाए तापनि आसाको हृदय आफ्नो जीवनभरि नै याहवेहप्रति सम्पूर्ण रूपले अर्पित थियो।<verse eid="1KI 15:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 15:15"/>तिनले याहवेहको मन्दिरमा आफ्ना पिताले अर्पण गरेका थोकहरू र आफैँले अर्पण गरेका चाँदी, सुन र अरू सामग्रीहरू ल्याए।<verse eid="1KI 15:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 15:16"/>आसा र इस्राएलका राजा बाशाको बीचमा तिनीहरूका शासनकालभरि युद्ध भइरह्‍यो।<verse eid="1KI 15:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 15:17"/>इस्राएलका राजा बाशा यहूदाको विरुद्धमा उठे। कसैलाई पनि यहूदाका राजा आसाको प्रान्तबाट बाहिर जान र भित्र पस्‍न नदिनलाई रामाको चारैतिर पर्खाल बनाए।<verse eid="1KI 15:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 15:18"/>तब आसाले याहवेहको मन्दिरभित्र र आफ्नै महलभित्र भएका सबै चाँदी र सुन लिए। तिनले त्यसलाई आफ्ना अधिकारीहरूको जिम्मामा सुम्पेर तिनीहरूलाई दमस्कसमा राज्य गर्ने अरामका राजा बेन-हददकहाँ पठाइदिए। बेन-हदद तब्रिमोनका छोरा र हेज्योनका नाति थिए।<verse eid="1KI 15:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 15:19"/>तिनले भने, “मेरा पिता र तपाईंका पिताको बीचमा झैँ, म र तपाईंको बीचमा पनि एउटा सन्धि होस्। हेर्नुहोस्, मैले तपाईंकहाँ उपहारस्वरूप चाँदी र सुन पठाइरहेको छु। अब तपाईं र इस्राएलका राजा बाशाको बीचको सन्धि तोड्नुहोस्; ताकि तिनी मदेखि हटेर जाऊन्।”<verse eid="1KI 15:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 15:20"/>तब बेन-हददले आसा राजासित सहमत भएर आफ्ना दलहरूका सेनापतिहरूलाई इस्राएलका सहरहरूको विरुद्धमा पठाए। तिनले नप्‍ताली सहित इयोन, दान, हाबिल-बेथ-माका र सम्पूर्ण किन्‍नरेतलाई कब्जा गरे।<verse eid="1KI 15:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 15:21"/>बाशाले यो सुनेपछि रामालाई निर्माण गर्न छोडिदिए, र तिर्सामा फर्के।<verse eid="1KI 15:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 15:22"/>तब राजा आसाले कसैलाई पनि नछोडी सारा यहूदामा एउटा हुकुम जारी गरे। तिनीहरूले बाशाले रामामा प्रयोग गर्दै गरेका ढुङ्गाहरू र काठहरू बोकेर लगे। ती सामानद्वारा राजा आसाले बेन्यामीनमा गेबा र मिस्पा बनाए।<verse eid="1KI 15:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 15:23"/>राजा आसाका जीवनकालका अरू घटनाहरू, तिनका सारा उपलब्धीहरू तिनले गरेका सबै कामहरू र तिनले बनाएका सहरहरूका विषयमा यहूदाका राजाहरूका पुस्तकमा लेखिएका छन्। तैपनि तिनको वृद्धावस्थामा तिनका खुट्टामा रोग लाग्यो।<verse eid="1KI 15:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 15:24"/>तब आसा आफ्ना पुर्खाहरूसित विश्राममा प्रवेश गरे, अनि तिनीहरूसितै आफ्ना पिता दावीदको सहरमा गाडिए। तिनीपछि तिनका छोरा यहोशापात राजा भए।<verse eid="1KI 15:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 15:25"/>यहूदाका राजा आसाको दोस्रो वर्षमा यारोबामका छोरा नादाब इस्राएलका राजा भए। उनले इस्राएलमा दुई वर्ष राज्य गरे।<verse eid="1KI 15:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 15:26"/>उनले याहवेहको दृष्‍टिमा जे कुरा खराब थियो, त्यही गरे। इस्राएललाई उनका पिताले गर्न लगाएका पापमा चलेर उनी तिनकै चालमा हिँडे।<verse eid="1KI 15:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 15:27"/>इस्साखारको घरानाको अहीयाहका छोरा बाशाले तिनको विरुद्धमा षड्यन्त्र रचे। अनि नादाब र सारा इस्राएलले पलिश्ती सहरलाई घेरा हालेको बेला उनले तिनलाई प्रहार गरेर मारे।<verse eid="1KI 15:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 15:28"/>यहूदाका राजा आसाको तेस्रो वर्षमा बाशाले नादाबलाई मारे, र तिनीपछि उनी राजा भए।<verse eid="1KI 15:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 15:29"/>बाशाले शासन गर्न थाल्नसाथ तिनले यारोबामको सम्पूर्ण परिवारलाई मारे। तिनले यारोबामका सास फेर्ने एउटैलाई पनि बाँकी राखेनन्। तर याहवेहको सेवक शीलोनी अहीयाहद्वारा उहाँले भन्‍नुभएको वचनअनुसार तिनीहरू सबैलाई नष्‍ट गरिदिए।<verse eid="1KI 15:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 15:30"/>योचाहिँ यारोबामले गरेको पाप र तिनले इस्राएललाई गर्न लगाएको पापको कारणले अनि तिनले याहवेह इस्राएलका परमेश्‍वरलाई रिस उठाएको कारणले गर्दा नै भएको थियो।<verse eid="1KI 15:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 15:31"/>नादाबको शासनका अरू घटनाहरू र तिनले गरेका सबै कामहरूको विषयमा इस्राएलका राजाहरूका इतिहासको पुस्तकमा लेखिएका छन्।<verse eid="1KI 15:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 15:32"/>आसा र इस्राएलका राजा बाशाको बीचमा तिनीहरूका शासनकालभरि युद्ध भइरह्‍यो।<verse eid="1KI 15:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 15:33"/>यहूदाका राजा आसाको तेस्रो वर्षमा अहीयाहका छोरा बाशा तिर्सामा सम्पूर्ण इस्राएलका राजा भए। तिनले चौबीस वर्ष राज्य गरे।<verse eid="1KI 15:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 15:34"/>तिनले याहवेहको दृष्‍टिमा जे दुष्‍टता थियो, त्यही गरे; र यारोबामका मार्गहरूमा र उनका पापहरूमा हिँडे; जुन पापहरूद्वारा तिनले इस्राएललाई पाप गर्न लगाएका थिए।<verse eid="1KI 15:34"/></para>
<chapter eid="1KI 15"/>
<chapter number="16" style="c" sid="1KI 16"/>
<para style="p"><verse number="1" style="v" sid="1KI 16:1"/>तब याहवेहको वचन हनानीका छोरा येहूद्वारा बाशाको विरुद्धमा आयो:<verse eid="1KI 16:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 16:2"/>“मैले तँलाई धुलोबाट माथि उठाएर मेरो जाति इस्राएलमाथि शासक नियुक्त गरेँ। तर यारोबामका मार्गहरूमा तँ हिँडिस्; र मेरा जाति इस्राएललाई पाप गर्न लगाइस्। तिनीहरूका पापले गर्दा मलाई रिस उठेको छ।<verse eid="1KI 16:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 16:3"/>यसकारण म बाशा र त्यसको घरानालाई नाश पार्नेछु। म तेरो घरानालाई नबातका छोरा यारोबामको घरानालाई जस्तै मेटिदिनेछु।<verse eid="1KI 16:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 16:4"/>बाशाका घरानाकाहरू, सहरमा मर्नेहरूलाई कुकुरले खानेछन्, र गाउँमा मर्नेहरूलाई चाहिँ आकाशका चराहरूले खानेछन्।”<verse eid="1KI 16:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 16:5"/>बाशाका शासनका अरू घटनाहरू, तिनले गरेका कार्य र तिनका उपलब्धीहरूका विषयमा इस्राएलका राजाहरूका इतिहासको पुस्तकमा लेखिएका छन्।<verse eid="1KI 16:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 16:6"/>बाशा आफ्ना पुर्खाहरूसित विश्राममा प्रवेश गरे, र तिर्सामा गाडिए; अनि तिनीपछि तिनका छोरा एलाह राजा भए।<verse eid="1KI 16:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 16:7"/>यसबाहेक याहवेहको वचन हनानीका छोरा अगमवक्ता येहूद्वारा बाशा र तिनका घरानाको विरुद्धमा आयो। यसो हुनुको कारणचाहिँ बाशाले पनि यारोबामको घरानाले जस्तै याहवेहको दृष्‍टिमा जे दुष्‍टता थियो त्यही गरेका थिए, र तिनले यारोबामको परिवारलाई पनि नाश गरे। यसरी बाशानले पाप गरेर याहवेहलाई रिस उठाए।<verse eid="1KI 16:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 16:8"/>यहूदाका राजा आसाको छब्बीसौँ वर्षमा बाशाका छोरा एलाह इस्राएलका राजा भए; र तिनले तिर्सामा दुई वर्ष राज्य गरे।<verse eid="1KI 16:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 16:9"/>तिनका सेवक जिम्रीले, जो आधा राजकीय रथहरूका सेनापति थिए, तिनको विरुद्धमा षड्यन्त्र रचे। त्यस बेला एलाचाहिँ तिर्सामा आफ्नो दरबारका प्रशासक अर्साको घरमा मद्यपान गरिरहेका थिए।<verse eid="1KI 16:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 16:10"/>यहूदाका राजा आसाको सत्ताइसौँ वर्षमा जिम्रीले दरबारभित्र पसेर तिनलाई प्रहार गरेर मारे। तब जिम्री नै तिनीपछि राजा भए।<verse eid="1KI 16:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 16:11"/>जिम्रीले सिंहासनमा बसेर शासन सुरु गर्नसाथ बाशाको सम्पूर्ण घरानालाई मारिदिए। चाहे आफन्त होस् वा मित्र, तिनले कुनै पुरुषलाई पनि जीवित राखेनन्।<verse eid="1KI 16:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 16:12"/>यसरी याहवेहले आफ्नो सेवक अगमवक्ता येहूद्वारा बोल्नुभएको वचनअनुसार जिम्रीले बाशाको सम्पूर्ण परिवारलाई नाश गरे।<verse eid="1KI 16:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 16:13"/>बाशा र तिनका छोरा एलाहले गरेका सम्पूर्ण पापहरू र इस्राएललाई पनि पाप गर्न लगाएको कारण र तिनीहरूका व्यर्थका मूर्तिहरूले याहवेह इस्राएलका परमेश्‍वरलाई रिस उठाएको कारण यो सबै भएको थियो।<verse eid="1KI 16:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 16:14"/>एलाहको शासनका अरू घटनाहरू, र तिनले गरेका सबै कामहरूको विषयमा चाहिँ इस्राएलका राजाहरूका इतिहासको पुस्तकमा लेखिएका छन्।<verse eid="1KI 16:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 16:15"/>यहूदाका राजा आसाको सत्ताइसौँ वर्षमा जिम्रीले तिर्सामा सात दिनसम्म राज्य गरे। त्यस बेला इस्राएली फौजले चाहिँ एउटा पलिश्ती सहर गिब्बतोनको छेउमा छाउनी हालेका थिए।<verse eid="1KI 16:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 16:16"/>जब जिम्रीले राजाको विरुद्धमा षड्यन्त्र गरेर तिनको हत्या गरेको कुरा छाउनीमा भएका इस्राएलीहरूले सुने, तब तिनीहरूले त्यसै दिन फौजका सेनापति ओम्रीलाई इस्राएलमाथि राजा घोषणा गरे।<verse eid="1KI 16:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 16:17"/>तब ओम्री र तिनीसित भएका सारा इस्राएलीहरू गिब्बतोनबाट निस्केर गए; र तिर्सालाई घेरे।<verse eid="1KI 16:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 16:18"/>जब जिम्रीले सहर आफ्नो कब्जाबाट गइसकेको देखे, तब तिनी दरबारको किल्‍लाभित्र पसे; र राज दरबारको चारैतिर आगो लगाइदिए। यसरी तिनी आफैँ पनि जलेर मरे।<verse eid="1KI 16:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 16:19"/>किनकि तिनले याहवेहको दृष्‍टिमा दुष्‍टता गरेर पाप गरे, र यारोबामका मार्गहरूमा हिँडे; अनि तिनले त्यही पाप गरे, जुन यारोबामले इस्राएललाई गर्न लगाएका थिए।<verse eid="1KI 16:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 16:20"/>जिम्रीको शासनका अरू घटनाहरू र तिनले गरेका विद्रोहको विषयमा चाहिँ इस्राएलका राजाहरूका इतिहासको पुस्तकमा लेखिएका छन्।<verse eid="1KI 16:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 16:21"/>तब इस्राएलका मानिसहरू दुई दलमा विभाजित भए। आधाले गीनतका छोरा तिब्नीलाई राजा बनाउन चाहन्थे; र बाँकी आधाले चाहिँ ओम्रीलाई साथ दिए।<verse eid="1KI 16:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 16:22"/>तर ओम्रीका पछि लाग्नेहरूले गीनतका छोरा तिब्नीका पछि लाग्नेहरूलाई परास्त गरे। यसकारण तिब्नी मारिए, र ओम्री राजा भए।<verse eid="1KI 16:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 16:23"/>यहूदाका राजा आसाको एकतीसौँ वर्षमा ओम्री इस्राएलमा राजा भए। तिनले बाह्र वर्ष राज्य गरे; छ वर्षचाहिँ तिनले तिर्सामा राज्य गरे।<verse eid="1KI 16:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 16:24"/>तिनले शेमेरबाट दुई टालेन्ट चाँदीमा सामरियाको डाँडा किने। त्यस डाँडामा एउटा सहर बनाए र त्यसलाई डाँडाका पहिलेका मालिक शेमेरको नामबाट सामरिया नाम राखे।<verse eid="1KI 16:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 16:25"/>तर ओम्रीले याहवेहको दृष्‍टिमा दुष्‍टता गरेर आफूभन्दा अगिका राजाहरूले भन्दा अझ बढी पाप गरे।<verse eid="1KI 16:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 16:26"/>तिनी नबातका छोरा यारोबाम र तिनका सबै मार्गहरूमा हिँडे; तिनले त्यही पाप गरे, जुन यारोबामले इस्राएललाई गर्न लगाएका थिए। यसरी तिनीहरूले आफ्ना व्यर्थका मूर्तिहरूद्वारा याहवेह इस्राएलका परमेश्‍वरलाई रिस उठाए।<verse eid="1KI 16:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 16:27"/>ओम्रीको शासनका अरू घटनाहरू, तिनले गरेका कार्य, र तिनका उपलब्धीहरूका विषयमा चाहिँ इस्राएलका राजाहरूका इतिहासको पुस्तकमा लेखिएका छन्।<verse eid="1KI 16:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 16:28"/>ओम्री आफ्ना पुर्खाहरूसित विश्राममा प्रवेश गरे; र सामरियामा गाडिए। तिनीपछि तिनका छोरा आहाब राजा भए।<verse eid="1KI 16:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 16:29"/>यहूदाका राजा आसाको अठतीसौँ वर्षमा ओम्रीका छोरा आहाब इस्राएलका राजा भए; र तिनले सामरियामा इस्राएलमाथि बाइस वर्ष राज्य गरे।<verse eid="1KI 16:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 16:30"/>ओम्रीका छोरा आहाबले याहवेहको दृष्‍टिमा आफ्ना अगिका सबै राजाहरूले भन्दा अझ बढी दुष्‍टता गरे।<verse eid="1KI 16:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 16:31"/>तिनले नबातका छोरा यारोबामका पापहरूमा हिँड्न मामूली कुराजस्तै मात्र होइन, तर तिनले सीदोनीहरूका राजा एतबालकी छोरी ईजेबेललाई पनि विवाह गरे, अनि बाल-देवताको सेवा गरेर त्यसलाई पुजे।<verse eid="1KI 16:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 16:32"/>तिनले सामरियामा बालको मन्दिर बनाएर त्यसका निम्ति एउटा वेदी बनाए।<verse eid="1KI 16:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 16:33"/>आहाबले अशेराको खाँबो पनि खडा गरे। यसरी आफूअगिका इस्राएलका राजाहरूले भन्दा बढी याहवेह इस्राएलका परमेश्‍वरलाई रिस उठाउने कामहरू गरे।<verse eid="1KI 16:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 16:34"/>आहाबको समयमा बेथेलका हीएलले यरीहोलाई पुनर्निर्माण गरे। तिनले त्यसको जग बसाल्दा तिनको जेठा छोरा अबीरामको मृत्यु भयो। अनि त्यसका मूलढोकाहरू बनाउँदा तिनको कान्छा छोरा सगूबको मृत्यु भयो। यो सबै याहवेहले नूनका छोरा यहोशूलाई भन्‍नुभएअनुसार नै हुनगयो।<verse eid="1KI 16:34"/></para>
<chapter eid="1KI 16"/>
<chapter number="17" style="c" sid="1KI 17"/>
<para style="p"><verse number="1" style="v" sid="1KI 17:1"/>गिलादको तिश्बीबाटका तिश्बी एलियाले आहाबलाई भने, “मैले सेवा गरेका याहवेह, इस्राएलका जीवित परमेश्‍वरलाई साक्षी राखी भन्दछु, कि आउँदा केही वर्षहरूमा मैले नभनेसम्म न त शीत पर्नेछ, न त पानी पर्नेछ।”<verse eid="1KI 17:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 17:2"/>तब याहवेहको वचन एलियाकहाँ आयो:<verse eid="1KI 17:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 17:3"/>“यो ठाउँ छोडेर पूर्वपट्टि लाग्, र यर्दनको पूर्वपट्टि भएको करीतको खोल्सामा गएर लुकेर बस्।<verse eid="1KI 17:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 17:4"/>तैँले खोलाको पानी पिउनेछस्; र तँलाई खुवाउनलाई मैले कागहरूलाई हुकुम गरेको छु।”<verse eid="1KI 17:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 17:5"/>यसकारण याहवेहले भन्‍नुभएझैँ तिनले गरे। तिनी यर्दनको पूर्वपट्टिको करीतको खोल्सामा गएर बसे।<verse eid="1KI 17:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 17:6"/>कागहरूले तिनलाई बिहान रोटी र मासु ल्याइदिन्थे; अनि साँझमा पनि रोटी र मासु ल्याइदिन्थे; र तिनले त्यस खोलाको पानी पिउँथे।<verse eid="1KI 17:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 17:7"/>केही समयपछि देशमा पानी नपरेको कारणले त्यो खोला सुक्यो।<verse eid="1KI 17:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 17:8"/>तब याहवेहको वचन तिनीकहाँ आयो:<verse eid="1KI 17:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 17:9"/>“झट्टै सीदोनको सारपतमा जा र त्यहाँ बस्। तँलाई भोजन दिनू भनेर मैले त्यहाँ एउटी विधवालाई आज्ञा दिएको छु।”<verse eid="1KI 17:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 17:10"/>यसकारण तिनी सारपतमा गए। तिनी त्यस सहरको मूलढोकामा आइपुग्दा त्यहाँ एउटी विधवा दाउरा बटुल्दै थिइन्। तिनले उनलाई बोलाएर सोधे, “कृपया तिमीले मलाई एउटा लोहोटामा अलिकति पानी ल्याइदिन्छौ कि ताकि म पिउन पाऊँ?”<verse eid="1KI 17:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 17:11"/>ती विधवा पानी लिन जाँदै गर्दा तिनले उनलाई भने, “अनि दया गरी मलाई एक टुक्रा रोटी पनि ल्याइदेऊ।”<verse eid="1KI 17:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 17:12"/>तिनले जवाफ दिइन्, “जीवित याहवेह तपाईंका परमेश्‍वरलाई साक्षी राखेर भन्दछु, मसित एउटै रोटी पनि छैन। एउटा भाँडामा एक मुट्ठी पिठो र ढुङ्ग्रोमा अलिकति तेलबाहेक केही छैन। म आफैँ र मेरा छोराका निम्ति खानेकुरा बनाएर खाई मरौँला भनी घरमा लैजान केही दाउरा बटुल्दैछु।”<verse eid="1KI 17:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 17:13"/>एलियाले उनलाई भने, “नडराऊ, घर गएर तिमीले भनेझैँ गर। तर तिमीसित जे छ, पहिले त्यसबाट मेरा निम्ति एउटा रोटी पकाएर मकहाँ ल्याऊ; अनि त्यसपछि तिमी र तिम्रो छोराका निम्ति केही बनाऊ!<verse eid="1KI 17:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 17:14"/>किनकि याहवेह इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ, ‘याहवेहले यस देशमा वर्षा नपठाउनुभएसम्म भाँडाको पिठो र ढुङ्ग्रोको तेल रित्तिनेछैन।’ ”<verse eid="1KI 17:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 17:15"/>अनि तिनी गइन्, र एलियाले तिनलाई भनेझैँ गरिन्। यसरी एलिया र ती स्त्रीका परिवारको निम्ति धेरै दिनका निम्ति भोजन भइरह्‍यो।<verse eid="1KI 17:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 17:16"/>किनकि एलियाद्वारा याहवेहले भन्‍नुभएझैँ भाँडोको पिठो रित्तिएन; न त ढुङ्ग्रोको तेल नै सकियो।<verse eid="1KI 17:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 17:17"/>केही समयपछि त्यस घरकी मालिक्नीको छोरा बिरामी भयो; अनि त्यो यति साह्रो हुँदैगयो, कि आखिरमा त्यसले सास फेर्नै छोड्यो।<verse eid="1KI 17:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 17:18"/>तिनले एलियालाई भनिन्, “हे परमेश्‍वरका जन, तपाईंले मेरो विरुद्धमा किन यस्तो गर्नुभयो? के तपाईं मेरो पाप सम्झना गराउन र मेरो छोरालाई मार्न भनी मकहाँ आउनुभएको हो?”<verse eid="1KI 17:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 17:19"/>एलियाले जवाफ दिए, “तिम्रो छोरा मलाई देऊ।” तिनले त्यस केटोलाई उनका हातबाट लिए, र आफू बस्‍ने माथिल्‍लो कोठामा लगेर त्यसलाई आफ्नो ओछ्यानमा सुताए।<verse eid="1KI 17:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 17:20"/>तब तिनले याहवेहलाई पुकार गरे, “हे याहवेह मेरा परमेश्‍वर, म जुन विधवासित बस्दैछु, तिनको छोरालाई मारेर किन उनीमाथि पनि यो विपत्ति ल्याउनुभएको हो?”<verse eid="1KI 17:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 17:21"/>तब तिनी तीन पल्ट त्यस केटोमाथि लमतन्‍न भई पस्रे; र याहवेहलाई पुकार गरे, “हे याहवेह मेरा परमेश्‍वर, यस बालकको प्राण ऊसभित्र फेरि फर्केर आओस्!”<verse eid="1KI 17:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 17:22"/>याहवेहले एलियाको पुकार सुन्‍नुभयो; अनि त्यस बालकको प्राण त्यसकहाँ फर्केर आयो, र त्यो जिउँदो भयो।<verse eid="1KI 17:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 17:23"/>अनि एलियाले त्यस बालकलाई उठाएर कोठाबाट बोकेर तल ल्याए; अनि त्यसकी आमालाई दिएर भने, “हेर, तिम्रो छोरा जीवितै छ!”<verse eid="1KI 17:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 17:24"/>तब ती स्त्रीले एलियालाई भनिन्, “अब मलाई थाहा भयो कि तपाईं परमेश्‍वरका जन हुनुहुन्छ; अनि तपाईंको मुखबाट निस्केको याहवेहको वचन सत्य रहेछ।”<verse eid="1KI 17:24"/></para>
<chapter eid="1KI 17"/>
<chapter number="18" style="c" sid="1KI 18"/>
<para style="p"><verse number="1" style="v" sid="1KI 18:1"/>धेरै समयपछि तेस्रो वर्षमा याहवेहको यो वचन एलियाकहाँ आयो: “जा, र राजा आहाबको सामु आफूलाई उपस्थित गरा; अनि म देशमा पानी बर्साइदिनेछु।”<verse eid="1KI 18:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 18:2"/>यसकारण एलिया आफूलाई आहाबकहाँ उपस्थित गराउन गए। सामरियामा घोर अनिकाल परेको थियो।<verse eid="1KI 18:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 18:3"/>आहाबले राजमहलका प्रशासक ओबदियालाई बोलाउन पठाए। (ओबदिया याहवेहका एक भक्त विश्‍वासी थिए।<verse eid="1KI 18:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 18:4"/>ईजेबेलले याहवेहका अगमवक्ताहरूलाई मारिरहेकी थिइन्, तब ओबदियाले एक सय जना अगमवक्ताहरूलाई लिएर तिनीहरूलाई पचास-पचास गरी दुई वटा गुफाहरूमा लुकाए र तिनीहरूलाई भोजन र पानी जुटाइदिएका थिए।)<verse eid="1KI 18:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 18:5"/>आहाबले ओबदियालाई भने, “देशमा भएका सबै पानीका मुहानहरू र खोल्साहरूमा जाऊ। सायद घोडाहरू र खच्‍चरहरूलाई जीवित राख्न हामीले केही घाँस पाउन सकौँला; ताकि हामीले आफ्नो कुनै पनि पशुहरूलाई गुमाउन नपरोस्।”<verse eid="1KI 18:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 18:6"/>यसकारण तिनीहरूले आ-आफू जानुपर्ने ठाउँलाई अलग गरे। तब आहाब एकातिर र ओबदिया अर्कोतिर लागे।<verse eid="1KI 18:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 18:7"/>ओबदिया बाटोमा जाँदै गर्दा एलियाले तिनलाई भेटे। ओबदियाले तिनलाई चिने। तिनले भुइँसम्म शिर निहुराएर उनलाई भने, “के तपाईं मेरा मालिक एलिया नै हुनुहुन्छ?”<verse eid="1KI 18:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 18:8"/>उनले जवाफ दिए, “हो म नै हुँ। जाऊ, गएर आफ्नो मालिकलाई एलिया यहाँ छन् भनिदेऊ।”<verse eid="1KI 18:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 18:9"/>तब ओबदियाले सोधे, “मैले के भूल गरेको छु र तपाईंले आफ्नो सेवकलाई मारिनको लागि आहाबकहाँ सुम्पँदै हुनुहुन्छ?<verse eid="1KI 18:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 18:10"/>याहवेह तपाईंका परमेश्‍वरलाई साक्षी राखेर भन्दछु, मेरा मालिकले तपाईंलाई खोज्न भनी नपठाएको कुनै राज्य छैन। अनि जब ती राष्ट्र वा जातिले तपाईं त्यहाँ हुनुहुन्‍न भनी दाबी गरे, तब तिनले तिनीहरूलाई ‘हामीले त्यसलाई पाउन सकेनौँ’ भन भनेर शपथ खान लगाए।<verse eid="1KI 18:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 18:11"/>तर अब तपाईंले मलाई मेरा मालिककहाँ गएर ‘एलिया यहाँ छन्’ भनी भन्‍न लगाउनुहुन्छ।<verse eid="1KI 18:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 18:12"/>म तपाईंबाट गएपछि याहवेहको आत्माले तपाईंलाई कहाँ लानुहुन्छ, म जान्दिनँ। यदि मैले गएर आहाबलाई भनेँ, र तिनले तपाईंलाई भेट्टाउन सकेनन् भने तिनले मलाई मार्नेछन्। तर म तपाईंको सेवक आफ्नो बालककालदेखि नै याहवेहको आराधना गर्दैआएको छु।<verse eid="1KI 18:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 18:13"/>मेरा मालिक, जब ईजेबेलले याहवेहका अगमवक्ताहरूलाई मारिरहेको बेला मैले के गरेँ, त्यो तपाईंलाई थाहा छैन? मैले याहवेहका एक सय जना अगमवक्ताहरूलाई पचास-पचास गरी दुई वटा गुफाहरूमा लुकाएँ, र तिनीहरूका निम्ति भोजन र पानी जुटाएँ।<verse eid="1KI 18:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 18:14"/>अनि अब तपाईं मलाई मेरा मालिककहाँ गएर ‘एलिया यहाँ छन्’ भनी भन भन्‍नुहुन्छ। तिनले त मलाई मार्नेछन्!”<verse eid="1KI 18:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 18:15"/>एलियाले भने, “जीवित सेनाहरूका याहवेह जसको सेवा म गर्दछु, उहाँलाई साक्षी राखेर भन्दछु, म आज निश्‍चय नै आहाबकहाँ देखा पर्नेछु।”<verse eid="1KI 18:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 18:16"/>यसकारण एलिया आएका छन् भनेर भन्‍नका लागि ओबदिया आहाबलाई भेट्न गए; र आहाब एलियालाई भेट्न गए।<verse eid="1KI 18:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 18:17"/>एलियालाई देखेर तिनले उनलाई भने, “के इस्राएललाई कष्‍ट दिने तिमी नै हौ?”<verse eid="1KI 18:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 18:18"/>एलियाले जवाफ दिए, “इस्राएललाई मैले कष्‍ट दिएको होइन। तर तपाईं र तपाईंका पिताका परिवारले चाहिँ कष्‍ट दिनुभएको छ। तपाईंहरू परमेश्‍वरका आज्ञाहरू त्यागेर बाल-देवताहरूका पछि लाग्नुभएको छ।<verse eid="1KI 18:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 18:19"/>अब तपाईंले मलाई कर्मेल पर्वतमा भेट गर्न इस्राएलबाट सारा मानिसहरूलाई बोलाउनुहोस्। बालका ती चार सय अगमवक्ता, जसले ईजेबेलको टेबुलमा बसेर खाने गर्दछन्, तिनीहरूलाई पनि लिएर आउनुहोस्।”<verse eid="1KI 18:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 18:20"/>यसकारण आहाबले सारा इस्राएलभरि खबर पठाए। अनि ती अगमवक्ताहरूलाई कर्मेल पर्वतमा भेला गराए।<verse eid="1KI 18:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 18:21"/>एलिया मानिसहरूका सामु गएर भने, “तिमीहरू कहिलेसम्म दोधारमा रहन्छौ? यदि याहवेह नै परमेश्‍वर हुनुहुन्छ भने उहाँलाई पछ्याओ। तर यदि बाल परमेश्‍वर हो भने त्यसैलाई पछ्याओ।” तर मानिसहरूले तिनलाई केही पनि जवाफ दिएनन्।<verse eid="1KI 18:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 18:22"/>तब एलियाले तिनीहरूलाई भने, “याहवेहका अगमवक्ताहरूमध्ये बाँकी रहेको म मात्र हुँ, तर बालका त चार सय पचास जना अगमवक्ताहरू छन्।<verse eid="1KI 18:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 18:23"/>हाम्रा निम्ति दुई वटा साँढेहरू ल्याओ। तिनीहरूले एउटा आफ्नो लागि चुनून्, र त्यसलाई टुक्रा-टुक्रा गरी काटेर दाउरामाथि राखून्; तर आगोचाहिँ नलगाऊन्। म अर्को साँढेलाई तयार पार्छु, र त्यसलाई दाउरामाथि राख्नेछु; तर म पनि त्यसमा आगो लगाउँदिनँ।<verse eid="1KI 18:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 18:24"/>तिमीहरूले आफ्ना देवताहरूका नाम लिएर पुकार गर, र मचाहिँ मेरा याहवेहको नाम लिएर पुकार गर्नेछु। जुन देवताले आगोद्वारा जवाफ दिनुहुनेछ, उहाँ नै परमेश्‍वर हुनुहुनेछ।” तब सबै मानिसहरूले भने, “तपाईंले भनेको कुरा ठिक हो।”<verse eid="1KI 18:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 18:25"/>एलियाले बालका अगमवक्ताहरूलाई भने, “तिमीहरू यति धेरै भएकाले पहिले तिमीहरूले नै एउटा साँढे चुनेर त्यसलाई तयार गर; तर आगोचाहिँ नलगाओ।”<verse eid="1KI 18:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 18:26"/>यसकारण तिनीहरूलाई दिइएको साँढे तिनीहरूले लगे, र त्यसलाई तयार पारे। तब तिनीहरूले बालको नाम लिएर बिहानदेखि मध्यदिनसम्म पुकार गरे। तिनीहरू यसो भन्दै चिच्याए, “हे बाल, हामीलाई जवाफ दिनुहोस्।” तर केही जवाफ आएन, न त कसैले जवाफ नै दियो। तिनीहरू आफूले बनाएका वेदीका वरिपरि उफ्रँदै नाचिरहे।<verse eid="1KI 18:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 18:27"/>मध्यदिनमा एलियाले तिनीहरूलाई यसो भनेर खिसी गर्न थाले, “ठूलो सोरले चिच्याओ! त्यो त देवता नै हो! सायद ऊ गहिरो चिन्तनमा बसेका होला, वा कतै व्यस्त होला, अथवा कतै भ्रमण गर्न पो गएको होला कि? सायद, ऊ सुतिरहेको होला, र उसलाई बिउँझाउनैपर्छ।”<verse eid="1KI 18:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 18:28"/>यसकारण तिनीहरू ठूलो सोरले चिच्याउन थाले; अनि तिनीहरूका रीतिअनुसार रगत नबगुन्जेल आफूलाई तरवार र भालाले चोट पारे।<verse eid="1KI 18:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 18:29"/>मध्यदिन बितिगयो। बेलुकाको बलिदानको समयसम्म नै तिनीहरू बौलाहझैँ अगमवाणी गरिरहे। तर त्यहाँ न त केही जवाफ आयो, न त कसैले जवाफ नै दियो; त्यहाँ कसैले ध्यान दिएनन्।<verse eid="1KI 18:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 18:30"/>तब एलियाले सबै मानिसहरूलाई भने, “यहाँ मकहाँ आओ।” तिनीहरू सबै तिनको नजिक आए। तब तिनले याहवेहको भत्किएको वेदीलाई मर्मत गरे।<verse eid="1KI 18:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 18:31"/>“तेरो नाम इस्राएल हुनेछ” भनेर याहवेहको वचन आएअनुसार याकोबका सन्तानबाट प्रत्येक कुलको निम्ति एक-एक गरी एलियाले बाह्र वटा ढुङ्गाहरू लिए।<verse eid="1KI 18:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 18:32"/>ती ढुङ्गाहरूद्वारा तिनले याहवेहको नाममा एउटा वेदी बनाए; र तिनले त्यसको वरिपरि दुई सिहा बिउ अटाउने खाडल खने।<verse eid="1KI 18:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 18:33"/>तिनले दाउरा मिलाए, र त्यस साँढेलाई टुक्रा-टुक्रा पारे, र दाउरामाथि राखे। तब तिनले तिनीहरूलाई भने, “चार वटा ठूला गाग्राहरूमा पानी भरेर त्यस बलिदान र दाउरामाथि खन्याइदेओ!”<verse eid="1KI 18:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 18:34"/>तिनले भने, “फेरि त्यस्तै गर!” तिनीहरूले फेरि त्यसै गरे। तिनले “तेस्रो पल्ट पनि त्यस्तै गर!” भनेर आज्ञा दिए। तिनीहरूले तेस्रो पल्ट पनि त्यसै गरे।<verse eid="1KI 18:34"/></para>
<para style="p"><verse number="35" style="v" sid="1KI 18:35"/>पानी वेदीको चारैतिर बग्यो, र त्यस खाडललाई समेत भरिदियो।<verse eid="1KI 18:35"/></para>
<para style="p"><verse number="36" style="v" sid="1KI 18:36"/>बलिदानको समयमा एलिया अगमवक्ता वेदीको अगि बढे, र यसरी प्रार्थना गरे: “हे याहवेह, अब्राहाम, इसहाक र इस्राएलका परमेश्‍वर, तपाईं नै इस्राएलमा परमेश्‍वर हुनुहुन्छ। म तपाईंको सेवक हुँ, र मैले यी सबै तपाईंकै आदेशमा गरेको हुँ भनेर आज थाहा होस्।<verse eid="1KI 18:36"/></para>
<para style="p"><verse number="37" style="v" sid="1KI 18:37"/>हे याहवेह, मलाई जवाफ दिनुहोस्, ताकि यी मानिसहरूले तपाईं नै याहवेह परमेश्‍वर हुनुहुन्छ र तपाईंले तिनीहरूका हृदय फेरि फर्काइदिनुहुनेछ भनी जान्‍नेछन्।”<verse eid="1KI 18:37"/></para>
<para style="p"><verse number="38" style="v" sid="1KI 18:38"/>तब याहवेहको आगो झर्‍यो, र त्यो बलिदान, दाउरा, ढुङ्गाहरू र माटोलाई डढायो; अनि खाडलमा भएको पानीलाई पनि सुकाइदियो।<verse eid="1KI 18:38"/></para>
<para style="p"><verse number="39" style="v" sid="1KI 18:39"/>जब सबै मानिसहरूले यो देखे, तब तिनीहरू लम्पसार परे; अनि “याहवेह नै परमेश्‍वर हुनुहुन्छ! याहवेह नै परमेश्‍वर हुनुहुन्छ!” भनी कराए।<verse eid="1KI 18:39"/></para>
<para style="p"><verse number="40" style="v" sid="1KI 18:40"/>तब एलियाले तिनीहरूलाई आज्ञा दिए, “बालका अगमवक्ताहरूलाई समात। एक जना पनि भाग्न नपाओस्!” तिनीहरूले उनीहरूलाई पक्रे; अनि एलियाले तिनीहरूलाई कीशोनको बेँसीमा ल्याउन लगाए, र तिनीहरूलाई त्यहाँ मारे।<verse eid="1KI 18:40"/></para>
<para style="p"><verse number="41" style="v" sid="1KI 18:41"/>अनि एलियाले आहाबलाई भने, “गएर खानपिन गर्नुहोस्; किनकि मुसलधारे वर्षाको आवाज सुनिँदैछ।”<verse eid="1KI 18:41"/></para>
<para style="p"><verse number="42" style="v" sid="1KI 18:42"/>यसकारण आहाब खानपिन गर्न गए। तर एलियाचाहिँ कर्मेलको टाकुरामा चढे; अनि भुइँसम्मै निहुरेर आफ्नो मुख आफ्ना घुँडाहरूको बीचमा राखे।<verse eid="1KI 18:42"/></para>
<para style="p"><verse number="43" style="v" sid="1KI 18:43"/>तिनले आफ्नो सेवकलाई भने, “गएर समुद्रतिर हेर्।” अनि त्यो माथि गयो, र हेरेर भन्यो, “त्यहाँ केही पनि छैन।” एलियाले त्यसलाई सात पटक “फेरि फर्केर जा” भने।<verse eid="1KI 18:43"/></para>
<para style="p"><verse number="44" style="v" sid="1KI 18:44"/>सातौँ पटकमा त्यस सेवकले “कुनै मानिसको हात जत्रो सानो एउटा बादल समुद्रबाट उठिरहेको छ” भन्‍ने खबर दियो। यसकारण एलियाले त्यसलाई भने, “गएर आहाबलाई भनिदे, ‘वर्षाले तपाईंलाई रोक्नुभन्दा पहिले आफ्नो रथ तयार गरेर तल गइहाल्नुहोस्।’ ”<verse eid="1KI 18:44"/></para>
<para style="p"><verse number="45" style="v" sid="1KI 18:45"/>त्यसै बेला आकाश बादलले कालो भयो; बतास चल्न थाल्यो, र मुसलधारे वर्षा हुन थाल्यो। अनि आहाब यिजरेलतर्फ सवार भए।<verse eid="1KI 18:45"/></para>
<para style="p"><verse number="46" style="v" sid="1KI 18:46"/>याहवेहको शक्ति एलियामाथि आयो, अनि आफ्नो पेटीमा आफ्नो खास्टो कसेर तिनी आहाबको अगि-अगि यिजरेलसम्मै दगुरे।<verse eid="1KI 18:46"/></para>
<chapter eid="1KI 18"/>
<chapter number="19" style="c" sid="1KI 19"/>
<para style="p"><verse number="1" style="v" sid="1KI 19:1"/>आहाबले ईजेबेललाई एलियाले गरेका सम्पूर्ण काम र तिनले कसरी बालका अगमवक्ताहरूलाई तरवारले मारे, ती सबै कुरा बताइदिए।<verse eid="1KI 19:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 19:2"/>यसकारण ईजेबेलले एलियाकहाँ यसो भनेर दूतहरू पठाइन्, “भोलि यस बेलासम्म मैले तेरो जीवनलाई पनि तिनीहरू प्रत्येकको जस्तै बनाइनँ भने देवताहरूले मसित कठोर व्यवहार गरून्।”<verse eid="1KI 19:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 19:3"/>तब एलिया भयभीत भएर आफ्नो प्राण जोगाउन भागे। यहूदाको बेर्शेबामा आइपुगेपछि तिनले आफ्नो सेवकलाई त्यहीँ छोडे;<verse eid="1KI 19:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 19:4"/>तर तिनीचाहिँ एक दिनको बाटो भएर उजाडस्थानमा गए। तिनी एउटा अम्रिसको झाडीमा आइपुगे, र त्यसको फेदमा बसे। तिनले मृत्युको निम्ति प्रार्थना गर्न लागे। तिनले भने, “हे याहवेह, मेरा लागि अति भयो। मेरो प्राण लिनुहोस्; म मेरा पितापुर्खाहरूभन्दा असल छैनँ।”<verse eid="1KI 19:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 19:5"/>तब तिनी त्यस झाडीमुनि ढल्के, र त्यहीँ निदाए। तब अचानक एक जना स्वर्गदूतले तिनलाई छोएर भने, “उठेर खाऊ।”<verse eid="1KI 19:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 19:6"/>तिनले चारैतिर हेरे, र आफ्नो सिरान छेउमा ताता कोइलाहरूमा पकाइएका केही रोटी र एउटा पानीको सुराही देखे। तिनले त्यो खानपिन गरेर फेरि ढल्के।<verse eid="1KI 19:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 19:7"/>याहवेहका दूत दोस्रो पल्ट आएर तिनलाई छोएर भने, “उठेर खाऊ, नत्रता तिमीलाई यात्रा गर्न कठिन हुन्छ।”<verse eid="1KI 19:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 19:8"/>यसकारण तिनी उठे, र तिनले खानपिन गरे। त्यस भोजनबाट शक्ति पाएर तिनी परमेश्‍वरको पर्वत होरेबसम्मै चालीस दिन र चालीस रात हिँडेर गए।<verse eid="1KI 19:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 19:9"/>त्यहाँ तिनी एउटा गुफाभित्र पसे, र त्यहीँ रात बिताए। याहवेहको वचन तिनीकहाँ आयो “एलिया, तँ यहाँ के गर्दैछस्?”<verse eid="1KI 19:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 19:10"/>तिनले जवाफ दिए, “याहवेह सर्वशक्तिमान् परमेश्‍वरको निम्ति म धेरै जोशिलो भएको छु। इस्राएलीहरूले तपाईंको करारलाई त्यागेका छन्। तपाईंका वेदीहरू भत्काएका छन्; अनि तपाईंका अगमवक्ताहरूलाई तरवारले मारेका छन्। अब म मात्र बाँकी रहेको छु, र तिनीहरूले मलाई पनि मार्ने कोसिस गरिरहेका छन्।”<verse eid="1KI 19:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 19:11"/>याहवेहले भन्‍नुभयो, “गएर पर्वतमा याहवेहको उपस्थितिमा खडा हो। किनकि याहवेह त्यहाँबाट भएर जाँदैहुनुहुन्छ।” तब एउटा शक्तिशाली बतास आएर पर्वतलाई फुटाइदियो अनि चट्टानलाई याहवेहको सामु छिन्‍नभिन्‍न पारिदियो। तर त्यस बतासमा याहवेह हुनुहुन्‍नथ्यो। बतासपछि भुइँचालो आयो, तर त्यस भुइँचालोमा याहवेह हुनुहुन्‍नथ्यो।<verse eid="1KI 19:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 19:12"/>भुइँचालोपछि आगो आयो, तर याहवेह आगोमा पनि हुनुहुन्‍नथ्यो। अनि आगोपछि एउटा सुस्त र शान्त कानेखुसीको सोर आयो।<verse eid="1KI 19:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 19:13"/>त्यो सोर सुनेपछि एलियाले आफ्नो खास्टोले आफ्नो मुख ढाके, र बाहिर गए, र तिनी गुफाको मुखमा उभिए। तब एउटा आवाजले तिनलाई भन्यो, “एलिया, तँ यहाँ के गर्दैछस्?”<verse eid="1KI 19:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 19:14"/>तिनले जवाफ दिए, “याहवेह सर्वशक्तिमान् परमेश्‍वरको निम्ति म धेरै जोशिलो भएको छु। इस्राएलीहरूले तपाईंको करारलाई त्यागेका छन्। तपाईंका वेदीहरू भत्काएका छन्; अनि तपाईंका अगमवक्ताहरूलाई तरवारले मारेका छन्। अब म मात्र बाँकी रहेको छु, र तिनीहरूले मलाई पनि मार्ने कोसिस गरिरहेका छन्।”<verse eid="1KI 19:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 19:15"/>याहवेहले तिनलाई भन्‍नुभयो, “तँ आएकै बाटो फर्किजा, र दमस्कसको उजाडस्थानमा जा। तँ त्यहाँ पुगेपछि हजाएललाई अराममाथि राजा अभिषेक गर्।<verse eid="1KI 19:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 19:16"/>निम्शीका छोरा येहूलाई पनि इस्राएलमाथि राजा अभिषेक गर्; अनि अबेल-महोलाका शापातका छोरा एलीशालाई तँपछि अगमवक्ता हुनलाई अभिषेक गर्।<verse eid="1KI 19:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 19:17"/>हजाएलको तरवारबाट उम्केको जो कोहीलाई येहूले मार्नेछ; अनि येहूको तरवारबाट उम्कनेलाई एलीशाले मार्नेछ।<verse eid="1KI 19:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 19:18"/>तरै पनि बालको सामु आफ्ना घुँडा नटेकेका र आफ्ना ओठहरूले त्यसलाई चुम्बन नगरेका सात हजारलाई म इस्राएलमा बचाइराख्छु।”<verse eid="1KI 19:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 19:19"/>यसकारण एलिया त्यहाँबाट हिँडे, र तिनले शापातका छोरा एलीशालाई खेत जोत्दै गरेको भेटे। त्यहाँ बाह्र हल गोरुहरू थिए; र तिनी आफूले चाहिँ बाह्रौँ हल गोरु जोत्दैथिए। एलिया तिनीकहाँ गए, र आफ्नो खास्टो तिनलाई ओढाइदिए।<verse eid="1KI 19:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 19:20"/>तब एलीशाले आफ्ना गोरुहरू छोडे, र तिनी एलियाको पछि-पछि दगुरे। तिनले भने, “मलाई मेरा पितालाई चुम्बन गर्न र आमासित बिदा माग्न दिनुहोस्, र म तपाईंसँग आउनेछु।” एलियाले जवाफ दिए, “फर्किएर जाऊ, मैले तिमीलाई के गरेको छु र?”<verse eid="1KI 19:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 19:21"/>यसकारण एलीशा तिनलाई छोडेर फर्किए। तिनले आफ्नो एक हल गोरुलाई लिएर मारे। तिनले हलोका काठहरू बालेर मासु पकाए; र मानिसहरूलाई ती दिए, र तिनीहरूले खाए। त्यसपछि तिनी एलियालाई पछ्याउन गइहाले, र तिनका सेवक भए।<verse eid="1KI 19:21"/></para>
<chapter eid="1KI 19"/>
<chapter number="20" style="c" sid="1KI 20"/>
<para style="p"><verse number="1" style="v" sid="1KI 20:1"/>अब अरामका राजा बेन-हददले आफ्नो सम्पूर्ण फौजलाई भेला गरे। बत्तीस जना राजाहरू, तिनीहरूका घोडाहरू र रथहरूलाई साथमा लिएर अगि बढे; अनि तिनले सामरियालाई घेरा हालेर त्यसमाथि आक्रमण गरे।<verse eid="1KI 20:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 20:2"/>तिनले इस्राएलका राजा आहाबकहाँ यसो भनेर दूतहरू पठाए, “बेन-हदद यसो भन्छन्:<verse eid="1KI 20:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 20:3"/>‘तिम्रा सुन र चाँदीहरू मेरा हुन्; अनि तिम्रा सबैभन्दा असल पत्नीहरू र छोराछोरीहरू मेरै हुन्।’ ”<verse eid="1KI 20:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 20:4"/>इस्राएलका राजाले जवाफ दिए, “हे मेरा मालिक महाराजा, तपाईंले भन्‍नुभएझैँ म र मसित भएका सबै थोकहरू तपाईंकै हुन्।”<verse eid="1KI 20:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 20:5"/>दूतहरू फेरि आएर भने, “बेन-हदद यसो भन्छन्: ‘मैले तिम्रो सुन र चाँदी, तिम्रा पत्नीहरू र छोराछोरीहरूको माग गरिसकेको छु।<verse eid="1KI 20:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 20:6"/>भोलि यही समयतिर म मेरा अधिकारीहरूलाई तिम्रो दरबार र तिम्रा अधिकारीहरूका घरहरूको छानबिन गर्न पठाउनेछु। तिमीले मूल्यवान् ठानेका चीजहरू कब्जा गरेर तिनीहरूले लैजानेछन्।’ ”<verse eid="1KI 20:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 20:7"/>इस्राएलका राजाले देशका सबै प्रधानहरूलाई बोलाउन पठाए, र तिनीहरूलाई भने, “हेर्नुहोस्, यस मानिसले कसरी झगडा गर्ने मौका खोज्दैछ! त्यसले मेरा पत्नीहरू र छोराछोरीहरू अनि मेरा सुन र चाँदीहरू माग गर्दा मैले तिनलाई इन्कार गरिनँ।”<verse eid="1KI 20:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 20:8"/>तब सबै प्रधानहरू र मानिसहरूले जवाफ दिए, “तिनको कुरा नसुन्‍नुहोस्, र तिनका मागहरूप्रति सहमत नहुनुहोस्।”<verse eid="1KI 20:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 20:9"/>यसकारण तिनले बेन-हददका दूतहरूलाई जवाफ दिए, “मेरा मालिक महाराजालाई भनिदेओ, ‘तपाईंको सेवकले तपाईंले पहिले मागेका कुराहरू सबै दिनेछ, तर यो मागचाहिँ म पूरा गर्न सक्दिनँ।’ ” तिनीहरू गएर त्यो जवाफ बेन-हददकहाँ पुर्‍याइदिए।<verse eid="1KI 20:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 20:10"/>तब बेन-हददले आहाबकहाँ अर्को समाचार पठाए: “सामरियामा मेरा प्रत्येक मानिसहरूलाई एक-एक मुट्ठी पनि पुग्ने गरी धुलो बाँकी रहेछ भने मेरा देवताहरूले मप्रति कठोर व्यवहार गरून्।”<verse eid="1KI 20:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 20:11"/>इस्राएलका राजाले जवाफ दिए, “तिनलाई यसो भन्‍नू: ‘कवच धारण गर्नेले कवच उतार्नेले झैँ घमण्ड नगरोस्।’ ”<verse eid="1KI 20:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 20:12"/>जब बेन-हदद र अरू राजाहरू आफ्ना पालहरूमा मद्य पिइरहेका थिए, तब तिनले यो समाचार सुने, र तिनले आफ्ना मानिसहरूलाई “आक्रमण गर्न तयार हुनु” भनेर हुकुम दिए। यसकारण तिनीहरू सहरमाथि आक्रमण गर्न तयार भए।<verse eid="1KI 20:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 20:13"/>त्यसपछि एक जना अगमवक्ता आहाब राजाकहाँ आएर घोषणा गरे, “याहवेह यसो भन्‍नुहुन्छ: ‘के तँ यो विशाल फौज देख्दैछस्? म यसलाई आज तेरो हातमा दिनेछु, र तैँले म नै याहवेह हुँ भनी जान्‍नेछस्।’ ”<verse eid="1KI 20:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 20:14"/>आहाबले सोधे, “तर यो कसले गर्नेछ?” ती अगमवक्ताले जवाफ दिए, “याहवेह यसो भन्‍नुहुन्छ: ‘तेरा प्रान्तिय सेनापतिहरूका जवान अधिकारीहरूले गर्नेछन्।’ ” तिनले सोधे, “अनि लडाइँ कसले सुरु गर्नेछ?” ती अगमवक्ताले जवाफ दिए, “तपाईंले।”<verse eid="1KI 20:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 20:15"/>यसकारण आहाबले प्रान्तका सेनापतिहरूका 232 जना जवान अधिकारीहरूलाई बोलाउन पठाए। त्यसपछि तिनले बाँकी रहेका 7,000 इस्राएलीहरूलाई भेला गराए।<verse eid="1KI 20:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 20:16"/>तिनीहरू मध्यदिनमा निस्के। त्यो समयमा बेन-हददचाहिँ तिनीसित भएका बत्तीस जना राजाहरूसित आ-आफ्ना पालहरूभित्र मद्यले लठ्ठ भइरहेका थिए।<verse eid="1KI 20:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 20:17"/>प्रान्तका सेनापतिहरूका जवान अधिकारीहरू पहिले निस्के। बेन-हददले जासुसहरू पठाएका थिए, जसले यस्तो खबर ल्याए, “मानिसहरू सामरियाबाट यतातिर बढिरहेका छन्।”<verse eid="1KI 20:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 20:18"/>तिनले भने, “चाहे तिनीहरू शान्तिको निम्ति आएका हुन् अथवा युद्धको निम्ति आएका हुन्, तिनीहरूलाई जिउँदै पक्र।”<verse eid="1KI 20:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 20:19"/>प्रान्तका सेनापतिहरूका ती जवान अधिकारीहरू सहरबाट अगि-अगि निस्के; र फौजचाहिँ तिनीहरूका पछि-पछि निस्के।<verse eid="1KI 20:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 20:20"/>अनि प्रत्येकले आफ्नो शत्रुलाई मारे। यसरी अरामीहरू भागे; र इस्राएलीहरूले उनीहरूलाई खेदे। तर अरामका राजा बेन-हदद घोडामा चढेर आफ्ना केही घोडसवारहरूसित उम्किए।<verse eid="1KI 20:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 20:21"/>इस्राएलका राजा अगि बढे; अनि घोडाहरू र रथहरूलाई नाश गरे, र अरामीहरूको ठूलो नोक्सानी गरे।<verse eid="1KI 20:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 20:22"/>पछिबाट ती अगमवक्ता इस्राएलका राजाकहाँ आएर भने, “आफ्नो स्थिति बलियो पार्नुहोस्, र अब के गर्ने हो, सो विचार गर्नुहोस्; किनकि आउँदो बसन्त ऋतुमा अरामका राजाले तपाईंमाथि फेरि आक्रमण गर्नेछन्।”<verse eid="1KI 20:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 20:23"/>त्यसपछि अरामका राजाका अधिकारीहरूले तिनलाई सल्‍लाह दिए, “तिनीहरूका देवताहरू पहाडका देवताहरू हुन्। त्यसैकारण तिनीहरू हाम्रो निम्ति अधिक शक्तिशाली थिए। तर यदि हामीले मैदानमा तिनीहरूसित युद्ध गर्‍यौँ भने हामी तिनीहरूभन्दा शक्तिशाली हुनेछौँ।<verse eid="1KI 20:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 20:24"/>यसो गर्नुहोस्: सबै राजाहरूलाई हटाएर तिनीहरूका ठाउँमा अरू अधिकारीहरूलाई खटाउनुहोस्।<verse eid="1KI 20:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 20:25"/>तपाईंले गुमाउनुभएको त्यो फौजजतिकै ठूलो सेना आफ्नो निम्ति भेला गर्नुहोस्। अनि घोडाको बदली घोडा, र रथको बदली रथ खडा गर्नुहोस्। अनि हामी इस्राएलीहरूसित मैदानमा युद्ध गर्न सक्नेछौँ। तब हामी निश्‍चय नै तिनीहरूभन्दा शक्तिशाली हुनेछौँ।” तिनी उनीहरूसित सहमत भए, र त्यस्तै गरे।<verse eid="1KI 20:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 20:26"/>आउँदो बसन्त ऋतुमा बेन-हददले अरामीहरूलाई भेला गरे, र इस्राएलको विरुद्धमा लडाइँ गर्न अपेकतर्फ गए।<verse eid="1KI 20:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 20:27"/>इस्राएलीहरूलाई पनि भेला गराइयो, र तिनीहरूका निम्ति खानेकुरा जुटाइयो; अनि उनीहरूसित लडाइँ गर्नलाई तिनीहरू निस्के। इस्राएलीहरू तिनीहरूका सामु बाख्राका दुई वटा साना बथानझैँ छाउनी हालेर बसे; र अरामीहरूले चाहिँ बस्ती नै ढाकेर बसे।<verse eid="1KI 20:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 20:28"/>एक जना परमेश्‍वरका जनले आएर इस्राएलका राजालाई भने, “याहवेह यसो भन्‍नुहुन्छ: ‘अरामीहरूले याहवेह बेँसीको होइन, तर पहाडको देवता हुन् भनी सम्झेका हुनाले म यस विशाल फौजलाई तेरो हातमा सुम्पिदिनेछु। अनि तैँले म नै याहवेह हुँ भनी जान्‍नेछस्।’ ”<verse eid="1KI 20:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 20:29"/>सात दिनसम्म तिनीहरूले आमने-सामने छाउनी हालेर बसे, र सातौँ दिन युद्ध भयो। इस्राएलीहरूले एकै दिनमा अरामीहरूका एक लाख पैदल सेनालाई मारे।<verse eid="1KI 20:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 20:30"/>तिनीहरूका बाँकी रहेकाहरूचाहिँ अपेकको सहरमा भागे, जहाँ तिनीहरूमध्ये सत्ताइस हजारचाहिँ पर्खाल ढलेर मरे। बेन-हददचाहिँ सहरमा भागेर गए, र भित्री कोठामा गएर लुके।<verse eid="1KI 20:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 20:31"/>तिनका अधिकारीहरूले तिनलाई भने, “हेर्नुहोस्, हामीले इस्राएलका घरानाका राजाहरू कृपालु हुन्छन् भनेर सुनेका छौँ। हामी कम्मरमा भाङ्ग्रा लगाऔँ, शिरमा डोरीहरू बाँधौँ र इस्राएलका राजाकहाँ जाऔँ। सायद तिनले तपाईंको प्राण जोगाइदेलान् कि।”<verse eid="1KI 20:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 20:32"/>तब तिनीहरूले आफ्ना कम्मरमा भाङ्ग्रा लगाए, र शिरमा डोरी बाँधे; अनि इस्राएलका राजाकहाँ गएर भने, “तपाईंको सेवक बेन-हदद भन्छन्: ‘दया गरी मलाई बाँच्न दिनुहोस्।’ ” राजाले जवाफ दिए, “के तिनी जीवितै छन्? तिनी त मेरा भाइ हुन्।”<verse eid="1KI 20:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 20:33"/>ती मानिसहरूले यसलाई एउटा असल लक्षण भन्‍ने सम्झे, र झट्टै तिनको कुरामा मौका पारेर भने, “हो, तपाईंको भाइ बेन-हदद नै हुन्!” तब राजाले भने, “गएर तिनलाई ल्याओ।” जब बेन-हदद निस्केर आए, तब राजाले तिनलाई आफ्नो रथमा चढाए।<verse eid="1KI 20:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 20:34"/>बेन-हददले भने, “मेरा पिताले तपाईंका पिताबाट लिएका सहरहरू म फर्काइदिनेछु। मेरा पिताले सामरियामा गरेझैँ तपाईंले दमस्कसमा आफ्नै व्यापार स्थलहरू राख्न सक्नुहुन्छ।” आहाबले भने, “म एउटा सन्धिको आधारमा तपाईंलाई छोडिदिनेछु।” यसकारण तिनले उनीसित एउटा सन्धि गरे, र उनलाई जान दिए।<verse eid="1KI 20:34"/></para>
<para style="p"><verse number="35" style="v" sid="1KI 20:35"/>याहवेहको वचनअनुसार अगमवक्ताहरूका छोराहरूमध्ये एक जनाले आफ्ना साथीलाई भने, “मलाई तिम्रो हतियारले प्रहार गर,” तर त्यस मानिसले अस्वीकार गर्‍यो।<verse eid="1KI 20:35"/></para>
<para style="p"><verse number="36" style="v" sid="1KI 20:36"/>यसकारण ती अगमवक्ताले भने, “याहवेहको आज्ञापालन नगरेका हुनाले तिमी मबाट जानसाथ एउटा सिंहले तिमीलाई मार्नेछ।” अनि त्यो मानिस जानेबित्तिक्‍कै एउटा सिंहले भेट्टायो, र त्यसलाई मार्‍यो।<verse eid="1KI 20:36"/></para>
<para style="p"><verse number="37" style="v" sid="1KI 20:37"/>ती अगमवक्ताले अर्को मानिसलाई भेटेर भने, “दया गरी मलाई प्रहार गर्नुहोस्।” यसकारण ती मानिसले तिनलाई प्रहार गरेर घाइते बनाइदिए।<verse eid="1KI 20:37"/></para>
<para style="p"><verse number="38" style="v" sid="1KI 20:38"/>त्यसपछि ती अगमवक्ता त्यहाँबाट हिँडे, र तिनले आफ्ना शिरको फेटा आँखासम्म झारेर भेष बदले। अनि बाटोको किनारमा राजाको बाटो हेर्दै पर्खिरहे।<verse eid="1KI 20:38"/></para>
<para style="p"><verse number="39" style="v" sid="1KI 20:39"/>जब राजा त्यहाँबाट गए, तब ती अगमवक्ताले कराएर तिनलाई भने, “तपाईंको सेवक लडाइँको मुखैमा पुग्यो। अनि कसैले एउटा कैदी लिएर मकहाँ आएर भन्यो, ‘यस मानिसमाथि नजर राख। यदि यो हरायो भने यसको जीवनको सट्टा तिम्रो जीवन दिनुपर्नेछ, नत्रता तिमीले एक टालेन्ट चाँदी तिर्नुपर्नेछ।’<verse eid="1KI 20:39"/></para>
<para style="p"><verse number="40" style="v" sid="1KI 20:40"/>तपाईंको सेवक यताउता व्यस्त हुँदा त्यो मानिस हराइहाल्यो।” तब इस्राएलका राजाले भने, “तँ आफैँले तेरो न्यायको निर्णय गरिस्।”<verse eid="1KI 20:40"/></para>
<para style="p"><verse number="41" style="v" sid="1KI 20:41"/>ती अगमवक्ताले झट्टै आफ्ना आँखाबाट त्यो शिरको फेटा हटाए; तब इस्राएलका राजाले तिनलाई अगमवक्ताहरूमध्ये एक हुन् भनी चिने।<verse eid="1KI 20:41"/></para>
<para style="p"><verse number="42" style="v" sid="1KI 20:42"/>तिनले राजालाई भने, “याहवेह यसो भन्‍नुहुन्छ: ‘मैले मारिनैपर्छ भनेर निश्‍चय गरेको मानिसलाई तैँले छोडिदिइस्। यसकारण त्यसको प्राणको साटो तेरो प्राण र त्यसका मानिसहरूको साटो तेरा मानिसहरू हुनेछन्।’ ”<verse eid="1KI 20:42"/></para>
<para style="p"><verse number="43" style="v" sid="1KI 20:43"/>यो सुनेर इस्राएलका राजा उदास र क्रोधित भई सामरियामा भएको तिनको महलमा गए।<verse eid="1KI 20:43"/></para>
<chapter eid="1KI 20"/>
<chapter number="21" style="c" sid="1KI 21"/>
<para style="p"><verse number="1" style="v" sid="1KI 21:1"/>केही समय बितेपछि यिजरेली नाबोतको दाखबारीको विषयलाई लिएर एउटा घटना घट्यो। त्यो दाखबारी यिजरेलमा सामरियाका राजा आहाबको महलको छेउमा थियो।<verse eid="1KI 21:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 21:2"/>आहाबले नाबोतलाई भने, “तिम्रो दाखबारी मेरो दरबारको छेउमा भएकोले त्यो मलाई मेरो करेसाबारी बनाउनलाई देऊ। त्यसको सट्टामा म तिमीलाई अझ उत्तम दाखबारी दिनेछु, अथवा यदि तिमी चाहन्छौ भने त्यसको जति मूल्य पर्छ, सो म तिर्नेछु।”<verse eid="1KI 21:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 21:3"/>तर नाबोतले जवाफ दिए, “आफ्ना पुर्खाहरूको पैतृक सम्पत्ति तपाईंलाई दिन सक्दिनँ। याहवेहले यसो हुन नदेऊन्।”<verse eid="1KI 21:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 21:4"/>यिजरेली नाबोतले “म आफ्ना पुर्खाहरूको पैतृक सम्पत्ति तपाईंलाई दिनेछैनँ” भनेको सुनेर आहाब उदास र क्रोधित भएर घर गए। तिनी खिन्‍न भई आफ्नो ओछ्यानमा ढल्किरहे, र केही पनि खाएनन्।<verse eid="1KI 21:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 21:5"/>तिनकी पत्नी ईजेबेलले भित्र आएर तिनलाई सोधिन्, “तपाईं किन उदास हुनुहुन्छ? तपाईं किन केही खानुहुन्‍न?”<verse eid="1KI 21:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 21:6"/>तिनले उनलाई जवाफ दिए, “किनकि मैले यिजरेली नाबोतलाई भनेँ, ‘मलाई तिम्रो दाखबारी बेच, अथवा यदि तिमी चाहन्छौ भने त्यसको सट्टामा म अर्को दाखबारी दिनेछु।’ तर त्यसले भन्यो, ‘म तपाईंलाई मेरो दाखबारी दिन्‍नँ।’ ”<verse eid="1KI 21:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 21:7"/>तिनकी पत्नी ईजेबेलले भनिन्, “के तपाईंले इस्राएलमा यसरी नै राजा भएर काम गर्नुहुन्छ? उठेर खानुहोस्। प्रसन्‍न रहनुहोस्। म तपाईंलाई यिजरेली नाबोतको दाखबारी दिलाउनेछु।”<verse eid="1KI 21:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 21:8"/>यसकारण उनले आहाबको नाममा चिट्ठीहरू लेखिन्, र त्यसमा मोहर लगाइन्; अनि ती चिट्ठीहरू नाबोतको सहरमा तिनीसित बस्‍ने प्रधानहरू र भारदारहरूकहाँ पठाइन्।<verse eid="1KI 21:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 21:9"/>ती चिट्ठीहरूमा तिनले यसरी लेखिन्: “उपवासको एक दिन घोषणा गर्नू, र नाबोतलाई मानिसहरूका बीचमा प्रमुख स्थानमा राख्नू।<verse eid="1KI 21:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 21:10"/>तर त्यसको सामु दुई जना दुष्‍ट व्यक्तिहरूलाई बसाउनू। अनि त्यसले परमेश्‍वर र राजा दुवैलाई सरापेको छ भनी तिनीहरूलाई साक्षी दिन लगाउनू। त्यसपछि त्यसलाई बाहिर लगेर ढुङ्गाले हानेर मार्नू।”<verse eid="1KI 21:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 21:11"/>यसकारण नाबोतको सहरमा बस्‍ने ती प्रधानहरू र भारदारहरूले ईजेबेलले तिनीहरूलाई लेखेका चिट्ठीहरूमा हुकुम दिएअनुसार गरे।<verse eid="1KI 21:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 21:12"/>तिनीहरूले उपवासको दिन घोषणा गरे; अनि नाबोतलाई मानिसहरूका बीचमा प्रमुख स्थानमा बसाए।<verse eid="1KI 21:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 21:13"/>तब दुई नीच व्यक्तिहरू आएर त्यसका सामु बसे; अनि “नाबोतले परमेश्‍वर र राजा दुवैलाई सरापेको छ” भनेर नाबोतको विरुद्धमा अभियोग लगाए। यसकारण तिनीहरूले नाबोतलाई सहरबाहिर लगेर ढुङ्गाले हानेर मारे।<verse eid="1KI 21:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 21:14"/>तब तिनीहरूले ईजेबेलकहाँ यसो भनी खबर पठाइदिए, “नाबोतलाई ढुङ्गाले हानेर मारियो।”<verse eid="1KI 21:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 21:15"/>नाबोतलाई ढुङ्गाले हानेर मारियो भन्‍ने ईजेबेलले सुन्‍नेबित्तिकै तिनले आहाबलाई भनिन्, “उठ्नुहोस् र यिजरेली नाबोतले तपाईंलाई बेच्न इन्कार गरेको त्यसको दाखबारीमाथि अधिकार गर्नुहोस्। ऊ अब जीवित छैन।”<verse eid="1KI 21:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 21:16"/>जब आहाबले नाबोत मरेको सुने, तब तिनी उठेर यिजरेली नाबोतको दाखबारीमाथि अधिकार गर्न गए।<verse eid="1KI 21:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 21:17"/>तब याहवेहको वचन तिश्बी एलियाकहाँ आयो:<verse eid="1KI 21:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 21:18"/>“सामरियामा राज्य गर्ने इस्राएलका राजा आहाबकहाँ जानू। त्यो अहिले नाबोतको दाखबारीमाथि अधिकार गर्नलाई त्यहीँ गएको छ।<verse eid="1KI 21:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 21:19"/>त्यसलाई भन्‍नू, ‘याहवेह यसो भन्‍नुहुन्छ: के तँलाई नाबोतको हत्या गरेर पुगेन र त्यसको सम्पत्ति पनि खोसिस्?’ त्यसपछि त्यसलाई भन्‍नू, ‘याहवेह यसो भन्‍नुहुन्छ: जहाँ कुकुरहरूले नाबोतको रगत चाटेका थिए, त्यही ठाउँमा तेरो पनि रगत कुकुरहरूले चाट्नेछन्!’ ”<verse eid="1KI 21:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 21:20"/>आहाबले एलियालाई भने, “ए मेरो शत्रु, के तैँले मलाई भेट्टाइस्?” तिनले जवाफ दिए, “मैले तपाईंलाई भेट्टाएँ; किनकि याहवेहको दृष्‍टिमा दुष्‍टता गर्नलाई तपाईंले आफैँलाई बेच्नुभयो।<verse eid="1KI 21:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 21:21"/>तिनले भने, ‘अब म तपाईंमाथि विपत्ति ल्याउनेछु। म तपाईंका सन्तानहरूलाई भस्म पार्नेछु र कमारा होस् कि फुक्‍का, आहाबका प्रत्येक पुरुषलाई नाश गर्नेछु।<verse eid="1KI 21:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 21:22"/>म तपाईंका घरानालाई नबातका छोरा यारोबाम र बाशाका छोरा अहीयाहको जस्तै बनाउनेछु। किनकि तपाईंले मलाई रिस उठाउनुभयो र इस्राएललाई पाप गर्न लगाउनुभयो।’<verse eid="1KI 21:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 21:23"/>“ईजेबेलको विषयमा पनि याहवेह भन्‍नुहुन्छ: ‘यिजरेलको पर्खालको छेउमा ईजेबेललाई कुकुरहरूले खानेछन्।’<verse eid="1KI 21:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 21:24"/>“आहाबका जति जना सहरमा मर्छन्, तिनीहरूलाई कुकुरहरूले खानेछन्, र गाउँमा मर्नेहरूलाई आकाशका पक्षीहरूले खानेछन्।”<verse eid="1KI 21:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 21:25"/>(आहाबजस्तो आफ्नी पत्नी ईजेबेलद्वारा उक्साइएर याहवेहको दृष्‍टिमा दुष्‍टता गर्न आफैँलाई बेच्ने अर्को मानिस कहिल्यै कोही थिएन।<verse eid="1KI 21:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 21:26"/>एमोरीहरूलेझैँ आहाबले मूर्तिहरूको पछि लागेर तिनले अति नै नीच काम गरे। ती एमोरीहरूलाई याहवेहले इस्राएलीहरूका सामुबाट धपाउनुभएको थियो।)<verse eid="1KI 21:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 21:27"/>यो कुरा सुनेपछि आहाबले आफ्ना वस्त्र च्याते, भाङ्ग्रा लगाए, र उपवास बसे। तिनी भाङ्ग्रा लगाएरै सुते, र उदास भई हिँडे।<verse eid="1KI 21:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 21:28"/>तब याहवेहको वचन तिश्बी एलियाकहाँ आयो,<verse eid="1KI 21:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 21:29"/>“आहाबले आफूलाई मेरो सामु विनम्र तुल्याएको के तैँले ध्यान दिइस्? त्यसले आफूलाई विनम्र तुल्याएकोले म त्यसको समयमा यी विपत्ति ल्याउनेछैनँ, तर त्यसको छोराको समयमा त्यसको घरानामाथि त्यो ल्याउनेछु।”<verse eid="1KI 21:29"/></para>
<chapter eid="1KI 21"/>
<chapter number="22" style="c" sid="1KI 22"/>
<para style="p"><verse number="1" style="v" sid="1KI 22:1"/>तीन वर्षसम्म अराम र इस्राएलको बीचमा कुनै युद्ध भएन।<verse eid="1KI 22:1"/></para>
<para style="p"><verse number="2" style="v" sid="1KI 22:2"/>तर तेस्रो वर्षमा यहूदाका राजा यहोशापात इस्राएलका राजा आहाबलाई भेट्न गए।<verse eid="1KI 22:2"/></para>
<para style="p"><verse number="3" style="v" sid="1KI 22:3"/>इस्राएलका राजाले आफ्ना अधिकारीहरूलाई भने, “रामोत-गिलाद हाम्रो हो; र पनि हामीले त्यसलाई अरामका राजाबाट फिर्ता लिन केही पनि गरेका छैनौँ भनी तपाईंहरूलाई थाहा छैन?”<verse eid="1KI 22:3"/></para>
<para style="p"><verse number="4" style="v" sid="1KI 22:4"/>यसकारण तिनले यहोशापातलाई सोधे, “के तपाईं हामीसित रामोत-गिलादको विरुद्धमा युद्ध गर्न जानुहुन्छ?” यहोशापातले इस्राएलका राजालाई जवाफ दिए, “म तपाईंजस्तै हुँ, मेरा मानिसहरू तपाईंका मानिसहरूजस्तै हुन्। मेरा घोडाहरू तपाईंकै घोडाहरूजस्तै हुन्।”<verse eid="1KI 22:4"/></para>
<para style="p"><verse number="5" style="v" sid="1KI 22:5"/>तर यहोशापातले इस्राएलका राजालाई यो पनि भने, “पहिले याहवेहसित सल्‍लाह माग्नुहोस्।”<verse eid="1KI 22:5"/></para>
<para style="p"><verse number="6" style="v" sid="1KI 22:6"/>यसकारण इस्राएलका राजाले चार सय जति अगमवक्ताहरू भेला गराएर तिनीहरूलाई सोधे, “म रामोत-गिलादको विरुद्धमा युद्ध गर्न जाऊँ कि नजाऊँ?” तिनीहरूले भने, “जानुहोस्, किनकि प्रभुले त्यसलाई राजाको हातमा दिनुहुनेछ।”<verse eid="1KI 22:6"/></para>
<para style="p"><verse number="7" style="v" sid="1KI 22:7"/>तर यहोशापातले सोधे, “यहाँ याहवेहका कुनै अगमवक्ता छैनन्, जसलाई हामीले यसको बारेमा सोध्न सकौँ?”<verse eid="1KI 22:7"/></para>
<para style="p"><verse number="8" style="v" sid="1KI 22:8"/>इस्राएलका राजाले यहोशापातलाई जवाफ दिए, “याहवेहसित सल्‍लाह लिन एक जना मानिस त छ, तर म उसलाई घृणा गर्छु; किनकि उसले मेरो विषयमा कहिल्यै पनि भलो अगमवाणी गर्दैन; सधैँ कुभलो मात्र गर्छ। ऊ यिम्‍लाको छोरा मीकाया हो।” यहोशापातले जवाफ दिए, “राजाले त्यसो भन्‍नुहुँदैन।”<verse eid="1KI 22:8"/></para>
<para style="p"><verse number="9" style="v" sid="1KI 22:9"/>यसकारण इस्राएलका राजाले आफ्ना एक जना अधिकारीलाई बोलाएर भने, “झट्टै यिम्‍लाका छोरा मीकायालाई लिएर आऊ।”<verse eid="1KI 22:9"/></para>
<para style="p"><verse number="10" style="v" sid="1KI 22:10"/>आफ्ना राजकीय पोशाकहरू पहिरेर इस्राएलका राजा र यहूदाका राजा यहोशापात सामरियाको मूलढोकाको प्रवेशद्वार नजिकको खलामा आफ्ना सिंहासनहरूमा बसिरहेका थिए। सबै अगमवक्ताहरूले तिनीहरूका सामु अगमवाणी गरिरहेका थिए।<verse eid="1KI 22:10"/></para>
<para style="p"><verse number="11" style="v" sid="1KI 22:11"/>केनानका छोरा सिदकियाहले फलामका सिङहरू बनाएका थिए; अनि तिनले घोषणा गरे, “याहवेह यसो भन्‍नुहुन्छ: ‘यी सिङहरूद्वारा नै तिमीहरूले अरामीहरूलाई तिनीहरू नाश नभएसम्म हान्‍नेछौ।’ ”<verse eid="1KI 22:11"/></para>
<para style="p"><verse number="12" style="v" sid="1KI 22:12"/>अरू सबै अगमवक्ताहरूले पनि अगमवाणीद्वारा त्यही कुरा भनिरहेका थिए। तिनीहरूले भने, “रामोत-गिलादमाथि आक्रमण गरेर विजयी हुनुहोस्; किनकि याहवेहले त्यसलाई राजाको हातमा दिनुहुनेछ।”<verse eid="1KI 22:12"/></para>
<para style="p"><verse number="13" style="v" sid="1KI 22:13"/>मीकायालाई बोलाउन जाने समाचारवाहकले तिनलाई भने, “हेर्नुहोस्, अरू अगमवक्ताहरूले एकै मत भएर राजाको सफलताको पूर्व सूचना दिइरहेका छन्। तपाईं पनि तिनीहरूसितै सहमत भएर असल कुरा बोलिदिनुहोस्।”<verse eid="1KI 22:13"/></para>
<para style="p"><verse number="14" style="v" sid="1KI 22:14"/>तर मीकायाले भने, “निश्‍चय नै जीवित याहवेहलाई साक्षी राखेर म भन्दछु, म तिनलाई याहवेहले मलाई भन्‍नुभएको कुरा मात्र भन्‍नेछु।”<verse eid="1KI 22:14"/></para>
<para style="p"><verse number="15" style="v" sid="1KI 22:15"/>तिनीहरू आइपुगेपछि राजाले तिनलाई सोधे, “मीकाया, हामी रामोत-गिलादको विरुद्धमा युद्ध गर्न जाऊँ कि नजाऊँ?” तिनले जवाफ दिए, “आक्रमण गरेर विजयी हुनुहोस्। किनकि याहवेहले त्यसलाई राजाको हातमा दिनुहुनेछ।”<verse eid="1KI 22:15"/></para>
<para style="p"><verse number="16" style="v" sid="1KI 22:16"/>राजाले तिनलाई भने, “मलाई सत्यबाहेक केही नभन्‍नू भनी म तिमीलाई कति पल्ट याहवेहको नाममा शपथ खान लाऊँ?”<verse eid="1KI 22:16"/></para>
<para style="p"><verse number="17" style="v" sid="1KI 22:17"/>तब मीकायाले जवाफ दिए, “मैले इस्राएललाई गोठाला नभएका भेडाहरूझैँ पहाडतिर छरिएको देखेँ, र याहवेहले भन्‍नुभयो, ‘यी मानिसहरूका मालिक छैनन्। प्रत्येक शान्तिसँग आ-आफ्नो घर फर्केर जाऊन्।’ ”<verse eid="1KI 22:17"/></para>
<para style="p"><verse number="18" style="v" sid="1KI 22:18"/>इस्राएलका राजाले यहोशापातलाई भने, “यसले मेरो विषयमा कुभलोबाहेक कहिले पनि असल अगमवाणी गर्दैन भनेर के मैले तपाईंलाई भनेको थिइनँ र?”<verse eid="1KI 22:18"/></para>
<para style="p"><verse number="19" style="v" sid="1KI 22:19"/>मीकायाले भन्दै गए, “यसकारण याहवेहको वचन सुन्‍नुहोस्: मैले याहवेहलाई सिंहासनमा बसिरहनुभएको देखेँ। उहाँका चारैतिर दाहिने र देब्रेपट्टि स्वर्गीय सेना उभिरहेका थिए।<verse eid="1KI 22:19"/></para>
<para style="p"><verse number="20" style="v" sid="1KI 22:20"/>तब याहवेहले भन्‍नुभयो, ‘कसले आहाबलाई रामोत-गिलादमाथि आक्रमण गरेर त्यहाँ मार्नलाई बहकाउनेछ?’ “एउटाले एउटा कुरा भने, र अर्कोले अर्कै भने।<verse eid="1KI 22:20"/></para>
<para style="p"><verse number="21" style="v" sid="1KI 22:21"/>आखिरमा एउटा आत्माले अगि सरेर याहवेहको सामु उभिएर भन्यो, ‘म तिनलाई बहकाउनेछु।’<verse eid="1KI 22:21"/></para>
<para style="p"><verse number="22" style="v" sid="1KI 22:22"/>“याहवेहले सोध्नुभयो, ‘कुन तरिकाले?’ “त्यसले भन्यो, ‘म निस्केर जानेछु, र त्यसका सबै अगमवक्ताहरूका मुखमा झूट बोल्ने आत्मा हुनेछु।’ “याहवेहले भन्‍नुभयो, ‘तँ त्यसलाई बहकाउन सफल हुनेछस्। जा, गएर त्यसै गर्।’<verse eid="1KI 22:22"/></para>
<para style="p"><verse number="23" style="v" sid="1KI 22:23"/>“यसरी अब याहवेहले तपाईंका यी सबै अगमवक्ताहरूका मुखमा एउटा झूट बोल्ने आत्मा हालिदिनुभएको छ। याहवेहले तपाईंको निम्ति विपत्तिको फैसला गर्नुभएको छ।”<verse eid="1KI 22:23"/></para>
<para style="p"><verse number="24" style="v" sid="1KI 22:24"/>तब केनानका छोरा सिदकियाह उठेर गए, र मीकायाको अनुहारमा थप्पड लगाए। तिनले सोधे, “कहिले याहवेहको आत्मा मबाट निस्केर तिमीसित बोल्न जानुभयो?”<verse eid="1KI 22:24"/></para>
<para style="p"><verse number="25" style="v" sid="1KI 22:25"/>मीकायाले जवाफ दिए, “त्यो त तिमी भित्री कोठामा लुक्न गएको दिन थाहा पाउनेछौ।”<verse eid="1KI 22:25"/></para>
<para style="p"><verse number="26" style="v" sid="1KI 22:26"/>तब इस्राएलका राजाले हुकुम दिए, “मीकायालाई लिएर सहरका शासक अमोन र राजाको छोरा योआशकहाँ पठाइदिनू,<verse eid="1KI 22:26"/></para>
<para style="p"><verse number="27" style="v" sid="1KI 22:27"/>अनि भन्‍नू, ‘राजा यसो भन्‍नुहुन्छ: यसलाई झ्यालखानामा हालिदिनू, र म सुरक्षित नफर्केसम्म यसलाई रोटी र पानीबाहेक अरू केही नदिनू।’ ”<verse eid="1KI 22:27"/></para>
<para style="p"><verse number="28" style="v" sid="1KI 22:28"/>मीकायाले घोषणा गरे, “यदि तपाईं सुरक्षित फर्कनुभयो भने याहवेह मद्वारा बोल्नुभएको होइन।” त्यसपछि तिनले अझ थपे, “तिमीहरू सबैले मेरो कुरा याद राख्नू!”<verse eid="1KI 22:28"/></para>
<para style="p"><verse number="29" style="v" sid="1KI 22:29"/>यसकारण इस्राएलका राजा र यहूदाका राजा यहोशापात रामोत-गिलादमा गए।<verse eid="1KI 22:29"/></para>
<para style="p"><verse number="30" style="v" sid="1KI 22:30"/>इस्राएलका राजाले यहोशापातलाई भने, “म लडाईँमा भेष बदलेर प्रवेश गर्नेछु; तर तपाईंले चाहिँ आफ्नो राजकीय पोशाक पहिरनुहोस्।” यसकारण इस्राएलका राजाले आफ्नो भेष बदली गरेर लडाइँ गर्न हिँडे।<verse eid="1KI 22:30"/></para>
<para style="p"><verse number="31" style="v" sid="1KI 22:31"/>अब अरामका राजाले भने आफ्ना बत्तीस जना रथहरूका सेनापतिहरूलाई यस्तो हुकुम दिएका थिए, “इस्राएलका राजाबाहेक साना-ठूला कसैसित पनि लडाइँ नगर्नू।”<verse eid="1KI 22:31"/></para>
<para style="p"><verse number="32" style="v" sid="1KI 22:32"/>जब ती रथका सेनापतिहरूले यहोशापातलाई देखे, तब तिनीहरूले सोचे, “निश्‍चय उहाँ नै इस्राएलका राजा हुनुहुन्छ।” यसकारण तिनीहरू उनीमाथि आक्रमण गर्नलाई फर्के, तर जब यहोशापात कराए,<verse eid="1KI 22:32"/></para>
<para style="p"><verse number="33" style="v" sid="1KI 22:33"/>तब ती रथका सेनापतिहरूले तिनी इस्राएलका राजा होइन रहेछन् भनी देखे। अनि तिनीहरूले उनलाई पछ्याउन छोडे।<verse eid="1KI 22:33"/></para>
<para style="p"><verse number="34" style="v" sid="1KI 22:34"/>तर कसैले आफ्नो धनु झिकेर जथाभाबी हान्‍न थाल्यो, र त्यसले इस्राएलका राजालाई तिनको कवचको जोर्नीमा लाग्यो। राजाले आफ्नो सारथीलाई भने, “रथलाई फर्का, र मलाई युद्ध-भूमीबाट बाहिर लैजा। मलाई चोट लागेको छ।”<verse eid="1KI 22:34"/></para>
<para style="p"><verse number="35" style="v" sid="1KI 22:35"/>युद्ध दिनभरि नै चलिरह्‍यो र राजालाईचाहिँ आफ्नो रथमा अड्याएर अरामीहरूतिर फर्काइएको थियो। तिनको चोटबाट रथमा रगत बगिरहेको थियो; र त्यही बेलुकी तिनको मृत्यु भयो।<verse eid="1KI 22:35"/></para>
<para style="p"><verse number="36" style="v" sid="1KI 22:36"/>सूर्यास्त हुँदै गर्दा फौजभरि यस्तो उर्दी भयो, “प्रत्येक मानिस आ-आफ्ना सहरमा फर्क। हरेक आफ्नै ठाउँमा फर्क!”<verse eid="1KI 22:36"/></para>
<para style="p"><verse number="37" style="v" sid="1KI 22:37"/>यसरी राजाको मृत्यु भयो, र तिनी सामरियामा ल्याइए। अनि तिनीहरूले उनलाई त्यहाँ गाडे।<verse eid="1KI 22:37"/></para>
<para style="p"><verse number="38" style="v" sid="1KI 22:38"/>तिनीहरूले रथलाई सामरियाको एउटा तलाउमा धोए (जहाँ वेश्याहरू नुहाउने गर्थे) र याहवेहको वचनले घोषणा गरेझैँ कुकुरहरूले तिनको रगत चाटे।<verse eid="1KI 22:38"/></para>
<para style="p"><verse number="39" style="v" sid="1KI 22:39"/>आहाबका शासनका अरू घटनाहरू र तिनले गरेका सबै कामहरू, तिनले हस्तीदन्तले बनाएका महल, अनि तिनले पर्खाल लगाएका सहरहरूको विषयमा चाहिँ इस्राएलका राजाहरूका इतिहासको पुस्तकमा लेखिएका छैनन् र?<verse eid="1KI 22:39"/></para>
<para style="p"><verse number="40" style="v" sid="1KI 22:40"/>आहाब आफ्ना पुर्खाहरूसित विश्राममा प्रवेश गरे। तिनका छोरा अहज्याह तिनीपछि राजा भए।<verse eid="1KI 22:40"/></para>
<para style="p"><verse number="41" style="v" sid="1KI 22:41"/>इस्राएलका राजा आहाबको चौथो वर्षमा आसाका छोरा यहोशापात यहूदाका राजा भए।<verse eid="1KI 22:41"/></para>
<para style="p"><verse number="42" style="v" sid="1KI 22:42"/>राजा हुँदा यहोशापात पैँतीस वर्षका थिए; र तिनले यरूशलेममा पच्‍चीस वर्ष राज्य गरे। तिनकी आमाको नाम अजूबा थियो, जो शिल्हीकी छोरी थिइन्।<verse eid="1KI 22:42"/></para>
<para style="p"><verse number="43" style="v" sid="1KI 22:43"/>प्रत्येक कुरामा तिनी आफ्ना पिता आसाका चालहरूमा हिँडिरहे, र तिनी तीबाट यताउता लागेनन्। तिनले याहवेहको दृष्‍टिमा जे ठिक थियो, त्यही गरे। तैपनि देवस्थानहरू हटाइएनन्; र मानिसहरूले त्यहाँ निरन्तर बलिदानहरू चढाए र धूप बाले।<verse eid="1KI 22:43"/></para>
<para style="p"><verse number="44" style="v" sid="1KI 22:44"/>यहूदाका राजा यहोशापात इस्राएलका राजासँग मेलमिलाप राखे।<verse eid="1KI 22:44"/></para>
<para style="p"><verse number="45" style="v" sid="1KI 22:45"/>यहोशापातको शासनका अरू घटनाहरू, तिनले गरेका उपलब्धीहरू र तिनका फौजी वीरताको विषयमा ती यहूदाका राजाका पुस्तकहरूमा लेखिएका छैनन् र?<verse eid="1KI 22:45"/></para>
<para style="p"><verse number="46" style="v" sid="1KI 22:46"/>तिनले देशलाई बाँकी रहेका देवस्थानका देवदासहरूबाट मुक्त गरे, जुन तिनका पिता आसाको शासनकालपछि पनि रहेका थिए।<verse eid="1KI 22:46"/></para>
<para style="p"><verse number="47" style="v" sid="1KI 22:47"/>त्यस बेला एदोममा कुनै राजा थिएनन्; तर प्रान्तिय राज्यपालले शासन गर्थे।<verse eid="1KI 22:47"/></para>
<para style="p"><verse number="48" style="v" sid="1KI 22:48"/>ओपीरबाट सुन ल्याउन भनी यहोशापातले व्यापारी जहाजहरू बनाए। तर एस्योन-गेबेरमा ती जहाजहरू भत्किएका हुनाले तिनीहरू तर्शीशमा कहिल्यै पुगेनन्।<verse eid="1KI 22:48"/></para>
<para style="p"><verse number="49" style="v" sid="1KI 22:49"/>त्यस बेला आहाबका छोरा अहज्याहले यहोशापातलाई भने, “मेरा मानिसहरूलाई तपाईंका मानिसहरूसित जान दिनुहोस्,” तर यहोशापातले अस्वीकार गरे।<verse eid="1KI 22:49"/></para>
<para style="p"><verse number="50" style="v" sid="1KI 22:50"/>त्यसपछि यहोशापात आफ्ना पुर्खाहरूसित सुते, र तिनीहरूसितै आफ्ना पिता दावीदको सहरमा गाडिए। तिनीपछि तिनका छोरा यहोराम राजा भए।<verse eid="1KI 22:50"/></para>
<para style="p"><verse number="51" style="v" sid="1KI 22:51"/>आहाबका छोरा अहज्याह यहूदाका राजा यहोशापातको सत्रौँ वर्षमा सामरियामा इस्राएलका राजा भए। तिनले इस्राएलमाथि दुई वर्षसम्म राज्य गरे।<verse eid="1KI 22:51"/></para>
<para style="p"><verse number="52" style="v" sid="1KI 22:52"/>तिनले याहवेहको दृष्‍टिमा दुष्‍ट काम गरे। किनकि तिनी आफ्ना बुबाआमाका चालहरूमा र इस्राएललाई पाप गर्न लगाउने नबातका छोरा यारोबामका चालहरूमा चले।<verse eid="1KI 22:52"/></para>
<para style="p"><verse number="53" style="v" sid="1KI 22:53"/>तिनले बालको सेवा गरेर त्यसलाई पूजा गरे, र आफ्ना पिताले गरेझैँ याहवेह इस्राएलका परमेश्‍वरलाई रिस उठाए।<verse eid="1KI 22:53"/></para>
<chapter eid="1KI 22"/>
</usx>