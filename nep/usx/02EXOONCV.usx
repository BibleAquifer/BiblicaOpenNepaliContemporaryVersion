<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="EXO" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">प्रस्थान</para>
<para style="toc1">प्रस्थान</para>
<para style="toc2">प्रस्थान</para>
<para style="mt1">प्रस्थान</para>
<chapter number="1" style="c" sid="EXO 1"/>
<para style="p"><verse number="1" style="v" sid="EXO 1:1"/>याकोबसित आ-आफ्नो परिवारसहित इजिप्टमा जाने इस्राएलका छोराहरूका नाम यिनै हुन्:<verse eid="EXO 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 1:2"/>रूबेन, शिमियोन, लेवी र यहूदा;<verse eid="EXO 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 1:3"/>इस्साखार, जबूलून र बेन्यामीन;<verse eid="EXO 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 1:4"/>दान र नप्‍ताली; गाद र आशेर।<verse eid="EXO 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 1:5"/>याकोबका सन्तति जम्मा सत्तरी जना थिए; योसेफ अगिबाटै इजिप्टमा थिए।<verse eid="EXO 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 1:6"/>त्यसपछि, योसेफ, तिनका दाजुभाइहरू र त्यस पुस्ताका सबै जना मरे।<verse eid="EXO 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 1:7"/>तर इस्राएलीहरू फलवन्त हुँदै संख्यामा वृद्धि हुँदैगए, यहाँसम्म कि सारा देश तिनीहरूद्वारा भरियो।<verse eid="EXO 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 1:8"/>तब इजिप्टमा योसेफलाई नचिनेका एक जना नयाँ राजाले शासन गर्न थाले।<verse eid="EXO 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 1:9"/>उनले आफ्ना प्रजालाई भने, “हेर, इस्राएलीहरू हामीभन्दा संख्यामा धेरै र बलवान् भएका छन्।<verse eid="EXO 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 1:10"/>अब हामीले तिनीहरूसित बुद्धि पुर्‍याएर व्यवहार गर्नुपर्छ; नत्रता तिनीहरू अझ धेरै हुनेछन्, र यदि युद्ध भइहाल्यो भने तिनीहरू हाम्रा शत्रुहरूसित लागेर हाम्रो विरुद्धमा लडाइँ गरी देशलाई छोडिदिनेछन्।”<verse eid="EXO 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 1:11"/>यसकारण उनीहरूले तिनीहरूलाई जबरजस्ती कामले लदाएर सताउनको लागि तिनीहरूमाथि हाकिमहरू खटाए; अनि उनीहरूले फारोको निम्ति पिताम र रामसेस भन्‍ने भण्डारका सहरहरू बनाए।<verse eid="EXO 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 1:12"/>तर तिनीहरू जति-जति सताइन्थे, उति-उति नै तिनीहरूका संख्या बढ्दै गए, र देशमा फिँजिदै गए। यसकारण इजिप्टियनहरू इस्राएलीहरूसित डराउन थाले।<verse eid="EXO 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 1:13"/>त्यसकारण इजिप्टियनहरूले इस्राएलीहरूलाई कठोरतापूर्वक काममा दलाउन थाले।<verse eid="EXO 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 1:14"/>उनीहरूले तिनीहरूलाई माटो, इँटा र खेतबारीका सबै किसिमका काम र कठोर परिश्रम गर्न लगाएर तिनीहरूको जीवन नै तितो बनाइदिए; इजिप्टियनहरूले तिनीहरूलाई सबै काममा कठोरतापूर्वक लगाए।<verse eid="EXO 1:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 1:15"/>इजिप्टका राजाले शिप्रा र पुवा नाम गरेका हिब्रू सुँडेनीहरूलाई बोलाएर भने,<verse eid="EXO 1:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 1:16"/>“जब तिमीहरूले हिब्रू स्त्रीहरूलाई बच्‍चा जन्माउन मदत गर्छौ, र जन्माएका हेर्छौ, तब त्यो छोरा हो भने त्यसलाई मारिदिनू; तर छोरी हो भने त्यसलाई चाहिँ नमार्नू।”<verse eid="EXO 1:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 1:17"/>तर ती सुँडेनीहरू परमेश्‍वरको डर राख्थे। इजिप्टको राजाको आज्ञाअनुसार तिनीहरूले गरेनन्; तिनीहरूले छोराहरू जन्मिँदा पनि मारेनन्।<verse eid="EXO 1:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 1:18"/>तब इजिप्टको राजाले ती सुँडेनीहरूलाई बोलाएर सोधे, “तिमीहरूले यस्तो किन गर्‍यौ? तिमीहरूले ती छोराहरूलाई किन जिउँदै छोडिदियौ?”<verse eid="EXO 1:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 1:19"/>ती सुँडेनीहरूले फारोलाई जवाफ दिए, “हिब्रू स्त्रीहरू इजिप्टियन स्त्रीहरूजस्ता छैनन्; तिनीहरू बलिया हुन्छन्; अनि सुँडेनीहरू तिनीहरूकहाँ पुग्नुभन्दा पहिल्यै सजिलैसँग बच्‍चा जन्माइसकेका हुन्छन्।”<verse eid="EXO 1:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 1:20"/>यसकारण परमेश्‍वर ती सुँडेनीहरूप्रति कृपालु हुनुभयो; अनि ती इस्राएलीहरू संख्यामा बढ्दै गए, र झन् शक्तिशाली भए।<verse eid="EXO 1:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 1:21"/>ती सुँडेनीहरू परमेश्‍वरसित डराएका हुनाले उहाँले तिनीहरूलाई आफ्नै परिवारहरू दिनुभयो।<verse eid="EXO 1:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 1:22"/>तब फारोले आफ्ना सबै प्रजालाई यसो भन्दै आज्ञा दिए: “जन्मेका हरेक हिब्रू छोरालाई तिमीहरूले नील नदीमा फ्याँकिदिनू, तर प्रत्येक छोरीलाई भने जीवितै छोड्नू।”<verse eid="EXO 1:22"/></para>
<chapter eid="EXO 1"/>
<chapter number="2" style="c" sid="EXO 2"/>
<para style="p"><verse number="1" style="v" sid="EXO 2:1"/>लेवी घरानाका एक जना मानिसले एउटी लेवी कुलकी स्त्रीलाई विवाह गरे।<verse eid="EXO 2:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 2:2"/>अनि तिनी गर्भवती भइन् र एउटा छोरो जन्माइन्। जब तिनले त्यस बालकलाई सुन्दर देखिन्, तब तिनले त्यसलाई तीन महिनासम्म लुकाइराखिन्।<verse eid="EXO 2:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 2:3"/>तर जब तिनले त्यसलाई अझै लुकाउन सकिनन्, तब तिनले त्यसको निम्ति एउटा काँसको टोकरी ल्याइन् र त्यसलाई लिसाइलो माटो र अलकत्राले लिपिन्। तब तिनले त्यस बालकलाई त्यसमा हालेर नील नदीको किनारमा अग्ला काँसघारीहरूका बीचमा राखिदिइन्।<verse eid="EXO 2:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 2:4"/>त्यसलाई के हुन्छ भनी त्यो हेर्नलाई तिनकी दिदी टाढामा उभिरहिन्।<verse eid="EXO 2:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 2:5"/>तब फारोकी छोरी नुहाउनलाई नील नदीमा आइन्, र तिनका दासीहरू नदीका किनारतिर हिँड्दैथिए। तिनले काँसघारीहरूका बीचमा टोकरी देखिन्, र आफ्नी दासीलाई त्यो लिन पठाइन्।<verse eid="EXO 2:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 2:6"/>जब तिनले खोल्दा त्यस बालकलाई देखिन्; तब त्यो बालक रोइरहेको थियो, र उसप्रति दयाले भरिएर तिनले भनिन्, “यो त कुनै हिब्रूको बालक हो।”<verse eid="EXO 2:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 2:7"/>तब बालककी दिदीले फारोकी छोरीलाई भनिन्, “के यस बालकलाई हेरचाह गर्नका निम्ति म गएर हिब्रू स्त्रीहरूमध्ये कुनै एउटी धाईलाई तपाईंको निम्ति बोलाऊँ?”<verse eid="EXO 2:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 2:8"/>तब फारोकी छोरीले जवाफ दिइन्, “हुन्छ, जाऊ।” अनि ती केटी गएर त्यस बालककी आमालाई लिएर आई।<verse eid="EXO 2:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 2:9"/>फारोकी छोरीले तिनलाई भनिन्, “यस बालकलाई लैजाऊ, र मेरा निम्ति दूध खुवाऊ र हेरचाह गर। म तिमीलाई ज्याला दिनेछु।” यसकारण त्यस स्त्रीले बालकलाई लिएर दूध खुवाउने गरिन्।<verse eid="EXO 2:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 2:10"/>बालक ठूलो भएपछि तिनले त्यसलाई फारोकी छोरीकहाँ लगिन्, र ऊ तिनको छोरा भयो, र “मैले उसलाई पानीबाट बाहिर निकालेकी हुँ” भन्दै तिनले उसको नाम मोशा राखिन्।<verse eid="EXO 2:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 2:11"/>मोशा ठूलो भएपछि एक दिन तिनी आफ्ना मानिसहरूकहाँ गए, र तिनीहरूले कठोर परिश्रम गरेको देखे। तिनले एक जना इजिप्टियनले हिब्रू जातिको एक जनालाई हिर्काइरहेको देखे।<verse eid="EXO 2:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 2:12"/>तिनले यताउता हेरे, र कोही पनि नदेखेपछि तिनले त्यस इजिप्टियनलाई मारे, र त्यसलाई बालुवामा पुरिदिए।<verse eid="EXO 2:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 2:13"/>अर्को दिन तिनी बाहिर निस्के; तब दुई जना हिब्रूहरूलाई झगडा गरिरहेका देखे। तिनले गल्ती गर्नेलाई सोधे, “तिमी किन आफ्नै मान्छेलाई हिर्काउँछौ?”<verse eid="EXO 2:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 2:14"/>तब त्यस मानिसले भन्यो, “तिमीलाई कसले हाम्रो शासक र न्यायकर्ता नियुक्त गर्‍यो? के तिमीले त्यस इजिप्टियनलाई मारेझैँ मलाई पनि मार्ने विचार गर्दैछौ?” तब मोशा डराए, र सोचे, “मैले जे गरेँ, त्यो सबैलाई थाहा भइसक्यो होला!”<verse eid="EXO 2:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 2:15"/>जब फारोले यो सुने, तब उनले मोशालाई मार्न खोजे; तर मोशा फारोदेखि भागेर गए, र मिद्यानमा बस्‍न लागे; अनि त्यहाँ तिनी एउटा इनारको छेउमा बसे।<verse eid="EXO 2:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 2:16"/>मिद्यानका एक जना पुजारीका सात जना छोरीहरू थिए। आफ्ना पिताका बगाललाई पानी खुवाउन तिनीहरू इनारमा आए, र पानी उघाउँदै डुँडमा भर्न लागे।<verse eid="EXO 2:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 2:17"/>तब त्यहाँ केही गोठालाहरू पनि आए र तिनीहरूलाई धपाए; तर मोशा उठे, र तिनीहरूलाई सहायता गरे, र तिनीहरूका बगाललाई पानी पिउन दिए।<verse eid="EXO 2:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 2:18"/>जब ती ठिटीहरू आफ्ना पिता रूएलकहाँ फर्किए, तब तिनले तिनीहरूलाई सोधे, “आज तिमीहरू कसरी यति चाँडो फर्कियौ?”<verse eid="EXO 2:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 2:19"/>तिनीहरूले जवाफ दिए, “एक जना इजिप्टियनले हामीलाई गोठालाहरूका हातबाट बचाए। तिनले त हाम्रा निम्ति पानी पनि उघाइदिए, र बगाललाई समेत पानी खुवाए।”<verse eid="EXO 2:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 2:20"/>उनले आफ्ना छोरीहरूलाई सोधे, “अनि तिनी कहाँ छन्? तिमीहरूले तिनलाई किन छोडिदियौ? तिनलाई खानलाई निम्तो देऊ।”<verse eid="EXO 2:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 2:21"/>त्यसपछि मोशा ती मानिससित बस्‍न राजी भए; र उनले आफ्नी छोरी सिप्पोरालाई मोशासित विवाह गरिदिए।<verse eid="EXO 2:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 2:22"/>सिप्पोराले एउटा छोरा जन्माइन्, र मोशाले “म अर्काको मुलुकमा प्रवासी भएँ” भनेर त्यसको नाम गेर्शोम राखे।<verse eid="EXO 2:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 2:23"/>समय बितेपछि इजिप्टका राजा मरे। आफ्ना दासत्वमा इस्राएलीहरूले सुस्केरा हाले; अनि पुकार गर्न थाले। दासत्वको कारण तिनीहरूले सहायताको लागि गरेको चीत्कार परमेश्‍वरकहाँ पुग्यो।<verse eid="EXO 2:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 2:24"/>तब परमेश्‍वरले तिनीहरूको सुस्केरा सुन्‍नुभयो; अनि उहाँले अब्राहाम, इसहाक र याकोबसित बाँध्नुभएको आफ्नो करार सम्झनुभयो।<verse eid="EXO 2:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 2:25"/>यसकारण परमेश्‍वरले इस्राएलीहरूमाथि दृष्‍टि लगाउनुभयो, र तिनीहरूको वास्ता गर्नुभयो।<verse eid="EXO 2:25"/></para>
<chapter eid="EXO 2"/>
<chapter number="3" style="c" sid="EXO 3"/>
<para style="p"><verse number="1" style="v" sid="EXO 3:1"/>मोशाले आफ्ना ससुरा मिद्यानका पुजारी यित्रोका भेडाबाख्रा चराउँथे। अनि आफ्नो बगाललाई उजाडस्थानको पल्‍लो छेउतिर लगे; अनि तिनी परमेश्‍वरको पर्वत होरेबमा आए।<verse eid="EXO 3:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 3:2"/>त्यहाँ याहवेहका दूत पोथ्राको माझमा जलिरहेको ज्वालाको रूपमा तिनीकहाँ देखा पर्नुभयो। मोशाले देखे, कि त्यो पोथ्रा जलिरहेको थियो; तापनि भस्म भएको थिएन।<verse eid="EXO 3:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 3:3"/>अनि मोशाले मनमनै सोचे, “यो अनौठो दृश्य म त्यहीँ गएर हेर्नेछु—त्यो पोथ्रा किन भस्म भएको छैन।”<verse eid="EXO 3:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 3:4"/>जब याहवेहले तिनले हेर्न गएको देख्नुभयो, तब परमेश्‍वरले त्यस पोथ्राभित्रबाट तिनलाई बोलाएर भन्‍नुभयो, “मोशा! ए मोशा!” अनि मोशाले भने, “हजुर, म यहाँ छु।”<verse eid="EXO 3:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 3:5"/>परमेश्‍वरले भन्‍नुभयो, “यता नजिक नआइज! तेरो जुत्ता फुकाल; किनकि तँ उभिएको ठाउँ पवित्र भूमि हो।”<verse eid="EXO 3:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 3:6"/>तब उहाँले भन्‍नुभयो, “म तेरा पितापुर्खाका परमेश्‍वर हुँ; अब्राहामका परमेश्‍वर, इसहाकका परमेश्‍वर र याकोबका परमेश्‍वर।” यो सुनेर मोशाले आफ्नो अनुहार छोपे; किनकि तिनी परमेश्‍वरलाई हेर्न डराए।<verse eid="EXO 3:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 3:7"/>याहवेहले भन्‍नुभयो, “मैले इजिप्टमा भएका मेरा प्रजाका कष्‍ट साँच्‍चै देखेको छु। परिश्रममा जोतिएकाहरूलाई यातना दिने ठेकेदारहरूका कारण मैले तिनीहरूको चीत्कार सुनेको छु; र तिनीहरूका दुःखप्रति मेरो वास्ता छ।<verse eid="EXO 3:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 3:8"/>यसकारण म तिनीहरूलाई इजिप्टियनहरूका हातबाट छुटाउन, र त्यस देशबाट निकालेर एउटा असल र ठूलो देश, दूध र मह बग्ने, जो कनानी, हित्ती, एमोरी, परिज्जी, हिव्वी र यबूसीहरूको देश हो, त्यहाँ ल्याउनलाई म ओर्लिएको छु।<verse eid="EXO 3:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 3:9"/>अब इस्राएलीहरूको चीत्कार मेरो सामु आइपुगेको छ; अनि इजिप्टियनहरूले कसरी तिनीहरूलाई सताइरहेका छन्, त्यो मैले देखेको छु।<verse eid="EXO 3:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 3:10"/>यसकारण अब जा। म मेरा मानिसहरू अर्थात् इस्राएलीहरूलाई इजिप्टबाट बाहिर ल्याउन तँलाई फारोकहाँ पठाउँदैछु।”<verse eid="EXO 3:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 3:11"/>तर मोशाले परमेश्‍वरलाई भने, “फारोकहाँ गएर इस्राएलीहरूलाई इजिप्टबाट बाहिर निकालेर ल्याउने म को हुँ र?”<verse eid="EXO 3:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 3:12"/>तब परमेश्‍वरले भन्‍नुभयो, “म तेरो साथमा हुनेछु। तँलाई पठाउने म नै हुँ भनी देखाउने अद्‌भुत चिन्ह यो हुनेछ: जब तैँले ती मानिसहरूलाई इजिप्टबाट बाहिर निकालेर ल्याउनेछस्, तब तिमीहरूले यस पर्वतमा परमेश्‍वरको आराधना गर्नेछौ।”<verse eid="EXO 3:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 3:13"/>मोशाले परमेश्‍वरलाई भने, “यदि मैले गएर इस्राएलीहरूलाई ‘तिमीहरूका पितापुर्खाहरूका परमेश्‍वरले मलाई तिमीहरूकहाँ पठाउनुभएको हो’ भनुँला, र तिनीहरूले मलाई ‘उहाँको नाम के हो?’ भनी सोध्लान्, तब म तिनीहरूलाई त्यस बेला के भनूँ?”<verse eid="EXO 3:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 3:14"/>परमेश्‍वरले मोशालाई भन्‍नुभयो, “म हुँ, जो म हुँ। तैँले इस्राएलीहरूलाई भन्‍नू: ‘म हुँ भन्‍नेले नै मलाई तिमीहरूकहाँ पठाउनुभएको हो।’ ”<verse eid="EXO 3:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 3:15"/>परमेश्‍वरले मोशालाई यसो पनि भन्‍नुभयो, “इस्राएलीहरूलाई भन्‍नू, ‘तिमीहरूका पितापुर्खाहरूका याहवेह परमेश्‍वर—अब्राहामका परमेश्‍वर, इसहाकका परमेश्‍वर र याकोबका परमेश्‍वरले—मलाई तिमीहरूकहाँ पठाउनुभएको हो।’ “मेरो नाम सदा यही रहन्छ, र सबै पुस्तासम्म मेरो नामको सम्झना यही हुनेछ।<verse eid="EXO 3:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 3:16"/>“जा, इस्राएलका प्रधानहरूलाई जम्मा गरेर तिनीहरूलाई भन्, ‘याहवेह तिमीहरूका पितापुर्खाहरूका परमेश्‍वर—अब्राहाम, इसहाक र याकोबका परमेश्‍वर—मकहाँ देखा परेर भन्‍नुभयो: मैले तिमीहरूमाथि दृष्‍टि लगाएको छु र तिनीहरूले तिमीहरूलाई इजिप्टमा के-के गरे, सो देखेको छु।<verse eid="EXO 3:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 3:17"/>मैले तिमीहरूलाई इजिप्टको दुःखबाट बाहिर निकालेर कनानी, हित्ती, एमोरी, परिज्जी, हिव्वी र यबूसीहरूको देशमा ल्याउनलाई प्रतिज्ञा गरेको छु—जुन दूध र मह बग्ने देश हो।’<verse eid="EXO 3:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 3:18"/>“इस्राएलका प्रधानहरूले तेरो कुरा सुन्‍नेछन्। तब तँ र प्रधानहरू इजिप्टका राजाकहाँ गएर यसो भन्‍नू: ‘याहवेह, हिब्रूहरूका परमेश्‍वरले हामीसित भेट गर्नुभयो। हामीलाई तीन दिनको बाटो उजाडस्थानमा गएर याहवेह हाम्रा परमेश्‍वरकहाँ बलिदान चढाउन जान दिनुहोस्।’<verse eid="EXO 3:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 3:19"/>तर म जान्दछु, शक्तिशाली हातले त्यसलाई बाध्य नगराएसम्म इजिप्टको राजाले तिमीहरूलाई जान दिनेछैन।<verse eid="EXO 3:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 3:20"/>यसकारण म आफ्नो हात पसारेर इजिप्टियनहरूका बीचमा सबै अद्‌भुत कार्यहरू गरेर तिनीहरूलाई प्रहार गर्नेछु। त्यसपछि त्यसले तिमीहरूलाई जान दिनेछ।<verse eid="EXO 3:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 3:21"/>“म इजिप्टियनहरूलाई यस जातिप्रति कृपा राख्ने बनाउनेछु, र तिमीहरू निस्कँदा खाली हात निस्कनेछैनौ।<verse eid="EXO 3:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 3:22"/>हरेक स्त्रीले आफ्ना छिमेकीसित र उसको घरमा बसेकी कुनै पनि स्त्रीसित सुन र चाँदीका चीजहरू, र लुगाफाटाहरू मागेर ती तिमीहरूका छोराछोरीहरूलाई लगाइदिनेछौ। यसरी तिमीहरूले इजिप्टियनहरूलाई लुट्नेछौ।”<verse eid="EXO 3:22"/></para>
<chapter eid="EXO 3"/>
<chapter number="4" style="c" sid="EXO 4"/>
<para style="p"><verse number="1" style="v" sid="EXO 4:1"/>तब मोशाले जवाफ दिए, “यदि तिनीहरूले मलाई विश्‍वास गरेनन् अथवा मेरा कुरा सुनेनन् र ‘याहवेह तिमीसित देखा पर्नुभएको होइन’ भनेर जवाफ दिए भने के गर्ने?”<verse eid="EXO 4:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 4:2"/>तब याहवेहले तिनलाई भन्‍नुभयो, “तेरो हातमा भएको त्यो के हो?” तिनले भने, “एउटा लहुरो।”<verse eid="EXO 4:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 4:3"/>याहवेहले भन्‍नुभयो, “त्यसलाई भुइँमा फाल्।” मोशाले त्यसलाई भुइँमा फाले, र त्यो एउटा सर्प भयो, र मोशा डराएर भागे।<verse eid="EXO 4:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 4:4"/>तब याहवेहले तिनलाई भन्‍नुभयो, “आफ्नो हात पसारेर त्यसको पुच्छरमा समात्।” यसकारण मोशाले हात पसारेर त्यस सर्पलाई समाते, र त्यो तिनको हातमा पहिलेझैँ लहुरो भइगयो।<verse eid="EXO 4:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 4:5"/>याहवेहले भन्‍नुभयो, “यो याहवेह तिनीहरूका पितापुर्खाका परमेश्‍वर—अब्राहामका परमेश्‍वर, इसहाकका परमेश्‍वर र याकोबका परमेश्‍वर तिमीकहाँ देखा पर्नुभएको हो भनी तिनीहरूले विश्‍वास गरून् भनेर हो।”<verse eid="EXO 4:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 4:6"/>तब याहवेहले भन्‍नुभयो, “तेरो हात तेरो वस्त्रभित्र हाल्।” यसकारण मोशाले आफ्नो हात आफ्नो वस्त्रभित्र हाले; अनि जब तिनले त्यसलाई बाहिर निकाले, तब त्यसमा कुष्‍ठरोग लागेर हिउँझैँ सेतो भयो।<verse eid="EXO 4:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 4:7"/>उहाँले भन्‍नुभयो, “अब त्यसलाई आफ्नो वस्त्रभित्र फेरि हाल्।” यसकारण मोशाले आफ्नो हात फेरि वस्त्रभित्र हाले, र जब तिनले त्यसलाई बाहिर निकाले, त्यो शरीरका अरू भागझैँ सद्दे भइहाल्यो।<verse eid="EXO 4:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 4:8"/>तब याहवेहले भन्‍नुभयो, “यदि तिनीहरूले तँलाई विश्‍वास गरेनन् अथवा पहिलो अद्‌भुत चिन्हमा ध्यान दिएनन् भने तिनीहरूले दोस्रोमा विश्‍वास गर्लान्।<verse eid="EXO 4:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 4:9"/>तर यदि तिनीहरूले यी दुई अलौकिक चिन्हहरूमाथि विश्‍वास गरेनन्, अथवा तेरो कुरा सुनेनन् भने नील नदीबाट केही पानी लिएर त्यसलाई ओबानो भूमिमा पोखाई दिनू। तैँले नदीबाट लिएको पानी सुक्खा भूमिमा रगत हुनेछ।”<verse eid="EXO 4:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 4:10"/>मोशाले याहवेहलाई भने, “माफ गर्नुहोला, हे प्रभु। म बोल्नमा सिपालु छैनँ, न त पहिले म सिपालु थिएँ; न अहिले तपाईं बोल्नुभएपछि म सिपालु भएको छु; किनकि म बोल्नमा र जिब्रो चलाउनमा ढिलो छु।”<verse eid="EXO 4:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 4:11"/>याहवेहले तिनलाई भन्‍नुभयो, “मानिसलाई बोल्ने मुख कसले दियो? त्यसलाई लाटो वा बहिरो, देख्ने वा नेदेख्ने भनी कसले निर्णय गर्छ? के त्यो म याहवेहले नै होइनँ र?<verse eid="EXO 4:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 4:12"/>अब जा; म तँलाई बोल्न सहायता गर्नेछु, र तैँले भन्‍नुपर्ने कुरा सिकाउनेछु।”<verse eid="EXO 4:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 4:13"/>तर मोशाले भने, “हे प्रभु, म तपाईंको दास बिन्ती गर्छु, कृपया अरू कसैलाई पठाउनुहोस्।”<verse eid="EXO 4:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 4:14"/>तब मोशाप्रति याहवेहको क्रोध दन्कियो, र उहाँले भन्‍नुभयो, “लेवी कुलको हारून तेरो दाजु होइन र? ऊ राम्ररी बोल्न सक्छ भनी म जान्दछु। त्यो तँसित भेट गर्न आइरहेको छ; र तँलाई देखेर उसको हृदय प्रसन्‍न हुनेछ।<verse eid="EXO 4:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 4:15"/>तँ उसित बोल्नेछस् र उसको मुखमा शब्द हालिदिनेछस्। म तिमीहरू दुवैलाई बोल्न सहायता गर्नेछु, र के गर्नुपर्छ, सो सिकाउनेछु।<verse eid="EXO 4:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 4:16"/>उसले तेरा निम्ति मानिसहरूसित बोलिदिनेछ, र ऊ तेरो मुखपात्र हुनेछ; अनि तँ उसका निम्ति ईश्‍वरतुल्य हुनेछस्।<verse eid="EXO 4:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 4:17"/>तर यो लहुरो तेरो हातमा लिनू, र तैँले यसद्वारा अलौकिक चिन्हहरू देखाउनेछस्।”<verse eid="EXO 4:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 4:18"/>तब मोशा आफ्ना ससुरा यित्रोकहाँ फर्किगएर उनलाई भने, “मेरा आफ्नै दाजुभाइहरू इजिप्टमा कोही जीवितै छन् कि छैनन् भनेर हेर्न मलाई त्यहाँ जान दिनुहोस्।” यित्रोले भने, “शान्तिसित जाऊ।”<verse eid="EXO 4:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 4:19"/>याहवेहले मोशालाई मिद्यानमा भन्‍नुभएको थियो, “इजिप्टमा फर्केर जा; किनकि तँलाई मार्न चाहनेहरू सबै मरिसके।”<verse eid="EXO 4:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 4:20"/>यसकारण मोशाले आफ्ना पत्नी र छोराहरू लिएर तिनीहरूलाई गधामाथि चढाए; अनि इजिप्टतिर लागे। अनि तिनले परमेश्‍वरको लहुरो आफ्नो हातमा लिए।<verse eid="EXO 4:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 4:21"/>याहवेहले मोशालाई भन्‍नुभयो, “जब तँ इजिप्टमा फर्कनेछस्, तब तैँले सबै अद्‌भुत कार्यहरू, जसका लागि मैले तँलाई शक्ति दिएको छु, फारोको सामु देखाउन नभुल्नू। तर म त्यसको हृदय कठोर पारिदिनेछु, र त्यसले मानिसहरूलाई जान दिनेछैन।<verse eid="EXO 4:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 4:22"/>तब फारोलाई भन्, ‘याहवेह यसो भन्‍नुहुन्छ: इस्राएल मेरो जेठो छोरा हो,<verse eid="EXO 4:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 4:23"/>र म तँलाई आदेश दिन्छु, “मेरो छोरालाई जान दे, र त्यसले मेरो आराधना गरोस्।” तर तैँले त्यसलाई जान दिइनस्, यसकारण म तेरो जेठो छोरालाई मार्नेछु।’ ”<verse eid="EXO 4:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 4:24"/>बाटोको एउटा बास बस्‍ने ठाउँमा याहवेहले मोशालाई भेटेर मार्न खोज्नुभएको थियो।<verse eid="EXO 4:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 4:25"/>तर सिप्पोराले एउटा ढुङ्गाको चक्‍कु लिएर आफ्नो छोराको खलडी च्वाट्ट काटेर त्यसले मोशाको खुट्टामा छोइदिइन्। तिनले भनिन्, “तपाईं निश्‍चय मेरा निम्ति रगतको दुलहा हुनुहुन्छ।”<verse eid="EXO 4:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 4:26"/>यसकारण याहवेहले तिनलाई छोडिदिनुभयो। (त्यस बेला तिनले खतनालाई दर्शाउँदै “रगतको दुलहा” भनिन्।)<verse eid="EXO 4:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 4:27"/>याहवेहले हारूनलाई भन्‍नुभयो, “मोशालाई भेट्न उजाडस्थानमा जा।” यसकारण तिनले मोशालाई परमेश्‍वरको पर्वतमा भेटे, र तिनलाई चुम्बन गरे।<verse eid="EXO 4:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 4:28"/>तब मोशाले तिनलाई याहवेहले जे भन्‍न पठाउनुभएको थियो, त्यो हरेक वचन, र तिनलाई उहाँले गर्नू भनेर हुकुम गर्नुभएका सबै अलौकिक चिन्हहरूको विषयमा हारूनलाई बताए।<verse eid="EXO 4:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 4:29"/>मोशा र हारूनले इस्राएलका सबै प्रधानहरूलाई एकै ठाउँमा भेला पारे।<verse eid="EXO 4:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 4:30"/>अनि हारूनले तिनीहरूलाई याहवेहले मोशालाई भन्‍नुभएका सबै कुराहरू सुनाइदिए। तिनले मानिसहरूका अगि अलौकिक चिन्हहरू पनि देखाए,<verse eid="EXO 4:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 4:31"/>र इस्राएलीहरूले विश्‍वास गरे। अनि तिनीहरूले जब याहवेहले तिनीहरूप्रति वास्ता राख्नुभएको छ, र उहाँले तिनीहरूको कष्‍ट देख्नुभएको छ भनी सुने, तब तिनीहरूले निहुरेर आराधना गरे।<verse eid="EXO 4:31"/></para>
<chapter eid="EXO 4"/>
<chapter number="5" style="c" sid="EXO 5"/>
<para style="p"><verse number="1" style="v" sid="EXO 5:1"/>त्यसपछि मोशा र हारून फारोकहाँ गएर भने, “याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘मेरा मानिसहरूलाई मेरा निम्ति उजाडस्थानमा चाड मनाउनलाई जान दे।’ ”<verse eid="EXO 5:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 5:2"/>फारोले भने, “याहवेह को हुनुहुन्छ, र म उहाँको हुकुम पालन गरूँ, र इस्राएलीहरूलाई जान दिऊँ? म याहवेहलाई चिन्दिनँ, र इस्राएलीहरूलाई जान पनि दिन्‍नँ।”<verse eid="EXO 5:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 5:3"/>तब तिनीहरूले भने, “हिब्रूहरूका परमेश्‍वरले हामीलाई भेट्नुभयो। अब हामीलाई तीन दिनको यात्रा गरी उजाडस्थानमा गएर याहवेह हाम्रा परमेश्‍वरका निम्ति बलिदान चढाउन जान दिनुहोस्, नत्रता उहाँले हामीलाई रूढीले अथवा तरवारले प्रहार गर्नुहुनेछ।”<verse eid="EXO 5:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 5:4"/>तब इजिप्टका राजाले तिनीहरूलाई भने, “ए मोशा र हारून, तिमीहरू यी मानिसहरूका काममा किन बाधा गर्छौ? तिमीहरू आफ्ना काममा लाग!”<verse eid="EXO 5:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 5:5"/>अनि फारोले भने, “हेर, देशका मानिसहरू अब धेरै भएका छन्, र तिमीहरू तिनीहरूलाई काम गर्नदेखि रोकिरहेका छौ।”<verse eid="EXO 5:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 5:6"/>त्यही दिन फारोले यातना दिने ठेकेदारहरू र मानिसहरूका नाइकेहरूलाई यस्तो हुकुम दिए:<verse eid="EXO 5:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 5:7"/>“अब उसो तिमीहरूले ती मानिसहरूलाई इँटाहरू बनाउनलाई पराल नदिनू; तिनीहरू गएर आफ्ना पराल आफैँले बटुलून्।<verse eid="EXO 5:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 5:8"/>तर तिनीहरूलाई पहिलेकै संख्यामा इँटाहरू बनाउन भन्‍नू; त्यसको संख्या नघटाउनू। तिनीहरू अल्छे छन्; यसैले तिनीहरू ‘हामीलाई आफ्ना परमेश्‍वरका निम्ति बलिदान चढाउन जान दिनुहोस्’ भनी कराउँदैछन्।<verse eid="EXO 5:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 5:9"/>ती मानिसहरूका निम्ति काम अझ कठोर पारिदिनू र तिनीहरूले खुरू-खुरू काम गरेर झूटो कुराहरूतिर ध्यान नदेऊन्।”<verse eid="EXO 5:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 5:10"/>तब ती यातना दिने ठेकेदारहरू र मानिसहरूका नाइकेहरू गएर मानिसहरूलाई भने, “फारो यसो भन्‍नुहुन्छ: ‘म तिमीहरूलाई अबदेखि पराल दिनेछैनँ।<verse eid="EXO 5:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 5:11"/>जाओ अनि जहाँबाट पाउन सकिन्छ, त्यहाँबाट आफ्ना लागि पराल ल्याओ, तर तिमीहरूका कामचाहिँ कदापि घटाइनेछैन।’ ”<verse eid="EXO 5:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 5:12"/>यसकारण ती मानिसहरू परालको लागि काम चलाउन टुक्राटाक्रीहरू बटुल्नलाई इजिप्टभरि छरिए।<verse eid="EXO 5:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 5:13"/>ती यातना दिने ठेकेदारहरूले तिनीहरूलाई यसो भन्दै दबाब दिए, “तिमीहरूसित पराल हुँदा काम गरेझैँ, तिमीहरूबाट प्रतिदिन चाहिएका काम पूरा गर।”<verse eid="EXO 5:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 5:14"/>फारोका यातना दिने ठेकेदारहरूबाट नियुक्त गरिएका इस्राएली नाइकेहरूलाई तिनीहरूले पिटे र यसो भन्दै सोधे, “तिमीहरूले हिजो र आज आफ्ना इँटाको परिमाण किन पहिलेझैँ पुर्‍याएनौ?”<verse eid="EXO 5:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 5:15"/>तब इस्राएली नाइकेहरू गएर फारोकहाँ उजुर गरे: “हजुरले आफ्ना सेवकहरूसँग किन यस्तो व्यवहार गर्नुहुन्छ?<verse eid="EXO 5:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 5:16"/>हजुरका सेवकहरूलाई पराल दिइँदैन, र पनि हामीलाई ‘इँटा बनाओ’ भनी आज्ञा गरिन्छ। हजुरका सेवकहरू कुटाइ पनि खाँदैछन्, तर अपराध भने हजुरकै मानिसहरूको छ।”<verse eid="EXO 5:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 5:17"/>फारोले भने, “तिमीहरू अल्छे छौ, अल्छे! यसैकारण तिमीहरू ‘हामीलाई याहवेहका निम्ति बलिदान चढाउन जान दिनुहोस्’ भनिबस्छौ।<verse eid="EXO 5:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 5:18"/>अब फर्केर काममा लाग। तिमीहरूलाई कत्ति पनि पराल दिइनेछैन; तर तिमीहरूले तोकिएको संख्यामा इँटाहरू बनाउनैपर्नेछ।”<verse eid="EXO 5:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 5:19"/>जब तिनीहरूलाई तिमीहरूले “प्रतिदिन बनाउनुपर्ने इँटाको संख्या घटाइनेछैन” भनियो, तब इस्राएली नाइकेहरूले तिनीहरू सङ्कटमा परेका थाहा पाए।<verse eid="EXO 5:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 5:20"/>त्यसपछि तिनीहरू फारोकहाँबाट निस्के, र तिनीहरूले मोशा र हारून तिनीहरूलाई भेट्न पर्खिरहेका भेटे।<verse eid="EXO 5:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 5:21"/>अनि तिनीहरूले भने, “याहवेहले तपाईंहरूमाथि दृष्‍टि गरून् र न्याय देऊन्! तपाईंहरूले हामीलाई फारो र उनका अधिकारीहरूको अगि घृणित बनाउनुभयो, र हामीलाई मार्नका निम्ति तिनीहरूका हातमा तरवार राखिदिनुभएको छ।”<verse eid="EXO 5:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 5:22"/>मोशा फर्केर याहवेहकहाँ गएर भने, “हे प्रभु, तपाईंले यस प्रजामाथि किन सङ्कष्‍ट ल्याइदिनुभयो? के तपाईंले मलाई यसकै लागि पठाउनुभएको हो?<verse eid="EXO 5:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 5:23"/>म फारोकहाँ तपाईंको नाममा बोल्न गएकै बेलादेखि तिनले यी प्रजामाथि सङ्कष्‍ट ल्याएका छन्; अनि तपाईंले आफ्नो प्रजालाई छुटकारा दिनुभएको छैन।”<verse eid="EXO 5:23"/></para>
<chapter eid="EXO 5"/>
<chapter number="6" style="c" sid="EXO 6"/>
<para style="p"><verse number="1" style="v" sid="EXO 6:1"/>तब याहवेहले मोशालाई भन्‍नुभयो, “अब म फारोलाई के गर्नेछु, सो तैँले देख्नेछस्: मेरा शक्तिशाली हातको कारण त्यसले तिनीहरूलाई जान दिनेछ; मेरा शक्तिशाली हातको कारण त्यसले तिनीहरूलाई आफ्नो देशबाट धपाइदिनेछ।”<verse eid="EXO 6:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 6:2"/>परमेश्‍वरले मोशालाई यसो पनि भन्‍नुभयो, “म नै याहवेह हुँ।<verse eid="EXO 6:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 6:3"/>म अब्राहाम, इसहाक र याकोबकहाँ सर्वशक्तिमान् परमेश्‍वरको रूपमा देखा परेँ, तर याहवेह मेरो नामले त मैले आफैँलाई तिनीहरूसित परिचित गराइनँ।<verse eid="EXO 6:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 6:4"/>मैले तिनीहरू प्रवासी भई बसेको कनान देश तिनीहरूलाई दिनेछु भनी मेरो करार पनि तिनीहरूसित स्थापित गरेँ।<verse eid="EXO 6:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 6:5"/>यसबाहेक मैले इजिप्टियनहरूले दास बनाइराखेका इस्राएलीहरूका सुस्केरा सुनेको छु, र मैले आफ्नो करार सम्झेको छु।<verse eid="EXO 6:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 6:6"/>“यसकारण इस्राएलीहरूलाई भन्: ‘म नै याहवेह हुँ, र म तिमीहरूलाई इजिप्टियनहरूका बोझबाट निकालेर ल्याउनेछु। म तिमीहरूलाई तिनीहरूका दासत्वबाट मुक्त गर्नेछु; अनि म तिमीहरूलाई फैलिएको हात र न्यायको पराक्रमी कामले छुटकारा दिनेछु।<verse eid="EXO 6:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 6:7"/>म तिमीहरूलाई मेरा आफ्नै मानिसहरूझैँ लिनेछु, र म तिमीहरूका परमेश्‍वर हुनेछु। तब म नै तिमीहरूका याहवेह परमेश्‍वर हुँ, जसले तिमीहरूलाई इजिप्टियनहरूका दासत्वको जुवामुनिबाट बाहिर निकालेर ल्याउनुभयो भन्‍ने कुरा तिमीहरूले जान्‍नेछौ;<verse eid="EXO 6:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 6:8"/>अनि म तिमीहरूलाई त्यस देशमा ल्याउनेछु, जुन देश मैले अब्राहाम, इसहाक र याकोबलाई दिनेछु भनी हात उचालेर शपथ खाएको थिएँ; म त्यो तिमीहरूलाई सम्पत्तिको रूपमा दिनेछु; म नै याहवेह हुँ।’ ”<verse eid="EXO 6:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 6:9"/>तब मोशाले इस्राएलीहरूलाई यो कुरा बताइदिए; तर तिनीहरूका निराशा र दासत्वको क्रूरताका कारण तिनीहरूले मोशाको कुरा सुनेनन्।<verse eid="EXO 6:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 6:10"/>तब याहवेहले मोशालाई भन्‍नुभयो,<verse eid="EXO 6:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 6:11"/>“जा, र इजिप्टको राजा फारोलाई इस्राएलीहरूलाई त्यसको देशबाट बाहिर जान देऊ भनी भन्।”<verse eid="EXO 6:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 6:12"/>तर मोशाले याहवेहलाई भने, “यदि इस्राएलीहरूले नै मेरा कुरा सुन्दैनन् भने फारोले झन् मेरो कुरा कसरी सुन्लान्? किनकि म भकभकाउँदै बोल्छु।”<verse eid="EXO 6:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 6:13"/>फेरि याहवेह इस्राएलीहरू र इजिप्टका राजा फारोका विषयमा मोशा र हारूनसँग बोल्नुभयो; अनि उहाँले तिनीहरूलाई इस्राएलीहरूलाई इजिप्टबाट बाहिर लैजान आज्ञा दिनुभयो।<verse eid="EXO 6:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 6:14"/>तिनीहरूका परिवारहरूका मुख्य-मुख्य मानिसहरू यिनीहरू नै हुन्: इस्राएलका जेठा छोरा रूबेनका छोराहरू: हानोक र पल्‍लू, हेस्रोन र कर्मी। रूबेनका वंशहरू यिनै हुन्।<verse eid="EXO 6:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 6:15"/>शिमियोनका छोराहरू: यमूएल, यामीन, ओहद, याकीन, सोहोर र एउटी कनानी स्त्रीको छोरा, शाऊल। शिमियोनका वंशहरू यिनै हुन्।<verse eid="EXO 6:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 6:16"/>तिनीहरूका वंशावलीअनुसार लेवीका छोराहरूका नाम यिनै हुन्: गेर्शोन, कहात र मरारी। (लेवी 137 वर्षसम्म बाँचे।)<verse eid="EXO 6:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 6:17"/>वंशअनुसार गेर्शोनका छोराहरू यिनै हुन्: लिब्नी र शिमी।<verse eid="EXO 6:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 6:18"/>कहातका छोराहरू: अम्राम, यिसहार, हेब्रोन र उज्जीएल। (कोहात 133 वर्षसम्म बाँचे।)<verse eid="EXO 6:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 6:19"/>मरारीका छोराहरू: महली र मूशी। तिनीहरूका वंशावलीअनुसार लेवीका परिवारहरू यिनै थिए।<verse eid="EXO 6:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 6:20"/>अम्रामले आफ्ना बुबाकी बहिनी योकेबेदलाई विवाह गरे; जसले तिनको निम्ति हारून र मोशालाई जन्माइन्। (अम्राम 133 वर्षसम्म बाँचे।)<verse eid="EXO 6:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 6:21"/>यिसहारका छोराहरू: कोरह, नेपेग र जिक्री।<verse eid="EXO 6:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 6:22"/>उज्जीएलका छोराहरू: मिशाएल, एलसाफान र सिथ्री।<verse eid="EXO 6:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 6:23"/>हारूनले अम्मीनादाबकी छोरी र नहशोनकी बहिनी एलिशेबालाई विवाह गरे; अनि तिनले उनको निम्ति नादाब, अबीहू, एलाजार र ईतामारलाई जन्माइन्।<verse eid="EXO 6:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 6:24"/>कोरहका छोराहरू: अस्सीर, एल्काना र अबिआसाप। यिनीहरू नै कोरहका वंशहरू हुन्।<verse eid="EXO 6:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 6:25"/>हारूनका छोरा एलाजारले पतीएलकी छोरीहरूमध्ये एक जनालाई विवाह गरे; र तिनले उनको लागि पीनहासलाई जन्माइन्। लेवीहरूका परिवारका मुख्य-मुख्य मानिसहरू तिनीहरूका वंश-वंशअनुसार यिनै हुन्।<verse eid="EXO 6:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 6:26"/>यी तिनै हारून र मोशा थिए, जसलाई याहवेहले भन्‍नुभयो, “इस्राएलीहरूलाई इजिप्टबाट दल-दल बनाएर बाहिर ल्याउनू।”<verse eid="EXO 6:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 6:27"/>इजिप्टका राजा फारोसित इस्राएलीहरूलाई इजिप्टबाट बाहिर ल्याउने विषयमा कुरा गर्नेहरू यी दुई मोशा र हारून नै थिए।<verse eid="EXO 6:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 6:28"/>जब याहवेहले इजिप्टमा मोशासित बोल्नुभयो,<verse eid="EXO 6:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 6:29"/>अनि उहाँले मोशालाई भन्‍नुभयो, “म नै याहवेह हुँ। मैले तँलाई जे-जे कुरा भन्दछु, ती सबै इजिप्टका राजा फारोलाई भन।”<verse eid="EXO 6:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 6:30"/>तर मोशाले याहवेहलाई भने, “म बोल्नमा ढिलो छु; फारोले मेरा कुरा किन सुन्थे होला र?”<verse eid="EXO 6:30"/></para>
<chapter eid="EXO 6"/>
<chapter number="7" style="c" sid="EXO 7"/>
<para style="p"><verse number="1" style="v" sid="EXO 7:1"/>तब याहवेहले मोशालाई भन्‍नुभयो, “हेर्, मैले तँलाई फारोको निम्ति ईश्‍वरतुल्य बनाएको छु, र तेरा दाजु हारूनचाहिँ तेरा निम्ति प्रवक्ता हुनेछ।<verse eid="EXO 7:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 7:2"/>मैले तँलाई आज्ञा गरेका प्रत्येक कुरा तैँले भन्‍नू, र तेरा दाजु हारूनले फारोलाई भनून्, कि त्यसले इस्राएलीहरूलाई त्यसको देशबाट बाहिर पठाइदेओस्।<verse eid="EXO 7:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 7:3"/>तर म फारोको हृदय कठोर पारिदिनेछु, र म इजिप्टमा अलौकिक चिन्हहरू र अद्‌भुत कार्यहरूका संख्या बढाउनेछु।<verse eid="EXO 7:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 7:4"/>तर फारोले तेरो कुरा सुन्‍नेछैन। तब म इजिप्ट देशमाथि मेरो हात पसार्नेछु, र न्यायका शक्तिशाली कार्यहरूद्वारा म मेरा दल, मेरा प्रजा इस्राएलीहरूलाई इजिप्ट देशबाट बाहिर निकालेर ल्याउनेछु।<verse eid="EXO 7:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 7:5"/>जब म आफ्नो हात इजिप्टको विरुद्धमा पसारेर इस्राएलीहरूलाई तिनीहरूको बीचबाट निकालेर बाहिर ल्याउनेछु, तब इजिप्टियनहरूले म नै याहवेह हुँ भनी जान्‍नेछन्।”<verse eid="EXO 7:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 7:6"/>तब मोशा र हारूनले याहवेहले तिनीहरूलाई आज्ञा दिनुभएझैँ गरे।<verse eid="EXO 7:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 7:7"/>तिनीहरूले फारोसित कुरा गर्दा मोशा असी वर्ष र हारून त्रियासी वर्ष पुगेका थिए।<verse eid="EXO 7:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 7:8"/>याहवेहले मोशा र हारूनलाई भन्‍नुभयो,<verse eid="EXO 7:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 7:9"/>“जब फारोले तिमीहरूलाई ‘एउटा आश्‍चर्य कर्म गर’ भन्ला, तब हारूनलाई ‘तपाईंको लहुरो लिएर फारोको सामु भुइँमा फालिदिनुहोस्’ भन्‍नू, तब त्यो एउटा सर्प बन्‍नेछ।”<verse eid="EXO 7:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 7:10"/>यसकारण मोशा र हारून फारोकहाँ गएर याहवेहले आज्ञा गर्नुभएझैँ गरे। हारूनले फारो र उनका अधिकारीहरूको सामु आफ्नो लहुरो भुइँमा फाले, र त्यो एउटा सर्प बन्यो।<verse eid="EXO 7:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 7:11"/>तब फारोले बुद्धिमान् मानिसहरू र तन्त्रमन्त्र गर्नेहरूलाई बोलाए; अनि इजिप्टका जादुगरहरूले पनि आफ्ना गुप्‍त कलाद्वारा त्यस्तै कामहरू गरे:<verse eid="EXO 7:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 7:12"/>प्रत्येकले आफ्नो लहुरो भुइँमा फाले, र त्यो सर्प भयो। तर हारूनको लहुरोले उनीहरूका लहुरोहरूलाई निलिदियो।<verse eid="EXO 7:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 7:13"/>तैपनि फारोको हृदय कठोर भयो, र याहवेहले भन्‍नुभएझैँ, उनले तिनीहरूका कुरा सुनेनन्।<verse eid="EXO 7:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 7:14"/>तब याहवेहले मोशालाई भन्‍नुभयो, “फारोको हृदय कठोर भएको छ; त्यसले मानिसहरूलाई जान दिँदैन।<verse eid="EXO 7:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 7:15"/>बिहान फारो नदीमा गएको बेला त्यसकहाँ जा। नील नदीको किनारमा त्यससँग भेट गर्नलाई पर्खिबस्; अनि सर्पमा परिणत भएको त्यो लहुरो हातमा लिएर जा।<verse eid="EXO 7:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 7:16"/>तब त्यसलाई भन्, ‘याहवेह हिब्रूहरूका परमेश्‍वरले मलाई तपाईंकहाँ यसो भन्‍न पठाउनुभएको छ: मेरा मानिसहरूलाई उजाडस्थानमा मेरो आराधना गर्नलाई जान दे। तर तपाईंले अहिलेसम्म सुन्‍नुभएको छैन।<verse eid="EXO 7:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 7:17"/>याहवेह यसो भन्‍नुहुन्छ: यसद्वारा तैँले म नै याहवेह हुँ भनी जान्‍नेछस्; म मेरो हातमा भएको लहुरोले नील नदीको पानीलाई हिर्काउनेछु, र त्यो रगतमा परिणत हुनेछ।<verse eid="EXO 7:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 7:18"/>नील नदीका माछाहरू मर्नेछन्, र नदीको पानी साह्रै गन्हाउनेछ, र इजिप्टियनहरूले त्यस नदीको पानी पिउन सक्नेछैनन्।’ ”<verse eid="EXO 7:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 7:19"/>याहवेहले मोशालाई भन्‍नुभयो, “हारूनलाई भन्, ‘आफ्नो लहुरो लिएर इजिप्टका पानीहरू—नदीनालाहरू, पोखरीहरू र सबै जलाशयहरूमाथि तेरो हात पसार—तब ती सबै रगत हुनेछन्।’ इजिप्टका सबै ठाउँहरू, यहाँसम्म कि काठका भाँडाहरू र ढुङ्गाका भाँडाहरूमा समेत रगतै-रगत हुनेछ।”<verse eid="EXO 7:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 7:20"/>मोशा र हारूनले याहवेहले आज्ञा दिनुभएबमोजिम गरे। तिनले फारो र उनका अधिकारीहरूका उपस्थितिमा आफ्नो लहुरो उठाए, र नील नदीको पानीलाई हिर्काए; अनि सबै पानी रगतमा परिणत भयो।<verse eid="EXO 7:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 7:21"/>नील नदीमा भएका माछाहरू मरे, र नदीमा यति नराम्रो गन्ध आउन थाल्यो कि इजिप्टियनहरूले त्यस नदीको पानी पिउन सकेनन्। इजिप्ट देशभरि सबै पानी रगतै-रगत भयो।<verse eid="EXO 7:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 7:22"/>तर इजिप्टका जादुगरहरूले पनि आफ्ना गुप्‍त कलाद्वारा त्यस्तै काम गरे; अनि फारोको हृदय कठोर भयो, र याहवेहले भन्‍नुभएझैँ उनले मोशा र हारूनका कुरा सुनेनन्।<verse eid="EXO 7:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 7:23"/>बरु फारो फर्केर आफ्नो महलमा गए, र यस कुरामाथि ध्यानै दिएनन्।<verse eid="EXO 7:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 7:24"/>अनि सारा इजिप्टियनहरूले पिउने पानीको लागि नील नदीको वरिपरि खने; किनकि उनीहरूले नदीको पानी पिउन सकेनन्।<verse eid="EXO 7:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 7:25"/>याहवेहले नील नदीमाथि प्रहार गर्नुभएको सात दिन बितिसकेको थियो।<verse eid="EXO 7:25"/></para>
<chapter eid="EXO 7"/>
<chapter number="8" style="c" sid="EXO 8"/>
<para style="p"><verse number="1" style="v" sid="EXO 8:1"/>फेरि याहवेहले मोशालाई भन्‍नुभयो, “फारोकहाँ गएर त्यसलाई भन्, ‘याहवेह यसो भन्‍नुहुन्छ: मेरा मानिसहरूलाई जान दे, र तिनीहरूले मेरो आराधना गरून्।<verse eid="EXO 8:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 8:2"/>यदि तैँले तिनीहरूलाई जान दिइनस् भने हेर्, म तेरो सारा देशमा भ्यागुताहरू पठाएर विपत्ति ल्याउनेछु।<verse eid="EXO 8:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 8:3"/>नील नदी भ्यागुताले भरिनेछ। ती भ्यागुताहरू तेरो महलभित्र, तेरो सुत्ने कोठाभित्र, तेरो खाटमाथि, तेरा अधिकारीहरूका घर-घरमा, तेरा प्रजामाथि, तेरो चुल्हा र पिठो मुछ्ने भाँडाहरूमा उक्लेर आउनेछन्।<verse eid="EXO 8:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 8:4"/>ती भ्यागुताहरू तँमाथि, तेरा प्रजामाथि र तेरा सबै अधिकारीहरूमाथि पनि आउनेछन्।’ ”<verse eid="EXO 8:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 8:5"/>तब याहवेहले मोशालाई भन्‍नुभयो, “हारूनलाई भन्, ‘आफ्नो लहुरो लिएर तपाईंको हात नदी, नाला, पोखरीहरूमाथि पसार्नुहोस्, र इजिप्ट देशमा भ्यागुताहरू उक्लेर आऊन्।’ ”<verse eid="EXO 8:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 8:6"/>यसकारण हारूनले इजिप्टका पानीहरूमाथि आफ्नो हात पसारे; अनि भ्यागुताहरू माथि निस्केर आए, र इजिप्ट देशलाई ढाकिदिए।<verse eid="EXO 8:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 8:7"/>तर जादुगरहरूले पनि आफ्ना गुप्‍त कलाद्वारा त्यसै गरे; तिनीहरूले पनि इजिप्ट देशमा भ्यागुताहरू ल्याए।<verse eid="EXO 8:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 8:8"/>तब फारोले मोशा र हारूनलाई बोलाएर भने, “म र मेरा मानिसहरूबाट भ्यागुताहरू हटाऊन् भनी याहवेहसित बिन्ती चढाइदेओ, तब म तिम्रा मानिसहरूलाई याहवेहका निम्ति बलिदान चढाउनलाई जान दिनेछु।”<verse eid="EXO 8:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 8:9"/>मोशाले फारोलाई भने, “मैले तपाईंका निम्ति, तपाईंका अधिकारीहरू र तपाईंका प्रजाका निम्ति नील नदीका बाहेक यी भ्यागुताहरू तपाईं र तपाईंका घरहरूबाट मुक्त गरिऊन् भनेर प्रार्थना गरिदिने समय ठहराउने सम्मानचाहिँ म तपाईंलाई नै दिन्छु।”<verse eid="EXO 8:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 8:10"/>फारोले भने, “भोलि प्रार्थना गरिदिनुहोला।” मोशाले जवाफ दिए, “तपाईंले भन्‍नुभएझैँ नै हुनेछ, र तपाईंले याहवेह हाम्रा परमेश्‍वरझैँ अरू कोही छैन भन्‍ने जान्‍न सक्नुहुनेछ।<verse eid="EXO 8:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 8:11"/>यी भ्यागुताहरूले तपाईं, तपाईंका घरहरू, तपाईंका अधिकारीहरू र तपाईंका मानिसहरूलाई छोड्नेछन्; तर तिनीहरू नील नदीमा मात्र रहनेछन्।”<verse eid="EXO 8:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 8:12"/>मोशा र हारून फारोकहाँबाट निस्केर गएपछि मोशाले याहवेहकहाँ उहाँले फारोमाथि ल्याउनुभएका भ्यागुताहरूका निम्ति पुकार गरे।<verse eid="EXO 8:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 8:13"/>अनि याहवेहले मोशाले मागेअनुसार गरिदिनुभयो; अनि ती भ्यागुताहरू घर, आँगन र खेतहरूमा नै मरे।<verse eid="EXO 8:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 8:14"/>तिनीहरूले ती बटुलेर थुप्रो लगाए; र देश नै दुर्गन्धले ढाकियो।<verse eid="EXO 8:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 8:15"/>तर जब फारोले सबै शान्त भएको देखे, तब तिनले आफ्नो हृदय कठोर पारे, र याहवेहले भन्‍नुभएझैँ मोशा र हारूनका कुरा सुनेनन्।<verse eid="EXO 8:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 8:16"/>फेरि याहवेहले मोशालाई भन्‍नुभयो, “हारूनलाई भन्, ‘तपाईंको लहुरो पसारेर जमिनको धुलोलाई हिर्काउनुहोस्,’ अनि त्यो सारा इजिप्ट देशभरि भुसुनै-भुसुना बन्‍नेछ।”<verse eid="EXO 8:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 8:17"/>तिनीहरूले त्यसै गरे; जब हारूनले लहुरो उठाएर जमिनका धुलोलाई हिर्काए, तब ती भुसुनाहरू मानिसहरू र पशुहरूमाथि आए। जमिनको सबै धुलो सारा इजिप्ट देशभरि भुसुनाहरू बने।<verse eid="EXO 8:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 8:18"/>तर जब ती जादुगरहरूले तिनीहरूका गुप्‍त कलाद्वारा भुसुनाहरू निकाल्न खोजे, तिनीहरूले सकेनन्। अनि ती भुसुनाहरू मानिसहरू र पशुहरूमाथि भइरहे।<verse eid="EXO 8:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 8:19"/>ती जादुगरहरूले फारोलाई भने, “यो सबै कार्यमा परमेश्‍वरको हात छ।” तर फारोको हृदय याहवेहले भन्‍नुभएझैँ कठोर थियो, र तिनले सुन्‍न मानेनन्।<verse eid="EXO 8:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 8:20"/>फेरि याहवेहले मोशालाई भन्‍नुभयो, “बिहानै उठ् र फारो नदीमा जाँदा त्यसलाई भन्, ‘याहवेह यसो भन्‍नुहुन्छ: मेरा मानिसहरूलाई जान दे, र तिनीहरूले मेरो आराधना गरून्।<verse eid="EXO 8:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 8:21"/>तैँले मेरा मानिसहरूलाई जान दिइनस् भने म तँमाथि र तेरा अधिकारीहरूमाथि, तेरा मानिसहरूमाथि, र तेरा घरहरूमा हुलका हुल झिँगाहरू पठाउनेछु। इजिप्टियनहरूका घरहरू र तिनीहरू बसेका जमिन पनि झिँगाहरूले भरिनेछ।<verse eid="EXO 8:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 8:22"/>“ ‘तर त्यस दिन म मेरा मानिसहरू बस्‍ने गोशेनको प्रान्तप्रति बेग्लै किसिमले व्यवहार गर्नेछु; त्यहाँ झिँगाको कुनै हुल हुनेछैन, र तैँले म नै याहवेह, यस देशमा छु भनी जान्‍नेछस्।<verse eid="EXO 8:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 8:23"/>म मेरा मानिसहरू र तेरा मानिसहरूको बीचमा भिन्‍नता पार्नेछु। यो अलौकिक चिन्ह भोलि हुनेछ।’ ”<verse eid="EXO 8:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 8:24"/>अनि याहवेहले त्यसै गर्नुभयो। फारोको महलमा र तिनका अधिकारीहरूका घरहरूभित्र धेरै मात्रामा झिँगाका हुलका हुल खनिए; र इजिप्टको जमिन झिँगाहरूद्वारा नाश भयो।<verse eid="EXO 8:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 8:25"/>तब फारोले मोशा र हारूनलाई बोलाएर भने, “जाओ, र यस देशभित्रै आफ्ना परमेश्‍वरका निम्ति बलिदान चढाओ।”<verse eid="EXO 8:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 8:26"/>तर मोशाले भने, “यसो गर्नु उचित नहोला। हामीले याहवेह हाम्रा परमेश्‍वरलाई चढाएको बलिदान इजिप्टियनहरूले घृणा गर्छन्। हामीले तिनीहरूका दृष्‍टिमा घृणित बलिदान चढायौँ भने, के तिनीहरूले हामीलाई ढुङ्गाले हान्‍नेछैनन् र?<verse eid="EXO 8:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 8:27"/>हामीलाई याहवेह हाम्रा परमेश्‍वरले आज्ञा गर्नुभएझैँ तीन दिनको यात्रा गरेर उजाडस्थानमा गएर उहाँका निम्ति बलिदान चढाउनेछौँ।”<verse eid="EXO 8:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 8:28"/>फारोले भने, “म तिमीहरूलाई उजाडस्थानमा गएर याहवेह तिमीहरूका परमेश्‍वरका निम्ति बलिदान चढाउन जान दिनेछु; तर धेरै टाढा नजाओ। अब मेरा निम्ति प्रार्थना गरिदेओ।”<verse eid="EXO 8:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 8:29"/>मोशाले जवाफ दिए, “म तपाईंबाट जाने बित्तिकै याहवेहसित प्रार्थना गर्नेछु, र भोलि यी सबै झिँगाका हुलहरू तपाईं, तपाईंका अधिकारीहरू र तपाईंका मानिसहरूबाट जानेछन्। तर यी मानिसहरूलाई याहवेहका निम्ति बलिदान चढाउन जान नदिएर फारोले फेरि छलपूर्ण काम नगर्न निश्‍चय गर्नुहोला।”<verse eid="EXO 8:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 8:30"/>तब मोशा फारोकहाँबाट गए, र याहवेहलाई प्रार्थना चढाए।<verse eid="EXO 8:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 8:31"/>याहवेहले मोशाले मागेअनुसार गरिदिनुभयो: ती झिँगाका हुलहरू फारो, तिनका अधिकारीहरू र तिनका मानिसहरूलाई छोडेर गइहाले; एउटै झिँगा पनि बाँकी रहेन।<verse eid="EXO 8:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 8:32"/>तर यस पटक पनि फारोले आफ्नो हृदय कठोर पारे, र मानिसहरूलाई जान दिएनन्।<verse eid="EXO 8:32"/></para>
<chapter eid="EXO 8"/>
<chapter number="9" style="c" sid="EXO 9"/>
<para style="p"><verse number="1" style="v" sid="EXO 9:1"/>फेरि याहवेहले मोशालाई भन्‍नुभयो, “फारोकहाँ गएर त्यसलाई भन्, ‘याहवेह, हिब्रूहरूका परमेश्‍वर यसो भन्‍नुहुन्छ: “मेरा मानिसहरूलाई जान दे, र तिनीहरूले मेरो आराधना गरून्।”<verse eid="EXO 9:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 9:2"/>तैँले तिनीहरूलाई जान नदिएर रोकेर राखिस् भने,<verse eid="EXO 9:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 9:3"/>याहवेहको हातले तेरा खेतमा भएका पशुहरू—तेरा घोडाहरू, गधाहरू, ऊँटहरू अनि तेरा गाईबस्तुहरू र भेडाबाख्राहरूमाथि डरलाग्दो महामारी ल्याउनेछ।<verse eid="EXO 9:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 9:4"/>तर याहवेहले इस्राएलका गाईबस्तुहरू र इजिप्टका गाईबस्तुहरूका बीचमा भिन्‍नता ल्याउनुहुनेछ; ताकि इस्राएलीहरूका कुनै पनि पशु नमरोस्।’ ”<verse eid="EXO 9:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 9:5"/>याहवेहले एउटा निश्‍चित समय ठहर्‍याएर भन्‍नुभयो, “भोलि यो कुरा याहवेहले यस देशमा गर्नुहुनेछ।”<verse eid="EXO 9:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 9:6"/>अनि भोलिपल्ट याहवेहले त्यो कुरा गर्नुभयो: इजिप्टका सबै गाईबस्तु मरे, तर इस्राएलीहरूका एउटै पनि पशु मरेनन्।<verse eid="EXO 9:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 9:7"/>फारोले यो जाँच गर्न मानिसहरू पठाए; अनि इस्राएलीहरूका एउटै पनि पशु नमरेको थाहा पाए। तर पनि तिनको हृदय कठोर भयो, र तिनले मानिसहरूलाई जान दिएनन्।<verse eid="EXO 9:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 9:8"/>फेरि याहवेहले मोशा र हारूनलाई भन्‍नुभयो, “भट्टीबाट आ-आफ्ना हातमा खरानी लेओ, र मोशाले फारोको उपस्थितिमा त्यो हावामा छरिदेओस्।<verse eid="EXO 9:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 9:9"/>त्यो इजिप्ट देशभरि मसिनो धुलो बन्‍नेछ, र इजिप्ट देशभरिका मानिसहरू र पशुहरूमा पाक्ने खटिरा निस्कनेछ।”<verse eid="EXO 9:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 9:10"/>तब तिनीहरू भट्टीबाट खरानी लिएर फारोको सामु खडा भए। मोशाले त्यसलाई हावामा छरिदिए; अनि मानिसहरू र पशुहरूमा पाक्ने खटिरा निस्के।<verse eid="EXO 9:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 9:11"/>ती खटिराहरू जादुगरहरू र सारा इजिप्टियनहरूमाथि भएका कारण ती जादुगरहरू मोशाको सामु खडा हुन सकेनन्।<verse eid="EXO 9:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 9:12"/>तर याहवेहले फारोको हृदय कठोर पारिदिनुभयो, र याहवेहले मोशालाई भन्‍नुभएझैँ तिनले मोशा र हारूनका कुरा सुनेनन्।<verse eid="EXO 9:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 9:13"/>फेरि याहवेहले मोशालाई भन्‍नुभयो, “बिहान सबेरै उठ्, र फारोलाई भन्, ‘याहवेह, हिब्रूहरूका परमेश्‍वर यसो भन्‍नुहुन्छ: मेरा मानिसहरूलाई जान दे, र तिनीहरूले मेरो आराधना गरून्,<verse eid="EXO 9:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 9:14"/>नत्रता यस पटक म मेरो पूरा शक्तिसाथ विपत्तिहरू तँमाथि, तेरा अधिकारीहरू, तेरा मानिसहरूका विरुद्धमा पठाउनेछु; र तिमीहरूले सारा पृथ्वीमा मजस्तो अरू कोही छैन भनी जान्‍नेछौ।<verse eid="EXO 9:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 9:15"/>किनकि अहिले सम्ममा मैले आफ्नो हात पसारेर तँलाई र तेरा मानिसहरूमाथि विपत्तिले प्रहार गर्न सक्नेथिएँ, जसले पृथ्वीबाट तिमीहरूको नामनिशानै मेटिदिनेथियो।<verse eid="EXO 9:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 9:16"/>तर मैले त आफ्नो शक्ति तँलाई देखाऊँ र सारा पृथ्वीमा मेरो नामको घोषणा गरियोस् भन्‍ने उद्देश्यले तँलाई खडा गरेको छु।<verse eid="EXO 9:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 9:17"/>तैँले त अझ पनि मेरा मानिसहरूलाई जान नदिनका लागि तिनीहरूको विरुद्धमा आफूलाई खडा गरेको छस्।<verse eid="EXO 9:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 9:18"/>यसकारण भोलि यही समयमा म यस्तो भयानक असिना पठाउनेछु; जुन इजिप्ट देश स्थापित भएको समयदेखि अहिलेसम्म कहिल्यै खसेको छैन।<verse eid="EXO 9:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 9:19"/>यसकारण तेरा गाईबस्तुहरू, तेरा खेतमा भएका हरेक कुरा सुरक्षित ठाउँमा ल्याउन भनी अहिले हुकुम दे; किनकि भित्र नल्याइएका, र खेतमै रहेका प्रत्येक मानिस र पशुमाथि असिना बर्सनेछ, र ती मर्नेछन्।’ ”<verse eid="EXO 9:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 9:20"/>याहवेहको वचनदेखि डराउने फारोका अधिकारीहरूले आफ्ना सेवकहरू र पशुहरूलाई भित्र ल्याउन हतार गरे।<verse eid="EXO 9:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 9:21"/>तर याहवेहको वचनको अवहेलना गर्नेहरूले आफ्ना सेवक र पशुहरू खेतमै छोडिराखे।<verse eid="EXO 9:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 9:22"/>तब याहवेहले मोशालाई भन्‍नुभयो, “तेरो हात आकाशतिर पसार्, र इजिप्ट देशमाथि, मानिसहरूमाथि, पशुहरूमाथि र इजिप्टको खेतमा बढ्दै गरेको प्रत्येक कुरामाथि असिना परोस्।”<verse eid="EXO 9:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 9:23"/>जब मोशाले आफ्नो लहुरो आकाशतिर पसारे, तब याहवेहले गर्जन र असिना पठाउनुभयो; अनि बिजुली चम्केर जमिनसम्मै पर्‍यो। यसरी याहवेहले इजिप्टमा असिना बर्साउनुभयो।<verse eid="EXO 9:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 9:24"/>असिना पर्‍यो र बिजुली जताततै चम्क्यो। इजिप्ट एउटा राष्ट्र बनेको दिनदेखि यता यस्तो प्रकारको असिना कहिल्यै परेको थिएन।<verse eid="EXO 9:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 9:25"/>समस्त इजिप्टमा असिनाले खेतमा भएका सबै थोक, मानिसहरू र पशुहरू दुवैलाई प्रहार गर्‍यो; यसले खेतमा बढिरहेका सबै घाँसलाई चुट्यो, र प्रत्येक रूखलाई नाङ्गो बनाइदियो।<verse eid="EXO 9:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 9:26"/>इस्राएलीहरू बसेका गोशेनको प्रान्तमा मात्र असिना परेको थिएन।<verse eid="EXO 9:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 9:27"/>तब फारोले मोशा र हारूनलाई बोलाइपठाए। तिनले उनीहरूलाई भने, “यस पटक मैले पाप गरेको छु। याहवेह धर्मी हुनुहुन्छ; अनि म र मेरा मानिसहरू गलत रहेछौँ।<verse eid="EXO 9:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 9:28"/>यो गर्जन र असिना अति भयो भनी याहवेहसित बिन्ती गरिदेओ; म तिमीहरूलाई जान दिनेछु; तिमीहरू अब उसो एकक्षण पनि बस्‍नुपर्नेछैन।”<verse eid="EXO 9:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 9:29"/>मोशाले जवाफ दिए, “म यस सहरबाट बाहिर निस्केपछि मेरा याहवेहसित बिन्ती गर्दै आफ्ना हात पसार्नेछु। तब गर्जन थामिनेछ, र असिना फेरि पर्नेछैन; र तपाईंले यो पृथ्वी याहवेहकै हो भनी जान्‍नुहुनेछ।<verse eid="EXO 9:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 9:30"/>तर म जान्दछु, तपाईं र तपाईंका अधिकारीहरू अझ पनि याहवेह परमेश्‍वरको डर मान्‍नुहुन्‍न।”<verse eid="EXO 9:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 9:31"/>(सनपाटका फूल फुलेका र जौका बाला निस्केका हुनाले ती नष्‍ट भए।<verse eid="EXO 9:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 9:32"/>तर गहुँ र कठियागहुँ ढिलो पाक्ने हुनाले नष्‍ट भएनन्।)<verse eid="EXO 9:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 9:33"/>तब मोशा फारोकहाँबाट निस्केर सहरबाहिर गए। तिनले आफ्ना हात याहवेहतिर फैलाए; अनि गर्जन र असिना थामिए, र देशमा पानी पर्न छाड्यो।<verse eid="EXO 9:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 9:34"/>जब फारोले पानी, असिना र गर्जन थामिएको देखे, तब तिनले फेरि पाप गरे: तिनी र तिनका अधिकारीहरूले आफ्ना हृदय कठोर गरे।<verse eid="EXO 9:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 9:35"/>तब फारोको हृदय कठोर भयो; याहवेहले मोशाद्वारा भन्‍नुभएझैँ तिनले इस्राएलीहरूलाई जान दिएनन्।<verse eid="EXO 9:35"/></para>
<chapter eid="EXO 9"/>
<chapter number="10" style="c" sid="EXO 10"/>
<para style="p"><verse number="1" style="v" sid="EXO 10:1"/>फेरि याहवेहले मोशालाई भन्‍नुभयो, “फारोकहाँ जा, किनकि मैले त्यसको र त्यसका अधिकारीहरूको हृदय कठोर बनाइदिएको छु, ताकि म तिनीहरूमाथि आफ्ना यी अलौकिक चिन्हहरू गर्न सकूँ;<verse eid="EXO 10:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 10:2"/>अनि मैले इजिप्टियनहरूसित कति कडा व्यवहार गरेँ, र मैले कसरी तिनीहरूबीच मेरा अलौकिक चिन्हहरू देखाएँ भनी तिमीहरूले आफ्ना छोराछोरीहरू र नातिनातिनाहरूलाई भन्‍नेछौ, र तिमीहरूले म नै याहवेह हुँ भनी जान्‍नेछौ।”<verse eid="EXO 10:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 10:3"/>यसकारण मोशा र हारून फारोकहाँ गएर तिनलाई भने, “याहवेह, हिब्रूहरूका परमेश्‍वर, यसो भन्‍नुहुन्छ: ‘मेरो अगि आफूलाई नम्र तुल्याउन तँ कहिलेसम्म अस्वीकार गर्छस्? मेरा मानिसहरूलाई जान दे, र तिनीहरूले मेरो आराधना गरून्।<verse eid="EXO 10:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 10:4"/>तैँले तिनीहरूलाई जान दिन अस्वीकार गरिस् भने म भोलि तेरो देशमा सलहहरू ल्याउनेछु।<verse eid="EXO 10:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 10:5"/>तिनीहरूले जमिनलाई नदेखिने गरी ढाकिदिनेछन्। असिनापछि अलि-अलि जे जति बाँकी रहेका छन्, तिनीहरूले ती सबै अनि तिमीहरूका खेतहरूमा बढ्दै गरेका प्रत्येक रूखलाई खाइदिनेछन्।<verse eid="EXO 10:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 10:6"/>तिनीहरूले तेरा घरहरू, तेरा सबै अधिकारीहरू र सारा इजिप्टियनहरूका घरहरू भरिनेछन्; यस्ता सलहहरू न तेरा पिताले, न त तेरा पुर्खाहरूले नै यस देशमा बसोबास गरेको समयदेखि आजसम्म देखेका छन्।’ ” तब मोशा फर्के, र फारोलाई छोडेर गए।<verse eid="EXO 10:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 10:7"/>फारोका अधिकारीहरूले तिनलाई भने, “यो मानिस कहिलेसम्म हाम्रा निम्ति पासो बन्‍ने? यी मानिसहरूलाई जान दिनुहोस्, ताकि याहवेह तिनीहरूका परमेश्‍वरको आराधना गरून्। इजिप्ट नाश भइसक्यो भनेर के तपाईंलाई अझ थाहा छैन र?”<verse eid="EXO 10:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 10:8"/>तब मोशा र हारून फारोकहाँ फर्काएर ल्याइए। अनि तिनले उनीहरूलाई भने, “जाओ, गएर याहवेह तिमीहरूका परमेश्‍वरको आराधना गर। तर जानेहरूचाहिँ को-को हुन्?”<verse eid="EXO 10:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 10:9"/>मोशाले जवाफ दिए, “हामी आफ्ना साना-ठूलासित, आफ्ना छोराछोरीहरूसित, आफ्ना बगाल र बथान सहित जानेछौँ; किनकि हामीले याहवेहका निम्ति चाड मनाउनुपर्छ।”<verse eid="EXO 10:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 10:10"/>फारोले भने, “म तिमीहरूलाई तिमीहरूका स्त्रीहरू र छोराछोरीहरूसहित जान दिनेछु, याहवेह तिमीहरूसित होऊन्, तर होशियार होऊ; किनभने तिमीहरूको यसमा दुष्‍टता देखिन्छ।<verse eid="EXO 10:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 10:11"/>अहँ, त्यसो होइन; तिमीहरू पुरुषहरू मात्र जाओ, र याहवेहको आराधना गर, जसका निम्ति तिमीहरूले बिन्ती गरिरहेका छौ।” तब मोशा र हारून फारोको उपस्थितिबाट निकालिए।<verse eid="EXO 10:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 10:12"/>अनि याहवेहले मोशालाई भन्‍नुभयो, “तेरो हात इजिप्टमाथि पसार्, र सलहहरूका हुल यस देशमा आऊन्, र खेतमा बढिरहेका घाँसपात, असिनाबाट बचेको सबै थोक खाइदेऊन्।”<verse eid="EXO 10:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 10:13"/>तब मोशाले आफ्नो लहुरो इजिप्टमाथि पसारे; अनि याहवेहले देशको चारैतिर दिनभरि र रातभरि पूर्वीय बतास चलाइदिनुभयो। तब बिहान भएपछि पूर्वीय बतासले सलहहरू ल्यायो।<verse eid="EXO 10:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 10:14"/>सलहहरूले सम्पूर्ण इजिप्टमाथि आक्रमण गरे, र देशका सबै भागहरूमा धेरै संख्यामा बसे। यसअगि कहिल्यै यति धेरै सलहहरू आएका थिएनन्, न त फेरि त्यो कहिल्यै आउनेछन्।<verse eid="EXO 10:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 10:15"/>तिनीहरूले सम्पूर्ण जमिनलाई कालो हुने गरी ढाकिदिए। तिनीहरूले असिनाले बचेका हरेक वनस्पति र रूखका सबै फलहरू खाइदिए। इजिप्टभरिका रूखहरू अथवा बोटबिरुवाहरूमा हरियो पात केही बाँकी रहेन।<verse eid="EXO 10:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 10:16"/>त्यसैले फारोले तुरुन्तै मोशा र हारूनलाई बोलाएर भने, “मैले याहवेह तिमीहरूका परमेश्‍वर र तिमीहरूका विरुद्धमा पाप गरेको छु।<verse eid="EXO 10:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 10:17"/>अब फेरि एक पल्ट मेरो पाप क्षमा गरिदेओ, र यो घातक विपत्ति मबाट हटाइदेऊन् भनी याहवेह तिमीहरूका परमेश्‍वरसित बिन्ती गरिदेओ।”<verse eid="EXO 10:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 10:18"/>तब मोशा फारोकहाँबाट निस्केर गइहाले र याहवेहलाई बिन्ती चढाए।<verse eid="EXO 10:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 10:19"/>अनि याहवेहले बतासलाई ठूलो पश्‍चिमी बतासमा परिणत गरिदिनुभयो, जसले सलहहरूलाई उडाएर लाल समुद्रमा फालिदियो। त्यसपछि इजिप्टमा एउटै सलह पनि रहेन।<verse eid="EXO 10:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 10:20"/>तर याहवेहले फारोको हृदय कठोर पारिदिनुभयो; र तिनले इस्राएलीहरूलाई जान दिएनन्।<verse eid="EXO 10:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 10:21"/>तब याहवेहले मोशालाई भन्‍नुभयो, “तेरो हात आकाशतिर पसार्, र इजिप्टमाथि अँध्यारो भइजाओस्—छाम्दा पनि थाहा पाउनेजस्तो अन्धकार।”<verse eid="EXO 10:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 10:22"/>यसकारण मोशाले आफ्नो हात आकाशतिर पसारे, र इजिप्टभरि तीन दिनसम्म घनघोर अन्धकार भयो।<verse eid="EXO 10:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 10:23"/>तीन दिनसम्म कसैले एक-अर्कालाई देख्न सकेनन्, र आफ्नो ठाउँ छोड्न सकेनन्। तरै पनि इस्राएलीहरूका निम्ति त तिनीहरू बसेको ठाउँहरूमा उज्यालो रह्‍यो।<verse eid="EXO 10:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 10:24"/>तब फारोले मोशालाई बोलाएर भने, “जाऊ, याहवेहको आराधना गर। तिमीहरूका स्त्रीहरू र छोराछोरीहरू पनि तिमीहरूसित जाऊन्; केवल तिमीहरूका बगाल र बथान मात्र यहाँ रहून्।”<verse eid="EXO 10:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 10:25"/>तर मोशाले भने, “तपाईंले हामीलाई याहवेह हाम्रा परमेश्‍वरका निम्ति बलिदान र होमबलि चढाउन दिनुपर्छ।<verse eid="EXO 10:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 10:26"/>हाम्रा गाईबस्तुहरू पनि हामीसित जानेछन्, र एउटै खुर समेत छोडिनेछैन; किनकि हामीले तीमध्ये कुनै-कुनै बस्तुभाउ हाम्रा याहवेह परमेश्‍वरलाई चढाउनुपर्छ; जबसम्म हामी त्यहाँ पुग्दैनौँ, तबसम्म हामीले याहवेहलाई के-के चढाएर आराधना गर्नुपर्छ, सो हामीलाई थाहा हुँदैन।”<verse eid="EXO 10:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 10:27"/>तर याहवेहले फारोको हृदय कठोर पारिदिनुभयो; अनि उनले तिनीहरूलाई जान दिएनन्।<verse eid="EXO 10:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 10:28"/>फारोले मोशालाई भने, “यहाँबाट गईहाल! अब फेरि मेरो सामु तिमी देखा पर्दै नपर! तिमीले मेरो अनुहार देखेको त्यही दिन तिमी मर्नेछौ।”<verse eid="EXO 10:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 10:29"/>मोशाले जवाफ दिए, “तपाईंले भन्‍नुभएझैँ म फेरि तपाईंको सामु कहिल्यै देखा पर्नेछैनँ।”<verse eid="EXO 10:29"/></para>
<chapter eid="EXO 10"/>
<chapter number="11" style="c" sid="EXO 11"/>
<para style="p"><verse number="1" style="v" sid="EXO 11:1"/>फेरि याहवेहले मोशालाई भन्‍नुभयो, “म फारो र इजिप्टमाथि अझै एउटा विपत्ति ल्याउनेछु। त्यसपछि त्यसले तिमीहरूलाई जान दिनेछ; जब त्यसले जान दिनेछ, त्यसले तिमीहरूलाई पूर्ण रूपले निकालिदिनेछ।<verse eid="EXO 11:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 11:2"/>मानिसहरूलाई भन्, कि पुरुष र स्त्री दुवैले आफ्ना छिमेकीहरूसँग चाँदी र सुनका चीजहरू मागून्।”<verse eid="EXO 11:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 11:3"/>(याहवेहले इजिप्टियनहरूलाई यी मानिसहरूप्रति दयालु बनाउनुभयो; मोशा आफूले पनि फारो र तिनका अधिकारीहरू र मानिसहरूद्वारा अति मान-सम्मान पाएका थिए।)<verse eid="EXO 11:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 11:4"/>यसकारण मोशाले भने, “याहवेह यसो भन्‍नुहुन्छ: ‘मध्यराततिर म इजिप्टको बीचबाट भएर जानेछु।<verse eid="EXO 11:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 11:5"/>इजिप्टमा भएका प्रत्येक जेठो छोरा मर्नेछ। सिंहासनमा बस्‍ने फारोको जेठा छोरादेखि लिएर, जाँतो पिँध्ने दासीको जेठा छोरासम्म, र पशुहरूको पनि पहिले जन्मिएका प्रत्येक सबै मर्नेछन्।<verse eid="EXO 11:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 11:6"/>इजिप्टभरि चर्को विलाप हुनेछ—जुन पहिले कहिल्यै भएको थिएन, न त फेरि पछि यस्तो विलाप कहिल्यै हुनेछ;<verse eid="EXO 11:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 11:7"/>तर इस्राएलीहरूका बीचमा भने कुनै मानिसलाई अथवा पशुलाई एउटा कुकुरले पनि भुक्नेछैन।’ तब तिमीहरूले जान्‍नेछौ कि याहवेहले इजिप्ट र इस्राएलको बीचमा भिन्‍नता राख्नुहुन्छ।<verse eid="EXO 11:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 11:8"/>तेरा यी सबै अधिकारीहरू मकहाँ आएर मलाई दण्डवत् गर्दै यसो भन्दै आउनेछन्, ‘तपाईं र तपाईंका पछि लाग्ने मानिसहरू जानुहोस्!’ त्यसपछि म निस्किजानेछु।” तब अत्यन्त क्रोधित भएर मोशा फारोकहाँबाट गइहाले।<verse eid="EXO 11:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 11:9"/>याहवेहले मोशालाई भन्‍नुभएको थियो, “इजिप्टमा मेरा अद्‌भुत कार्यहरू बढ्दै जाऊन् भनेर फारोले तेरो कुरा सुन्‍न इन्कार गर्नेछ।”<verse eid="EXO 11:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 11:10"/>मोशा र हारूनले फारोको अगि यी सबै अद्‌भुत कार्यहरू गरे, तर याहवेहले फारोको हृदय कठोर पारिदिनुभयो, र तिनले इस्राएलीहरूलाई आफ्नो देशबाट जान दिएनन्।<verse eid="EXO 11:10"/></para>
<chapter eid="EXO 11"/>
<chapter number="12" style="c" sid="EXO 12"/>
<para style="p"><verse number="1" style="v" sid="EXO 12:1"/>याहवेहले मोशा र हारूनलाई इजिप्टमा भन्‍नुभयो,<verse eid="EXO 12:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 12:2"/>“यो महिना तिमीहरूका लागि महिनाहरूको सुरु, वर्षको पहिलो महिना हुनेछ।<verse eid="EXO 12:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 12:3"/>इस्राएलका सम्पूर्ण समुदायलाई प्रत्येक मानिसले यो महिनाको दशौँ दिनमा आफ्ना परिवारको लागि प्रत्येक घरानाअनुसार एउटा थुमा लिनुपर्छ भनी भन्।<verse eid="EXO 12:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 12:4"/>कुनै घराना एउटा थुमाको लागि एकदमै सानो छ भने तिनीहरूले मानिसहरूको संख्याको हिसाबले एउटा थुमा आफ्नो नजिकैको छिमेकीसित मिलेर खाऊन्। हरेक मानिसले कति खान सक्छ भन्‍ने हिसाबले थुमा कति चाहिन्छ भनी तैँले निर्णय गर्नू।<verse eid="EXO 12:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 12:5"/>तैँले रोज्नुपर्ने पशु खोटरहितको एकवर्षे पाठो हुनुपर्छ; अनि तैँले त्यो भेडा अथवा बाख्राबाट लिन सक्नेछस्।<verse eid="EXO 12:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 12:6"/>तिनीहरूलाई तिमीहरूले महिनाको चौधौँ दिनसम्म रेखदेख गर्नू, र इस्राएलको समुदायका सबै मानिसहरूले तिनीहरूलाई साँझपख मारून्।<verse eid="EXO 12:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 12:7"/>तब तिनीहरूले केही रगत लिएर जुन घरमा तिनीहरूले थुमा खान्छन्, त्यसका चौकसका दुई पट्टिका र माथिल्‍ला भागहरूमा लगाऊन्।<verse eid="EXO 12:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 12:8"/>त्यही रात तिनीहरूले त्यो मासु आगोमा पोलेर तितो सागसित र खमिर नमिसाइएको रोटीसित खाऊन्।<verse eid="EXO 12:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 12:9"/>त्यो मासु काँचो अथवा पानीमा पकाएर नखानू, तर त्यसलाई आगोमा पोल्नू—टाउको, खुट्टाहरू अनि भित्री भागहरू।<verse eid="EXO 12:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 12:10"/>त्यसको केही पनि भाग बिहानसम्म नराख्नू; बिहानसम्म केही रह्‍यो भने त्यसलाई जलाइदिनू।<verse eid="EXO 12:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 12:11"/>त्यसलाई तिमीहरूले यसरी खानू: तिमीहरूका पटुका कसेर, खुट्टामा जुत्ता लगाएर र तिमीहरूका लहुरो हातमा लिएर त्यसलाई हतार-हतार खानू; यो याहवेहको निस्तार चाड हो।<verse eid="EXO 12:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 12:12"/>“त्यही रात म इजिप्टबाट भएर जानेछु अनि मानिसहरू र पशुहरूका प्रत्येक जेठोमाथि प्रहार गर्नेछु, र इजिप्टका सबै देवी-देवताहरूमाथि न्याय ल्याउनेछु; म नै याहवेह हुँ।<verse eid="EXO 12:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 12:13"/>त्यो रगत तिमीहरू बसेका घरहरूमा चिन्ह हुनेछ; अनि जब म रगत देख्नेछु, तब म तिमीहरूलाई छोडेर जानेछु। मैले इजिप्टमाथि प्रहार गर्दा तिमीहरूलाई कुनै पनि नाश गर्ने विपत्तिले छुनेछैन।<verse eid="EXO 12:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 12:14"/>“यस दिनलाई तिमीहरूको स्मरणमा राख्नू; अनि आउने पुस्ताका निम्ति तिमीहरूले यसलाई याहवेहका चाडको हिसाबले मान्‍नू—यो सदाको निम्ति एउटा धार्मिक विधि हो।<verse eid="EXO 12:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 12:15"/>सात दिनसम्म तिमीहरूले खमिर नमिसाइएको रोटी खानू। पहिलो दिन आफ्ना घरहरूबाट खमिर निकाल्नू; किनकि जसले पहिलो दिनदेखि लिएर सातौँ दिनसम्म खमिर हालेको केही खान्छ, त्यो इस्राएलदेखि बहिष्कृत होस्।<verse eid="EXO 12:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 12:16"/>पहिलो दिन एउटा पवित्र सभा आयोजना गर, र अर्को सभा सातौँ दिनमा गर। प्रत्येकले खानलाई भोजन तयार गर्नुबाहेक यी सबै दिनहरूमा पटक्‍कै काम नगर्नू; भोजन बनाउने काम मात्र तिमीहरू गर्न सक्छौ।<verse eid="EXO 12:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 12:17"/>“अखमिरी रोटीको चाड मान्‍नू; किनकि यो त्यही दिन हो, जसमा मैले तिमीहरूका दलहरूलाई इजिप्टबाट ल्याएँ। यस दिनलाई भावी पुस्ताका लागि एउटा सदाको धार्मिक विधिस्वरूप मान्‍नू।<verse eid="EXO 12:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 12:18"/>पहिलो महिनाको चौधौँ दिनको साँझदेखि एक्‍काइसौँ दिनको साँझसम्म तिमीहरूले खमिर नमिसाइएको रोटी खानू।<verse eid="EXO 12:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 12:19"/>सात दिनसम्म तिमीहरूका घरहरूमा खमिर पटक्‍कै नपाइयोस्। अनि जसले खमिर मिसाएर केही कुरा खान्छ, त्यो परदेशी होस् वा स्वदेशमै जन्मेको होस्, त्यसलाई इस्राएलको समुदायबाट बहिष्कार गर्नू।<verse eid="EXO 12:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 12:20"/>खमिर मिसाएर केही कुरा पनि नखानू। तिमीहरू जहाँ बसे तापनि खमिर नमिसाइएको रोटी नै खानू।”<verse eid="EXO 12:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 12:21"/>तब मोशाले इस्राएलका सबै प्रधानहरूलाई बोलाएर तिनीहरूलाई भने, “झट्टै गएर तपाईंहरूका परिवारहरूका निम्ति पशुहरू रोज्नुहोस् र निस्तार चाडको पाठो मार्नुहोस्।<verse eid="EXO 12:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 12:22"/>हिसपको एउटा झुप्पा लिएर भाँडामा भएको रगतमा चोप्नुहोस्, र केही रगत चौकसका माथिल्‍लो र दुवैतिरका भागमा लगाउनुहोस्। बिहानसम्म आफ्नो घरदेखि कोही पनि बाहिर ननिस्कोस्।<verse eid="EXO 12:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 12:23"/>जब याहवेह इजिप्टियनहरूलाई प्रहार गर्नलाई यस देशबाट भएर जानुहुनेछ, तब उहाँले चौकसका माथिल्‍ला र दुई छेउका भागहरूमा रगत देख्नुहुनेछ; अनि उहाँले त्यस ढोकालाई नाघेर जानुहुनेछ, र विनाशकर्तालाई नाश गर्न तपाईंहरूका घरमा पस्‍न दिनुहुनेछैन।<verse eid="EXO 12:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 12:24"/>“यस निर्देशनलाई तपाईंहरू र तपाईंहरूका सन्तानका लागि एउटा सदाको धार्मिक नियमस्वरूप पालन गर्नू।<verse eid="EXO 12:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 12:25"/>जब तपाईंहरू याहवेहले प्रतिज्ञा गर्नुभएको देशमा प्रवेश गर्नुहुनेछ, यस उत्सवलाई मान्‍नू।<verse eid="EXO 12:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 12:26"/>अनि जब तपाईंहरूका छोराछोरीहरूले तपाईंहरूलाई ‘तपाईंहरूका निम्ति यस उत्सवको अर्थ के हो?’ भनी सोध्छन्,<verse eid="EXO 12:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 12:27"/>तब तपाईंहरूले भन्‍नू, ‘यो याहवेहको निम्ति निस्तारको बलिदान हो; उहाँले इजिप्टमा इस्राएलीहरूका घरहरूलाई छोड्नुभयो, र इजिप्टियनहरूलाई प्रहार गर्नुहुँदा हाम्रा परिवारहरूलाई जोगाइराख्नुभयो।’ ” तब मानिसहरूले शिर निहुराएर आराधना गरे।<verse eid="EXO 12:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 12:28"/>इस्राएलीहरूले याहवेहले मोशा र हारूनलाई आज्ञा गर्नुभएबमोजिम नै गरे।<verse eid="EXO 12:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 12:29"/>मध्यरातमा याहवेहले सिंहासनमा बस्‍ने फारोको जेठा छोरादेखि लिएर झ्यालखानामा भएको कैदीको जेठा छोरा, र सबै गाईबस्तुहरूका पहिले जन्मेकाहरू समेत, र इजिप्टका पहिले जन्मेकाहरू सबैलाई मार्नुभयो।<verse eid="EXO 12:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 12:30"/>फारो र तिनका सबै अधिकारीहरू र सारा इजिप्टियनहरू राति नै उठे, र इजिप्टमा ठूलो रुवाबासी चल्यो; किनकि त्यहाँ कोही नमरेको कुनै घर थिएन।<verse eid="EXO 12:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 12:31"/>रातको समयमा फारोले मोशा र हारूनलाई बोलाइपठाएर भने, “तिमीहरू र सारा इस्राएलीहरू उठ! अनि मेरा मानिसहरूलाई छोडिदेओ! जाओ, र तिमीहरूले बिन्ती गरेझैँ याहवेहको आराधना गर।<verse eid="EXO 12:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 12:32"/>तिमीहरूका बगाल र बथान पनि तिमीहरूले भनेझैँ लिएर जाओ; अनि मलाई पनि आशिष् देओ।”<verse eid="EXO 12:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 12:33"/>इजिप्टियनहरूले ती मानिसहरूलाई झट्टै देश छोडेर जान भनेर बिन्ती गरे। तिनीहरूले भने, “नत्रता हामी सबै मर्नेछौँ!”<verse eid="EXO 12:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 12:34"/>यसकारण मानिसहरूले आफ्ना मुछेको पिठो खमिर हाल्न अगि नै मुछ्ने भाँडामा लुगाले बेह्रेर आफ्ना काँधमा बोके।<verse eid="EXO 12:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 12:35"/>इस्राएलीहरूले मोशाले भनेझैँ गरे; अनि इजिप्टियनहरूबाट चाँदी र सुनका सामग्रीहरू अनि लुगाहरू मागे।<verse eid="EXO 12:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 12:36"/>याहवेहले मानिसहरूलाई इजिप्टियनहरूको निगाहमा राखिदिनुभयो; र तिनीहरूले उनीहरूले मागेका सबै कुराहरू दिइहाले; यसरी तिनीहरूले इजिप्टियनहरूलाई लुटे।<verse eid="EXO 12:36"/></para>
<para style="p"><verse number="37" style="v" sid="EXO 12:37"/>इस्राएलीहरूले रामसेसदेखि सुक्‍कोतसम्म यात्रा गरे। स्त्री र बालबालिकाहरू छोडेर, लगभग छ लाख पैदल हिँड्ने मानिसहरू थिए।<verse eid="EXO 12:37"/></para>
<para style="p"><verse number="38" style="v" sid="EXO 12:38"/>अरू धेरै मानिसहरूका साथसाथै बगाल र बथानसित गाईबस्तुको ठूलो हुल पनि तिनीहरूसित गए।<verse eid="EXO 12:38"/></para>
<para style="p"><verse number="39" style="v" sid="EXO 12:39"/>इजिप्टबाट ल्याएको मुछेको पिठोबाट तिनीहरूले अखमिरी रोटीहरू पकाए। त्यो मुछेको पिठो खमिररहित थियो; किनकि तिनीहरू इजिप्टबाट धपाइएका थिए, र तिनीहरूसित आफ्ना भोजन बनाउने समय पनि थिएन।<verse eid="EXO 12:39"/></para>
<para style="p"><verse number="40" style="v" sid="EXO 12:40"/>इस्राएलीहरू इजिप्टमा बसेको 430 वर्ष भइसकेको थियो।<verse eid="EXO 12:40"/></para>
<para style="p"><verse number="41" style="v" sid="EXO 12:41"/>430 वर्षको अन्त्यमा त्यही दिन याहवेहको सम्पूर्ण दलहरूले इजिप्ट छोडे।<verse eid="EXO 12:41"/></para>
<para style="p"><verse number="42" style="v" sid="EXO 12:42"/>तिनीहरूलाई इजिप्टबाट बाहिर निकाल्नलाई त्यस रात याहवेहले हेरचाह गर्नुभएको कारण सारा इस्राएलीहरू पनि भावी पुस्तामा याहवेहलाई सम्मान दिनको निम्ति त्यस रात जागा रहनुपर्छ।<verse eid="EXO 12:42"/></para>
<para style="p"><verse number="43" style="v" sid="EXO 12:43"/>याहवेहले मोशा र हारूनलाई भन्‍नुभयो, “निस्तार चाडका नियमहरू यिनै हुन्: “यसबाट कुनै विदेशीले खानुहुँदैन।<verse eid="EXO 12:43"/></para>
<para style="p"><verse number="44" style="v" sid="EXO 12:44"/>तिमीहरूले किनेका हरेक दासले तिमीहरूले त्यसलाई खतना गरिदिएपछि यसबाट खाओस्,<verse eid="EXO 12:44"/></para>
<para style="p"><verse number="45" style="v" sid="EXO 12:45"/>तर परदेशी र ज्यालादारी नोकरले यसबाट नखाओस्।<verse eid="EXO 12:45"/></para>
<para style="p"><verse number="46" style="v" sid="EXO 12:46"/>“त्यो एउटै घरभित्र खाइनुपर्छ; मासुबाट अलिकति पनि घरबाट बाहिर नलैजानू। त्यसको कुनै पनि हड्डी नभाँच्नू।<verse eid="EXO 12:46"/></para>
<para style="p"><verse number="47" style="v" sid="EXO 12:47"/>इस्राएलका सम्पूर्ण समुदायले त्यो उत्सव मनाउनुपर्छ।<verse eid="EXO 12:47"/></para>
<para style="p"><verse number="48" style="v" sid="EXO 12:48"/>“तिमीहरूसित बस्‍ने कुनै परदेशीले याहवेहको निस्तार चाडको उत्सव मनाउन चाहन्छ भने त्यसले आफ्ना परिवारका सबै पुरुषहरूको खतना गराउनुपर्छ; तब त्यसले स्वदेशमा जन्मेकाले झैँ त्यसमा भाग लिन सक्छ। खतना नभएको कुनै पुरुषले यसबाट खान पाउनेछैन।<verse eid="EXO 12:48"/></para>
<para style="p"><verse number="49" style="v" sid="EXO 12:49"/>तिमीहरूसित बस्‍ने स्वदेशी र विदेशीको लागि यही नियम लाग्नेछ।”<verse eid="EXO 12:49"/></para>
<para style="p"><verse number="50" style="v" sid="EXO 12:50"/>सारा इस्राएलीहरूले याहवेहले मोशा र हारूनलाई आज्ञा दिनुभएबमोजिम गरे।<verse eid="EXO 12:50"/></para>
<para style="p"><verse number="51" style="v" sid="EXO 12:51"/>अनि त्यही दिन याहवेहले इस्राएलीहरूलाई इजिप्टबाट तिनीहरूका दलअनुसार बाहिर निकालेर ल्याउनुभयो।<verse eid="EXO 12:51"/></para>
<chapter eid="EXO 12"/>
<chapter number="13" style="c" sid="EXO 13"/>
<para style="p"><verse number="1" style="v" sid="EXO 13:1"/>याहवेहले मोशालाई भन्‍नुभयो,<verse eid="EXO 13:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 13:2"/>“पहिले जन्मेका प्रत्येक पुरुषलाई मेरा निम्ति अर्पण गर। इस्राएलीहरूबीच गर्भको हरेक पहिलो फल मेरो हो—चाहे त्यो मानिस होस् वा पशु।”<verse eid="EXO 13:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 13:3"/>तब मोशाले मानिसहरूलाई भने, “यस दिनलाई सम्झना गर, जुन दिन तिमीहरू इजिप्टबाट, दासत्वको देशबाट निस्केर आयौ; किनकि याहवेहले तिमीहरूलाई शक्तिशाली हातले त्यहाँबाट बाहिर निकालेर ल्याउनुभयो। खमिर भएको कुनै कुरा नखाओ।<verse eid="EXO 13:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 13:4"/>आज आबीब महिनामा तिमीहरू निस्कँदैछौ।<verse eid="EXO 13:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 13:5"/>जब याहवेहले तिमीहरूलाई कनानीहरू, हित्तीहरू, एमोरीहरू, हिव्वीहरू र यबूसीहरूको देश—उहाँले तिमीहरूका पितापुर्खाहरूलाई दिनेछु भनेर शपथ खानुभएको दूध र मह बग्ने देशमा ल्याउनुहुनेछ, तब तिमीहरूले यही महिनामा यो उत्सव मनाउनुपर्छः<verse eid="EXO 13:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 13:6"/>सात दिनसम्म खमिर नमिसाइएको रोटी खानू र सातौँ दिनमा याहवेहका निम्ति चाड मनाउनू।<verse eid="EXO 13:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 13:7"/>ती सात दिनहरूमा अखमिरी रोटी खानू; तिमीहरूका साँधसिमानाभित्र खमिर भएका चीज र खमिर देखिनुहुँदैन।<verse eid="EXO 13:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 13:8"/>त्यस दिन तिमीहरूले आफ्ना छोरालाई भन्‍नू, ‘म इजिप्टबाट निस्केर आउँदा याहवेहले मेरो लागि जे गर्नुभयो, त्यसका लागि म यो गर्छु।’<verse eid="EXO 13:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 13:9"/>याहवेहको व्यवस्था तिमीहरूका ओठमा रहोस् भनी यो रीति तिमीहरूको हातमा एउटा चिन्हस्वरूप र तिमीहरूका निधारमा एउटा सम्झना दिलाउने कुरो हुनेछ; किनकि याहवेहले तिमीहरूलाई इजिप्टबाट उहाँको शक्तिशाली हातले निकालेर ल्याउनुभयो।<verse eid="EXO 13:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 13:10"/>तिमीहरूले यो रीति वर्षैपिच्छे तोकिएको समयमा पालन गर्नुपर्छ।<verse eid="EXO 13:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 13:11"/>“उहाँले तिमीहरू र तिमीहरूका पितापुर्खाहरूसित शपथद्वारा प्रतिज्ञा गर्नुभएझैँ याहवेहले तिमीहरूलाई कनानीहरूको देशमा ल्याएर त्यो तिमीहरूलाई दिनुभएपछि,<verse eid="EXO 13:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 13:12"/>तिमीहरूले प्रत्येक गर्भको पहिलो फल याहवेहलाई दिनुपर्छ। तिमीहरूका पशुहरूका पहिले जन्मेका सबै नरहरू याहवेहकै हुन्।<verse eid="EXO 13:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 13:13"/>पहिले जन्मेको गधालाई एउटा पाठो दिएर छुटाउनू, तर तिमीहरूले त्यसलाई छुटाएनौ भने त्यसको घाँटी भाँचिदिनू। तिमीहरूका छोराहरूमध्ये जेठालाई छुटाउनू।<verse eid="EXO 13:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 13:14"/>“भविष्यमा जब तिमीहरूका छोराले ‘यसको अर्थ के हो?’ भनी सोध्नेछ, तब त्यसलाई भन्‍नू, ‘याहवेहले हामीलाई शक्तिशाली हातले दासत्वको देश इजिप्टबाट निकालेर ल्याउनुभयो।<verse eid="EXO 13:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 13:15"/>जब फारोले हठी भएर हामीलाई जान दिएनन्, याहवेहले इजिप्टमा मानिस र पशुबाट प्रथम जन्मेका हरेकलाई मार्नुभयो। यसैकारण म प्रत्येक गर्भको प्रथम नरलाई याहवेहका निम्ति बलिदान चढाउँछु, र मेरा पहिला जन्मेका प्रत्येक छोरालाई छुटाउँछु।’<verse eid="EXO 13:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 13:16"/>अनि याहवेहले हामीलाई इजिप्टबाट शक्तिशाली हातले निकालेर ल्याउनुभयो भन्‍ने यो तिमीहरूका हातमा चिन्हस्वरूप र निधारमा सङ्केतस्वरूप हुनेछ।”<verse eid="EXO 13:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 13:17"/>जब फारोले ती मानिसहरूलाई जान दिए, याहवेहले तिनीहरूलाई पलिश्तीहरूको देश भएर डोर्‍याउनुभएन; यद्यपि त्यो छोटो थियो। किनकि परमेश्‍वरले भन्‍नुभयो, “तिनीहरूले युद्धको सामना गर्नुपर्‍यो भने तिनीहरूले आफ्ना मन परिवर्तन गरेर इजिप्टतिरै फर्कन सक्छन्।”<verse eid="EXO 13:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 13:18"/>यसकारण परमेश्‍वरले मानिसहरूलाई घुमाएर लाल समुद्रतिर जाने उजाडस्थानको बाटोमा डोर्‍याउनुभयो। इस्राएलीहरू इजिप्टबाट लडाइँको लागि तयारी भएर निस्के।<verse eid="EXO 13:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 13:19"/>मोशाले आफूसित योसेफको अस्थि लगे; किनकि योसेफले इस्राएलका छोराहरूलाई शपथ खान लाएका थिए। तिनले भनेका थिए, “परमेश्‍वर निश्‍चय नै तिमीहरूको सहायताका निम्ति आउनुहुनेछ, र तिमीहरूले मेरो अस्थि यस ठाउँबाट आफूसित लैजानुपर्छ।”<verse eid="EXO 13:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 13:20"/>सुक्‍कोत छोडेपछि तिनीहरू उजाडस्थानको नजिकै एथाममा पाल टाँगेर बसे।<verse eid="EXO 13:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 13:21"/>तिनीहरू दिन र रात यात्रा गर्न सकून् भनेर दिउँसो याहवेह तिनीहरूलाई बाटोमा डोर्‍याउनलाई बादलको खामोमा र राति तिनीहरूलाई प्रकाश दिनलाई आगोको खामोमा तिनीहरूका अगि-अगि जानुभयो।<verse eid="EXO 13:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 13:22"/>न त दिउँसो बादलको खामोले, न त राति आगोको खामोले मानिसहरूका अगि-अगि जान कहिल्यै छोड्यो।<verse eid="EXO 13:22"/></para>
<chapter eid="EXO 13"/>
<chapter number="14" style="c" sid="EXO 14"/>
<para style="p"><verse number="1" style="v" sid="EXO 14:1"/>तब याहवेहले मोशालाई भन्‍नुभयो,<verse eid="EXO 14:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 14:2"/>“इस्राएलीहरूलाई पछि फर्केर मिग्दोल र समुद्रको बीचमा पी-हहीरोतको छेउमा पाल टाँगेर बस्‍नू भन्। तिनीहरू बाल-सेफोनको ठिक विपरीत समुद्रनिर डेरा हालेर बसून्।<verse eid="EXO 14:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 14:3"/>फारोले विचार गर्नेछ, ‘इस्राएलीहरू त उजाडस्थानमा थुनिएर अलमलमा परी देशमा भौँतारिरहेका छन्।’<verse eid="EXO 14:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 14:4"/>अनि म फारोको हृदय कठोर पार्नेछु, र त्यसले तिनीहरूलाई खेद्नेछ। तर म फारो र त्यसका सेनाद्वारा आफ्नो महिमा लिनेछु, र इजिप्टियनहरूले म नै याहवेह हुँ भनी जान्‍नेछन्।” यसकारण इस्राएलीहरूले त्यसै गरे।<verse eid="EXO 14:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 14:5"/>जब इजिप्टका राजालाई ती मानिसहरू भागे भनी बताइयो, फारो अनि तिनका अधिकारीहरूले तिनीहरूको विषयमा आफ्ना मन बदली गरे, र भने, “हामीले यो के गर्‍यौँ? हामीले इस्राएलीहरूलाई जान दिएर तिनीहरूको सेवा गुमायौँ!”<verse eid="EXO 14:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 14:6"/>यसकारण तिनले आफ्नो रथ तयार गराए, र आफ्नो सेना आफूसित लिए।<verse eid="EXO 14:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 14:7"/>तिनले आफ्ना उत्तम रथहरूमध्ये छ सय वटा लिए, र साथमा इजिप्टका अरू सबै रथहरूमाथि पदाधिकारीहरू सवार गराए।<verse eid="EXO 14:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 14:8"/>याहवेहले इजिप्टका राजा फारोको हृदय कठोर पारिदिनुभयो, र तिनले साहससित अगि बढिरहेका इस्राएलीहरूलाई खेदे।<verse eid="EXO 14:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 14:9"/>इजिप्टियनहरू—फारोका सबै घोडाहरू, रथहरू, घोडसवारहरू र सेनाले—इस्राएलीहरूलाई खेदे, र बाल-सेफोनको विपरीत पी-हहीरोतको नजिक समुद्रनिर डेरा हालेर बसेको बेलामा तिनीहरूलाई भेटे।<verse eid="EXO 14:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 14:10"/>फारो नजिक आइपुग्दा इस्राएलीहरूले आँखा उठाएर हेरे, र इजिप्टियनहरूलाई तिनीहरूको पछि आइरहेका देखे। तिनीहरू साह्रै डराए; अनि याहवेहलाई पुकार गरे।<verse eid="EXO 14:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 14:11"/>तिनीहरूले मोशालाई भने, “के इजिप्टमा चिहानहरू थिएनन् र तपाईंले हामीलाई यस उजाडस्थानमा मर्न भनी ल्याउनुभयो? हामीलाई इजिप्टबाट यहाँ ल्याएर तपाईंले यो के गर्नुभएको?<verse eid="EXO 14:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 14:12"/>के हामीले इजिप्टमा तपाईंलाई ‘हामीलाई त्यसै छोडिदिनुहोस्; हामीलाई इजिप्टियनहरूको सेवा गर्न दिनुहोस्’ भनेका थिएनौँ र? यस उजाडस्थानमा मर्नुभन्दा त हामीलाई इजिप्टियनहरूको सेवा गर्नु असल हुनेथियो।”<verse eid="EXO 14:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 14:13"/>मोशाले मानिसहरूलाई जवाफ दिए, “नडराओ, दृढतासाथ खडा रहो। आज याहवेहले तिमीहरूमा ल्याउनुहुने छुटकारा तिमीहरूले देख्नेछौ। तिमीहरूले आज देखेका इजिप्टियनहरूलाई फेरि कहिल्यै देख्नेछैनौ।<verse eid="EXO 14:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 14:14"/>याहवेहले तिमीहरूका पक्षमा युद्ध गर्नुहुनेछ; तिमीहरू केवल शान्त होऊ।”<verse eid="EXO 14:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 14:15"/>तब याहवेहले मोशालाई भन्‍नुभयो, “तिमीहरू किन मेरो पुकार गर्छौ? इस्राएलीहरूलाई अगि बढ्नू भन्।<verse eid="EXO 14:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 14:16"/>तेरो लहुरो उठा, र इस्राएलीहरू समुद्र भएर ओबानो जमिनबाट जाऊन् भनेर पानी दुई भाग गर्नलाई तेरो हात पसार्।<verse eid="EXO 14:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 14:17"/>म इजिप्टियनहरूको हृदय कठोर पारिदिनेछु, र तिनीहरू उनीहरूको पछि-पछि समुद्रभित्र जानेछन्। अनि म फारो र त्यसका सेनाद्वारा, त्यसका रथहरू र त्यसका घोडसवारहरूद्वारा महिमित हुनेछु।<verse eid="EXO 14:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 14:18"/>जब फारो, त्यसका रथहरू र त्यसका घोडसवारहरूद्वारा मेरो महिमा हुनेछ, तब इजिप्टियनहरूले म नै याहवेह हुँ भनी जान्‍नेछन्।”<verse eid="EXO 14:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 14:19"/>त्यसपछि इस्राएली सेनाको अगि-अगि यात्रा गरिरहेका परमेश्‍वरका स्वर्गदूत पछि सरेर तिनीहरूका पछिल्तिर गए। बादलको खामो पनि अगिल्तिरबाट सरेर तिनीहरूका पछिल्तिर उभियो;<verse eid="EXO 14:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 14:20"/>अनि इजिप्ट र इस्राएलीहरूका सेनाका बीचमा आयो। रातभरि त्यस बादलले एकातिर अँध्यारो र अर्कोतिर उज्यालो ल्यायो। यसकारण रातभरि एकपट्टिको मानिस अर्कोपट्टि गएन।<verse eid="EXO 14:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 14:21"/>तब मोशाले समुद्रमाथि आफ्ना हात पसारे; अनि याहवेहले रातभरि शक्तिशाली पूर्वीय बतास चलाएर समुद्रलाई पछिल्तिर ठेलिदिनुभयो, र त्यसलाई ओबानो जमिनमा परिणत गरिदिनुभयो। पानी दुई भाग भयो,<verse eid="EXO 14:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 14:22"/>अनि इस्राएलीहरू समुद्रबीच ओबानो जमिनबाट भएर गए; तिनीहरूका दाहिने र देब्रेतिर पानीको पर्खाल खडा भयो।<verse eid="EXO 14:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 14:23"/>ती इजिप्टियनहरूले तिनीहरूलाई खेदे, र फारोका सबै घोडाहरू, रथहरू र घोडसवारहरूले तिनीहरूलाई समुद्रमा पछ्याए।<verse eid="EXO 14:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 14:24"/>मिरमिरे बिहानी याहवेहले आगो र बादलको खामोबाट इजिप्टका सेनालाई तल हेर्नुभयो र तिनीहरूलाई अलमल पारिदिनुभयो।<verse eid="EXO 14:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 14:25"/>उहाँले तिनीहरूका रथहरूका चक्‍काहरू फुस्काइदिनुभयो, र तिनीहरूलाई कुदाउन कठिन पर्‍यो। अनि इजिप्टियनहरूले भने, “हामी इस्राएलीहरूदेखि भागौँ! याहवेह तिनीहरूको पक्षमा भई हाम्रो विरुद्धमा युद्ध गर्दै हुनुहुन्छ।”<verse eid="EXO 14:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 14:26"/>तब याहवेहले मोशालाई भन्‍नुभयो, “पानी फेरि इजिप्टियनहरू, तिनीहरूका रथहरू र घोडसवारहरूमाथि पछिल्तिर फर्केर ओइरियोस् भनेर तेरो हात समुद्रमाथि पसार्।”<verse eid="EXO 14:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 14:27"/>मोशाले आफ्ना हात समुद्रमाथि पसारे, र बिहान समुद्र फेरि आफ्नो ठाउँमा सर्‍यो। इजिप्टियनहरू यसको विपरीत भाग्दैथिए; अनि याहवेहले तिनीहरूलाई सोहोरेर समुद्रमा हालिदिनुभयो।<verse eid="EXO 14:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 14:28"/>पानी फर्केर आयो, र इस्राएलीहरूलाई समुद्रमा पछिबाट लखेट्ने रथहरू र घोडसवारहरू, फारोका सम्पूर्ण सेनालाई ढाकिदियो। तिनीहरूमध्ये एउटै पनि बाँचेनन्।<verse eid="EXO 14:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 14:29"/>तर इस्राएलीहरू त तिनीहरूका दाहिने र देब्रेतिर पानीका पर्खाल भएकाले समुद्रबाट ओबानो जमिन भएर गए।<verse eid="EXO 14:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 14:30"/>त्यस दिन याहवेहले इस्राएलीहरूलाई इजिप्टियनहरूको हातबाट बचाउनुभयो; अनि इस्राएलीहरूले इजिप्टियनहरूलाई किनारमा मरेर पस्रिरहेका देखे।<verse eid="EXO 14:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 14:31"/>जब याहवेहले इजिप्टियनहरूको विरुद्धमा महान् शक्ति देखाउनुभएको इस्राएलीहरूले देखे, तब मानिसहरू याहवेहसित डराए र आफ्नो भरोसा याहवेह र उहाँका सेवक मोशामाथि राखे।<verse eid="EXO 14:31"/></para>
<chapter eid="EXO 14"/>
<chapter number="15" style="c" sid="EXO 15"/>
<para style="p"><verse number="1" style="v" sid="EXO 15:1"/>तब मोशा र इस्राएलीहरूले याहवेहका निम्ति यो गीत गाए: “म याहवेहको निम्ति गाउनेछु; किनकि उहाँ अति नै उच्‍च पारिनुभएको छ। घोडा र त्यसको सवारलाई उहाँले समुद्रमा फालिदिनुभएको छ।<verse eid="EXO 15:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 15:2"/>“याहवेह नै मेरो बल, सुरक्षा र गीत हुनुहुन्छ; उहाँ मेरा मुक्ति हुनुभएको छ। उहाँ मेरा परमेश्‍वर हुनुहुन्छ, र म उहाँको प्रशंसा गर्नेछु; मेरा पिताका परमेश्‍वर, र म उहाँको नामलाई उच्‍च पार्नेछु।”<verse eid="EXO 15:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 15:3"/>याहवेह योद्धा हुनुहुन्छ; उहाँको नाम याहवेह हो।<verse eid="EXO 15:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 15:4"/>फारोका रथहरू र तिनका सेनालाई उहाँले समुद्रमा फालिदिनुभएको छ। फारोका सर्वोत्तम पदाधिकारीहरू लाल समुद्रमा डुबाइएका छन्।<verse eid="EXO 15:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 15:5"/>गहिरा पानीले तिनीहरूलाई छोपिदिएका छन्; तिनीहरू ढुङ्गाझैँ गहिराइमा डुबेका छन्।<verse eid="EXO 15:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 15:6"/>हे याहवेह, तपाईंको दाहिने हात, शक्तिमा गौरवशाली थियो। हे याहवेह, तपाईंको दाहिने हातले, शत्रुलाई चकनाचुर पारेको छ।<verse eid="EXO 15:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 15:7"/>“तपाईंका गौरवको महानतामा तपाईंले विरोधीहरूलाई फ्याँकिदिनुभएको छ। तपाईंले आफ्नो क्रोधको ज्वाला पोख्नुभयो; जसले तिनीहरूलाई परालझैँ भस्म पार्‍यो।<verse eid="EXO 15:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 15:8"/>तपाईंका नाकको सासको वेगले पानी एक ठाउँमा थुप्रो लाग्यो, तरङ्गले भरिएका पानीहरू दृढ पर्खालझैँ खडा भए; गहिरो पानी समुद्रको गहिराइमा जमिहाल्यो।<verse eid="EXO 15:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 15:9"/>शत्रुले घमण्ड गर्‍यो, ‘म तिनीहरूलाई खेद्नेछु, म तिनीहरूलाई भेट्नेछु। म लुटिएका सामानहरू बाँड्नेछु; म तिनीहरूलाई निल्नेछु। म आफ्नो तरवार थुत्नेछु, र मेरो हातले तिनीहरूलाई नाश पार्नेछु।’<verse eid="EXO 15:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 15:10"/>तर तपाईंले आफ्नो सास फुक्नुभयो; र समुद्रले तिनीहरूलाई ढाकिहाल्यो। तिनीहरू शक्तिशाली पानीमा सिसाझैँ डुबे।<verse eid="EXO 15:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 15:11"/>हे याहवेह, देवी-देवताहरूमा तपाईंजस्तो को छ र? पवित्रतामा अति गौरवशाली, महिमामा भययोग्य, र अद्‌भुत कार्यहरू गर्नुहुने अरू को छ र?<verse eid="EXO 15:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 15:12"/>“तपाईंले आफ्नो दाहिने हात पसार्नुभयो; अनि पृथ्वीले हाम्रा शत्रुहरूलाई निलिहाल्यो।<verse eid="EXO 15:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 15:13"/>तपाईंले आफ्नो अचुक प्रेममा, आफूले छुटाउनुभएका मानिसहरूलाई डोर्‍याउनुहुनेछ। तपाईंको शक्तिमा तपाईंले तिनीहरूलाई आफ्नो पवित्र वासस्थानमा अगुवाइ गर्नुहुनेछ।<verse eid="EXO 15:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 15:14"/>जातिहरूले सुन्‍नेछन् र काँप्नेछन्; पलिश्तीहरूलाई वेदनाले पक्रनेछ।<verse eid="EXO 15:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 15:15"/>एदोमका अगुवाहरू भयभीत हुनेछन्; मोआबका शक्तिशाली अगुवाहरू काँप्नेछन्; कनानका सारा मानिसहरू बिलाइजानेछन्;<verse eid="EXO 15:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 15:16"/>उनीहरूलाई आतङ्क र डरले छोप्नेछ। हे याहवेह, तपाईंका प्रजा पार नहोउन्जेल, तपाईंले किन्‍नुभएका यी प्रजा पार नहोउन्जेल— तपाईंका पाखुराको शक्तिले उनीहरू पत्थरझैँ अचल हुनेछन्।<verse eid="EXO 15:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 15:17"/>तपाईंले तिनीहरूलाई भित्र ल्याउनुहुनेछ र तपाईंको आफ्नो उत्तराधिकारको पर्वतमा रोप्नुहुनेछ— हे याहवेह, त्यो ठाउँ, जसलाई तपाईंले आफ्नो लागि वासस्थान बनाउनुभएको छ; त्यो समागम पालमा, हे प्रभु, जसलाई तपाईंका हातहरूले स्थापित गर्नुभएको छ।<verse eid="EXO 15:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 15:18"/>“याहवेहले सदासर्वदा राज्य गर्नुहुन्छ।”<verse eid="EXO 15:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 15:19"/>जब फारोका घोडा, रथ र घोडसवारहरू समुद्रभित्र पसे, तब याहवेहले समुद्रको पानी फर्काएर तिनीहरूमाथि ल्याइदिनुभयो; तर इस्राएलीहरू त समुद्रको बीचबाट ओबानो जमिनमाथि हिँडे।<verse eid="EXO 15:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 15:20"/>तब हारूनकी दिदी अगमवादिनी मिरियमले आफ्नो हातमा एउटा खैँजडी लिइन्; अनि अरू स्त्रीहरू पनि खैँजडी लिएर नाच्दै तिनको पछि-पछि लागे।<verse eid="EXO 15:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 15:21"/>मिरियमले यसरी गीत गाउन थालिन्: “याहवेहका निम्ति गाओ; किनकि उहाँ अति उच्‍च पारिनुभएको छ। घोडा र त्यसको सवार दुवैलाई उहाँले समुद्रमा फालिदिनुभएको छ।”<verse eid="EXO 15:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 15:22"/>तब मोशाले इस्राएललाई लाल समुद्रबाट लगे, र तिनीहरू शूरको उजाडस्‍थानभित्र पसे। तीन दिनसम्म तिनीहरू उजाडस्थानमा पिउने पानीविना यात्रा गरे।<verse eid="EXO 15:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 15:23"/>जब तिनीहरू मारा आइपुगे, तिनीहरूले त्यहाँको पानी पिउन सकेनन्; किनकि त्यो तितो थियो। (त्यसैकारण त्यस ठाउँलाई मारा भनिन्छ।)<verse eid="EXO 15:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 15:24"/>यसकारण मानिसहरू मोशाको विरुद्धमा यसो भन्दै गनगन गर्न थाले, “हामीले के पिऔँ?”<verse eid="EXO 15:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 15:25"/>तब मोशाले याहवेहलाई पुकारे; अनि याहवेहले तिनलाई एउटा काठको टुक्रा देखाउनुभयो। जब तिनले त्यसलाई पानीमा फाले, तब त्यो पानी मिठो भयो। त्यहाँ याहवेहले तिनीहरूका निम्ति एउटा नियम र निर्देशन बनाउनुभयो; अनि त्यहीँ नै उहाँले तिनीहरूको जाँच लिनुभयो।<verse eid="EXO 15:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 15:26"/>उहाँले भन्‍नुभयो, “तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको कुरा ध्यानसित सुन्यौँ र उहाँको दृष्‍टिमा जे ठिक छ, त्यही गर्‍यौ, र तिमीहरूले उहाँका आज्ञाहरूमा ध्यान दियौ, र उहाँका सबै उर्दीहरू पालन गर्‍यौ भने मैले इजिप्टियनहरूमाथि ल्याएका रोगहरू म तिमीहरूमाथि ल्याउनेछैनँ; किनकि तिमीहरूलाई निको पार्ने याहवेह म नै हुँ।”<verse eid="EXO 15:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 15:27"/>त्यसपछि तिनीहरू एलीममा आइपुगे, जहाँ बाह्र वटा पानीका मूल र सत्तरी वटा खजूरका रूखहरू थिए। तिनीहरूले त्यहीँ पानीको नजिक पाल टाँगे।<verse eid="EXO 15:27"/></para>
<chapter eid="EXO 15"/>
<chapter number="16" style="c" sid="EXO 16"/>
<para style="p"><verse number="1" style="v" sid="EXO 16:1"/>इस्राएलीहरूका सारा समुदाय एलीमबाट हिँडे, र सीनैको उजाडस्थानमा आइपुगे। यो एलीम र सीनैको बीचमा थियो। तिनीहरू इजिप्टबाट निस्केर आएको दोस्रो महिनाको पन्ध्रौँ दिन भइसकेको थियो।<verse eid="EXO 16:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 16:2"/>त्यस उजाडस्थानमा सारा इस्राएलीहरू मोशा र हारूनको विरुद्धमा गनगनाए।<verse eid="EXO 16:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 16:3"/>इस्राएलीहरूले तिनीहरूलाई भने, “हामी इजिप्टमै याहवेहका हातद्वारा मरेका भए असल हुनेथियो! त्यस ठाउँमा छँदा हामी मासुका भाँडाको वरिपरि बस्थ्यौँ, र हामीले अघाउन्जेल भोजन खान्थ्यौँ; तर तपाईंले हामीलाई निकालेर यस उजाडस्थानमा यो सारा समुदायलाई भोकभोकै मार्न ल्याउनुभएको छ।”<verse eid="EXO 16:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 16:4"/>तब याहवेहले मोशालाई भन्‍नुभयो, “म तिमीहरूका लागि स्वर्गबाट रोटी बर्साउनेछु। यी मानिसहरू हरेक दिन बाहिर जाऊन्, र त्यस दिनको भाग बटुलून्; ताकि तिनीहरूले मेरा आज्ञाहरू मान्छन् कि मान्दैनन् भनी म तिनीहरूलाई जाँच्न सकूँ।<verse eid="EXO 16:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 16:5"/>छैटौँ दिनमा तिनीहरूले जे भित्र ल्याउनेछन्, त्यसलाई तयार पारून्; र त्यो अरू दिन बटुलेको भन्दा दोबर होस्।”<verse eid="EXO 16:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 16:6"/>यसकारण मोशा र हारूनले सारा इस्राएलीहरूलाई भने, “याहवेहले नै तिमीहरूलाई इजिप्टबाट निकालेर ल्याउनुभएको हो भनी तिमीहरूले बेलुकीपख जान्‍नेछौ।<verse eid="EXO 16:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 16:7"/>अनि बिहान तिमीहरूले याहवेहको महिमा देख्नेछौ; किनकि तिमीहरूले उहाँको विरुद्धमा गनगनाएको उहाँले सुन्‍नुभएको छ। हामी को हौँ, र तिमीहरू हाम्रो विरुद्धमा गनगनाउँछौ?”<verse eid="EXO 16:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 16:8"/>मोशाले यो पनि भने, “जब याहवेहले तिमीहरूलाई बेलुकी खानलाई मासु र बिहानीपख चाहेजति रोटी दिनुहुनेछ, तब त्यसलाई दिनुहुने याहवेह नै हुनुहुन्छ भनी तिमीहरूले जान्‍नेछौ; किनकि तिमीहरूले उहाँको विरुद्धमा गनगनाएको उहाँले सुन्‍नुभएको छ। हामी को हौँ र? तिमीहरू हाम्रो विरुद्धमा होइन, तर परमेश्‍वरको विरुद्धमा गनगनाइरहेका छौ।”<verse eid="EXO 16:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 16:9"/>तब मोशाले हारूनलाई भने, “इस्राएलका सारा समुदायलाई भन्‍नुहोस्, ‘याहवेहको सामु आओ; किनकि उहाँले तिमीहरूको गनगन सुन्‍नुभएको छ।’ ”<verse eid="EXO 16:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 16:10"/>हारून सारा इस्राएली समुदायसित बोल्दैगर्दा तिनीहरूले उजाडस्थानतिर हेरे; अनि त्यहाँ याहवेहको महिमा बादलमा देखा पर्‍यो।<verse eid="EXO 16:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 16:11"/>याहवेहले मोशालाई भन्‍नुभयो,<verse eid="EXO 16:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 16:12"/>“मैले इस्राएलीहरूको गनगन सुनेको छु। तिनीहरूलाई भन्, ‘बेलुकी तिमीहरूले मासु खानेछौ र बिहानचाहिँ तिमीहरू रोटीले अघाउनेछौ। तब म नै याहवेह तिमीहरूका परमेश्‍वर हुँ भनी तिमीहरूले जान्‍नेछौ।’ ”<verse eid="EXO 16:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 16:13"/>त्यस बेलुकी बट्टाई चराहरू आएर छाउनी नै ढाकिदिए; अनि बिहानचाहिँ छाउनीका चारैतिर शीत पर्‍यो।<verse eid="EXO 16:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 16:14"/>शीत सुकेपछि उजाडस्थानभरि मसिना डल्‍लाहरू, तुसारोजस्ता चीजहरू देखा परे।<verse eid="EXO 16:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 16:15"/>जब इस्राएलीहरूले त्यो देखे, तब तिनीहरूले आपसमा भने, “यो के हो?” किनकि त्यो के थियो, तिनीहरूलाई थाहा थिएन। अनि मोशाले तिनीहरूलाई भने, “यो याहवेहले तिमीहरूलाई खान भनी दिनुभएको रोटी हो।<verse eid="EXO 16:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 16:16"/>याहवेहले यसो भनी आज्ञा दिनुभएको छ: ‘हरेकले आफूलाई चाहिए जति बटुल्नू। तिमीहरूसित पालभित्र भएका हरेक व्यक्तिको निम्ति एक ओमेर लिनू।’ ”<verse eid="EXO 16:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 16:17"/>मोशाले भनेझैँ इस्राएलीहरूले गरे; अनि कतिले धेरै, कतिले थोरै बटुले।<verse eid="EXO 16:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 16:18"/>जब तिनीहरूले त्यसलाई ओमेरले नापे, तब धेरै बटुल्नेको ज्यादा भएन, र थोरै बटुल्नेको पनि कम्ती भएन। तिनीहरू हरेकले आफूलाई जति चाहिन्छ, त्यति नै बटुले।<verse eid="EXO 16:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 16:19"/>मोशाले तिनीहरूलाई भने, “कसैले पनि यसबाट बाँकी भाग बिहानसम्म नराख्नू।”<verse eid="EXO 16:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 16:20"/>तैपनि कसै-कसैले मोशाको कुरामा ध्यान दिएनन्; र त्यसबाट केही भाग बिहानसम्म राखे। तर त्यसमा किरा पर्‍यो, र गनाउन थाल्यो। यसकारण मोशा तिनीहरूसित क्रोधित भए।<verse eid="EXO 16:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 16:21"/>प्रत्येक बिहान हरेकले आफूलाई चाहिने जति बटुल्थे; अनि घाम छिप्पिएपछि त्यो पग्लिहाल्थ्यो।<verse eid="EXO 16:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 16:22"/>छैटौँ दिनमा भने तिनीहरूले दोबर अर्थात् हरेकका लागि दुई ओमेर बटुले; अनि समुदायका अगुवाहरूले यो कुरा मोशालाई बताइदिए।<verse eid="EXO 16:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 16:23"/>तब तिनले उनीहरूलाई भने, “याहवेहले यसो भनी आज्ञा गर्नुभएको छ: ‘भोलि याहवेहका निम्ति शब्बाथको विश्रामदिन, पवित्र शब्बाथ हुनुपर्छ। तिमीहरू जे पकाउन चाहन्छौ, त्यो पकाओ; अनि जे उमाल्न चाहन्छौ, उमाल; अनि जे उब्रिन्छ, त्यो बिहानसम्म राखिछोड।’ ”<verse eid="EXO 16:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 16:24"/>यसकारण मोशाले भनेझैँ तिनीहरूले त्यसलाई बिहानसम्म राखे; र त्यो गनाएन, र त्यसमा किरा पनि परेन।<verse eid="EXO 16:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 16:25"/>तब मोशाले भने, “त्यो खानेकुरा आज खाऊ; किनकि आज याहवेहका निम्ति शब्बाथ हो। तिमीहरूले आज जमिनमा त्यसको केही भाग पनि पाउनेछैनौ।<verse eid="EXO 16:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 16:26"/>छ दिन तिमीहरूले त्यसलाई बटुल्नू, तर सातौँ दिन, अर्थात् शब्बाथमा चाहिँ केही पनि हुनेछैन।”<verse eid="EXO 16:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 16:27"/>तैपनि केही मानिसहरू ती बटुल्नलाई सातौँ दिनमा बाहिर गए, तर तिनीहरूले केही भेटेनन्।<verse eid="EXO 16:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 16:28"/>तब याहवेहले मोशालाई भन्‍नुभयो, “कहिलेसम्म तिमीहरू मेरा आज्ञा र अर्तीहरू पालन गर्न अस्वीकार गर्छौ?<verse eid="EXO 16:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 16:29"/>यो कुरा मनमा राख: याहवेहले तिमीहरूका निम्ति शब्बाथ दिनुभएको छ; यसैकारण छैटौँ दिनमा उहाँले तिमीहरूलाई दुई दिनका लागि रोटी दिनुभएको छ। सातौँ दिन तिमीहरू हरेक आ-आफ्नै ठाउँमा बस्‍नू; कोही बाहिर नजानू।”<verse eid="EXO 16:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 16:30"/>यसकारण मानिसहरूले सातौँ दिनमा विश्राम गरे।<verse eid="EXO 16:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 16:31"/>अनि इस्राएलका मानिसहरूले त्यस रोटीलाई मन्‍न भनी भने। त्यो धनियाँको बिउजस्तो सेतो देखिन्थ्यो; अनि स्वादचाहिँ मह मिसाएर बनाएको बाबरजस्तो थियो।<verse eid="EXO 16:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 16:32"/>मोशाले भने, “याहवेहले यसो भनी आज्ञा दिनुभएको छ: ‘मैले तिमीहरूलाई इजिप्टबाट निकालेर ल्याउँदा उजाडस्थानमा तिमीहरूलाई कस्तो रोटी खुवाएको थिएँ भनेर पछिका पुस्ताहरूलाई देखाउन भनी एक ओमेर मन्‍न जोगाएर राख्नू।’ ”<verse eid="EXO 16:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 16:33"/>यसकारण मोशाले हारूनलाई भने, “एउटा भाँडो लिएर त्यसमा एक ओमेर मन्‍न भर्नुहोस्, र त्यसलाई पछि आउने पुस्तौँ-पुस्तासम्म रहोस् भनेर याहवेहको सामु राख्नुहोस्।”<verse eid="EXO 16:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 16:34"/>याहवेहले मोशालाई आज्ञा गर्नुभएझैँ, हारूनले त्यस मन्‍नलाई जोगाएर राख्न भनी करारको सन्दुकको सामु राखिदिए।<verse eid="EXO 16:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 16:35"/>इस्राएलीहरूले चालीस वर्षसम्म मन्‍न खाए; तिनीहरू कनान देशसम्म पुगेर बसोबास नगरुन्जेल मन्‍न खाइरहे।<verse eid="EXO 16:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 16:36"/>(एक ओमेर भनेको एपाको दशौँ भाग हो।)<verse eid="EXO 16:36"/></para>
<chapter eid="EXO 16"/>
<chapter number="17" style="c" sid="EXO 17"/>
<para style="p"><verse number="1" style="v" sid="EXO 17:1"/>इस्राएलीहरूका सारा समुदाय याहवेहले आज्ञा गर्नुभएझैँ एक ठाउँदेखि अर्को ठाउँ यात्रा गर्दै जानलाई सीनको उजाडस्थानबाट निस्के। तिनीहरूले रेफिदीममा पाल टाँगे; तर त्यहाँ मानिसहरूका निम्ति पिउनलाई पानी थिएन।<verse eid="EXO 17:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 17:2"/>यसकारण तिनीहरूले मोशासित झगडा गरेर भने, “हामीलाई पिउने पानी दिनुहोस्।” मोशाले जवाफ दिए, “तिमीहरू किन मसित झगडा गर्छौ? तिमीहरू किन याहवेहलाई परीक्षा गर्छौ?”<verse eid="EXO 17:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 17:3"/>तर ती मानिसहरू असाध्यै तिर्खाएका थिए; अनि तिनीहरू मोशाको विरुद्धमा गनगनाए। तिनीहरूले भने, “हामी, हाम्रा छोराछोरी र गाईबस्तुहरूलाई तिर्खाले मार्न भनी तपाईंले इजिप्टबाट निकालेर यस डरलाग्दो ठाउँमा किन ल्याउनुभयो?”<verse eid="EXO 17:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 17:4"/>तब मोशाले याहवेहलाई पुकार गरे, “म यी मानिसहरूलाई के गरूँ? तिनीहरूले मलाई ढुङ्गाले हान्‍नै आँटेका छन्।”<verse eid="EXO 17:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 17:5"/>याहवेहले मोशालाई जवाफ दिनुभयो, “इस्राएलका केही प्रधानहरूलाई साथमा लिएर मानिसहरूका अगि-अगि जा, र जुन लहुरोले तैँले नील नदीलाई हिर्काएको थिइस्, त्यो पनि आफ्नो हातमा लिएर जा।<verse eid="EXO 17:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 17:6"/>अनि म होरेबमा भएको चट्टानको छेवैमा तेरो सामु उभिनेछु। तैँले त्यस चट्टानलाई हिर्काऊनू, र त्यसबाट पानीको मूल फुट्नेछ, र मानिसहरूले पिउन सक्नेछन्।” यसकारण मोशाले इस्राएलका प्रधानहरूका आँखाको सामु त्यसै गरे।<verse eid="EXO 17:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 17:7"/>“याहवेह हाम्रा बीचमा हुनुहुन्छ कि हुनुहुन्‍न” भन्‍ने इस्राएलीहरूका झगडाको कारण र तिनीहरूले याहवेहको परीक्षा गरेको कारण त्यस ठाउँको नाम तिनले मस्सा र मेरीबा राखे।<verse eid="EXO 17:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 17:8"/>अमालेकीहरूले आएर रेफिदीममा इस्राएलीहरूमाथि आक्रमण गरे।<verse eid="EXO 17:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 17:9"/>अनि मोशाले यहोशूलाई भने, “हाम्रा मानिसहरूमध्ये केही मानिसलाई चुन र अमालेकीहरूसित लडाइँ गर। भोलि म परमेश्‍वरको लहुरो हातमा लिएर पहाडको टाकुरामा उभिनेछु।”<verse eid="EXO 17:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 17:10"/>यसकारण मोशाले आदेश गरेझैँ यहोशूले अमालेकीहरूसित युद्ध गरे; मोशा, हारून र हूरचाहिँ पहाडको टाकुरामा गए।<verse eid="EXO 17:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 17:11"/>मोशाले आफ्ना हातहरू उचालिराख्दा इस्राएलीहरूले जित्थे, तर जब तिनले आफ्ना हातहरू तल झार्थे, तब अमालेकीहरूले जित्थे।<verse eid="EXO 17:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 17:12"/>जब मोशाका हातहरू थाके, तब तिनीहरूले एउटा ढुङ्गा लिएर त्यसलाई तिनको मुनि राखिदिए, र तिनी त्यसमाथि बसे। हारून र हूरले सूर्यास्तसम्म तिनका हातहरू स्थिर भइरहून् भनेर एउटाले एकापट्टि र अर्काले अर्र्कापट्टि तिनका हातहरू थामिराखे।<verse eid="EXO 17:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 17:13"/>यसरी यहोशूले तरवारद्वारा अमालेकीहरूका सेनालाई पराजित गरे।<verse eid="EXO 17:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 17:14"/>तब याहवेहले मोशालाई भन्‍नुभयो, “यसलाई सम्झनाका निम्ति एउटा पुस्तकमा लेखिराख्, र यो कुरा यहोशूलाई सुनाइदे; किनकि म अमालेकीहरूको सम्झना धर्तीबाट पूर्ण रूपमा मेटिदिनेछु।”<verse eid="EXO 17:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 17:15"/>मोशाले एउटा वेदी बनाए, र त्यसलाई याहवेह निस्सी भने।<verse eid="EXO 17:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 17:16"/>तिनले भने, “याहवेहको सिंहासनतिर हातहरू उचालिएकाले याहवेहले पुस्तौँ-पुस्तासम्म अमालेकीहरूका विरुद्धमा लडाइँ गर्नुहुनेछ।”<verse eid="EXO 17:16"/></para>
<chapter eid="EXO 17"/>
<chapter number="18" style="c" sid="EXO 18"/>
<para style="p"><verse number="1" style="v" sid="EXO 18:1"/>मिद्यानका पुजारी, मोशाका ससुरा यित्रोले मोशा र आफ्नो प्रजा इस्राएलका निम्ति परमेश्‍वरले गर्नुभएका सबै कुरा, र याहवेहले इस्राएलीहरूलाई इजिप्टबाट कसरी बाहिर निकालेर ल्याउनुभएको कुरा सुने।<verse eid="EXO 18:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 18:2"/>मोशाले आफ्नी पत्नी सिप्पोरालाई माइत पठाएपछि यित्रोले आफ्नी छोरी सिप्पोरा,<verse eid="EXO 18:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 18:3"/>र तिनका दुई जना छोरालाई लिए। मोशाले एउटा छोराको नाम गेर्शोम राखेका थिए; किनकि तिनले “म परदेशमा प्रवासी भएको छु” भनेका थिए;<verse eid="EXO 18:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 18:4"/>अनि अर्कोचाहिँको नाम एलीएजर राखिएको थियो; किनकि तिनले भने, “मेरा पिताका परमेश्‍वर मेरो सहायक हुनुहुन्छ; उहाँले मलाई फारोको तरवारबाट बचाउनुभयो।”<verse eid="EXO 18:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 18:5"/>मोशाका ससुरा यित्रो तिनका दुई जना छोरा र तिनकी पत्नीसँग उजाडस्थानमा मोशाकहाँ आए, जहाँ तिनले परमेश्‍वरको पर्वत नजिक पाल टाँगेर बसेका थिए।<verse eid="EXO 18:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 18:6"/>यित्रोले मोशाकहाँ “म, तिम्रो ससुरा यित्रो, तिम्री पत्नी र तिम्रा दुई छोरासित तिमीकहाँ आउँदैछौँ” भनेर खबर पठाएका थिए।<verse eid="EXO 18:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 18:7"/>यसकारण मोशा आफ्ना ससुरालाई भेट्न बाहिर निस्के, र तिनलाई भेटेर दण्डवत् गरे; अनि म्वाइँ खाए। तिनीहरू एक-अर्कालाई हालखबर सोधेर पालभित्र गए।<verse eid="EXO 18:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 18:8"/>इस्राएलीहरूका निम्ति याहवेहले फारो र इजिप्टियनहरूलाई जे-जे गर्नुभएको थियो, ती सबै कुराहरू, साथै बाटोमा तिनीहरूमाथि के कस्ता कष्‍टहरू आइपरेका थिए, र याहवेहले तिनीहरूलाई कसरी छुटाउनुभएको थियो, ती सबै मोशाले आफ्ना ससुरोलाई बताए।<verse eid="EXO 18:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 18:9"/>याहवेहले इस्राएलीहरूलाई इजिप्टियनहरूका हातबाट छुटाउन तिनीहरूका निम्ति कस्ता-कस्ता असल कुराहरू गर्नुभएको थियो, ती सुनेर यित्रो खुशी भए।<verse eid="EXO 18:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 18:10"/>अनि यित्रोले भने, “याहवेहको प्रशंसा होस्, जसले तिमीहरूलाई इजिप्टियनहरू र फारोका हातबाट छुटाउनुभयो, जसले मानिसहरूलाई इजिप्टियनहरूका हातबाट छुटाउनुभयो।<verse eid="EXO 18:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 18:11"/>अब मलाई थाहा भयो कि याहवेह अरू सबै देवी-देवताहरूभन्दा महान् हुनुहुन्छ; किनकि उहाँले इस्राएलीहरूसित अभिमानी व्यवहार गर्नेलाई यस्तो व्यवहार गर्नुभयो।”<verse eid="EXO 18:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 18:12"/>तब मोशाका ससुरा यित्रोले याहवेहका निम्ति होमबलि र अरू बलिदानहरू ल्याए; अनि हारून र इस्राएलका सबै प्रधानहरू परमेश्‍वरको सामु मोशाका ससुरासित रोटी खान आए।<verse eid="EXO 18:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 18:13"/>भोलिपल्ट मोशा मानिसहरूको न्याय गर्नलाई बसे; अनि बिहानदेखि बेलुकासम्म मानिसहरू मोशाको वरिपरि उभिरहे।<verse eid="EXO 18:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 18:14"/>मोशाले मानिसहरूका लागि गरिरहेका सबै काम देखेपछि तिनका ससुराले भने, “तिमीले मानिसहरूका लागि यो के गरिरहेका छौ? यी मानिसहरू बिहानदेखि बेलुकीसम्म तिम्रो वरिपरि उभिरहन्छन्, तिमी एकलै मात्र किन न्यायकर्ता भएर बसिरहन्छौ?”<verse eid="EXO 18:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 18:15"/>मोशाले आफ्ना ससुरालाई भने, “किनकि मानिसहरू परमेश्‍वरको इच्छा खोज्न मकहाँ आउँछन्।<verse eid="EXO 18:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 18:16"/>जब तिनीहरूको बीचमा विवाद हुन्छ, तब त्यसलाई मकहाँ ल्याउँछन्, र मैले दुवै पक्षका बीचमा निर्णय गरेर तिनीहरूलाई परमेश्‍वरको उर्दी र उहाँका व्यवस्थाहरू बताइदिन्छु।”<verse eid="EXO 18:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 18:17"/>मोशाका ससुराले तिनलाई भने, “तिमीले जे गर्दैछौ, त्यो ठिक छैन।<verse eid="EXO 18:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 18:18"/>पक्‍कै पनि तिमी र तिमीसित हुने यी मानिसहरू एकदम थाक्नेछौ; यो काम तिम्रो निम्ति अति गाह्रो छ; र तिमी एकलैले यो गर्न सक्दैनौ।<verse eid="EXO 18:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 18:19"/>अब मेरो कुरा सुन, र म तिमीलाई केही सल्‍लाह दिनेछु, र परमेश्‍वर तिमीसित रहून्। तिमी परमेश्‍वरको सामु मानिसहरूका प्रतिनिधि भएर तिनीहरूका विवादहरू उहाँकहाँ लैजाऊ।<verse eid="EXO 18:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 18:20"/>तिनीहरूलाई उर्दी र व्यवस्थाहरू सिकाऊ, र तिनीहरूलाई जिउने तरिका र पालना गर्नुपर्ने कर्तव्य देखाइदेऊ।<verse eid="EXO 18:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 18:21"/>यसकासाथै यस्ता मानिसहरूलाई चुन, जो सबै मानिसहरूमध्येबाट सक्षम अर्थात् परमेश्‍वरको डर मान्‍ने विश्‍वासयोग्य मानिसहरू जसले बेइमानीसित लाभ लिन घृणा गर्छन्। तिनीहरूलाई हजार-हजार, सय-सय, पचास-पचास र दश-दश जनामाथि अगुवा नियुक्त गर।<verse eid="EXO 18:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 18:22"/>हरेक समय मानिसहरूमाथि तिनीहरूले न्यायकर्ता भएर सेवा गरून्; तर तिनीहरूले हरेक गाह्रो मुद्दाचाहिँ तिम्रो सामु ल्याऊन्; साना-साना मुद्दाहरूको निर्णयचाहिँ तिनीहरूले नै गरून्। यसो गर्दा तिम्रो भार हलुका हुनेछ, र तिनीहरूले तिमीसित भार उठाउनेछन्।<verse eid="EXO 18:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 18:23"/>तिमीले यसो गर्‍यौ भने, र परमेश्‍वरले यस्तै आज्ञा दिनुभयो भने तिम्रो भार हलुका हुनेछ, र यी मानिसहरू शान्तिसाथ आफ्नो घरमा फर्कनेछन्।”<verse eid="EXO 18:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 18:24"/>मोशाले आफ्ना ससुराको कुरा सुने, र तिनले भनेका हरेक कुरा गरे।<verse eid="EXO 18:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 18:25"/>तब मोशाले इस्राएलबाट सक्षम मानिसहरूलाई चुने, र तिनीहरूलाई मानिसहरूमाथि अगुवा अर्थात् हजार-हजार, सय-सय, दश-दश जनामाथि अधिकारीहरू तुल्याइदिए।<verse eid="EXO 18:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 18:26"/>तिनीहरूले हर समय मानिसहरूमाथि न्यायकर्ताको रूपमा सेवा गर्थे। कठिन मुद्दाहरू तिनीहरूले मोशाकहाँ ल्याउँथे, तर हरेक स-साना मुद्दाहरूको फैसला तिनीहरू आफूले नै गर्थे।<verse eid="EXO 18:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 18:27"/>तब मोशाले आफ्ना ससुरालाई बिदा गरे; अनि यित्रो आफ्नो देशको बाटो लागे।<verse eid="EXO 18:27"/></para>
<chapter eid="EXO 18"/>
<chapter number="19" style="c" sid="EXO 19"/>
<para style="p"><verse number="1" style="v" sid="EXO 19:1"/>इस्राएलीहरूले इजिप्ट छोडेको तेस्रो महिनाको पहिलो दिन, त्यही दिन तिनीहरू सीनैको उजाडस्थानमा आइपुगे।<verse eid="EXO 19:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 19:2"/>इस्राएलीहरू रेफिदीमबाट हिँडेपछि सीनैको उजाडस्थानमा प्रवेश गरे, र तिनीहरूले त्यही पर्वतको सामु उजाडस्थानमा पाल टाँगेर बसे।<verse eid="EXO 19:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 19:3"/>तब मोशा माथि डाँडामा परमेश्‍वरलाई भेट्न गए; अनि याहवेहले पर्वतबाट तिनलाई भन्‍नुभयो, “तैँले याकोबको घरानालाई भन्‍नुपर्ने र इस्राएलका मानिसहरूलाई बताउनुपर्ने यही हो:<verse eid="EXO 19:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 19:4"/>‘मैले इजिप्टलाई के गरेँ, मैले कसरी तिमीहरूलाई गरुडहरूझैँ पखेटामा उडाएर मकहाँ ल्याएँ, त्यो तिमीहरूले देखेका छौ।<verse eid="EXO 19:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 19:5"/>अब यदि तिमीहरूले मैले भनेको कुरा सुन्यौ, र मेरा करारहरू पूर्ण पालन गर्‍यौ भने सबै जातिमध्ये तिमीहरू मेरा निज धन हुनेछौ। सारा पृथ्वी मेरै हुन्।<verse eid="EXO 19:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 19:6"/>तिमीहरू मेरा निम्ति पुजारीहरूको एउटा राज्य र एउटा पवित्र जाति हुनेछौ।’ तैँले इस्राएलीहरूलाई भन्‍नुपर्ने कुराहरू यिनै हुन्।”<verse eid="EXO 19:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 19:7"/>मोशा फर्किएर मानिसहरूका प्रधानहरूलाई बोलाइपठाए, र याहवेहले तिनलाई आज्ञा गर्नुभएका सबै कुराहरू तिनीहरूका सामु राखिदिए।<verse eid="EXO 19:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 19:8"/>ती सबै मानिसहरूले एकसाथ जवाफ दिए, “याहवेहले भन्‍नुभएका सबै कुराहरू हामी गर्नेछौँ।” यसकारण मोशाले तिनीहरूका जवाफ याहवेहकहाँ आएर सुनाए।<verse eid="EXO 19:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 19:9"/>याहवेहले मोशालाई भन्‍नुभयो, “म बाक्लो बादलमा तँकहाँ आउनेछु; मानिसहरूले म तँसित कुरा गरेको सुनून्, र तिनीहरूले सधैँ आफ्ना भरोसा तँमाथि राखून्।” तब मोशाले याहवेहलाई मानिसहरूले भनेका कुरा भनिदिए।<verse eid="EXO 19:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 19:10"/>याहवेहले मोशालाई भन्‍नुभयो, “मानिसहरूकहाँ गएर तिनीहरूलाई आज र भोलि शुद्ध पार्। तिनीहरूले आफ्ना वस्त्र धोऊन्,<verse eid="EXO 19:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 19:11"/>अनि तेस्रो दिनको लागि तिनीहरू तयार रहून्; किनकि त्यस दिन याहवेह सबै मानिसहरूका आँखाका सामु सीनै पर्वतमाथि ओर्लिआउनुहुनेछ।<verse eid="EXO 19:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 19:12"/>पर्वतको चारैतिर मानिसहरूका लागि सिमाना लगाएर तिनीहरूलाई यसो भन्‍नू, ‘होशियार रहो, पर्वतमाथि नचढ्नू र त्यसको फेद पनि नछुनू। जसले यस पर्वतलाई छुन्छ, त्यो निश्‍चय मारिनेछ।<verse eid="EXO 19:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 19:13"/>त्यसलाई कसैले पनि नछुनू। तर त्यसलाई ढुङ्गाले हानेर अथवा काँडले छेडेर मार्नू। मानिस होस् वा पशु, त्यो जीवित रहनेछैन।’ केवल तुरही फुकेको आवाज सुनेपछि मात्र तिनीहरू पर्वतको नजिक जाऊन्।”<verse eid="EXO 19:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 19:14"/>मोशा पर्वतबाट तल मानिसहरूकहाँ ओर्लेर आएपछि तिनले उनीहरूलाई शुद्ध पारे; अनि तिनीहरूले आफ्ना वस्त्रहरू धोए।<verse eid="EXO 19:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 19:15"/>तब तिनले मानिसहरूलाई भने, “आफूलाई तेस्रो दिनको लागि तयार पार्नू। यौन सम्बन्धबाट अलग रहनू।”<verse eid="EXO 19:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 19:16"/>तेस्रो दिनको बिहान गर्जन भयो, बिजुली चम्क्यो र पर्वतमा बाक्लो बादल देखियो; अनि अति चर्को आवाजले तुरही बजेको आवाज सुनियो। छाउनीमा भएका हरेक व्यक्ति थरथर कामे।<verse eid="EXO 19:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 19:17"/>तब मोशाले मानिसहरूलाई परमेश्‍वरसित भेट्न छाउनीबाहिर निकालेर ल्याए; अनि तिनीहरू पर्वतको फेदमा उभिए।<verse eid="EXO 19:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 19:18"/>सीनै पर्वत धुवैँधुवाँले भरिएको थियो; किनकि याहवेह त्यहाँ आगोमा भई ओर्लनुभएको थियो। त्यहाँ इँटाभट्टाको धुवाँझैँ मुस्लो उठिरहेको थियो; अनि सम्पूर्ण पर्वत जोडसित काम्यो,<verse eid="EXO 19:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 19:19"/>र तुरहीको आवाज झन्-झन् चर्को हुँदैगयो। तब मोशा बोले, र परमेश्‍वरको आवाजले तिनलाई जवाफ दियो।<verse eid="EXO 19:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 19:20"/>याहवेह सीनै पर्वतको टाकुरामा ओर्लनुभयो; र मोशालाई पर्वतको टाकुरामा बोलाउनुभयो। यसकारण मोशा माथि गए,<verse eid="EXO 19:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 19:21"/>अनि याहवेहले मोशालाई भन्‍नुभयो, “तल गएर मानिसहरूलाई चेतावनी दे, र याहवेहलाई हेर्न भनी तिनीहरू जबरजस्ती नआऊन्, र तिनीहरूमध्ये धेरै नमरून्।<verse eid="EXO 19:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 19:22"/>याहवेहको नजिकमा आउने पुजारीहरू समेतले आफूलाई शुद्ध पारून्, नत्रता याहवेहले तिनीहरूलाई नाश गर्नुहुनेछ।”<verse eid="EXO 19:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 19:23"/>मोशाले याहवेहलाई भने, “मानिसहरू सीनै पर्वतमाथि आउन सक्दैनन्; किनकि तपाईंले हामीलाई ‘पर्वतका चारैतिर सिमाना लगाएर त्यसलाई पवित्र गरी अलग गर्नू’ भनी चेतावनी दिनुभएको छ।”<verse eid="EXO 19:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 19:24"/>याहवेहले जवाफ दिनुभयो, “तल गएर हारूनलाई तँसित माथि लिएर आइज; तर पुजारीहरू र मानिसहरू याहवेहकहाँ जबरजस्ती गरेर नआऊन्; नत्रता उहाँले तिनीहरूलाई नाश गर्नुहुनेछ।”<verse eid="EXO 19:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 19:25"/>यसकारण मोशा तल मानिसहरूकहाँ ओर्लेर गए, र तिनीहरूलाई यी कुरा भनिदिए।<verse eid="EXO 19:25"/></para>
<chapter eid="EXO 19"/>
<chapter number="20" style="c" sid="EXO 20"/>
<para style="p"><verse number="1" style="v" sid="EXO 20:1"/>परमेश्‍वरले यी कुराहरू भन्‍नुभयो:<verse eid="EXO 20:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 20:2"/>“म नै याहवेह, तेरा परमेश्‍वर हुँ; जसले तँलाई इजिप्टबाट, दासत्वको देशबाट निकालेर ल्याएँ।<verse eid="EXO 20:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 20:3"/>“मबाहेक तैँले अरू कुनै देवी-देवताहरू नमान्‍नू।<verse eid="EXO 20:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 20:4"/>आफ्ना निम्ति खोपेर माथि आकाशको, तल पृथ्वीको, र पानी मुनिको कुनै पनि वस्तुको कुनै मूर्ति नबनाउनू।<verse eid="EXO 20:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 20:5"/>तिनीहरूका सामु ननिहुरनू अथवा तिनीहरूको आराधना नगर्नू; किनकि म, याहवेह तेरा परमेश्‍वर, डाह गर्ने परमेश्‍वर हुँ; मलाई घृणा गर्नेहरूका पापको दण्ड तिनीहरूका छोराछोरीका तेस्रो र चौथो पुस्तामाथि दिन्छु;<verse eid="EXO 20:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 20:6"/>तर मलाई प्रेम गर्ने र मेरा आज्ञाहरू पालन गर्नेका हजारौँ पुस्तामाथि प्रेम देखाउँछु।<verse eid="EXO 20:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 20:7"/>तैँले याहवेह, आफ्ना परमेश्‍वरको नामको गलत प्रयोग नगर्नू; किनकि उहाँको नाम व्यर्थैमा लिनेलाई याहवेहले निर्दोष ठहराउनुहुनेछैन।<verse eid="EXO 20:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 20:8"/>शब्बाथलाई पवित्र राखेर त्यसको सम्झना गर्नू।<verse eid="EXO 20:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 20:9"/>छ दिनसम्म तैँले परिश्रम गरेर आफ्ना सबै काम गर्नू;<verse eid="EXO 20:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 20:10"/>तर सातौँ दिन याहवेह तेरा परमेश्‍वरका निम्ति शब्बाथ हो। यस दिन तैँले केही काम नगर्नू; न त तैँले, न तेरा छोरा वा छोरीले, न तेरा सेवक वा सेविकाले, न तेरा पशुहरूले, न तेरा सहरभित्र भएका परदेशीले, न त कसैले केही काम गर्नू।<verse eid="EXO 20:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 20:11"/>किनकि छ दिनमा याहवेहले आकाश, पृथ्वी, समुद्र र त्यसमा भएका सबै थोकहरू बनाउनुभयो, तर सातौँ दिनमा उहाँले विश्राम लिनुभयो। यसकारण याहवेहले शब्बाथलाई आशिष् दिनुभयो, र त्यसलाई पवित्र तुल्याउनुभयो।<verse eid="EXO 20:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 20:12"/>तैँले आफ्ना बुबा र आफ्नी आमालाई आदर गर्नू, ताकि याहवेह तेरा परमेश्‍वरले तँलाई दिनुहुने देशमा तेरो आयु लामो होस्।<verse eid="EXO 20:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 20:13"/>तैँले मानव हत्या नगर्नू।<verse eid="EXO 20:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 20:14"/>तैँले व्यभिचार नगर्नू।<verse eid="EXO 20:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 20:15"/>तैँले चोरी नगर्नू।<verse eid="EXO 20:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 20:16"/>तैँले आफ्नो छिमेकीको विरुद्धमा झूटो साक्षी नदिनू।<verse eid="EXO 20:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 20:17"/>तैँले तेरा छिमेकीको घरको लालच नगर्नू। तैँले आफ्नो छिमेकीको पत्नीको लालच नगर्नू, अथवा आफ्नो छिमेकीको सेवक वा सेविका, गोरु वा गधा, अथवा त्यससित भएको कुनै कुराको पनि लालच नगर्नू।”<verse eid="EXO 20:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 20:18"/>जब सारा मानिसहरूले गर्जन, बिजुली देखे; अनि तुरहीको आवाज सुने, र पर्वत धुवाँले भरिएको देखे, तब तिनीहरू डरले थरथर कामे। तिनीहरू टाढै उभिए,<verse eid="EXO 20:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 20:19"/>अनि मोशालाई भने, “हामीसित तपाईं नै बोल्नुहोस्, र हामी सुन्‍नेछौँ। तर परमेश्‍वर हामीसित नबोलून्, नत्रता हामी मर्नेछौँ।”<verse eid="EXO 20:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 20:20"/>अनि मोशाले मानिसहरूलाई भने, “नडराओ, किनकि परमेश्‍वरको डर तिमीहरूमा रहिरहोस्, साथै उहाँले तिमीहरूलाई जाँच गर्न र तिमीहरूले पाप नगर भनेर आउनुभएको छ।”<verse eid="EXO 20:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 20:21"/>त्यसैले मानिसहरू टाढै उभिरहे। अनि मोशाचाहिँ परमेश्‍वर उपस्थित हुनुभएको त्यस बाक्लो कालो बादलको नजिक गए।<verse eid="EXO 20:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 20:22"/>तब याहवेहले मोशालाई भन्‍नुभयो, “इस्राएलीहरूलाई यसो भन्: ‘मैले तिमीहरूसित स्वर्गबाट बोलेको तिमीहरूले देखेका छौ:<verse eid="EXO 20:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 20:23"/>तिमीहरूले मेरो साथमा अरू देवी-देवताहरू नबनाउनू, न त आफ्ना निम्ति चाँदी वा सुनका देवी-देवताहरू नै बनाउनू।<verse eid="EXO 20:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 20:24"/>“ ‘तिमीहरूले मेरो निम्ति माटोको एउटा वेदी बनाउनू, र त्यसमाथि तिमीहरूका होमबलि, मेलबलि, तिमीहरूका भेडाबाख्राहरू र पशुहरू बलिदान गर्नू। मेरो सम्झना गर्नलाई जुन स्थान म रोज्छु, त्यहाँ म तिमीहरूकहाँ आउनेछु र तिमीहरूलाई आशिष् दिनेछु।<verse eid="EXO 20:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 20:25"/>यदि तिमीहरूले मेरो निम्ति ढुङ्गाको वेदी बनायौ भने कुँदेका ढुङ्गाले नबनाउनू; किनकि तिमीहरूले त्यसमा हतियार प्रयोग गर्दा त्यसलाई अशुद्ध पार्नेछौ।<verse eid="EXO 20:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 20:26"/>अनि तिमीहरूको नग्नता वेदीमा नदेखियोस् भनेर त्यसमा खुड्किला बनाएर नउक्लनू।’<verse eid="EXO 20:26"/></para>
<chapter eid="EXO 20"/>
<chapter number="21" style="c" sid="EXO 21"/>
<para style="p"><verse number="1" style="v" sid="EXO 21:1"/>“तैँले तिनीहरूका सामु स्थापना गर्नुपर्ने नियमहरू यिनै हुन्:<verse eid="EXO 21:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 21:2"/>“तैँले हिब्रू सेवकलाई किनिस् भने उसले छ वर्षसम्म तेरो सेवा गरोस्। तर सातौँ वर्षमा उसले केही नतिरी स्वतन्त्र भएर जाओस्।<verse eid="EXO 21:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 21:3"/>यदि त्यो एकलै आएको भए, एकलै स्वतन्त्र भएर जाओस्; तर त्यो आउँदा त्यससँग पत्नी पनि थिई भने ऊ पनि त्यससितै जाओस्।<verse eid="EXO 21:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 21:4"/>यदि उसका मालिकले उसलाई पत्नी दिएको हो भने, र त्यसले छोराछोरी जन्माई भने त्यो स्त्री, र त्यसका छोराछोरी त्यसका मालिकका हुनेछन्; तर त्यो मानिस मात्र स्वतन्त्र भएर जाओस्।<verse eid="EXO 21:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 21:5"/>“तर त्यस सेवकले ‘म मेरा मालिक, आफ्नी पत्नी र छोराछोरीलाई माया गर्छु; अनि स्वतन्त्र भएर जान चाहन्‍नँ’ भनेर घोषणा गर्‍यो भने,<verse eid="EXO 21:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 21:6"/>उसका मालिकले उसलाई न्यायकर्ताहरूका सामु लगोस्। तिनले त्यसलाई ढोका अथवा ढोकाको खाँबोमा लगेर त्यसका कान सियोले छेडोस्; तब त्यो जीवनभरिका लागि त्यस मालिकको दास हुनेछ।<verse eid="EXO 21:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 21:7"/>“यदि कुनै मानिसले आफ्नी छोरीलाई दासीको रूपमा बेच्छ भने त्यो दासी पुरुष दासहरूझैँ स्वतन्त्र भएर जान पाउनेछैन।<verse eid="EXO 21:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 21:8"/>यदि त्यसलाई किन्‍ने मालिकलाई त्यसले प्रसन्‍न पार्न सकिन भने तिनले त्यसलाई फेरि किनिनका लागि छाडिदिनुपर्छ। मालिकले त्यससँग विश्‍वास तोडेका कारण त्यसलाई परदेशीको हातमा बेच्ने अधिकार हुँदैन।<verse eid="EXO 21:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 21:9"/>तिनले त्यसलाई आफ्नो छोराको लागि चुन्छन् भने तिनले त्यसलाई छोरीको अधिकार दिनुपर्छ;<verse eid="EXO 21:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 21:10"/>तर त्यसले अर्की पत्नी ल्यायो भने त्यसले जेठीलाई भोजन, लुगाफाटा र वैवाहिक अधिकारदेखि वञ्चित नगरोस्।<verse eid="EXO 21:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 21:11"/>यदि त्यसले उसलाई यी तीन कुराहरू दिँदैन भने त्यो कुनै मोल नतिरी स्वतन्त्र भएर जाओस्।<verse eid="EXO 21:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 21:12"/>“कसैले कुनै मानिसलाई हिर्काएर मार्‍यो भने त्यो पनि मारिनैपर्छ।<verse eid="EXO 21:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 21:13"/>तरै पनि यदि त्यसले जानाजानी त्यसो गर्दैन, तर परमेश्‍वरले नै त्यसो हुन दिनुभयो भने जुन ठाउँ म तोक्नेछु; त्यो त्यहाँ भागेर जाओस्।<verse eid="EXO 21:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 21:14"/>तर कुनै मानिसले योजना बनाएर छलपूर्वक अर्को मानिसलाई मार्छ भने त्यसलाई मेरो वेदीबाट लगेर मार्नैपर्छ।<verse eid="EXO 21:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 21:15"/>“जसले आफ्ना बुबा वा आमामाथि आक्रमण गर्छ, त्यो मारिनैपर्छ।<verse eid="EXO 21:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 21:16"/>“जसले कुनै मानिसलाई अपहरण गर्छ वा बिक्री गर्छ, अथवा त्यो पक्राउ पर्दा ऊ त्यससितै रहेको अवस्थामा फेला परियो भने त्यो मारिनैपर्छ।<verse eid="EXO 21:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 21:17"/>“जसले आफ्ना बुबा वा आमालाई सराप्छ, त्यो मारिनैपर्छ।<verse eid="EXO 21:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 21:18"/>“यदि मानिसहरू झगडा गर्दा एउटाले अर्कोलाई ढुङ्गा अथवा मुक्‍काले हिर्कायो, र त्यो नमरेर ओछ्यान पर्‍यो,<verse eid="EXO 21:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 21:19"/>अनि उठेर आफ्नो लहुरोको सहायताले बाहिर यताउता हिँड्न थाल्यो भने त्यो हिर्काउने मानिस निर्दोष ठहरियोस्; तरै पनि त्यसले घाइते मानिसको खेर गएको समयको क्षतिपूर्ति देओस्, र त्यो पूरा निको नहोउन्जेल त्यसले त्यस मानिसको उपचार गरोस्।<verse eid="EXO 21:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 21:20"/>“कुनै मानिसले आफ्नो दास वा दासीलाई लहुरोले हिर्कायो, र ऊ त्यही कारणले मर्‍यो भने त्यसले दण्ड पाउनैपर्छ।<verse eid="EXO 21:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 21:21"/>तर यदि त्यो दास एक दुई दिनमा उठ्यो भने त्यसलाई दण्ड नदिइयोस्; किनकि त्यो दास त्यसकै सम्पत्ति हो।<verse eid="EXO 21:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 21:22"/>“मानिसहरू झगडा गर्दा कुनै गर्भवती स्त्रीलाई लाग्यो, र त्यसले समय नपुगी नै बच्‍चा जन्माई, तर अरू चोट लागेको छैन भने त्यस कसुरदारले त्यस स्त्रीको पतिले तोकेको र अदालतले अनुमति दिएबमोजिम जरिमाना तिरोस्।<verse eid="EXO 21:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 21:23"/>तर यदि गम्भीर चोट लागेको छ भने तिमीहरूले प्राणको सट्टा प्राण लिनू,<verse eid="EXO 21:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 21:24"/>आँखाको सट्टा आँखा, दाँतको सट्टा दाँत, हातको सट्टा हात, खुट्टाको सट्टा खुट्टा,<verse eid="EXO 21:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 21:25"/>डामको सट्टा डाम, कुटाइको सट्टा कुटाइ र चोटको सट्टा चोट।<verse eid="EXO 21:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 21:26"/>“यदि कुनै मानिसले आफ्नो दास वा दासीलाई आँखामा हिर्कायो, र आँखा फुट्यो भने त्यसले आँखाको क्षतिपूर्तिस्वरूप त्यसलाई स्वतन्त्र भएर जान देओस्।<verse eid="EXO 21:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 21:27"/>अनि यदि त्यसले आफ्नो दास वा दासीको दाँत हिर्काएर भाँचिदियो भने त्यसको दाँतको क्षतिपूर्तिस्वरूप त्यसलाई स्वतन्त्र भएर जान देओस्।<verse eid="EXO 21:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 21:28"/>“यदि कुनै गोरुले कुनै पुरुष वा स्त्रीलाई सिङले हानेर मार्‍यो भने त्यस गोरुलाई ढुङ्गाले हानेर मारियोस्, र त्यसको मासु नखानू। तर त्यस गोरुको मालिक त्यसको जिम्मेवार हुनेछैन।<verse eid="EXO 21:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 21:29"/>तर यदि त्यस गोरुको पहिलेदेखि नै हान्‍ने स्वभाव थियो, र त्यसको मालिकलाई चेतावनी दिइएको थियो, तर उसले त्यसलाई बाँधेर राखेन, र त्यसले कुनै पुरुष वा स्त्रीलाई मार्‍यो भने त्यो गोरुलाई ढुङ्गाले हानेर मारियोस्, साथै त्यो मालिक पनि मारिनुपर्छ।<verse eid="EXO 21:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 21:30"/>तर यदि त्यस गोरुको मालिकबाट छुटकाराको दाम मागियो भने त्यो आफ्नै प्राणको निम्ति तोकिएको रकम तिरेर छुटोस्।<verse eid="EXO 21:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 21:31"/>त्यस गोरुले छोरा वा छोरीलाई सिङले हानेर मार्‍यो भने पनि यही नियम लागू हुन्छ।<verse eid="EXO 21:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 21:32"/>यदि त्यस गोरुले कसैको दास वा दासीलाई हानेर मार्‍यो भने त्यस गोरुको मालिकले दास-दासीको मालिकलाई चाँदीको तीस शेकेल तिरोस्, र त्यो गोरुचाहिँ ढुङ्गाले हानेर मारियोस्।<verse eid="EXO 21:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 21:33"/>“कुनै मानिसले खाडल खनेर खुल्‍लै राख्यो, अथवा खनेर त्यसलाई छोपेन; अनि त्यसभित्र कुनै गोरु अथवा गधा खस्यो भने,<verse eid="EXO 21:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 21:34"/>त्यस खाडलको मालिकले त्यस नोक्सानीको साटो रकम तिरोस्। उसले त्यसको मालिकलाई रकम तिरोस्; र त्यो मरेको पशु त्यसैको हुनेछ।<verse eid="EXO 21:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 21:35"/>“कुनै मानिसको गोरुले अर्को गोरुलाई हान्यो, र त्यो मर्‍यो भने तिनीहरूले जीवित गोरुलाई बेचून्, र बेचेको रकम र मरेको पशु बराबर बाँडून्।<verse eid="EXO 21:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 21:36"/>तथापि त्यस गोरुको पहिलेदेखि नै हान्‍ने बानी छ भनेर जानिएको थियो, तर पनि उसले त्यसलाई बाँधेन भने त्यस मालिकले गोरुको सट्टा गोरु नै देओस्, र मरेको गोरुचाहिँ त्यसैको होस्।”<verse eid="EXO 21:36"/></para>
<chapter eid="EXO 21"/>
<chapter number="22" style="c" sid="EXO 22"/>
<para style="p"><verse number="1" style="v" sid="EXO 22:1"/>“यदि कसैले गोरु वा भेडा चोरेर त्यसलाई मार्छ वा बिक्री गर्छ भने त्यसले त्यस गोरुको सट्टा पाँच गोरु र त्यस भेडाको सट्टा चार वटा भेडा देओस्।<verse eid="EXO 22:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 22:2"/>“यदि कुनै चोर घर फोर्दै गर्दा फेला पर्‍यो, र त्यसलाई हिर्काउँदा मर्‍यो भने त्यस मानिसको रगतको दोष कसैलाई लाग्नेछैन;<verse eid="EXO 22:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 22:3"/>तर यदि यस्तो घटना घाम झुल्केपछि भएको हो भने हिर्काउने मानिसलाई रगतको दोष लाग्नेछ। “चोरले क्षतिपूर्ति तिर्नैपर्छ; तर यदि त्यससित केही छैन भने त्यसले चोरी गरेको बदलामा त्यसैलाई बेचेर मूल्य चुकाइयोस्।<verse eid="EXO 22:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 22:4"/>यदि चोरिएको पशु त्यससित जिउँदै पाइयो भने—चाहे त्यो गोरु अथवा गधा अथवा भेडा जेसुकै होस्—त्यसले दोबर मूल्य फर्काउनुपर्छ।<verse eid="EXO 22:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 22:5"/>“यदि कुनै मानिसले आफ्नो पशु खेतमा अथवा दाखबारीमा चर्न खुला छोडिदियो, र त्यो अर्काको खेतमा गएर चर्‍यो भने त्यसले आफ्नो खेतबारी अथवा दाखबारीको सबैभन्दा असल उब्जनीबाट त्यसको क्षतिपूर्तिस्वरूप दिनुपर्छ।<verse eid="EXO 22:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 22:6"/>“यदि कसैले काँडाघारीमा आगो लगाउँदा त्यो फैलिँदै गएर अन्‍न थुपारेर राखेको ठाउँ, खेतको अन्‍न अथवा सम्पूर्ण खेत सखाप गरिदियो भने आगो लगाउने व्यक्ति जो हो, त्यसैले क्षतिपूर्ति तिरिदिनैपर्छ।<verse eid="EXO 22:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 22:7"/>“कुनै मानिसले आफ्नो छिमेकीलाई रकम अथवा सर-सामान सुरक्षापूर्वक राख्नलाई दियो, तर छिमेकीको घरबाट ती कुराहरू चोरी भयो भने र चोर पक्राउ परेको खण्डमा त्यसले दोबर क्षतिपूर्ति तिर्नुपर्छ।<verse eid="EXO 22:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 22:8"/>तर त्यो चोर पक्राउ परेन भने त्यस घरको मालिक नै त्यस मानिसको सम्पत्तिमा हात लगायो कि भनेर निर्णय गरिनका लागि न्यायकर्ताहरूका सामु ल्याइयोस्।<verse eid="EXO 22:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 22:9"/>गोरु, गधा, भेडा, लुगा अथवा कसैले ‘यो मेरो हो’ भनेका कुनै पनि किसिमको सम्पत्ति कसैकहाँ अवैध रूपमा पाइयो भने यस्ता सबै मुद्दा दुवै पक्षले न्यायकर्ताहरूको सामु ल्याऊन्। जसलाई न्यायकर्ताले दोषी ठहर्‍याउँछन्, त्यसले नै आफ्नो छिमेकीलाई दोबर क्षतिपूर्ति तिरोस्।<verse eid="EXO 22:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 22:10"/>“यदि कुनै मानिसले गधा, गोरु, भेडा अथवा अरू पशु आफ्नो छिमेकीलाई सुरक्षाको निम्ति राख्न दिएको छ; र त्यो पशुको मृत्यु भयो अथवा त्यसलाई चोट लाग्यो अथवा कसैको ध्यान नपुगेको बेला कसैले लगिदियो भने,<verse eid="EXO 22:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 22:11"/>दुई बीचको यो विषय त्यस छिमेकीले अर्को मानिसको सम्पत्तिमा आफ्नो हात लगाएको छैन भनेर याहवेहको सामु शपथ खाएर मिलाउनुपर्छ। त्यस मालिकले त्यो स्वीकार गरोस्, तब त्यसले क्षतिपूर्ति तिर्नुपर्दैन।<verse eid="EXO 22:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 22:12"/>तर यदि त्यो पशु त्यही छिमेकीबाट नै चोरिएको हो भने त त्यसले त्यसको धनीलाई क्षतिपूर्ति तिर्नुपर्छ।<verse eid="EXO 22:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 22:13"/>यदि त्यसलाई कुनै जङ्गली जनावरले टुक्रा-टुक्रा पारेको छ भने त्यसले ती बाँकी रहेका अङ्गहरू प्रमाणको लागि ल्याओस्, र त्यसले टुक्रा-टुक्रा पारिएको पशुको मोल तिर्नुपर्दैन।<verse eid="EXO 22:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 22:14"/>“यदि कुनै मानिसले आफ्नो छिमेकीबाट पशु सापटी लियो, र मालिक नभएको बेलामा त्यसलाई चोट लाग्यो अथवा त्यो मर्‍यो भने त्यसैले नै क्षतिपूर्ति तिर्नुपर्छ।<verse eid="EXO 22:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 22:15"/>तर पशु मालिकसितै छ भने सापटी लानेले त्यसलाई क्षतिपूर्ति तिर्नुपर्दैन। यदि त्यो पशु भाडामा लिइएको थियो भने भाडाको त्यस रकमले त्यसैको नोक्सानी बेहोर्छ।<verse eid="EXO 22:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 22:16"/>“यदि कुनै मानिसले विवाह गर्नलाई मगनी नभएकी कन्यालाई ललाइ-फकाइ गरी त्यससित कुकर्म गर्‍यो भने त्यसले दुलहीको मूल्य तिर्नुपर्छ; तब त्यो त्यसकी पत्नी हुनेछ।<verse eid="EXO 22:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 22:17"/>यदि त्यसका बुबाले त्यसलाई दिन पटक्‍कै मानेनन् भने कन्याको मोलअनुसार त्यस मानिसले दुलहीको मूल्य तिर्नैपर्छ।<verse eid="EXO 22:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 22:18"/>“तन्त्रमन्त्र गर्ने स्त्रीलाई जीवित रहन नदिनू।<verse eid="EXO 22:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 22:19"/>“जसले पशुसित कुकर्म गर्छ, त्यो मारिनैपर्छ।<verse eid="EXO 22:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 22:20"/>“जसले याहवेहबाहेक अरू देवी-देवताहरूलाई बलिदान चढाउँछ, त्यसलाई नाश पारिनुपर्छ।<verse eid="EXO 22:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 22:21"/>“तैँले कुनै प्रवासीसित दुर्व्यवहार नगर्नू अथवा त्यसलाई नसताऊनू; किनकि तिमीहरू पनि इजिप्टमा प्रवासी थियौ।<verse eid="EXO 22:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 22:22"/>“तिमीहरूले विधवा वा अनाथलाई शोषण नगर्नू।<verse eid="EXO 22:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 22:23"/>यदि तिमीहरूले यसो गर्‍यौ, र तिनीहरूले मेरो पुकार गरे भने म निश्‍चय तिनीहरूका पुकार सुन्‍नेछु।<verse eid="EXO 22:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 22:24"/>अनि मेरो क्रोध दन्कनेछ, र म तिमीहरूलाई तरवारले मार्नेछु; अनि तिमीहरूका पत्नीहरू विधवा हुनेछन् र तिमीहरूका छोराछोरी अनाथ हुनेछन्।<verse eid="EXO 22:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 22:25"/>“यदि तिमीहरूले अभावमा भएका मेरा मानिसलाई आफूसित भएका रकम ऋण दियौ भने साहुकारजस्ता नहुनू; न त त्यससित ब्याज नै लिनू।<verse eid="EXO 22:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 22:26"/>यदि तिमीहरूले आफ्नो छिमेकीको लुगा बन्धकको रूपमा लिएका छौ भने सूर्यास्त हुनु पहिल्यै त्यो त्यसलाई फर्काइदिनू;<verse eid="EXO 22:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 22:27"/>किनकि आफ्नो शरीर ढाक्नलाई त्यससित एक जोर लुगा मात्र छ। तब त्यसले के ओढेर सुत्ला? जब त्यसले मेरो पुकार गर्छ, तब म सुन्‍नेछु; किनकि म दयालु छु।<verse eid="EXO 22:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 22:28"/>“तैँले ईश्‍वरनिन्दा नगर्नू, न त आफ्ना मानिसहरूका शासकलाई सराप्नू।<verse eid="EXO 22:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 22:29"/>“तिमीहरूका ढुकुटी अथवा भाँडोबाट दिनुपर्ने भेटी अर्पण गर्न ढिला नगर्नू। “तिमीहरूले आफ्ना छोराहरूमध्येबाट जेठाचाहिँ मलाई दिनू।<verse eid="EXO 22:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 22:30"/>तिमीहरूका गाईबस्तु र भेडाबाख्राहरूबाट पनि त्यस्तै गर्नू। तिनीहरूलाई आफ्ना आमासित सात दिन बस्‍न देओ; तर आठौँ दिन ती मलाई दिनू।<verse eid="EXO 22:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 22:31"/>“तिमीहरू मेरा निम्ति पवित्र जाति हौ। यसकारण जङ्गली जन्तुहरूले चिथोरेको पशुको मासु नखानू; त्यसलाई कुकुरहरूका निम्ति फालिदिनू।<verse eid="EXO 22:31"/></para>
<chapter eid="EXO 22"/>
<chapter number="23" style="c" sid="EXO 23"/>
<para style="p"><verse number="1" style="v" sid="EXO 23:1"/>“तैँले झूटो कुरा नफैलाउनू। झूटो साक्षी बनेर दुष्‍ट मानिसलाई नसघाउनू।<verse eid="EXO 23:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 23:2"/>“तैँले खराबी गर्न भीडको पछि नलाग्नू। मुद्दामा साक्षी दिँदा भीडतिर लागेर न्याय नबिगार्नू;<verse eid="EXO 23:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 23:3"/>अनि गरिब भन्दैमा मुद्दामा त्यसलाई पक्षपात नगर्नू।<verse eid="EXO 23:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 23:4"/>“तिमीहरूका शत्रुका गोरु अथवा गधा फुस्केको देख्यौ भने त्यसलाई उसकहाँ लगिदिनू।<verse eid="EXO 23:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 23:5"/>यदि तिमीहरूलाई घृणा गर्नेको गधा भारीमुनि दबिएको देख्यौ भने त्यसलाई त्यत्तिकै नछोड्नू, बरु त्यसलाई सहायता दिनैपर्छ।<verse eid="EXO 23:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 23:6"/>“मुद्दामा आफ्ना गरिब मानिसहरूलाई न्याय गरिदिन इन्कार नगर्नू।<verse eid="EXO 23:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 23:7"/>झूटो अभियोगबाट टाढा बस्‍नू र कुनै निर्दोष अथवा इमानदार व्यक्तिलाई नमार्नू; किनकि म दोषीलाई त्यत्तिकै छोड्नेछैनँ।<verse eid="EXO 23:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 23:8"/>“घूस स्वीकार नगर्नू; किनकि घूसले आँखा देख्नेहरूलाई अन्धा तुल्याइदिन्छ, र निर्दोषका कुरालाई बङ्ग्याइदिन्छ।<verse eid="EXO 23:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 23:9"/>“प्रवासीलाई अत्याचार नगर्नू; प्रवासी हुँदा कस्तो हुन्छ, त्यो तिमीहरू आफैँलाई थाहा छ; किनकि तिमीहरू इजिप्टमा प्रवासी थियौ।<verse eid="EXO 23:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 23:10"/>“छ वर्षसम्म तिमीहरूले आफ्नो खेती गर्नू, र फसलको कटनी गर्नू,<verse eid="EXO 23:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 23:11"/>तर सातौँ वर्षमा खेत नजोत्नू, र प्रयोग नगरी छोडिदिनू। तब तिमीहरूमध्ये गरिबहरूले त्यसबाट भोजन पाऊन्, र तिनीहरूले छोडेका जङ्गली पशुहरूले खाऊन्। तिमीहरूका अङ्‌गुर र जैतुनका बारीलाई पनि त्यसै गर्नू।<verse eid="EXO 23:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 23:12"/>“छ दिनसम्म आफ्ना काम गर्नू, तर सातौँ दिनमा चाहिँ काम नगर्नू, र तिमीहरूका गोरु र गधाले विश्राम पाऊन्, र तिमीहरूका घरमा जन्मेका दास र प्रवासीहरू पनि ताजा होऊन्।<verse eid="EXO 23:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 23:13"/>“मैले तिमीहरूलाई भनेका प्रत्येक कुरा होशियार भई पालन गर्नू। अरू देवी-देवताहरूको नाम नलेओ; तिनीहरूका नाम तिमीहरूको मुखबाट उच्‍चारण नै नहोस्।<verse eid="EXO 23:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 23:14"/>“वर्षमा तीन पल्ट तिमीहरूले मेरा निम्ति चाड मनाउनू।<verse eid="EXO 23:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 23:15"/>“अखमिरी रोटीको चाड मनाओ; मैले तिमीहरूलाई आज्ञा दिएझैँ सात दिनसम्म अखमिरी रोटी खाओ। यो तिमीहरूले आबीब महिनाको तोकिएको समयमा गर; किनकि त्यही महिना तिमीहरू इजिप्टबाट निस्केर आएका थियौ। “मकहाँ कोही पनि खाली हात नआओस्।<verse eid="EXO 23:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 23:16"/>“तिमीहरूले आफ्ना खेतमा छरेका अन्‍नको पहिलो फलले कटनीको चाड मनाउनू। “वर्षको अन्तमा तिमीहरूले खेतबाट आफ्ना अन्‍न बटुल्दा अन्‍न भित्र्याउने चाड मनाओ।<verse eid="EXO 23:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 23:17"/>“वर्षमा तीन पल्ट सबै पुरुषहरू सार्वभौम याहवेहकहाँ देखा परून्।<verse eid="EXO 23:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 23:18"/>“तिमीहरूले मलाई बलिदानको रगतसित खमिर भएको कुनै पनि कुरा नचढाउनू। “मेरा चाडको बलिको बोसोहरू बिहानसम्म रहन नदिनू।<verse eid="EXO 23:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 23:19"/>“तिमीहरूका माटोबाट उब्जेका सबैभन्दा असल पहिलो फल याहवेह तिमीहरूका परमेश्‍वरको घरमा ल्याउनू। “बाख्राको पाठो त्यसको माउको दूधमा नपकाउनू।<verse eid="EXO 23:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 23:20"/>“हेर, तिमीहरूलाई बाटोमा रक्षा गर्न मैले तयार पारिराखेको ठाउँमा तिमीहरूलाई ल्याउनलाई म एउटा दूत तिमीहरूका अगि-अगि पठाउँदैछु।<verse eid="EXO 23:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 23:21"/>ध्यान दिएर तिनको कुरा सुन, र तिनले भनेका कुरा मान। तिनको विरोध नगर; तिनले तिमीहरूको विद्रोह क्षमा गर्नेछैनन्; किनकि मेरो नाम तिनमा रहेको छ।<verse eid="EXO 23:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 23:22"/>यदि तिमीहरूले तिनले भनेका कुरा ध्यानपूर्वक सुन्यौ र मैले तिमीहरूलाई भनेका सबै गर्‍यौ भने म तिमीहरूका शत्रुहरूका शत्रु बन्‍नेछु; अनि तिमीहरूलाई विरोध गर्नेहरूलाई म विरोध गर्नेछु।<verse eid="EXO 23:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 23:23"/>मेरो दूत तिमीहरूका अगि-अगि जानेछन् र तिमीहरूलाई एमोरी, हित्ती, परिज्जी, कनानी, हिव्वी र यबूसीहरूका देशमा ल्याउनेछन्, र म तिनीहरूलाई पूर्ण रूपले नाश गरिदिनेछु।<verse eid="EXO 23:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 23:24"/>तिनीहरूका देवी-देवताहरूलाई दण्डवत् नगर्नू, तिनीहरूको आराधना नगर्नू अथवा तिनीहरूका रीतिहरूअनुसार नचल्नू। तिमीहरूले ती भत्काइदिनू र तिनीहरूले पवित्र मानेका ढुङ्गाहरू टुक्रा-टुक्रा पारेर भाँचिदिनू।<verse eid="EXO 23:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 23:25"/>याहवेह तिमीहरूका परमेश्‍वरलाई आराधना गर्नू, र तिमीहरूका अन्‍नपानीमा उहाँको आशिष् रहनेछ। म तिमीहरूका बीचबाट रोगहरू हटाइदिनेछु;<verse eid="EXO 23:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 23:26"/>अनि तिमीहरूको देशमा कसैको गर्भ तुहुनेछैन वा कोही बाँझी हुनेछैन। म तिमीहरूलाई पूरा आयु जिउन दिनेछु।<verse eid="EXO 23:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 23:27"/>“म तिमीहरूका अगि-अगि मेरो आतङ्क पठाउनेछु, र तिमीहरूले सामना गर्ने प्रत्येक राष्ट्रलाई अलमल पारिदिनेछु। म तिमीहरूका सबै शत्रुहरूलाई पिठिउँ फर्काएर भाग्ने तुल्याउनेछु।<verse eid="EXO 23:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 23:28"/>म हिव्वी, कनानी र हित्तीहरूलाई तिमीहरूका बाटोदेखि धपाउनको निम्ति तिमीहरूका अगि-अगि अरिङ्गाल पठाउनेछु।<verse eid="EXO 23:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 23:29"/>तर म तिनीहरूलाई एकै वर्षमा धपाउनेछैन, नत्रता देश उजाड हुनेछ, र जङ्गली जनावरहरू तिमीहरूका लागि संख्यामा ज्यादै हुनेछन्।<verse eid="EXO 23:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 23:30"/>म तिमीहरू संख्यामा बढेर देशमाथि अधिकार गर्न सक्ने नभएसम्म तिनीहरूलाई तिमीहरूकै सामु अलि-अलि गर्दै धपाउनेछु।<verse eid="EXO 23:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 23:31"/>“म तिमीहरूका सिमाना लाल समुद्रदेखि भूमध्य सागरसम्म, र उजाडस्थानदेखि यूफ्रेटिस नदीसम्मै स्थापित गर्नेछु। म त्यस देशमा बसोबास गर्ने मानिसहरूलाई तिमीहरूका हातमा पारिदिनेछु, र तिमीहरूले तिनीहरूलाई आफ्नो सामुबाट धपाउनेछौ।<verse eid="EXO 23:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 23:32"/>तिनीहरूसित र तिनीहरूका देवी-देवताहरूसित करार नबाँध्नू।<verse eid="EXO 23:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 23:33"/>तिनीहरूलाई तिमीहरूको देशमा बस्‍न नदिनू, नत्रता तिनीहरूले तिमीहरूलाई मेरो विरुद्धमा पाप गर्न लाउनेछन्; किनकि तिनीहरूका देवी-देवताहरूको आराधना तिमीहरूका निम्ति निश्‍चय नै पासो हुनेछ।”<verse eid="EXO 23:33"/></para>
<chapter eid="EXO 23"/>
<chapter number="24" style="c" sid="EXO 24"/>
<para style="p"><verse number="1" style="v" sid="EXO 24:1"/>त्यसपछि उहाँले मोशालाई भन्‍नुभयो, “तँ र हारून, नादाब र अबीहू, र इस्राएलका सत्तरी जना प्रधानहरू याहवेहकहाँ माथि उक्लेर आओ। तिमीहरू टाढै रहेर आराधना गर्नू,<verse eid="EXO 24:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 24:2"/>तर मोशामात्र याहवेहको नजिक आओस्; अरू कोही पनि नजिक नआऊन्। अनि मानिसहरू पनि ऊसँग माथि उक्लेर नआऊन्।”<verse eid="EXO 24:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 24:3"/>जब मोशाले गएर मानिसहरूलाई याहवेहका सबै वचन र व्यवस्थाहरू भनिदिए; तब तिनीहरूले एकै सोरले जवाफ दिए, “याहवेहले भन्‍नुभएका सबै कुराहरू हामी गर्नेछौँ।”<verse eid="EXO 24:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 24:4"/>तब मोशाले याहवेहले भन्‍नुभएका प्रत्येक कुराहरू लेखे। तिनी भोलिपल्ट बिहानै उठे र पर्वतको फेदीमा एउटा वेदी बनाए, र इस्राएलका बाह्र कुलको प्रतिनिधित्व गर्नलाई बाह्र वटा ढुङ्गाका खम्बाहरू खडा गरे।<verse eid="EXO 24:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 24:5"/>तब तिनले जवान इस्राएली मानिसहरूलाई पठाए, र तिनीहरूले याहवेहका निम्ति होमबलि चढाए, र मेलबलिको रूपमा जवान बहरहरू बलिदान गरे।<verse eid="EXO 24:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 24:6"/>मोशाले आधा रगत लिएर कचौराहरूमा हाले र अर्को आधा भागचाहिँ वेदीमाथि छर्किदिए।<verse eid="EXO 24:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 24:7"/>तब तिनले करारको पुस्तक लिएर मानिसहरूलाई पढेर सुनाए। तिनीहरूले जवाफ दिए, “याहवेहले भन्‍नुभएका सबै कुराहरू हामी गर्नेछौँ; हामी ती पालन गर्नेछौँ।”<verse eid="EXO 24:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 24:8"/>तब मोशाले रगत लिएर मानिसहरूमाथि छर्के, र भने, “यो रगत यी वचनहरूका आधारमा याहवेहले तिमीहरूसित गर्नुभएको करारको रगत हो।”<verse eid="EXO 24:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 24:9"/>त्यसपछि मोशा, हारून, नादाब, अबीहू, र इस्राएलका सत्तरी प्रधानहरू माथि उक्लेर गए;<verse eid="EXO 24:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 24:10"/>अनि तिनीहरूले इस्राएलका परमेश्‍वरलाई देखे। उहाँको खुट्टामुनि निलो आकाशझैँ सफा नीलमणि थियो।<verse eid="EXO 24:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 24:11"/>तर परमेश्‍वरले इस्राएलका ती अगुवाहरूका विरुद्धमा आफ्नो हात उठाउनुभएन; तिनीहरूले परमेश्‍वरलाई देखे, र तिनीहरूले खानपिन गरे।<verse eid="EXO 24:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 24:12"/>तब याहवेहले मोशालाई भन्‍नुभयो, “मकहाँ पर्वतमा उक्लेर आइज र यहीँ बस्; अनि तिनीहरूको शिक्षाको निम्ति मैले लेखेका व्यवस्था र आज्ञाका ढुङ्गाका पाटीहरू म तँलाई दिनेछु।”<verse eid="EXO 24:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 24:13"/>तब मोशा र तिनका सेवक यहोशू उठेर परमेश्‍वरको पर्वतमा गए।<verse eid="EXO 24:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 24:14"/>मोशाले प्रधानहरूलाई भने, “हामी तपाईंहरूकहाँ नआउन्जेल यहीँ हामीलाई पर्खिबस्‍नुहोस्। हारून र हूर तपाईंहरूसँग छन्; अनि कसैको केही विवाद भए तिनीहरूकहाँ जानू।”<verse eid="EXO 24:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 24:15"/>जब मोशा उक्लेर पर्वतमाथि गए, तब बादलले त्यस पर्वतलाई ढाक्यो।<verse eid="EXO 24:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 24:16"/>अनि याहवेहको महिमा सीनै पर्वतमा रह्‍यो। छ दिनसम्म बादलले पर्वतलाई ढाकिरह्‍यो; र सातौँ दिनमा याहवेहले बादलभित्रबाट मोशालाई बोलाउनुभयो।<verse eid="EXO 24:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 24:17"/>इस्राएलीहरूका निम्ति याहवेहको महिमा पर्वतको टाकुरामा भस्म पार्ने आगोझैँ देखियो।<verse eid="EXO 24:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 24:18"/>मोशा पर्वतमाथि उक्लँदै गएर बादलभित्र प्रवेश गरे। अनि तिनी पर्वतमाथि चालीस दिन र चालीस रात रहे।<verse eid="EXO 24:18"/></para>
<chapter eid="EXO 24"/>
<chapter number="25" style="c" sid="EXO 25"/>
<para style="p"><verse number="1" style="v" sid="EXO 25:1"/>याहवेहले मोशालाई भन्‍नुभयो,<verse eid="EXO 25:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 25:2"/>“इस्राएलीहरूलाई मेरो निम्ति भेटी ल्याउनू भन्। मेरो निम्ति हृदयदेखि नै दिने इच्छा गर्ने प्रत्येक मानिसबाट तैँले भेटी ग्रहण गर्नू।<verse eid="EXO 25:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 25:3"/>“तिनीहरूबाट तैँले प्राप्‍त गर्नुपर्ने भेटीहरू यिनै हुन्: “सुन, चाँदी र काँसो;<verse eid="EXO 25:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 25:4"/>निलो र बैजनी, रातो धागो र मसिनो सुती कपडा; बाख्राको भुत्ला;<verse eid="EXO 25:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 25:5"/>भेडाका रातो रङ्गले रङ्गाएको छालाहरू र सीलका छालाहरू; बबुलका काठ;<verse eid="EXO 25:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 25:6"/>बत्तीको निम्ति जैतुनको तेल; अभिषेक गर्नका निम्ति तेल र सुगन्धित धूपका निम्ति मसलाहरू;<verse eid="EXO 25:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 25:7"/>अनि एपोद र छाती-पाता जड्नका निम्ति गोमेद र अरू रत्नहरू।<verse eid="EXO 25:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 25:8"/>“तब तिनीहरूले मेरा लागि एउटा समागम पाल बनाऊन्, र म तिनीहरूको माझमा बास गर्नेछु।<verse eid="EXO 25:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 25:9"/>मैले तँलाई जस्तो नमुना देखाउनेछु, ठिक त्यहीअनुसार समागम पाल र त्यसका सबै सामानहरू बनाउनू।<verse eid="EXO 25:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 25:10"/>“तिनीहरूले बबुल काठको साढे दुई क्यूबिट लामो, साढे एक क्यूबिट चौडा र साढे एक क्यूबिट अग्लो सन्दुक बनाऊन्।<verse eid="EXO 25:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 25:11"/>त्यसलाई भित्र र बाहिर दुवैतिर निखुर सुनले मोहोर्नू, र त्यसको चारैतिर सुनको बिट बनाउनू।<verse eid="EXO 25:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 25:12"/>अनि त्यसका निम्ति सुनका चार वटा मुन्‍द्रा, त्यसका चार खुट्टामा बाँध्नू—दुई मुन्द्राहरू एकापट्टि र दुई वटा अर्कापट्टि।<verse eid="EXO 25:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 25:13"/>तब बबुल काठका डण्डाहरू बनाएर तिनलाई सुनले मोहोर्नू।<verse eid="EXO 25:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 25:14"/>ती डण्डाहरू सन्दुक बोक्नलाई त्यसका दुवैतिर भएका मुन्द्राहरूमा लगाउनू।<verse eid="EXO 25:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 25:15"/>ती डण्डाहरू त्यस सन्दुकका मुन्द्राहरूमै रहून्; तिनीहरूलाई ननिकाल्नू।<verse eid="EXO 25:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 25:16"/>त्यस सन्दुकभित्र मैले तँलाई दिने साक्षी पाटी राख्नू।<verse eid="EXO 25:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 25:17"/>“तैँले निखुर सुनको साढे दुई क्यूबिट लामो र साढे एक क्यूबिट चौडा एउटा पाप समाधान-स्थान बनाउनू।<verse eid="EXO 25:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 25:18"/>त्यसपछि पाप समाधान-स्थानको किनारहरूमा पिटिएको सुनका दुई वटा करूबहरू बनाउनू।<verse eid="EXO 25:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 25:19"/>एउटा करूब त्यस पाप समाधान-स्थानको एकापट्टि र अर्को करूब अर्कोपट्टि बनाउनू। ती करूबहरू पाप समाधान-स्थानसित एउटै टुक्रा हुने गरी दुवैतिर बनाउनू।<verse eid="EXO 25:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 25:20"/>ती करूबहरूका पखेटाहरू पाप समाधान-स्थानलाई ढाक्ने गरी उँभोतिर फर्केका होऊन्। ती करूबहरू पाप समाधान-स्थानतिर हेर्दै एक-अर्कापट्टि फर्केका होऊन्।<verse eid="EXO 25:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 25:21"/>त्यस पाप समाधान-स्थानलाई सन्दुकको माथिपट्टि राख्नू; अनि मैले तँलाई दिने साक्षी पाटी त्यसभित्र राख्नू।<verse eid="EXO 25:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 25:22"/>अनि त्यहीँ करारको सन्दुकमाथि भएका दुई करूबहरूको बीचमा भएको पाप समाधान-स्थानमाथि म तँलाई भेट्नेछु; र इस्राएलीहरूका निम्ति मेरा सबै आज्ञाहरू तँलाई दिनेछु।<verse eid="EXO 25:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 25:23"/>“तैँले बबुल काठको एउटा टेबुल—दुई क्यूबिट लामो, एक क्यूबिट चौडा र साढे एक क्यूबिट अग्लो बनाउनू।<verse eid="EXO 25:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 25:24"/>त्यसलाई तैँले निखुर सुनले मोहोर्नू, र त्यसका चारैतिर सुनको बिट बनाउनू।<verse eid="EXO 25:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 25:25"/>साथै त्यसका चारैतिर चार औँला चौडाइ भएको घेरा बनाउनू, र त्यसमा सुनको बिट लगाउनू।<verse eid="EXO 25:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 25:26"/>टेबुलको लागि सुनका चार वटा मुन्द्राहरू बनाएर ती चार कुनाहरूमा भएका खुट्टाहरूमा बाँध्नू।<verse eid="EXO 25:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 25:27"/>त्यो टेबुल बोक्नलाई चलाइने डण्डाहरूलाई समातिराख्न ती मुन्द्राहरू घेराका छेवैमा होऊन्।<verse eid="EXO 25:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 25:28"/>बबुल काठका डण्डाहरू बनाएर त्यसलाई सुनले मोहोर्नू, र तिनीहरूकै सहायताले टेबुल बोक्नू।<verse eid="EXO 25:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 25:29"/>त्यसका थालहरू अनि कचौराहरू, साथै करूवाहरू र भेटी खन्याउने कचौराहरू पनि निखुर सुनको बनाउनू।<verse eid="EXO 25:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 25:30"/>यस टेबुलमाथि उपस्थितिको रोटी मेरो सामु हर समय राख्नू।<verse eid="EXO 25:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 25:31"/>“तैँले निखुर सुनको एउटा सामदान बनाउनू; घनले पिटेर त्यसको आधार र डण्डा बनाउनू; त्यसका फूलजस्ता कचौराहरू, कोपिलाहरू र फूलहरू त्यससित एउटै टुक्राबाट बनाउनू।<verse eid="EXO 25:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 25:32"/>तीन वटा एकपट्टि र तीन वटा अर्कोपट्टि गरेर जम्मा सामदानका दुई छेउमा छ वटा हाँगाहरू निस्केका होऊन्।<verse eid="EXO 25:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 25:33"/>एउटा हाँगामा कोपिला र फूल भएको बदामको फूलजस्तै आकारका तीन वटा कचौराहरू होऊन्; अर्को हाँगामा तीन वटा र यसै गरी सामदानबाट निस्केका छ वटै हाँगाहरूमा होऊन्।<verse eid="EXO 25:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 25:34"/>अनि सामदानमा कोपिला र कोपिला भएको बदामको फूलको आकारमा चार वटा कचौराहरू बनाउनू।<verse eid="EXO 25:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 25:35"/>पहिलो कोपिला सामदानबाट निस्केको हाँगाको पहिलो जोडीमुनि होऊन्—दोस्रो कोपिला दोस्रो जोडीमुनि र तेस्रो कोपिला तेस्रो जोडीमुनि गरेर जम्मा छ वटा हाँगाहरू।<verse eid="EXO 25:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 25:36"/>ती कोपिलाहरू र हाँगाहरू सामदानसित एउटै टुक्राबाट घनले पिटेको निखुर सुनले बनिएको होस्।<verse eid="EXO 25:36"/></para>
<para style="p"><verse number="37" style="v" sid="EXO 25:37"/>“तब त्यसका सात वटा दियाहरू बनाउनू र त्यसको नजिक ठाउँमा उज्यालो देखियोस् भनेर तिनलाई त्यसमाथि राख्नू।<verse eid="EXO 25:37"/></para>
<para style="p"><verse number="38" style="v" sid="EXO 25:38"/>त्यसको सलेदो ठिक गर्ने चिम्टा र मोसोदानी निखुर सुनका होऊन्।<verse eid="EXO 25:38"/></para>
<para style="p"><verse number="39" style="v" sid="EXO 25:39"/>सामदान र त्यसका सबै पात्रहरू एक टालेन्ट निखुर सुनको बनाउनू।<verse eid="EXO 25:39"/></para>
<para style="p"><verse number="40" style="v" sid="EXO 25:40"/>ती सबै तँलाई पर्वतमा देखाइएको नमुनाअनुसार बनाउनू।<verse eid="EXO 25:40"/></para>
<chapter eid="EXO 25"/>
<chapter number="26" style="c" sid="EXO 26"/>
<para style="p"><verse number="1" style="v" sid="EXO 26:1"/>“तैँले दश वटा मसिनो गरी बाटेका सुती, निलो, बैजनी र रातो धागोका पर्दाबाट दक्ष शिल्पकारद्वारा बनाइएका करूबहरूसहित समागम पाल बनाउनू।<verse eid="EXO 26:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 26:2"/>ती सबै पर्दाहरू एकै नापका होऊन्—अट्ठाइस क्यूबिट लामो र चार क्यूबिट चौडा।<verse eid="EXO 26:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 26:3"/>पाँच वटा पर्दाहरू एकसाथ गाँस्‍नू, र अर्को पाँच वटालाई पनि त्यसै गर्नू।<verse eid="EXO 26:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 26:4"/>पहिलो पाँच पर्दाहरूका किनारै किनारमा निलो रङ्गको सुर्काउनी बनाउनू; अनि अर्को पाँच पर्दाहरूका किनारमा पनि त्यस्तै गर्नू।<verse eid="EXO 26:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 26:5"/>एउटा समूहका पर्दामा पचास वटा सुर्काउनीहरू बनाउनू; अनि अर्को समूहका पाँच वटा पर्दाहरूका किनारमा पचास वटा सुर्काउनी बनाउनू। ती सुर्काउनीहरू आमने-सामने होऊन्।<verse eid="EXO 26:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 26:6"/>तब सुनका पचास वटा अङ्कुसेहरू बनाएर तिनीहरूलाई पर्दाहरू एकसाथ बाँध्ने काममा प्रयोग गर्नू र यसरी समागम पाल एउटै इकाई होस्।<verse eid="EXO 26:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 26:7"/>“समागम पालमाथिको पालको लागि बाख्राको भुत्लाबाट जम्मा एघार वटा पर्दाहरू बनाउनू।<verse eid="EXO 26:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 26:8"/>ती एघारै वटा पर्दाहरू एउटै नापका होऊन्—तीस क्यूबिट लामो र चार क्यूबिट चौडा।<verse eid="EXO 26:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 26:9"/>पाँच वटा पर्दाहरू एकसाथ गाँस्‍नू र बाँकी छ वटा पर्दा एकसाथ गाँस्‍नू। पालको अगिल्तिर छैटौँ पर्दालाई दोबर गरी पट्याउनू।<verse eid="EXO 26:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 26:10"/>पहिलो गाँसिएको समूहको किनारमा पचास वटा सुर्काउनीहरू बनाउनू; अनि अर्को गाँसिएको समूहको पर्दाको किनारमा पनि पचास वटा सुर्काउनीहरू बनाउनू।<verse eid="EXO 26:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 26:11"/>त्यसपछि काँसाका पचास वटा अङ्कुसेहरू बनाएर सुर्काउनीहरूमा लगाउनू र पाललाई एउटै एकाइ बनाउनका लागि कस्‍ने काममा प्रयोग गर्नू।<verse eid="EXO 26:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 26:12"/>पालका पर्दाहरूको उब्रेको लम्बाइको विषयमा, उब्रेको आधा पर्दा समागम पालको पछिल्तिर झुण्डियोस्।<verse eid="EXO 26:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 26:13"/>पालका पर्दाहरू दुवै छेउतिर एक क्यूबिट लामो होऊन् र उब्रेका भाग समागम पाललाई ढाक्नलाई त्यसका दुवै छेउमा झुण्डिरहून्।<verse eid="EXO 26:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 26:14"/>पालको निम्ति भेडाको रातो रङ्गाइएको छालाबाट छत बनाउनू; र त्यसमाथि सीलका छालाहरूबाट छत बनाउनू।<verse eid="EXO 26:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 26:15"/>“समागम पालका निम्ति बबुल काठको ठाडो फल्याकहरू बनाउनू।<verse eid="EXO 26:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 26:16"/>प्रत्येक फल्याकको लम्बाइ दश क्यूबिट र चौडाइ डेढ क्यूबिट होस्।<verse eid="EXO 26:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 26:17"/>त्यसमा एक-अर्कामा समानान्तर रहेका दुई वटा चोसाहरू होऊन्। समागम पालका सबै फल्याकहरू यस किसिमले नै बनाउनू।<verse eid="EXO 26:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 26:18"/>समागम पालको दक्षिणपट्टिका लागि बीस वटा फल्याकहरू बनाउनू;<verse eid="EXO 26:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 26:19"/>अनि ती फल्याकहरूका मुन्तिर चालीस वटा चाँदीका आधारहरू बनाउनू—एउटा फल्याकको लागि दुई वटा आधारहरू, प्रत्येक चोसाको मुनि एउटा।<verse eid="EXO 26:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 26:20"/>अर्कोपट्टि समागम पालको उत्तरपट्टि बीस वटा फल्याकहरू बनाउनू;<verse eid="EXO 26:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 26:21"/>अनि प्रत्येक फल्याकको मुनि दुई वटा आधार गरेर चाँदीका चालीस वटा आधारहरू बनाउनू।<verse eid="EXO 26:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 26:22"/>पछिल्तिरको भाग, जो समागम पालको पश्‍चिमतिरको भाग हो, त्यसका लागि छ वटा फल्याकहरू बनाउनू;<verse eid="EXO 26:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 26:23"/>अनि अन्तिम भागमा भएका कुनाहरूका लागि दुई वटा फल्याकहरू बनाउनू।<verse eid="EXO 26:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 26:24"/>यी कुनाहरूमा फेददेखि टुप्पोसम्म फल्याकहरू दोबर खप्टिएका होऊन्; अनि एउटै मुन्द्रामा जोडिएका होऊन्; दुवै यस्तै होऊन्।<verse eid="EXO 26:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 26:25"/>यसरी प्रत्येक फल्याकमुनि दुई वटा गरेर जम्मा आठ वटा फल्याकहरू र चाँदीका सोह्र वटा आधारहरू होऊन्।<verse eid="EXO 26:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 26:26"/>“बबुल काठका बारहरू पनि बनाउनू: समागम पालको एकातिरको फल्याकहरूका लागि पाँच वटा,<verse eid="EXO 26:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 26:27"/>अर्कोपट्टिका फल्याकहरूका लागि पाँच वटा बार र समागम पालको पश्‍चिमका अन्तिम भागका फल्याकहरूको लागि पाँच वटा बारहरू लगाए।<verse eid="EXO 26:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 26:28"/>बीचको बार फल्याकको बीचमा एक छेउदेखि अर्को छेउसम्म पुगोस्।<verse eid="EXO 26:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 26:29"/>फल्याकहरूलाई सुनले मोहोर्नू, र बारहरू अड्काउनका लागि सुनका मुन्द्राहरू बनाउनू। ती बारहरूलाई पनि सुनले मोहोर्नू।<verse eid="EXO 26:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 26:30"/>“मैले तँलाई पर्वतमा देखाएको नमुनाअनुसार समागम पाल खडा गर्नू।<verse eid="EXO 26:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 26:31"/>“निलो, बैजनी अनि रातो धागो र मसिनो गरी बाटेको सुती कपडा; अनि दक्ष शिल्पकारद्वारा बनाइएका करूबहरू भएका एउटा पर्दा बनाउनू।<verse eid="EXO 26:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 26:32"/>चाँदीका चार वटा आधारहरूमा खडा भएका र सुनले मोहोरेका बबुल काठका चार वटा खम्बाहरूमा त्यसलाई सुनका अङ्कुसेहरूले झुण्ड्याउनू।<verse eid="EXO 26:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 26:33"/>पर्दालाई अङ्कुसेले झुण्ड्याएर साक्षी पाटीको सन्दुकलाई पर्दाको पछाडि राख्नू। त्यस पर्दाले पवित्रस्थानलाई महा-पवित्रस्थानबाट अलग गर्नेछ।<verse eid="EXO 26:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 26:34"/>महा-पवित्रस्थानमा साक्षी पाटीको सन्दुकको माथि पाप समाधान-स्थान राख्नू।<verse eid="EXO 26:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 26:35"/>टेबुललाई पर्दा बाहिर समागम पालको उत्तरतिर राख्नू; र सामदानलाई त्यसको विपरीततिर दक्षिणपट्टि राख्नू।<verse eid="EXO 26:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 26:36"/>“पाल प्रवेशद्वारका लागि निलो, बैजनी, रातो रङ्गको धागो र मसिनो गरी बाटेको सुती कपडाले फूल-बुट्टा भएको एउटा पर्दा बनाउनू।<verse eid="EXO 26:36"/></para>
<para style="p"><verse number="37" style="v" sid="EXO 26:37"/>त्यस पर्दाका लागि सुनका अङ्कुसेहरू र सुनले मोहोरेका बबुलका पाँच वटा खम्बाहरू बनाउनू; अनि तिनीहरूका लागि काँसाका पाँच वटा आधारहरू बनाउनू।<verse eid="EXO 26:37"/></para>
<chapter eid="EXO 26"/>
<chapter number="27" style="c" sid="EXO 27"/>
<para style="p"><verse number="1" style="v" sid="EXO 27:1"/>“तैँले बबुल काठको तीन क्यूबिट अग्लो एउटा वेदी बनाउनू; त्यो पाँच क्यूबिट लामो र पाँच क्यूबिट चौडा भएको वर्गाकार होस्।<verse eid="EXO 27:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 27:2"/>चार कुनामा एक-एक वटा सिङ बनाउनू, ताकि सिङहरू र वेदी एउटै टुक्राको होस्; अनि वेदीलाई काँसोले मोहोर्नू।<verse eid="EXO 27:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 27:3"/>त्यसका सबै भाँडाहरू काँसाको बनाउनू—त्यसका खरानी उठाउने भाँडाहरू र त्यसका बेल्चाहरू, पानी छर्कने बाटाहरू, मासुको लागि काँटाहरू र आगो राख्ने पात्रहरू।<verse eid="EXO 27:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 27:4"/>त्यसका लागि काँसोको जालीबाट एउटा झिँजा बनाउनू, र जालीका चारै कुनामा एक-एक वटा काँसाका मुन्द्राहरू बनाउनू।<verse eid="EXO 27:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 27:5"/>त्यसलाई वेदीको मुन्तिर यस प्रकारले लगाउनु कि त्यो वेदीको आधा भागसम्म आओस्।<verse eid="EXO 27:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 27:6"/>वेदीका निम्ति बबुल काठका डण्डाहरू बनाएर तिनीहरूलाई काँसोले मोहोर्नू।<verse eid="EXO 27:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 27:7"/>ती डण्डाहरूलाई मुन्द्राहरूमा यस्तो किसिमले छिराउनू कि वेदीलाई बोक्दा तिनीहरू वेदीका दुई छेउमा होऊन्।<verse eid="EXO 27:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 27:8"/>फल्याकहरूसित तैँले त्यसलाई खोक्रो गरी बनाउनू। यो तँलाई पर्वतमा देखाइदिएजस्तै गरी बनाउनू।<verse eid="EXO 27:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 27:9"/>“समागम पालको लागि एउटा आँगन बनाउनू। त्यसको दक्षिणी भाग एक सय क्यूबिट लामो बनाउनू र त्यसमा मसिनो गरी बाटेको सुती कपडाको पर्दा बनाउनू।<verse eid="EXO 27:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 27:10"/>त्यस पर्दाका लागि बीस वटा खम्बा र काँसाका बीस वटा आधारहरू बनाउनू; अनि ती खम्बाहरूमा चाँदीका अङ्कुसेहरू र फित्ताहरू हुनुपर्छ।<verse eid="EXO 27:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 27:11"/>उत्तरको भाग पनि एक सय क्यूबिट लामो र त्यसमा पर्दाहरू हुनुपर्छ; अनि ती पर्दाहरूका लागि बीस वटा खम्बाहरू र काँसाका बीस वटा आधारहरू र ती खम्बाहरूमा चाँदीका अङ्कुसे र फित्ताहरू हुनुपर्छ।<verse eid="EXO 27:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 27:12"/>“आँगनको पश्‍चिमी भागका पर्दाहरू पचास क्यूबिट चौडा हुनुपर्छ। त्यसमा दश वटा खम्बाहरू र दश वटा आधारहरू हुनुपर्छ।<verse eid="EXO 27:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 27:13"/>पूर्वतिर, सूर्योदयतर्फ पनि पचास क्यूबिट चौडा हुनुपर्छ।<verse eid="EXO 27:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 27:14"/>मूलढोकाको एकापट्टिका पर्दाहरू पन्ध्र क्यूबिट लामा हुनुपर्छ; जसका तीन वटा खम्बाहरू र तीन वटा आधारहरू हुनुपर्छ,<verse eid="EXO 27:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 27:15"/>अनि तीन वटा खम्बाहरू र तीन वटा आधार भएका पन्ध्र क्यूबिट लामा पर्दाहरू अर्कोतिर होऊन्।<verse eid="EXO 27:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 27:16"/>“आँगनको प्रवेशद्वारका लागि चार वटा खम्बाहरू र चार वटा आधारहरू भएका, निलो, बैजनी, रातो रङ्गको धागो र मसिनो बाटेको सुती कपडामा बुट्टा भर्नेको शिल्पकारी भएको बीस क्यूबिट लामो एउटा पर्दा बनाउनू।<verse eid="EXO 27:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 27:17"/>आँगनको चारैतिरका सबै खाँबाहरूमा चाँदीका अङ्कुसे र फित्ता र काँसाका आधारहरू बनाउनू।<verse eid="EXO 27:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 27:18"/>आँगन एक सय क्यूबिट लामो र पचास क्यूबिट चौडा हुनुपर्छ; त्यसमा काँसाका आधार भएका मसिनो बाटेका सुती कपडाका छ क्यूबिट अग्ला पर्दाहरू हुनुपर्छ।<verse eid="EXO 27:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 27:19"/>समागम पालको सेवामा प्रयोग गरिने सबै सामानहरू, पालका किलाहरू, आँगनका किलाहरू लगायत सबै, चाहे तिनीहरूका काम जेसुकै होस्, ती काँसाका हुनुपर्छ।<verse eid="EXO 27:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 27:20"/>“इस्राएलीहरूलाई आज्ञा दिनू, कि तिनीहरूले उज्यालोका निम्ति पेलेको जैतुनको शुद्ध तेल ल्याऊन्, र दियाहरू निरन्तर बलिरहून्।<verse eid="EXO 27:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 27:21"/>भेट हुने पालमा, साक्षी पाटीको सामु भएको पर्दा बाहिर हारून र त्यसका छोराहरूले याहवेहको सामु साँझदेखि बिहानसम्मै दियाहरू बलिरहने बनाउनुपर्छ। यो इस्राएलीहरूका बीचमा आउने पुस्ताहरूका निम्ति सदा रहिरहने विधि हुनुपर्छ।<verse eid="EXO 27:21"/></para>
<chapter eid="EXO 27"/>
<chapter number="28" style="c" sid="EXO 28"/>
<para style="p"><verse number="1" style="v" sid="EXO 28:1"/>“इस्राएलीहरूका बीचबाट तेरा दाजु हारून र त्यसका छोराहरू नादाब, अबीहू, एलाजार अनि ईतामार पुजारी भई मेरो सेवा गर्न भनेर तँकहाँ बोला।<verse eid="EXO 28:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 28:2"/>तेरा दाजु हारूनलाई मर्यादा र सम्मान दिनलाई त्यसका निम्ति पवित्र पोशाकहरू बनाउनू।<verse eid="EXO 28:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 28:3"/>मैले यस्ता कामका लागि बुद्धि दिएका सबै दक्ष मानिसहरूलाई भन् कि तिनीहरूले हारूनलाई पुजारी भई मेरो सेवा गर्न नियुक्त गर्नका लागि पोशाकहरू बनाऊन्।<verse eid="EXO 28:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 28:4"/>तिनीहरूले बनाउनुपर्ने पोशाकहरू यिनै हुन्: छाती-पाता, एपोद, अलखा, बुनेको कुर्ता, फेटा र पटुका। तिनीहरूले यी पवित्र पोशाकहरू तेरा दाजु हारून र त्यसका छोराहरूका निम्ति पुजारी भई मेरो सेवा गर्नका लागि बनाउनुपर्छ।<verse eid="EXO 28:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 28:5"/>तिनीहरूले सुन, निलो, बैजनी र रातो धागो अनि मसिनो सुती कपडा चलाऊन्।<verse eid="EXO 28:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 28:6"/>“एपोदचाहिँ सुन, निलो, बैजनी र रातो धागोका अनि मसिनो बाटेको सुती कपडाका सिपालु शिल्पकारको काम भएको बनाउनू।<verse eid="EXO 28:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 28:7"/>त्यसमा दुई कुनामा जोडिएका अनि बाँध्न सकिने काँधका दुई वटा टुक्राहरू हुनुपर्छ।<verse eid="EXO 28:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 28:8"/>त्यसको सिपालु गरी बुनेको पटुका अनि एपोदसित एउटै भएको, र त्यो सुन अनि निलो, बैजनी र रातो धागो अनि मसिनोसित बाटेको सुती कपडाले बनिएको हुनुपर्छ।<verse eid="EXO 28:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 28:9"/>“दुई वटा गोमेद पत्थर लिएर त्यसमा इस्राएलका छोराहरूका नाम खोप्नू।<verse eid="EXO 28:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 28:10"/>ती तिनीहरूका जन्मअनुसार एउटा पत्थरमा छ वटा नामहरू र अर्कोमा बाँकी रहेका नामहरू खोप्नू।<verse eid="EXO 28:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 28:11"/>इस्राएलका छोराहरूका नाम ती दुई पत्थरहरूमा शिल्पकारले जसरी छाप खोप्छ, त्यसरी नै खोप्नू। त्यसपछि ती पत्थरहरूलाई सुनका मणिघरमा राख्नू।<verse eid="EXO 28:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 28:12"/>तिनीहरूलाई इस्राएलका छोराहरूका निम्ति सम्झना गराउने पत्थरझैँ एपोदका काँधे-जोर्नीहरूमा कसिदिनू। हारूनले ती नामहरू सम्झनाझैँ याहवेहको सामु आफ्नो काँधमा बोक्नुपर्छ।<verse eid="EXO 28:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 28:13"/>सुनका मणिघर बनाउनू<verse eid="EXO 28:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 28:14"/>र निखुर सुनका डोरीझैँ बाटेका दुई वटा सिक्रीहरू बनाएर ती सिक्रीहरूलाई सुनका मणिघरमा जोड्नू।<verse eid="EXO 28:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 28:15"/>“न्याय गर्नका लागि एउटा छाती-पाता दक्ष शिल्पकारद्वारा बनाउनू। त्यसलाई एपोदझैँ सुनको, निलो, बैजनी र रातो धागो अनि मसिनो गरी बाटेको सुती कपडाको बनाउनू।<verse eid="EXO 28:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 28:16"/>त्यो एक बित्ता लामो र एक बित्ता चौडा, वर्गाकार, दोबर पट्याइएर बनाउनू।<verse eid="EXO 28:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 28:17"/>त्यसपछि त्यसमा चार पङ्‌क्ति बहुमूल्य पत्थरहरू जोड्नू। पहिलो पङ्‌क्तिमा माणिक, पुष्पराज र पन्‍ना;<verse eid="EXO 28:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 28:18"/>दोस्रो पङ्‌क्तिमा फिरोजा, नीलमणि र हीरा;<verse eid="EXO 28:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 28:19"/>तेस्रो पङ्‌क्तिमा धूम्रकान्त, सूर्यकान्त र नीलमणि;<verse eid="EXO 28:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 28:20"/>र चौथो पङ्‌क्तिमा फिरोज, गोमेद र स्फटिक लगाउनू। अनि ती सुनको मणिघरहरूमा जड्नू।<verse eid="EXO 28:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 28:21"/>बाह्र पत्थरहरूमा इस्राएलका बाह्र कुलहरू जनाउन प्रत्येकमा छापमा खोपेझैँ एक-एक गरी इस्राएलका छोराहरूका नाम हुनुपर्छ।<verse eid="EXO 28:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 28:22"/>“छाती-पाताको निम्ति डोरीजस्तो निखुर सुनको बाटेका सिक्रीहरू बनाउनू।<verse eid="EXO 28:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 28:23"/>त्यसका लागि सुनका दुई वटा मुन्द्राहरू बनाएर छाती-पाताको दुई किनारमा बाँध्नू।<verse eid="EXO 28:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 28:24"/>सुनका ती दुई सिक्रीहरूलाई छाती-पाताको किनारका मुन्द्रीमा बाँध्नू,<verse eid="EXO 28:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 28:25"/>अनि सिक्रीका अरू छेउहरूलाई अगिल्तिर भएको एपोदका काँधे-जोर्नीहरूका अगाडिपट्टि मिलाएर दुवैलाई सुनका मणिघरहरूमा बाँध्नू।<verse eid="EXO 28:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 28:26"/>सुनका दुई वटा मुन्‍द्रा बनाएर एपोदको अर्का दुई भित्री किनारमा भएको छाती-पाताको अर्का छेउहरूमा लगाउनू।<verse eid="EXO 28:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 28:27"/>सुनका अझ अरू दुई वटा मुन्द्रीहरू बनाएर एपोदको अगाडिपट्टि पटुकाको ठिक माथि जोडिएको भागको नजिक, काँधे टुक्राको फेदमा लगाइदिनू।<verse eid="EXO 28:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 28:28"/>छाती-पाताका मुन्द्राहरूलाई, छाती-पाता एपोदबाट नहल्‍लिओस् भनेर त्यसलाई कम्मरको पटुकासित जोडेर एपोदको मुन्द्रीसित निलो डोरीले बाँध्नू।<verse eid="EXO 28:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 28:29"/>“जहिले-जहिले हारून पवित्रस्थानमा प्रवेश गर्नेछ, त्यसले याहवेहको सामु सधैँको सम्झनाको रूपमा इस्राएलका छोराहरूका नाम आफ्नो हृदयमा निर्णयको छाती-पातामा राख्नेछ।<verse eid="EXO 28:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 28:30"/>जहिले-जहिले हारून याहवेहको उपस्थितिमा पस्‍नेछ, ऊरीम र तुम्मीम पनि त्यसको हृदयमा रहोस् भनेर तिनलाई पनि छाती-पातामा लगाउनू। यसरी हारूनले इस्राएलीहरूको निर्णय लिने साधनलाई याहवेहको सामु सधैँ आफ्नो हृदयमाथि बोक्नेछ।<verse eid="EXO 28:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 28:31"/>“एपोदको अलखा सबै निलो कपडाको बनाउनू।<verse eid="EXO 28:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 28:32"/>त्यसको बीचमा टाउको छिराउनको लागि खुला भाग राख्नू। त्यो नफाटोस् भनेर त्यस खुला भागको चारैतिर बुनेको बिट होस्।<verse eid="EXO 28:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 28:33"/>लबेदाको बिटको चारैतिर बीच-बीचमा सुनको घण्टी राखेर निलो, बैजनी र रातो धागोका दारिमहरू बनाउनू।<verse eid="EXO 28:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 28:34"/>सुनका घण्टीहरू र दारिमहरू एउटाको पछि अर्को गरेर लबेदाको बिटको चारैतिर होऊन्।<verse eid="EXO 28:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 28:35"/>हारूनले सेवा गर्दा त्यो लगाउनैपर्छ। ऊ याहवेहको उपस्थितिमा पवित्रस्थानभित्र पस्दा र बाहिर निस्कँदा, ती घण्टीहरूका आवाज सुनियोस् र हारून नमरोस्।<verse eid="EXO 28:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 28:36"/>“तैँले निखुर सुनको एउटा पाता बनाएर औँठीको छापमा खोप्नूः याहवेहका निम्ति पवित्र।<verse eid="EXO 28:36"/></para>
<para style="p"><verse number="37" style="v" sid="EXO 28:37"/>त्यसलाई फेटामा लगाउनको लागि त्यसमा निलो डोरी कस्‍नू। यो टोपीको अगिल्तिर होस्।<verse eid="EXO 28:37"/></para>
<para style="p"><verse number="38" style="v" sid="EXO 28:38"/>यो हारूनको निधारमा हुनेछ, र इस्राएलीहरूले जुनसुकै भेटी चढाए पनि तिनीहरूले पवित्र भेटीहरू चढाएको काममा रहेको दोष हारूनले बोक्नेछ। तिनीहरू याहवेहकहाँ ग्रहणयोग्य होऊन् भनेर त्यो सधैँ हारूनको निधारमा रहनेछ।<verse eid="EXO 28:38"/></para>
<para style="p"><verse number="39" style="v" sid="EXO 28:39"/>“लबेदा मसिनो सुती कपडाले बुन्‍नू र टोपी मसिनो सुती कपडाको बनाउनू। पटुका बुट्टा भर्नेले गरेको काम हुनुपर्दछ।<verse eid="EXO 28:39"/></para>
<para style="p"><verse number="40" style="v" sid="EXO 28:40"/>हारूनका छोराहरूका निम्ति तिनीहरूलाई मर्यादा र सम्मान दिनलाई लबेदा, पटुका र टोपी बनाउनू।<verse eid="EXO 28:40"/></para>
<para style="p"><verse number="41" style="v" sid="EXO 28:41"/>तैँले आफ्ना दाजु हारून र त्यसका छोराहरूलाई यी वस्त्रहरू लगाइदिएपछि तिनीहरूलाई अभिषेक गरी नियुक्त गर्नू। तिनीहरूले पुजारी भई मेरो सेवा गरून् भनेर तिनीहरूलाई अर्पण गर्नू।<verse eid="EXO 28:41"/></para>
<para style="p"><verse number="42" style="v" sid="EXO 28:42"/>“शरीर ढाक्नलाई कम्मरदेखि जाँघसम्म पुग्ने सुतीका भित्री पोशाकहरू बनाउनू।<verse eid="EXO 28:42"/></para>
<para style="p"><verse number="43" style="v" sid="EXO 28:43"/>हारून र त्यसका छोराहरू जहिले-जहिले समागम पालभित्र पस्छन् अथवा पवित्रस्थानमा सेवा गर्न वेदीको छेउमा जान्छन्, ती लगाऊन्, ताकि तिनीहरू दोष लागेर नमरून्। “यो हारून र त्यसका सन्ततिका निम्ति सधैँ रहिरहने धार्मिक विधि हुनेछ।<verse eid="EXO 28:43"/></para>
<chapter eid="EXO 28"/>
<chapter number="29" style="c" sid="EXO 29"/>
<para style="p"><verse number="1" style="v" sid="EXO 29:1"/>“तिनीहरूले पुजारी भई मेरो सेवा गरून् भनेर तिनीहरूलाई यसरी अर्पण गर्नू: एउटा बहर र दुई वटा निष्खोट भेडाहरू ल्याउनू।<verse eid="EXO 29:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 29:2"/>अनि गहुँको मसिनो पिठोबाट खमिर नमिसाइएको रोटी र जैतुन तेल मिसाइएको अखमिरी बाबर र तेल छर्केको पातलो अखमिरी रोटी बनाउनू।<verse eid="EXO 29:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 29:3"/>तिनीहरूलाई एउटा टोकरीमा हाल्नू, र त्यो बहर र दुई वटा भेडाहरूसहित ल्याउनू।<verse eid="EXO 29:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 29:4"/>त्यसपछि हारून र तिनका छोराहरूलाई भेट हुने पालको प्रवेशद्वारमा ल्याउनु र तिनीहरूलाई पानीले नुहाइदिनू।<verse eid="EXO 29:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 29:5"/>पोशाकहरू लिएर हारूनलाई लबेदा, एपोदको पोशाक, एपोद र छाती-पाता लगाइदिनू। निपूर्णतासित बुट्टा काढेको पटुकाले त्यसको शरीरमा एपोद बाँधिदिनू।<verse eid="EXO 29:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 29:6"/>त्यसको शिरमा फेटा लगाएर त्यसमा पवित्र मुकुट लगाइदिनू।<verse eid="EXO 29:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 29:7"/>त्यसपछि अभिषेक गर्ने तेल लिएर त्यसको शिरमा त्यो खन्याएर त्यसलाई अभिषेक गर्नू।<verse eid="EXO 29:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 29:8"/>अनि त्यसका छोराहरूलाई ल्याएर तिनीहरूलाई लबेदा पहिर्‍याइदिनू,<verse eid="EXO 29:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 29:9"/>र तिनीहरूलाई शिरमा फेटा लगाइदिनू। त्यसपछि हारून र त्यसका छोराहरूलाई पटुका बाँधिदिनू। सदाको धार्मिक विधिद्वारा पुजारी पद तिनीहरूकै हुनेछ। “यसरी तैँले हारून र त्यसका छोराहरूलाई अभिषेक गर्नू।<verse eid="EXO 29:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 29:10"/>“त्यस बहरलाई भेट हुने पालको सामु ल्याउनू; अनि हारून र त्यसका छोराहरूले त्यसमाथि आफ्ना हात राख्नेछन्।<verse eid="EXO 29:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 29:11"/>बहरलाई याहवेहको उपस्थितिमा भेट हुने पालको प्रवेशद्वारमा बलि चढाउनू।<verse eid="EXO 29:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 29:12"/>त्यस बहरको रगतबाट केही लिएर त्यसलाई तेरो औँलाले वेदीका सिङहरूमाथि लगाउनू, र बाँकी रहेको रगत वेदीको जगमा खन्याउनू।<verse eid="EXO 29:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 29:13"/>त्यसपछि भित्री अङ्गहरूका वरिपरि भएका सबै बोसो, कलेजोलाई छोप्ने जालो, र दुवै मिर्गौलाहरू र त्यसमाथि भएका बोसोसमेत लिएर वेदीमाथि जलाउनू।<verse eid="EXO 29:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 29:14"/>तर बहरको मासु, त्यसको छाला र त्यसको गोबर छाउनी बाहिर जलाउनू। यो पाप शुद्धीकरण बलि हो।<verse eid="EXO 29:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 29:15"/>“ती दुई बोकाहरूमध्ये एउटा बोका लिनू, र हारून र त्यसका छोराहरूले त्यसको शिरमाथि हात राख्नेछन्।<verse eid="EXO 29:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 29:16"/>भेडालाई मार्नू र त्यसको रगत लिएर त्यसलाई वेदीको चारैतिर भित्तामा छर्कनू।<verse eid="EXO 29:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 29:17"/>त्यस भेडालाई टुक्रा-टुक्रा गरी काटेर त्यसका भित्री भागहरू र खुट्टाहरू धुनू, र तिनीहरूलाई टाउको र अरू टुक्राहरूसित राख्नू।<verse eid="EXO 29:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 29:18"/>त्यसपछि सम्पूर्ण भेडालाई वेदीमा जलाउनू। योचाहिँ याहवेहलाई मनपर्दो मिठो बास्‍ना भएको आगोद्वारा चढाइएको होमबलि हो।<verse eid="EXO 29:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 29:19"/>“तैँले अर्को भेडा लिनू, हारून र त्यसका छोराहरूले त्यसको शिरमा हात राख्नेछन्।<verse eid="EXO 29:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 29:20"/>त्यस भेडालाई मार्नू, त्यसबाट केही रगत लिएर हारून र त्यसका छोराहरूका दाहिने कानका लोतीमा, तिनीहरूका दाहिने हातका बूढी औँलामा, र दाहिने खुट्टाका बूढी औँलामा लगाउनू। त्यसपछि वेदीका चारै भित्तामा रगत छर्कनू।<verse eid="EXO 29:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 29:21"/>त्यसपछि वेदीको केही रगत र केही अभिषेक गर्ने तेल लिएर त्यसलाई हारून र त्यसका पोशाकहरूमा, त्यसका छोराहरू र तिनीहरूका पोशाकहरूमा छर्कनू। त्यसपछि त्यो, त्यसका छोराहरू र तिनीहरू सबैका पोशाकहरूसमेत पवित्र हुनेछन्।<verse eid="EXO 29:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 29:22"/>“त्यस भेडाबाट बोसो, बोसे पुच्छर, भित्री भागहरूलाई छोप्ने बोसो, कलेजो बाहिरको जाली, दुवै मिर्गौलाहरू र तिनीहरूमाथिका बोसोसमेत र दाहिने फिला लिनू। (यो भेडा अर्पणका लागि हो।)<verse eid="EXO 29:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 29:23"/>याहवेहको सामु राखिएको टोकरीको खमिर नमिसाइएको रोटीबाट एउटा, र तेलमा पोलेको एउटा बाबर अनि एउटा फुलौरो लिनू।<verse eid="EXO 29:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 29:24"/>यी सबैलाई हारून र त्यसका छोराहरूका हातमा विशेष भेटीको रूपमा उचालिनका लागि याहवेहको सामु ल्याउनू।<verse eid="EXO 29:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 29:25"/>त्यसपछि ती सबैलाई उनीहरूका हातबाट लिएर होमबलिका निम्ति याहवेहका लागि मनपर्दो बास्‍नाका निम्ति आगोद्वारा चढाइएको भेटीका साथमा वेदीमाथि जलाइदिनू।<verse eid="EXO 29:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 29:26"/>अनि तैँले हारूनको निम्ति हुने अर्पणका निम्ति भेडाको ह्‍याकुला लिनू, र त्यसलाई विशेष भेटीको रूपमा उचालिनका निम्ति याहवेहको सामु ल्याउनू, र त्यो तेरो भाग हुनेछ।<verse eid="EXO 29:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 29:27"/>“अर्पण गर्ने भेडाका ती भागहरू, जुन हारून र त्यसका छोराहरूका भाग हुन्, ती अर्पण गर्नू: डोलाएको ह्‍याकुला र उचालिएको फिला।<verse eid="EXO 29:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 29:28"/>त्यो इस्राएलीहरूका तर्फबाट हारून र त्यसका छोराहरूका निम्ति नियमित भाग हो। यो इस्राएलीहरूले आफ्ना मेलबलिबाट याहवेहलाई चढाउनुपर्ने भाग हो।<verse eid="EXO 29:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 29:29"/>“हारूनका पवित्र पोशाकहरू त्यसका सन्ततिहरूका निम्ति हुनेछन्; ताकि तिनीहरू तिनै पोशाकहरूमा अभिषेक र अर्पण होऊन्।<verse eid="EXO 29:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 29:30"/>त्यसको पछि पुजारीको उत्तराधिकारी हुने छोराले पवित्रस्थानमा सेवा गर्न समागम पालमा आउँदा ती लुगाहरू सात दिनसम्म लगाओस्।<verse eid="EXO 29:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 29:31"/>“अर्पणको बोका लिएर त्यसको मासु एउटा पवित्र ठाउँमा पकाउनू।<verse eid="EXO 29:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 29:32"/>समागम पालको प्रवेशद्वारमा हारून र त्यसका छोराहरूले त्यस भेडाको मासु र टोकरीमा भएको रोटी खाऊन्।<verse eid="EXO 29:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 29:33"/>तिनीहरूले आफ्ना अभिषेक र अर्पणका लागि प्रायश्‍चित गरिएका ती भेटीहरू खाऊन्, तर अरू कसैले पनि ती नखाओस्; किनकि ती पवित्र हुन्।<verse eid="EXO 29:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 29:34"/>यदि अर्पणको बोकाको मासुको केही भाग अथवा केही रोटी बिहानसम्म उब्रियो भने त्यसलाई जलाइदिनू। त्यो खान हुँदैन; किनकि त्यो पवित्र छ।<verse eid="EXO 29:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 29:35"/>“तँलाई मैले दिएको आज्ञाबमोजिम हारून र त्यसका छोराहरूलाई सात दिन लगाएर नियुक्त गर्नू।<verse eid="EXO 29:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 29:36"/>प्रायश्‍चित गर्नका लागि प्रत्येक दिन पाप शुद्धीकरण बलिको रूपमा एउटा बहर बलिदान गर्नू। प्रायश्‍चित गरेर वेदीलाई शुद्ध गर्नू; त्यसलाई पवित्र गर्नका लागि अभिषेक गर्नू।<verse eid="EXO 29:36"/></para>
<para style="p"><verse number="37" style="v" sid="EXO 29:37"/>सात दिनसम्म वेदीको लागि प्रायश्‍चित गर्नू र त्यसलाई पवित्र पार्नू, तब वेदी महा-पवित्र हुनेछ; अनि त्यसलाई छुने जेसुकै पनि पवित्र हुनेछ।<verse eid="EXO 29:37"/></para>
<para style="p"><verse number="38" style="v" sid="EXO 29:38"/>“तैँले वेदीमा प्रत्येक दिन नियमित रूपले चढाउनुपर्ने कुराहरू यिनै हुन्: एकवर्षे दुई वटा थुमाहरू।<verse eid="EXO 29:38"/></para>
<para style="p"><verse number="39" style="v" sid="EXO 29:39"/>एउटा थुमा बिहान र अर्को थुमा साँझमा चढाउनू।<verse eid="EXO 29:39"/></para>
<para style="p"><verse number="40" style="v" sid="EXO 29:40"/>पहिलो थुमाको साथमा एपाको दशौँ भाग मसिनो पिठोसित पेलिएको जैतुनको चौथाइ हिन तेल मिसाएर अनि अर्घबलिको रूपमा चौथाइ हिन दाखमद्य चढाउनू।<verse eid="EXO 29:40"/></para>
<para style="p"><verse number="41" style="v" sid="EXO 29:41"/>अर्को थुमालाई पनि साँझमा बिहानजस्तै अन्‍नबलि र अर्घबलिका साथमा चढाउनू—जुन याहवेहलाई मनपर्दो बास्‍नाको रूपमा आगोद्वारा चढाइएको बलि होस्।<verse eid="EXO 29:41"/></para>
<para style="p"><verse number="42" style="v" sid="EXO 29:42"/>“आउने पुस्ताका लागि यो होमबलि भेट हुने समागम पालको प्रवेशद्वारमा याहवेहका निम्ति नियमित रूपले चढाइयोस्। त्यहाँ म तँलाई भेट्नेछु, र तँसित बोल्नेछु;<verse eid="EXO 29:42"/></para>
<para style="p"><verse number="43" style="v" sid="EXO 29:43"/>त्यहाँ म इस्राएलीहरूसित पनि भेट गर्नेछु, र त्यो ठाउँ मेरो महिमाले पवित्र हुनेछ।<verse eid="EXO 29:43"/></para>
<para style="p"><verse number="44" style="v" sid="EXO 29:44"/>“यसरी म समागम पाललाई र वेदीलाई पवित्र पार्नेछु; अनि मेरो निम्ति पुजारी भई सेवा गर्नलाई हारून र त्यसका छोराहरूलाई पवित्र गर्नेछु।<verse eid="EXO 29:44"/></para>
<para style="p"><verse number="45" style="v" sid="EXO 29:45"/>तब म इस्राएलीहरूका बीचमा बास गर्नेछु र तिनीहरूका परमेश्‍वर हुनेछु।<verse eid="EXO 29:45"/></para>
<para style="p"><verse number="46" style="v" sid="EXO 29:46"/>म तिनीहरूबीच बास गरूँ भनेर तिनीहरूलाई इजिप्टबाट निकालेर ल्याउने म याहवेह नै तिनीहरूका परमेश्‍वर हुँ भनी तिनीहरूले जान्‍नेछन्। म याहवेह नै तिनीहरूका परमेश्‍वर हुँ।<verse eid="EXO 29:46"/></para>
<chapter eid="EXO 29"/>
<chapter number="30" style="c" sid="EXO 30"/>
<para style="p"><verse number="1" style="v" sid="EXO 30:1"/>“तैँले धूप बाल्नलाई बबुल काठको एउटा वेदी बनाउनू।<verse eid="EXO 30:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 30:2"/>त्यो वर्गाकार होस्। त्यो एक क्यूबिट लामो, एक क्यूबिट चौडा, र दुई क्यूबिट उचाइ होस्। त्यसका सिङहरू त्यससित एउटै टुक्राको होस्।<verse eid="EXO 30:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 30:3"/>त्यसको टुप्पो र सबै भित्ताहरू र सिङहरूलाई निखुर सुनले मोहोर्नू; अनि त्यसको चारैतिर सुनको बिट बनाउनू।<verse eid="EXO 30:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 30:4"/>वेदीलाई बोक्ने डण्डाहरू अड्काउनलाई बिटको मुन्तिर दुवैतिर दुई वटा मुन्द्राहरू बनाउनू।<verse eid="EXO 30:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 30:5"/>ती डण्डाहरू बबुल काठका बनाउनू र तिनीहरूलाई सुनले मोहोर्नू।<verse eid="EXO 30:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 30:6"/>वेदीलाई साक्षी पाटीको सन्दुकको अगिल्तिर भएको पर्दाको सामु राख्नू। साक्षी पाटीको माथि रहेको पाप समाधान-स्थानको सामु, जहाँ म तँसित भेट गर्नेछु।<verse eid="EXO 30:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 30:7"/>“हारूनले प्रत्येक बिहान बत्तीहरू मिलाउँदा वेदीमा सुगन्धित धूप जलाओस्।<verse eid="EXO 30:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 30:8"/>त्यसले साँझमा बत्तीहरू बाल्दा फेरि धूप जलाओस् र आउने पुस्ताहरूका लागि याहवेहको सामु धूप नियमित रूपले जल्नेछ।<verse eid="EXO 30:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 30:9"/>त्यस वेदीमा अरू कुनै किसिमका धूप अथवा होमबलि अथवा अन्‍नबलि नचढाउनू र त्यसमाथि कुनै अर्घबलि पनि नचढाउनू।<verse eid="EXO 30:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 30:10"/>हारूनले वर्षमा एक पल्ट सिङहरूमा प्रायश्‍चित गर्नेछ। यो वार्षिक प्रायश्‍चित आउने पुस्ता-पुस्ताका लागि प्रायश्‍चितको पाप शुद्धीकरण बलिको रगतसित गरिनुपर्छ। याहवेहका निम्ति यो अति पवित्र हो।”<verse eid="EXO 30:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 30:11"/>त्यसपछि याहवेहले मोशालाई भन्‍नुभयो,<verse eid="EXO 30:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 30:12"/>“जब तैँले इस्राएलीहरूको गन्ती लिनलाई तिनीहरूको जनगणना गर्नेछस्, तब प्रत्येकले आफ्नो गन्तीको समयमा त्यसको प्राणका लागि याहवेहलाई छुटकाराको मोल तिरोस्। तब तैँले तिनीहरूलाई गन्ती गर्दा तिनीहरूमाथि कुनै विपत्ति आउनेछैन।<verse eid="EXO 30:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 30:13"/>हरेक जो गन्ती भइसकेकाहरूपट्टि पार गरेर जान्छ, त्यसले पवित्रस्थानको शेकेलको हिसाबले आधा शेकेल दिनुपर्नेछ (एक शेकेल बराबर बीस गेरा हुन्छ)। त्यो आधा शेकेल याहवेहका निम्ति भेटी हो।<verse eid="EXO 30:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 30:14"/>बीस वर्ष र त्योभन्दा बढी उमेर पुगेका जति जना गनिन्छन्, सबैले याहवेहका निम्ति भेटी देऊन्।<verse eid="EXO 30:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 30:15"/>तिमीहरूले आफ्नो प्रायश्‍चितका लागि याहवेहलाई भेटी चढाउँदा धनीहरूले आधा शेकेलभन्दा बढी र गरिबहरूले त्योभन्दा कम नदेओस्।<verse eid="EXO 30:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 30:16"/>इस्राएलीहरूबाट प्रायश्‍चितको रकम लिएर त्यसलाई भेट हुने पालको सेवाका निम्ति प्रयोग गर्नू। तिमीहरूले आफ्नो प्राणको प्रायश्‍चित गर्दा याहवेहको सामु इस्राएलीहरूका निम्ति यो एउटा सम्झनास्वरूप हुनेछ।”<verse eid="EXO 30:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 30:17"/>तब याहवेहले मोशालाई भन्‍नुभयो,<verse eid="EXO 30:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 30:18"/>“धुनको लागि काँसोको खुट्टा भएको काँसोका धुने बाटा बनाउनू। त्यसलाई समागम पाल र वेदीको बीचमा राखेर त्यसमा पानी भर्नू।<verse eid="EXO 30:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 30:19"/>हारून र त्यसका छोराहरूले त्यसमा भएको पानीले आफ्ना हातगोडा धोऊन्।<verse eid="EXO 30:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 30:20"/>जब तिनीहरू समागम पालभित्र पस्छन्, तब हातगोडा धोएर मात्र पसून्, ताकि तिनीहरू नमरून्। साथै, जब तिनीहरू वेदीनेर सेवा गर्नलाई याहवेहका निम्ति अग्निबलि जलाउनलाई आउँछन्,<verse eid="EXO 30:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 30:21"/>तब तिनीहरूले पानीले हातगोडा धोऊन्, र तिनीहरू नमरून्। यो हारून र त्यसका सन्ततिका निम्ति तिनीहरूका पुस्ता-पुस्तासम्मका निम्ति अनन्तको धार्मिक विधि होस्।”<verse eid="EXO 30:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 30:22"/>तब याहवेहले मोशालाई भन्‍नुभयो,<verse eid="EXO 30:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 30:23"/>“निम्न लिखित असल मसाला लिनू: पाँच सय शेकेल तरल मूर्र, त्यसको आधा अथवा दुई सय पचास शेकेल बास्‍ना आउने दालचिनी, दुई सय पचास शेकेल सुगन्धित बोझो,<verse eid="EXO 30:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 30:24"/>पाँच सय शेकेल तेजपात। सबै समागम पालको शेकेलको हिसाबले, र एक हिन जैतुनको तेल।<verse eid="EXO 30:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 30:25"/>यी सबैबाट अभिषेकको पवित्र तेल बनाउनू, र बनाउने सिपालु व्यक्तिले बनाएको बास्‍नायुक्त होस्। त्यो अभिषेक गर्ने पवित्र तेल हुनेछ।<verse eid="EXO 30:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 30:26"/>तब त्यस तेललाई समागम पाल, साक्षीको सन्दुक,<verse eid="EXO 30:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 30:27"/>टेबुल र त्यसमा भएका सम्पूर्ण सामग्रीहरू, सामदान र त्यसका अरू उपकरणहरू, धूपको वेदी,<verse eid="EXO 30:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 30:28"/>अनि होमबलिको वेदी र त्यसका सबै भाँडाहरू र बाटा, र त्यसलाई उभ्याउने चीजसमेत सबैलाई अभिषेक गर्नलाई प्रयोग गर्नू।<verse eid="EXO 30:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 30:29"/>तैँले यी सबै कुराहरू पवित्र गर्नू, र तिनीहरू अति पवित्र हुनेछन्। जेसुकैले तिनीहरूलाई छोए तापनि त्यो पवित्र हुनेछ।<verse eid="EXO 30:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 30:30"/>“हारून र त्यसका छोराहरूलाई अभिषेक गरेर पवित्र गर्नू, र तिनीहरूले पुजारी भई मेरो सेवा गरून्।<verse eid="EXO 30:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 30:31"/>इस्राएलीहरूलाई भन्, ‘यो आउने पुस्ताहरूका लागि मेरो पवित्र अभिषेकको तेल होस्।<verse eid="EXO 30:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 30:32"/>यसलाई अरू कुनै मानिसहरूका शरीरहरूमा नखन्याउनू र यही तरिकाले कुनै तेल नबनाउनू। यो पवित्र हो, र तैँले यसलाई पवित्र ठान्‍नू।<verse eid="EXO 30:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 30:33"/>जसले यस्तै सुगन्धित तेल बनाउँछ र जसले यसलाई पुजारीबाहेक अरूमाथि लगाउँछ, त्यसलाई आफ्ना मानिसहरूबाट बहिष्कार गरिनुपर्छ।’ ”<verse eid="EXO 30:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 30:34"/>तब याहवेहले मोशालाई भन्‍नुभयो, “सुगन्धित मसलाहरू—कुन्द, धूप, नखी र सालधूप—अनि शुद्ध मूर्र सबै एकै परिमाणमा लिनू,<verse eid="EXO 30:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 30:35"/>अनि अत्तर बनाउनमा सिपालु व्यक्तिद्वारा सुगन्धित धूप बनाउनू। त्यसमा नुन हाल्नुपर्छ, र त्यो शुद्ध र पवित्र हुनुपर्छ।<verse eid="EXO 30:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 30:36"/>त्यसको केही भाग पिँधेर पिठो बनाउनू, र त्यसलाई समागम पालको साक्षी पाटीको सामु राख्नू, जहाँ म तँलाई भेट्नेछु। यो तेरा निम्ति अति पवित्र हुनेछ।<verse eid="EXO 30:36"/></para>
<para style="p"><verse number="37" style="v" sid="EXO 30:37"/>यस तरिकाले तिमीहरूले आफ्नो निम्ति कुनै धूप नबनाउनू; यसलाई याहवेहका निम्ति पवित्र ठान्‍नू।<verse eid="EXO 30:37"/></para>
<para style="p"><verse number="38" style="v" sid="EXO 30:38"/>जसले यस सुगन्धको आनन्द लिनलाई यस्तो बनाउँछ, त्यसलाई आफ्ना मानिसहरूबाट बहिष्कार गरिनुपर्छ।”<verse eid="EXO 30:38"/></para>
<chapter eid="EXO 30"/>
<chapter number="31" style="c" sid="EXO 31"/>
<para style="p"><verse number="1" style="v" sid="EXO 31:1"/>तब याहवेहले मोशालाई भन्‍नुभयो,<verse eid="EXO 31:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 31:2"/>“हेर्, मैले यहूदा कुलको हूरको नाति ऊरीको छोरा बजलेललाई चुनेको छु।<verse eid="EXO 31:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 31:3"/>अनि मैले त्यसलाई मेरो आत्मा, बुद्धि, समझ, ज्ञान र कारिगरीका सबै दक्षताले भरेको छु।<verse eid="EXO 31:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 31:4"/>त्यसले सुन, चाँदी र काँसोका कामहरू,<verse eid="EXO 31:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 31:5"/>पत्थर काटेर जड्ने काम, काठको काम, र सबै किसिमका कारिगरी गर्नेछ।<verse eid="EXO 31:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 31:6"/>यसबाहेक त्यसलाई सघाउन भनी मैले दानको कुलको अहीसामाकको छोरा ओहोलीआबलाई नियुक्त गरेको छु। “मैले तँलाई आज्ञा गरेका सबै कुरा बनाउनलाई सबै दक्ष कामदारहरूलाई पनि मैले सिप दिएको छु:<verse eid="EXO 31:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 31:7"/>“समागम पाल, साक्षी पाटीको सन्दुक, र त्यसमाथि भएको पाप समाधान-स्थान, र पालका अरू सबै सामग्रीहरू—<verse eid="EXO 31:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 31:8"/>टेबुल र त्यसका सामग्रीहरू, निखुर सुनको सामदान र त्यसका सबै सामग्रीहरू, धूपको वेदी,<verse eid="EXO 31:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 31:9"/>होमबलिको वेदी र त्यसका सबै पात्रहरू, काँसोका बाटा र त्यसलाई उभ्याउने सामानहरू—<verse eid="EXO 31:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 31:10"/>बुनेका पोशाकहरू पनि, हारून पुजारीका पवित्र पोशाकहरू, पुजारी भई सेवा गर्दा लगाउने तिनका छोराहरूका पोशाकहरू,<verse eid="EXO 31:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 31:11"/>अभिषेक गर्ने तेल र पवित्रस्थानको लागि सुगन्धित धूप। “मैले तँलाई आज्ञा गरेअनुसार नै तिनीहरूले यी सबै कुराहरू ठिकठिक बनाउनुपर्छ।”<verse eid="EXO 31:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 31:12"/>तब याहवेहले मोशालाई भन्‍नुभयो,<verse eid="EXO 31:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 31:13"/>“इस्राएलीहरूलाई भन्, ‘तिमीहरूले मेरो शब्बाथ पालन गर्नू। आउने पुस्ताहरूका लागि मेरो र तिमीहरू बीचको चिन्ह यो हुनेछ, ताकि तिमीहरूले जान्‍नेछौ कि म याहवेह हुँ, जसले तिमीहरूलाई पवित्र बनाउँछु।<verse eid="EXO 31:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 31:14"/>“ ‘शब्बाथ मान्‍नू; किनकि यो दिन तिमीहरूका लागि पवित्र छ। जसले यसलाई अपवित्र पार्छ, त्यो मारिनुपर्छ; जसले यस दिनमा काम गर्छ, त्यसलाई मानिसहरूबाट बहिष्कार गरिनुपर्छ।<verse eid="EXO 31:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 31:15"/>छ दिनसम्म काम गरिनुपर्छ, तर सातौँ दिनचाहिँ शब्बाथ विश्रामदिन हो, जुन याहवेहका निम्ति पवित्र छ। जसले शब्बाथ विश्रामदिनमा काम गर्छ, त्यो मारिनुपर्छ।<verse eid="EXO 31:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 31:16"/>इस्राएलीहरूले शब्बाथलाई आउने पुस्ताहरूका लागि सधैँको करारको रूपमा मनाउनुपर्छ।<verse eid="EXO 31:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 31:17"/>मेरो र इस्राएलीहरूको बीचमा यो अनन्तका लागि चिन्ह हुनेछ; किनकि याहवेहले छ दिनमा आकाश र पृथ्वी बनाउनुभयो; अनि सातौँ दिनमा उहाँले काम गर्नुभएन, तर आरामले विश्राम लिनुभयो।’ ”<verse eid="EXO 31:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 31:18"/>परमेश्‍वरले मोशासित सीनै पर्वतमा कुरा गरिसक्नुभएपछि उहाँका आफ्ना औँलाले लेखेका दुई वटा साक्षीका ढुङ्गा पाटीहरू उनलाई दिनुभयो।<verse eid="EXO 31:18"/></para>
<chapter eid="EXO 31"/>
<chapter number="32" style="c" sid="EXO 32"/>
<para style="p"><verse number="1" style="v" sid="EXO 32:1"/>जब मानिसहरूले मोशा पर्वतबाट आउन ढिलो गरेका देखे, तब तिनीहरू हारूनका वरिपरि भेला भएर भने, “उठ्नुहोस्, हाम्रा अगि-अगि जानलाई हाम्रा निम्ति देवी-देवताहरू बनाउनुहोस्। हामीलाई इजिप्टबाट बाहिर निकालेर ल्याउने यी मोशालाई के भयो, हामी जान्दैनौँ।”<verse eid="EXO 32:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 32:2"/>हारूनले तिनीहरूलाई जवाफ दिए, “तिमीहरूका पत्नीहरू र तिमीहरूका छोराछोरीहरूले लगाइराखेका कानका सुनका कुण्डलहरू फुकालेर मकहाँ ल्याओ।”<verse eid="EXO 32:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 32:3"/>यसकारण सबै मानिसहरूले आफ्ना कुण्डलहरू फुकालेर हारूनकहाँ ल्याए।<verse eid="EXO 32:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 32:4"/>तिनीहरूले दिएका ती चीजहरू हारूनले लिए, र त्यसलाई ढालेर हतियारले खोपेर त्यसबाट एउटा बाछाको मूर्ति बनाए। तब तिनीहरूले भने, “हे इस्राएल, तँलाई इजिप्टबाट निकालेर ल्याउने देवता यिनै हुन्।”<verse eid="EXO 32:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 32:5"/>जब हारूनले यो देखे, तिनले त्यस बाछाको सामु एउटा वेदी बनाएर घोषणा गरे, “भोलि याहवेहका निम्ति एउटा चाड हुनेछ।”<verse eid="EXO 32:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 32:6"/>यसकारण भोलिपल्ट मानिसहरूले बिहानै उठेर होमबलि चढाए र मेलबलि पनि ल्याए। त्यसपछि तिनीहरू खानपिन गर्न बसे, र मोज गर्न उठे।<verse eid="EXO 32:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 32:7"/>तब याहवेहले मोशालाई भन्‍नुभयो, “तल ओर्ली; किनकि तैँले इजिप्टबाट निकालेर ल्याएका तेरा मानिसहरू भ्रष्‍ट भएका छन्।<verse eid="EXO 32:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 32:8"/>मैले तिनीहरूलाई दिएका आज्ञाहरूबाट तिनीहरू चाँडै अर्कोतिर लागेका छन्; र तिनीहरूले आफ्ना लागि ढालिएको एउटा बाछाको रूपमा मूर्ति बनाएका छन्। तिनीहरूले त्यसलाई ढोगेर बलिहरू चढाएर भनेका छन्, ‘हे इस्राएल, तँलाई इजिप्टबाट निकालेर ल्याउने तेरा देवता यिनै हुन्।’<verse eid="EXO 32:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 32:9"/>“याहवेहले मोशालाई भन्‍नुभयो, ‘मैले यी मानिसहरूलाई देखेको छु; यिनीहरू हठी मानिसहरू हुन्।’<verse eid="EXO 32:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 32:10"/>अब मलाई नरोक्, र मेरो क्रोध यिनीहरूका विरुद्धमा दन्कियोस्, र म यिनीहरूलाई भस्म पार्नेछु। तब म तँबाट नै एउटा महान् जाति बनाउनेछु।”<verse eid="EXO 32:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 32:11"/>तर मोशाले याहवेह आफ्ना परमेश्‍वरबाट कृपा मागेर भने, “हे याहवेह, तपाईंले महान् शक्ति र सामर्थी हातले इजिप्टबाट ल्याउनुभएको आफ्नो जातिको विरुद्धमा तपाईंको क्रोध किन यति साह्रो दन्केको छ?<verse eid="EXO 32:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 32:12"/>‘उहाँले तिनीहरूलाई पहाडी ठाउँहरूमा मारेर यस पृथ्वीबाट तिनीहरूको नामनिशानै मेटिदिने नराम्रो विचार लिएर तिनीहरूलाई निकालेर ल्याउनुभयो,’ भनेर इजिप्टियनहरूले किन भन्‍न पाऊन्? तपाईंको भयानक क्रोध त्याग्नुहोस्; शान्त हुनुहोस्, र आफ्ना जातिमाथि विपत्ति नल्याउनुहोस्।<verse eid="EXO 32:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 32:13"/>तपाईंका सेवकहरू अब्राहाम, इसहाक र याकोबलाई सम्झनुहोस्, जसलाई तपाईंले यसो भनी आफ्नै नाममा शपथ खानुभएको थियो: ‘म तेरा सन्ततिलाई आकाशका ताराहरूझैँ धेरै बनाउनेछु, र मैले तिनीहरूसित प्रतिज्ञा गरेको देश दिनेछु; अनि त्यो अनन्तसम्मका लागि तिनीहरूको उत्तराधिकार हुनेछ।’ ”<verse eid="EXO 32:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 32:14"/>तब याहवेह शान्त हुनुभयो, र आफूले चेतावनी दिनुभएको विपत्ति आफ्ना मानिसहरूमाथि ल्याउनुभएन।<verse eid="EXO 32:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 32:15"/>मोशा फर्के, र करारका ती दुई ढुङ्गाका पाटीहरू लिएर पर्वतदेखि तल ओर्ले। ती अगाडि र पछाडि, दुवैतिर खोपिएका थिए।<verse eid="EXO 32:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 32:16"/>ती पाटीहरू परमेश्‍वरका काम थिए; त्यो लेखोट पाटीहरूमा खोपिएको परमेश्‍वरको लेखोट थियो।<verse eid="EXO 32:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 32:17"/>यहोशूले मानिसहरू चिच्याएको हल्‍ला सुनेर मोशालाई भने, “तल छाउनीमा लडाइँको आवाज सुनिँदैछ।”<verse eid="EXO 32:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 32:18"/>मोशाले जवाफ दिए: “यो सोर न त जित्नेहरूको हो, न हार्नेहरूको हो; म त गाउनेहरूको आवाज पो सुन्दैछु।”<verse eid="EXO 32:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 32:19"/>जब मोशा छाउनीमा पुगेर बाछाको मूर्ति र नाच देखे, तब तिनी रिसले आगो भए; अनि तिनले ती पाटीहरूलाई आफ्ना हातबाट फ्याँकिदिएर पर्वतको फेदीमा टुक्रा-टुक्रा पारेर फुटाइदिए।<verse eid="EXO 32:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 32:20"/>तिनले उनीहरूले बनाएको बाछा लिएर त्यसलाई आगोमा जलाइदिए, अनि त्यसलाई धुलोपिठो पारिदिए, र त्यसलाई पानीमा छरिदिए; अनि इस्राएलीहरूलाई त्यो पिउन लाए।<verse eid="EXO 32:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 32:21"/>अनि मोशाले हारूनलाई भने, “यी मानिसहरूले तपाईंलाई के गरे, र तपाईंले तिनीहरूलाई यति ठूलो पाप गर्न लाउनुभयो?”<verse eid="EXO 32:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 32:22"/>हारूनले जवाफ दिए, “मेरा प्रभु, नरिसाउनुहोस्। यी मानिसहरू दुष्‍टतातिर कतिसम्म झुकेका छन्, त्यो तपाईं जान्‍नुहुन्छ।<verse eid="EXO 32:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 32:23"/>तिनीहरूले मलाई भने, ‘हाम्रो अगि-अगि जानलाई हाम्रा निम्ति देवी-देवताहरू बनाउनुहोस्। हामीलाई इजिप्टबाट बाहिर निकालेर ल्याउने यी मोशाको विषयमा तिनलाई के भयो हामी जान्दैनौँ।’<verse eid="EXO 32:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 32:24"/>यसकारण मैले तिनीहरूलाई यसो भनेँ, ‘जस-जससित केही सुनका गहना छन्, त्यो फुकालून्।’ तब तिनीहरूले त्यो सुन मलाई दिए; मैले त्यसलाई आगोमा फालिदिएँ, र यसबाट यो बाछा निस्केर आयो।”<verse eid="EXO 32:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 32:25"/>मोशाले मानिसहरू असभ्य भइरहेका, र हारूनले तिनीहरूलाई अधीनबाहिर जान दिएर तिनीहरूका शत्रुको निम्ति हाँसोको पात्र बनेका देखे।<verse eid="EXO 32:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 32:26"/>यसकारण मोशा छाउनीको प्रवेशद्वारमा उभिएर भने, “जो-जो याहवेहको पक्षमा छ, मकहाँ आओस्।” अनि सबै लेवीहरू तिनीकहाँ भेला भए।<verse eid="EXO 32:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 32:27"/>तब तिनले उनीहरूलाई भने, “याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘प्रत्येक मानिसले तरवार भिर्नू। छाउनीको अगि र पछि एक छेउदेखि अर्को छेउसम्म प्रत्येकले आफ्नो दाजुभाइ, मित्र र छिमेकीलाई मार्दै जानू।’ ”<verse eid="EXO 32:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 32:28"/>लेवीहरूले मोशाले हुकुम दिएझैँ गरे; अनि त्यस दिन प्राय: तीन हजार मानिसहरू मरे।<verse eid="EXO 32:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 32:29"/>तब मोशाले भने, “आज तिमीहरू याहवेहका निम्ति अलग गरिएका छौ; किनकि तिमीहरू आफ्नै छोराहरू र दाजुभाइहरूका विरुद्धमा भयौ; अनि उहाँले आजको दिन तिमीहरूलाई आशिष् दिनुभएको छ।”<verse eid="EXO 32:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 32:30"/>भोलिपल्ट मोशाले मानिसहरूलाई भने, “तिमीहरूले ठूलो पाप गरेका छौ। तर अब म याहवेहकहाँ माथि जानेछु; सायद म तिमीहरूका पापको प्रायश्‍चित गर्न सक्छु कि।”<verse eid="EXO 32:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 32:31"/>यसकारण मोशा फर्केर याहवेहकहाँ गएर भने, “हाय, यी मानिसहरूले कति ठूलो पाप गरेका छन्! तिनीहरूले आफ्ना निम्ति सुनका देवता बनाएका छन्।<verse eid="EXO 32:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 32:32"/>तर अब तिनीहरूका पाप क्षमा गरिदिनुहोस्। यदि गरिदिनुभएन भने त तपाईंले लेख्नुभएको पुस्तकबाट मेरो नामनिशानै मेटिदिनुहोस्।”<verse eid="EXO 32:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 32:33"/>याहवेहले मोशालाई जवाफ दिनुभयो, “जसले मेरो विरुद्ध पाप गरेको छ, त्यसलाई म मेरो पुस्तकबाट मेटाउनेछु।<verse eid="EXO 32:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 32:34"/>अब जा, मानिसहरूलाई मैले भनेको ठाउँमा डोर्‍याएर लैजा, र मेरा दूत तेरो अगि-अगि जानेछन्। तरै पनि जब मैले दण्ड दिने समय आउँछ, म तिनीहरूका पापको निम्ति तिनीहरूलाई दण्ड दिनेछु।”<verse eid="EXO 32:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 32:35"/>अनि तिनीहरूले हारूनले बनाएका बाछालाई जे गरेका थिए, त्यसैको कारण याहवेहले मानिसहरूलाई रूढीले मार्नुभयो।<verse eid="EXO 32:35"/></para>
<chapter eid="EXO 32"/>
<chapter number="33" style="c" sid="EXO 33"/>
<para style="p"><verse number="1" style="v" sid="EXO 33:1"/>तब याहवेहले मोशालाई भन्‍नुभयो, “तँ र तैँले इजिप्टबाट निकालेर ल्याएका मानिसहरू यस ठाउँलाई छोडेर मैले अब्राहाम, इसहाक र याकोबलाई शपथद्वारा ‘म यो तिमीहरूका सन्तानहरूलाई दिनेछु’ भनेको देशमा जानू।<verse eid="EXO 33:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 33:2"/>म एउटा दूतलाई तिमीहरूको अगि-अगि पठाउनेछु; अनि कनानी, एमोरी, हित्ती, परिज्जी, हिव्वी र यबूसीहरूलाई धपाइदिनेछु।<verse eid="EXO 33:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 33:3"/>दूध र मह बग्ने देशमा जाओ। तर म तिमीहरूसित जानेछैनँ; किनकि तिमीहरू हठी मानिसहरू भएका हुनाले सायद म तिमीहरूलाई बाटैमा नाश गरुँला।”<verse eid="EXO 33:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 33:4"/>जब मानिसहरूले यस्तो पीडादायक कुरा सुने, तब तिनीहरूले शोक गर्न थाले; अनि कसैले पनि कुनै गहना लगाएनन्।<verse eid="EXO 33:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 33:5"/>किनकि याहवेहले मोशालाई भन्‍नुभएको थियो, “इस्राएलीहरूलाई यसो भन्, ‘तिमीहरू हठी मानिसहरू हौ। यदि म केही समयको लागि मात्र पनि तिमीहरूसित जानुपर्‍यो भने म तिमीहरूलाई भस्म पार्नेछु। अब तिमीहरूका आफ्ना गहनाहरू फुकाल र तिमीहरूलाई के गर्नुपर्छ, सो म निर्णय गर्नेछु।’ ”<verse eid="EXO 33:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 33:6"/>यसकारण इस्राएलीहरूले होरेब पर्वतमा आफ्ना सबै गहनाहरू फुकाले।<verse eid="EXO 33:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 33:7"/>अब मोशाले एउटा पाल लिएर त्यसलाई “समागम पाल” भनेर छाउनीदेखि केही टाढासम्म टाँग्ने गर्थे। याहवेहसित भेट गर्न चाहने जोसुकै पनि छाउनीबाहिर भएको समागम पालमा जान्थ्यो।<verse eid="EXO 33:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 33:8"/>अनि जहिले-जहिले मोशा बाहिर पालमा निस्कन्थे, तब सबै मानिसहरू मोशा पालभित्र नपसुन्जेल आफ्ना पालहरूका प्रवेश द्वारहरूमा हेर्दै उभिरहन्थे।<verse eid="EXO 33:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 33:9"/>जब मोशा पालभित्र पस्थे, याहवेह तिनीसित बोल्नुहुँदा बादलको खामो ओर्लेर पालको ढोकामा खडा रहन्थ्यो।<verse eid="EXO 33:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 33:10"/>जब-जब मानिसहरू बादलको खामो पालको ढोकामा खडा भएको देख्थे; तिनीहरू आ-आफ्ना पालको ढोकामा उभिएर आराधना गर्दथे।<verse eid="EXO 33:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 33:11"/>कुनै मानिस आफ्नो मित्रसित बोलेझैँ याहवेह मोशासित आमने-सामने बोल्नुहुन्थ्यो। त्यसपछि मोशा छाउनीमा फर्कन्थे, तर तिनको जवान सहायक नूनका छोरा यहोशूले पाल छाड्दैनथे।<verse eid="EXO 33:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 33:12"/>मोशाले याहवेहलाई भने, “तपाईंले मलाई ‘यी मानिसहरूलाई डोर्‍याउनू,’ भन्दै आउनुभएको छ; तर तपाईंले मसित कसलाई पठाउनुहुनेछ, त्यो भन्‍नुभएको छैन। तपाईंले भन्‍नुभएको छ, ‘म त तँलाई तेरो नामले नै चिन्छु, र तँमाथि मेरो निगाह परेको छ।’<verse eid="EXO 33:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 33:13"/>यदि तपाईं मसित प्रसन्‍न हुनुहुन्छ भने मलाई तपाईंका मार्ग सिकाउनुहोस्, र म तपाईंलाई चिन्‍न सकूँ; अनि तपाईंको निगाह पाइरहन सकूँ। स्मरण रहोस्, यो जाति तपाईंकै मानिसहरू हुन्।”<verse eid="EXO 33:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 33:14"/>याहवेहले जवाफ दिनुभयो, “मेरो उपस्थिति तँसित जानेछ; अनि म तँलाई विश्राम दिनेछु।”<verse eid="EXO 33:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 33:15"/>तब मोशाले उहाँलाई भने, “यदि तपाईंको उपस्थिति हाम्रो साथमा जाँदैन भने त हामीलाई यहाँबाट नलैजानुहोस्।<verse eid="EXO 33:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 33:16"/>तपाईं हामीसित नगएसम्म म र तपाईंका यी मानिसहरूले तपाईंको निगाह पाएका छौँ भनेर हामीले कसरी जान्‍ने? अरू के कुराले म र तपाईंका मानिसहरू पृथ्वीका सारा मानिसहरूदेखि भिन्‍नै ठहरिन्छौँ?”<verse eid="EXO 33:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 33:17"/>तब याहवेहले मोशालाई भन्‍नुभयो, “तैँले भनेकै कुरा म गर्नेछु; किनकि तैँले मेरो दृष्‍टिमा निगाह पाएको छस्; र मैले तँलाई तेरो नामले चिनेको छु।”<verse eid="EXO 33:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 33:18"/>तब मोशाले भने, “अब मलाई तपाईंको महिमा देखाउनुहोस्।”<verse eid="EXO 33:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 33:19"/>याहवेहले भन्‍नुभयो, “म तेरै सामु मेरो सारा भलाइ देखाउनेछु; र तेरै सामु याहवेह नामको घोषणा गर्नेछु। जसलाई म कृपा गर्न चाहन्छु, त्यसलाई म कृपा गर्नेछु। जसलाई म दया देखाउन चाहन्छु, त्यसलाई म दया देखाउनेछु।”<verse eid="EXO 33:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 33:20"/>उहाँले भन्‍नुभयो, “तर तैँले मेरो अनुहार हेर्न सक्दैनस्; किनकि मेरो अनुहार हेरेर कुनै मानिस जीवित रहन सक्दैन।”<verse eid="EXO 33:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 33:21"/>त्यसपछि याहवेहले भन्‍नुभयो, “मेरो छेउमा एउटा ठाउँ छ, जहाँ तँ चट्टानमाथि खडा हुन सक्छस्।<verse eid="EXO 33:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 33:22"/>जब मेरो महिमा त्यहाँबाट भएर जान्छ; म तँलाई चट्टानको धाँदोमा राख्नेछु; अनि म नगइन्जेल तँलाई आफ्नो हातले छोपिराख्नेछु।<verse eid="EXO 33:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 33:23"/>त्यसपछि म आफ्नो हात हटाउनेछु, र तैँले मेरो पिठिउँ देख्नेछस्; तर मेरो अनुहारचाहिँ देखिनेछैन।”<verse eid="EXO 33:23"/></para>
<chapter eid="EXO 33"/>
<chapter number="34" style="c" sid="EXO 34"/>
<para style="p"><verse number="1" style="v" sid="EXO 34:1"/>याहवेहले मोशालाई भन्‍नुभयो, “पहिलेको जस्तै ढुङ्गाका दुई वटा पाटीहरू काट्, र म तिनीहरूमा तैँले फुटाएको पहिलो पाटीहरूमा भएकै शब्दहरू लेखिदिनेछु।<verse eid="EXO 34:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 34:2"/>बिहान तयार भएर सीनै पर्वतमा उक्लिआइज। पर्वतको टाकुरामा आफूलाई मकहाँ हाजिर गर्।<verse eid="EXO 34:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 34:3"/>पर्वतमा तँसित कोही पनि नआओस्; अथवा पर्वतका कुनै ठाउँमा देखा पनि नपरोस्; कुनै बगाल र बथान पनि पर्वतको सामु नचरोस्।”<verse eid="EXO 34:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 34:4"/>यसकारण मोशाले पहिलेको जस्तै ढुङ्गाका दुई वटा पाटीहरू काटेर निकाले, र याहवेहले आज्ञा दिनुभएझैँ बिहानै सीनै पवर्तमा उक्ले। तिनले ढुङ्गाका दुई वटा पाटीहरू आफ्ना हातमा बोके।<verse eid="EXO 34:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 34:5"/>तब याहवेह बादलमा तल ओर्लिनुभयो, र त्यहाँ तिनीसित उभिनुभयो; अनि आफ्नो नाम याहवेह भनी घोषणा गर्नुभयो।<verse eid="EXO 34:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 34:6"/>उहाँ मोशाको सामु यसो भनेर घोषणा गर्दै जानुभयो, “याहवेह, याहवेह, दयालु र अनुग्रही परमेश्‍वर, रिस गर्नमा ढिलो, प्रेम र विश्‍वासयोग्यताले भरिपूर्ण हुनुहुन्छ।<verse eid="EXO 34:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 34:7"/>उहाँले हजारौँसित प्रेम कायम राख्नुहुन्छ; अनि दुष्‍टता, विद्रोह र पापलाई क्षमा गर्नुहुन्छ। तरै पनि उहाँले दोषीलाई दण्ड नदिई छाड्नुहुन्‍न। पितापुर्खाका दुष्‍टताको दण्ड तिनीहरूका सन्तान, नातिनातिना र तेस्रो अनि चौथो पुस्तासम्म दिनुहुन्छ।”<verse eid="EXO 34:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 34:8"/>तब मोशाले तुरुन्तै भुइँसम्मै निहुरेर परमेश्‍वरलाई आराधना गरे।<verse eid="EXO 34:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 34:9"/>तिनले भने, “हे प्रभु, यदि मैले तपाईंको दृष्‍टिमा निगाह पाएको छु भने तपाईं नै हामीसित हिँड्नुहोस्। यो एउटा हठी जाति भए तापनि हाम्रा दुष्‍टता र पाप क्षमा गरिदिनुहोस्; अनि हामीलाई आफ्नो निज सम्पत्तिको रूपमा लिनुहोस्।”<verse eid="EXO 34:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 34:10"/>तब याहवेहले भन्‍नुभयो: “म तँसित एउटा करार बाँध्दछु। म तेरा सबै मानिसहरूको सामु यस संसारमा भएका कुनै जातिको बीचमा कहिल्यै पनि नगरिएका अद्‌भुत कार्यहरू गर्नेछु। तँ जुन मानिसहरूसित बस्दछस्, तिनीहरूले म याहवेहले कस्तो महान् काम तिमीहरूका निम्ति गर्नेछु, त्यो देख्नेछन्।<verse eid="EXO 34:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 34:11"/>म तँलाई आज जे आज्ञा दिन्छु, त्यो पालन गर्नू। म तेरो सामु एमोरीहरू, कनानीहरू, हित्तीहरू, परिज्जीहरू, हिव्वीहरू र यबूसीहरूलाई धपाउनेछु।<verse eid="EXO 34:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 34:12"/>तिमीहरू जाने देशमा बस्‍नेहरूसित होशियार हुनू र सम्झौता नगर्नू, नत्रता तिमीहरूका निम्ति तिनीहरू पासो हुनेछन्।<verse eid="EXO 34:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 34:13"/>तिनीहरूका वेदीहरू भत्काइदिनू, तिनीहरूका चोखा पत्थरहरू चकनाचुर पारिदिनू र तिनीहरूका अशेराको खाँबो काटेर ढालिदिनू।<verse eid="EXO 34:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 34:14"/>अरू कुनै देवी-देवताको आराधना नगर्नू; किनकि याहवेह, जसको नाम डाही हो, डाह गर्ने परमेश्‍वर हुनुहुन्छ।<verse eid="EXO 34:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 34:15"/>“त्यस देशमा बस्‍नेहरूसित होशियार हुनू र करार नबाँध्नू; किनकि तिनीहरूले आफ्ना देवी-देवताहरूका अगि व्यभिचार गर्दा र तिनीहरूका लागि बलिदान चढाउँदा तिमीहरूलाई निम्तो दिनेछन्; अनि तिमीहरूले तिनीहरूका बलिदानबाट खानेछौ।<verse eid="EXO 34:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 34:16"/>अनि जब तिमीहरूले तिनीहरूका छोरीहरूलाई आफ्ना छोराहरूका निम्ति पत्नी बनाउन रोज्नेछौ, र ती छोरीहरूले आफ्ना देवी-देवताहरूसित व्यभिचार गर्नेछन्; तब तिनीहरूले तिमीहरूका छोराहरूलाई त्यसै गर्न डोर्‍याउनेछन्।<verse eid="EXO 34:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 34:17"/>“तिमीहरूले आफ्ना निम्ति मूर्तिहरू नबनाउनू।<verse eid="EXO 34:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 34:18"/>“अखमिरी रोटीको चाड मनाउनू। सात दिनसम्म मैले तिमीहरूलाई आज्ञा दिएझैँ, खमिर नमिसाइएको रोटी खानू। यो आबीब महिनाको तोकिएको समयमा गर्नू; किनकि तिमीहरू त्यही महिनामा इजिप्टबाट निस्केर आएका हौ।<verse eid="EXO 34:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 34:19"/>“प्रत्येक गर्भको पहिलो फल मेरो हो। तिमीहरूका पशुका सबै भाले, गाईबस्तुका र भेडाबाख्राका पहिले जन्मेका मेरै हुन्।”<verse eid="EXO 34:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 34:20"/>गधैनीको पहिले जन्मेको बछेडालाई पाठो दिएर छुटाउनू; तर तिमीहरूले छुटाएनौ भने त्यसको गर्दन भाँचिदिनू। तिमीहरूका सबै जेठा छोराहरूलाई छुटाउनू। “मेरो सामु कोही खाली हात देखा नपरोस्।<verse eid="EXO 34:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 34:21"/>“छ दिनसम्म काम गर्नू, तर सातौँ दिनमा विश्राम गर्नू; जोत्ने र कटनी गर्ने समयमा पनि विश्राम गर्नू।<verse eid="EXO 34:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 34:22"/>“गहुँको कटनीबाट पहिलो फल लिएर साताहरूका चाड मनाउनू, र वर्षको अन्तमा अन्‍न भित्र्याउने चाड मनाउनू।<verse eid="EXO 34:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 34:23"/>वर्षमा तीन पल्ट तेरा सबै पुरुषहरू सार्वभौम याहवेह, इस्राएलका परमेश्‍वरको सामु देखा परून्।<verse eid="EXO 34:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 34:24"/>म तिमीहरूका सामु जातिहरूलाई धपाइदिनेछु, र तिमीहरूका सिमाना फैलाइदिनेछु; अनि वर्षमा तीन पल्ट तिमीहरू याहवेह तिमीहरूका परमेश्‍वरको सामु देखा पर्न जाँदा कसैले पनि तिमीहरूका जमिनको लोभ गर्नेछैन।<verse eid="EXO 34:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 34:25"/>“तिमीहरूले मलाई बलिदानको रगतसित खमिर भएको कुनै पनि कुरा नचढाउनू, र निस्तार चाडको बलिबाट कुनै पनि भाग बिहानसम्म रहन नदिनू।<verse eid="EXO 34:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 34:26"/>“तिमीहरूका माटोबाट उब्जेका सबैभन्दा असल पहिलो फल याहवेह तिमीहरूका परमेश्‍वरको घरमा ल्याउनू। “बाख्राको पाठो त्यसको माउको दूधमा नपकाउनू।”<verse eid="EXO 34:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 34:27"/>त्यसपछि याहवेहले मोशालाई भन्‍नुभयो, “यी कुराहरू लेख्; किनकि यिनै कुराअनुसार मैले तँ र इस्राएलसँग करार बाँधेको छु।”<verse eid="EXO 34:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 34:28"/>मोशा त्यहाँ रोटी नखाई र पानी नपिई याहवेहसित चालीस दिन र चालीस रातसम्म रहे। तिनले ती साक्षी पाटीहरूमा त्यस करारका वचन अर्थात् दश आज्ञाहरू लेखे।<verse eid="EXO 34:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 34:29"/>जब मोशा सीनै पर्वतबाट आफ्ना हातहरूमा साक्षी पाटीहरू लिएर तल ओर्ले, तब याहवेहसित तिनले कुरा गरेकोले आफ्नो अनुहार चम्कँदैछ भन्‍ने तिनलाई थाहा भएन।<verse eid="EXO 34:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 34:30"/>जब हारून र सबै इस्राएलीहरूले मोशालाई देखे, तिनको अनुहार चम्किरहेको थियो; अनि तिनीहरू उनको नजिक आउन डराए।<verse eid="EXO 34:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 34:31"/>तर मोशाले तिनीहरूलाई बोलाए। अनि हारून र समुदायका सबै अगुवाहरू तिनीकहाँ फर्केर आए; र तिनले उनीहरूसित कुरा गरे।<verse eid="EXO 34:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 34:32"/>त्यसपछि सबै इस्राएलीहरू तिनको नजिक आए; अनि तिनले तिनीहरू सबैलाई याहवेहले तिनलाई सीनै पर्वतमा दिनुभएका सबै आज्ञाहरू दिए।<verse eid="EXO 34:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 34:33"/>मोशाले तिनीहरूसित कुरा गरिसकेपछि तिनले आफ्नो अनुहारमाथि घुम्टो लगाए।<verse eid="EXO 34:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 34:34"/>तर जब मोशा याहवेहसित कुरा गर्न उहाँको उपस्थितिमा जान्थे, आफू बाहिर ननिस्कुन्जेल घुम्टो उतार्थे। अनि तिनी बाहिर आएर तिनले के आज्ञा पाए, सो इस्राएलीहरूलाई सुनाइदिँदा<verse eid="EXO 34:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 34:35"/>इस्राएलीहरूले तिनको अनुहार चम्केको देख्थे। याहवेहसित कुरा गर्न भित्र नगएसम्म मोशाले फेरि आफ्नो अनुहारमाथि त्यो घुम्टो लगाउँथे।<verse eid="EXO 34:35"/></para>
<chapter eid="EXO 34"/>
<chapter number="35" style="c" sid="EXO 35"/>
<para style="p"><verse number="1" style="v" sid="EXO 35:1"/>मोशाले इस्राएलीहरूका सारा समुदायलाई भेला गरेर भने, “याहवेहले तिमीहरूलाई यी कुराहरू पालना गर्न आज्ञा दिनुभएको छ:<verse eid="EXO 35:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 35:2"/>छ दिनसम्म काम गर्नू, तर सातौँ दिनचाहिँ तिमीहरूका लागि पवित्र दिन, याहवेहका निम्ति शब्बाथ विश्रामदिन हुनेछ। जसले यस दिनमा काम गर्दछ, त्यो मारिनेछ।<verse eid="EXO 35:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 35:3"/>शब्बाथ दिनमा तिमीहरू कसैको घरमा आगो पनि नबलोस्।”<verse eid="EXO 35:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 35:4"/>मोशाले इस्राएलका सारा समुदायलाई भने, “याहवेहले गर्नुभएको आज्ञा यही हो:<verse eid="EXO 35:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 35:5"/>याहवेहका निम्ति भेटी ल्याओ। याहवेहका निम्ति भेटी ल्याउन चाहने हरेकले यी कुराहरू ल्याउनू: “सुन, चाँदी र काँसो;<verse eid="EXO 35:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 35:6"/>निलो, बैजनी र रातो धागो र मसिनो सुती कपडा; बाख्राको भुत्ला;<verse eid="EXO 35:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 35:7"/>भेडाका रातो रङ्गाएको छालाहरू र सीलका छालाहरू; बबुलका काठ;<verse eid="EXO 35:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 35:8"/>बत्तीको निम्ति जैतुनको तेल; अभिषेक गर्नका निम्ति तेल र सुगन्धित धूपका निम्ति मसलाहरू;<verse eid="EXO 35:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 35:9"/>अनि एपोद र छाती-पाता जड्नका निम्ति गोमेद र अरू रत्नहरू।<verse eid="EXO 35:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 35:10"/>“तिमीहरूमध्ये सबै निपूर्ण कारिगरहरू आएर याहवेहले आज्ञा गर्नुभएअनुसार सम्पूर्ण कुराहरू बनाउनुपर्छ:<verse eid="EXO 35:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 35:11"/>“समागम पाल, पालको छत, अङ्कुसेहरू, फल्याकहरू, बारहरू, खाँबाहरू र आधारहरू;<verse eid="EXO 35:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 35:12"/>डण्डाहरूसहित करारको सन्दुक र पाप समाधान-स्थान;<verse eid="EXO 35:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 35:13"/>टेबुल, त्यसका डण्डाहरूसहित र त्यसका सबै सामानहरू, र उपस्थितिको रोटी;<verse eid="EXO 35:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 35:14"/>सरसामानहरूसहित बत्तीको निम्ति सामदान, प्रकाशको निम्ति जैतुनको तेल;<verse eid="EXO 35:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 35:15"/>धूपको निम्ति वेदी र त्यसका डण्डाहरू, अभिषेक गर्ने तेल र सुगन्धित धूप; समागम पालको प्रवेशद्वारमा लगाइने पर्दा;<verse eid="EXO 35:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 35:16"/>होमबलिको निम्ति वेदी, काँसोको जाली, त्यसका डण्डाहरू र सबै सामानहरू; काँसोका बाटा त्यसका खुट्टासहित;<verse eid="EXO 35:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 35:17"/>आँगनका पर्दाहरू त्यसका खाँबाहरू र आधारहरूसमेत, र आँगनको मूलढोकाको निम्ति पर्दा;<verse eid="EXO 35:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 35:18"/>समागम पाल र आँगनका निम्ति किलाहरू र तिनीहरूका डोरीहरू;<verse eid="EXO 35:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 35:19"/>पवित्रस्थानमा सेवाका निम्ति बुनिएका पोशाकहरू—पुजारी हारूनका निम्ति पवित्र पोशाकहरू, र तिनका छोराहरूका निम्ति पोशाकहरू जब तिनीहरू पुजारी भएर सेवा गर्छन्।”<verse eid="EXO 35:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 35:20"/>त्यसपछि इस्राएलका सारा समुदाय मोशाको सामुबाट बिदा भए।<verse eid="EXO 35:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 35:21"/>जसका हृदय उत्साहित भए र दिने इच्छा गरे; तिनीहरूले समागम पाल, त्यसको सेवाको सबै काम र पवित्र पोशाकहरूका निम्ति याहवेहको सामु भेटी ल्याए।<verse eid="EXO 35:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 35:22"/>इच्छुक हुने हरेक पुरुष र स्त्रीले सबै प्रकारका सुनका गहना ल्याए—पिन, कुण्डल, औँठी र सिङ्गारका सामानहरू। तिनीहरू हरेकले आफ्ना सुन विशेष भेटीको रूपमा उचालिनको निम्ति याहवेहलाई चढाए।<verse eid="EXO 35:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 35:23"/>जससँग निलो, बैजनी, रातो धागो, मसिनो सुती कपडा, बाख्राका भुत्ला, भेडाका रातो रङ्गाएका छाला वा सीलका छालाहरू थिए, ती सबै ल्याए।<verse eid="EXO 35:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 35:24"/>तिनीहरू, जसले चाँदी वा काँसो दिन सक्थे, तिनीहरूले ती भेटीको रूपमा याहवेहको सामु ल्याए; अनि जससँग सेवाको कामका निम्ति बबुल काठ थियो, त्यो तिनीहरूले ल्याए।<verse eid="EXO 35:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 35:25"/>सिपले योग्य स्त्रीहरूले आफ्नो हातले तयार पारेका निलो, बैजनी, रातो धागो र मसिनो सुतीका वस्त्र ल्याए।<verse eid="EXO 35:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 35:26"/>अनि सिपले योग्य र इच्छुक स्त्रीहरूले बाख्राका भुत्ला काते।<verse eid="EXO 35:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 35:27"/>अगुवाहरूले एपोदमा र छाती-पातामा जड्नका लागि गोमेद पत्थरहरू र अरू रत्नहरू ल्याए।<verse eid="EXO 35:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 35:28"/>तिनीहरूले बत्तीको निम्ति जैतुनको तेल, अभिषेक गर्ने तेल र सुगन्धित धूपका निम्ति मसला ल्याए।<verse eid="EXO 35:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 35:29"/>इस्राएलका सबै पुरुष र स्त्रीहरू, जसले याहवेहको निम्ति भेटी चढाउने इच्छा राखे; याहवेहले मोशाद्वारा आज्ञा गर्नुभएको सबै कामका निम्ति तिनीहरूले याहवेहकहाँ आफ्नो स्वेच्छा-भेटी ल्याए।<verse eid="EXO 35:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 35:30"/>तब मोशाले इस्राएलीहरूलाई भने, “हेर, याहवेहले यहूदाका कुल, हूरका नाति, ऊरीका छोरा बजलेललाई चुन्‍नुभएको छ;<verse eid="EXO 35:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 35:31"/>अनि उहाँले तिनलाई आफ्नो आत्मा, बुद्धि, समझ, ज्ञान र कारिगरीका सबै दक्षताले भर्नुभएको छ।<verse eid="EXO 35:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 35:32"/>उहाँले तिनलाई सुन, चाँदी, काँसोमा कलापूर्ण आकार कोर्ने,<verse eid="EXO 35:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 35:33"/>कलापूर्ण तरिकाले हरेक प्रकारका पत्थर काटेर जड्ने काम, र काठमा खोप्ने सिप दिनुभएको छ।<verse eid="EXO 35:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 35:34"/>याहवेहले तिनलाई र दानका कुलका अहीसामाकका छोरा, ओहोलीआबलाई अरूलाई सिकाउन सक्ने क्षमता दिनुभएको छ।<verse eid="EXO 35:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 35:35"/>उहाँले तिनीहरूलाई हरेक प्रकारका शिल्पकारी, चित्र बनाउने काम, निलो, बैजनी, रातो धागो र मसिनो सुती कपडामा बुट्टा भर्ने अनि बुन्‍ने कारिगरले जानेका सबै काम गर्ने बुद्धिले भरिपूर्ण पार्नुभएको छ।<verse eid="EXO 35:35"/></para>
<chapter eid="EXO 35"/>
<chapter number="36" style="c" sid="EXO 36"/>
<para style="p"><verse number="1" style="v" sid="EXO 36:1"/>यसकारण बजलेल, ओहोलीआब र हरेक दक्ष मानिस, जसलाई याहवेहले पवित्रस्थान निर्माण गर्ने काममा दक्षता र क्षमता दिनुभएको छ, तिनीहरू सबैले याहवेहले आज्ञा दिनुभएअनुसार काम गरून्।”<verse eid="EXO 36:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 36:2"/>तब मोशाले बजलेल, ओहोलीआब अनि याहवेहले काम गर्न क्षमता दिनुभएका र इच्छुक हरेक दक्ष मानिसलाई बोलाइपठाए।<verse eid="EXO 36:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 36:3"/>तिनीहरूले पवित्रस्थान निर्माणका लागि इस्राएलीहरूले दिएका सबै भेटी मोशाबाट प्राप्‍त गरे। अनि मानिसहरूले हरेक बिहान स्वेच्छिक भेटीहरू ल्याउने गर्थे।<verse eid="EXO 36:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 36:4"/>तब पवित्रस्थानमा काम गर्ने सबै दक्ष कामदारहरूले आ-आफ्ना काम छोडे,<verse eid="EXO 36:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 36:5"/>अनि मोशालाई भने, “याहवेहले आज्ञा गर्नुभएको भन्दा धेरै सरसामानहरू मानिसहरूले ल्याएका छन्।”<verse eid="EXO 36:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 36:6"/>त्यसपछि मोशाले आदेश गरे, र छाउनीभरि नै सन्देश पठाए: “अब कुनै पुरुष वा स्त्रीले पवित्रस्थानको भेटीका लागि अरू केही नल्याउनू।” यसकारण मानिसहरूले अरू भेटी ल्याउन छोडे।<verse eid="EXO 36:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 36:7"/>किनकि तिनीहरूले ल्याएका भेटीहरू सबै काम सम्पन्‍न गर्न चाहिएभन्दा धेरै भयो।<verse eid="EXO 36:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 36:8"/>कामदारहरूमध्ये दक्ष भएकाहरूले दश वटा पर्दाले समागम पाल बनाए। ती पर्दाहरू मसिनो गरी बाटिएका सुती कपडाका निलो, बैजनी र रातो धागोका, र तिनमा दक्ष शिल्पकारद्वारा बनाइएका करूबहरूसहित समागम पाल थिए।<verse eid="EXO 36:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 36:9"/>सबै पर्दाहरू एउटै नापका थिए—अट्ठाइस क्यूबिट लम्बाइ र चार क्यूबिट चौडाइ।<verse eid="EXO 36:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 36:10"/>तिनीहरूले ती पाँच वटा पर्दाहरू एक-अर्कासित जोडे।<verse eid="EXO 36:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 36:11"/>त्यसपछि तिनीहरूले पहिलो जोडिएको पर्दाको अन्तिम किनारमा निलो कपडाको सुर्काउनी बनाए। अनि दोस्रो किनारमा जोडिएको भागको अर्को पर्दाको अन्तिम किनारमा पनि पहिलेको जस्तै गरे।<verse eid="EXO 36:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 36:12"/>तिनीहरूले एउटा भागको पर्दामा पचास वटा सुर्काउनी पनि बनाए। अर्को पर्दाको भागको अन्तिम किनारमा पचास वटा सुर्काउनी बनाए। ती सुर्काउनीहरू एक-अर्काका विपरीत थिए।<verse eid="EXO 36:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 36:13"/>त्यसपछि तिनीहरूले ती पर्दाहरू एक-आपसमा जोड्नलाई सुनका पचास वटा अङ्कुसेहरू बनाए। यसरी समागम पाल एउटै भयो।<verse eid="EXO 36:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 36:14"/>समागम पालमाथिको पालको लागि तिनीहरूले बाख्राको भुत्लाबाट एघार वटा पर्दाहरू बनाए।<verse eid="EXO 36:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 36:15"/>सबै एघार वटा पर्दाहरू एउटै नापका थिए—तीस क्यूबिट लम्बाइ र चार क्यूबिट चौडाइ।<verse eid="EXO 36:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 36:16"/>तिनीहरूले पाँच वटा पर्दाहरू जोडेर एउटा भाग र छ वटा पर्दाहरूका जोडेर अर्को भाग बनाए।<verse eid="EXO 36:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 36:17"/>त्यसपछि तिनीहरूले पहिलो गाँसिएको समूहको किनारमा पचास वटा सुर्काउनीहरू बनाए; अनि अर्को गाँसिएको समूहको पर्दाको किनारमा पनि पचास वटा सुर्काउनीहरू बनाए।<verse eid="EXO 36:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 36:18"/>ती दुवै पर्दालाई जोडेर एक-आपसमा एउटै बनाउन तिनीहरूले काँसोका पचास वटा अङ्कुसेहरू बनाए।<verse eid="EXO 36:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 36:19"/>त्यसपछि तिनीहरूले पालको निम्ति भेडाको रातो रङ्गाइएको छालाबाट छत बनाए; र त्यसमाथि सीलका छालाहरूबाट छत बनाए।<verse eid="EXO 36:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 36:20"/>तिनीहरूले समागम पालका निम्ति बबुल काठको ठाडो फल्याकहरू बनाए।<verse eid="EXO 36:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 36:21"/>प्रत्येक फल्याकका लम्बाइ दश क्यूबिट र चौडाइ डेढ क्यूबिट थियो।<verse eid="EXO 36:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 36:22"/>त्यसमा एक-अर्कामा समानान्तर रहेका दुई वटा चोसाहरू थिए। समागम पालका सबै फल्याकहरू यस किसिमले नै बनाए।<verse eid="EXO 36:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 36:23"/>तिनीहरूले समागम पालको दक्षिणपट्टिका लागि बीस वटा फल्याकहरू बनाए।<verse eid="EXO 36:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 36:24"/>अनि ती फल्याकहरूका मुन्तिर चालीस वटा चाँदीका आधारहरू बनाए—एउटा फल्याकको लागि दुई वटा आधारहरू, प्रत्येक चोसाको मुनि एउटा।<verse eid="EXO 36:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 36:25"/>अर्कोपट्टि, समागम पालको उत्तरपट्टि बीस वटा फल्याकहरू,<verse eid="EXO 36:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 36:26"/>अनि तिनको निम्ति दुई वटा आधार गरेर तिनीहरूले चाँदीका चालीस वटा आधारहरू बनाए।<verse eid="EXO 36:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 36:27"/>तिनीहरूले पछिल्तिरको भाग, जो समागम पालको पश्‍चिमतिरको भाग हो, त्यसका लागि छ वटा फल्याकहरू बनाए।<verse eid="EXO 36:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 36:28"/>अनि अन्तिम भागमा भएका समागम पालका कुनाहरूका लागि दुई वटा फल्याकहरू बनाइए।<verse eid="EXO 36:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 36:29"/>ती कुनाका दुई फल्याकहरू तलदेखि माथिसम्म दोबर खप्टिएका र माथिल्‍लो भागमा कुनाका फल्याकहरू एउटै मुन्द्रामा जोडिएका थिए। ती दुवै एकै किसिमले बनेका थिए।<verse eid="EXO 36:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 36:30"/>यसरी त्यहाँ पछाडिपट्टि आठ वटा फल्याकहरू र एउटाको मुन्तिर दुई वटा गरी चाँदीका सोह्र वटा आधारहरू थिए।<verse eid="EXO 36:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 36:31"/>तिनीहरूले बबुल काठका बारहरू र समागम पालको एकापट्टि पाँच वटा फल्याकहरू पनि बनाए।<verse eid="EXO 36:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 36:32"/>अनि अर्कोपट्टिका फल्याकहरूका लागि पाँच वटा बार र समागम पालको पश्‍चिमका अन्तिम भागका फल्याकहरूको लागि पाँच वटा बारहरू लगाए।<verse eid="EXO 36:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 36:33"/>तिनीहरूले फल्याकहरूको बीचमा पर्ने बारचाहिँ एक छेउदेखि अर्को छेउसम्म पुग्ने बनाए।<verse eid="EXO 36:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 36:34"/>तिनीहरूले सबै फल्याकहरू सुनले मोहोरे, र बारहरू पक्रनका लागि सुनका मुन्द्राहरू बनाए। ती बारहरू पनि सुनले नै मोहोरे।<verse eid="EXO 36:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 36:35"/>तिनीहरूले निलो, बैजनी, रातो धागो र मसिनो गरी बाटेको सुती कपडाको एउटा पर्दा बनाए; जसमा निपूर्ण शिल्पकारद्वारा बनाइएका करूबहरू थिए।<verse eid="EXO 36:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 36:36"/>तिनीहरूले त्यसका लागि बबुल काठका चार वटा खाँबाहरू बनाए; अनि तिनलाई सुनले मोहोरे। तिनीहरूले सुनका अङ्कुसेहरू बनाए; र चाँदीका चार वटा आधारहरू ढाले।<verse eid="EXO 36:36"/></para>
<para style="p"><verse number="37" style="v" sid="EXO 36:37"/>तिनीहरूले पाल प्रवेशद्वारका लागि निलो, बैजनी, रातो रङ्गको धागो र मसिनो गरी बाटेको सुती कपडाले शिल्पकारको शिल्पकारी भएको एउटा पर्दा बनाए;<verse eid="EXO 36:37"/></para>
<para style="p"><verse number="38" style="v" sid="EXO 36:38"/>अनि तिनीहरूले पाँच वटा खाँबाहरूसहित अङ्कुसेहरू पनि बनाए। तिनीहरूले खाँबोका टुप्पाहरू र तिनका फित्ताहरू सुनले मोहोरे, र तिनका पाँच वटा काँसोका आधारहरू बनाए।<verse eid="EXO 36:38"/></para>
<chapter eid="EXO 36"/>
<chapter number="37" style="c" sid="EXO 37"/>
<para style="p"><verse number="1" style="v" sid="EXO 37:1"/>बजलेलले बबुल काठको सन्दुक बनाए। त्यसको लम्बाइ साढे दुई क्यूबिट, चौडाइ साढे एक क्यूबिट, र उचाइ साढे एक क्यूबिट थियो।<verse eid="EXO 37:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 37:2"/>तिनले त्यसको भित्री र बाहिरी भाग निखुर सुनले मोहोरे; अनि त्यसको वरिपरि सुनको बिट बनाए।<verse eid="EXO 37:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 37:3"/>तिनले त्यसका निम्ति सुनका चार वटा मुन्द्राहरू ढाले, र ती त्यसका चार वटा खुट्टामा लगाइदिए; दुई वटा मुन्‍द्रा एकापट्टि र दुई वटा अर्कापट्टि।<verse eid="EXO 37:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 37:4"/>तब तिनले बबुल काठका डण्डाहरू बनाएर ती सुनले मोहोरे।<verse eid="EXO 37:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 37:5"/>ती डण्डाहरू सन्दुकको दुवैपट्टि भएका मुन्द्राहरूमा बोक्नका निम्ति हाले।<verse eid="EXO 37:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 37:6"/>तिनले निखुर सुनको पाप समाधान-स्थान बनाए; जसको लम्बाइ साढे दुई क्यूबिट र चौडाइ साढे एक क्यूबिट थियो।<verse eid="EXO 37:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 37:7"/>त्यसपछि तिनले पाप समाधान-स्थानको किनारहरूमा पिटिएको सुनका दुई वटा करूबहरू बनाए।<verse eid="EXO 37:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 37:8"/>तिनले एउटा करूब एक किनारमा, र अर्को करूब अर्को किनारमा बनाए। ती दुवै करूबहरू पाप समाधान-स्थानसित एउटै टुक्राले बनाए।<verse eid="EXO 37:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 37:9"/>ती करूबहरूले आफ्ना पखेटाहरू माथिपट्टि फैलाएर पाप समाधान-स्थानमा छाया पारेका थिए। तिनीहरूका मुखचाहिँ एक-अर्कापट्टि, पाप समाधान-स्थानतिर फर्किएका थिए।<verse eid="EXO 37:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 37:10"/>बजलेलले बबुल काठको एउटा टेबुल बनाए; जसको लम्बाइ दुई क्यूबिट, चौडाइ एक क्यूबिट र उचाइ साढे एक क्यूबिट थियो।<verse eid="EXO 37:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 37:11"/>तब तिनले त्यसलाई निखुर सुनले मोहोरे र चारैपट्टि सुनको बिट बनाए।<verse eid="EXO 37:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 37:12"/>तिनले त्यसका चारैतिर चार औँला चौडाइ भएको घेरा बनाए; अनि घेराको सबै भागमा सुनको बिट लगाए।<verse eid="EXO 37:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 37:13"/>तिनले टेबुलको लागि सुनका चार वटा मुन्द्राहरू बनाएर ती चार कुनाहरूमा भएका खुट्टाहरूमा बाँधे।<verse eid="EXO 37:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 37:14"/>त्यो टेबुल बोक्नलाई चलाइने डण्डाहरूलाई समातिराख्न ती मुन्द्राहरू घेराका छेवैमा राखिए।<verse eid="EXO 37:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 37:15"/>तिनले टेबुल बोक्नलाई ती डण्डीहरू बबुल काठका बनाए र त्यसलाई सुनले मोहोरे।<verse eid="EXO 37:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 37:16"/>अनि तिनले टेबुलका निम्ति थालहरू, धुपौराहरू, कचौराहरू र अर्घबलि चढाउनका निम्ति यसका भाँडाहरू सबै निखुर सुनको बनाए।<verse eid="EXO 37:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 37:17"/>तिनले निखुर सुनको सामदान बनाए। त्यसका आधार र डण्डा, फूलजस्ता कचौराहरू, कोपिला र फूलहरू एउटै टुक्राबाट पिटेर बनाए।<verse eid="EXO 37:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 37:18"/>तीन वटा एकपट्टि र तीन वटा अर्कोपट्टि गरेर जम्मा सामदानका दुई छेउमा छ वटा हाँगाहरू निस्केका थिए।<verse eid="EXO 37:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 37:19"/>एउटा हाँगामा कोपिला र फूल भएको बदामको फूलजस्तै आकारका तीन वटा कचौराहरू; अर्को हाँगामा तीन वटा र यसै गरी सामदानबाट निस्केका छ वटै हाँगाहरूमा थिए।<verse eid="EXO 37:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 37:20"/>अनि सामदानमा कोपिला र कोपिला भएको बदामको फूलको आकारमा चार वटा कचौराहरू थिए।<verse eid="EXO 37:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 37:21"/>पहिलो कोपिला सामदानबाट निस्केको हाँगाको पहिलो जोडीमुनि थिए—दोस्रो कोपिला दोस्रो जोडीमुनि र तेस्रो कोपिला तेस्रो जोडीमुनि गरेर जम्मा छ वटा हाँगाहरू।<verse eid="EXO 37:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 37:22"/>ती कोपिलाहरू र हाँगाहरू सामदानसित एउटै टुक्राबाट घनले पिटेको निखुर सुनले बनिएको थियो।<verse eid="EXO 37:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 37:23"/>तिनले सात वटा दियाहरू बनाए; तिनका चिम्टा र मोसोदानी निखुर सुनका थिए।<verse eid="EXO 37:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 37:24"/>सामदान र त्यसका सरसामानहरूका निम्ति तिनले एक टालेन्ट निखुर सुन लिए।<verse eid="EXO 37:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 37:25"/>तिनले धूप बाल्नलाई बबुल काठको एउटा वेदी बनाए। त्यो वर्गाकार थियो; जसको लम्बाइ एक क्यूबिट, चौडाइ एक क्यूबिट र उचाइ दुई क्यूबिट थियो। त्यसका सिङहरू पनि एउटै टुक्राबाट बनेका थिए।<verse eid="EXO 37:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 37:26"/>तिनले त्यसका टुप्पो र सबै भित्ताहरू र सिङहरूलाई निखुर सुनले मोहोरे; अनि त्यसको चारैतिर सुनको बिट बनाए।<verse eid="EXO 37:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 37:27"/>त्यसलाई बोक्नका निम्ति तिनले त्यसको बिटमुनि र त्यसको दुई विपरीत भागमा डण्डाहरू बस्‍ने घरका निम्ति सुनका दुई वटा मुन्द्राहरू बनाए।<verse eid="EXO 37:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 37:28"/>तिनले बबुल काठका डण्डाहरू बनाए र त्यसलाई सुनले मोहोरे।<verse eid="EXO 37:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 37:29"/>तिनले अभिषेक गर्ने पवित्र तेल र अत्तर बनाउनेले झैँ सुगन्धित शुद्ध धूप पनि बनाए।<verse eid="EXO 37:29"/></para>
<chapter eid="EXO 37"/>
<chapter number="38" style="c" sid="EXO 38"/>
<para style="p"><verse number="1" style="v" sid="EXO 38:1"/>बजलेलले होमबलिको निम्ति बबुल काठको वेदी बनाए। त्यो वर्गाकार थियो; त्यसको लम्बाइ पाँच क्यूबिट, चौडाइ पाँच क्यूबिट र उचाइ तीन क्यूबिट थियो।<verse eid="EXO 38:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 38:2"/>तिनले त्यसका चार कुनामा सिङहरू बनाए; ती सिङहरू र वेदी एउटै टुक्राबाट बनेका थिए; अनि वेदीलाई काँसोले मोहोरे।<verse eid="EXO 38:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 38:3"/>तिनले वेदीका सबै सरसामानहरू, भाँडाहरू, बेल्चाहरू, छर्कने बाटाहरू, मासु उठाउने काँटाहरू र आगो राख्ने भाँडाहरू काँसोका बनाए।<verse eid="EXO 38:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 38:4"/>तब तिनले वेदीको निम्ति एउटा काँसोको जाली बनाए, जुन वेदीको तलबाट आधा भागसम्म आउँदथ्यो।<verse eid="EXO 38:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 38:5"/>डण्डाहरू राख्नका निम्ति तिनले काँसोका चार वटा मुन्द्राहरू बनाएर चारै कुनामा राखे।<verse eid="EXO 38:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 38:6"/>बबुल काठका डण्डाहरू बनाए, र तिनलाई तिनले काँसोले मोहोरे।<verse eid="EXO 38:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 38:7"/>तिनले ती डण्डाहरूलाई वेदी बोक्नका निम्ति त्यसका दुवै तर्फका किनारका मुन्द्राहरूमा हाले। फल्याकहरूबाट तिनले त्यस वेदीलाई खोक्रो बनाए।<verse eid="EXO 38:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 38:8"/>तिनले समागम पालको ढोकामा सेवा गर्ने स्त्रीहरूका ऐनाबाट काँसोका धुने बाटा र आसन बनाए।<verse eid="EXO 38:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 38:9"/>त्यसपछि तिनले आँगन बनाए। त्यसको दक्षिण भागपट्टिको लम्बाइ एक सय क्यूबिट र पर्दाचाहिँ मसिनो गरी बाटेको सुती कपडाको थियो।<verse eid="EXO 38:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 38:10"/>त्यसका खाँबाहरू बीस वटा र काँसाका आधारहरू पनि बीस वटा नै थिए; खाँबोका अङ्कुसेहरू र फित्ताहरू चाँदीका थिए।<verse eid="EXO 38:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 38:11"/>आँगनको उत्तरपट्टिको निम्ति एक सय क्यूबिट लामा पर्दाहरू र बीस वटा खाँबाहरू, र काँसोका आधारहरू पनि बीस वटा नै थिए। त्यसका अङ्कुसेहरू र फित्ताहरू चाँदीका थिए।<verse eid="EXO 38:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 38:12"/>पश्‍चिमपट्टि पचास क्यूबिट चौडा पर्दाहरू थिए; त्यसका खाँबाहरू र आधारहरू पनि दश-दश वटा थिए। खम्बाहरूका अङ्कुसे र फित्ताहरू चाँदीका थिए।<verse eid="EXO 38:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 38:13"/>पूर्व वा सूर्योदयतर्फ पनि पचास क्यूबिट चौडा थियो।<verse eid="EXO 38:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 38:14"/>मूलढोकाको एकापट्टिका पर्दाहरू पन्ध्र क्यूबिट लामा थिए; जसका तीन वटा खाँबाहरू र तीन वटा आधारहरू थिए।<verse eid="EXO 38:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 38:15"/>आँगनको मूलढोकाको अर्कापट्टि पन्ध्र क्यूबिट लामा पर्दाहरू थिए; तीन वटा खाँबाहरू र तीन वटा आधारहरू थिए।<verse eid="EXO 38:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 38:16"/>आँगनका चारैपट्टिका सबै पर्दाहरू मसिनो गरी बाटिएका सुती कपडाका थिए।<verse eid="EXO 38:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 38:17"/>खाँबाका आधारहरू काँसोका थिए। यसका अङ्कुसेहरू र फित्ताहरूचाहिँ चाँदीले बनाइएका र टुप्पाहरू चाँदीले नै मोहोरिएका थिए। आँगनका सबै खाँबाहरूमा चाँदीका फित्ताहरू थिए।<verse eid="EXO 38:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 38:18"/>आँगनको मूलढोकाको पर्दामा बुट्टा हाल्नेको काम, जसलाई निलो, बैजनी र रातो रङ्गको मसिनो सुतीले बुनेको कपडाले बनाइएको थियो। यसको लम्बाइ बीस क्यूबिट र आँगनको पर्दाझैँ पाँच क्यूबिट उचाइ थियो।<verse eid="EXO 38:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 38:19"/>त्यसका खाँबाहरू चार वटा र काँसोका आधारहरू चार वटा थिए। त्यसका अङ्कुसेहरू र फित्ताहरू चाँदीले बनेका थिए; अनि टुप्पाहरू चाँदीले मोहोरिएका थिए।<verse eid="EXO 38:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 38:20"/>समागम पाल र चारैतिर आँगनका किलाहरू काँसाका थिए।<verse eid="EXO 38:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 38:21"/>मोशाका आज्ञाअनुसार पुजारी हारूनका छोरा ईतामारद्वारा लेवीहरूले समागम पाल, करारको पाल, जुनचाहिँ समागम पाल हो, बनाउनका निम्ति प्रयोग गरेका सरसामानहरूको वर्णन यही हो:<verse eid="EXO 38:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 38:22"/>(यहूदा कुलका हूरका नाति, ऊरीका छोरा बजलेलले याहवेहले मोशालाई आज्ञा गर्नुभएअनुसार सबै कुराहरू बनाए।<verse eid="EXO 38:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 38:23"/>उनको साथमा दान कुलका अहीसामाकका छोरा ओहोलीआब थिए। तिनी एक शिल्पकार तथा चित्रहरू बनाउने र निलो, बैजनी, रातो रङ्गका धागो र मसिनो सुती कपडामा बुट्टा भर्ने काममा निपूर्ण थिए।)<verse eid="EXO 38:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 38:24"/>पवित्र वासस्थान बनाउन विशेष भेटीको रूपमा अर्पण भएका सबै भेटीको सुन पवित्र वासस्थानको सेकेलको हिसाबअनुसार 29 टालेन्ट र 730 सेकेल थियो।<verse eid="EXO 38:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 38:25"/>सारा समुदायमा गणना भएको मानिसहरूका चाँदी पवित्र वासस्थानको हिसाबअनुसार 100 टालेन्ट र 1,775 सेकेल थियो।<verse eid="EXO 38:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 38:26"/>बीस वर्ष र त्यसभन्दा बढी उमेर समूहका 6,03,550 पुरुषहरूमध्ये प्रत्येकबाट पवित्र वासस्थानको शेकेलको हिसाबले आधा सेकेल थियो।<verse eid="EXO 38:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 38:27"/>100 टालेन्ट चाँदी पवित्र वासस्थान र पर्दाको आधारहरू ढाल्न प्रयोग भयो; सबै आधारहरूमा 100 टालेन्ट थियो—प्रत्येक आधारका निम्ति एक टालेन्ट।<verse eid="EXO 38:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 38:28"/>तिनले चाँदीका 1,775 सेकेललाई खाँबोका निम्ति अङ्कुसेहरू बनाउन र तिनका टुप्पाहरू मोहोर्न फित्ताहरू बनाए र प्रयोग गरे।<verse eid="EXO 38:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 38:29"/>विशेष भेटीको रूपमा अर्पण गरिएका काँसोका भेटी 70 टालेन्ट र 2,400 सेकेल थियो।<verse eid="EXO 38:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 38:30"/>ती काँसोबाट तिनले भेट हुने पालका ढोकाका आधारहरू, काँसोका वेदी, जाली र त्यसका सबै सरसामानहरू बनाए।<verse eid="EXO 38:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 38:31"/>आँगनका चारैपट्टिका आधारहरू, मूलढोकाका आधारहरू, समागम पालका र आँगनका चारैतिरका सबै किलाहरू बनाए।<verse eid="EXO 38:31"/></para>
<chapter eid="EXO 38"/>
<chapter number="39" style="c" sid="EXO 39"/>
<para style="p"><verse number="1" style="v" sid="EXO 39:1"/>तिनीहरूले पवित्रस्थानका सेवाका निम्ति निलो, बैजनी र रातो धागोले बुनेका पोशाकहरू बनाए। याहवेहले मोशालाई आज्ञा गर्नुभएझैँ तिनीहरूले हारूनका निम्ति पनि पवित्र पोशाकहरू बनाए।<verse eid="EXO 39:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 39:2"/>तिनीहरूले एपोदचाहिँ सुन, निलो, बैजनी, रातो रङ्गको धागो र मसिनो गरी बाटेको सुती कपडाको बनाए।<verse eid="EXO 39:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 39:3"/>तिनीहरूले सुनलाई पिटेर पातलो पाताबाट स-साना डोरीहरू बनाए; अनि त्यसलाई निलो, बैजनी, रातो रङ्गको धागो र मसिनो सुती कपडामा जडे, जुनचाहिँ निपूर्ण कारिगरको हातको काम थियो।<verse eid="EXO 39:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 39:4"/>एपोदका निम्ति तिनीहरूले दुई वटा काँधे-जोर्नीहरू बनाए; अनि त्यसलाई बाँध्नका निम्ति त्यसका छेउमा लगाइदिए।<verse eid="EXO 39:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 39:5"/>याहवेहले मोशालाई आज्ञा गर्नुभएबमोजिम सिपालु गरी बुनेको पटुका एपोदसँग एकै प्रकारका सामग्रीहरूबाट बनिएको थियो: सुन, निलो, बैजनी, रातो रङ्गको धागो र मसिनो गरी बाटेको सुती कपडाको थियो।<verse eid="EXO 39:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 39:6"/>तिनीहरूले आनिक्स पत्थरहरू सुनका मणिघरहरूमा जडे, र छापमा झैँ इस्राएलका छोराहरूका नाम त्यसमा खोपे।<verse eid="EXO 39:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 39:7"/>याहवेहले मोशालाई आज्ञा गर्नुभएझैँ तिनीहरूले ती पत्थरहरू सम्झनाका निम्ति इस्राएलका छोराहरूका एपोदका काँधे-जोर्नीहरूमा लगाए।<verse eid="EXO 39:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 39:8"/>सिपले निपूर्ण मानिसलेझैँ तिनीहरूले छाती-पाता बनाए। सुन, निलो, बैजनी, रातो रङ्गको धागो र मसिनो गरी बाटेको सुती कपडाबाट तिनीहरूले त्यो एपोदजस्तै बनाए।<verse eid="EXO 39:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 39:9"/>त्यो वर्गाकार, एक बित्ता लामो र एक बित्ता चौडा, अनि दोबारेर पट्ट्याइएको थियो।<verse eid="EXO 39:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 39:10"/>तब तिनीहरूले त्यसका चार पङ्‌क्तिमा बहुमूल्य पत्थरहरू जडे। पहिलो पङ्‌क्तिमा माणिक, पुष्पराज र पन्‍ना;<verse eid="EXO 39:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 39:11"/>दोस्रो पङ्‌क्तिमा फिरोजा, नीलमणि र हीरा;<verse eid="EXO 39:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 39:12"/>तेस्रो पङ्‌क्तिमा धूम्रकान्त, सूर्यकान्त र नीलमणि;<verse eid="EXO 39:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 39:13"/>अनि चौथो पङ्‌क्तिमा फिरोज, गोमेद र स्फटिक थिए। ती सुनको मणिघरहरूमा जडिएका थिए।<verse eid="EXO 39:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 39:14"/>बाह्र पत्थरहरूमा इस्राएलका बाह्र कुलहरू जनाउन प्रत्येकमा छापमा खोपेझैँ एक-एक गरी इस्राएलका छोराहरूका नाम थिए।<verse eid="EXO 39:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 39:15"/>छाती-पाताको निम्ति तिनीहरूले डोरीजस्तो बाटेको निखुर सुनका सिक्रीहरू बनाए।<verse eid="EXO 39:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 39:16"/>तिनीहरूले सुनका दुई वटा मणिघरहरू र दुई वटा मुन्द्राहरू बनाए; अनि ती दुवै मुन्द्राहरूलाई छाती-पाताको दुई कुनामा लगाए।<verse eid="EXO 39:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 39:17"/>तिनीहरूले बनाएका ती सुनका दुई सिक्रीहरूलाई छाती-पाताको कुनामा भएका मुन्द्राहरूमा लगाए,<verse eid="EXO 39:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 39:18"/>अनि सिक्रीका अरू छेउहरूलाई अगिल्तिर भएको एपोदका काँधे-जोर्नीहरूका अगाडिपट्टि मिलाएर दुवैलाई सुनका मणिघरहरूमा लगाए।<verse eid="EXO 39:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 39:19"/>तिनीहरूले सुनका दुई वटा मुन्‍द्रा बनाएर छाती-पाताको अर्को दुई किनारमा एपोदको भित्री भागमा लगाए।<verse eid="EXO 39:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 39:20"/>तब तिनीहरूले सुनका अरू दुई वटा मुन्द्राहरू बनाए, र दुवै काँधे-जोर्नीहरूका मुनि एपोदको अगाडिपट्टि पटुकाको ठिक माथि सिउनीनिर लगाए।<verse eid="EXO 39:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 39:21"/>याहवेहले मोशालाई आज्ञा गर्नुभएझैँ तिनीहरूले छाती-पाताका मुन्द्राहरूलाई निलो धागोले बाँधे, ताकि त्यो एपोदबाट सर्न नसकोस्।<verse eid="EXO 39:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 39:22"/>तिनीहरूले एपोदको अलखा सबै निलो रङ्गले बुनेको कपडाको बनाए।<verse eid="EXO 39:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 39:23"/>त्यसको बीचमा कठालोको प्वालजस्तो अलखाको प्वाल बनाए, र वरिपरि बिट बुनिदिए, ताकि त्यो नफाटोस्।<verse eid="EXO 39:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 39:24"/>त्यसको तल्‍लो फेरोमा तिनीहरूले निलो, बैजनी, र रातो धागो र मसिनो गरी बाटेको सुती कपडाको दारिमहरू बनाए।<verse eid="EXO 39:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 39:25"/>तिनीहरूले निखुर सुनका घण्टीहरू बनाए, र ती अलखाको फेरोको वरिपरि र दारिमहरूको बीचमा लगाए।<verse eid="EXO 39:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 39:26"/>याहवेहले मोशालाई आज्ञा गर्नुभएझैँ तिनीहरूले सेवा गर्दा लगाउनका निम्ति ती सुनका घण्टीहरू अलखाको फेरो र दारिमहरूको वरिपरि लगाए।<verse eid="EXO 39:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 39:27"/>तिनीहरूले हारून र तिनका छोराहरूका निम्ति मसिनो सुती कपडाका लवेदाहरू<verse eid="EXO 39:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 39:28"/>अनि मसिनो सुती कपडाका फेटा, टोपीहरू र सुती कपडाकै भित्री वस्त्रहरू पनि बनाए।<verse eid="EXO 39:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 39:29"/>त्यसै गरी याहवेहले मोशालाई आज्ञा गर्नुभएबमोजिम तिनीहरूले शिल्पकारीले झैँ मसिनो गरी बाटेको सुतीको कपडा, निलो, बैजनी र रातो रङ्गको बुट्टेदार भएको पटुका बनाए।<verse eid="EXO 39:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 39:30"/>तिनीहरूले पाता, अर्थात् निखुर सुनले पवित्र मुकुट बनाए, र छापको खोपझैँ यी कुरा खोपे: याहवेहका निम्ति पवित्र।<verse eid="EXO 39:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 39:31"/>तब याहवेहले मोशालाई आज्ञा गर्नुभएबमोजिम तिनीहरूले त्यस पातालाई निलो डोरीले फेटामा लगाउनलाई बाँधे।<verse eid="EXO 39:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 39:32"/>यसरी भेट हुने पाल, अर्थात् समागम पालको सम्पूर्ण कार्य सकियो। याहवेहले मोशालाई जस्तो आज्ञा गर्नुभएको थियो, त्यस्तै इस्राएलीहरूले गरे।<verse eid="EXO 39:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 39:33"/>तब तिनीहरूले मोशाकहाँ समागम पाल ल्याए: पाल र त्यसका सबै सरसामानहरू, त्यसका अङ्कुसेहरू, फल्याकहरू, तेर्सो बारहरू, खाँबाहरू र आधारहरू;<verse eid="EXO 39:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 39:34"/>रातो रङ्गले रङ्गाएका भेडाका छालाहरू र पर्दाहरू ढाक्नका निम्ति सीलका छालाहरू, छेक्ने पर्दा;<verse eid="EXO 39:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 39:35"/>करारको सन्दुक, त्यसका डण्डाहरू र पाप समाधान-स्थान;<verse eid="EXO 39:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 39:36"/>टेबुल र त्यसका सबै सरसामानहरू र उपस्थितिको रोटी;<verse eid="EXO 39:36"/></para>
<para style="p"><verse number="37" style="v" sid="EXO 39:37"/>निखुर सुनको सामदान, त्यसका दियाहरू, सबै सरसामानहरू अनि प्रकाशको निम्ति जैतुनको तेल;<verse eid="EXO 39:37"/></para>
<para style="p"><verse number="38" style="v" sid="EXO 39:38"/>सुनको वेदी, अभिषेक गर्ने तेल, सुगन्धित धूप र पालको ढोकाको निम्ति पर्दा;<verse eid="EXO 39:38"/></para>
<para style="p"><verse number="39" style="v" sid="EXO 39:39"/>काँसोका वेदी, त्यसको जाली, डण्डाहरू र सबै सामानहरू; हात धुने बाटा र त्यसका आसन;<verse eid="EXO 39:39"/></para>
<para style="p"><verse number="40" style="v" sid="EXO 39:40"/>आँगनका पर्दाहरू, त्यसका खाँबाहरू, त्यसका आधारहरू र आँगनको ढोकाको निम्ति पर्दाहरू; आँगनका निम्ति डोरीहरू र किलाहरू; समागम पालको भेट हुने पालको निम्ति सबै सरसामानहरू;<verse eid="EXO 39:40"/></para>
<para style="p"><verse number="41" style="v" sid="EXO 39:41"/>अनि पवित्रस्थानमा सेवाको निम्ति बुनिएका पोशाकहरू, पुजारी हारूनका निम्ति पवित्र पोशाकहरू र पुजारीकै पदमा रही सेवा गर्नका निम्ति हारूनका छोराहरूका पोशाकहरू।<verse eid="EXO 39:41"/></para>
<para style="p"><verse number="42" style="v" sid="EXO 39:42"/>याहवेहले मोशालाई आज्ञा गर्नुभएअनुसार इस्राएलीहरूले सबै काम गरे।<verse eid="EXO 39:42"/></para>
<para style="p"><verse number="43" style="v" sid="EXO 39:43"/>मोशाले सबै काम हेरे; अनि ती काम याहवेहले आज्ञा गर्नुभएअनुसार थिए। त्यसकारण मोशाले तिनीहरूलाई आशिष् दिए।<verse eid="EXO 39:43"/></para>
<chapter eid="EXO 39"/>
<chapter number="40" style="c" sid="EXO 40"/>
<para style="p"><verse number="1" style="v" sid="EXO 40:1"/>तब याहवेहले मोशालाई भन्‍नुभयो:<verse eid="EXO 40:1"/></para>
<para style="p"><verse number="2" style="v" sid="EXO 40:2"/>“महिनाको पहिलो दिन समागम पालको भेट हुने पाल खडा गर्नू।<verse eid="EXO 40:2"/></para>
<para style="p"><verse number="3" style="v" sid="EXO 40:3"/>त्यसमा करारको सन्दुक राखेर त्यसलाई पर्दाले ढाक्नू।<verse eid="EXO 40:3"/></para>
<para style="p"><verse number="4" style="v" sid="EXO 40:4"/>टेबुल भित्र ल्याउनू र त्यसका सबै सरसामानहरू त्यसमाथि राख्नू। त्यसपछि सामदान भित्र ल्याउनू र दियाहरू मिलाउनू।<verse eid="EXO 40:4"/></para>
<para style="p"><verse number="5" style="v" sid="EXO 40:5"/>करारको सन्दुकको अगाडिपट्टि धूपको निम्ति सुनको वेदी राख्नू; अनि समागम पालको ढोकामा पर्दा लगाउनू।<verse eid="EXO 40:5"/></para>
<para style="p"><verse number="6" style="v" sid="EXO 40:6"/>“समागम पालको भेट हुने पाल अगाडिपट्टि होमबलिको वेदी राख्नू।<verse eid="EXO 40:6"/></para>
<para style="p"><verse number="7" style="v" sid="EXO 40:7"/>भेट हुने पाल र वेदीको बीचमा बाटामा पानी भरेर राख्नू।<verse eid="EXO 40:7"/></para>
<para style="p"><verse number="8" style="v" sid="EXO 40:8"/>यसको वरिपरि आँगन बनाउनू, र यसको ढोकामा पर्दा लगाउनू।<verse eid="EXO 40:8"/></para>
<para style="p"><verse number="9" style="v" sid="EXO 40:9"/>“अभिषेक गर्ने तेलले समागम पाल र त्यहाँ भएका सबै सरसामानहरूलाई अभिषेक गर्नू, त्यसलाई र त्यसका सबै सरसामानहरूलाई नै शुद्ध गर्नू, र त्यो पवित्र हुनेछ।<verse eid="EXO 40:9"/></para>
<para style="p"><verse number="10" style="v" sid="EXO 40:10"/>त्यसपछि होमबलिको वेदी र त्यसको सबै सरसामानहरूलाई अभिषेक गर्नू, र त्यो महा-पवित्र हुनेछ।<verse eid="EXO 40:10"/></para>
<para style="p"><verse number="11" style="v" sid="EXO 40:11"/>पानीको बाटा र त्यसको खुट्टालाई अभिषेक गरी शुद्ध गर्नू।<verse eid="EXO 40:11"/></para>
<para style="p"><verse number="12" style="v" sid="EXO 40:12"/>“हारून र तिनका छोराहरूलाई भेट हुने पालको ढोकामा ल्याउनू, र तिनीहरूलाई पानीले धुनू।<verse eid="EXO 40:12"/></para>
<para style="p"><verse number="13" style="v" sid="EXO 40:13"/>अनि हारूनलाई पवित्र पोशाक पहिर्‍याएर अभिषेक गर्नू र शुद्ध गर्नू; ताकि त्यसले पुजारी भई मेरो सेवा गरोस्।<verse eid="EXO 40:13"/></para>
<para style="p"><verse number="14" style="v" sid="EXO 40:14"/>त्यसका छोराहरूलाई ल्याउनू, र लबेदा पहिर्‍याइदिनू।<verse eid="EXO 40:14"/></para>
<para style="p"><verse number="15" style="v" sid="EXO 40:15"/>तिनीहरूका पितालाई अभिषेक गरेजस्तै तैँले तिनीहरूलाई पनि अभिषेक गर्नू, ताकि तिनीहरूले पुजारी भई मेरो सेवा गरून्। अनि तिनीहरूको अभिषेक एक पुजारी भई तिनीहरूका पुस्तामा निरन्तर रहनेछ।”<verse eid="EXO 40:15"/></para>
<para style="p"><verse number="16" style="v" sid="EXO 40:16"/>याहवेहले मोशालाई आज्ञा गर्नुभएअनुसार नै तिनले त्यो गरे।<verse eid="EXO 40:16"/></para>
<para style="p"><verse number="17" style="v" sid="EXO 40:17"/>यसरी दोस्रो वर्षको पहिलो महिनाको, पहिलो दिनमा समागम पाल खडा गरियो।<verse eid="EXO 40:17"/></para>
<para style="p"><verse number="18" style="v" sid="EXO 40:18"/>जब मोशाले समागम पाल खडा गरे, तिनले त्यसका आधारहरू र फल्याकहरू खडा गरी बारहरू लगाए, र त्यसका खाँबाहरू गाडे।<verse eid="EXO 40:18"/></para>
<para style="p"><verse number="19" style="v" sid="EXO 40:19"/>त्यसपछि याहवेहले मोशालाई आज्ञा गर्नुभएअनुसार तिनले समागम पालमाथि पाल फैलाएर त्यसको माथिपट्टि छत लगाए।<verse eid="EXO 40:19"/></para>
<para style="p"><verse number="20" style="v" sid="EXO 40:20"/>तिनले साक्षी पाटी ल्याई त्यसलाई सन्दुकभित्र राखे, र त्यसमा डण्डाहरू राखे, र सन्दुकमाथि पाप समाधान-स्थान राखे।<verse eid="EXO 40:20"/></para>
<para style="p"><verse number="21" style="v" sid="EXO 40:21"/>त्यसपछि तिनले त्यो सन्दुकलाई समागम पालभित्र ल्याए, र त्यसलाई पर्दाले ढाकिदिए; जस्तो याहवेहले मोशालाई आज्ञा गर्नुभएको थियो।<verse eid="EXO 40:21"/></para>
<para style="p"><verse number="22" style="v" sid="EXO 40:22"/>मोशाले भेट हुने पालमा समागम पालको उत्तरपट्टिको पर्दाको बाहिरपट्टि टेबुल राखे।<verse eid="EXO 40:22"/></para>
<para style="p"><verse number="23" style="v" sid="EXO 40:23"/>याहवेहले तिनलाई आज्ञा गर्नुभएअनुसार तिनले याहवेहको सामु टेबुलमा रोटी सजाएर राखे।<verse eid="EXO 40:23"/></para>
<para style="p"><verse number="24" style="v" sid="EXO 40:24"/>मोशाले भेट हुने पालभित्र समागम पालको दक्षिणतर्फको भागमा टेबुलको विपरीत सामदान राखे;<verse eid="EXO 40:24"/></para>
<para style="p"><verse number="25" style="v" sid="EXO 40:25"/>अनि याहवेहले आज्ञा गर्नुभएअनुसार तिनले याहवेहको सामु दियाहरू बाले।<verse eid="EXO 40:25"/></para>
<para style="p"><verse number="26" style="v" sid="EXO 40:26"/>भेट हुने पालको पर्दाको सामु मोशाले सुनको वेदी बनाए;<verse eid="EXO 40:26"/></para>
<para style="p"><verse number="27" style="v" sid="EXO 40:27"/>अनि याहवेहले तिनलाई आज्ञा गर्नुभएअनुसार तिनले सुगन्धित धूप बाले।<verse eid="EXO 40:27"/></para>
<para style="p"><verse number="28" style="v" sid="EXO 40:28"/>त्यसपछि तिनले समागम पालको ढोकामा पर्दा लगाए।<verse eid="EXO 40:28"/></para>
<para style="p"><verse number="29" style="v" sid="EXO 40:29"/>याहवेहले मोशालाई आज्ञा गर्नुभएअनुसार तिनले समागम पालको भेट हुने पालको ढोकाको नजिक वेदी बनाएर होमबलि र अन्‍नबलि चढाए।<verse eid="EXO 40:29"/></para>
<para style="p"><verse number="30" style="v" sid="EXO 40:30"/>तिनले समागम पाल र वेदीको बीचमा बाटा राखेर धुनलाई त्यसमा पानी भरे।<verse eid="EXO 40:30"/></para>
<para style="p"><verse number="31" style="v" sid="EXO 40:31"/>अनि मोशा, हारून र तिनका छोराहरूले त्यसबाट आ-आफ्ना हातहरू र खुट्टाहरू धोए।<verse eid="EXO 40:31"/></para>
<para style="p"><verse number="32" style="v" sid="EXO 40:32"/>तिनीहरू जहिले-जहिले भेट हुने पाल, अर्थात् वेदीको नजिक आउँथे, तब तिनीहरूले आ-आफ्ना हातहरू र खुट्टाहरू धुने गर्दथे; जस्तो याहवेहले मोशालाई आज्ञा गर्नुभएको थियो।<verse eid="EXO 40:32"/></para>
<para style="p"><verse number="33" style="v" sid="EXO 40:33"/>त्यसपछि मोशाले याहवेहले आज्ञा गर्नुभएअनुसार वेदी खडा गरे र आँगनको ढोकामा पर्दा लगाए। यसरी मोशाले काम सिद्ध्याए।<verse eid="EXO 40:33"/></para>
<para style="p"><verse number="34" style="v" sid="EXO 40:34"/>तब भेट हुने पाललाई बादलले ढाक्यो, र समागम पाल याहवेहको महिमाले भरियो।<verse eid="EXO 40:34"/></para>
<para style="p"><verse number="35" style="v" sid="EXO 40:35"/>मोशाचाहिँ भेट हुने पालभित्र पस्‍न सकेनन्; किनकि बादल त्यसमाथि बसिरह्‍यो र याहवेहको महिमाले समागम पाल भरियो।<verse eid="EXO 40:35"/></para>
<para style="p"><verse number="36" style="v" sid="EXO 40:36"/>इस्राएलीहरूका सबै यात्राभरि जहिले-जहिले त्यो बादल समागम पालबाट उठ्थ्यो, तब तिनीहरू अगाडि बढ्थे;<verse eid="EXO 40:36"/></para>
<para style="p"><verse number="37" style="v" sid="EXO 40:37"/>तर यदि बादल उठेर गएन भने नउठेको त्यस दिनसम्म तिनीहरू हिँड्दैनथे।<verse eid="EXO 40:37"/></para>
<para style="p"><verse number="38" style="v" sid="EXO 40:38"/>यसरी सारा इस्राएलीहरूले तिनीहरूका सबै यात्राभरि समागम पालमाथि दिनमा याहवेहको बादल र राति बादलमा आगो देख्थे।<verse eid="EXO 40:38"/></para>
<chapter eid="EXO 40"/>
</usx>