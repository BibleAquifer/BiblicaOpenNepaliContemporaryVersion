<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="JUD" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">यहूदा</para>
<para style="toc1">यहूदा</para>
<para style="toc2">यहूदा</para>
<para style="mt1">यहूदा</para>
<chapter number="1" style="c" sid="JUD 1"/>
<para style="p"><verse number="1" style="v" sid="JUD 1:1"/>येशू ख्रीष्‍टको सेवक र याकोबको भाइ यहूदाबाट, तिनीहरूलाई, जो परमेश्‍वर पिताबाट बोलाइएका, प्रेम गरिएका र येशू ख्रीष्‍टको लागि सुरक्षित राखिएका छन्:<verse eid="JUD 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="JUD 1:2"/>तिमीहरूलाई प्रशस्त मात्रामा कृपा, शान्ति र प्रेम!<verse eid="JUD 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="JUD 1:3"/>प्रिय मित्रहरू हो, म तिमीहरूलाई हामी सहभागी भएको मुक्तिको विषयमा लेख्न अति इच्छुक भए तापनि परमेश्‍वरका सन्तहरूलाई सधैँको निम्ति सुम्पिएको विश्‍वासको रक्षा गर भनेर तिमीहरूलाई बिन्ती गर्दै लेख्न मलाई इच्छा लाग्यो।<verse eid="JUD 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="JUD 1:4"/>किनकि धेरै अगिदेखि दण्डको भागीदार छन् भनी लेखिएका कतिपय मानिसहरू तिमीहरूका बीचमा गुप्‍त रूपले पसिसकेका छन्। तिनीहरू ईश्‍वरहीन मानिसहरू हुन्, जसले हाम्रा परमेश्‍वरको अनुग्रहलाई दुष्‍ट आचरणको अनुमतिपत्रको रूपमा बदल्छन्, र हाम्रा एक मात्र मालिक र प्रभु येशू ख्रीष्‍टलाई इन्कार गर्दछन्।<verse eid="JUD 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="JUD 1:5"/>तिमीहरूले यो सबै जानिसकेका छौ तापनि म तिमीहरूलाई यो स्मरण गराउन चाहन्छु—प्रभुले आफ्नो जातिलाई इजिप्टबाट निकालेर ल्याउनुभयो; तर विश्‍वास नगर्नेहरूलाई पछिबाट नष्‍ट गर्नुभयो।<verse eid="JUD 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="JUD 1:6"/>ती स्वर्गदूतहरू, जसले आफ्नो अधिकारको स्थान राखेनन्, तर तिनीहरूका आफ्नै घरसमेत त्याग गर्नेलाई उहाँले त्यस महान् दिनको न्यायको निम्ति अनन्तको साङ्लोले बाँधेर अन्धकारमा राख्नुभएको छ।<verse eid="JUD 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="JUD 1:7"/>यस्तै किसिमले सदोम र गमोरा, र छेउछाउका सहरहरूले आफूलाई व्यभिचारको अनैतिकता र भ्रष्‍टताको लागि दिइहाले। तिनीहरू अनन्तको आगोको दण्ड भोग्नेहरूका नमुना भएका छन्।<verse eid="JUD 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="JUD 1:8"/>ठिक यही किसिमले यी मानिसहरू गुप्‍त रूपले पसेका छन्। यी ईश्‍वरहीन मानिसहरूले सपनाको आधारमा तिनीहरूका आफ्नै शरीरलाई दूषित पार्छन्; अधिकारलाई इन्कार गर्दछन्, र स्वर्गीय प्राणीहरूको निन्दा गर्छन्।<verse eid="JUD 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="JUD 1:9"/>तर प्रधान दूत माइकलले पनि मोशाको शरीरको विषयमा शैतानसित विवाद गर्दा त्यसको विरुद्धमा निन्दापूर्ण दोष लगाउन साहस गरेनन्, तर “प्रभुले तिमीलाई हप्काऊन्!” मात्र भनेका थिए।<verse eid="JUD 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="JUD 1:10"/>तरै पनि यी मानिसहरूले निर्बुद्धि पशुहरूझैँ सहज बुद्धिले कुरा बुझ्छन्; त्यसैले तिनीहरू आफूले नबुझेका कुराहरूको निन्दा गर्छन्। यी कुराहरूले नै तिनीहरूलाई नष्‍ट गर्नेछन्।<verse eid="JUD 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="JUD 1:11"/>यस्ताहरूलाई धिक्‍कार छ! तिनीहरू कयिनको बाटोमा लागेका छन्। तिनीहरू लाभको निम्ति बालामको गल्तीतिर हतारिन्छन्। तिनीहरू कोरहको विद्रोहमा जस्तै नष्‍ट भएका छन्।<verse eid="JUD 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="JUD 1:12"/>यी मानिसहरू तिमीहरूका प्रेम भोजहरूमा कलङ्कहरू हुन्, जो सङ्कोचविना निर्धक्‍कसित तिमीहरूसँगै खान्छन्। तिनीहरू आफ्नै मात्र पेट भर्ने गोठालाहरू हुन्। तिनीहरू बतासले उडाइएका पानीविनाका बादलहरू हुन्। तिनीहरू शरद ऋतुका फल नभएका दुई पल्ट मरिसकेका र जरैसित उखेलिएका रूखहरू हुन्।<verse eid="JUD 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="JUD 1:13"/>तिनीहरू समुद्रका उर्लंदा छालहरू हुन्; जसले आफ्नै शर्मको फिँज काढ्छन्। तिनीहरू डुलुवा ताराहरू हुन्, जसका लागि सबैभन्दा कालो अन्धकार सदाको लागि साँचिएको छ।<verse eid="JUD 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="JUD 1:14"/>आदमदेखि सातौँ पुस्ताका हनोकले यस्ता मानिसहरूबारे यसरी अगमवाणी गरेका थिए: “हेर, प्रभु हरेकको न्याय गर्नलाई आफ्ना हजारौँ-हजार पवित्र जनहरूसँग आउँदैहुनुहुन्छ;<verse eid="JUD 1:14"/></para>
<para style="p"><verse number="15" style="v" sid="JUD 1:15"/>अनि ती सबै, जसले अभद्र तरिकाले ईश्‍वरहीन कामहरू गरे, र ईश्‍वरहीन पापीहरूले उहाँको विरुद्धमा बोलेका सबै कुराहरूको दण्ड दिनलाई आउँदैहुनुहुन्छ।”<verse eid="JUD 1:15"/></para>
<para style="p"><verse number="16" style="v" sid="JUD 1:16"/>यी मानिसहरू गनगन गर्नेहरू र दोष खोज्नेहरू हुन्। तिनीहरू आफ्नै दुष्‍ट विचारको पछि लाग्छन्। तिनीहरू आफ्नै विषयमा घमण्ड गर्छन्, र तिनीहरू आफ्नै लाभको निम्ति अरूको चापलुसी गर्दछन्।<verse eid="JUD 1:16"/></para>
<para style="p"><verse number="17" style="v" sid="JUD 1:17"/>तर प्रिय मित्रहरू हो, हाम्रा प्रभु येशू ख्रीष्‍टका प्रेरितहरूले पहिलेबाट नै के भनेका छन्, सो सम्झना गर।<verse eid="JUD 1:17"/></para>
<para style="p"><verse number="18" style="v" sid="JUD 1:18"/>तिनीहरूले तिमीहरूलाई भने, “अन्तिम समयहरूमा आफ्नै इच्छाहरूको पछि लाग्ने ईश्‍वरहीन निन्दकहरू हुनेछन्।”<verse eid="JUD 1:18"/></para>
<para style="p"><verse number="19" style="v" sid="JUD 1:19"/>यिनीहरू त्यस्ता मानिसहरू हुन्, जसले तिमीहरूमा विभाजन ल्याउँछन्, जससित परमेश्‍वरको आत्मा नभएका, तर सहज बुद्धिको पछि लाग्नेहरू हुन्।<verse eid="JUD 1:19"/></para>
<para style="p"><verse number="20" style="v" sid="JUD 1:20"/>तर प्रिय मित्रहरू हो, तिमीहरूले आफूलाई अति पवित्र विश्‍वासमा निर्माण गर, पवित्र आत्मामा प्रार्थना गर।<verse eid="JUD 1:20"/></para>
<para style="p"><verse number="21" style="v" sid="JUD 1:21"/>प्रभु येशू ख्रीष्‍टले तिमीहरूलाई अनन्त जीवनमा लैजाने कृपालाई पर्खंदा तिमीहरू आफूलाई परमेश्‍वरको प्रेममा स्थिर बनाइराख।<verse eid="JUD 1:21"/></para>
<para style="p"><verse number="22" style="v" sid="JUD 1:22"/>शङ्कालुहरूप्रति कृपालु बन।<verse eid="JUD 1:22"/></para>
<para style="p"><verse number="23" style="v" sid="JUD 1:23"/>आगोको अनन्त नरकमा पर्न लागेका केही मानिसहरूलाई झट्टै बचाओ; उहाँको डरलाई हृदयमा राखेर अरूहरूप्रति सधैँ दया देखाओ। भ्रष्‍ट शरीरले दाग लगाएको वस्त्रलाई घृणा गर।<verse eid="JUD 1:23"/></para>
<para style="p"><verse number="24" style="v" sid="JUD 1:24"/>अब उहाँलाई नै, जसले तिमीहरूलाई पतन हुनदेखि बचाउनुहुन्छ, र जसले तिमीहरूलाई उहाँको महिमित उपस्थितिमा अति आनन्दसाथ निष्कलङ्क प्रस्तुत गर्न सक्नुहुन्छ,<verse eid="JUD 1:24"/></para>
<para style="p"><verse number="25" style="v" sid="JUD 1:25"/>हाम्रा एउटै मुक्तिदाता परमेश्‍वरलाई हाम्रा प्रभु येशू ख्रीष्‍टद्वारा महिमा, गौरव, पराक्रम र अधिकार युगानुयुग, पहिलेदेखि अहिले र सदासर्वदा भइरहोस्! आमेन।<verse eid="JUD 1:25"/></para>
<chapter eid="JUD 1"/>
</usx>