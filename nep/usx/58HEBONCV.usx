<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="HEB" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">हिब्रूहरू</para>
<para style="toc1">हिब्रूहरू</para>
<para style="toc2">हिब्रूहरू</para>
<para style="mt1">हिब्रूहरू</para>
<chapter number="1" style="c" sid="HEB 1"/>
<para style="p"><verse number="1" style="v" sid="HEB 1:1"/>बितेका समयमा परमेश्‍वर हाम्रा पुर्खाहरूसँग धेरै पटक विभिन्‍न प्रकारले अगमवक्ताहरूद्वारा बोल्नुभयो;<verse eid="HEB 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 1:2"/>तर यी अन्तिम दिनहरूमा चाहिँ उहाँ आफ्नो पुत्रद्वारा हामीसँग बोल्नुभएको छ। पुत्रलाई नै उहाँले सबै कुराहरूको उत्तराधिकारी बनाउनुभएको हो, जसद्वारा उहाँले समस्त विश्‍वलाई पनि बनाउनुभयो।<verse eid="HEB 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 1:3"/>पुत्रचाहिँ परमेश्‍वरको महिमाको चमक र उहाँ परमेश्‍वरकै स्वभावको दुरुस्त प्रतिरूप हुनुहुन्छ, र उहाँले आफ्नो शक्तिशाली वचनद्वारा सबै थोकहरू सम्हाल्नुहुन्छ। उहाँले पापहरूका लागि शुद्धीकरणको प्रबन्ध मिलाउनुभयो, र उहाँ स्वर्गमा महामहिमको दाहिने हातपट्टि विराजमान हुनुभयो।<verse eid="HEB 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 1:4"/>यसकारण उहाँ स्वर्गदूतभन्दा उच्‍च हुनुभएको छ; अनि तिनीहरूभन्दा उहाँले उच्‍च नाम उत्तराधिकारस्वरूप पाउनुभएको छ।<verse eid="HEB 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 1:5"/>स्वर्गदूतहरूमध्ये कसलाई चाहिँ परमेश्‍वरले कहिल्यै यसो भन्‍नुभयो: “तिमी मेरा पुत्र हौ, आज म तिम्रो पिता भएको छु?” अथवा फेरि, “म तिनका पिता हुनेछु, र तिनी मेरा पुत्र हुनेछन्?”<verse eid="HEB 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 1:6"/>परमेश्‍वरले आफ्ना प्रथम जन्मेकालाई संसारमा फेरि ल्याउनुहुँदा उहाँ भन्‍नुहुन्छ, “परमेश्‍वरका सारा स्वर्गदूतहरूले उहाँको आराधना गरून्।”<verse eid="HEB 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 1:7"/>स्वर्गदूतहरूका विषयमा उहाँ भन्‍नुहुन्छ, “उहाँले आफ्ना स्वर्गदूतहरूलाई बतास, र आफ्ना सेवकहरूलाई आगोको ज्वाला बनाउनुहुन्छ।”<verse eid="HEB 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 1:8"/>तर पुत्रको विषयमा उहाँ भन्‍नुहुन्छ, “हे परमेश्‍वर, तपाईंको सिंहासन सदाको निम्ति रहनेछ; तपाईंको राज्यको राजदण्ड न्यायको राजदण्ड हुनेछ।<verse eid="HEB 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 1:9"/>तपाईंले धार्मिकतालाई प्रेम र दुष्‍टतालाई घृणा गर्नुभयो; यसकारण परमेश्‍वर, तपाईंका परमेश्‍वरले तपाईंलाई तपाईंका सङ्गीहरूभन्दा उच्‍च पार्नुभएको छ र हर्षको तेलले अभिषेक गर्नुभएको छ।”<verse eid="HEB 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 1:10"/>उहाँ यसो पनि भन्‍नुहुन्छ, “हे प्रभु, सुरुमा तपाईंले पृथ्वीको जग बसाल्नुभयो, र स्वर्ग तपाईंकै हातका काम हुन्।<verse eid="HEB 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 1:11"/>तिनीहरू नाश भएर जानेछन्, तर तपाईंचाहिँ रहिरहनुहुन्छ; तिनीहरू कपडाझैँ सबै फाटेर जानेछन्।<verse eid="HEB 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 1:12"/>तपाईंले तिनीहरूलाई वस्त्रलाईझैँ लपेट्नुहुनेछ, वस्त्रझैँ ती बदली हुनेछन्। तर तपाईं एकैनास रहनुहुन्छ, र तपाईंका वर्षहरूको अन्त्य कहिल्यै हुनेछैन।”<verse eid="HEB 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 1:13"/>स्वर्गदूतहरूमध्ये कसलाई चाहिँ परमेश्‍वरले कुनै समयमा यसो भन्‍नुभयो, “जबसम्म म तिम्रा शत्रुहरूलाई तिम्रा खुट्टाको पाउदान बनाउँदिनँ, तबसम्म तिमी मेरो दाहिने हातपट्टि बस!”<verse eid="HEB 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 1:14"/>तसर्थ के सबै स्वर्गदूतहरू मुक्ति पाउनेहरूलाई सेवा गर्न पठाइएका सेवा गर्ने आत्माहरू होइनन् र?<verse eid="HEB 1:14"/></para>
<chapter eid="HEB 1"/>
<chapter number="2" style="c" sid="HEB 2"/>
<para style="p"><verse number="1" style="v" sid="HEB 2:1"/>यसकारण हामीले जे सुनेका छौँ, त्यसमा विशेष ध्यान दिनुपर्छ, नत्रता हामी त्यसबाट तर्किजानेछौँ।<verse eid="HEB 2:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 2:2"/>किनकि स्वर्गदूतहरूद्वारा बोलिएका सन्देश पक्‍का थियो; अनि यसलाई उल्‍लङ्घन गर्ने र अनाज्ञाकारी रहने सबैले परमेश्‍वरबाट उचित दण्ड पाए भने,<verse eid="HEB 2:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 2:3"/>हामीले त झन् यति महान् मुक्तिको वास्ता राखेनौँ भने हामी कसरी उम्कौँला त? यो त्यही मुक्ति थियो, जसलाई पहिले प्रभुले घोषणा गर्नुभयो र उहाँलाई सुन्‍नेहरूले हाम्रा निम्ति यसको पुष्‍टि गरिदिए।<verse eid="HEB 2:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 2:4"/>परमेश्‍वरले पनि अलौकिक चिन्हहरू, अद्‌भुत कार्यहरू, अनेकौँ अचम्मका कामहरू र उहाँको इच्छाद्वारा बाँडिएका पवित्र आत्माका वरदानहरूद्वारा त्यसलाई पक्‍का गर्नुभयो।<verse eid="HEB 2:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 2:5"/>हामीले जुन आउने संसारको विषयमा कुरा गर्दैछौँ, त्यसलाई स्वर्गदूतहरूको अधीनमा राखिएन।<verse eid="HEB 2:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 2:6"/>तर कसैले धर्मशास्त्रको कुनै एक ठाउँमा यसो भन्‍ने साक्षी दिएका छन्: “मानिस जाति के हो, र तपाईं त्यसको वास्ता गर्नुहुन्छ? अथवा मानिसको पुत्र के हो, र तपाईंले उसको फिक्री गर्नुहुन्छ?<verse eid="HEB 2:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 2:7"/>तपाईंले तिनीहरूलाई स्वर्गदूतहरूभन्दा केही कम बनाउनुभयो; तपाईंले तिनीहरूलाई महिमा र आदरको मुकुट पहिर्‍याउनुभयो;<verse eid="HEB 2:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 2:8"/>सबै कुरा उहाँको पाउमुनि राखिदिनुभयो।” मानिसको अधीनमा सबै थोक राख्नुहुँदा उहाँको अधीनबाहिर केही रहन दिनुभएन; तर यस वर्तमान समयमा सबै थोक उहाँको अधीनमा भएको हामी देख्दैनौँ।<verse eid="HEB 2:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 2:9"/>तर हामी येशूलाई देख्छौँ, जसलाई स्वर्गदूतहरूभन्दा केही कम दर्जाको तुल्याइएको थियो, मृत्यु सहनुभएकोले उहाँलाई महिमा र आदरको मुकुट पहिराइएको छ; ताकि परमेश्‍वरको अनुग्रहद्वारा उहाँले हरेकको निम्ति मृत्यु चाखून्।<verse eid="HEB 2:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 2:10"/>परमेश्‍वर, जसका निम्ति र जसद्वारा सबै कुरा अस्तित्वमा छन्, उहाँले नै धेरै सन्तानलाई महिमामा ल्याउनुहुँदा तिनीहरूका मुक्ति दिने येशूलाई कष्‍टहरूद्वारा सिद्ध तुल्याउन उचित लाग्यो।<verse eid="HEB 2:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 2:11"/>मानिसहरूलाई पवित्र तुल्याउनुहुने येशू र पवित्र तुल्याइएकाहरू दुवै एउटै परिवारबाटका हुन्। यसकारण येशूले तिनीहरूलाई दाजुभाइ-दिदीबहिनीहरू भन्‍न शर्माउनुभएन।<verse eid="HEB 2:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 2:12"/>उहाँ भन्‍नुहुन्छ; “मेरा दाजुभाइ-दिदीबहिनीहरूलाई म तपाईंको नाम घोषणा गर्नेछु; सभाको उपस्थितिमा म तपाईंको प्रशंसा गाउनेछु।”<verse eid="HEB 2:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 2:13"/>अनि फेरि, “उहाँमाथि म आफ्नो भरोसा राख्नेछु।” र उहाँ फेरि भन्‍नुहुन्छ, “हेर, म र परमेश्‍वरले मलाई दिनुभएका यी छोराछोरीहरू।”<verse eid="HEB 2:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 2:14"/>छोराछोरीहरूका मासु र रगत भएको हुनाले उहाँले पनि तिनीहरूको जस्तै मानव रूप लिनुभयो, ताकि आफ्नो मृत्युद्वारा त्यो शैतानलाई, जससँग मृत्युको अधिकार छ, नष्‍ट पार्न सक्नुभएको होस्;<verse eid="HEB 2:14"/></para>
<para style="p"><verse number="15" style="v" sid="HEB 2:15"/>अनि जीवनभरि मृत्युको डर बोकेर दासत्वको बन्धनमा रहनेहरूलाई मुक्त गरियोस्।<verse eid="HEB 2:15"/></para>
<para style="p"><verse number="16" style="v" sid="HEB 2:16"/>किनकि उहाँले अवश्य नै स्वर्गदूतहरूलाई होइन, तर अब्राहामका वंशलाई सहायता दिनुहुन्छ।<verse eid="HEB 2:16"/></para>
<para style="p"><verse number="17" style="v" sid="HEB 2:17"/>यसैकारण उहाँलाई हरकिसिमले आफ्ना भाइहरूझैँ हुनुपर्नेथियो; ताकि उहाँ परमेश्‍वरको सेवामा दयालु र विश्‍वासयोग्य प्रधान पुजारी बनून्; यसरी येशू मानिसहरूका पाप क्षमाको बलिदान हुनुभएको होस्।<verse eid="HEB 2:17"/></para>
<para style="p"><verse number="18" style="v" sid="HEB 2:18"/>किनभने उहाँ आफू परीक्षित हुनुहुँदा कष्‍ट भोग्नुभएकोले परीक्षामा पर्नेहरूलाई उहाँले सहायता गर्न सक्नुहुन्छ।<verse eid="HEB 2:18"/></para>
<chapter eid="HEB 2"/>
<chapter number="3" style="c" sid="HEB 3"/>
<para style="p"><verse number="1" style="v" sid="HEB 3:1"/>यसकारण हे स्वर्गीय बोलावटका सहभागी, प्रिय दाजुभाइ-दिदीबहिनीहरू हो, हामीले प्रेरित र प्रधान पुजारीको रूपमा स्वीकार गरेका हाम्रा येशूमा आफ्ना विचारहरू दृढतापूर्वक राखिदेओ।<verse eid="HEB 3:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 3:2"/>जसरी मोशा परमेश्‍वरको घरमा विश्‍वासयोग्य थिए, त्यसरी नै येशू पनि आफूलाई नियुक्त गर्नुहुने परमेश्‍वरप्रति विश्‍वासयोग्य हुनुहुन्थ्यो।<verse eid="HEB 3:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 3:3"/>घरको भन्दा घर बनाउनेको आदर बढी भएझैँ, येशू पनि मोशाभन्दा बढी आदरको योग्य ठहरिनुभएको छ।<verse eid="HEB 3:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 3:4"/>किनकि प्रत्येक घर कसैले बनाएको हुन्छ; तर परमेश्‍वर नै हरेक थोकका निर्माता हुनुहुन्छ।<verse eid="HEB 3:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 3:5"/>अनि भविष्यमा परमेश्‍वरले के भन्‍नुहुनेछ भनेर साक्षी दिँदै, “परमेश्‍वरको सम्पूर्ण परिवारमा मोशा सेवकझैँ विश्‍वासयोग्य थिए।”<verse eid="HEB 3:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 3:6"/>तर परमेश्‍वरको सम्पूर्ण परिवारमा ख्रीष्‍टचाहिँ पुत्रको रूपमा विश्‍वासयोग्य हुनुहुन्छ। अनि साहसमा र हामीले गर्व गरेको आशामा अडिरह्‍यौँ भने हामी उहाँका परिवार हौँ।<verse eid="HEB 3:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 3:7"/>यसकारण जसरी पवित्र आत्मा भन्‍नुहुन्छ: “आज तिमीहरूले उहाँको सोर सुन्यौ भने,<verse eid="HEB 3:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 3:8"/>उजाडस्थानमा परीक्षाको समयमा तिमीहरू बागी भएझैँ, आफ्ना हृदयलाई कठोर नपार,<verse eid="HEB 3:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 3:9"/>जहाँ चालीस वर्षसम्म मैले गरेका कामहरू देखेर पनि तिमीहरूका पुर्खाहरूले मलाई जाँच र परीक्षा गरेका थिए।<verse eid="HEB 3:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 3:10"/>त्यसैकारण म त्यस पुस्तासँग रिसाएको थिएँ; अनि मैले भनेँ, ‘तिनीहरूका हृदय सधैँ बरालिन्छन्, र तिनीहरूले मेरा मार्गहरू जानेका छैनन्।’<verse eid="HEB 3:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 3:11"/>यसकारण मैले आफ्नो क्रोधमा शपथ खाएर घोषणा गरेँ, ‘तिनीहरू कहिल्यै पनि मेरो विश्राममा पस्‍नेछैनन्।’ ”<verse eid="HEB 3:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 3:12"/>यसकारण हे दाजुभाइ-दिदीबहिनीहरू हो, यसमा विचार गर, कि तिमीहरूसँग जीवित परमेश्‍वरदेखि टाढा रहने पापपूर्ण र अविश्‍वासी हृदय नहोस्।<verse eid="HEB 3:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 3:13"/>तर “आजको दिन” रहँदा नै एक-अर्कालाई दिनहुँ ढाडस देओ, ताकि तिमीहरूमध्ये कोही पनि पापको छलद्वारा कठोर नबनोस्।<verse eid="HEB 3:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 3:14"/>हामीसँग भएको आत्मविश्‍वासलाई दृढतापूर्वक अन्त्यसम्मै पक्रिराख्यौँ भने हामी ख्रीष्‍टका सहभागी भएका छौँ।<verse eid="HEB 3:14"/></para>
<para style="p"><verse number="15" style="v" sid="HEB 3:15"/>जसरी धर्मशास्त्रमा लेखिएको छ: “आज तिमीहरूले उहाँको सोर सुन्यौँ भने, तिमीहरू बागी हुँदा गरेझैँ आफ्ना हृदयलाई कठोर नबनाओ।”<verse eid="HEB 3:15"/></para>
<para style="p"><verse number="16" style="v" sid="HEB 3:16"/>सुनेर बागी हुने तिनीहरू को थिए? के तिनीहरू नै होइनन्, जसलाई मोशाले इजिप्टबाट डोर्‍याएर निकालेका थिए?<verse eid="HEB 3:16"/></para>
<para style="p"><verse number="17" style="v" sid="HEB 3:17"/>अनि उहाँ कोसँग चालीस वर्षसम्म रिसाउनुभएको थियो? के तिनीहरूसितै होइन र, जसले पाप गरे, र जसका शरीरहरू मरुभूमिमा नष्‍ट भए?<verse eid="HEB 3:17"/></para>
<para style="p"><verse number="18" style="v" sid="HEB 3:18"/>अनि परमेश्‍वरले उहाँको विश्राममा प्रवेश गर्नेछैनौ भनी कोसँग शपथ खानुभएको थियो, तिनीहरूसँग नै होइन र, जो अनाज्ञाकारी बने?<verse eid="HEB 3:18"/></para>
<para style="p"><verse number="19" style="v" sid="HEB 3:19"/>यसरी हामी देख्दछौँ, कि तिनीहरूका अविश्‍वासको कारणले तिनीहरू विश्राममा प्रवेश गर्न सकेनन्।<verse eid="HEB 3:19"/></para>
<chapter eid="HEB 3"/>
<chapter number="4" style="c" sid="HEB 4"/>
<para style="p"><verse number="1" style="v" sid="HEB 4:1"/>यसकारण परमेश्‍वरको विश्राममा पस्‍न पाउने प्रतिज्ञा अझै पनि रहेकोले तिमीहरूमध्ये कोही पनि वञ्चित हुन नपरोस् भनी हामी होसियार रहौँ।<verse eid="HEB 4:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 4:2"/>किनकि तिनीहरूलाई झैँ हामीलाई पनि सुसमाचार प्रचार गरिएको हो, तर तिनीहरूले सुनेको सन्देश तिनीहरूलाई लाभदायक भएन; किनभने तिनीहरूले आज्ञापालन गर्नेहरूको जस्तो विश्‍वास गरेनन्।<verse eid="HEB 4:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 4:3"/>तर हामी जतिले विश्‍वास गरेका छौँ, त्यस विश्राममा प्रवेश गरेका छौँ, जसरी परमेश्‍वरले भन्‍नुभएको छ: “यसैले मैले आफ्नो क्रोधमा शपथ खाएर घोषणा गरेँ, ‘तिनीहरू कहिल्यै मेरो विश्राममा पस्‍नेछैनन्।’ ” किनकि उहाँका कामहरू त संसारको उत्पत्तिदेखि नै पूरा भइसकेका थिए।<verse eid="HEB 4:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 4:4"/>तथापि धर्मशास्त्रमा परमेश्‍वरले सातौँ दिनको विषयमा यसरी वर्णन गर्नुभएको छ: “अनि सातौँ दिनमा उहाँले आफ्ना सबै कामबाट विश्राम लिनुभयो।”<verse eid="HEB 4:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 4:5"/>फेरि यसै खण्डमा उहाँ भन्‍नुहुन्छ, “तिनीहरू कहिल्यै पनि मेरो विश्राममा पस्‍नेछैनन्।”<verse eid="HEB 4:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 4:6"/>यसकारण कतिपय त्यस विश्राममा प्रवेश गर्न बाँकी नै छ, जसलाई पहिले सुसमाचार प्रचार गरिएको थियो, तिनीहरू प्रवेश गर्न पाएनन्; किनकि तिनीहरू अनाज्ञाकारी थिए।<verse eid="HEB 4:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 4:7"/>यसकारण फेरि परमेश्‍वरले कुनै एउटा दिनलाई “आज” भनेर छुट्याउनुभयो, जब धेरै समयपछि उहाँले अगि भनिएकोझैँ दावीदद्वारा फेरि भन्‍नुभयो: “आज तिमीहरूले उहाँको सोर सुन्यौ भने, आफ्ना हृदयलाई कठोर नबनाओ।”<verse eid="HEB 4:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 4:8"/>किनकि यदि यहोशूले तिनीहरूलाई विश्राम दिएका भए, परमेश्‍वरले पछिबाट अर्को दिनको विषयमा भन्‍नुहुने थिएन।<verse eid="HEB 4:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 4:9"/>यसकारण परमेश्‍वरका जनहरूका निम्ति शब्बाथको विश्राम बाँकी नै छ;<verse eid="HEB 4:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 4:10"/>किनकि जसले परमेश्‍वरको विश्राममा प्रवेश गर्नेछन्, परमेश्‍वरले आफ्ना कामबाट विश्राम गरेझैँ तिनले पनि आफ्ना कामबाट विश्राम लिनेछन्।<verse eid="HEB 4:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 4:11"/>यसकारण इस्राएलीहरूका अनाज्ञाकारिताको नमुना अपनाएर कोही पनि नष्‍ट हुन नपरोस् भनेर हामी त्यस विश्राममा प्रवेश गर्न भरमग्दूर प्रयत्न गरौँ।<verse eid="HEB 4:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 4:12"/>किनकि परमेश्‍वरको वचन जीवित, क्रियाशील र कुनै पनि दुईधारे तरवारभन्दा धारिलो हुन्छ, जसले प्राण र आत्मालाई अनि जोर्नी-जोर्नी र हाडको मासीलाई समेत भाग-भाग गरेर वारपार छेडिदिन्छ, र हृदयका विचार र मनोवृत्तिको न्याय गर्छ।<verse eid="HEB 4:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 4:13"/>सारा सृष्‍टिमा भएको कुनै पनि थोक परमेश्‍वरको सृष्‍टिबाट लुकेको छैन। हामीले आफ्नो हिसाब बुझाउनु पर्नेका आँखामा सबै थोकहरू खुला र उदाङ्गो हुन्छन्।<verse eid="HEB 4:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 4:14"/>यसकारण आकाश छिचोलेर जानुहुने परमेश्‍वरको पुत्र येशू, महान् प्रधान पुजारी, हामीसँग हुनुभएकोले हामीले स्वीकार गरेको विश्‍वासलाई दृढतापूर्वक थामिराखौँ।<verse eid="HEB 4:14"/></para>
<para style="p"><verse number="15" style="v" sid="HEB 4:15"/>किनकि हामीसँग हाम्रा दुर्बलताहरूमा सान्त्वना दिन नसक्ने प्रधान पुजारी होइन, तर हामीसँग यस्ता प्रधान पुजारी हुनुहुन्छ, जो हामीझैँ हरेक प्रकारले परीक्षित हुनुभएर पनि पापरहित हुनुहुन्छ।<verse eid="HEB 4:15"/></para>
<para style="p"><verse number="16" style="v" sid="HEB 4:16"/>यसकारण हामी आत्मविश्‍वासका साथ अनुग्रहको सिंहासनको नजिक जाऔँ, ताकि हाम्रा खाँचोहरूका समयमा हामीलाई दया र अनुग्रह प्राप्‍त होस्।<verse eid="HEB 4:16"/></para>
<chapter eid="HEB 4"/>
<chapter number="5" style="c" sid="HEB 5"/>
<para style="p"><verse number="1" style="v" sid="HEB 5:1"/>हरेक प्रधान पुजारी पापको लागि भेटीहरू र बलिदानहरू चढाउनलाई मानिसहरूमध्येबाट नै छानिएका हुन्छन्, र परमेश्‍वर सम्बन्धी कुराहरूमा मानिसहरूको प्रतिनिधित्व गर्न नियुक्त भएका हुन्छन्।<verse eid="HEB 5:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 5:2"/>तिनी आफैँ पनि दुर्बलताको अधीनमा भएको हुनाले तिनले अनजान र बरालिएकाहरूसँग नम्रतापूर्वक व्यवहार गर्न सक्छन्।<verse eid="HEB 5:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 5:3"/>यसैकारण तिनले आफ्नै पापको लागि र मानिसहरूको पापको लागि बलिदानहरू चढाउनुपर्छ।<verse eid="HEB 5:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 5:4"/>अनि कसैले यो सम्मान आफैँ लिन सक्दैन, तर तिनलाई पनि हारूनलाई झैँ परमेश्‍वरको बोलावट भएपछि प्राप्‍त हुन्छ।<verse eid="HEB 5:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 5:5"/>यसरी ख्रीष्‍टले पनि प्रधान पुजारी हुने महिमा आफैँले लिनुभएन, तर परमेश्‍वरले ख्रीष्‍टलाई भन्‍नुभयो: “तिमी मेरा पुत्र हौ, आज म तिम्रो पिता भएको छु।”<verse eid="HEB 5:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 5:6"/>अनि अर्को ठाउँमा पनि उहाँ भन्‍नुहुन्छ, “मल्कीसेदेकको दर्जाबमोजिम तिमी सदासर्वदाको लागि पुजारी हौ।”<verse eid="HEB 5:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 5:7"/>येशू यस संसारमा रहनुभएका दिनहरूमा, मृत्युदेखि बचाउन सक्नुहुनेलाई उहाँले जोडले कराएर आँसुसहित प्रार्थना र अन्तर्बिन्ती चढाउनुभयो; अनि उहाँको भक्तिपूर्ण समर्पणको कारण त्यो सुनुवाइ भयो।<verse eid="HEB 5:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 5:8"/>उहाँ परमेश्‍वरका पुत्र हुनुभए तापनि उहाँले कष्‍ट सहनुभएर आज्ञाकारिता सिक्नुभयो।<verse eid="HEB 5:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 5:9"/>एक पल्ट सिद्ध हुनुभएपछि उहाँका आज्ञा मान्‍नेहरू सबैको लागि अनन्त मुक्तिको स्रोत हुनुभयो;<verse eid="HEB 5:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 5:10"/>अनि मल्कीसेदेकको दर्जाबमोजिम प्रधान पुजारी नियुक्त हुनुभयो।<verse eid="HEB 5:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 5:11"/>हामीलाई यस विषयमा भन्‍नुपर्ने कुराहरू धेरै नै छन्, तर यसलाई स्पष्‍टसँग बुझाउनु कठिन छ; किनकि तिमीहरू सिक्ने कुरामा ढिला छौ।<verse eid="HEB 5:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 5:12"/>वास्तवमा अहिलेसम्म त तिमीहरू शिक्षकहरू भइसक्नुपर्ने थियो, तर तिमीहरूलाई त कसैले परमेश्‍वरको वचनका सुरुका शिक्षाहरू फेरि दोहोर्‍याएर सिकाउन खाँचो परेको छ। तिमीहरूलाई खँदिलो भोजन होइन, तर दूधै चाहिन्छ!<verse eid="HEB 5:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 5:13"/>दूध मात्र पिएर बाँच्ने हरेक मानिस बालकझैँ हुने भएको हुनाले धार्मिकताको विषयको शिक्षामा अनभिज्ञ हुन्छ।<verse eid="HEB 5:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 5:14"/>तर खँदिलो भोजनचाहिँ हुर्किएकाहरूका लागि हो, जसले निरन्तर अभ्यासद्वारा असल र खराब चिन्‍न सक्ने तालिम पाइसकेका हुन्छन्।<verse eid="HEB 5:14"/></para>
<chapter eid="HEB 5"/>
<chapter number="6" style="c" sid="HEB 6"/>
<para style="p"><verse number="1" style="v" sid="HEB 6:1"/>यसकारण ख्रीष्‍टसम्बन्धी सुरुका शिक्षाहरू त्यागेर परिपक्वतातर्फ बढौँ। मृत्युतिर लैजाने कर्महरूबाट पश्‍चात्ताप, परमेश्‍वरमाथिको विश्‍वास, बप्‍तिस्माको विषयमा निर्देशन, हात राख्ने कामहरू, मरेकाहरूको पुनरुत्थान र अनन्त न्यायका कुरा यी सुरुका शिक्षाहरूको जग फेरि नबसालौँ।<verse eid="HEB 6:1"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 6:3"/>परमेश्‍वरले अनुमति दिनुभयो भने हामी यसो गर्नेछौँ।<verse eid="HEB 6:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 6:4"/>जसले एक पल्ट स्पष्‍टसँग सत्य जानेर स्वर्गीय वरदान चाखे, पवित्र आत्मामा सहभागी भए;<verse eid="HEB 6:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 6:5"/>अनि जसले परमेश्‍वरको वचनको भलाइ र आउँदो युगको शक्तिको स्वाद चाखे,<verse eid="HEB 6:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 6:6"/>र पनि तिनीहरू पतित भए भने तिनीहरूलाई पश्‍चात्तापमा फिर्ता ल्याउन असम्भव हुन्छ; तिनीहरूले आफ्ना कामहरूद्वारा परमेश्‍वरको पुत्रलाई पुनः क्रूसमा टाँगेर खुल्‍लमखुल्‍ला उहाँको अपमान गर्छन्।<verse eid="HEB 6:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 6:7"/>जुन जमिनले आफूमा बर्सिएको पानी सोसेर खनजोत गर्नेहरूका लागि उपयोगी अन्‍न उमार्छ, त्यसले परमेश्‍वरको आशिष् पाउँछ।<verse eid="HEB 6:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 6:8"/>तर जुन जमिनले सिउँडी र काँडाहरू उमार्छ, त्यो विनाकामको भई श्राप पाउने जोखिममा रहन्छ, र अन्त्यमा त्यसलाई जलाइन्छ।<verse eid="HEB 6:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 6:9"/>प्रिय मित्रहरू, हामीले यसरी बोले तापनि हामी तिमीहरूको विषयमा चाहिँ असल कुराहरूबारे निश्‍चित छौँ—ती कुराहरू, जो मुक्तिसँग सम्बन्धित छन्।<verse eid="HEB 6:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 6:10"/>परमेश्‍वर अन्यायी हुनुहुन्‍न, तिमीहरूले परमेश्‍वरका जनहरूलाई सहायता गर्‍यौ र अझ गरिरहेर उहाँप्रति तिमीहरूको प्रेम देखाएकाले परमेश्‍वरले तिमीहरूका काम बिर्सनुहुनेछैन।<verse eid="HEB 6:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 6:11"/>हामी चाहन्छौँ, तिमीहरूको आशा पक्‍का गर्नको लागि तिमीहरू हरेकले अन्त्यसम्म त्यस्तै परिश्रम देखाइरहो।<verse eid="HEB 6:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 6:12"/>हामी तिमीहरू अल्छे भएका चाहँदैनौँ, तर तिनीहरूको देखासिकी गर्ने होओ, जसले विश्‍वास र धीरजद्वारा प्रतिज्ञा गरिएका थोकहरूको अधिकार पाए।<verse eid="HEB 6:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 6:13"/>जब परमेश्‍वरले अब्राहामसँग प्रतिज्ञा गर्नुभयो, तब शपथ खानलाई अरू कुनै ठूलो नाम नभएकोले उहाँले आफ्नै नाममा शपथ खाएर यसो भन्‍नुभयो,<verse eid="HEB 6:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 6:14"/>“म निश्‍चय तँलाई आशिष् दिएर धेरै सन्तान दिनेछु।”<verse eid="HEB 6:14"/></para>
<para style="p"><verse number="15" style="v" sid="HEB 6:15"/>अनि यसरी धैर्यसाथ प्रतीक्षा गरेपश्‍चात् अब्राहामले प्रतिज्ञा गरिएको थोक प्राप्‍त गरे।<verse eid="HEB 6:15"/></para>
<para style="p"><verse number="16" style="v" sid="HEB 6:16"/>मानिसहरूले आफूभन्दा ठूलाहरूको नाममा शपथ खान्छन्; अनि भनिएको कुरा पक्‍का हुन्छ र त्यहाँ कुनै तर्क गरिँदैन।<verse eid="HEB 6:16"/></para>
<para style="p"><verse number="17" style="v" sid="HEB 6:17"/>किनकि परमेश्‍वरले प्रतिज्ञाका हकदारहरूसित उहाँको बदली नहुने उद्देश्य स्पष्‍ट गर्न चाहनुभएकोले उहाँले यसलाई शपथद्वारा नै पक्‍का गर्नुभयो।<verse eid="HEB 6:17"/></para>
<para style="p"><verse number="18" style="v" sid="HEB 6:18"/>परमेश्‍वरले दिनुभएका यी दुई कुरा उहाँको प्रतिज्ञा र शपथ, जुन बदली हुन सक्दैन; किनकि परमेश्‍वरलाई झूट बोल्नु असम्भव छ। परमेश्‍वरले यसो गर्नुभयो, ताकि हामीलाई हाम्रो सामु राखिएको आशालाई दह्रो गरी पक्रिराख्न धेरै उत्साह मिलोस्।<verse eid="HEB 6:18"/></para>
<para style="p"><verse number="19" style="v" sid="HEB 6:19"/>यो आशा हाम्रो प्राणको लागि एउटा दृढ र सुरक्षित लङ्गरजस्तै हो, जुन आशा पर्दाभित्रको पवित्रस्थानमा प्रवेश गर्दछ,<verse eid="HEB 6:19"/></para>
<para style="p"><verse number="20" style="v" sid="HEB 6:20"/>जसमा हामीभन्दा पहिले येशू हाम्रा पक्षबाट प्रवेश गर्नुभएको छ; किनभने उहाँ मल्कीसेदेकको दर्जाबमोजिम सदासर्वदाको लागि प्रधान पुजारी हुनुभएको छ।<verse eid="HEB 6:20"/></para>
<chapter eid="HEB 6"/>
<chapter number="7" style="c" sid="HEB 7"/>
<para style="p"><verse number="1" style="v" sid="HEB 7:1"/>यिनै मल्कीसेदेक, शालेमका राजा र सर्वोच्‍च परमेश्‍वरका पुजारी थिए। तिनले राजाहरूलाई जितेर फर्किरहेका अब्राहामलाई भेटेर आशिष् दिए;<verse eid="HEB 7:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 7:2"/>अनि अब्राहामले तिनलाई हरेक कुराको दशांश दिए। मल्कीसेदेकको नामको अर्थ “धार्मिकताका राजा” र त्यसपछि, “शालेमका राजा” अर्थात् “शान्तिका राजा” हो।<verse eid="HEB 7:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 7:3"/>तिनी आमाबुबाविना, वंशावलीविना, जीवनको सुरु र अन्त्यविना नै परमेश्‍वरका पुत्रसमान सदाकाल पुजारी भइरहनेछन्।<verse eid="HEB 7:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 7:4"/>विचार मात्र गर, तिनी कति महान् थिए: कुलपिता अब्राहाम समेतले तिनलाई युद्धमा जितेका मालबाट दशांश दिए!<verse eid="HEB 7:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 7:5"/>अब लेवी वंशबाट भएका पुजारीहरूले मात्र मानिसहरूबाट अथवा तिनीहरूका सङ्गी इस्राएलीहरूबाट दशांश उठाउन सक्छन् भनी व्यवस्थाले अनुमति दिन्छ। यद्यपि तिनीहरू पनि अब्राहामकै सन्तानहरू हुन्;<verse eid="HEB 7:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 7:6"/>यी मल्कीसेदेकचाहिँ लेवीको कुलबाट आएका होइनन्, तर पनि अब्राहामबाट दशांश लिए, र प्रतिज्ञा पाउनेलाई आशिष् दिए।<verse eid="HEB 7:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 7:7"/>अनि सानो व्यक्तिले ठूलो व्यक्तिबाट आशिष् पाउँछन् भन्‍ने कुरामा कुनै शङ्का छैन।<verse eid="HEB 7:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 7:8"/>एकातिर, दशांश मरेर जानेहरूले लिन्छन्; तर अर्कोतिर, दशांश तिनले लिन्छन्, जसलाई सदासर्वदा जीवित घोषणा गरिन्छ।<verse eid="HEB 7:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 7:9"/>कसैले यसो पनि भन्‍न सक्छ, दशांश लिने लेवीले कुलपिता अब्राहामद्वारा दशांश दिए।<verse eid="HEB 7:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 7:10"/>किनकि मल्कीसेदेकले अब्राहामलाई भेट्दा लेवीचाहिँ आफ्नो पुर्खाको शरीरभित्रै थिए।<verse eid="HEB 7:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 7:11"/>परमेश्‍वरले इस्राएलीहरूलाई दिइएको व्यवस्थाको आधारमा यदि लेवीहरूको पुजारीपनद्वारा सिद्धता प्राप्‍त हुनसक्ने भए किन हारूनको दर्जाबमोजिम नभई, तर मल्कीसेदेकको दर्जाबमोजिम पुजारी आउने आवश्यकता पर्‍यो?<verse eid="HEB 7:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 7:12"/>किनकि पुजारीपन बदली हुँदा व्यवस्था पनि बदली हुनुपर्छ।<verse eid="HEB 7:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 7:13"/>जसको लागि यी कुराहरू भनिए, उहाँ त बेग्लै कुलको हुनुहुन्थ्यो, र त्यस कुलबाट कसैले कहिल्यै पुजारी भएर वेदीको सेवा गरेन।<verse eid="HEB 7:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 7:14"/>किनकि यो स्पष्‍ट छ, हाम्रा प्रभु यहूदाको कुलबाट आउनुभयो, जुन कुलको विषयमा मोशाले पुजारी हुने कुरा गरेकै छैनन्।<verse eid="HEB 7:14"/></para>
<para style="p"><verse number="15" style="v" sid="HEB 7:15"/>यदि मल्कीसेदेकझैँ अर्को पुजारी उठ्ने हो भनेता हामीले जे भन्यौँ, त्यो अझ स्पष्‍ट हुन्छ;<verse eid="HEB 7:15"/></para>
<para style="p"><verse number="16" style="v" sid="HEB 7:16"/>उहाँ, जो पुर्ख्यौलीको नियमको आधारमा होइन, तर एउटा अविनाशी जीवनको शक्तिको आधारमा पुजारी हुनुभयो।<verse eid="HEB 7:16"/></para>
<para style="p"><verse number="17" style="v" sid="HEB 7:17"/>किनकि धर्मशास्त्रमा उहाँको बारेमा यो घोषणा भएको छ: “मल्कीसेदेकको दर्जाबमोजिम तिमी सदासर्वदाको लागि पुजारी हौ।”<verse eid="HEB 7:17"/></para>
<para style="p"><verse number="18" style="v" sid="HEB 7:18"/>अगिल्‍लो नियम कमजोर र काम नलाग्ने भएकोले खारेज गरियो;<verse eid="HEB 7:18"/></para>
<para style="p"><verse number="19" style="v" sid="HEB 7:19"/>जसको साटो अझ उत्तम आशा उपस्थित गराइयो, जसद्वारा हामी परमेश्‍वरको नजिक जान्छौँ; किनकि व्यवस्थाले कुनै थोकलाई सिद्ध तुल्याएन।<verse eid="HEB 7:19"/></para>
<para style="p"><verse number="20" style="v" sid="HEB 7:20"/>अनि यो शपथविना भएन। अरूचाहिँ शपथविना नै पुजारी भए;<verse eid="HEB 7:20"/></para>
<para style="p"><verse number="21" style="v" sid="HEB 7:21"/>तर उहाँचाहिँ शपथसहित पुजारी हुनुभयो, जब परमेश्‍वरले उहाँलाई भन्‍नुभयो: “परमप्रभुले शपथ खानुभएको छ; अनि आफ्नो मन बदल्नुहुनेछैन: ‘तिमी सदासर्वदाको लागि पुजारी हौ।’ ”<verse eid="HEB 7:21"/></para>
<para style="p"><verse number="22" style="v" sid="HEB 7:22"/>यस शपथको कारण येशू करारको अझ उत्तम जमानी हुनुभयो।<verse eid="HEB 7:22"/></para>
<para style="p"><verse number="23" style="v" sid="HEB 7:23"/>संख्यामा अरू धेरै पुजारीहरू थिए, तर मृत्युको कारणले तिनीहरूलाई निरन्तर पुजारीको काम गरिरहन दिएन।<verse eid="HEB 7:23"/></para>
<para style="p"><verse number="24" style="v" sid="HEB 7:24"/>तर येशूचाहिँ सधैँ बाँचिरहनुहुने हुनाले उहाँको पुजारीपन अनन्तको लागि नै छ।<verse eid="HEB 7:24"/></para>
<para style="p"><verse number="25" style="v" sid="HEB 7:25"/>यसकारण जति जना उहाँद्वारा परमेश्‍वरमा आउँछन्, तिनीहरूलाई सदासर्वदा पूर्णतया बचाउन सक्नुहुन्छ; किनकि तिनीहरूको मध्यस्थता गर्न उहाँ सधैँ जिउनुहुन्छ।<verse eid="HEB 7:25"/></para>
<para style="p"><verse number="26" style="v" sid="HEB 7:26"/>यस्ता प्रधान पुजारीले नै हाम्रा खाँचोहरू पूरा गर्नुहुन्छ। जो पवित्र, दोषरहित, शुद्ध, पापीहरूबाट अलग गरिएका स्वर्गहरूभन्दा माथि उच्‍च पारिनुभएको छ।<verse eid="HEB 7:26"/></para>
<para style="p"><verse number="27" style="v" sid="HEB 7:27"/>अरू प्रधान पुजारीहरूलाई जस्तो पहिले आफ्नै पापहरूको लागि, र मानिसहरूका पापहरूको लागि दिनहुँ बलिदान चढाइरहने आवश्यकता उहाँलाई पर्दैन। उहाँले आफूलाई अर्पण गरेर एकै पल्ट सदाको लागि तिनीहरूका पापको बलिदान दिनुभयो।<verse eid="HEB 7:27"/></para>
<para style="p"><verse number="28" style="v" sid="HEB 7:28"/>किनकि व्यवस्थाले कमजोरी भएका मानिसहरूलाई प्रधान पुजारी नियुक्त गर्छ, तर व्यवस्थापछि आएको शपथले परमेश्‍वरको पुत्रलाई नियुक्त गर्‍यो, जो सदासर्वदाको लागि सिद्ध तुल्याइनुभएको छ।<verse eid="HEB 7:28"/></para>
<chapter eid="HEB 7"/>
<chapter number="8" style="c" sid="HEB 8"/>
<para style="p"><verse number="1" style="v" sid="HEB 8:1"/>हामीले भन्‍न चाहेको मुख्य कुरा यही हो: हामीसँग यस्ता प्रधान पुजारी हुनुहुन्छ, जो स्वर्गमा महामहिमको सिंहासनको दाहिने हाततिर विराजमान हुनुहुन्छ<verse eid="HEB 8:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 8:2"/>ती प्रधान पुजारीले साँचो पवित्र वासस्थानमा सेवा गर्नुहुन्छ, जुन वासस्थान मानिसले होइन, तर प्रभुले नै निर्माण गर्नुभएको हो।<verse eid="HEB 8:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 8:3"/>हरेक प्रधान पुजारी भेटी र बलिदानहरू चढाउनको लागि नियुक्त गरिएको हुन्छ; अनि यी प्रधान पुजारीसँग पनि चढाउनको लागि केही हुनुपर्थ्यो।<verse eid="HEB 8:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 8:4"/>यदि उहाँ संसारमा हुनुभएको भए उहाँ पुजारी हुनुहुनेथिएन; किनकि व्यवस्थाले तोकिदिएअनुसार भेटी चढाउनलाई त पुजारीहरू छँदैछन्।<verse eid="HEB 8:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 8:5"/>तिनीहरूले एउटा पवित्रस्थानमा सेवा गर्दछन्, जुनचाहिँ स्वर्गमा भएका कुराको नक्‍कल र छाया मात्र हुन्। यसैकारण मोशाले पवित्र वासस्थान बनाउन लाग्दा तिनलाई यसरी चेतावनी दिइएको थियो: “हेर, तँलाई पर्वतमा देखाइएको नमुनाअनुसार नै हरेक कुरा बनाउनू।”<verse eid="HEB 8:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 8:6"/>वास्तवमा येशूले पाउनुभएको सेवा पुरानोभन्दा उच्‍च दर्जाको छ; किनकि नयाँ करार अझ उत्तम प्रतिज्ञामा स्थापित भएकोले उहाँले मध्यस्थ गरेको करार पनि त्यो पुरानो करारभन्दा उच्‍च दर्जाको छ।<verse eid="HEB 8:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 8:7"/>किनकि यदि त्यो पहिलो करार दोषरहित भएको भए अर्को करारको खाँचो हुनेथिएन।<verse eid="HEB 8:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 8:8"/>तर परमेश्‍वरले मानिसहरूमा दोष भेटेर भन्‍नुभयो: “यस्ता दिनहरू आउनेछन्, प्रभु घोषणा गर्नुहुन्छ, जब म इस्राएलका मानिसहरू र यहूदाका मानिसहरूसँग नयाँ करार स्थापित गर्नेछु।<verse eid="HEB 8:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 8:9"/>यो त्यस करारजस्तै हुनेछैन, जुन करार मैले तिनीहरूका पुर्खाहरूसँग बाँधेँ; जब मैले तिनीहरूलाई हात समातेर इजिप्टबाट डोर्‍याएर ल्याएको थिएँ; किनकि तिनीहरू मेरा करारप्रति विश्‍वासयोग्य भएनन्, अनि म तिनीहरूदेखि विमुख भएँ, प्रभु घोषणा गर्नुहुन्छ।<verse eid="HEB 8:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 8:10"/>त्यसपछि म इस्राएलका मानिसहरूसँग यो करार बाँध्नेछु, प्रभु घोषणा गर्नुहुन्छ। म आफ्नो व्यवस्था तिनीहरूका मनमा राखिदिनेछु र ती तिनीहरूका हृदयमा लेखिदिनेछु। म तिनीहरूका परमेश्‍वर हुनेछु, र तिनीहरू मेरा मानिसहरू हुनेछन्।<verse eid="HEB 8:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 8:11"/>अब उसो कुनै पनि मानिसले आफ्नो छिमेकीलाई अथवा एक-अर्कालाई, ‘प्रभुलाई चिन’ भनी सिकाउनेछैन; किनकि सानादेखि लिएर ठूलासम्म सबैले मलाई चिन्‍नेछन्।<verse eid="HEB 8:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 8:12"/>किनकि म तिनीहरूका दुष्‍टता क्षमा गरिदिनेछु, र तिनीहरूका पापहरू फेरि सम्झनेछैनँ।”<verse eid="HEB 8:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 8:13"/>यस करारलाई “नयाँ” भनेर उहाँले पहिलोलाई चाहिँ काम नलाग्ने तुल्याउनुभयो; अनि जुन काम नलाग्ने र थोत्रो हुन्छ, त्यो चाँडै हराएर जानेछ।<verse eid="HEB 8:13"/></para>
<chapter eid="HEB 8"/>
<chapter number="9" style="c" sid="HEB 9"/>
<para style="p"><verse number="1" style="v" sid="HEB 9:1"/>अब परमेश्‍वरले इस्राएलीहरूसँग बाँध्नुभएको पहिलो करारमा आराधनाको नियम र आराधना गर्ने सांसारिक पवित्रस्थान पनि थियो।<verse eid="HEB 9:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 9:2"/>यसरी वासस्थान तयार भयो। वासस्थानको पहिलो भागमा (पहिलो पर्दाको पछाडि) सामदान थियो, र पवित्र रोटी राखिएको टेबुल थियो; जसलाई पवित्रस्थान भनिन्थ्यो।<verse eid="HEB 9:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 9:3"/>दोस्रो पर्दाको पछाडि अर्को भाग थियो; जसलाई महा-पवित्रस्थान भनिन्थ्यो,<verse eid="HEB 9:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 9:4"/>जसमा सुनको धुपौरो र सुनले मोहोरिएको करारको सन्दुक थियो। यस सन्दुकमा मन्‍न राखिएको सुनको भाँडो, कोपिला लागेको हारूनको लहुरो र करारका शिलापाटीहरू थिए।<verse eid="HEB 9:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 9:5"/>सन्दुकमाथि पाप क्षमाको ठाउँको ढकनीमा छाया पारिरहेका महिमाका करूबहरू थिए, तर हामी यी कुराहरू अहिले विस्तारपूर्वक व्याख्या गर्न सक्दैनौँ।<verse eid="HEB 9:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 9:6"/>यसरी यी सबै थोक मिलाइएपछि पुजारीहरू आफ्ना सेवा गर्नलाई नियमित रूपले पवित्रस्थानको पहिलो भागमा प्रवेश गर्दथे।<verse eid="HEB 9:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 9:7"/>तर दोस्रो भागमा चाहिँ प्रधान पुजारी मात्र वर्षमा एक पल्ट प्रवेश गर्दथे, रगतविना कहिल्यै पनि होइन, जुन रगतचाहिँ तिनले आफ्नै लागि र मानिसहरूले अज्ञानतामा गरेका पापहरूको निम्ति चढाउनलाई जान्थे।<verse eid="HEB 9:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 9:8"/>यसबाट पवित्र आत्माले यो देखाइरहनुभएको थियो, कि पहिलो वासस्थान अस्तित्वमा रहुन्जेल महा-पवित्रस्थानमा जाने बाटो देखाइएको थिएन।<verse eid="HEB 9:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 9:9"/>अहिलेको समयको लागि यो एउटा दृष्‍टान्त हो, जसले यो सङ्केत गर्दछ, कि चढाइएका भेटी र बलिदानहरूले आराधना गर्नेको विवेकलाई शुद्ध गर्न सकेनन्।<verse eid="HEB 9:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 9:10"/>ती नयाँ सुधारको समय नआएसम्म खानेकुरा र पिउने कुरा हुन्, र विभिन्‍न विधिका शुद्धीकरणका बाहिरी नियम मात्र हुन्।<verse eid="HEB 9:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 9:11"/>यहाँ पहिलेदेखि नै स्थापना भएका असल व्यवस्थाहरूको प्रधान पुजारीको रूपमा जब ख्रीष्‍ट आउनुभयो, तब उहाँ अझ महान् र सिद्ध वासस्थानद्वारा जानुभयो, जुनचाहिँ मानिसले बनाएको होइन, अर्थात् जुन वासस्थान यो सृष्‍टिको भाग होइन।<verse eid="HEB 9:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 9:12"/>उहाँ बोका र बाछाहरूको रगत लिएर प्रवेश गर्नुभएन, तर आफ्नै रगत लिएर सधैँको लागि एकै पल्ट महा-पवित्रस्थानमा प्रवेश गर्नुभयो, र हाम्रो लागि अनन्त उद्धार प्राप्‍त गर्नुभयो।<verse eid="HEB 9:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 9:13"/>बोका, साँढेहरूको रगत र कोरलीको खरानी अशुद्ध मानिसहरूमा छर्किंदा तिनीहरू बाहिरी रूपमा शुद्ध हुन्छन् भने,<verse eid="HEB 9:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 9:14"/>झन् आफूलाई परमेश्‍वरमा अनन्त आत्माद्वारा निष्खोट अर्पण गर्नुहुने ख्रीष्‍टको रगतले मृत्युमा लैजाने पाप कर्महरूदेखि हाम्रा विवेकलाई कति बढी शुद्ध पार्ला! ताकि हामीले जीवित परमेश्‍वरको सेवा गर्न सकौँ।<verse eid="HEB 9:14"/></para>
<para style="p"><verse number="15" style="v" sid="HEB 9:15"/>यसकारण ख्रीष्‍ट नयाँ करारको मध्यस्थकर्ता हुनुहुन्छ, ताकि बोलाइएकाहरूले अनन्तको उत्तराधिकार पाऊन् अर्थात् मानिसहरूले पहिलो करार अन्तर्गत गरेका पापहरूबाट छुटकारा पाऊन् भनेर उहाँ छुटकाराको मोल भई मर्नुभएको छ।<verse eid="HEB 9:15"/></para>
<para style="p"><verse number="16" style="v" sid="HEB 9:16"/>इच्छापत्रको विषयमा चाहिँ यसलाई बनाउनेको मृत्यु प्रमाणित भएको हुनुपर्छ;<verse eid="HEB 9:16"/></para>
<para style="p"><verse number="17" style="v" sid="HEB 9:17"/>किनकि कोही मरेपछि मात्र इच्छापत्र प्रयोगमा आउँछ; यसलाई बनाउने जीवित रहुन्जेल त्यो कहिल्यै पनि प्रयोगमा आउँदैन।<verse eid="HEB 9:17"/></para>
<para style="p"><verse number="18" style="v" sid="HEB 9:18"/>यसैकारण पहिलो करार पनि रगतविना कार्यान्वयन भएको थिएन।<verse eid="HEB 9:18"/></para>
<para style="p"><verse number="19" style="v" sid="HEB 9:19"/>जब मोशाले सबै मानिसहरूलाई व्यवस्थाको हरेक आज्ञा घोषणा गरे, तब तिनले पानी, रातो ऊन र हिसपका हाँगाहरूसित बाछाहरूको रगत लिए, र त्यो चर्मपत्र र सबै मानिसहरूमाथि छर्किदिए।<verse eid="HEB 9:19"/></para>
<para style="p"><verse number="20" style="v" sid="HEB 9:20"/>तिनले भने, “यो करारको रगत हो, जुनचाहिँ परमेश्‍वरले तिमीहरूलाई पालन गर्नू भनेर आज्ञा दिनुभएको छ।”<verse eid="HEB 9:20"/></para>
<para style="p"><verse number="21" style="v" sid="HEB 9:21"/>यस्तै प्रकारले तिनले वासस्थान र विधिहरूमा प्रयोग गरिने हरेक थोकमाथि रगत छर्के।<verse eid="HEB 9:21"/></para>
<para style="p"><verse number="22" style="v" sid="HEB 9:22"/>वास्तवमा व्यवस्थाअनुसार प्रायः हरेक थोक नै रगतद्वारा शुद्ध गरिनुपर्छ; अनि रगत नबगाईकन पाप क्षमा नै हुँदैन।<verse eid="HEB 9:22"/></para>
<para style="p"><verse number="23" style="v" sid="HEB 9:23"/>तब यी बलिदानहरूले स्वर्गीय चीजहरूका नक्‍कलहरूलाई शुद्ध हुनु खाँचो परेको थियो भने स्वर्गकै कुरालाई शुद्ध पार्न त अझ उत्तम बलिको आवश्यकता पर्‍यो।<verse eid="HEB 9:23"/></para>
<para style="p"><verse number="24" style="v" sid="HEB 9:24"/>किनकि ख्रीष्‍ट मानिसद्वारा बनिएको वासस्थानमा प्रवेश गर्नुभएन, जुन साँचो पवित्रस्थानको नक्‍कल थियो, तर स्वर्गमा प्रवेश गर्नुभयो, त्यसैले अब हाम्रो लागि परमेश्‍वरको उपस्थितिमा देखा पर्नुहुन्छ।<verse eid="HEB 9:24"/></para>
<para style="p"><verse number="25" style="v" sid="HEB 9:25"/>हरेक वर्ष प्रधान पुजारी अरूको रगत लिएर महा-पवित्रस्थानभित्र प्रवेश गरेजस्तै उहाँ आफूलाई बारम्बार अर्पण गर्न स्वर्गमा प्रवेश गर्नुभएन।<verse eid="HEB 9:25"/></para>
<para style="p"><verse number="26" style="v" sid="HEB 9:26"/>त्यसो भएको भए ख्रीष्‍टले संसारको सृष्‍टिदेखि नै धेरै पल्ट कष्‍ट भोग्नुपर्नेथियो; तर अब उहाँ आफ्नै बलिदानद्वारा पाप हरण गर्नलाई यस युगको अन्त्यमा एकैचोटि सदाको लागि देखा पर्नुभएको छ।<verse eid="HEB 9:26"/></para>
<para style="p"><verse number="27" style="v" sid="HEB 9:27"/>जसरी मानिसले एक पल्ट मर्नु निश्‍चित छ, र त्यसपछि न्यायको सामना गर्नुपर्छ;<verse eid="HEB 9:27"/></para>
<para style="p"><verse number="28" style="v" sid="HEB 9:28"/>त्यसरी नै ख्रीष्‍ट पनि धेरैको पाप उठाइलैजान एकै पल्ट बलिदान हुनुभयो; अनि दोस्रो पल्ट देखा पर्नुहुँदा पाप बोक्न होइन, तर उहाँको प्रतीक्षा गर्नेहरूलाई मुक्ति ल्याउन आउनुहुनेछ।<verse eid="HEB 9:28"/></para>
<chapter eid="HEB 9"/>
<chapter number="10" style="c" sid="HEB 10"/>
<para style="p"><verse number="1" style="v" sid="HEB 10:1"/>व्यवस्था केवल आउने असल कुराहरूको छाया मात्र हो; यो आफैँमा वास्तविकता होइन। यसैकारण यसले एकै किसिमको बलिदान अन्त्य नहुने गरी हरेक वर्ष दोहोर्‍याइएकोले आराधनाको नजिक आउनेहरूलाई सिद्ध तुल्याउन सक्दैन।<verse eid="HEB 10:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 10:2"/>यदि सक्ने भए के ती चढाइन रोकिने थिएनन् र? किनकि आराधना गर्नेहरू सधैँको निम्ति शुद्ध भइसक्नेथिए, र फेरि कहिल्यै तिनीहरूका पापहरूको लागि दोषी ठहरिने थिएनन्।<verse eid="HEB 10:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 10:3"/>तर ती बलिदानहरू पापका वार्षिक सम्झना मात्र हुन्;<verse eid="HEB 10:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 10:4"/>किनकि बोका र साँढेहरूको रगतले पाप हटाउन असम्भव छ।<verse eid="HEB 10:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 10:5"/>यसकारण संसारमा आउनुहुँदा ख्रीष्‍टले भन्‍नुभयो: “बलिदान र भेटी तपाईंले चाहनुभएन, तर तपाईंले मेरो निम्ति एउटा शरीर चढाउनको लागि तयार पारिदिनुभयो।<verse eid="HEB 10:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 10:6"/>होमबलिहरू र पाप शुद्धीकरणको बलिहरूमा तपाईं प्रसन्‍न हुनुभएन।<verse eid="HEB 10:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 10:7"/>तब मैले भनेँ, ‘म यहाँ छु, यो कुरा पवित्र शास्त्रमा लेखिएको छ। हे परमेश्‍वर, म तपाईंको इच्छा पूरा गर्न आएको छु।’ ”<verse eid="HEB 10:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 10:8"/>पहिला उहाँले भन्‍नुभयो, “बलिदान र भेटी, होमबलि र पाप शुद्धीकरणको बलिहरू तपाईंले चाहनुभएन; न त तपाईं तिनीहरूदेखि प्रसन्‍न हुनुभयो”, यद्यपि ती व्यवस्थाले चढाउन भन्दछ।<verse eid="HEB 10:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 10:9"/>तब उहाँले भन्‍नुभयो, “म यहाँ छु, म तपाईंकै इच्छा पूरा गर्न आएको छु।” पहिलोलाई खारेज गर्न उहाँले दोस्रोलाई स्थापित गर्नुभयो।<verse eid="HEB 10:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 10:10"/>अनि उहाँको इच्छाद्वारा येशू ख्रीष्‍टको शरीरको एक पल्टको बलिदानद्वारा हामी सधैँको लागि पापबाट पवित्र पारिएका छौँ।<verse eid="HEB 10:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 10:11"/>पुरानो करारमा हरेक पुजारीले दिनहुँ उभिएर आफ्नो धार्मिक कर्तव्यहरू गर्छन्; घरी-घरी तिनले एकै किसिमका बलिदानहरू चढाउँछन्, जसले कहिल्यै पाप हटाउन सक्दैन।<verse eid="HEB 10:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 10:12"/>तर जब यी प्रधान पुजारीले सधैँको लागि पाप क्षमाको लागि एउटै बलिदान चढाउनुभयो, तब उहाँ परमेश्‍वरको दाहिने हातपट्टि विराजमान हुनुभयो;<verse eid="HEB 10:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 10:13"/>त्यस बेलादेखि नै आफ्ना शत्रुहरूलाई आफ्ना पाउदान बनिऊन् भनेर उहाँ पर्खनुहुन्छ;<verse eid="HEB 10:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 10:14"/>किनकि जो पवित्र तुल्याइँदैछन्, उहाँले तिनीहरूलाई एउटै बलिदानले सदाको निम्ति सिद्ध पार्नुभएको छ।<verse eid="HEB 10:14"/></para>
<para style="p"><verse number="15" style="v" sid="HEB 10:15"/>यस विषयमा पवित्र आत्माले पनि साक्षी दिनुहुन्छ; उहाँ भन्‍नुहुन्छ:<verse eid="HEB 10:15"/></para>
<para style="p"><verse number="16" style="v" sid="HEB 10:16"/>“त्यसपछि म तिनीहरूसित यो करार बाँध्नेछु, प्रभु भन्‍नुहुन्छ, म आफ्नो व्यवस्था तिनीहरूका हृदयमा राखिदिनेछु, र म ती तिनीहरूका मनमा लेखिदिनेछु।”<verse eid="HEB 10:16"/></para>
<para style="p"><verse number="17" style="v" sid="HEB 10:17"/>तब उहाँ फेरि भन्‍नुहुन्छ: “म तिनीहरूका पाप र कुकर्महरू फेरि सम्झनेछैनँ।”<verse eid="HEB 10:17"/></para>
<para style="p"><verse number="18" style="v" sid="HEB 10:18"/>अनि जब यी क्षमा हुन्छन्, तब पाप क्षमाको लागि कुनै बलिदान आवश्यक पर्दैन।<verse eid="HEB 10:18"/></para>
<para style="p"><verse number="19" style="v" sid="HEB 10:19"/>यसकारण दाजुभाइ-दिदीबहिनीहरू हो, हामीलाई येशूको रगतद्वारा महा-पवित्रस्थानभित्र पस्‍ने आत्मविश्‍वास प्राप्‍त भएको छ;<verse eid="HEB 10:19"/></para>
<para style="p"><verse number="20" style="v" sid="HEB 10:20"/>येशूले हाम्रो निम्ति एउटा नयाँ र जीवन दिने मार्ग खोलिदिनुभएको छ, अर्थात् त्यस पर्दाद्वारा, जो उहाँको शरीर हो।<verse eid="HEB 10:20"/></para>
<para style="p"><verse number="21" style="v" sid="HEB 10:21"/>परमेश्‍वरको परिवारमा हामीसँग एक जना प्रधान पुजारी हुनुभएकोले,<verse eid="HEB 10:21"/></para>
<para style="p"><verse number="22" style="v" sid="HEB 10:22"/>हामी विश्‍वासको निश्‍चयताले भरिएको निष्कपट हृदयहरू लिएर परमेश्‍वरको नजिक जाऔँ। किनकि हाम्रो दोषी विवेकलाई शुद्ध पार्नका निम्ति येशूको रगतले छर्किएको छ र हाम्रो शरीरलाई शुद्ध पानीले धोइएको छ।<verse eid="HEB 10:22"/></para>
<para style="p"><verse number="23" style="v" sid="HEB 10:23"/>प्रतिज्ञा गर्नुहुने परमेश्‍वर विश्‍वासयोग्य हुनुभएको हुनाले हामीले अपनाएको आशालाई दृढतासाथ पक्रिराखौँ।<verse eid="HEB 10:23"/></para>
<para style="p"><verse number="24" style="v" sid="HEB 10:24"/>अनि एउटाले अर्कोलाई प्रेम र असल कामको निम्ति उत्साहित गराउने कुरामा विचार गरौँ।<verse eid="HEB 10:24"/></para>
<para style="p"><verse number="25" style="v" sid="HEB 10:25"/>कति जनाको सङ्गतिमा नजाने बानी हुन्छ, तर हामीचाहिँ सङ्गतिमा एकसाथ भेला हुन नछोडौँ; तर प्रभुको पुनरागमन नजिक आइरहेकोले हामी एउटाले अर्कोलाई साहस दिइरहौँ।<verse eid="HEB 10:25"/></para>
<para style="p"><verse number="26" style="v" sid="HEB 10:26"/>यदि हामीले स्पष्‍टसँग सत्य बुझेर पनि जानाजानी पाप गरिरहन्छौँ भने त पापहरूको लागि कुनै बलिदान बाँकी रहनेछैन,<verse eid="HEB 10:26"/></para>
<para style="p"><verse number="27" style="v" sid="HEB 10:27"/>तर परमेश्‍वरका शत्रुहरूलाई भस्म पार्ने आगो र डरलाग्दो न्यायको प्रतीक्षा मात्र रहनेछ।<verse eid="HEB 10:27"/></para>
<para style="p"><verse number="28" style="v" sid="HEB 10:28"/>मोशाको व्यवस्था इन्कार गर्ने जोसुकै पनि दया नपाई दुई वा तीन साक्षीको गवाहीद्वारा मरे।<verse eid="HEB 10:28"/></para>
<para style="p"><verse number="29" style="v" sid="HEB 10:29"/>त्यसो भए झन् परमेश्‍वरको पुत्रलाई खुट्टामुनि कुल्चने, आफूलाई पवित्र तुल्याएको करारको रगतलाई अपवित्र वस्तु ठान्‍ने र अनुग्रहको आत्मालाई अपमानित गर्नेको सजाय झन् कति कठोर होला?<verse eid="HEB 10:29"/></para>
<para style="p"><verse number="30" style="v" sid="HEB 10:30"/>तर यसो भन्‍नुहुने परमेश्‍वरलाई हामी चिन्छौँ, “बदला लिने काम मेरो हो; म बदला लिनेछु,” अनि फेरि “प्रभुले आफ्ना जातिको न्याय गर्नुहुनेछ।”<verse eid="HEB 10:30"/></para>
<para style="p"><verse number="31" style="v" sid="HEB 10:31"/>जिउँदो परमेश्‍वरको हातमा पर्नु डरलाग्दो कुरा हो।<verse eid="HEB 10:31"/></para>
<para style="p"><verse number="32" style="v" sid="HEB 10:32"/>पहिलेका ती दिनहरूलाई सम्झ, जब तिमीहरूले स्पष्‍टसँग सत्य बुझेपछि कसरी कष्‍टहरू बीचको सङ्घर्षमा स्थिर रहेका थियौ।<verse eid="HEB 10:32"/></para>
<para style="p"><verse number="33" style="v" sid="HEB 10:33"/>कुनै बेला तिमीहरूलाई कति पल्ट अपमान गरिएको र सताइएको थियो भने अरू बेलाचाहिँ तिमीहरू त्यस्ता व्यवहार गरिएकाहरूको साथमा काँधमा काँध मिलाएर उभिएका थियौ।<verse eid="HEB 10:33"/></para>
<para style="p"><verse number="34" style="v" sid="HEB 10:34"/>तिमीहरूले कैदमा हुनेहरूसँग सहानुभूति देखाएका थियौ, र आफ्ना सम्पत्ति खुशीसाथ लुटिन दिएका थियौ; किनकि तिमीहरूसित अझ उत्तम र स्थायी सम्पत्ति छन् भनी तिमीहरूले जानेका थियौ।<verse eid="HEB 10:34"/></para>
<para style="p"><verse number="35" style="v" sid="HEB 10:35"/>यसकारण आफ्नो आत्मविश्‍वास नत्याग, जसमा ठूलो प्रतिफल छ।<verse eid="HEB 10:35"/></para>
<para style="p"><verse number="36" style="v" sid="HEB 10:36"/>तिमीहरूले स्थिर भइरहनु खाँचो छ; किनकि तिमीहरूले परमेश्‍वरको इच्छा पूरा गरिसकेपछि उहाँले प्रतिज्ञा गर्नुभएको कुरा प्राप्‍त गर्नेछौ।<verse eid="HEB 10:36"/></para>
<para style="p"><verse number="37" style="v" sid="HEB 10:37"/>किनकि धर्मशास्त्रमा लेखिएको छ, अब केही बेरमा, “उहाँ, जो आउँदैहुनुहुन्छ, आउनुहुनेछ, विलम्ब गर्नुहुनेछैन।”<verse eid="HEB 10:37"/></para>
<para style="p"><verse number="38" style="v" sid="HEB 10:38"/>र, “तर मेरो धर्मी जनचाहिँ विश्‍वासद्वारा नै जिउनेछ। अनि जो पछि हट्छ, म ऊसँग प्रसन्‍न हुनेछैनँ।”<verse eid="HEB 10:38"/></para>
<para style="p"><verse number="39" style="v" sid="HEB 10:39"/>तर हामीचाहिँ पछि हट्ने र नष्‍ट हुनेमध्येका होइनौँ, तर विश्‍वासद्वारा हाम्रो प्राण बचाइएकाहरू मध्येका हौँ।<verse eid="HEB 10:39"/></para>
<chapter eid="HEB 10"/>
<chapter number="11" style="c" sid="HEB 11"/>
<para style="p"><verse number="1" style="v" sid="HEB 11:1"/>अब विश्‍वासचाहिँ हामीले गरेको आशाको निश्‍चयता र हामीले नदेखेका कुराको दृढ भरोसा हो।<verse eid="HEB 11:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 11:2"/>यही विश्‍वासद्वारा प्राचीन कालका मानिसहरूको प्रशंसा भएको थियो।<verse eid="HEB 11:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 11:3"/>विश्‍वासैद्वारा हामी बुझ्दछौँ, कि परमेश्‍वरको वचनले विश्‍व बनियो, र देखिने कुराहरू नदेखिने थोकहरूबाट बनिए।<verse eid="HEB 11:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 11:4"/>विश्‍वासैद्वारा हाबिलले परमेश्‍वरलाई कयिनले भन्दा उत्तम बलिदान चढाए। परमेश्‍वरले तिनको भेटीको विषयमा असल कुरा भन्‍नुहुँदा विश्‍वासैबाट तिनले धर्मी मानिस हुन् भन्‍ने प्रशंसा पाए। तिनी मरेर गए, तापनि तिनी विश्‍वासैद्वारा अझ बोलिरहेका छन्।<verse eid="HEB 11:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 11:5"/>विश्‍वासद्वारा नै हनोकले मृत्युको अनुभव नगरी उठाइए: “अनि तिनी फेला परेनन्; किनकि परमेश्‍वरले नै तिनलाई उठाइलैजानुभयो;” किनकि तिनी उठाइनुअगि नै तिनले परमेश्‍वरलाई खुशी पार्ने व्यक्तिको रूपमा प्रशंसा पाएका थिए।<verse eid="HEB 11:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 11:6"/>विश्‍वासविना परमेश्‍वरलाई खुशी पार्न असम्भव छ; किनकि जो परमेश्‍वरकहाँ आउँछन्, तिनले उहाँ हुनुहुन्छ अनि उहाँलाई खोज्नेहरूलाई पुरस्कार दिनुहुन्छ भनी विश्‍वास गर्नुपर्छ।<verse eid="HEB 11:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 11:7"/>विश्‍वासैद्वारा नोआले नदेखेका कुराहरूको विषयमा चेतावनी पाउँदा आफ्नो परिवारलाई बचाउनको लागि आदरको भयमा एउटा जहाज बनाए। आफ्नो विश्‍वासद्वारा तिनले संसारलाई दोषी ठहराए, र विश्‍वासैद्वारा धार्मिकताका उत्तराधिकारी भए।<verse eid="HEB 11:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 11:8"/>विश्‍वासैद्वारा अब्राहामले उनलाई जानू भनेको ठाउँमा आज्ञाकारी भएर गए, जुन ठाउँ पछिबाट मात्रै उत्तराधिकारको रूपमा प्राप्‍त हुनेवाला थियो। यद्यपि तिनी कहाँ जानुपर्ने हो, सो थाहा थिएन।<verse eid="HEB 11:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 11:9"/>विश्‍वासैद्वारा परदेशीझैँ भएर तिनी प्रतिज्ञाको देशमा रहे, तिनी इसहाक र याकोबसँग पालमा बसे; जो तिनीजस्तै त्यही प्रतिज्ञाका उत्तराधिकारीहरू थिए।<verse eid="HEB 11:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 11:10"/>किनकि तिनले स्थायी जग भएको सहरलाई हेरिरहेका थिए, जसको रचनाकार र निर्माता परमेश्‍वर नै हुनुहुन्छ।<verse eid="HEB 11:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 11:11"/>साराको गर्भधारण गर्ने उमेर गइसकेको भए तापनि विश्‍वासैद्वारा तिनले गर्भधारण गर्ने क्षमता प्राप्‍त गरिन्; किनकि प्रतिज्ञा दिनुहुने विश्‍वासयोग्य हुनुहुन्छ भनी तिनले विश्‍वास गरिन्।<verse eid="HEB 11:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 11:12"/>यसरी नै यी एक जना मानिस, जो मरेतुल्य भए तापनि यिनैबाट आकाशका अनगन्ती ताराहरू र समुद्रका किनारका बालुवाझैँ असंख्य सन्तान भए।<verse eid="HEB 11:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 11:13"/>यी सबै मानिसहरू मृत्युसम्म विश्‍वासमै बाँचेका थिए। तिनीहरूले प्रतिज्ञा गरिएका कुराहरू पाएनन्, तर (विश्‍वासद्वारा) तिनीहरूले टाढैबाट देखेर स्वागत गरे; किनकि तिनीहरू यस संसारमा बिराना र परदेशी हुन् भनी तिनीहरूले मानिलिए।<verse eid="HEB 11:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 11:14"/>यस्ता कुराहरू गर्ने मानिसहरूले यो देखाउँछन्, कि तिनीहरूले त्यो देशको खोजी गरिरहेका छन्, जो तिनीहरूको आफ्नै थियो।<verse eid="HEB 11:14"/></para>
<para style="p"><verse number="15" style="v" sid="HEB 11:15"/>यदि तिनीहरूले आफूले छोडेर आएको देश नै सम्झिरहेको भए, तिनीहरूलाई फर्किजाने मौका मिल्नेथियो।<verse eid="HEB 11:15"/></para>
<para style="p"><verse number="16" style="v" sid="HEB 11:16"/>यसको सट्टामा तिनीहरूले त अझ उत्तम देश अर्थात् स्वर्गीय देशको प्रतीक्षा गरिरहेका थिए। यसकारण परमेश्‍वर तिनीहरूका परमेश्‍वर हुँ भन्‍न शर्माउनुभएन; किनकि उहाँले तिनीहरूका निम्ति एउटा सहर तयार गरिदिनुभएको छ।<verse eid="HEB 11:16"/></para>
<para style="p"><verse number="17" style="v" sid="HEB 11:17"/>विश्‍वासैद्वारा अब्राहामले, तिनको परमेश्‍वरद्वारा जाँच हुँदा इसहाकलाई बलिदानको रूपमा चढाइहालेका थिए। अब्राहाम, जसले प्रतिज्ञालाई अँगालेका थिए, तिनैले आफ्नो एउटै पुत्रलाई बलिदान चढाउन तयार भएका थिए;<verse eid="HEB 11:17"/></para>
<para style="p"><verse number="18" style="v" sid="HEB 11:18"/>यद्यपि परमेश्‍वरले तिनलाई भन्‍नुभएको थियो, “इसहाकबाट नै तेरो वंशको नाम रहनेछ।”<verse eid="HEB 11:18"/></para>
<para style="p"><verse number="19" style="v" sid="HEB 11:19"/>परमेश्‍वरले मरेकाहरूलाई पनि जीवित पार्न सक्नुहुन्छ भनी अब्राहामले तर्क गरेर सोचे, र एक अर्थमा इसहाकलाई मृत्युबाट फिर्ता पाए।<verse eid="HEB 11:19"/></para>
<para style="p"><verse number="20" style="v" sid="HEB 11:20"/>विश्‍वासैद्वारा इसहाकले याकोब र एसावलाई तिनीहरूका भविष्यबारे आशिष् दिए।<verse eid="HEB 11:20"/></para>
<para style="p"><verse number="21" style="v" sid="HEB 11:21"/>विश्‍वासैद्वारा याकोबले आफू मर्ने बेलामा र आफ्नो लहुरोको टुप्पोमा अडेस लागेर योसेफका दुवै छोरालाई आशीर्वाद दिए।<verse eid="HEB 11:21"/></para>
<para style="p"><verse number="22" style="v" sid="HEB 11:22"/>विश्‍वासैद्वारा योसेफले पनि आफ्नो अन्त्य नजिक आइपुग्दा इस्राएलीहरू इजिप्टबाट निस्केर आउने कुरा गरे, र आफ्ना हड्डीहरू गाड्ने विषयमा निर्देशन दिए।<verse eid="HEB 11:22"/></para>
<para style="p"><verse number="23" style="v" sid="HEB 11:23"/>विश्‍वासैद्वारा मोशाका आमाबुबाले तिनी जन्मेपछि तीन महिनासम्म लुकाइ राखे; किनकि तिनीहरूले बालक असाधारण भएको देखे, र तिनीहरूले राजाको हुकुमदेखि डर मानेनन्।<verse eid="HEB 11:23"/></para>
<para style="p"><verse number="24" style="v" sid="HEB 11:24"/>विश्‍वासैद्वारा मोशाले, जवान भएपछि फारोकी छोरीको छोरा कहलाइन अस्वीकार गरे।<verse eid="HEB 11:24"/></para>
<para style="p"><verse number="25" style="v" sid="HEB 11:25"/>पापको सुख केही समयसम्म भोग्नुभन्दा परमेश्‍वरका जनहरूसित थिचोमिचोमा पर्नु तिनी राजी भए।<verse eid="HEB 11:25"/></para>
<para style="p"><verse number="26" style="v" sid="HEB 11:26"/>इजिप्टको धनसम्पत्तिभन्दा ख्रीष्‍टको निम्ति निन्दित हुन तिनले बढ्ता मूल्यको सम्झे; किनकि तिनले आफ्नो दृष्‍टिलाई पछि प्राप्‍त हुने प्रतिफलतिर लगाएका थिए।<verse eid="HEB 11:26"/></para>
<para style="p"><verse number="27" style="v" sid="HEB 11:27"/>विश्‍वासैद्वारा तिनले राजाको रिसको डरै नमानी इजिप्ट देशलाई त्यागे; किनकि अदृश्य हुनुहुने परमेश्‍वरलाई देखेर तिनी स्थिर रहिरहे।<verse eid="HEB 11:27"/></para>
<para style="p"><verse number="28" style="v" sid="HEB 11:28"/>पहिले जन्मेकोलाई नाश गर्नेले इस्राएलका पहिले जन्मेकाहरूलाई छुन नपाऊन् भनेर तिनले विश्‍वासद्वारा निस्तार चाडको विधि पालन गरे र रगतको प्रयोग गरे।<verse eid="HEB 11:28"/></para>
<para style="p"><verse number="29" style="v" sid="HEB 11:29"/>विश्‍वासैद्वारा मानिसहरूले लाल समुद्र सुक्खा जमिनझैँ तरे; तर जब इजिप्टियनहरूले त्यसै गर्न खोज्दा, तिनीहरू डुबेर मरे।<verse eid="HEB 11:29"/></para>
<para style="p"><verse number="30" style="v" sid="HEB 11:30"/>सात दिनसम्म सेनाहरूले यरीहोको परिक्रमा गरेपछि विश्‍वासैद्वारा पर्खालहरू ढले।<verse eid="HEB 11:30"/></para>
<para style="p"><verse number="31" style="v" sid="HEB 11:31"/>विश्‍वासैद्वारा राहाब वेश्या ती अनाज्ञाकारीहरूसित मारिइनन्; किनकि तिनले ती जासुसहरूलाई स्वागत गरेकी थिइन्।<verse eid="HEB 11:31"/></para>
<para style="p"><verse number="32" style="v" sid="HEB 11:32"/>अनि अझ बढ्ता म के भनूँ? गिदोन, बाराक, शिमशोन, यिप्‍ता, दावीद, शमूएल र अगमवक्ताहरू यी सबैको विषयमा बयान गरिरहने समय मसित छैनँ।<verse eid="HEB 11:32"/></para>
<para style="p"><verse number="33" style="v" sid="HEB 11:33"/>उनीहरूले विश्‍वासैद्वारा राज्यहरू जिते, न्याय दिए, प्रतिज्ञा गरिएका थोकहरू प्राप्‍त गरे, उनीहरूले सिंहका मुखहरू थुने,<verse eid="HEB 11:33"/></para>
<para style="p"><verse number="34" style="v" sid="HEB 11:34"/>दन्केको आगोको ज्वालाहरू निभाए, र तरवारको धारबाट उम्के। उनीहरूका कमजोरीहरू शक्तिमा परिवर्तन भए, र उनीहरू लडाइँहरूमा शक्तिशाली भए, र विदेशी सेनाहरूलाई परास्त गरे।<verse eid="HEB 11:34"/></para>
<para style="p"><verse number="35" style="v" sid="HEB 11:35"/>स्त्रीहरूले आफ्ना प्रिय जनहरूलाई मृत्युबाट फेरि जीवित प्राप्‍त गरे। अरूहरू सताइए, र अझ उत्तम पुनरुत्थान प्राप्‍त गर्न सकौँ भनेर छुटकारा पनि अस्वीकार गरे।<verse eid="HEB 11:35"/></para>
<para style="p"><verse number="36" style="v" sid="HEB 11:36"/>कतिले गिल्‍ला र कोर्राको सामना गरे, कतिपयहरूचाहिँ साङ्लाले बाँधिएर कैदमा हालिए।<verse eid="HEB 11:36"/></para>
<para style="p"><verse number="37" style="v" sid="HEB 11:37"/>तिनीहरू ढुङ्गाले हानेर मारिए, करौँतीले दुई फ्याक पारिए, र तिनीहरू तरवारद्वारा मारिए। तिनीहरू भेडा र बाख्राका छाला लगाएर भौँतारिँदै हिँडे; दरिद्रतामा परे, सताइएर दुर्व्यवहारमा परे।<verse eid="HEB 11:37"/></para>
<para style="p"><verse number="38" style="v" sid="HEB 11:38"/>संसार तिनीहरूका लागि योग्यको थिएन। तिनीहरू पाखापखेरा, गुफाहरू र खाडलहरूभित्र रहँदै मरुभूमि र पहाडहरूमा भौँतारिँदै हिँडे।<verse eid="HEB 11:38"/></para>
<para style="p"><verse number="39" style="v" sid="HEB 11:39"/>अनि तिनीहरूले आफ्ना विश्‍वासको निम्ति प्रशंसा पाए, तर प्रतिज्ञा गरिएका थोकहरू भने कसैले पनि पाएनन्।<verse eid="HEB 11:39"/></para>
<para style="p"><verse number="40" style="v" sid="HEB 11:40"/>परमेश्‍वरले हाम्रो निम्ति केही उत्तम योजना राख्नुभएको थियो, ताकि हामीहरूसँगै तिनीहरू सिद्ध होऊन्।<verse eid="HEB 11:40"/></para>
<chapter eid="HEB 11"/>
<chapter number="12" style="c" sid="HEB 12"/>
<para style="p"><verse number="1" style="v" sid="HEB 12:1"/>यसकारण यतिका साक्षीका ठूला बादलले हामीलाई घेरिराखेका हुनाले, हामीलाई बाधा पुर्‍याउने टन्टाहरू र सजिलैसित अलमल्याउने पापहरूजस्ता हरेक थोक त्यागेर, हाम्रो अगि राखिएको दौड धीरजसाथ दगुरौँ।<verse eid="HEB 12:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 12:2"/>हाम्रा विश्‍वासका कर्ता र सिद्ध तुल्याउनुहुने येशूमा हाम्रा आँखा केन्द्रित गरौँ, जसले आफ्नो अगि राखिएको आनन्दको निम्ति अपमानलाई केहीजस्तो नठानी क्रूसको कष्‍ट भोग्नुभयो, र परमेश्‍वरको सिंहासनको दाहिने हाततिर विराजमान हुनुभयो।<verse eid="HEB 12:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 12:3"/>पापीहरूबाट उहाँको विरुद्धमा भएका यतिका विवादहरू सहनुहुनेलाई विचार गर, यसरी तिमीहरू थाक्नेछैनौ र हरेस खानेछैनौ।<verse eid="HEB 12:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 12:4"/>तिमीहरूको पापको सङ्घर्षको विरुद्धमा तिमीहरूले रगत बग्ने गरी त्यसको विरोध गरेका छैनौ।<verse eid="HEB 12:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 12:5"/>पिताले आफ्नो पुत्रलाई भनेझैँ तिमीहरूलाई भनिएका परमेश्‍वरको ढाडसका वचन तिमीहरूले पूरै भुलिसक्यौ? “हे मेरा छोराछोरी, परमेश्‍वरको अनुशासनलाई हल्का नठान; अनि उहाँले तिमीलाई हप्काउँदा हताश नहोऊ;<verse eid="HEB 12:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 12:6"/>किनकि परमेश्‍वरले आफूले प्रेम गरेकाहरूलाई अनुशासन गर्नुहुन्छ; अनि आफूले पुत्र भनी ग्रहण गरेकाहरूलाई उहाँले दण्ड दिनुहुन्छ।”<verse eid="HEB 12:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 12:7"/>कठिनाइलाई अनुशासन ठानी भोग; किनकि परमेश्‍वरले तिमीहरूलाई सन्तानहरूझैँ व्यवहार गर्दै हुनुहुन्छ। पिताले अनुशासनमा नराखेको कुनचाहिँ छोरा होला र?<verse eid="HEB 12:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 12:8"/>अनि सबै जना अनुशासनको भागी भएर जान्छन्; यदि तिमीहरूलाई अनुशासनमा राखिएन भने तिमीहरू वैधानिक होइनौ, साँचो छोराछोरीहरू होइनौ।<verse eid="HEB 12:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 12:9"/>यसबाहेक हामीलाई अनुशासन राख्ने हाम्रा शारीरिक बुबाहरू थिए, र हामीले तिनीहरूलाई आदर गर्‍यौँ भने झन् कति बढी हाम्रा आत्माहरूका पिताको अधीनमा रहनुपर्छ र जिउनुपर्छ!<verse eid="HEB 12:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 12:10"/>उहाँहरूलाई असल लागेअनुसार हामीलाई केही समयसम्म अनुशासनमा राख्नुभयो, तर हामी परमेश्‍वरको पवित्रतामा सहभागी होऔँ भनेर परमेश्‍वरले हामीलाई हाम्रै भलाइको लागि अनुशासनमा राख्नुहुन्छ।<verse eid="HEB 12:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 12:11"/>कुनै पनि अनुशासन त्यस बेलाको लागि सुखद हुँदैन, तर कष्‍टदायक हुन्छ। तरै पनि पछि गएर यसमा तालिम पाएकाहरूको लागि धार्मिकता र शान्तिको फल उत्पन्‍न हुन्छ।<verse eid="HEB 12:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 12:12"/>यसकारण तिमीहरूका कमजोर हातहरू र दुर्बल घुँडाहरू बलियो बनाओ।<verse eid="HEB 12:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 12:13"/>“तिमीहरूका खुट्टाका लागि बाटो समतल बनाओ” ताकि अशक्तको अङ्ग नखुस्कोस्, तर निको होस्।<verse eid="HEB 12:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 12:14"/>हरेक मानिससित मिलापमा रहने, र पवित्रतामा हुने भरमग्दूर प्रयत्न गर; किनकि पवित्रताविना कसैले प्रभुलाई देख्नेछैन।<verse eid="HEB 12:14"/></para>
<para style="p"><verse number="15" style="v" sid="HEB 12:15"/>ध्यान देओ, कुनै मानिस परमेश्‍वरको अनुग्रहबाट वञ्चित नहोस्, नत्रता तितोपनको जरा टुसाएर त्यसले फाटो ल्याउला, र धेरैजनालाई बिटुलो पार्ला।<verse eid="HEB 12:15"/></para>
<para style="p"><verse number="16" style="v" sid="HEB 12:16"/>अनैतिक सम्बन्ध राख्ने कोही नहोस्, अथवा जेठो छोरा भएर पनि एक छाक खानेकुराको लागि आफ्नो पैतृक अधिकार बेच्ने एसावजस्तै अधर्मी नहोस् भन्‍ने कुरामा ध्यान देओ।<verse eid="HEB 12:16"/></para>
<para style="p"><verse number="17" style="v" sid="HEB 12:17"/>पछिबाट आफ्नो पैतृक अधिकार आशिष् उपभोग गर्ने इच्छा गर्दा तिनी तिरस्कृत भएका थिए भन्‍ने तिमीलाई थाहै छ। यद्यपि तिनले आँसुसहित त्यो आशिष् प्राप्‍त गर्न खोजेका थिए; तर तिनले जे गरेका थिए, त्यसलाई सपार्ने मौका नै पाएनन्।<verse eid="HEB 12:17"/></para>
<para style="p"><verse number="18" style="v" sid="HEB 12:18"/>तिमीहरू छुन सकिने त्यस सियोन पर्वतमा आएका छैनौ, जहाँ आगोले जलिरहेको, अन्धकार, कालो बादल छाएको र आँधी चलिरहेको थियो।<verse eid="HEB 12:18"/></para>
<para style="p"><verse number="19" style="v" sid="HEB 12:19"/>तुरहीको चर्को सोर र शब्द निकालेर बोल्ने आवाजमा पनि आएका छैनौ, जसलाई सुनेपछि तिनीहरूले अब यस्तो शब्द सुन्‍न नपरोस् भनी बिन्ती गरेका थिए,<verse eid="HEB 12:19"/></para>
<para style="p"><verse number="20" style="v" sid="HEB 12:20"/>किनकि, “कुनै जनावरले समेत त्यस पर्वतलाई छोए भने त्यसलाई ढुङ्गाले हिर्काएर मार्नू” भन्‍ने आदेश तिनीहरूले सहन सकेनन्।<verse eid="HEB 12:20"/></para>
<para style="p"><verse number="21" style="v" sid="HEB 12:21"/>त्यो दृश्य यति डरलाग्दो थियो, कि मोशाले पनि भने, “म डरले कामिरहेको छु।”<verse eid="HEB 12:21"/></para>
<para style="p"><verse number="22" style="v" sid="HEB 12:22"/>तर तिमीहरू त सियोन पर्वतमा, जिउँदो परमेश्‍वरको सहर, स्वर्गीय यरूशलेममा आएका छौ। तिमीहरू असंख्य स्वर्गदूतहरू भएको आनन्दमय सभामा आएका छौ,<verse eid="HEB 12:22"/></para>
<para style="p"><verse number="23" style="v" sid="HEB 12:23"/>अर्थात् पहिला जन्मेकाहरूको मण्डलीमा, जसका नामहरू स्वर्गमा लेखिएका छन्। तिमीहरू सबै मानिसहरूका न्यायकर्ता परमेश्‍वरकहाँ, र सिद्ध तुल्याइएका धर्मी मानिसहरूका आत्मामा,<verse eid="HEB 12:23"/></para>
<para style="p"><verse number="24" style="v" sid="HEB 12:24"/>नयाँ करारका मध्यस्थ येशूकहाँ, र हाबिलको रगतभन्दा अझ राम्रोसँग बोलिदिने रगतको छिट्काउमा आएका छौ।<verse eid="HEB 12:24"/></para>
<para style="p"><verse number="25" style="v" sid="HEB 12:25"/>होसियार रहो! परमेश्‍वर, जो बोल्नुहुन्छ, उहाँलाई इन्कार गर्नुहुँदैन। संसारमा चेतावनी दिनेलाई इन्कार गर्दा तिनीहरू उम्केनन् भने स्वर्गबाट चेतावनी दिनुहुनेलाई इन्कार गर्दा हामी कसरी उम्कन सक्छौँ?<verse eid="HEB 12:25"/></para>
<para style="p"><verse number="26" style="v" sid="HEB 12:26"/>त्यस बेला उहाँको सोरले पृथ्वी हल्‍लाएको थियो, तर अब त उहाँले यसो भनी प्रतिज्ञा गर्नुभएको छ, “फेरि एक पल्ट म पृथ्वी मात्र होइन, तर स्वर्गलाई पनि हल्‍लाउनेछु।”<verse eid="HEB 12:26"/></para>
<para style="p"><verse number="27" style="v" sid="HEB 12:27"/>त्यो “फेरि एक पल्ट” भन्‍ने शब्दहरूले यो देखाउँछ, कि हल्‍लाउन सकिने कुराहरू, अर्थात् सृजिएका कुराहरू हटाइनेछन्; ताकि हल्‍लाउन नसकिने कुराहरूचाहिँ रहिरहून्।<verse eid="HEB 12:27"/></para>
<para style="p"><verse number="28" style="v" sid="HEB 12:28"/>यसैकारण हामीले एउटा नहल्‍लिने राज्य पाउने हुनाले हामी धन्यवादी भई परमेश्‍वरलाई भक्ति र भयको साथ स्वीकार्य आराधना चढाऔँ;<verse eid="HEB 12:28"/></para>
<para style="p"><verse number="29" style="v" sid="HEB 12:29"/>किनकि हाम्रो “परमेश्‍वर भस्म पार्ने आगो हुनुहुन्छ।”<verse eid="HEB 12:29"/></para>
<chapter eid="HEB 12"/>
<chapter number="13" style="c" sid="HEB 13"/>
<para style="p"><verse number="1" style="v" sid="HEB 13:1"/>एक-अर्कालाई दाजुभाइ-दिदीबहिनीहरूलाई झैँ प्रेम गरिरहो।<verse eid="HEB 13:1"/></para>
<para style="p"><verse number="2" style="v" sid="HEB 13:2"/>अपरिचितहरूको पाहुनासत्कार गर्न नबिर्स; किनकि यसो गरेर कति मानिसहरूले अनजानमै स्वर्गदूतहरूलाई सत्कार गरेका छन्।<verse eid="HEB 13:2"/></para>
<para style="p"><verse number="3" style="v" sid="HEB 13:3"/>कैदीहरूलाई तिमीहरू आफू पनि सङ्गी-कैदी भएझैँ र दुर्व्यव्यवहारमा परेकाहरूलाई तिमीहरू आफैँले कष्‍ट भोग गरेझैँ सम्झिदेओ।<verse eid="HEB 13:3"/></para>
<para style="p"><verse number="4" style="v" sid="HEB 13:4"/>विवाहलाई सबैले आदरणीय मानून्, र ओछ्यान नबिटुलियोस्; किनकि परमेश्‍वरले व्यभिचारी र सबै अनैतिक सम्बन्धहरूको न्याय गर्नुहुन्छ।<verse eid="HEB 13:4"/></para>
<para style="p"><verse number="5" style="v" sid="HEB 13:5"/>तिमीहरूको जीवनशैली पैसाको प्रेमदेखि मुक्त होस्, र तिमीहरूसित जे छ त्यसैमा सन्तुष्‍ट रहो; किनकि परमेश्‍वरले धर्मशास्त्रमा भन्‍नुभएको छ, “म तिमीहरूलाई कहिल्यै छोड्नेछैनँ, म तिमीहरूलाई कहिल्यै त्याग्नेछैनँ।”<verse eid="HEB 13:5"/></para>
<para style="p"><verse number="6" style="v" sid="HEB 13:6"/>यसकारण हामी आत्मविश्‍वाससहित भन्दछौँ, “प्रभु मेरा सहायक हुनुहुन्छ, म डराउनेछैनँ। मरणशील मानिसले मलाई के गर्न सक्छ र?”<verse eid="HEB 13:6"/></para>
<para style="p"><verse number="7" style="v" sid="HEB 13:7"/>आफ्ना अगुवाहरूको सम्झना गर, जसले तिमीहरूलाई परमेश्‍वरको वचन सिकाएका थिए। तिनीहरूका जीवनको परिणामलाई विचार गरेर तिनीहरूका विश्‍वासको अनुकरण गर।<verse eid="HEB 13:7"/></para>
<para style="p"><verse number="8" style="v" sid="HEB 13:8"/>येशू ख्रीष्‍ट हिजो, आज र सदासर्वदा एकसमान हुनुहुन्छ।<verse eid="HEB 13:8"/></para>
<para style="p"><verse number="9" style="v" sid="HEB 13:9"/>सबै किसिमका अनौठा शिक्षाहरूका भ्रममा नपर। हाम्रो हृदयलाई अनुग्रहद्वारा बलियो पार्नु असल छ, तर धर्म विधिअनुसारको भोजनले होइन, जुनचाहिँ खानेहरूको लागि कुनै मूल्यको हुँदैन।<verse eid="HEB 13:9"/></para>
<para style="p"><verse number="10" style="v" sid="HEB 13:10"/>हाम्रो एउटा वेदी छ, ती वासस्थानमा सेवा गर्नेहरूलाई खाने अधिकार छैन र?<verse eid="HEB 13:10"/></para>
<para style="p"><verse number="11" style="v" sid="HEB 13:11"/>प्रधान पुजारीले पाप शुद्धीकरणको बलिको रूपमा पशुहरूको रगत महा-पवित्रस्थानमा लिएर जान्छन्, तर शरीर त छाउनीबाहिर नै जलाइन्छन्।<verse eid="HEB 13:11"/></para>
<para style="p"><verse number="12" style="v" sid="HEB 13:12"/>यसकारण येशूले पनि आफ्नै रगतद्वारा मानिसहरूलाई पवित्र पार्नलाई सहरको ढोकाबाहिर नै दुःख भोग्नुभयो।<verse eid="HEB 13:12"/></para>
<para style="p"><verse number="13" style="v" sid="HEB 13:13"/>त्यसो भए, हामी पनि छाउनीबाहिर उहाँकहाँ जाऔँ, र उहाँले सहनुभएको अपमान सहौँ।<verse eid="HEB 13:13"/></para>
<para style="p"><verse number="14" style="v" sid="HEB 13:14"/>किनकि यस पृथ्वीमा हाम्रो स्थायी सहर छैन, तर हामी त आउनेवाला सहरको प्रतीक्षा गरिरहेका छौँ।<verse eid="HEB 13:14"/></para>
<para style="p"><verse number="15" style="v" sid="HEB 13:15"/>यसकारण हामी येशूद्वारा परमेश्‍वरलाई सदैव प्रशंसाको बलिदान चढाऔँ, जो उहाँको नाम स्वीकार गर्ने हाम्रो ओठको फल हो।<verse eid="HEB 13:15"/></para>
<para style="p"><verse number="16" style="v" sid="HEB 13:16"/>अनि भलाइ गर्न र अरूसित बाँडचुँड गर्न नबिर्स; किनकि यस्तो बलिदानद्वारा परमेश्‍वर प्रसन्‍न हुनुहुन्छ।<verse eid="HEB 13:16"/></para>
<para style="p"><verse number="17" style="v" sid="HEB 13:17"/>तिमीहरूका अगुवाहरूको आज्ञापालन गर, र तिनीहरूका अधिकारको अधीनमा बस; किनकि तिनीहरूले परमेश्‍वरलाई आफ्नो सेवाको लेखा दिनुपर्छ भन्‍ने कुरा जानेर नै तिनीहरूले तिमीहरूका प्राणको हेरचाह गर्दछन्। यो काम तिनीहरूले आनन्दसाथ गरून्, दुःख मानेर होइन, नत्रता त्यसबाट तिमीहरूलाई कुनै लाभ हुनेछैन।<verse eid="HEB 13:17"/></para>
<para style="p"><verse number="18" style="v" sid="HEB 13:18"/>हाम्रो निम्ति प्रार्थना गर। हाम्रो विवेक सफा छ भन्‍ने हामी निश्‍चित छौँ; अनि हरेक प्रकारले आदरसाथ जिउने चाहना गर्छौँ।<verse eid="HEB 13:18"/></para>
<para style="p"><verse number="19" style="v" sid="HEB 13:19"/>म तिमीहरूलाई प्रार्थना गर्न विशेष आग्रह गर्दछु, ताकि म फेरि चाँडै तिमीहरूकहाँ आउन सकूँ।<verse eid="HEB 13:19"/></para>
<para style="p"><verse number="20" style="v" sid="HEB 13:20"/>अब शान्तिका परमेश्‍वर, जसले अनन्तको करारको रगतद्वारा भेडाका महान् गोठाला हाम्रा प्रभु येशूलाई मरेकाबाट जीवित पार्नुभयो;<verse eid="HEB 13:20"/></para>
<para style="p"><verse number="21" style="v" sid="HEB 13:21"/>उहाँले आफ्नो इच्छा पूरा गर्न तिमीहरूलाई हरेक असल थोकले सुसज्जित पारून्। येशू ख्रीष्‍टद्वारा उहाँलाई मनपर्ने कामहरू उहाँले हामीमा गरेका होऊन्। उहाँलाई नै सदासर्वदा महिमा होस्! आमेन।<verse eid="HEB 13:21"/></para>
<para style="p"><verse number="22" style="v" sid="HEB 13:22"/>अनि दाजुभाइ-दिदीबहिनीहरू, म तिमीहरूलाई मेरो अर्ती सुनिदेओ भनी आग्रह गर्दछु; किनकि मैले तिमीहरूलाई एउटा छोटो पत्र लेखेको छु।<verse eid="HEB 13:22"/></para>
<para style="p"><verse number="23" style="v" sid="HEB 13:23"/>हाम्रा भाइ तिमोथी कैदबाट छोडिएका छन् भन्‍ने तिमीहरूले जान भनी म चाहन्छु। यदि तिनी चाँडै आए भने म तिनीसितै तिमीहरूलाई हेर्न आउनेछु।<verse eid="HEB 13:23"/></para>
<para style="p"><verse number="24" style="v" sid="HEB 13:24"/>तिमीहरूका सबै अगुवाहरू र परमेश्‍वरका जनहरूलाई अभिवादन सुनाइदेओ। इटालीयाबाट आएकाहरूले तिमीहरूलाई अभिवादन पठाएका छन्।<verse eid="HEB 13:24"/></para>
<para style="p"><verse number="25" style="v" sid="HEB 13:25"/>तिमीहरू सबैसित अनुग्रह रहोस्!<verse eid="HEB 13:25"/></para>
<chapter eid="HEB 13"/>
</usx>