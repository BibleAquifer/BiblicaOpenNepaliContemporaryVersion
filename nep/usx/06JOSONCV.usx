<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="JOS" style="id">- Biblica Open Nepali Contemporary Version -</book>
<para style="h">यहोशू</para>
<para style="toc1">यहोशू</para>
<para style="toc2">यहोशू</para>
<para style="mt1">यहोशू</para>
<chapter number="1" style="c" sid="JOS 1"/>
<para style="p"><verse number="1" style="v" sid="JOS 1:1"/>याहवेहका सेवक मोशाको मृत्युपछि याहवेहले मोशाका सहायक, नूनका छोरा, यहोशूलाई यसो भन्‍नुभयो:<verse eid="JOS 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 1:2"/>“मेरो सेवक मोशाको मृत्यु भइसक्यो। यसकारण अब तँ र यी मानिसहरू यर्दन नदी तरेर मैले तिनीहरूलाई अर्थात् इस्राएलीहरूलाई दिन लागेको देशमा जानलाई तयारी गर्।<verse eid="JOS 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 1:3"/>मैले मोशालाई प्रतिज्ञा गरेझैँ, तैँले पाइला टेक्ने सबै भूमि म तँलाई दिनेछु।<verse eid="JOS 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 1:4"/>तिमीहरूको देशको सिमाना उजाडस्थानदेखि लेबनानसम्म लिएर महानदी अर्थात् यूफ्रेटिस नदीदेखि हित्तीहरूको सबै देश अर्थात् पश्‍चिममा भूमध्य सागरसम्म हुनेछ।<verse eid="JOS 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 1:5"/>तेरो जीवनकालभरि तेरो विरुद्धमा कोही पनि खडा हुन सक्नेछैन। जसरी म मोशासँग थिएँ, त्यसरी नै तँसँग पनि रहनेछु; म तँलाई कहिल्यै छोड्नेछैनँ, न त तँलाई त्याग्ने नै छु।<verse eid="JOS 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 1:6"/>“बलियो र साहसी बन्; किनकि तैँले नै यी मानिसहरूलाई मैले तिनीहरूका पितापुर्खाहरूलाई दिनेछु भनी शपथ खाएको देशमा अधिकार गर्नलाई अगुवाइ गर्नेछस्।<verse eid="JOS 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 1:7"/>“बलियो र खूब साहसी बन्। मेरो सेवक मोशाले तँलाई दिएको सारा व्यवस्था होसियारीसाथ पालन गर्; त्यसबाट दायाँ अथवा बायाँतिर नलाग्नू। तँ जहाँ गए तापनि सफलता पाउनेछस्।<verse eid="JOS 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 1:8"/>व्यवस्थाको यो पुस्तक तेरो ओठबाट कहिल्यै नहटोस्; तैँले त्यसमाथि दिनरात ध्यान गर्नू, ताकि त्यसमा लेखिएका हरेक कुरा होसियारीसाथ पालन गर्न सक्नेछस्। तब तैँले उन्‍नति गर्नेछस् र सफलता पाउनेछस्।<verse eid="JOS 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 1:9"/>के मैले तँलाई बलियो र साहसी हुनलाई आज्ञा दिएको छैन र? नडरा, निरुत्साहित नहो; किनकि तँ जहाँ गए तापनि याहवेह तेरा परमेश्‍वर तँसित हुनुहुनेछ।”<verse eid="JOS 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 1:10"/>यसकारण यहोशूले मानिसहरूका अधिकृतहरूलाई आदेश दिए:<verse eid="JOS 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 1:11"/>“छाउनीभित्र गएर मानिसहरूलाई भन, ‘तिमीहरूका खाने कुराहरूको बन्दोबस्त गर। अबको तीन दिनमा याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई आफ्नो उत्तराधिकारको रूपमा दिनुहुने देशमाथि अधिकार गर्न तिमीहरू यर्दन नदी पार गरेर जानेछौ।’ ”<verse eid="JOS 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 1:12"/>तर रूबेनीहरू, गादीहरू र मनश्शेको आधा कुललाई चाहिँ यहोशूले भने,<verse eid="JOS 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 1:13"/>“याहवेहको सेवक मोशाले तिमीहरूलाई दिएको आज्ञा याद गर, ‘याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई यो देश दिएर विश्राम दिनुहुनेछ।’<verse eid="JOS 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 1:14"/>तिमीहरूका पत्नीहरू, छोराछोरीहरू र तिमीहरूका गाईबस्तुहरू चाहिँ मोशाले तिमीहरूलाई दिएको यर्दन नदीको पूर्वपट्टिको भूमिमा बस्‍न सक्छन्। तर तिमीहरूका सबै योद्धाहरू भने लडाइँका निम्ति हातहतियारले सुसज्जित भएर आ-आफ्ना दाजुभाइहरूका साथमा अगि-अगि पारि जानुपर्छ। तिमीहरूले तिनीहरूलाई सहायता गर्नुपर्छ।<verse eid="JOS 1:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 1:15"/>याहवेहले तिमीहरूलाई विश्राम दिनुभएझैँ, उहाँले तिमीहरूका दाजुभाइहरूलाई विश्राम नदिनुभएसम्म र याहवेह तिमीहरूका परमेश्‍वरले तिनीहरूलाई दिनुहुने देशमा तिनीहरूले पनि अधिकार नगरेसम्म तिमीहरूले तिनीहरूलाई सहायता गर्नुपर्नेछ। त्यसपछि तिमीहरू याहवेहका सेवक मोशाले यर्दनको पूर्वपट्टि घाम झुल्कनेतिर तिमीहरूलाई दिएको भूमिमा फर्केर जान सक्छौ, र आफ्नो भूमिमा बसोबास गर्न सक्नेछौ।”<verse eid="JOS 1:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 1:16"/>तब तिनीहरूले यहोशूलाई जवाफ दिए, “तपाईंले हामीलाई आज्ञा दिनुभएका सबै कुराहरू हामी गर्नेछौँ, र तपाईंले हामीलाई जहाँ पठाउनुहुन्छ, त्यहीँ जानेछौँ।<verse eid="JOS 1:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 1:17"/>जसरी हामीले मोशाको आज्ञापालन गर्‍यौँ, त्यसरी नै हामी तपाईंको पनि आज्ञापालन गर्नेछौँ। केवल याहवेह तपाईंका परमेश्‍वर मोशासँग हुनुभएझैँ तपाईंसँग पनि हुनुभएको होस्।<verse eid="JOS 1:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 1:18"/>तपाईंको वचनको विरुद्ध विद्रोह गर्ने र तपाईंले आज्ञा गर्नुभएको कुरा पालन नगर्ने जोसुकै पनि मारिनेछ। केवल तपाईं बलियो र साहसी हुनुहोस्!”<verse eid="JOS 1:18"/></para>
<chapter eid="JOS 1"/>
<chapter number="2" style="c" sid="JOS 2"/>
<para style="p"><verse number="1" style="v" sid="JOS 2:1"/>तब नूनका छोरा यहोशूले शित्तीमबाट दुई मानिसलाई जासुसी गर्न यसो भन्दै गुप्‍तमा पठाए: “जाओ, र त्यस देशलाई हेर, विशेष गरी यरीहोलाई।” यसकारण तिनीहरू गए, र राहाब नाम भएकी एउटी वेश्याको घरमा गए, र त्यहीँ बास बसे।<verse eid="JOS 2:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 2:2"/>यरीहोको राजालाई यसो भनियो, “सुन्‍नुहोस्, आज राति यस देशको भेद लिन भनी केही इस्राएलीहरू यहाँ आएका छन्।”<verse eid="JOS 2:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 2:3"/>यसकारण यरीहोको राजाले राहाबकहाँ यो समाचार पठाए: “तँकहाँ आएर तेरो घरभित्र बसेका मानिसहरूलाई बाहिर निकालेर ले; किनकि तिनीहरू समस्त देशको भेद लिन आएका छन्।”<verse eid="JOS 2:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 2:4"/>तर त्यस स्त्रीले ती दुई पुरुषहरूलाई लुकाएकी थिई। त्यसले भनी, “हो, ती पुरुषहरू मकहाँ आएका थिए, तर तिनीहरू कहाँबाट आएका हुन् भन्‍ने कुरा मलाई थाहा भएन।<verse eid="JOS 2:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 2:5"/>साँझमा सहरको मूलढोका बन्द हुने समयमा ती मानिसहरू गइहाले। तिनीहरू कुन बाटो गए, सो म जान्दिनँ। तिनीहरूको पछि झट्टै जानुहोस्। सायद तपाईंहरूले तिनीहरूलाई भेट्टाउन सक्नुहुनेछ।”<verse eid="JOS 2:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 2:6"/>(तर जासुसहरूलाई त्यस स्त्रीले माथि कौसीमा लगेर आफूले मिलाएर राखेको सनपाटका डाँठहरूका थाकमुनि लुकाएकी थिई।)<verse eid="JOS 2:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 2:7"/>यसकारण ती मानिसहरू ती जासुसहरूलाई खोज्दै यर्दनको बाटोमा घाटहरूसम्म गए। अनि खोजी गर्दै जाने ती मानिसहरू जानसाथ मूलढोका बन्द भइहाल्यो।<verse eid="JOS 2:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 2:8"/>राति ती जासुसहरू सुत्नुभन्दा अगि त्यो स्त्री माथि कौसीमा गई।<verse eid="JOS 2:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 2:9"/>अनि जासुसहरूलाई भनी, “याहवेहले यो देश तपाईंहरूलाई दिनुभएको छ भनी म जान्दछु। अनि तपाईंहरूको भयङ्ककर डरले हामीलाई छोपेको छ। यसकारण देशमा बस्‍ने सबै मानिसहरू तपाईंहरूको कारण डरले भयभीत भएका छन्।<verse eid="JOS 2:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 2:10"/>तपाईंहरू इजिप्टबाट निस्केर आउँदा याहवेहले कसरी तपाईंहरूका निम्ति लाल समुद्रलाई सुकाइदिनुभयो; अनि यर्दनको पूर्वपट्टि तपाईंहरूले पूर्ण रूपमा नाश पार्नुभएका एमोरीहरूका दुवै राजाहरू, सीहोन र ओगलाई के गर्नुभयो भनी हामीले सुनेका छौँ।<verse eid="JOS 2:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 2:11"/>यो कुरा सुनेपछि तपाईंहरूको कारण हामी भयभीत भयौँ र हामी सबैको साहस हरायो; किनकि याहवेह तपाईंहरूका परमेश्‍वर, उहाँ नै माथि स्वर्गका र तल पृथ्वीका परमेश्‍वर हुनुहुन्छ।<verse eid="JOS 2:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 2:12"/>“यसकारण अब मलाई याहवेहको नाममा शपथ खानुहोस्। मैले तपाईंहरूप्रति देखाएको दयाको कारण तपाईंहरूले मेरो परिवारप्रति पनि दया देखाउनुहुनेछ। मलाई एउटा निश्‍चित चिन्ह दिनुहोस्,<verse eid="JOS 2:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 2:13"/>ताकि तपाईंहरूले मेरा बुबा, आमा, दाजुभाइ, दिदीबहिनीहरू र तिनीहरूका सबै परिवारका जनहरूका जीवनको रक्षा गरिदिनुहुनेछ, अर्थात् तपाईंहरूले हामीलाई मृत्युबाट बचाउनुहुनेछ।”<verse eid="JOS 2:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 2:14"/>ती जासुसहरूले तिनलाई यसरी सान्त्वना दिए, “तिमीहरूको प्राणको सट्टा हाम्रो प्राण। हामीले के गरिरहेका छौँ भनी तिमीले अरूलाई भनेनौ भने याहवेहले यो देश हामीलाई दिनुहुन्छ, तब हामी तिमीहरूप्रति दयालु हुनेछौँ र आफ्नो वचन पूरा गर्नेछौँ।”<verse eid="JOS 2:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 2:15"/>यसकारण त्यसले जासुसहरूलाई झ्यालबाट एउटा डोरीले तल ओह्राली; किनकि त्यो बसेकी घर सहरको पर्खालको एउटा भाग थियो।<verse eid="JOS 2:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 2:16"/>त्यो स्त्रीले तिनीहरूलाई भनी, “पहाडहरूतिर जानुहोस् र ती खोज्नेहरूले तपाईंहरूलाई भेट्टाउनेछैनन्। ती खोज्नेहरू फर्केर नआएसम्म तीन दिनसम्म त्यहीँ लुकिबस्‍नुहोस्। अनि मात्र आफ्नो बाटो लाग्नुहोस्।”<verse eid="JOS 2:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 2:17"/>ती मानिसहरूले त्यसलाई भने, “तिमीले हामीलाई खान लगाएको शपथ हामी पूरा गर्नेछौँ;<verse eid="JOS 2:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 2:18"/>जब हामी यस देशमा प्रवेश गर्छौँ, तब तिमीले हामीलाई निकालेको झ्यालमा यो रातो डोरी बाँधिराख्नू। तिमीले आफ्नो बुबाआमा, तिम्रो दाजुभाइहरू र सम्पूर्ण परिवारलाई तिम्रो घरभित्र ल्याउनू;<verse eid="JOS 2:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 2:19"/>तर यदि कोही तिम्रो घरबाट बाहिर सडकमा गयो र मर्‍यो भने त्यसको रगतको दोष त्यसकै शिरमा पर्नेछ; अनि हामी जिम्मेवार हुनेछैनौँ। तर तिमीसँग घरभित्र हुनेहरूमाथि कसैले हात लगायो भने त्यसको रगतको दोष हाम्रो शिरमा पर्नेछ।<verse eid="JOS 2:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 2:20"/>तर यदि हामीले के गर्दैछौँ, त्यो तिमीले बतायौ भने जुन शपथ तिमीले हामीलाई खान लगाएकी थियौ, सो शपथबाट हामी मुक्त हुनेछौँ।”<verse eid="JOS 2:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 2:21"/>त्यसले जवाफ दिई, “म राजी छु। तपाईंहरूले भन्‍नुभएअनुसार नै होस्।” यसरी त्यसले तिनीहरूलाई पठाइदिई, र तिनीहरू गइहाले। अनि त्यसले झ्यालमा एउटा रातो डोरी बाँधी।<verse eid="JOS 2:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 2:22"/>अनि तिनीहरू गए, र पहाडमा पुगे। तिनीहरू त्यहाँ तीन दिनसम्म बसे। तिनीहरूलाई खोज्नेहरूले बाटोहरूमा खोजी गरे; तर तिनीहरूलाई भेट्टाउन नसकेपछि फर्केर आए।<verse eid="JOS 2:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 2:23"/>अनि ती दुई मानिसहरू पहाडबाट ओर्ले, र नदी तरेर नूनका छोरा यहोशूकहाँ आए। अनि तिनीहरूमाथि आइपरेका सबै कुरा तिनलाई बताए।<verse eid="JOS 2:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 2:24"/>तिनीहरूले यहोशूलाई भने, “साँच्‍चै नै याहवेहले सम्पूर्ण देश हाम्रो हातमा दिनुभएको छ। सबै मानिसहरू हाम्रो कारण भयभीत भएका छन्।”<verse eid="JOS 2:24"/></para>
<chapter eid="JOS 2"/>
<chapter number="3" style="c" sid="JOS 3"/>
<para style="p"><verse number="1" style="v" sid="JOS 3:1"/>बिहान सबेरै यहोशू र सारा इस्राएलीहरू शित्तीम छाडेर यर्दनमा गए। अनि त्यहाँ तिनीहरूले नदी पार गर्न अगि छाउनी हालेर बास बसे।<verse eid="JOS 3:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 3:2"/>तीन दिनपछि अधिकृतहरू सबै छाउनीहरूमा गए।<verse eid="JOS 3:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 3:3"/>अनि मानिसहरूलाई यसरी आदेश दिए: “जब तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरको साक्षी पाटीको सन्दुक र लेवी पुजारीहरूले त्यसलाई बोकेका देखौला, तब तिमीहरू आ-आफ्ना ठाउँबाट हिँड्नू र त्यसको पछि-पछि लाग्नू।<verse eid="JOS 3:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 3:4"/>तब तिमीहरूले कता जानुपर्ने हो, सो जान्‍नेछौ; किनकि तिमीहरू पहिले कहिल्यै यो बाटोबाट भएर गएका छैनौ। तर तिमीहरू र सन्दुकको बीचमा दुई हजार क्यूबिटको दूरी राख्नू; अनि सन्दुकको नजिक नजानू।”<verse eid="JOS 3:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 3:5"/>यहोशूले मानिसहरूलाई भने, “तिमीहरूले आफूलाई पवित्र बनाओ; किनकि भोलि याहवेहले तिमीहरूका बीचमा अचम्मको काम गर्नुहुनेछ।”<verse eid="JOS 3:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 3:6"/>यहोशूले पुजारीहरूलाई भने, “साक्षी पाटीको सन्दुक लिएर मानिसहरूका अगि-अगि पारिपट्टि जाओ।” यसकारण तिनीहरूले सन्दुकलाई उठाए, र मानिसहरूका अगि-अगि हिँडे।<verse eid="JOS 3:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 3:7"/>अनि याहवेहले यहोशूलाई भन्‍नुभयो, “आज म तँलाई सबै इस्राएलीहरूका दृष्‍टिमा उच्‍च पार्नेछु। जसरी म मोशासँग थिएँ, त्यसरी नै तँसँग पनि छु भनी तिनीहरूले जानून्।<verse eid="JOS 3:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 3:8"/>साक्षी पाटीको सन्दुक बोक्ने पुजारीहरूलाई तैँले यस्तो आज्ञा दिनू: ‘जब तिमीहरू यर्दन नदीको किनारमा आइपुग्छौ, तब यर्दनको पानीमा जानू, र नदीमा खडा रहनू।’ ”<verse eid="JOS 3:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 3:9"/>यहोशूले इस्राएलीहरूलाई भने, “यता आओ, र याहवेह तिमीहरूका परमेश्‍वरको वचन सुन।<verse eid="JOS 3:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 3:10"/>जीवित परमेश्‍वर तिमीहरूका बीचमा हुनुहुन्छ भनी तिमीहरूले यसरी थाहा गर्नेछौ। उहाँले निश्‍चय नै तिमीहरूको अगिबाट कनानी, हित्ती, हिव्वी, परिज्जी, गिर्गाशी, एमोरी र यबूसीहरूलाई धपाउनुहुनेछ।<verse eid="JOS 3:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 3:11"/>हेर, समस्त पृथ्वीका याहवेहको साक्षी पाटीको सन्दुक तिमीहरूका अगि-अगि यर्दनमा जानेछ।<verse eid="JOS 3:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 3:12"/>अब इस्राएलको हरेक कुलबाट एक-एक जना गरी बाह्र जना पुरुषहरू छान।<verse eid="JOS 3:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 3:13"/>अनि जब समस्त पृथ्वीका प्रभु याहवेहको सन्दुक बोक्ने पुजारीहरूका खुट्टाले यर्दनमा टेक्नेछन्, तब बग्दै गरेको पानी रोकिनेछ, र एक थुप्रो भई खडा हुनेछ।”<verse eid="JOS 3:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 3:14"/>यसकारण जब यर्दन तर्न भनी मानिसहरूले छाउनी भत्काए, तब साक्षी पाटीको सन्दुक बोक्ने पुजारीहरू तिनीहरूका अगि-अगि गए।<verse eid="JOS 3:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 3:15"/>त्यो समय अन्‍नको कटनीको समय थियो। यो समय यर्दनचाहिँ पानीले भरिएको थियो। तापनि करारको सन्दुक बोक्ने पुजारीहरू यर्दन नदीमा पुगेर तिनीहरूका खुट्टाले पानीको किनार छुनेबित्तिकै,<verse eid="JOS 3:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 3:16"/>माथिबाट तल बगेर आउने पानी बग्न छोड्यो। त्यो पानी धेरै टाढा सार्तानको नजिक आदम भनिने सहरनिर एक थुप्रो भई जम्मा भयो। अनि अराबा समुद्रतिर (अर्थात् मृत सागर) जाने ओरालोमा बग्दै गरेको पानीचाहिँ पूर्ण रूपले सुक्यो। यसरी मानिसहरू यरीहो नदीको अर्कोपट्टि पारि तरे।<verse eid="JOS 3:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 3:17"/>सबै इस्राएलीहरू सुक्खा जमिनबाट हिँडे, र सम्पूर्ण मानिसहरू नदी पार नगरुन्जेल याहवेहको करारको सन्दुक बोक्ने पुजारीहरू यर्दन नदीको बीचमा सुक्खा जमिनमा उभिरहे।<verse eid="JOS 3:17"/></para>
<chapter eid="JOS 3"/>
<chapter number="4" style="c" sid="JOS 4"/>
<para style="p"><verse number="1" style="v" sid="JOS 4:1"/>जब सम्पूर्ण मानिसहरूले यर्दन नदी पार गरिसके, तब याहवेहले यहोशूलाई भन्‍नुभयो,<verse eid="JOS 4:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 4:2"/>“प्रत्येक कुलबाट एक-एक जना गरी बाह्र जना मानिसहरू छान्।<verse eid="JOS 4:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 4:3"/>अनि तिनीहरूलाई यर्दनको बीचबाट ती पुजारीहरू उभिएकै ठाउँबाट बाह्र वटा ढुङ्गाहरू ल्याउन लगाउनू। अनि ती ढुङ्गाहरूलाई तैँले लगेर आज राति तिमीहरू बस्‍ने ठाउँमा राख्नू।”<verse eid="JOS 4:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 4:4"/>यसकारण यहोशूले इस्राएली कुलबाट एक-एक जना गरी तिनले नियुक्त गरेका बाह्र जना मानिसहरूलाई बोलाए।<verse eid="JOS 4:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 4:5"/>अनि तिनीहरूलाई भने, “याहवेह तिमीहरूका परमेश्‍वरको सन्दुकको अगाडि यर्दन नदीको बीचमा जाओ। तिमीहरू हरेकले इस्राएलका कुलहरूको संख्याअनुसार एक-एक वटा ढुङ्गा काँधमा बोकेर ल्याओ।<verse eid="JOS 4:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 4:6"/>यो तिमीहरूका बीचमा एउटा सम्झनाको रूपमा रहोस्।” भविष्यमा जब तिमीहरूका छोराछोरीहरूले “यी ढुङ्गाहरूको अर्थ के हो?” भनेर सोध्लान्,<verse eid="JOS 4:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 4:7"/>तब तिनीहरूलाई यसो भन्‍नू, “याहवेहको करारको सन्दुकको सामु बग्दै गरेको यर्दनको पानी रोकिएको थियो। याहवेहको करारको सन्दुक बोकेर पुजारीहरूले यर्दन पार गर्दा पानी रोकिएको थियो। यी ढुङ्गाहरू इस्राएलका मानिसहरूका निम्ति सधैँको लागि स्मारकको रूपमा रहनेछन्।”<verse eid="JOS 4:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 4:8"/>यसकारण यहोशूले इस्राएलीहरूलाई आज्ञा गरेझैँ तिनीहरूले गरे। याहवेहले यहोशूलाई आज्ञा गर्नुभएअनुसार तिनीहरूले इस्राएलका कुलहरूको संख्याअनुसार यर्दनको बीचबाट बाह्र वटा ढुङ्गाहरू बोकेर ल्याए। अनि तिनीहरूले ती ढुङ्गाहरू आफ्ना छाउनीसम्म आफूसँग बोकेर लगे; र त्यहाँ छाउनीमा राखे।<verse eid="JOS 4:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 4:9"/>करारको सन्दुक बोक्ने पुजारीहरू उभिएको जमिन यर्दनको बीचबाट ल्याइएका ढुङ्गाहरूलाई यहोशूले खडा गरे। अनि ती ढुङ्गाहरू आजको दिनसम्म त्यहीँ छँदैछन्।<verse eid="JOS 4:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 4:10"/>याहवेहले यहोशूलाई आज्ञा दिनुभएझैँ मानिसहरूले नगरुन्जेल, सन्दुक बोक्ने पुजारीहरू यर्दनको बीचमा उभिरहे। मोशाले पनि यहोशूलाई त्यस्तै निर्देशन दिएका थिए। अनि मानिसहरूले हतार-हतार गरेर नदी पार गरे।<verse eid="JOS 4:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 4:11"/>अनि तिनीहरू सबै जना नदी पार गरिसकेपछि मानिसहरूले हेरिरहेकै बेला याहवेहको सन्दुक र पुजारीहरू नदीको अर्कोपट्टि आए।<verse eid="JOS 4:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 4:12"/>मोशाले तिनीहरूलाई निर्देशन दिएझैँ रूबेन, गादका र मनश्शेको आधा कुलका मानिसहरू, लडाइँका निम्ति हतियार लिएर अरू इस्राएलीहरूको अगि नदी तरेर गए।<verse eid="JOS 4:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 4:13"/>युद्धका निम्ति हतियार भिरेका लगभग चालीस हजार मानिसहरू पार भएर याहवेहको सामु यरीहोको मैदानतिर लडाइँका निम्ति गए।<verse eid="JOS 4:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 4:14"/>त्यस दिन याहवेहले यहोशूलाई इस्राएलको नजरमा उच्‍च पार्नुभयो। अनि तिनीहरूले मोशाको आदर गरेझैँ, तिनको जीवनकालभरि तिनको पनि आदर गरे।<verse eid="JOS 4:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 4:15"/>तब याहवेहले यहोशूलाई भन्‍नुभयो,<verse eid="JOS 4:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 4:16"/>“साक्षी पाटीको सन्दुक बोक्ने पुजारीहरूलाई यर्दनबाट निस्केर माथि आउनू भनी आज्ञा गर्।”<verse eid="JOS 4:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 4:17"/>यसकारण यहोशूले पुजारीहरूलाई, “यर्दनबाट निक्लेर माथि आओ” भनी आज्ञा गरे।<verse eid="JOS 4:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 4:18"/>अनि पुजारीहरू याहवेहको करारको सन्दुक बोकेर नदीबाट बाहिर निक्लेर आए। तिनीहरूका पाइलाले सुक्खा भूमिमा टेक्ने बित्तिकै यर्दनको पानी आफ्नो ठाउँमा फर्केर आयो र पहिलेझैँ भरिएर बग्न थाल्यो।<verse eid="JOS 4:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 4:19"/>पहिलो महिनाको दशौँ दिनमा मानिसहरू यर्दनबाट उक्लेर गए, र यरीहोको पूर्वीय सिमाना गिलगालमा छाउनी हाले।<verse eid="JOS 4:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 4:20"/>अनि यहोशूले यर्दनबाट तिनीहरूले ल्याएका बाह्र वटा ढुङ्गाहरूलाई गिलगालमा खडा गरे।<verse eid="JOS 4:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 4:21"/>तिनले इस्राएलीहरूलाई भने, “भविष्यमा तिमीहरूका बालबच्‍चाहरूले आफ्ना आमाबुबालाई, ‘यी ढुङ्गाहरूको अर्थ के हो?’ भनेर जब सोध्लान्,<verse eid="JOS 4:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 4:22"/>तब तिनीहरूलाई यसो भन्‍नू, ‘इस्राएलीहरूले सुक्खा जमिनबाट यर्दन नदी तरेका थिए।’<verse eid="JOS 4:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 4:23"/>किनकि याहवेह तिमीहरूका परमेश्‍वरले यर्दन नदीलाई हामीहरूले पार नगरुन्जेल सुकाउनुभयो। हामीले लाल समुद्रपार नगरेसम्म याहवेह तिमीहरूका परमेश्‍वरले जसरी लाल समुद्रलाई सुकाउनुभयो, त्यसरी नै उहाँले यर्दनलाई पनि सुकाउनुभयो।<verse eid="JOS 4:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 4:24"/>उहाँले यसो गर्नुभयो; ताकि सारा पृथ्वीका मानिसहरूले याहवेहका हात शक्तिशाली छन् भनी जानून्। त्यसरी नै तिमीहरूले पनि याहवेह तिमीहरूका परमेश्‍वरको भय सधैँ मान।”<verse eid="JOS 4:24"/></para>
<chapter eid="JOS 4"/>
<chapter number="5" style="c" sid="JOS 5"/>
<para style="p"><verse number="1" style="v" sid="JOS 5:1"/>अनि जब यर्दनको पश्‍चिमतिर भएका एमोरी राजाहरू र भूमध्य सागरको नजिकका सबै कनानी राजाहरूले, हामीले यर्दन पार नगरेसम्म याहवेहले यर्दनलाई इस्राएलीहरूका अगि कसरी सुकाइदिनुभएको थियो भन्‍ने कुरा सुने, तब तिनीहरूको हृदय डरले हतोत्साहित भयो। अनि तिनीहरूमा इस्राएलीहरूको सामना गर्ने साहस नै रहेन।<verse eid="JOS 5:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 5:2"/>त्यस बेला याहवेहले यहोशूलाई भन्‍नुभयो, “दर्शन-ढुङ्गाका कर्दहरू बनाएर इस्राएलीहरूलाई फेरि खतना गर्।”<verse eid="JOS 5:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 5:3"/>यसकारण यहोशूले दर्शन-ढुङ्गाका कर्दहरू बनाए। अनि इस्राएलीहरूलाई गिबियथ-हारालोथमा खतना गरे।<verse eid="JOS 5:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 5:4"/>तिनले खतना गर्नुको कारण यो थियो: इजिप्टबाट निस्किएर आएका लडाइँमा जान सक्ने उमेर भएका सबै मानिसहरू, इजिप्ट छोडेपछि उजाडस्थानको बाटैमा मरिसकेका थिए।<verse eid="JOS 5:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 5:5"/>इजिप्टबाट निस्किआएका सबै पुरुषहरूका खतना भइसकेको थियो। तर इजिप्टबाट निस्किएर आएपछि उजाडस्थानको यात्रामा जन्मेका सबै मानिसहरूको चाहिँ खतना भएको थिएन।<verse eid="JOS 5:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 5:6"/>इजिप्ट छोड्दा लडाइँमा जान सक्ने उमेर भएका सबै पुरुषहरूको मृत्यु नभएसम्म इस्राएलीहरू चालीस वर्षसम्म उजाडस्थानमा डुलिरहे। किनकि तिनीहरूले याहवेहको आज्ञापालन गरेका थिएनन्। किनभने तिनीहरूका पितापुर्खाहरूसँग शपथ खाएर दूध र मह बग्ने देश हामीलाई दिनेछु भनी प्रतिज्ञा गर्नुभएको देश तिनीहरूले देख्न पाउनेछैनन् भनी उहाँले तिनीहरूसँग शपथ खानुभएको थियो।<verse eid="JOS 5:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 5:7"/>यसकारण उहाँले तिनीहरूको स्थानमा तिनीहरूका छोराहरूलाई खडा गर्नुभयो र यहोशूले तिनीहरूको खतना गरे। किनकि तिनीहरूलाई यात्राको बेला खतना गरिएको थिएन।<verse eid="JOS 5:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 5:8"/>अनि सम्पूर्ण पुरुषहरूको खतना भइसकेपछि तिनीहरू निको नभएसम्म आ-आफ्ना छाउनीमै बसे।<verse eid="JOS 5:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 5:9"/>तब याहवेहले यहोशूलाई भन्‍नुभयो, “आज मैले तिमीहरूबाट इजिप्टको अपमान मेटाइदिएको छु।” यसकारण आजको दिनसम्म नै त्यस ठाउँलाई गिलगाल भनिन्छ।<verse eid="JOS 5:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 5:10"/>त्यस महिनाको चौधौँ दिनको साँझपख यरीहोको मैदान गिलगालमा छाउनी लगाएको बेला इस्राएलीहरूले निस्तार चाड मनाए।<verse eid="JOS 5:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 5:11"/>निस्तार चाडको भोलिपल्ट ठिक त्यही दिन तिनीहरूले त्यस कनान देशको उब्जनीबाट खमिर नहालेको रोटी र भुटेको अन्‍न खाए।<verse eid="JOS 5:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 5:12"/>तिनीहरूले त्यस देशको अन्‍न खाएकै दिनदेखि मन्‍न खस्‍न रोकियो; तब इस्राएलीहरूका निम्ति त्यहाँ मन्‍न थिएन, तर त्यस वर्ष तिनीहरूले कनान देशको उब्जनी खाए।<verse eid="JOS 5:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 5:13"/>अब यहोशू यरीहोको नजिक हुँदा तिनले माथि हेरे। अनि तिनले आफ्नो सामु एक जना मानिसलाई हातमा नाङ्गो तरवार लिएर उभिरहेका देखे। यहोशू तिनीकहाँ गएर सोधे, “तपाईं हाम्रो पक्षमा हुनुहुन्छ कि हाम्रा शत्रुहरूको पक्षमा हुनुहुन्छ?”<verse eid="JOS 5:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 5:14"/>तिनले जवाफ दिए, “कसैको पक्षमा पनि होइन। तर म अहिले याहवेहको फौजको सेनापति भएर आएको छु।” तब यहोशू भुइँमा घोप्टो परेर दण्डवत् गर्दै सोधे, “मेरा प्रभु, आफ्नो सेवकका निम्ति के सन्देश छ?”<verse eid="JOS 5:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 5:15"/>तब याहवेहको फौजका सेनापतिले भने, “तेरो जुत्ता फुकाल्। किनकि तँ उभिएको ठाउँ पवित्र छ।” अनि यहोशूले त्यसै गरे।<verse eid="JOS 5:15"/></para>
<chapter eid="JOS 5"/>
<chapter number="6" style="c" sid="JOS 6"/>
<para style="p"><verse number="1" style="v" sid="JOS 6:1"/>इस्राएलीहरूको कारण यरीहोका मूलढोकाहरू पूर्णतया बन्द गरिएको थियो। कोही पनि भित्र पस्‍न वा बाहिर निस्की आउन सक्दैनथ्यो।<verse eid="JOS 6:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 6:2"/>तब याहवेहले यहोशूलाई भन्‍नुभयो, “हेर्, मैले यरीहो, यसकासाथै त्यसका राजा र त्यसका योद्धाहरूसमेत तेरो हातमा सुम्पिदिएको छु।<verse eid="JOS 6:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 6:3"/>सबै हतियारधारी मानिसहरूसँग त्यस सहरलाई दिनमा एक चोटि फन्को मार्नू। छ दिनसम्म तिमीहरूले यसै गर्नू।<verse eid="JOS 6:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 6:4"/>सन्दुकको सामु भेडाका सिङको तुरही लिएका सात जना पुजारीहरू अगि-अगि हिँडून्। सातौँ दिनमा चाहिँ पुजारीहरूले तुरही फुक्दै सहरको चारैतिर सात चोटि फन्को मारून्।<verse eid="JOS 6:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 6:5"/>जब तिमीहरूले लामो समयसम्म तुरही फुकेको आवाज सुन्छौ, तब सबै योद्धाहरू चर्को सोरले कराऊन्; र सहरको पर्खाल ढल्नेछ। अनि सेनाहरू र हरेक मानिसहरू सीधै सहरभित्र बढेर जाऊन्।”<verse eid="JOS 6:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 6:6"/>यसकारण नूनका छोरा यहोशूले पुजारीहरूलाई बोलाएर तिनीहरूलाई भने, “याहवेहको करारको सन्दुक लिएर सात जना पुजारीहरू सन्दुकको अगि-अगि तुरही बोकेर हिँड्नू।”<verse eid="JOS 6:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 6:7"/>अनि तिनले योद्धाहरूलाई आदेश दिए, “अगि बढ, सहरको चारैतिर हिँड, र हतियारधारी मानिसहरूचाहिँ याहवेहको सन्दुकको अगि-अगि हिँडून्।”<verse eid="JOS 6:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 6:8"/>जब यहोशूले मानिसहरूसँग कुरा गरिसके, तब याहवेहको अगाडि सात वटा तुरही बोक्ने सात जना पुजारीहरू तुरही बजाउँदै अगि बढेर गए। अनि याहवेहको करारको सन्दुकचाहिँ उनीहरूको पछि-पछि थियो।<verse eid="JOS 6:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 6:9"/>हतियारधारी योद्धाहरू तुरही फुक्ने पुजारीहरूका अगि-अगि गए। अनि रक्षकहरूचाहिँ सन्दुकको पछि-पछि हिँडे। यस समयमा तुरहीहरू बजिरहेका थिए।<verse eid="JOS 6:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 6:10"/>तर यहोशूले योद्धाहरूलाई यसो भनी आज्ञा दिएका थिए, “मैले तिमीहरूलाई जोरसँग कराउने आज्ञा नदिएसम्म तिमीहरू नकराउनू। तिमीहरूले आवाज ननिकाल्नू। एक शब्द पनि नबोल्नू। त्यसपछि कराउनू!”<verse eid="JOS 6:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 6:11"/>यसरी तिनले याहवेहको सन्दुकलाई बोकाएर एक पल्ट सहरको फन्को मार्न लगाए। त्यसपछि योद्धाहरू छाउनीमा फर्किआए, र त्यहीँ रात बिताए।<verse eid="JOS 6:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 6:12"/>भोलिपल्ट यहोशू बिहानै उठे, र पुजारीहरूले याहवेहको सन्दुक उठाए।<verse eid="JOS 6:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 6:13"/>सात वटा तुरही बोक्ने सात जना पुजारीहरू याहवेहको सन्दुकको अगि-अगि तुरही फुक्दै हिँडे। हतियारधारी योद्धाहरू तिनीहरूका अगि-अगि गए। अनि पछिल्तिरका रक्षकहरू याहवेहको सन्दुकको पछि-पछि हिँडे। त्यति बेला तुरही बजिरहेको थियो।<verse eid="JOS 6:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 6:14"/>यसरी दोस्रो दिन तिनीहरूले सहरको फन्को मारे, र छाउनीमा फर्के। तिनीहरूले यसरी नै छ दिनसम्म फन्को मारे।<verse eid="JOS 6:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 6:15"/>सातौँ दिनमा तिनीहरू एकाबिहानै उठे। अनि अगाडिका दिनहरूमा जस्तै सहरलाई फन्को मारे। तर तिनीहरूले त्यस दिनचाहिँ सात चोटि सहरलाई फन्को मारे।<verse eid="JOS 6:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 6:16"/>सातौँ पटकमा जब पुजारीहरूले तुरही फुके, तब यहोशूले मानिसहरूलाई यसरी आज्ञा दिए, “कराओ, किनभने याहवेहले यो सहर तिमीहरूलाई दिनुभएको छ।<verse eid="JOS 6:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 6:17"/>यो सहर र यसमा भएका सबै कुराहरू याहवेहलाई अर्पण गर्नुपर्छ। केवल राहाब वेश्या र उनका घरमा भएका सबै जना मात्र जीवित छोडिनेछन्। किनकि हामीले पठाएका जासुसहरूलाई तिनले लुकाएकी थिइन्।<verse eid="JOS 6:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 6:18"/>तर तिमीहरू अर्पण गरिएका थोकहरूबाट अलग रहनू, ताकि तिमीहरूले ती अर्पित थोकहरूबाट केही लिएर आफूमाथि विपत्ति नल्याओ। नत्रता तिमीहरूले इस्राएलका छाउनीहरूलाई नाश हुने बनाएर त्यसमाथि विपत्ति ल्याउनेछौ।<verse eid="JOS 6:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 6:19"/>सबै सुन, चाँदी अनि काँसो र फलामका चीजहरू याहवेहका निम्ति पवित्र छन्, र ती वस्तुहरू उहाँको भण्डारमा ल्याउनुपर्छ।”<verse eid="JOS 6:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 6:20"/>तुरहीको आवाज बजेपछि योद्धाहरू कराए। अनि जब मानिसहरू तुरहीको आवाज सुनेर चर्को सोरमा कराए, तब पर्खाल भत्कियो। यसरी सारा मानिस सीधै भित्र पसे, र तिनीहरूले त्यस सहरलाई कब्जा गरे।<verse eid="JOS 6:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 6:21"/>तिनीहरूले सहरलाई याहवेहकहाँ अर्पण गरे। अनि त्यहाँ भएका हरेक जीवितहरूलाई अर्थात् पुरुष र स्त्रीहरू, जवान र वृद्धहरू, गाईबस्तु, भेडाबाख्रा र गधाहरू सबैलाई तरवारले नाश गरिदिए।<verse eid="JOS 6:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 6:22"/>त्यस देशको भेद लिन जाने दुई जना मानिसहरूलाई चाहिँ यहोशूले भने, “त्यस वेश्याको घरमा जाओ, र तिमीहरूले तिनीसँग शपथ खाएअनुसार त्यस स्त्री र तिनीसँग भएका सबै मानिसहरूलाई बाहिर निकाल।”<verse eid="JOS 6:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 6:23"/>यसकारण भेद लिन जाने ती दुई जवान मानिसहरू भित्र गए; अनि राहाब, तिनका आमाबुबा र दाजुभाइहरू अनि तिनका सबै मानिसहरूलाई बाहिर निकालेर ल्याए। तिनीहरूले तिनको सम्पूर्ण परिवारलाई बाहिर निकाले; र इस्राएलको छाउनीबाहिर एक ठाउँमा राखे।<verse eid="JOS 6:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 6:24"/>त्यसपछि तिनीहरूले सम्पूर्ण सहर र त्यस सहरमा भएका हरेक कुरालाई जलाइदिए। तर तिनीहरूले सुन, चाँदी, काँसो र फलामका चीजहरू याहवेहको भवनको भण्डारमा राखे।<verse eid="JOS 6:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 6:25"/>तर यहोशूले वेश्या राहाब र तिनका परिवार अनि तिनीसँग भएका सबैलाई छोडिदिए। किनकि तिनले यरीहोमा जासुसी गर्न पठाएका मानिसहरूलाई लुकाएकी थिइन्। अनि तिनका सन्तानहरू आजको दिनसम्म पनि इस्राएलीहरूको बीचमा बास गरेका छन्।<verse eid="JOS 6:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 6:26"/>त्यस बेला यहोशूले यो गम्भीर शपथ खाए: “जसले यो यरीहो सहरलाई पुनर्निर्माण गर्ने जिम्मा लिन्छ, त्यो मानिस याहवेहको सामु श्रापित होस्: “त्यसले यसको जग बसाल्दा, त्यसको जेठो छोरा मर्नेछ; यसका मूलढोकाहरू बनाउँदा, त्यसको कान्छा छोरा मर्नेछ।”<verse eid="JOS 6:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 6:27"/>यसरी यहोशूसँग याहवेह हुनुहुन्थ्यो, र तिनको कीर्ति देशभरि फैलियो।<verse eid="JOS 6:27"/></para>
<chapter eid="JOS 6"/>
<chapter number="7" style="c" sid="JOS 7"/>
<para style="p"><verse number="1" style="v" sid="JOS 7:1"/>तर अर्पण गरिएका चीजहरूको, विषयमा इस्राएलीहरू विश्‍वासयोग्य भएनन्। यहूदा कुलको जेरहको छोरा जब्दी जब्दीको छोरा कर्मी, कर्मीको छोरा आकानले ती अर्पण गरिएका चीजहरूबाट केही कुरा लियो। यसकारण याहवेहको क्रोध इस्राएलीहरूमाथि दन्कियो।<verse eid="JOS 7:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 7:2"/>यहोशूले बेथेलको पूर्वपट्टिको बेथ-आवेनको नजिक भएको ऐ सहरमा यरीहोबाट मानिसहरू पठाएर तिनीहरूलाई भने, “तिमीहरू माथि गएर त्यस इलाकाको भेद लेओ।” यसकारण ती मानिसहरू गए, र ऐ सहरको भेद लिए।<verse eid="JOS 7:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 7:3"/>जब तिनीहरू यहोशूकहाँ फर्केर आए, तब तिनीहरूले भने, “ऐ सहरको विरुद्धमा सबै मानिसहरू नजाऊन्। त्यसलाई कब्जा गर्न दुई वा तीन हजार मानिसहरू पठाउनुहोस्। सबै मानिसहरू जाने कष्‍ट नदिनुहोस्; किनकि त्यहाँ थोरै मात्र मानिसहरू बस्दछन्।”<verse eid="JOS 7:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 7:4"/>यसकारण करिब तीन हजार मानिसहरू मात्र माथि गए; तर तिनीहरू ऐ सहरका मानिसहरूद्वारा पराजित भए।<verse eid="JOS 7:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 7:5"/>तिनीहरूले लगभग छत्तीस जना इस्राएलीहरूलाई मारे। तिनीहरूले इस्राएलीहरूलाई सहरको मूलढोकादेखि शबारीमसम्म लखेटे, र ओरालोमा तिनीहरूलाई हराए। यो देखेर मानिसहरूको हृदय डरले गलेर पानीजस्तै भयो।<verse eid="JOS 7:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 7:6"/>तब यहोशूले आफ्नो वस्त्र च्याते। अनि याहवेहको सन्दुकको सामु भुइँमा घोप्टो परेर लडे। अनि साँझसम्म त्यहीँ रहिरहे। इस्राएलका प्रधानहरूले पनि त्यसै गरेर तिनीहरूका शिरहरूमा धुलो छर्के।<verse eid="JOS 7:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 7:7"/>अनि यहोशूले भने, “हाय, प्रभु याहवेह! तपाईंले यी मानिसहरूलाई एमोरीहरूको हातमा सुम्पिदिएर नष्‍ट पार्नलाई किन यर्दन पार गराएर ल्याउनुभयो? बरु हामी यर्दनको पारिपट्टि नै सन्तोष गरेर बसेको भए वेश हुनेथियो!<verse eid="JOS 7:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 7:8"/>हे प्रभु, अब म के भनूँ, अहिले इस्राएल आफ्ना शत्रुहरूद्वारा पराजित भएको छ?<verse eid="JOS 7:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 7:9"/>कनानी र यस देशका अरू मानिसहरूले यसबारे सुन्‍नेछन्, र तिनीहरूले हामीलाई चारैतिरबाट घेरेर पृथ्वीबाट हाम्रो नामनिशानै मेटिदिनेछन्। अनि त्यस बेला आफ्नो महान् नामको खातिर तपाईंले के गर्नुहुनेछ?”<verse eid="JOS 7:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 7:10"/>याहवेहले यहोशूलाई भन्‍नुभयो, “उठ्! तँ किन यसरी घोप्टो परेर भुइँमा लडिरहेको छस्?”<verse eid="JOS 7:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 7:11"/>इस्राएलले पाप गरेको छ। मैले तिनीहरूलाई पालन गर्न दिएको करार भङ्ग गरेका छन्। तिनीहरूले अर्पण गरिएका चीजहरूबाट केही लिएका छन्। तिनीहरूले चोरेका छन्। तिनीहरूले झूट बोलेका छन्। तिनीहरूले ती चीजहरू आफ्नै मालसामानसँग राखेका छन्।<verse eid="JOS 7:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 7:12"/>त्यसैकारण इस्राएलीहरू आफ्ना शत्रुहरूको विरुद्धमा खडा रहन सक्दैनन्। तिनीहरू पिठिउँ फर्काएर भाग्छन्; किनकि तिनीहरूले आफूलाई सर्वनाशको योग्य बनाएका छन्। तिमीहरूले आफ्ना बीचबाट नष्‍ट हुनका निम्ति अर्पण गरिएका चीजहरूलाई नष्‍ट नगरेसम्म म अब उसो तिमीहरूसँग रहनेछैन।<verse eid="JOS 7:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 7:13"/>“उठ्, गएर मानिसहरूलाई शुद्ध पार्! तिनीहरूलाई भन्, ‘भोलिको दिनको तयारीका निम्ति आफूलाई शुद्ध बनाओ’; किनकि याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: हे इस्राएल, तिमीहरूको बीचमा अर्पण गरिएको चीज छ। तिमीहरूले त्यसलाई नहटाएसम्म तिमीहरू आफ्ना शत्रुहरूको विरुद्धमा खडा रहन सक्दैनौ।<verse eid="JOS 7:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 7:14"/>“ ‘यसकारण बिहानै तिमीहरूले कुल-कुलअनुसार आफूलाई प्रस्तुत गर। याहवेहले छान्‍नुभएको कुल वंश-वंश गरी अगाडि आओस्। याहवेहले छान्‍नुभएको वंश परिवार-परिवार गरी अगाडि आओस्; अनि याहवेहले छान्‍नुभएको परिवार एक-एक जना गरी अगाडि आओस्।<verse eid="JOS 7:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 7:15"/>अर्पण गरिएका चीजहरूसँग पक्राउ पर्ने व्यक्ति, त्यससँग भएका सबै थोकसँगै आगोद्वारा नष्‍ट पारियोस्। त्यसले याहवेहको करार भङ्ग गरेको छ; र इस्राएलमा घृणित काम गरेको छ!’ ”<verse eid="JOS 7:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 7:16"/>भोलिपल्ट बिहानै यहोशूले इस्राएललाई कुलअनुसार अगाडि आउन लगाए; अनि यहूदा छानिए।<verse eid="JOS 7:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 7:17"/>तब यहूदाका सबै कुलहरू अगाडि आए, र जेरहको वंशहरू छानिए। तिनले जेरहका वंशहरूलाई परिवार-परिवार गरी अगि आउन लगाए, र जब्दी छानिए।<verse eid="JOS 7:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 7:18"/>यहोशूले त्यसको परिवारलाई एक-एक गरी अगि आउन लगाए। अनि यहूदाको कुलको जेरहका छोरा जब्दी, त्यसका छोरा कर्मी र कर्मीका छोरा आकान पक्राउ पर्‍यो।<verse eid="JOS 7:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 7:19"/>तब यहोशूले आकानलाई भने, “हे मेरो छोरा, याहवेह इस्राएलका परमेश्‍वरलाई महिमा दे, र उहाँको कदर गर्। तैँले जे गरिस्, त्यो मलाई भन्; मदेखि त्यो कुरा नलुका।”<verse eid="JOS 7:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 7:20"/>आकानले जवाफ दियो, “यो कुरा सत्य हो! मैले याहवेह इस्राएलका परमेश्‍वरको विरुद्धमा पाप गरेको छु। मैले गरेको अपराध यही हो:<verse eid="JOS 7:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 7:21"/>लुटको मालमा जब मैले बेबिलोनबाटको एउटा सुन्दर लवेदा, दुई सय सेकेलको चाँदी र पचास सेकेलको सुनको टुक्रा देखेँ, तब मलाई लोभ लाग्यो र मैले ती लिएँ। ती मेरो पालभित्र जमिनमुनि गाडिएका छन्। अनि चाँदीचाहिँ सबैभन्दा मुनि छ।”<verse eid="JOS 7:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 7:22"/>यसकारण यहोशूले दूतहरू पठाए। अनि तिनीहरू दगुरेर पालमा गए। अनि त्यस पालभित्र ती लुकाइराखिएका थिए। चाँदीचाहिँ सबैभन्दा मुनि भेट्टाए।<verse eid="JOS 7:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 7:23"/>तिनीहरूले पालबाट ती चीजहरू लिएर यहोशू र सारा इस्राएलीहरूकहाँ ल्याए। अनि ती याहवेहको अगि राखिदिए।<verse eid="JOS 7:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 7:24"/>तब यहोशू र सारा इस्राएलीहरू मिलेर जेरहको छोरा आकान, त्यससँग भएको चाँदी, लवेदा, सुनको टुक्रा, त्यसका छोराछोरीहरू, त्यसका गाईबस्तु, गधाहरू र भेडाहरू, त्यसका पाल र त्यसका सबै चीजहरूलाई आकोरको बेँसीमा ल्याए।<verse eid="JOS 7:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 7:25"/>अनि यहोशूले भने, “तैँले यो विपत्ति हामीमाथि किन ल्याइस्? याहवेहले आज तँमाथि विपत्ति ल्याउनुहुनेछ।” त्यसपछि सारा इस्राएलीहरूले त्यसलाई ढुङ्गाले हाने। अनि तिनीहरूले अरू बाँकी रहेकाहरूलाई पनि ढुङ्गाले हानेर तिनीहरूलाई जलाइदिए।<verse eid="JOS 7:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 7:26"/>तिनीहरूले आकानमाथि पत्थरहरूको थुप्रो लगाए, जुन आजको दिनसम्मै छँदैछ। त्यसपछि याहवेहको भयानक क्रोध शान्त भयो। यसकारण त्यस दिनदेखि त्यस ठाउँलाई आकोरको बेँसी भनिन्छ।<verse eid="JOS 7:26"/></para>
<chapter eid="JOS 7"/>
<chapter number="8" style="c" sid="JOS 8"/>
<para style="p"><verse number="1" style="v" sid="JOS 8:1"/>तब याहवेहले यहोशूलाई भन्‍नुभयो, “नडरा, निराश नहो। आफ्नो साथमा सम्पूर्ण सेनाहरू लिएर जा अनि ऐ सहरमाथि आक्रमण गर। किनकि मैले ऐको राजा, त्यसका मानिसहरू, त्यसको सहर र त्यसको देशलाई तेरो हातमा सुम्पिदिएको छु।<verse eid="JOS 8:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 8:2"/>तैँले ऐ र त्यसको राजासँग त्यस्तै गर्नू, जुन तैँले यरीहो र त्यसको राजासँग गरेको थिइस्। तर तैँले त्यहाँको लुटको माल र गाईबस्तु भने आफ्ना लागि ल्याउन सक्छस्। तैँले सहरको पछिल्तिर ढुकेर बस्‍नू।”<verse eid="JOS 8:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 8:3"/>यसकारण यहोशू र सम्पूर्ण फौज ऐमाथि आक्रमण गर्न निस्के। तिनले आफ्ना उत्तम लडाकुहरूबाट तीस हजारलाई छानेर तिनीहरूलाई राति नै पठाए।<verse eid="JOS 8:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 8:4"/>अनि तिनले यसरी आज्ञा गरे: “ध्यान दिएर सुन। तिमीहरू सहरको पछिल्तिर ढुकेर बस्‍नू। त्यहाँबाट धेरै टाढा नजानू। तिमीहरू सबै जना चनाखो भएर रहनू।<verse eid="JOS 8:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 8:5"/>म र मसँग भएका सबै मानिसहरू सहरतिर बढ्नेछौँ। अनि पहिलेझैँ, जब तिनीहरू हाम्रो विरुद्धमा निस्केर आउँछन्। हामी तिनीहरूदेखि भाग्नेछौँ।<verse eid="JOS 8:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 8:6"/>तिनीहरूले हामीलाई खेद्नेछन्। अनि तिनीहरूलाई सहरदेखि टाढा नपुर्‍याएसम्म हामी भागिरहने छौँ। तब तिनीहरूले सोच्नेछन्, ‘पहिलेझैँ तिनीहरू हामीदेखि भागिरहेका छन्।’ यसरी जब हामी तिनीहरूदेखि भाग्नेछौँ,<verse eid="JOS 8:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 8:7"/>तिमीहरूले ढुकेर बसेको ठाउँबाट निस्केर सहरलाई कब्जा गर्नू। याहवेह तिमीहरूका परमेश्‍वरले त्यो तिमीहरूको हातमा दिनुहुनेछ।<verse eid="JOS 8:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 8:8"/>जब तिमीहरूले त्यो सहरलाई कब्जा गर्नेछौ, तब याहवेहले भन्‍नुभएझैँ त्यस सहरमा आगो लगाइदिनू! यो याद राख कि, यो तिमीहरूलाई मेरो आज्ञा हो।”<verse eid="JOS 8:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 8:9"/>तब यहोशूले तिनीहरूलाई पठाए। अनि तिनीहरू लुक्ने ठाउँमा गए। तब ऐ सहरको पश्‍चिमतिरको ऐ र बेथेल सहरको बीचमा ढुकिबसे। तर यहोशूले चाहिँ त्यो रात मानिसहरूसँग बिताए।<verse eid="JOS 8:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 8:10"/>भोलिपल्ट बिहानै यहोशूले आफ्ना सेनाहरूलाई भेला गरे। अनि तिनी र इस्राएलका अगुवाहरू तिनीहरूका अगि-अगि ऐतिर बढे।<verse eid="JOS 8:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 8:11"/>तिनीसँग भएको सम्पूर्ण दल अगि बढे। अनि तिनीहरू सहरको नजिक पुगे, र त्यस सहरको अगिल्तिर आइपुगे। तिनीहरूले तिनीहरू र सहरको बीचको बेँसीमा ऐ सहरको उत्तरतिर छाउनी हाले।<verse eid="JOS 8:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 8:12"/>यहोशूले पाँच हजार जति मानिसहरू लिएर सहरको पश्‍चिमतिर बेथेल र ऐको बीचमा ढुकेर बसे।<verse eid="JOS 8:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 8:13"/>यसरी सेनाहरू लडाइँका निम्ति तयार भए। फौजको ठूलो दललाई सहरको उत्तरपट्टिको छाउनीमा राखे। अनि ढुकेर बस्‍नेहरूका दलचाहिँ सहरको पश्‍चिमपट्टिको छाउनीमा रहे। त्यो रात यहोशूचाहिँ बेँसीमा गए।<verse eid="JOS 8:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 8:14"/>जब ऐका राजाले यो देखे, तिनी र सहरका सबै मानिसहरू एकाबिहानै हतारिँदै इस्राएलीहरूसँग युद्ध गर्नलाई अराबाको एक निश्‍चित ठाउँमा निस्के। तर तिनीहरूको विरुद्धमा सहरको पछिल्तिरको भागमा तिनीहरूलाई ढुकेर बस्‍नेहरूको बारेमा थाहै भएन।<verse eid="JOS 8:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 8:15"/>यहोशू र सबै इस्राएलीहरू तिनीहरूको अगि-अगि खेदिएझैँ उजाडस्थानतिर भागे।<verse eid="JOS 8:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 8:16"/>ऐका सारा मानिसहरू तिनीहरूलाई खेद्नलाई बोलाइएका थिए। अनि तिनीहरूले यहोशूलाई खेदे, र तिनीहरू सहरदेखि टाढा पुर्‍याइए।<verse eid="JOS 8:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 8:17"/>ऐका अथवा बेथेलमा इस्राएलको पछि नलाग्ने पुरुष एउटै पनि थिएन। तिनीहरू सबैले सहर खुल्‍ला छोडेर इस्राएलीहरूलाई खेदे।<verse eid="JOS 8:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 8:18"/>तब याहवेहले यहोशूलाई भन्‍नुभयो, “तेरो हातमा भएको भाला ऐतिर पसार्; किनकि म त्यस सहरलाई तेरो अधीनमा सुम्पिदिनेछु।” यसकारण यहोशूले आफ्नो भाला ऐतिर पसारे।<verse eid="JOS 8:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 8:19"/>तिनले यसो गर्नसाथ ती ढुकेर बसेका मानिसहरू आफ्नो ठाउँबाट तुरुन्तै निस्केर अगि बढे। तिनीहरू सहरभित्र पसे। तब त्यसलाई कब्जा गरे; अनि तुरुन्तै सहरमा आगो लगाइदिए।<verse eid="JOS 8:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 8:20"/>जब ऐ सहरका मानिसहरूले पछि फर्केर हेरे, तब सहरबाट धुवाँको मुस्लो आकाशतिर गइरहेको देखे। तर तिनीहरूलाई कुनै दिशातिर भाग्ने मौका थिएन। किनकि उजाडस्थानतिर भाग्दै गरेका इस्राएलीहरू तिनीहरूलाई खेद्नेहरूको विरुद्धमा फर्किसकेका थिए।<verse eid="JOS 8:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 8:21"/>जब यहोशू र सबै इस्राएलीहरूले ढुकेर बस्‍ने मानिसहरूले सहर कब्जा गरेको अनि सहरबाट धुवाँ मास्तिर उठिरहेको देखे, तब तिनीहरू फनक्‍क फर्केर ऐका मानिसहरूलाई आक्रमण गरे।<verse eid="JOS 8:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 8:22"/>तिनीहरूलाई ढुकेर बस्‍ने मानिसहरू पनि तिनीहरूको विरुद्धमा सहरबाट निस्किआए; र तिनीहरू दुवैतिर इस्राएली सेनाहरू भएको बीचमा थुनिए। इस्राएलीहरूले बाँचेका र भाग्नेहरू कसैलाई पनि जीवित रहन नदिई सबैलाई काटेर मारे।<verse eid="JOS 8:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 8:23"/>तर तिनीहरूले ऐका राजालाई जिउँदै पक्रे, र तिनलाई यहोशूकहाँ ल्याए।<verse eid="JOS 8:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 8:24"/>उजाडस्थानमा इस्राएलीहरूलाई खेद्‌दै आएका ऐका सबै मानिसहरूलाई त्यहीँ नै तरवारले मारे। अनि सबै इस्राएलीहरू ऐमा फर्केर आए। तब त्यहाँ भएकाहरूलाई पनि मारे।<verse eid="JOS 8:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 8:25"/>त्यस दिन ऐका सबै मानिसहरू, बाह्र हजार पुरुष र स्त्रीहरू मारिए।<verse eid="JOS 8:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 8:26"/>किनकि ऐमा बस्‍ने सबै मनिसहरूलाई विनाश नगरेसम्म यहोशूले भाला पक्रेको हात बिसाएनन्।<verse eid="JOS 8:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 8:27"/>तर याहवेहले यहोशूलाई निर्देशन दिनुभएझैँ इस्राएलीले त्यस सहरका गाईबस्तु र लुटको माल आफ्ना निम्ति बोकेर लगे।<verse eid="JOS 8:27"/></para>
<para style="p"><verse number="28" style="v" sid="JOS 8:28"/>यसरी यहोशूले ऐलाई जलाएर भग्नावशेषको रास बनाइदिए, जुन आजको दिनसम्म निर्जन छँदैछ।<verse eid="JOS 8:28"/></para>
<para style="p"><verse number="29" style="v" sid="JOS 8:29"/>यहोशूले ऐको राजालाई एउटा रूखमा झुण्ड्याइदिए; र तिनलाई साँझसम्मै त्यहाँ छोडिदिए। सूर्यास्तमा तिनले राजाको शरीरलाई रूखबाट उतारेर सहरको ढोकाको सँघारमा फ्याँकिदिन आदेश दिए। अनि तिनीहरूले त्यसमाथि ढुङ्गाहरूको थुप्रो लगाइदिए, जुन थुप्रो आजको दिनसम्म छँदैछ।<verse eid="JOS 8:29"/></para>
<para style="p"><verse number="30" style="v" sid="JOS 8:30"/>तब यहोशूले एबाल डाँडामा याहवेह इस्राएलका परमेश्‍वरका निम्ति एउटा वेदी बनाए,<verse eid="JOS 8:30"/></para>
<para style="p"><verse number="31" style="v" sid="JOS 8:31"/>जुनचाहिँ याहवेहका सेवक मोशाले इस्राएलीहरूलाई आज्ञा दिएअनुसार र तिनले मोशाको व्यवस्थामा लेखिएअनुसार, फलामको कुनै औजार प्रयोग नगरिएका र नकाटिएका ढुङ्गाहरूको वेदी थियो। त्यसमाथि तिनीहरूले याहवेहका निम्ति होमबलि र मेलबलिहरू चढाए।<verse eid="JOS 8:31"/></para>
<para style="p"><verse number="32" style="v" sid="JOS 8:32"/>त्यहाँ इस्राएलीहरूको उपस्थितिमा यहोशूले त्यस ढुङ्गाहरूमा मोशाले लेखेका व्यवस्थाको नक्‍कल उतारे।<verse eid="JOS 8:32"/></para>
<para style="p"><verse number="33" style="v" sid="JOS 8:33"/>सबै इस्राएलीहरू, तिनीहरूका प्रधानहरू, अधिकृतहरू, न्यायकर्ताहरू, याहवेहको करारको सन्दुक बोक्ने लेवी पुजारीहरूका दुवै तर्फ फर्केर उभिएका थिए। त्यहाँ विदेशीहरू र त्यहाँ जन्मिएका नागरिकहरू पनि थिए। इस्राएलका मानिसहरूलाई आशिष् दिनलाई याहवेहको सेवक मोशाले पहिले नै आदेश दिएझैँ, आधा मानिसहरू गीरीज्जीम डाँडाको सामु र आधाचाहिँ एबाल डाँडाको सामु खडा भए।<verse eid="JOS 8:33"/></para>
<para style="p"><verse number="34" style="v" sid="JOS 8:34"/>त्यसपछि यहोशूले व्यवस्थाका सबै वचन, आशिष् र श्राप व्यवस्थाको पुस्तकमा लेखिएअनुसार पढे।<verse eid="JOS 8:34"/></para>
<para style="p"><verse number="35" style="v" sid="JOS 8:35"/>इस्राएलका सम्पूर्ण समुदाय, साथै स्त्री र बालबालिकाहरू र तिनीहरूसँग बस्‍ने विदेशीहरूको सामु मोशाले आज्ञा गरेका वचनहरूमा यहोशूले नपढेको शब्द एउटै पनि थिएन।<verse eid="JOS 8:35"/></para>
<chapter eid="JOS 8"/>
<chapter number="9" style="c" sid="JOS 9"/>
<para style="p"><verse number="1" style="v" sid="JOS 9:1"/>अब यर्दनको पश्‍चिमतिरका सबै राजाहरूले यी कुराहरूको बारेमा सुने। ती राजाहरू यिनै थिए: हित्ती, एमोरी, कनानी, परिज्जी, हिव्वी अनि यबूसी, जो पहाडी मुलुकका पश्‍चिमका डाँडाहरू, फेदी र लेबनानसम्म फैलिएका महासागरका किनारामा बस्दथे।<verse eid="JOS 9:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 9:2"/>तिनीहरू यहोशू र इस्राएलको विरुद्धमा युद्ध गर्न भनी एकजुट भएर आए।<verse eid="JOS 9:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 9:3"/>जब गिबोनका मानिसहरूले यहोशूले यरीहो र ऐलाई जे गरेका थिए त्यसको बारेमा सुने,<verse eid="JOS 9:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 9:4"/>तब तिनीहरूले छल गर्ने विचार गरे। तिनीहरू राजदूतको रूपमा गए, जसका गधाहरूमाथि फाटेका बोराहरू, पुराना फाटेका र टालेका मशकहरूले लादिएका थिए।<verse eid="JOS 9:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 9:5"/>ती मानिसहरूले खुट्टामा पुराना टालेका जुत्ताहरू र फाटेका लुगाहरू लगाएका थिए। तिनीहरूका सबै भोजनहरू सुकेका र ढुसी परेका थिए।<verse eid="JOS 9:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 9:6"/>तब तिनीहरू गिलगालमा यहोशूको छाउनीमा गएर तिनलाई र इस्राएलीहरूलाई भने, “हामी टाढाको देशबाट आएका हौँ; यसकारण हामीसँग सन्धि गर्नुहोस्।”<verse eid="JOS 9:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 9:7"/>इस्राएलका मानिसहरूले हिव्वीहरूलाई भने, “सायद, तिमीहरू हाम्रै नजिकमा बस्‍ने मानिसहरू हौ। अनि हामीले कसरी तिमीहरूसँग सन्धि गर्न सक्छौँ?”<verse eid="JOS 9:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 9:8"/>तिनीहरूले यहोशूलाई भने, “हामी तपाईंका सेवकहरू हौँ।” तर यहोशूले सोधे, “तिमीहरू को हौ? र कहाँबाट आएका हौ?”<verse eid="JOS 9:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 9:9"/>तिनीहरूले जवाफ दिए: “हामी तपाईंका सेवकहरू धेरै टाढाको देशबाट याहवेह तपाईंका परमेश्‍वरको ख्याति सुनेको हुनाले आएका हौँ। किनकि उहाँले इजिप्टमा गर्नुभएका सबै कुराहरूको वृतान्त हामीले सुनेका छौँ।<verse eid="JOS 9:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 9:10"/>अनि उहाँले यर्दनको पूर्वका दुई एमोरी राजाहरू अर्थात् हेश्बोनका राजा सीहोन र अस्तारोतमा राज्य गर्ने बाशानका राजा ओगलाई के गर्नुभयो, त्यो सुनेका छौँ।<verse eid="JOS 9:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 9:11"/>अनि हाम्रा प्रधानहरू र हाम्रा देशमा बस्‍ने सबै मानिसहरूले हामीलाई भने, ‘यात्राका निम्ति चाहिने सबै खानेकुराहरू बोकेर जाओ, र तिनीहरूलाई भेटेर भन; “हामी तपाईंहरूका सेवकहरू हौँ, यसैले हामीसँग सन्धि गर्नुहोस्।” ’<verse eid="JOS 9:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 9:12"/>हामी तपाईंहरूलाई भेट्न निस्केको दिन हामीले पोको पारेका यी हाम्रा रोटीहरू तातो-तातै थिए। तर अब हेर्नुहोस्, यो कति सुक्खा र ढुसी परिसकेको छ।<verse eid="JOS 9:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 9:13"/>अनि हामीले यी मशकहरू दाखमद्यले भर्दा नयाँ नै थिए। तर अब हेर्नुहोस्, यी प्वाल परिसकेका छन्। अनि हाम्रा लुगाहरू र जुत्ताहरू लामो यात्राको कारणले थोत्रा भइसकेका छन्।”<verse eid="JOS 9:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 9:14"/>तब इस्राएलीहरूले तिनीहरूका खाने कुराहरूको जाँच गरे, तर याहवेहबाट केही सल्‍लाह लिएनन्।<verse eid="JOS 9:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 9:15"/>तब यहोशूले तिनीहरूलाई जीवितै राख्ने शान्ति-सन्धि गरे। अनि सभामा अगुवाहरूले त्यसलाई शपथद्वारा सहमत गरे।<verse eid="JOS 9:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 9:16"/>गिबोनीहरूसँग शान्ति-सन्धि गरेको तीन दिनपछि इस्राएलीहरूले यो कुरा थाहा पाए, कि तिनीहरू त उनीहरूकै नजिकमा बस्‍ने छिमेकीहरू पो रहेछन्।<verse eid="JOS 9:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 9:17"/>यसकारण इस्राएलीहरू प्रस्थान गरे। अनि तेस्रो दिन तिनीहरूका सहरहरू गिबोन, कपीरा, बेरोत र किर्यत-यारीममा आइपुगे।<verse eid="JOS 9:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 9:18"/>तर इस्राएलीहरूले तिनीहरूमाथि आक्रमण गरेनन्; किनकि समुदायका अगुवाहरूले तिनीहरूसँग याहवेह इस्राएलका परमेश्‍वरको नाममा शपथ खाएका थिए। सारा समुदाय ती अगुवाहरूसँग गनगन गरे।<verse eid="JOS 9:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 9:19"/>तर सबै अगुवाहरूले जवाफ दिए, “हामीले तिनीहरूलाई याहवेह इस्राएलका परमेश्‍वरको नाममा शपथ खाएका छौँ। अब हामीले तिनीहरूलाई छुन सक्दैनौँ।<verse eid="JOS 9:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 9:20"/>हामी तिनीहरूसँग यसो गरौँ: हामीले तिनीहरूलाई जीवितै राखौँ, ताकि हामीले तिनीहरूसँग खाएको शपथ भङ्ग गरेको कारण हामीमाथि परमेश्‍वरको क्रोध नपरोस्।”<verse eid="JOS 9:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 9:21"/>तिनीहरूले अझ भने, “तिनीहरू जीवितै रहून्, तर तिनीहरू सारा समुदायका निम्ति दाउरा काट्नेहरू र पानी भर्नेहरू होऊन्।” यसरी ती अगुवाहरूले तिनीहरूसँग गरिएको प्रतिज्ञा कायम राखे।<verse eid="JOS 9:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 9:22"/>तब यहोशूले गिबोनीहरूलाई बोलाएर भने, “तिमीहरूले हामीलाई ‘हामी तपाईंहरूभन्दा टाढा बस्छौँ,’ भनेर किन छल गर्‍यौ? वास्तवमा तिमीहरू त हाम्रै नजिक बसोबास गर्नेहरू रहेछौ।<verse eid="JOS 9:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 9:23"/>यसकारण अब तिमीहरू श्रापित भएका छौ। तिमीहरू मेरा परमेश्‍वरका भवनको दाउरा काट्ने र पानी भर्ने कामबाट कहिल्यै मुक्त हुनेछैनौ।”<verse eid="JOS 9:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 9:24"/>तिनीहरूले यहोशूलाई भने, “याहवेह तपाईंका परमेश्‍वरले आफ्नो सेवक मोशालाई यो सम्पूर्ण देश तपाईंहरूलाई दिन र यस देशका सारा बासिन्दाहरूलाई नष्‍ट गर्न आज्ञा दिनुभएको थियो। त्यसैले हामी आफ्नो ज्यानको निम्ति डरायौँ। यसकारण हामीले यसो गरेका हौँ।<verse eid="JOS 9:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 9:25"/>अब हामी तपाईंहरूको हातमा छौँ। तपाईंहरूलाई जस्तो उचित र ठिक लाग्छ, हामीसित त्यही गर्नुहोस्।”<verse eid="JOS 9:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 9:26"/>यसकारण यहोशूले इस्राएलीहरूबाट तिनीहरूलाई जोगाए; र तिनीहरूलाई मारेनन्।<verse eid="JOS 9:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 9:27"/>त्यस दिन यहोशूले गिबोनीहरूलाई सम्पूर्ण समुदायका निम्ति र याहवेहले चुन्‍नुहुने उहाँको वेदीका निम्ति दाउरा काट्ने र पानी भर्नेहरू बनाए। अनि आजको दिनसम्म पनि तिनीहरूले त्यही काम गर्छन्।<verse eid="JOS 9:27"/></para>
<chapter eid="JOS 9"/>
<chapter number="10" style="c" sid="JOS 10"/>
<para style="p"><verse number="1" style="v" sid="JOS 10:1"/>अब यरूशलेमका राजा अदोनी-सेदेकले यहोशूले ऐ सहर कब्जा गरेको, त्यसका राजालाई पनि यरीहो सहर र त्यहाँका राजालाई जस्तै पूर्ण रूपले नष्‍ट गरेको कुरा तिनले सुने। अनि गिबोनका मानिसहरूले इस्राएलसँग शान्ति-सन्धि गरेर तिनीहरूकै नजिक बस्‍न थालेका छन् भन्‍ने कुरा पनि तिनले सुने।<verse eid="JOS 10:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 10:2"/>यो कुराले तिनी र तिनका मानिसहरू भयभीत भए; किनकि गिबोन राजकीय सहरहरूजस्तै एउटा ठूलो सहर थियो। गिबोन ऐ सहरभन्दा ठूलो थियो। अनि त्यसका सबै मानिसहरू असल लडाकुहरू थिए।<verse eid="JOS 10:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 10:3"/>यसकारण यरूशलेमका राजा अदोनी-सेदेकले हेब्रोनका राजा होहाम, यर्मूतका राजा पिराम, लाकीशका राजा याफिया र एग्लोनका राजा दबीरकहाँ खबर पठाए।<verse eid="JOS 10:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 10:4"/>तिनले भने, “आउनुहोस्, र मलाई गिबोनमा आक्रमण गर्न सघाउनुहोस्! किनकि त्यसले यहोशू र इस्राएलीहरूसँग मिलाप गरेको छ।”<verse eid="JOS 10:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 10:5"/>तब पाँच जना एमोरी राजाहरू, अर्थात् यरूशलेम, हेब्रोन, यर्मूत, लाकीश र एग्लोनका राजाहरूले एकसाथ मोर्चा बाँधे। तिनीहरूले आफ्ना सबै फौजहरू लिएर गिबोनको विरुद्धमा लडाइँका निम्ति तयार भए; अनि त्यसमाथि आक्रमण गरे।<verse eid="JOS 10:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 10:6"/>तब गिबोनीहरूले गिलगालको छाउनीमा यहोशूकहाँ यसो भनी खबर पठाए: “तपाईंका सेवकहरूलाई नत्याग्नुहोस्। हामीकहाँ चाँडो आएर हामीलाई बचाउनुहोस्! हामीलाई सहायता गर्नुहोस्; किनकि पहाडी मुलुकबाट सबै एमोरी राजाहरूले हाम्रो विरुद्धमा मोर्चा बाँधेका छन्।”<verse eid="JOS 10:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 10:7"/>यसकारण यहोशूले आफ्ना सबैभन्दा असल लडाकुहरू लगायत सम्पूर्ण फौज लिएर युद्ध गर्न गिलगालबाट हिँडे।<verse eid="JOS 10:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 10:8"/>अनि याहवेहले यहोशूलाई भन्‍नुभयो, “तिनीहरूसँग नडरा। मैले तिनीहरूलाई तेरो हातमा सुम्पिदिएको छु। तिनीहरूमध्ये कोही पनि तेरो सामु टिक्न सक्नेछैन।”<verse eid="JOS 10:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 10:9"/>गिलगालबाट रातभरिको हिँडाइपछि यहोशू अचानक तिनीहरूमाथि जाइलागे।<verse eid="JOS 10:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 10:10"/>याहवेहले तिनीहरूलाई इस्राएलको सामु भयभीत पारिदिनुभयो। यसरी इस्राएलीहरूले तिनीहरूलाई गिबोनमा पूर्ण रूपले परास्त गरे। इस्राएलीहरूले तिनीहरूलाई बेथ-होरोन जाने बाटोभरि खेदे। अनि तिनीहरूलाई अजेका र मक्‍केदासम्म लखेटेर मार्दै गए।<verse eid="JOS 10:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 10:11"/>तिनीहरू इस्राएलीहरूको सामुबाट बेथ-होरोनदेखि अजेकासम्म बाटोमा भाग्दैगर्दा याहवेहले तिनीहरूमाथि आकाशबाट ठूला-ठूला असिनाहरू ओइर्‍याइदिनुभयो। अनि इस्राएलीहरूका तरवारले मारेकाभन्दा असिनाले धेरै जना मरे।<verse eid="JOS 10:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 10:12"/>याहवेहले एमोरीहरूलाई इस्राएलको हातमा दिनुभएको त्यस दिन यहोशूले इस्राएलको उपस्थितिमा याहवेहलाई भने: “हे सूर्य, तँ गिबोनमाथि, र हे चन्द्रमा, तँ अय्यालोनको बेँसीमाथि अडेर बस्।”<verse eid="JOS 10:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 10:13"/>यसकारण इस्राएलले आफ्ना शत्रुहरूमाथि बदला नलिएसम्म सूर्य अडिरह्‍यो। अनि चन्द्रमा थामियो। यो कुरा याशारको पुस्तकमा लेखिएको छ। आकाशको बीचमा सूर्य अडिरह्‍यो। अनि सूर्य अस्ताउनलाई लगभग एक दिन नै ढिलो गर्‍यो।<verse eid="JOS 10:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 10:14"/>याहवेहले यसरी मानिसको प्रार्थना सुन्‍नुभएको घटना न त पहिले, न त पछि कहिल्यै कुनै दिन नै भयो। निश्‍चय नै याहवेह इस्राएलको पक्षमा लडिरहनुभएको थियो!<verse eid="JOS 10:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 10:15"/>त्यसपछि यहोशू सारा इस्राएलीसँग गिलगालको छाउनीमा फर्के।<verse eid="JOS 10:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 10:16"/>अब ती पाँच जना एमोरी राजाहरू भागे, र मक्‍केदामा भएको गुफामा लुकेर बसे।<verse eid="JOS 10:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 10:17"/>जब ती पाँच जना राजाहरू मक्‍केदामा भएको गुफामा लुकिरहेका कुरा यहोशूलाई बताइयो,<verse eid="JOS 10:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 10:18"/>तब यहोशूले भने, “त्यस गुफाको मुखमा ठूला पत्थरहरू गुड्याइदेओ। अनि त्यसलाई कुर्नलाई केही मानिसहरूलाई खटाओ।<verse eid="JOS 10:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 10:19"/>तर तिमीहरू भने त्यहाँ नरोकिनू। तिमीहरूले शत्रुहरूलाई खेदेर पछिल्तिरबाट आक्रमण गर्नू र तिनीहरूलाई तिनीहरूका सहरमा पुग्न नदिनू। किनकि याहवेह तिमीहरूका परमेश्‍वरले तिनीहरूलाई तिमीहरूको हातमा सुम्पिदिनुभएको छ।”<verse eid="JOS 10:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 10:20"/>यसरी यहोशू र इस्राएलीहरूले तिनीहरूलाई सम्पूर्ण रूपले नष्‍ट गरे। तर बाँचेका केही मानिसहरू भने तिनीहरूका सुरक्षित सहरहरूमा पुग्न सफल भए।<verse eid="JOS 10:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 10:21"/>त्यसपछि सारा सेना मक्‍केदामा भएको छाउनीमा सुरक्षितसाथ यहोशूकहाँ फर्के। अनि इस्राएलीहरूको विरुद्धमा कसैले पनि एउटा शब्द पनि बोलेनन्।<verse eid="JOS 10:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 10:22"/>यहोशूले भने, “गुफाको मुखबाट ढुङ्गा हटाओ, र ती पाँच राजाहरूलाई बाहिर निकालेर मकहाँ ल्याओ।”<verse eid="JOS 10:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 10:23"/>यसकारण तिनीहरूले ती पाँच राजाहरू, जो यरूशलेम, हेब्रोन, यर्मूत, लाकीश र एग्लोनका राजाहरू थिए, तिनीहरूलाई गुफाबाट बाहिर निकालेर ल्याए।<verse eid="JOS 10:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 10:24"/>जब तिनीहरूले ती पाँच राजाहरूलाई यहोशूकहाँ ल्याए, तब तिनले इस्राएलका सबै मानिसहरूलाई बोलाए। अनि तिनीसँग आएका सेनाका सेनापतिहरूलाई भने, “यहाँ आओ, र तिमीहरूका आ-आफ्ना खुट्टा यी राजाहरूका गर्दनमाथि राख।” यसकारण तिनीहरू नजिक आएर आ-आफ्ना खुट्टाहरू तिनीहरूका गर्दनमाथि राखे।<verse eid="JOS 10:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 10:25"/>यहोशूले तिनीहरूलाई भने, “नडराओ, र निरुत्साहित नहोओ। बलियो र साहसी होओ। तिमीहरूले लडाइँ गर्न जाने सबै शत्रुहरूलाई याहवेहले यसै गर्नुहुनेछ।”<verse eid="JOS 10:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 10:26"/>तब यहोशूले ती सबै राजाहरूलाई मारे। अनि तिनीहरूलाई पाँच वटा खम्बाहरूमा झुण्ड्याइदिए। तिनीहरूलाई साँझसम्मै खम्बाहरूमा झुण्डाएर राखियो।<verse eid="JOS 10:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 10:27"/>सूर्यास्तको समयमा यहोशूले आदेश दिए, र तिनीहरूले उनीहरूलाई खम्बाबाट झारे। अनि तिनीहरू लुकेर बसेका गुफामा फ्याँकिदिए। तिनीहरूले गुफाको मुखमा ठूला चट्टानहरू राखिदिए, जुन आजको दिनसम्म छँदैछ।<verse eid="JOS 10:27"/></para>
<para style="p"><verse number="28" style="v" sid="JOS 10:28"/>त्यस दिन यहोशूले मक्‍केदा कब्जा गरे। तिनले सहर र त्यस देशका राजालाई तरवारद्वारा परास्त गरे। अनि त्यहाँ भएका हरेक मानिसहरूलाई पूर्ण रूपले नष्‍ट गरे। तिनले एक जनालाई पनि जीवित छोडेनन्। अनि तिनले यरीहोको राजालाई गरेजस्तै, मक्‍केदाको राजालाई पनि त्यस्तै गरे।<verse eid="JOS 10:28"/></para>
<para style="p"><verse number="29" style="v" sid="JOS 10:29"/>तब यहोशू र तिनीसँग भएका सारा इस्राएलीहरू मक्‍केदाबाट अगि बढेर लिब्नामा गए, र त्यसलाई आक्रमण गरे।<verse eid="JOS 10:29"/></para>
<para style="p"><verse number="30" style="v" sid="JOS 10:30"/>याहवेहले त्यो सहर र त्यस देशका राजालाई पनि इस्राएलको हातमा सुम्पिदिनुभयो। यहोशूले त्यो सहर र त्यसमा भएका सबैलाई तरवारले नाश गरे। तिनले त्यहाँ कसैलाई पनि जीवित छोडेनन्। तिनले त्यहाँका राजालाई पनि यरीहोको राजालाई जस्तै गरे।<verse eid="JOS 10:30"/></para>
<para style="p"><verse number="31" style="v" sid="JOS 10:31"/>त्यसपछि यहोशू र तिनीसँग भएका सारा इस्राएलीहरू लिब्नाबाट लाकीशतर्फ अगि बढे। तिनले त्यसको विरुद्धमा लड्न तयार भए, र त्यसलाई आक्रमण गरे।<verse eid="JOS 10:31"/></para>
<para style="p"><verse number="32" style="v" sid="JOS 10:32"/>याहवेहले लाकीशलाई इस्राएलको हातमा सुम्पिदिनुभयो। अनि यहोशूले यस सहरलाई दोस्रो दिनमा कब्जा गरे। तिनले लिब्नालाई गरेजस्तै, त्यो सहर र त्यसमा भएका हरेकलाई तरवारले नष्‍ट गरे।<verse eid="JOS 10:32"/></para>
<para style="p"><verse number="33" style="v" sid="JOS 10:33"/>त्यस बेला गेजेरका राजा होराम लाकीशलाई सहायता गर्न आएका थिए। तर यहोशूले तिनलाई र तिनका सेनाहरू एउटैलाई पनि जीवित नराखी परास्त गरे।<verse eid="JOS 10:33"/></para>
<para style="p"><verse number="34" style="v" sid="JOS 10:34"/>त्यसपछि यहोशू र तिनीसँग भएका सारा इस्राएलीहरू लाकीशबाट एग्लोन तर्फ अगि बढे। तिनीहरू एग्लोनको विरुद्धमा लड्न तयार भए, र त्यसमाथि आक्रमण गरे।<verse eid="JOS 10:34"/></para>
<para style="p"><verse number="35" style="v" sid="JOS 10:35"/>तिनीहरूले त्यसलाई त्यही दिन कब्जा गरे। अनि तिनीहरूले लाकीशलाई गरेजस्तै, त्यस सहरमा भएका हरेकलाई तरवारले नष्‍ट गरे।<verse eid="JOS 10:35"/></para>
<para style="p"><verse number="36" style="v" sid="JOS 10:36"/>त्यसपछि यहोशू र तिनीसँग भएका सारा इस्राएली एग्लोनबाट हेब्रोनतर्फ अगि बढे, र त्यसलाई आक्रमण गरे।<verse eid="JOS 10:36"/></para>
<para style="p"><verse number="37" style="v" sid="JOS 10:37"/>तिनीहरूले त्यस सहरलाई कब्जामा लिए। अनि त्यसका राजालाई समेत त्यसका गाउँहरू, र त्यसमा भएका हरेकलाई तरवारले नष्‍ट गरे। तिनीहरूले एउटैलाई पनि जीवित छोडेनन्। एग्लोनलाई गरेजस्तै, तिनीहरूले त्यसलाई र त्यसमा भएका हरेकलाई नष्‍ट गरे।<verse eid="JOS 10:37"/></para>
<para style="p"><verse number="38" style="v" sid="JOS 10:38"/>त्यसपछि यहोशू र तिनीसँग भएका सारा इस्राएलीहरू दबीरतर्फ फर्के, र त्यसलाई आक्रमण गरे।<verse eid="JOS 10:38"/></para>
<para style="p"><verse number="39" style="v" sid="JOS 10:39"/>तिनीहरूले त्यस सहरलाई त्यसका राजालाई र त्यसका गाउँहरूलाई कब्जामा लिए। अनि तिनीहरूलाई पूर्ण रूपमा तरवारले नष्‍ट गरे। तिनीहरूले एउटैलाई पनि जीवित छोडेनन्। तिनीहरूले हेब्रोन र लिब्ना तथा त्यहाँका राजाहरूलाई गरेजस्तै, दबीर र त्यसका राजालाई पनि त्यस्तै गरे।<verse eid="JOS 10:39"/></para>
<para style="p"><verse number="40" style="v" sid="JOS 10:40"/>यसरी यहोशूले पहाडी मुलुक, दक्षिणी भाग, पश्‍चिमी फेदी, पर्वतीय पाखाहरू र त्यहाँका सबै राजाहरू लगायत सम्पूर्ण इलाकालाई अधीनमा पारे। तिनले एउटैलाई पनि जीवित छोडेनन्। याहवेह इस्राएलका परमेश्‍वरले आज्ञा गर्नुभएझैँ, तिनले सास हुने सबैलाई पूर्ण रूपमा नाश गरे।<verse eid="JOS 10:40"/></para>
<para style="p"><verse number="41" style="v" sid="JOS 10:41"/>यहोशूले तिनीहरूलाई कादेश-बर्नेदेखि गाजासम्म र गोशेनको सम्पूर्ण इलाकादेखि गिबोनसम्मै अधीनमा पारे।<verse eid="JOS 10:41"/></para>
<para style="p"><verse number="42" style="v" sid="JOS 10:42"/>यी सबै राजाहरू र तिनीहरूका देशहरूलाई यहोशूले एकै पटकमा जिते। किनकि याहवेह इस्राएलका परमेश्‍वरले नै इस्राएलको निम्ति युद्ध गर्नुभयो।<verse eid="JOS 10:42"/></para>
<para style="p"><verse number="43" style="v" sid="JOS 10:43"/>त्यसपछि यहोशू र सारा इस्राएलीहरू गिलगालमा भएको छाउनीमा फर्के।<verse eid="JOS 10:43"/></para>
<chapter eid="JOS 10"/>
<chapter number="11" style="c" sid="JOS 11"/>
<para style="p"><verse number="1" style="v" sid="JOS 11:1"/>जब हासोरका राजा याबीनले यो सुने, तब तिनले मादोनका राजा योबाब, शिम्रोन र अक्षापका राजाहरूलाई,<verse eid="JOS 11:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 11:2"/>साथै उत्तरी पहाडहरूमा भएका किन्‍नरेतको दक्षिण अराबामा, पश्‍चिमी फेदीमा र पश्‍चिममा नापोत-डोरमा भएका राजाहरूलाई;<verse eid="JOS 11:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 11:3"/>पूर्व र पश्‍चिममा कनानीहरू, एमोरीहरू, हित्तीहरू, परिज्जीहरू र पहाडी मुलुकका यबूसीहरू, र मिस्पा इलाकामा हेर्मोनको मुन्तिरका हिव्वीहरूलाई खबर पठाए।<verse eid="JOS 11:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 11:4"/>तिनीहरू आ-आफ्ना सबै फौजहरूसँग समुद्रको किनारका बालुवासरह गन्‍नै नसकिने गरी घोडाहरू र रथहरूको ठूलो संख्या भएको विशाल सेना लिएर निस्किआए।<verse eid="JOS 11:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 11:5"/>यी सबै राजाहरूले सेनाहरू लिएर मेरोमको ताल नजिक इस्राएलको विरुद्धमा लडाइँ गर्न एकसाथ छाउनी हाले।<verse eid="JOS 11:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 11:6"/>याहवेहले यहोशूलाई भन्‍नुभयो, “तिनीहरूसँग नडरा; किनकि भोलि यस बेलासम्ममा म तिनीहरू सबैलाई मारेर इस्राएलको हातमा सुम्पिदिनेछु। तैँले तिनीहरूका घोडाहरूका ढोडनसा काटिदिनू र तिनीहरूका रथहरू जलाइदिनू।”<verse eid="JOS 11:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 11:7"/>यसकारण यहोशू र तिनका सम्पूर्ण फौजले मेरोमको तालमा अचानक आएर तिनीहरूमाथि आक्रमण गरे।<verse eid="JOS 11:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 11:8"/>अनि याहवेहले तिनीहरूलाई इस्राएलको हातमा सुम्पिदिनुभयो। तिनीहरूले उनीहरूलाई परास्त गरेर विशाल सीदोनदेखि मिस्रापोत-मैमसम्म, र एउटै पनि जीवित नरहेसम्म पूर्वको मिस्पाको बेँसीसम्म खेदे।<verse eid="JOS 11:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 11:9"/>याहवेहले निर्देशन दिनुभएअनुसार यहोशूले त्यसै गरे। तिनले तिनीहरूका घोडाहरूका ढोडनसा काटिदिए, र तिनीहरूका रथहरू जलाइदिए।<verse eid="JOS 11:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 11:10"/>त्यस समयमा यहोशू फर्के, र हासोरलाई कब्जा गरे। अनि त्यसका राजालाई तरवारले मारे। (हासोरचाहिँ यी सबै राज्यहरूको केन्द्र थियो।)<verse eid="JOS 11:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 11:11"/>तिनीहरूले त्यहाँ भएका हरेकलाई तरवारले मारे। तिनीहरूले सास हुनेजति एउटैलाई नछोडी सबैलाई नष्‍ट गरे। अनि तिनले हासोरलाई पनि जलाइदिए।<verse eid="JOS 11:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 11:12"/>यहोशूले सम्पूर्ण राजकीय सहरहरू र तिनीहरूका राजाहरूलाई कब्जा गरे। अनि तिनीहरूलाई तरवारले मारे। याहवेहका सेवक मोशाले आज्ञा गरेअनुसार यहोशूले तिनीहरूलाई पूर्ण रूपमा नष्‍ट गरे।<verse eid="JOS 11:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 11:13"/>तैपनि इस्राएलीहरूले डाँडामा बनाएका कुनै पनि सहर जलाएनन्। यहोशूले हासोरलाई मात्र जलाए।<verse eid="JOS 11:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 11:14"/>इस्राएलीहरूले यस सहरहरूका सबै लुटका धनमाल र गाईबस्तु आफ्ना लागि लगे। तर सास फेर्ने एउटैलाई पनि जीवित नराखी सबै मानिसहरूलाई पूर्ण रूपमा तरवारले मारेर नष्‍ट पारे।<verse eid="JOS 11:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 11:15"/>याहवेहले आफ्ना सेवक मोशालाई आज्ञा गर्नुभएजस्तै मोशाले यहोशूलाई आज्ञा दिएका थिए। अनि यहोशूले त्यही गरे; याहवेहले मोशालाई दिनुभएको आज्ञाहरू एउटै पनि अधुरो नछोडी तिनले सबै पूरा गरे।<verse eid="JOS 11:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 11:16"/>यसरी यहोशूले सम्पूर्ण देश जिते: पहाडी मुलुक, सम्पूर्ण दक्षिणी भाग, गोशेनको सारा इलाका, पश्‍चिमी डाँडाहरू, अराबा र इस्राएलका पर्वतहरू अनि त्यसका फेदीहरूसमेत,<verse eid="JOS 11:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 11:17"/>सेइरदेखि माथिको हालाक पर्वतदेखि हेर्मोन पर्वत मुन्तिरको लेबनानमा भएको बेँसीको बाल-गादसम्म तिनले तिनीहरूका सबै राजाहरूलाई पक्रे, र तिनीहरूलाई मारे।<verse eid="JOS 11:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 11:18"/>यहोशूले यी सबै राजाहरू विरुद्ध लामो समयसम्म युद्ध गरे।<verse eid="JOS 11:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 11:19"/>गिबोनमा बस्‍ने हिव्वीहरूबाहेक एउटै पनि सहरले इस्राएलसँग शान्तिको सम्झौता गरेनन्। तर इस्राएलीहरूले तिनीहरू सबैलाई लडाइँमा जिते।<verse eid="JOS 11:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 11:20"/>किनकि याहवेह आफैँले इस्राएलसँग युद्ध गर्न तिनीहरूको हृदय कठोर तुल्याइदिनुभयो, ताकि याहवेहले मोशालाई आज्ञा दिनुभएझैँ इस्राएलले तिनीहरूलाई निर्दयतासाथ पूर्ण रूपले नाश गरोस्।<verse eid="JOS 11:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 11:21"/>त्यस बेला यहोशूले गएर अनाकीहरूलाई पहाडी मुलुकको हेब्रोन, दबीर र अनाब, यहूदाको पहाडी मुलुक अनि इस्राएलका सम्पूर्ण पहाडी मुलुकबाट नष्‍ट गरे। यहोशूले तिनीहरू र तिनीहरूका सहरहरूलाई पूर्ण रूपले नष्‍ट गरे।<verse eid="JOS 11:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 11:22"/>इस्राएली प्रान्तमा एउटै पनि अनाकी रहेनन्। तर गाजा, गात र अश्दोदमा कोही-कोही मात्र बाँचेका थिए।<verse eid="JOS 11:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 11:23"/>यसरी याहवेहले मोशालाई निर्देशन दिनुभएझैँ यहोशूले सम्पूर्ण देश कब्जामा लिए। अनि त्यस देशलाई इस्राएलीहरूका कुलको दलअनुसार पैतृक सम्पत्तिको रूपमा तिनीहरूलाई दिए। त्यसपछि देशले युद्धबाट विश्राम पायो।<verse eid="JOS 11:23"/></para>
<chapter eid="JOS 11"/>
<chapter number="12" style="c" sid="JOS 12"/>
<para style="p"><verse number="1" style="v" sid="JOS 12:1"/>यी तिनै राजाहरू हुन्, जो यर्दनको अराबाको पूर्वमा थिए, जसलाई इस्राएलीहरूले जिते, र तिनीहरूको देश कब्जा गरे। तिनीहरूको भूभागको सिमाना अर्नोन घाटीदेखि हेर्मोन पर्वतसम्म, र सम्पूर्ण भूमि समावेश थियो:<verse eid="JOS 12:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 12:2"/>एमोरीहरूका राजा सीहोन, जसले हेश्बोनमा राज्य गर्थे। तिनले अर्नोन घाटीमा अवस्थित अरोएरदेखि—बीचमा भएको सहरदेखि अम्मोनीहरूको सिमानामा भएको यब्बोक नदीसम्म शासन गर्थे। त्यसमा गिलादको आधा भाग पनि पर्थ्यो।<verse eid="JOS 12:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 12:3"/>तिनले गालील समुद्रदेखि अराबा समुद्र (खारा समुद्र) सम्म र पूर्वीय अराबामा बेथ-यशीमोत र त्यसपछि पिसगाको भिरालोमुनि दक्षिणको भागसम्म शासन गर्थे।<verse eid="JOS 12:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 12:4"/>अनि बाशानका राजा ओगको इलाका, जो रपाईहरूका आखिरी पुस्ता मध्येका एक जना थिए; जसले अस्तारोत र एद्रईमा राज्य गर्थे।<verse eid="JOS 12:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 12:5"/>तिनले हेर्मोन पर्वत, सलेका र सारा बाशानमा गेशूरीहरू र माकातीहरूको सिमानासम्म, अनि हेश्बोनका राजा सीहोनको सिमानासम्म र गिलादको आधा भागसम्म शासन गर्थे।<verse eid="JOS 12:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 12:6"/>याहवेहका सेवक मोशा र इस्राएलीहरूले तिनीहरूलाई जिते। अनि याहवेहका सेवक मोशाले ती राजाहरूका देश; रूबेनीहरू, गादीहरू र मनश्शेको आधा कुललाई तिनीहरूको पैतृक सम्पत्तिको रूपमा दिए।<verse eid="JOS 12:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 12:7"/>यहोशू र इस्राएलीहरूले यर्दनको पश्‍चिमपट्टि लेबनानको बेँसीमा भएको बाल-गाददेखि सेइरको उकालोतिर जाने हालाक पर्वतसम्म जितेका राजाहरू यिनै हुन्। तिनीहरूका देशहरू यहोशूले इस्राएलका कुलहरूलाई उत्तराधिकारको रूपमा तिनीहरूलाई दिए।<verse eid="JOS 12:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 12:8"/>ती भूमिहरू, पहाडी मुलुक, पश्‍चिमी फेदीहरू, अराबा, पर्वतीय भिरहरू, उजाडस्थान र दक्षिणी भागहरू हुन्। ती देशहरू हित्ती, एमोरी, कनानी, परिज्जी, हिव्वी र यबूसीहरूका थिए: यी राजाहरू थिए:<verse eid="JOS 12:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 12:9"/>यरीहोको राजा, एक, ऐको राजा, (बेथेलको छेउको) एक,<verse eid="JOS 12:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 12:10"/>यरूशलेमको राजा, एक, हेब्रोनको राजा, एक,<verse eid="JOS 12:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 12:11"/>यर्मूतको राजा, एक, लाकीशको राजा, एक,<verse eid="JOS 12:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 12:12"/>एग्लोनको राजा, एक, गेजेरको राजा, एक,<verse eid="JOS 12:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 12:13"/>दबीरको राजा, एक, गेदेरको राजा, एक,<verse eid="JOS 12:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 12:14"/>होर्माको राजा, एक, आरादको राजा, एक,<verse eid="JOS 12:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 12:15"/>लिब्नाको राजा, एक, अदुल्‍लामको राजा, एक,<verse eid="JOS 12:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 12:16"/>मक्‍केदाको राजा, एक, बेथेलको राजा, एक,<verse eid="JOS 12:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 12:17"/>तप्पूहको राजा, एक, हेपेरको राजा, एक,<verse eid="JOS 12:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 12:18"/>अपेकको राजा, एक, लश्शारोनको राजा, एक,<verse eid="JOS 12:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 12:19"/>मादोनको राजा, एक, हासोरको राजा, एक,<verse eid="JOS 12:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 12:20"/>शिम्रोन-मेरोनको राजा, एक, अक्षापको राजा, एक,<verse eid="JOS 12:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 12:21"/>तानाकको राजा, एक, मगिद्दोको राजा, एक,<verse eid="JOS 12:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 12:22"/>केदेशको राजा, एक, कर्मेलमा योक्नामको राजा, एक,<verse eid="JOS 12:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 12:23"/>नापोथमा डोरको राजा, एक, गिलगालमा गयीमको राजा, एक,<verse eid="JOS 12:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 12:24"/>तिर्साको राजा एक। जम्मा एकतीस जना राजाहरू थिए।<verse eid="JOS 12:24"/></para>
<chapter eid="JOS 12"/>
<chapter number="13" style="c" sid="JOS 13"/>
<para style="p"><verse number="1" style="v" sid="JOS 13:1"/>जब यहोशू धेरै वृद्ध भए, तब याहवेहले तिनलाई भन्‍नुभयो, “तँ धेरै वृद्ध भएको छस्। तर अधिकार गर्नुपर्ने देशहरू अझ धेरै छन्।<verse eid="JOS 13:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 13:2"/>“बाँकी रहेका देशहरू यिनै हुन्: “पलिश्तीहरू र गेशूरीहरूका समस्त इलाका:<verse eid="JOS 13:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 13:3"/>इजिप्टको पूर्वमा पर्ने शीहोर नदीदेखि उत्तरमा पर्ने एक्रोनका इलाकासम्म। यी इलाकाहरू कनानीहरूको भागमा गनिन्छ। यद्यपि त्यहाँ पाँच पलिश्ती शासकहरूले गाजा, अश्दोद, अश्कलोन, गित्ती र एक्रोनमा शासन गर्छन्। अनि अव्वीहरूको इलाका<verse eid="JOS 13:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 13:4"/>दक्षिणमा; कनानीहरूका सबै देशहरू, सीदोनीहरूको आरादेखि एमोरीहरूको इलाका अपेकसम्म;<verse eid="JOS 13:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 13:5"/>गबालीहरूको इलाका; समस्त पूर्वको लेबनान, हेर्मोन पर्वतको मुन्तिरको बाल-गाददेखि लेबो-हमातसम्म।<verse eid="JOS 13:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 13:6"/>“लेबनानदेखि मिस्रापोत-मैमसम्मका पहाडी क्षेत्रका सबै बासिन्दाहरू अर्थात् सीदोनीहरू, तिनीहरूलाई म आफैँले इस्राएलीहरूको सामुबाट निकालिदिनेछु। मैले तँलाई निर्देशन दिएअनुसार निश्‍चित रूपमा यो देश इस्राएलीहरूका निम्ति उत्तराधिकारस्वरूप छुट्याउनू।<verse eid="JOS 13:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 13:7"/>अनि यसलाई नौ वटा कुलहरू र मनश्शेका आधा कुलको बीचमा उत्तराधिकारको रूपमा बाँडिदिनू।”<verse eid="JOS 13:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 13:8"/>याहवेहका सेवक मोशाले तिनीहरूलाई अगिबाटै तोकिदिएअनुसार मनश्शेको आधा कुल, रूबेनीहरू र गादीहरूले यर्दनको पूर्वपट्टिका प्रान्तहरू उत्तराधिकारको रूपमा पाएका थिए।<verse eid="JOS 13:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 13:9"/>यो अर्नोनको घाटीको किनारमा भएको अरोएरदेखि घाटीको बीचमा भएको सहरसम्म फैलिएको थियो। अनि यसमा दीबोनसम्मै मेदेबाको पठार पनि सामेल थियो।<verse eid="JOS 13:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 13:10"/>अनि अम्मोनीहरूको सिमानासम्म एमोरीहरूका राजा सीहोनका सबै सहरहरू, जसले हेश्बोनमा राज्य गर्नेगर्थे।<verse eid="JOS 13:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 13:11"/>यसमा गेशूरी र माकातीहरूको इलाका गिलाद, सम्पूर्ण हेर्मोन पर्वत र सलेकासम्मै समस्त बाशान पनि पर्दथ्यो।<verse eid="JOS 13:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 13:12"/>अर्थात् अस्तारोत र एद्रईमाथि शासन गर्ने रपाईहरूका आखिरी पुस्ताहरूमध्येका एक जना बाशानका राजा ओगको समस्त राज्य पर्दथ्यो। मोशाले तिनीहरूलाई जितेर तिनीहरूका देश लिएका थिए।<verse eid="JOS 13:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 13:13"/>तर इस्राएलीहरूले गेशूरी र माकातीहरूलाई धपाएनन्। यसकारण तिनीहरू आजको दिनसम्म इस्राएलीहरूका बीचमा बसोबास गर्दैआएका छन्।<verse eid="JOS 13:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 13:14"/>तर मोशाले लेवीको कुललाई चाहिँ कुनै उत्तराधिकारको भाग दिएनन्। किनकि याहवेह इस्राएलका परमेश्‍वरले तिनीहरूलाई प्रतिज्ञा गर्नुभएझैँ, उहाँलाई चढाएका अन्‍नबलिहरू तिनीहरूको उत्तराधिकारको भाग थियो।<verse eid="JOS 13:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 13:15"/>मोशाले रूबेनको कुललाई वंशअनुसार दिएका भूमि यिनै हुन्:<verse eid="JOS 13:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 13:16"/>अर्नोनको घाटीको किनारमा भएको अरोएरको इलाका र घाटीको बीचमा भएको सहर र मेदेबा पारिको समस्त पठारदेखि<verse eid="JOS 13:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 13:17"/>हेश्बोन र पठारमा भएका सबै सहरहरू, जसमा दीबोन, बामोत-बाल, बेथ-बालमोन सामेल थिए।<verse eid="JOS 13:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 13:18"/>यहसा, कदेमोत, मेपात,<verse eid="JOS 13:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 13:19"/>किर्यातैम, सिब्मा, पहाडी बेँसीको सेरेथ-शेहार,<verse eid="JOS 13:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 13:20"/>बेथ-पोर, पिसगाको भिरालो पाखो र बेथ-यशीमोत,<verse eid="JOS 13:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 13:21"/>पठारका सबै सहरहरू र हेश्बोनमा शासन गर्ने एमोरीहरूको राजा सीहोनका सबै राज्यहरू। मोशाले तिनलाई र मिद्यानका मुखियाहरू एवी, रेकेम, सूर, हूर र रेवा त्यस देशमा बस्‍ने राजकुमारहरू जो सीहोनसँग मिलेका थिए, तिनीहरूलाई जितेका थिए।<verse eid="JOS 13:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 13:22"/>लडाइँमा मारिएकाहरूबाहेक, इस्राएलीहरूले बालामको छोरा बओरलाई तरवारले मारे, जसले जोखना हेर्ने गर्थे।<verse eid="JOS 13:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 13:23"/>रूबेनीहरूको सिमाना यर्दन नदीको किनार थियो। यी सहरहरू र गाउँहरूचाहिँ रूबेनीहरूका वंशअनुसार उत्तराधिकारको भाग थियो।<verse eid="JOS 13:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 13:24"/>मोशाले गादको कुललाई वंशअनुसार दिएका भूमि यिनै हुन्:<verse eid="JOS 13:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 13:25"/>याजेरको इलाका, गिलादका सबै सहरहरू रब्बाको नजिक अरोएरसम्मको अम्मोनीको आधा देश;<verse eid="JOS 13:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 13:26"/>अनि हेश्बोनदेखि रामत-मिस्पा र बेतोनीमसम्म, र महनाइमदेखि दबीरको इलाकासम्म;<verse eid="JOS 13:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 13:27"/>अनि बेँसीमा, बेथ-हाराम, बेथ-निम्रा, सुक्‍कोत र सापोनसँगै हेश्बोनको राजा सीहोनका बाँकिरहेको राज्यसम्म (यर्दनको पूर्वपट्टिको गालीलको समुद्रको अन्त्यसम्म)।<verse eid="JOS 13:27"/></para>
<para style="p"><verse number="28" style="v" sid="JOS 13:28"/>वंशअनुसार यी सहरहरू र तिनीहरूका गाउँहरू गादीहरूको पैतृक सम्पत्ति थियो।<verse eid="JOS 13:28"/></para>
<para style="p"><verse number="29" style="v" sid="JOS 13:29"/>मनश्शेको वंशअनुसार यसको आधा कुललाई, अर्थात् मनश्शेका सन्तानहरूका आधा परिवारलाई मोशाले दिएका भूमि यिनै थिए:<verse eid="JOS 13:29"/></para>
<para style="p"><verse number="30" style="v" sid="JOS 13:30"/>महनाइमदेखि बाशानको समस्त इलाकासम्म फैलिएको, बाशानका राजा ओगका समस्त राज्य, बाशानमा भएका याईरका सबै गाउँहरू, साठी वटा सहरहरू,<verse eid="JOS 13:30"/></para>
<para style="p"><verse number="31" style="v" sid="JOS 13:31"/>गिलादको आधा भाग र अस्तारोत र एद्रई (बाशानमा ओगका राजकीय सहरहरू)। योचाहिँ मनश्शेको छोरा माकीरका सन्तानहरूका लागि थियो। माकीरका छोराहरूलाई तिनीहरूका वंशअनुसार आधालाई दिइएको थियो।<verse eid="JOS 13:31"/></para>
<para style="p"><verse number="32" style="v" sid="JOS 13:32"/>यरीहोको पूर्वमा भएको यर्दनपारि मोआबको मैदानमा हुँदा मोशाले दिएको उत्तराधिकारको भाग यही थियो।<verse eid="JOS 13:32"/></para>
<para style="p"><verse number="33" style="v" sid="JOS 13:33"/>तर लेवीको कुललाई चाहिँ मोशाले कुनै उत्तराधिकारको भाग दिएका थिएनन्। तिनले उनीहरूलाई प्रतिज्ञा गरेझैँ, याहवेह इस्राएलका परमेश्‍वर नै तिनीहरूका उत्तराधिकारको भाग हुनुभयो।<verse eid="JOS 13:33"/></para>
<chapter eid="JOS 13"/>
<chapter number="14" style="c" sid="JOS 14"/>
<para style="p"><verse number="1" style="v" sid="JOS 14:1"/>इस्राएलले कनान देशमा उत्तराधिकारको रूपमा पाएका इलाकाहरू यिनै हुन्, जसलाई पुजारी एलाजार, नूनका छोरा यहोशू र इस्राएलका कुलका अगुवाहरूले तिनीहरूलाई बाँडिदिएका थिए।<verse eid="JOS 14:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 14:2"/>याहवेहले मोशाद्वारा आज्ञा दिनुभएझैँ तिनीहरूका उत्तराधिकारको भाग चिट्ठा हालेर साढे नौ कुललाई बाँडिदिएको थियो।<verse eid="JOS 14:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 14:3"/>मोशाले साढे दुई कुललाई तिनीहरूको उत्तराधिकारको रूपमा यर्दनको पूर्वपट्टिको भाग दिएका थिए। तर बाँकी रहेकाहरूमा लेवीहरूलाई कुनै उत्तराधिकारको भाग दिएका थिएनन्।<verse eid="JOS 14:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 14:4"/>किनकि योसेफका सन्तानबाट मनश्शे र एफ्राइम दुई कुलहरू भएका थिए। त्यसैले लेवीहरूले देशको कुनै पनि भाग पाएनन्; तर बस्‍नलाई सहरहरू र तिनीहरूका बगाल अनि बथानका निम्ति खर्कहरू मात्र पाए।<verse eid="JOS 14:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 14:5"/>यसरी याहवेहले मोशालाई आज्ञा दिनुभएजस्तै, इस्राएलीहरूले देशलाई विभाजन गरे।<verse eid="JOS 14:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 14:6"/>एक दिन यहूदाका मानिसहरूले यहोशूलाई गिलगालमा भेट गरे। अनि कनज्जी यपून्‍नेका छोरा कालेबले तिनलाई भने, “याहवेहले तपाईं र मेरो विषयमा परमेश्‍वरका जन मोशालाई कादेश-बर्नेमा भन्‍नुभएको कुरा तपाईंलाई थाहै छ।<verse eid="JOS 14:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 14:7"/>याहवेहका सेवक मोशाले मलाई यो देशको भेद लिनलाई कादेश-बर्नेबाट पठाउँदा म चालीस वर्षको थिएँ। अनि मैले तिनलाई आफ्नो सत्य बयान दिएँ।<verse eid="JOS 14:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 14:8"/>तर मसँग माथि जाने मेरा दाजुभाइहरूले मानिसहरूको हृदय भयभीत तुल्याइदिए। तर मैलेचाहिँ याहवेह मेरा परमेश्‍वरलाई सम्पूर्ण हृदयले पछ्याएँ।<verse eid="JOS 14:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 14:9"/>यसकारण त्यस दिन मोशाले मसँग, ‘तेरा पाइलाले टेकेको देश सधैँको निम्ति तँ र तेरा सन्तानहरूका निम्ति उत्तराधिकारको भाग हुनेछ। किनकि तैँले याहवेह मेरो परमेश्‍वरलाई सम्पूर्ण हृदयले पछ्याएको छस् भनी शपथ खानुभएको थियो।’<verse eid="JOS 14:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 14:10"/>“यसकारण जब इस्राएल उजाडस्थानमा भौँतारिँदै हिँडिरहेको बेला याहवेहले प्रतिज्ञा गर्नुभएझैँ, उहाँले यो कुरा मोशासँग भन्‍नुभएदेखि उसो उहाँले मलाई पैँतालीस वर्षसम्म जीवित राख्नुभएको छ। यसरी आजको दिन म पचासी वर्षको भएको छु!<verse eid="JOS 14:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 14:11"/>मोशाले मलाई जासुस गर्न पठाएको दिनमा जस्तै आज पनि म बलियो छु। म लडाइँमा जाँदा जति बलियो थिएँ, आज पनि त्यत्तिकै बलियो छु।<verse eid="JOS 14:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 14:12"/>अब त्यस दिन याहवेहले मलाई प्रतिज्ञा गर्नुभएझैँ, यो पहाडी मुलुक मलाई दिनुहोस्। त्यहाँ अनाकीहरू बस्दछन्। अनि तिनीहरूका सहरहरू ठूला र सुरक्षित छन् भनी तपाईं आफैँले सुन्‍नुभएको छ। तर याहवेहको सहायताले म तिनीहरूलाई धपाइदिनेछु।”<verse eid="JOS 14:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 14:13"/>तब यहोशूले यपून्‍नेका छोरा कालेबलाई आशिष् दिए। अनि तिनलाई तिनको उत्तराधिकारको रूपमा हेब्रोन दिए।<verse eid="JOS 14:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 14:14"/>यसरी त्यस दिनदेखि उसो हेब्रोन कनज्जी यपून्‍नेका छोरा कालेबको अधीनमा छ। किनकि तिनले याहवेह इस्राएलको परमेश्‍वरलाई सम्पूर्ण हृदयले पछ्याएका थिए।<verse eid="JOS 14:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 14:15"/>(हेब्रोनलाई किर्यत-अर्बा भनिन्थ्यो। अर्बाचाहिँ अनाकीहरू बीचका सबैभन्दा महान् मानिस थिए।) त्यसपछि देशलाई युद्धबाट विश्राम मिल्यो।<verse eid="JOS 14:15"/></para>
<chapter eid="JOS 14"/>
<chapter number="15" style="c" sid="JOS 15"/>
<para style="p"><verse number="1" style="v" sid="JOS 15:1"/>यहूदा कुलको भाग तिनीहरूको वंशअनुसार एदोमको इलाकासम्म थियो। सुदूर दक्षिणमा जीनको उजाडस्थानसम्म फैलिएको थियो।<verse eid="JOS 15:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 15:2"/>तिनीहरूको दक्षिणी सिमाना मृत सागरको अन्तिम भागमा भएको खाडीदेखि सुरु भएर,<verse eid="JOS 15:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 15:3"/>अक्रब्बीमको घाटी पार गर्दै जीनतिर लागेर कादेश-बर्नेको दक्षिणसम्म पुगेको थियो। त्यसपछि त्यो हेस्रोनलाई छिचोलेर अद्दारसम्म पुगेको थियो; र कर्काको चारैतिर घुमेको थियो।<verse eid="JOS 15:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 15:4"/>त्यसपछि त्यो अज्मोनतिर लागेर इजिप्टको बेँसीमा जोडिएर महासागरमा अन्त्य भएको थियो। यो तिनीहरूको दक्षिणी सिमाना हो।<verse eid="JOS 15:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 15:5"/>पूर्वीय सिमाना मृत सागरदेखि यर्दनको मुखैसम्म पर्थ्यो। उत्तरी सिमाना यर्दनको खाडीबाट सुरु हुन्थ्यो,<verse eid="JOS 15:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 15:6"/>जुन बेथ-होग्लासम्म पुगेर अगि बढ्दै बेथ-अराबामा गएर रूबेनको छोरो बोहनको ढुङ्गासम्म पुग्थ्यो।<verse eid="JOS 15:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 15:7"/>त्यसपछि आकोरको बेँसीबाट दबीरसम्म पुगेर दक्षिणतिर अदुम्मीमको घाटीतिर फर्केर उत्तरतिर गिलगालको सिमानासम्म पुगेको थियो। त्यो एन-शेमेशको पानीतिर बढेर एन-रोगेलबाट निस्केको थियो।<verse eid="JOS 15:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 15:8"/>त्यसपछि त्यो यबूसी सहर (अर्थात्, यरूशलेम) को भिरालो ठाउँको दक्षिणमा भएको बेन-हिन्‍नोमको बेँसीमा पुगेको थियो। त्यहाँबाट त्यो सिमाना रपाईको बेँसीको अन्त्य उत्तरपट्टि हिन्‍नोम बेँसीको पहाडसम्म पुगेको थियो।<verse eid="JOS 15:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 15:9"/>पहाडको टुप्पोबाट सिमाना अगि बढ्दै नेप्‍तोहको पानीको मूलतिर लागेर एप्रोन पर्वतको सहरहरूमा निस्केर बालातिर (अर्थात्, किर्यत-यारीम) तल झरेको थियो।<verse eid="JOS 15:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 15:10"/>त्यसपछि त्यो सिमाना बालाबाट पश्‍चिमतिर घुमेर सेइर पर्वतहुँदै, यारिम पर्वत (अर्थात्, कशालोन) को उत्तरतिर ओरालो गएर तिम्नासम्म पुगेको थियो।<verse eid="JOS 15:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 15:11"/>त्यो एक्रोनको उत्तरतिरको ओरालो गएर शिक्‍करोनतिर पुगेर बाला डाँडाबाट हुँदै यब्नेल पुगेको थियो। त्यो सिमाना महासागरमा समाप्‍त भएको थियो।<verse eid="JOS 15:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 15:12"/>पश्‍चिमी सिमाना महासागरको किनार थियो। यहूदाका मानिसहरू तिनीहरूका वंशअनुसार चारैतिरका सिमानाहरू यिनै हुन्।<verse eid="JOS 15:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 15:13"/>याहवेहले यहोशूलाई दिनुभएको आज्ञाअनुसार तिनले यपून्‍नेको छोरो कालेबलाई यहूदामा एक भाग दिए, किर्यत-अर्बा अर्थात् हेब्रोनलाई दिए। (अर्बाचाहिँ अनाकका पुर्खा थिए।)<verse eid="JOS 15:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 15:14"/>हेब्रोनबाट कालेबले तीन जना अनाकीहरू अर्थात् अनाकका छोराहरू, शेशै, अहीमन र तल्मैलाई धपाइदिए।<verse eid="JOS 15:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 15:15"/>त्यहाँबाट तिनले दबीरमा (पहिले किर्यत-सेपेर भनिन्थ्यो) बस्‍ने मानिसहरूको विरुद्धमा युद्ध गरे।<verse eid="JOS 15:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 15:16"/>अनि कालेबले भने, “म मेरी छोरी अक्साको विवाह किर्यत-सेपेरमाथि आक्रमण गरेर जित्ने मानिससँग गरिदिनेछु।”<verse eid="JOS 15:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 15:17"/>कालेबको भाइ कनजका छोरा ओत्निएलले त्यसलाई जित्यो। अनि कालेबले आफ्नी छोरी अक्सालाई ओत्निएलसँग विवाह गरिदिए।<verse eid="JOS 15:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 15:18"/>एक दिन तिनी ओत्निएलकहाँ जाँदा तिनले आफ्नो पिताबाट एउटा जमिन माग्न भनी उनलाई सुर्‍याए। अक्सा आफ्नो गधाबाट ओर्लेपछि कालेबले तिनलाई सोधे, “म तिम्रा निम्ति के गर्न सक्छु?”<verse eid="JOS 15:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 15:19"/>तिनले जवाफ दिइन्, “ममाथि एउटा विशेष कृपा गर्नुहोस्। तपाईंले मलाई दक्षिणमा एउटा जमिन दिनुभएको हुनाले मलाई पानीका मूलहरू पनि दिनुहोस्।” तब कालेबले तिनलाई माथिल्‍ला र तलका पानीका मूलहरू दिए।<verse eid="JOS 15:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 15:20"/>यहूदाको कुलको वंशअनुसार तिनीहरूका उत्तराधिकारको भाग यिनै हुन्:<verse eid="JOS 15:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 15:21"/>एदोमको सिमानातिर यहूदाको कुलको सुदूर दक्षिणतिरका सहरहरू यिनै हुन्: कब्सेल, एदेर, यागूर,<verse eid="JOS 15:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 15:22"/>कीना, दीमोना, अदादा,<verse eid="JOS 15:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 15:23"/>केदेश, हासोर, यित्नान,<verse eid="JOS 15:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 15:24"/>जीप, तेलेम, बालोत,<verse eid="JOS 15:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 15:25"/>हासोर-हादत्ता, किर्योत-हेस्रोन (अर्थात् हासोर),<verse eid="JOS 15:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 15:26"/>अमाम, शेमा, मोलादा,<verse eid="JOS 15:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 15:27"/>हसर-गद्दा, हेश्मोन, बेथ-पेलेत,<verse eid="JOS 15:27"/></para>
<para style="p"><verse number="28" style="v" sid="JOS 15:28"/>हसर-शूआल, बेर्शेबा, बिज्योत्या,<verse eid="JOS 15:28"/></para>
<para style="p"><verse number="29" style="v" sid="JOS 15:29"/>बाला, ईम, एसेम,<verse eid="JOS 15:29"/></para>
<para style="p"><verse number="30" style="v" sid="JOS 15:30"/>एल्तोलद, कसील, होर्मा,<verse eid="JOS 15:30"/></para>
<para style="p"><verse number="31" style="v" sid="JOS 15:31"/>सिक्लग, मदमन्‍ना, सन्सन्‍ना,<verse eid="JOS 15:31"/></para>
<para style="p"><verse number="32" style="v" sid="JOS 15:32"/>लबाओत, शिल्हीम, ऐन र रिम्मोन—जम्मा उनन्तीस वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 15:32"/></para>
<para style="p"><verse number="33" style="v" sid="JOS 15:33"/>पश्‍चिमी फेदीमा: एश्तोल, सोरा, अश्ना,<verse eid="JOS 15:33"/></para>
<para style="p"><verse number="34" style="v" sid="JOS 15:34"/>जानोह, एन-गन्‍नीम, तप्पूह, एनाम,<verse eid="JOS 15:34"/></para>
<para style="p"><verse number="35" style="v" sid="JOS 15:35"/>यर्मूत, अदुल्‍लाम, सोको, अजेका,<verse eid="JOS 15:35"/></para>
<para style="p"><verse number="36" style="v" sid="JOS 15:36"/>शारैम, अदीतैम र गदेरा, (गदेरोतेम), जम्मा चौध वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 15:36"/></para>
<para style="p"><verse number="37" style="v" sid="JOS 15:37"/>सनान, हदाशा, मिग्दल-गाद,<verse eid="JOS 15:37"/></para>
<para style="p"><verse number="38" style="v" sid="JOS 15:38"/>दिलान, मिस्पा, योक्तेल,<verse eid="JOS 15:38"/></para>
<para style="p"><verse number="39" style="v" sid="JOS 15:39"/>लाकीश, बोस्कत, एग्लोन,<verse eid="JOS 15:39"/></para>
<para style="p"><verse number="40" style="v" sid="JOS 15:40"/>कोब्बन, लहमास, कितलीश,<verse eid="JOS 15:40"/></para>
<para style="p"><verse number="41" style="v" sid="JOS 15:41"/>गदेरोत, बेथ-दागोन, नामा र मक्‍केदाका—सोह्र वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 15:41"/></para>
<para style="p"><verse number="42" style="v" sid="JOS 15:42"/>लिब्ना, एतेर, आशान,<verse eid="JOS 15:42"/></para>
<para style="p"><verse number="43" style="v" sid="JOS 15:43"/>यिप्‍ताह, अश्ना, नसीब,<verse eid="JOS 15:43"/></para>
<para style="p"><verse number="44" style="v" sid="JOS 15:44"/>कीलाह, अक्जीब र मारेशा—जम्मा नौ वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 15:44"/></para>
<para style="p"><verse number="45" style="v" sid="JOS 15:45"/>एक्रोन र त्यसका चारैतिरका बस्तीहरू र गाउँहरू;<verse eid="JOS 15:45"/></para>
<para style="p"><verse number="46" style="v" sid="JOS 15:46"/>एक्रोनको पश्‍चिम र अश्दोदका सबै सहरहरूसँगै तिनीहरूका गाउँहरू।<verse eid="JOS 15:46"/></para>
<para style="p"><verse number="47" style="v" sid="JOS 15:47"/>अश्दोद र त्यसका चारैतिरका बस्तीहरू र गाउँहरू; गाजा, त्यसका सहरहरू र बस्तीहरूसमेत, इजिप्टको बेँसीसम्म र महासागरको किनारसम्म।<verse eid="JOS 15:47"/></para>
<para style="p"><verse number="48" style="v" sid="JOS 15:48"/>पहाडी मुलुकमा: शामीर, यत्तीर, सोको,<verse eid="JOS 15:48"/></para>
<para style="p"><verse number="49" style="v" sid="JOS 15:49"/>दन्‍ना, किर्यत-सन्‍ना (अर्थात् दबीर),<verse eid="JOS 15:49"/></para>
<para style="p"><verse number="50" style="v" sid="JOS 15:50"/>अनाब, एश्तमोह, अनीम,<verse eid="JOS 15:50"/></para>
<para style="p"><verse number="51" style="v" sid="JOS 15:51"/>गोशेन, होलोन र गीलोह—एघार वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 15:51"/></para>
<para style="p"><verse number="52" style="v" sid="JOS 15:52"/>अरब, दुमा, एशान,<verse eid="JOS 15:52"/></para>
<para style="p"><verse number="53" style="v" sid="JOS 15:53"/>यानीम, बेथ-तप्पूह, अपेका,<verse eid="JOS 15:53"/></para>
<para style="p"><verse number="54" style="v" sid="JOS 15:54"/>हुम्ता, किर्यत-अर्बा (अर्थात्, हेब्रोन) र सीओर—नौ वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 15:54"/></para>
<para style="p"><verse number="55" style="v" sid="JOS 15:55"/>माओन, कर्मेल, जीप, युत्ता,<verse eid="JOS 15:55"/></para>
<para style="p"><verse number="56" style="v" sid="JOS 15:56"/>यिजरेल, योक्दाम, जानोह,<verse eid="JOS 15:56"/></para>
<para style="p"><verse number="57" style="v" sid="JOS 15:57"/>कैन, गेबा र तिम्ना—दश वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 15:57"/></para>
<para style="p"><verse number="58" style="v" sid="JOS 15:58"/>हलहूल, बेथ-सूर, गदोर,<verse eid="JOS 15:58"/></para>
<para style="p"><verse number="59" style="v" sid="JOS 15:59"/>मारात, बेथ-अनोत र एल्तकोन—छ वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 15:59"/></para>
<para style="p"><verse number="60" style="v" sid="JOS 15:60"/>किर्यत-बाल (अर्थात्, किर्यत-यारीम) र रब्बा—दुई वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 15:60"/></para>
<para style="p"><verse number="61" style="v" sid="JOS 15:61"/>उजाडस्थानमा: बेथ-अराबा, मिद्दीन, सेकाका,<verse eid="JOS 15:61"/></para>
<para style="p"><verse number="62" style="v" sid="JOS 15:62"/>नुनको सहर निब्शान र एन-गदी—छ वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 15:62"/></para>
<para style="p"><verse number="63" style="v" sid="JOS 15:63"/>यहूदाका मानिसहरूले यरूशलेममा बस्‍ने यबूसीहरूलाई धपाउन सकेनन्। ती यबूसीहरू आजको दिनसम्म यहूदाका मानिसहरूसँग बस्छन्।<verse eid="JOS 15:63"/></para>
<chapter eid="JOS 15"/>
<chapter number="16" style="c" sid="JOS 16"/>
<para style="p"><verse number="1" style="v" sid="JOS 16:1"/>योसेफका सन्तानको निम्ति अधिकारको भाग यरीहोको पूर्वपट्टिको मूल यर्दनदेखि सुरु भएर त्यहाँबाट उकालो हुँदै मरुभूमिलाई छिचोल्दै बेथेलको पहाडी देशसम्म पुगेको थियो।<verse eid="JOS 16:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 16:2"/>त्यो बेथेल अर्थात्, लूजदेखि अगि बढेर अरकीहरू बसेका अतारोत प्रान्तसम्म पुगेको थियो।<verse eid="JOS 16:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 16:3"/>त्यसपछि पश्‍चिमतिर यल्पेतीहरूको इलाका हुँदै ओर्लेर तल्‍लो बेथ-होरोनको इलाका भएर गेजेरसम्म पुगेर समुद्रमा टुङ्गिएको थियो।<verse eid="JOS 16:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 16:4"/>यसरी योसेफका सन्तानहरू एफ्राइम र मनश्शेले, तिनीहरूका उत्तराधिकारको भाग पाए।<verse eid="JOS 16:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 16:5"/>एफ्राइमको इलाका, तिनीहरूका वंशअनुसार यस्तो थियो: पूर्वमा तिनीहरूको सिमाना अतारोत-अद्दारदेखि उक्लेर माथिल्‍लो बेथ-होरोन हुँदै,<verse eid="JOS 16:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 16:6"/>महासागरसम्म पुगेको थियो। उत्तरमा मिक्मतातबाट पूर्वमा तानत-शीलोतिर घुमेर त्यसबाट पार भएर यानोहसम्म पुगेको थियो।<verse eid="JOS 16:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 16:7"/>त्यसपछि यानोहबाट तल झरेर अतारोत र नारामा पुगेर यरीहोलाई छुँदै, यर्दनबाट निस्केको थियो।<verse eid="JOS 16:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 16:8"/>तप्पूहबाट त्यो सिमाना पश्‍चिममा कनाको खोल्सामा पुगेर महासागरमा समाप्‍त भएको थियो। एफ्राइम कुलको वंशअनुसार, तिनीहरूका उत्तराधिकारको भाग यही थियो।<verse eid="JOS 16:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 16:9"/>यसबाहेक मनश्शेहरूको उत्तराधिकारभित्र एफ्राइम वंशहरूका निम्ति अलग गरिएका सबै सहरहरू र तिनीहरूका गाउँहरू पनि सामेल थिए।<verse eid="JOS 16:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 16:10"/>तिनीहरूले गेजेरमा बस्‍ने कनानीहरूलाई निकालेनन्। आजको दिनसम्म कनानीहरू एफ्राइमका मानिसहरूसँग बसेका छन्, तर तिनीहरू दास भएर बसेका छन्।<verse eid="JOS 16:10"/></para>
<chapter eid="JOS 16"/>
<chapter number="17" style="c" sid="JOS 17"/>
<para style="p"><verse number="1" style="v" sid="JOS 17:1"/>त्यसपछि योसेफको पहिलो सन्तान मनश्शेको कुललाई छुट्ट्याइएको भाग यही थियो। माकीरचाहिँ गिलादीहरूका पुर्खा थिए; जसले गिलाद र बाशान पाएका थिए। किनकि माकीरहरू महान् योद्धाहरू थिए।<verse eid="JOS 17:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 17:2"/>यसकारण यो भागचाहिँ मनश्शेका बाँकी रहेका मानिसहरू—अबीएजेर, हेलेक, अस्रीएल, शेकेम, हेपेर र शमीदाका वंशहरूका लागि थियो। तिनीहरू आफ्ना वंशअनुसार योसेफका छोरा मनश्शेका कुलका मुखियाहरू हुन्।<verse eid="JOS 17:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 17:3"/>मनश्शेका छोरा माकीर, तिनका छोरा गिलाद, तिनका छोरा हेपेर, तिनका छोरा सलोफादका कुनै छोराहरू थिएनन्; तर छोरीहरू मात्र थिए। तिनीहरू महला, नोआ, होग्ला, मिल्का र तिर्सा नाम भएका थिए।<verse eid="JOS 17:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 17:4"/>तिनीहरू पुजारी एलाजार, नूनका छोरा यहोशू र अगुवाहरूकहाँ गएर भने, “हामीलाई हाम्रा दाजुभाइहरूसँग नै अधिकार दिनू भनेर याहवेहले मोशालाई आज्ञा दिनुभएको थियो।” यसकारण यहोशूले तिनीहरूलाई याहवेहको आज्ञाअनुसार तिनीहरूका बुबाका दाजुभाइहरूसँग उत्तराधिकारको भाग दिए।<verse eid="JOS 17:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 17:5"/>मनश्शेको भागमा यर्दनको पूर्वपट्टिको गिलाद र बाशानको छेउमा भएका ठाउँका दश वटा भागहरू पर्‍यो।<verse eid="JOS 17:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 17:6"/>किनकि मनश्शेको कुलका छोरीहरूले छोराहरूसँगै उत्तराधिकार पाएका थिए। गिलादचाहिँ मनश्शेका बाँकी रहेका सन्तानहरूका निम्ति दिइयो।<verse eid="JOS 17:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 17:7"/>मनश्शेको प्रान्त आशेरदेखि शेकेमको पूर्वपट्टि मिक्मतातसम्म फैलिएको थियो। त्यहाँदेखि सिमाना दक्षिणतिर बढेर एन-तप्पूहमा बस्‍ने बासिन्दाहरूसम्म पुगेको थियो।<verse eid="JOS 17:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 17:8"/>(मनश्शेसँग तप्पूहको जमिन थियो। तर मनश्शेको सिमानामा भएको तप्पूहचाहिँ एफ्राएमीहरूको थियो।)<verse eid="JOS 17:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 17:9"/>त्यसपछि त्यो सिमाना दक्षिणतिर अगि बढेर कनाको खोल्सासम्म पुगेको थियो। त्यहाँ मनश्शेका सहरहरूमा बस्‍ने एफ्राएमीहरूका सहरहरू थिए। तर मनश्शेको सिमाना खोल्साको उत्तरपट्टि थियो, र महासागरमा टुङ्गिएको थियो।<verse eid="JOS 17:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 17:10"/>दक्षिणपट्टिको भाग एफ्राइमको थियो र उत्तरमा मनश्शेको थियो। मनश्शेको प्रान्त महासागरमा पुगेको थियो। अनि उत्तरतिर आशेरको र पूर्वपट्टि इस्साखारको सिमाना थियो।<verse eid="JOS 17:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 17:11"/>इस्साखार र आशेरभित्र बेथ-शान, यिबलाम र डोर, एन्दोर, तानाक र मगिद्दोका मानिसहरू साथै चारैतिरका बस्तीहरू पनि मनश्शेका थिए (त्यस सूचीमा तेस्रोचाहिँ नापोत हो)।<verse eid="JOS 17:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 17:12"/>तैपनि मनश्शेका सन्तानहरूले यी सहरहरू अधिकार गर्न सकेनन्; किनकि कनानीहरूले त्यस इलाकामा बस्‍ने निश्‍चय गरेका थिए।<verse eid="JOS 17:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 17:13"/>तर पनि जब इस्राएलीहरू बलिया भए, तब तिनीहरूले कनानीहरूलाई जबरजस्ती मजदुरीमा खटाए। तर तिनीहरूलाई पूर्ण रूपले धपाएनन्।<verse eid="JOS 17:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 17:14"/>योसेफका मानिसहरूले यहोशूलाई भने, “किन तपाईंले हामीलाई उत्तराधिकारको एउटै बाँडफाँडमा एक भाग मात्र दिनुभयो? जबकि हामी संख्यामा धेरै छौँ। अनि याहवेहले हामीलाई प्रशस्त मात्रामा आशिष् दिनुभएको छ।”<verse eid="JOS 17:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 17:15"/>यहोशूले जवाफ दिए, “यदि तिमीहरू संख्यामा धेरै छौ, र एफ्राइमको पहाडी मुलुक तिमीहरूका लागि अति सानो भएको छ भने परिज्जी र रपाईहरूको देशमा गएर आफ्ना लागि जङ्गल फँडानी गर।”<verse eid="JOS 17:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 17:16"/>योसेफका मानिसहरूले जवाफ दिए, “त्यो पहाडी मुलुक हाम्रा निम्ति पर्याप्‍त छैन। अनि मैदानमा बस्‍ने कनानीहरूसँग, बेथ-शान र त्यसमा बस्‍नेहरू अनि यिजरेलको बेँसीमा बस्‍ने सबैसँग फलामका रथहरू छन्।”<verse eid="JOS 17:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 17:17"/>तर यहोशूले योसेफको कुल—एफ्राइम र मनश्शेलाई भने, “तिमीहरू संख्यामा धेरै छौ; र अति शक्तिशाली पनि छौ। त्यसैले तिमीहरूको एउटा मात्र भाग हुनेछैन।<verse eid="JOS 17:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 17:18"/>यहाँ जङ्गल भएको पहाडी मुलुक पनि छ। त्यसलाई फँडानी गर। अनि त्यसको पल्‍लो छेउसम्म नै त्यो तिमीहरूको हुनेछ। कनानीहरूसँग फलामका रथहरू भए तापनि र तिनीहरू बलिया भए तापनि तिमीहरूले तिनीहरूलाई धपाउन सक्नेछौ।”<verse eid="JOS 17:18"/></para>
<chapter eid="JOS 17"/>
<chapter number="18" style="c" sid="JOS 18"/>
<para style="p"><verse number="1" style="v" sid="JOS 18:1"/>इस्राएलका सम्पूर्ण समुदाय शीलोमा भेला भए। अनि त्यहाँ भेट हुने पाल खडा गरे। त्यो देश तिनीहरूको अधीनमा आइसकेको थियो।<verse eid="JOS 18:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 18:2"/>तर इस्राएलीहरूका सात वटा कुलहरू बाँकी थिए, जसले उत्तराधिकारको भाग अझै पाएका थिएनन्।<verse eid="JOS 18:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 18:3"/>यसकारण यहोशूले इस्राएलीहरूलाई भने: “याहवेह तिमीहरूका पितापुर्खाका परमेश्‍वरले तिमीहरूलाई दिनुभएको देश अधिकार गर्न कहिलेसम्म तिमीहरू पर्खिरहन्छौ?<verse eid="JOS 18:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 18:4"/>हरेक कुलबाट तीन जना मानिसहरू नियुक्त गर। म तिनीहरूलाई देशको सर्वेक्षण गर्न र प्रत्येकको उत्तराधिकारको भागअनुसार त्यसको विवरण लेख्न पठाउनेछु। तब तिनीहरू मकहाँ फर्कनेछन्।<verse eid="JOS 18:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 18:5"/>तिमीहरूले त्यस देशलाई सात भागमा बाँड्नू। यहूदा दक्षिणमा भएको आफ्नो प्रान्तमा रहोस्। अनि योसेफको घरानाचाहिँ उत्तरमा तिनीहरूकै प्रान्तमा रहून्।<verse eid="JOS 18:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 18:6"/>तिमीहरूले ती सात भागहरूका विवरण लेखिसकेपछि त्यो यहाँ मकहाँ ल्याओ। अनि म याहवेह हाम्रा परमेश्‍वरको उपस्थितिमा तिमीहरूका निम्ति चिट्ठा हालिदिनेछु।<verse eid="JOS 18:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 18:7"/>तैपनि तिमीहरूसँग भएका लेवीहरूले तिमीहरूसँग कुनै अंश पाउनेछैनन्। किनकि याहवेहको पुजारी सेवा नै तिनीहरूको उत्तराधिकारको भाग हो। अनि गाद, रूबेन र मनश्शेको आधा कुलले आफ्ना उत्तराधिकारको भाग यर्दनको पूर्वपट्टि अगाडि नै पाइसकेका छन्। याहवेहका सेवक मोशाले त्यो तिनीहरूलाई दिएका थिए।”<verse eid="JOS 18:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 18:8"/>ती मानिसहरू त्यस देशको नक्सा बनाउन जान लाग्दा यहोशूले तिनीहरूलाई यसो भनेर निर्देशन दिए, “जाओ, र त्यस देशको सर्वेक्षण गर। अनि त्यसको विवरण लेख। त्यसपछि मकहाँ फर्केर आओ, र म यहाँ शीलोमा याहवेहको उपस्थितिमा तिमीहरूका निम्ति चिट्ठा हालिदिनेछु।”<verse eid="JOS 18:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 18:9"/>यसकारण ती मानिसहरू गएर त्यस देशभरि घुमे। तिनीहरूले सात भागको विवरण चर्मपत्रमा लेखे। अनि प्रत्येक भागमा पर्ने सहरहरूको सूची बनाए, र यहोशूकहाँ शीलोमा भएको छाउनीमा फर्किआए।<verse eid="JOS 18:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 18:10"/>त्यसपछि यहोशूले शीलोमा याहवेहको उपस्थितिमा तिनीहरूका निम्ति चिट्ठा हाले। त्यहाँ तिनले तिनीहरूको कुलअनुसार त्यो देश इस्राएलीहरूलाई भाग लगाइदिए।<verse eid="JOS 18:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 18:11"/>पहिलो चिट्ठा बेन्यामीनको कुलको वंशलाई पर्‍यो। तिनीहरूको भागमा परेको प्रान्त यहूदा र योसेफका बीचमा पर्‍यो।<verse eid="JOS 18:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 18:12"/>उत्तरतिर तिनीहरूको सिमाना यर्दनमा सुरु भएर यरीहोको उत्तरीय ओरालो भएर पश्‍चिमतिरको पहाडी मुलुक हुँदै बेथ-आवेनको उजाडस्थानमा निस्केको थियो।<verse eid="JOS 18:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 18:13"/>त्यहाँबाट त्यो पार भएर दक्षिणतिरको लूज (अर्थात्, बेथेल) को भिरमा पुगेर तल्‍लो बेथ-होरोनको दक्षिणको पहाडमा भएको अतारोत-अद्दारमा झरेको थियो।<verse eid="JOS 18:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 18:14"/>दक्षिणतिर भएको बेथ-होरोनतिर फर्केको पहाडको सिमाना पश्‍चिमतिर हुँदै दक्षिणतिर मोडिन्थ्यो। अनि यहूदाको सहर किर्यत-बालमा (अर्थात्, किर्यत-यारीम) निस्कन्थ्यो। पश्‍चिमी सिमाना यही थियो।<verse eid="JOS 18:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 18:15"/>दक्षिण भागको सिमाना पश्‍चिम किर्यत-यारीमको दुर्गम भागमा सुरु भएर त्यो सिमाना नेप्‍तोहको पानीको मूलमा निस्केको थियो।<verse eid="JOS 18:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 18:16"/>त्यो सिमाना रपाईको बेँसीको उत्तरमा भएको बेन-हिन्‍नोमको बेँसीतिर फर्केको पहाडको फेदतिर झरेको थियो। त्यो दक्षिणपट्टि यबूसी सहरको ओरालो हुँदै हिन्‍नोम बेँसीमा भएर एन-रोगेलसम्म पुगेको थियो।<verse eid="JOS 18:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 18:17"/>त्यसपछि त्यो उत्तरतिर मोडिएर एन-शेमेशमा हुँदै अदुम्मीमको घाटीतिर फर्केको गलिलोत भएर रूबेनका छोरा बोहनको ढुङ्गामा पुगेको थियो।<verse eid="JOS 18:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 18:18"/>त्यो उत्तरपट्टि बेथ-अराबाको भिरालोतिर बढेर अराबामा झरेको थियो।<verse eid="JOS 18:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 18:19"/>तब त्यो बेथ-होग्लाको उत्तरी भिरालोतिर हुँदै उत्तरीय मृत सागरको खाडीमा टुङ्गिएको थियो, जुन दक्षिणतिरको यर्दन नदीको अन्त्यमा पर्दथ्यो। योचाहिँ दक्षिणको सिमाना थियो।<verse eid="JOS 18:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 18:20"/>यर्दन नदी पूर्वपट्टिको सिमाना थियो। यी बेन्यामीनका कुलहरूको उत्तराधिकारको चारैतिर लगाइएका सिमानाहरूका चिन्ह थिए।<verse eid="JOS 18:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 18:21"/>यी बेन्यामीनको कुलको वंशअनुसारका सहरहरू थिए: यरीहो, बेथ-होग्ला, एमेक-कसीस,<verse eid="JOS 18:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 18:22"/>बेथ-अराबा, समारैम, बेथेल,<verse eid="JOS 18:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 18:23"/>अव्वीम, पारा, ओप्रा,<verse eid="JOS 18:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 18:24"/>कपर-अमोनी, ओप्नी र गेबा गरी बाह्र सहरहरू र तिनीहरूका गाउँहरू थिए।<verse eid="JOS 18:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 18:25"/>गिबोन, रामा, बेरोत,<verse eid="JOS 18:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 18:26"/>मिस्पा, कपीरा, मोसा,<verse eid="JOS 18:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 18:27"/>रेकेम, यिर्पल, तरला,<verse eid="JOS 18:27"/></para>
<para style="p"><verse number="28" style="v" sid="JOS 18:28"/>सेलाह, एलेप, यबूसी सहर (अर्थात्, यरूशलेम) गेबा र किर्यत गरी चौध वटा सहरहरू र तिनीहरूका गाउँहरू। बेन्यामीनको वंशहरूका निम्ति तिनीहरूको उत्तराधिकारको भाग यही नै थियो।<verse eid="JOS 18:28"/></para>
<chapter eid="JOS 18"/>
<chapter number="19" style="c" sid="JOS 19"/>
<para style="p"><verse number="1" style="v" sid="JOS 19:1"/>दोस्रो चिट्ठा वंशअनुसार शिमियोनको कुललाई पर्‍यो। तिनीहरूको उत्तराधिकारको भाग यहूदाको इलाकाभित्र पर्थ्यो।<verse eid="JOS 19:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 19:2"/>तिनीहरूको भागमा यी सहरहरू थिए: बेर्शेबा (अर्थात्, शेबा), मोलादा,<verse eid="JOS 19:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 19:3"/>हसर-शूआल, बाला, एसेम,<verse eid="JOS 19:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 19:4"/>एल्तोलद, बतूल, होर्मा,<verse eid="JOS 19:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 19:5"/>सिक्लग, बेथ-मर्काबोत, हसर-सूसा,<verse eid="JOS 19:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 19:6"/>बेथ-लबाओत र शारूहेन गरी तेह्र वटा सहरहरू र तिनीहरूका गाउँहरू।<verse eid="JOS 19:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 19:7"/>ऐन, रिम्मोन, एतेर र आशान गरी चार वटा सहरहरू र तिनीहरूका गाउँहरू,<verse eid="JOS 19:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 19:8"/>अनि बालाथ-बेर (दक्षिणमा रामा) सम्म चारैतिरका सहरहरूका सबै गाउँहरू। योचाहिँ वंशअनुसार शिमियोनको कुलको उत्तराधिकार थियो।<verse eid="JOS 19:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 19:9"/>शिमियोनीहरूको उत्तराधिकारको भाग यहूदाको भागबाट लिइएको थियो। किनकि यहूदाको भाग तिनीहरूलाई चाहिएको भन्दा धेरै थियो। यसरी शिमियोनीहरूले आफ्नो उत्तराधिकारको भाग यहूदाको इलाकाभित्र पाए।<verse eid="JOS 19:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 19:10"/>तेस्रो चिट्ठा वंशअनुसार जबूलूनको कुलका निम्ति निस्क्यो: तिनीहरूको उत्तराधिकारको सिमाना सारीदसम्म पुग्थ्यो।<verse eid="JOS 19:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 19:11"/>पश्‍चिमतिर त्यो मरलामा पुगेर दब्बेशेतलाई छोएर योक्नामको छेउको खोल्सासम्म फैलिएको थियो।<verse eid="JOS 19:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 19:12"/>सारीदबाट त्यो पूर्वपट्टि घुमेर सूर्योदय हुने किस्लोथ-तबोरको इलाकापट्टि हुँदै, दाबरतदेखि माथि याफियासम्म पुगेको थियो।<verse eid="JOS 19:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 19:13"/>त्यसपछि त्यो पूर्वपट्टि बढेर गात-हेपेर र इथ-कासीनमा हुँदै, रिम्मोनबाट निस्केर नेआ भएतिर घुमेको थियो।<verse eid="JOS 19:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 19:14"/>अनि त्यो सिमाना उत्तरतर्फ हन्‍नतोनतिर घुमेर यिप्‍ताह-एलको बेँसीमा टुङ्गिएको थियो।<verse eid="JOS 19:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 19:15"/>त्यसमा काथाथ, नहलल, शिम्रोन, इदलाह र बेथलेहेम गरी जम्मा बाह्र वटा सहरहरू र तिनीहरूका गाउँहरू थिए।<verse eid="JOS 19:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 19:16"/>यी सहरहरू र तिनीहरूका गाउँहरू वंशअनुसार जबूलूनको उत्तराधिकारको भाग थियो।<verse eid="JOS 19:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 19:17"/>चौथो चिट्ठा वंशअनुसार इस्साखारको कुललाई पर्‍यो।<verse eid="JOS 19:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 19:18"/>तिनीहरूका इलाकामा यी सहरहरू सामेल थिए: यिजरेल, कसुल्‍लोत, शूनेम,<verse eid="JOS 19:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 19:19"/>हपारैम, शीओन, अनाहारत,<verse eid="JOS 19:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 19:20"/>रब्बीत, किश्योन, एबेस,<verse eid="JOS 19:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 19:21"/>रेमेत, एन-गन्‍नीम, एन-हद्दा र बेथ-पसेस।<verse eid="JOS 19:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 19:22"/>सिमानाले तबोर, शहसूमा र बेथ-शेमेशलाई छोएर यर्दन नदीमा टुङ्गिन्थ्यो। यसका सोह्र वटा सहरहरू र तिनीहरूका गाउँहरू थिए।<verse eid="JOS 19:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 19:23"/>यी सहरहरू र तिनीहरूका गाउँहरू वंशअनुसार इस्साखारको कुलको उत्तराधिकारको भाग थियो।<verse eid="JOS 19:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 19:24"/>पाँचौँ चिट्ठा वंशअनुसार आशेरको कुललाई पर्‍यो।<verse eid="JOS 19:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 19:25"/>तिनीहरूको भागमा यी सहरहरू सामेल थिए: हेल्कत, हली, बेतेन, अक्षाप,<verse eid="JOS 19:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 19:26"/>अल्‍लम्मेलेक, अमाद र मिशाल। पश्‍चिमतिर सिमानाले कर्मेल र शीहोर-लिब्नातलाई छुन्थ्यो।<verse eid="JOS 19:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 19:27"/>त्यसपछि त्यो पूर्वमा बेथ-दागोनतिर फर्केर जबूलून र यिप्‍ताह-एलको बेँसीलाई छोएर, उत्तरतिर बेथ-एमेक र देब्रेपट्टि काबूललाई पार गरेर नीएलमा पुगेको थियो।<verse eid="JOS 19:27"/></para>
<para style="p"><verse number="28" style="v" sid="JOS 19:28"/>त्यो अब्डोन, रहोब, हम्मोन र कना भएर महा सीदोनसम्म पुगेको थियो।<verse eid="JOS 19:28"/></para>
<para style="p"><verse number="29" style="v" sid="JOS 19:29"/>त्यसपछि सिमाना रामातिर फर्केर टायरको किल्‍लामा हुँदै होसातिर मोडिन्थ्यो। अनि अक्जीबको इलाकामा महासागरमा निस्किआएको थियो।<verse eid="JOS 19:29"/></para>
<para style="p"><verse number="30" style="v" sid="JOS 19:30"/>उम्मा, अपेक र रहोब पनि तिनीहरूको इलाकामा पर्दथे। यसका बाइस वटा सहरहरू र तिनीहरूका गाउँहरू थिए।<verse eid="JOS 19:30"/></para>
<para style="p"><verse number="31" style="v" sid="JOS 19:31"/>यी सहरहरू र तिनीहरूका गाउँहरू वंशअनुसार आशेरको कुलको उत्तराधिकारको भागमा थियो।<verse eid="JOS 19:31"/></para>
<para style="p"><verse number="32" style="v" sid="JOS 19:32"/>छैटौँ चिट्ठा वंशअनुसार नप्‍तालीको कुललाई पर्‍यो:<verse eid="JOS 19:32"/></para>
<para style="p"><verse number="33" style="v" sid="JOS 19:33"/>तिनीहरूको सिमाना हेलेप र सानन्‍नीममा भएको मोरेको ठूलो रूखबाट भएर अदामी-नेकेब र यब्नेल हुँदै लक्‍कूममा गएर यर्दन नदीमा टुङ्गिएको थियो।<verse eid="JOS 19:33"/></para>
<para style="p"><verse number="34" style="v" sid="JOS 19:34"/>त्यो सिमाना अज्नोथ-तबोरबाट पश्‍चिमतिर मोडिएर हुक्‍कोकमा निस्किएको थियो। यसले दक्षिणतिर जबूलूनलाई र पश्‍चिममा आशेरलाई, र पूर्वमा यर्दन नदीलाई छोएको थियो।<verse eid="JOS 19:34"/></para>
<para style="p"><verse number="35" style="v" sid="JOS 19:35"/>पर्खाल लगाइएका सहरहरू सिद्दिम, सेर, हम्मत, रक्‍कत, किन्‍नरेत,<verse eid="JOS 19:35"/></para>
<para style="p"><verse number="36" style="v" sid="JOS 19:36"/>अदमा, रामा, हासोर,<verse eid="JOS 19:36"/></para>
<para style="p"><verse number="37" style="v" sid="JOS 19:37"/>केदेश, एद्रई, एन-हासोर,<verse eid="JOS 19:37"/></para>
<para style="p"><verse number="38" style="v" sid="JOS 19:38"/>यिरोन, मिग्दल-एल, होरेम, बेथ-अनात र बेथ-शेमेश थिए। यसका उन्‍नाइस वटा सहरहरू र तिनीहरूका गाउँहरू थिए।<verse eid="JOS 19:38"/></para>
<para style="p"><verse number="39" style="v" sid="JOS 19:39"/>यी सहरहरू र तिनीहरूका गाउँहरू वंशअनुसार नप्‍तालीको कुलको उत्तराधिकारको भाग थियो।<verse eid="JOS 19:39"/></para>
<para style="p"><verse number="40" style="v" sid="JOS 19:40"/>सातौँ चिट्ठा वंशअनुसार दानको कुललाई पर्‍यो।<verse eid="JOS 19:40"/></para>
<para style="p"><verse number="41" style="v" sid="JOS 19:41"/>तिनीहरूका उत्तराधिकारका प्रान्तहरूमा यी सहरहरू सामेल थिए: सोरा, एश्तोल, इर-शेमेस,<verse eid="JOS 19:41"/></para>
<para style="p"><verse number="42" style="v" sid="JOS 19:42"/>शालवीन, अय्यालोन, इत्ला,<verse eid="JOS 19:42"/></para>
<para style="p"><verse number="43" style="v" sid="JOS 19:43"/>एलोन, तिम्ना, एक्रोन,<verse eid="JOS 19:43"/></para>
<para style="p"><verse number="44" style="v" sid="JOS 19:44"/>एल्तके, गिब्बतोन, बालात,<verse eid="JOS 19:44"/></para>
<para style="p"><verse number="45" style="v" sid="JOS 19:45"/>यहूद, बेने-बेरक, गात-रिम्मोन,<verse eid="JOS 19:45"/></para>
<para style="p"><verse number="46" style="v" sid="JOS 19:46"/>मे-यरकोन र रक्‍कोनसँगै जोप्पातिर फर्केको इलाका।<verse eid="JOS 19:46"/></para>
<para style="p"><verse number="47" style="v" sid="JOS 19:47"/>(दानवंशीहरूले तिनीहरूको अधिकारको प्रान्त गुमाएको हुनाले तिनीहरू माथि गए। अनि लेशेममाथि आक्रमण गरेर लिए। त्यसलाई तरवारले नष्‍ट गरे; अनि त्यसलाई कब्जा गरे। तिनीहरू लेशेममा बसोबास गरे। अनि लेशेमलाई तिनीहरूको पुर्ख्यौली दानको नाम दिए।)<verse eid="JOS 19:47"/></para>
<para style="p"><verse number="48" style="v" sid="JOS 19:48"/>यी सहरहरू र तिनीहरूका गाउँहरू वंशअनुसार दानको कुलका उत्तराधिकारको भाग थियो।<verse eid="JOS 19:48"/></para>
<para style="p"><verse number="49" style="v" sid="JOS 19:49"/>जब तिनीहरूले देशलाई विभाजन गरेर भाग लगाउने काम गरी सिद्ध्याए, तब इस्राएलीहरूले नूनका छोरा यहोशूलाई तिनीहरूकै बीचमा उत्तराधिकारको भाग दिए।<verse eid="JOS 19:49"/></para>
<para style="p"><verse number="50" style="v" sid="JOS 19:50"/>याहवेहले तिनीहरूलाई आज्ञा गर्नुभएअनुसार गरे। यहोशूले मागेका सहर एफ्राइमको पहाडी मुलुकमा भएको तिम्नथ-सेरह तिनीहरूले दिए। अनि त्यहाँ तिनले सहरलाई निर्माण गरे, र त्यहीँ बसोबास गरे।<verse eid="JOS 19:50"/></para>
<para style="p"><verse number="51" style="v" sid="JOS 19:51"/>भेट हुने पालको प्रवेशद्वारमा याहवेहको उपस्थितिमा शीलोमा चिट्ठा हालेर पुजारी एलाजार, नूनका छोरा यहोशू र इस्राएलका कुलका वंशका मुखियाहरूले तोकेका मुलुकहरू यिनै हुन्। यसरी तिनीहरूले देश बाँडफाँड गर्ने काम सिद्ध्याए।<verse eid="JOS 19:51"/></para>
<chapter eid="JOS 19"/>
<chapter number="20" style="c" sid="JOS 20"/>
<para style="p"><verse number="1" style="v" sid="JOS 20:1"/>त्यसपछि याहवेहले यहोशूलाई भन्‍नुभयो:<verse eid="JOS 20:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 20:2"/>“मैले मोशालाई आज्ञा दिएझैँ शरण-सहरहरू नियुक्त गर्न इस्राएलीहरूलाई भन्,<verse eid="JOS 20:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 20:3"/>ताकि कसैले कसैलाई संयोगवश र अनजानमा मार्‍यो भने त्यो त्यहाँ भागेर गई रगतको बदला लिनेबाट सुरक्षित रहोस्।<verse eid="JOS 20:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 20:4"/>जब तिनीहरू यी सहरहरूमध्ये एउटामा भागेर जान्छन्, तब सहरको मूलढोकाको प्रवेशद्वारमा खडा रहून्, र त्यस सहरका प्रधानहरूलाई आफ्नो मुद्दा बताऊन्। तब ती प्रधानहरूले हत्यारालाई आफ्नो सहरमा लगेर त्यसलाई तिनीहरूसँग बस्‍न ठाउँ देऊन्।<verse eid="JOS 20:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 20:5"/>यदि रगतको बदला लिनेले त्यसलाई खेद्‌यो भने प्रधानहरूले त्यस अभियुक्तलाई सुम्पिदिनुहुँदैन। किनकि त्यसले आफ्नो छिमेकीलाई अनजानमा मारेको हो र त्यसको छिमेकीसँग कुनै दुश्मनी थिएन।<verse eid="JOS 20:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 20:6"/>न्यायका निम्ति सभाको सामु खडा नभएसम्म र त्यस समय सेवा गर्दैगरेको प्रधान पुजारीको मृत्यु नभएसम्म हत्यारा त्यस सहरमा बस्‍नुपर्छ। त्यसपछि तिनीहरू भागेर आएको सहरबाट आफ्नो घर फर्केर जान सक्नेछ।”<verse eid="JOS 20:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 20:7"/>यसकारण तिनीहरूले नप्‍तालीको पहाडी मुलुकमा रहेको गालीलमा केदेश र एफ्राइमको पहाडी मुलुकमा भएको शेकेमलाई र यहूदाको पहाडी मुलुकमा भएको किर्यत-अर्बा (अर्थात्, हेब्रोन) लाई अलग गरे।<verse eid="JOS 20:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 20:8"/>यरीहो पारि यर्दनको पूर्वपट्टि रूबेनको कुलमा भएको पठारमा भएको उजाडस्थानको बेसेर, गादको कुलमा भएको गिलादको रामोत र मनश्शेको कुलमा भएको बाशानको गोलानलाई छुट्याए।<verse eid="JOS 20:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 20:9"/>इस्राएलीहरू अर्थात् तिनीहरूसँग बसोबास गर्ने विदेशीहरूमध्ये कसैले कसैलाई अनजानमा मार्‍यो भने त्यो ती छुट्याइएका सहरहरूमा भागेर जानसक्थ्यो। अनि न्यायका निम्ति सभाको सामु खडा हुनुभन्दा अगि त्यसलाई रगतको बदला लिनेले मार्न पाउँदैनथियो।<verse eid="JOS 20:9"/></para>
<chapter eid="JOS 20"/>
<chapter number="21" style="c" sid="JOS 21"/>
<para style="p"><verse number="1" style="v" sid="JOS 21:1"/>तब लेवी कुलका मुखियाहरू, पुजारी एलाजार, नूनका छोरा यहोशू र इस्राएलका अरू कुलका मुखियाहरूकहाँ आए।<verse eid="JOS 21:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 21:2"/>अनि तिनीहरूले कनान देशको शीलोमा तिनीहरूलाई भने, “याहवेहले तपाईंलाई मोशाद्वारा हामीलाई हाम्रा गाईबस्तुका निम्ति खर्कसहितको बस्‍ने सहरहरू दिनू भनी आज्ञा गर्नुभयो।”<verse eid="JOS 21:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 21:3"/>यसकारण याहवेहले आज्ञा गर्नुभएझैँ, इस्राएलीहरूले तिनीहरूका आफ्नै उत्तराधिकारको भागबाट लेवीहरूलाई यी सहरहरू र खर्कहरू दिए:<verse eid="JOS 21:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 21:4"/>पहिलो चिट्ठा वंशअनुसार कहातीहरूका निम्ति निस्क्यो। हारून पुजारीका सन्तान लेवीहरूलाई यहूदा, शिमियोन र बेन्यामीनका कुलहरूबाट तेह्र वटा सहरहरू भाग लगाइयो।<verse eid="JOS 21:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 21:5"/>कहातका बाँकी रहेका सन्तानहरूलाई एफ्राइम, दान र मनश्शेको आधा कुलहरूका वंशहरूबाट दश वटा सहरहरू भाग लगाइयो।<verse eid="JOS 21:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 21:6"/>गेर्शोनका सन्तानहरूलाई इस्साखार, आशेर, नप्‍ताली र बाशानमा भएको मनश्शेको आधा कुलहरूका वंशहरूबाट तेह्र वटा सहरहरू भाग लगाइयो।<verse eid="JOS 21:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 21:7"/>मरारीका सन्तानहरूले वंशअनुसार रूबेन, गाद र जबूलूनका कुलहरूबाट बाह्र वटा सहरहरू पाए।<verse eid="JOS 21:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 21:8"/>यसरी याहवेहले मोशाद्वारा आज्ञा गर्नुभएझैँ इस्राएलीहरूले लेवीहरूलाई यी सहरहरू र तिनीहरूका खर्कहरू दिए।<verse eid="JOS 21:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 21:9"/>तिनीहरूले यहूदा र शिमियोनका कुलहरूबाट भाग लगाइएका सहरहरू यिनै हुन्।<verse eid="JOS 21:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 21:10"/>यी सहरहरू हारूनका सन्तानहरूलाई दिइयो, जो लेवीका वंशका कहाती थिए। किनकि पहिलो चिट्ठा तिनीहरूको नाममा परेको थियो:<verse eid="JOS 21:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 21:11"/>तिनीहरूले उनीहरूलाई किर्यत-अर्बा (अर्थात्, हेब्रोन) लाई यहूदामा भएको पहाडी मुलुकबाट चारैतिरका खर्कहरूसमेत दिए। (अर्बा अनाकका पुर्खा थिए।)<verse eid="JOS 21:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 21:12"/>तर त्यस सहरका खेतहरू र गाउँहरूचाहिँ तिनीहरूले यपून्‍नेका छोरा कालेबलाई तिनको पैतृक सम्पत्तिको रूपमा दिएका थिए।<verse eid="JOS 21:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 21:13"/>यसकारण पुजारी हारूनका सन्तानहरूलाई तिनीहरूले हेब्रोन (हत्याको अभियोग लागेको व्यक्तिको लागि शरण-नगर) लिब्ना,<verse eid="JOS 21:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 21:14"/>यत्तीर, एश्तमो,<verse eid="JOS 21:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 21:15"/>होलोन, दबीर,<verse eid="JOS 21:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 21:16"/>ऐन, युत्ता र बेथ-शेमेश, तिनीहरूका खर्कहरूसमेत यी दुई कुलहरूबाट नौ वटा सहरहरू दिइएको थियो।<verse eid="JOS 21:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 21:17"/>अनि बेन्यामीनको कुलबाट तिनीहरूले उनीहरूलाई यी सहरहरू दिए: गिबोन, गेबा,<verse eid="JOS 21:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 21:18"/>अनातोत र अल्मोन, तिनीहरूका खर्कहरूसमेत, चार वटा सहरहरू दिइएको थियो।<verse eid="JOS 21:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 21:19"/>हारूनका सन्तान, पुजारीहरूका निम्ति जम्मा तेह्र वटा तिनीहरूका खर्कहरूसमेत सहरहरू थिए।<verse eid="JOS 21:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 21:20"/>बाँकी रहेका लेवीहरूका कहाती वंशहरूलाई एफ्राइमको कुलबाट सहरहरू दिइएको थियो:<verse eid="JOS 21:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 21:21"/>एफ्राइमको पहाडी मुलुकमा तिनीहरूलाई यी सहरहरू दिइएको थियो: शेकेम (हत्याको अभियोग लागेको व्यक्तिका निम्ति शरण-नगर), गेजेर,<verse eid="JOS 21:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 21:22"/>किब्सैम र बेथ-होरोन, तिनीहरूका खर्कहरूसमेत चार वटा सहरहरू दिइएको थियो।<verse eid="JOS 21:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 21:23"/>दानको कुलबाट पनि तिनीहरूले यी सहरहरू पाए: एल्तके, गिब्बतोन,<verse eid="JOS 21:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 21:24"/>अय्यालोन र गात-रिम्मोन, तिनीहरूका खर्कहरूसमेत चार वटा सहरहरू पाए।<verse eid="JOS 21:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 21:25"/>मनश्शेको आधा कुलबाट तिनीहरूले यी सहरहरू पाए: तानाक र गात-रिम्मोन, तिनीहरूका खर्कहरूसँगै दुई वटा सहरहरू पाए।<verse eid="JOS 21:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 21:26"/>यी सबै दश सहरहरू र तिनीहरूका खर्कहरू कहाती वंशका बाँकी रहेकाहरूलाई दिइएको थियो।<verse eid="JOS 21:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 21:27"/>लेवी वंशका गेर्शोनीहरूलाई यी सहरहरू दिइएको थियो: मनश्शेको आधा कुलहरूबाट: बाशानमा भएको गोलान (हत्याको अभियोग लागेको व्यक्तिका निम्ति शरण-नगर) र बेएश्तरा, तिनीहरूका खर्कहरूसमेत दुई वटा सहरहरू दिइएको थियो।<verse eid="JOS 21:27"/></para>
<para style="p"><verse number="28" style="v" sid="JOS 21:28"/>इस्साखारको कुलबाट: किश्योन, दाबरत,<verse eid="JOS 21:28"/></para>
<para style="p"><verse number="29" style="v" sid="JOS 21:29"/>यर्मूत र एन-गन्‍नीम, तिनीहरूका खर्कहरूसमेत चार वटा सहरहरू दिइएको थियो।<verse eid="JOS 21:29"/></para>
<para style="p"><verse number="30" style="v" sid="JOS 21:30"/>आशेरको कुलबाट: मिशाल, अब्दोन,<verse eid="JOS 21:30"/></para>
<para style="p"><verse number="31" style="v" sid="JOS 21:31"/>हेल्कत र रहोब, तिनीहरूका खर्कहरूसमेत चार वटा सहरहरू थिए।<verse eid="JOS 21:31"/></para>
<para style="p"><verse number="32" style="v" sid="JOS 21:32"/>नप्‍तालीको कुलबाट: गालीलमा भएको केदेश (हत्याको अभियोग लागेको व्यक्तिका निम्ति शरण-नगर) हम्मोत-डोर र कर्तान, तिनीहरूका खर्कहरूसमेत तीन वटा सहरहरू थिए।<verse eid="JOS 21:32"/></para>
<para style="p"><verse number="33" style="v" sid="JOS 21:33"/>गेर्शोनी वंशका सहरहरू, तिनीहरूका खर्कहरूसमेत जम्मा तेह्र वटा थिए।<verse eid="JOS 21:33"/></para>
<para style="p"><verse number="34" style="v" sid="JOS 21:34"/>मरारी वंशकाहरू, जो लेवीहरूका बाँकी रहेकाहरू थिए। तिनीहरूलाई यी सहरहरू दिइएको थियो: जबूलूनको कुलबाट: योक्नाम, कर्तह,<verse eid="JOS 21:34"/></para>
<para style="p"><verse number="35" style="v" sid="JOS 21:35"/>दिम्ना र नहलल, तिनीहरूका खर्कहरूसमेत चार वटा सहरहरू थिए;<verse eid="JOS 21:35"/></para>
<para style="p"><verse number="36" style="v" sid="JOS 21:36"/>रूबेनको कुलबाट: बेसेर, यहसा,<verse eid="JOS 21:36"/></para>
<para style="p"><verse number="37" style="v" sid="JOS 21:37"/>कदेमोत र मेपात, तिनीहरूका खर्कहरूसमेत चार वटा सहरहरू थिए।<verse eid="JOS 21:37"/></para>
<para style="p"><verse number="38" style="v" sid="JOS 21:38"/>गादको कुलबाट: गिलादको रामोत (हत्याको अभियोग लागेको व्यक्तिका निम्ति शरण-नगर), महनाइम,<verse eid="JOS 21:38"/></para>
<para style="p"><verse number="39" style="v" sid="JOS 21:39"/>हेश्बोन र याजेर, तिनीहरूका खर्कहरूसमेत जम्मा चार वटा सहरहरू थिए।<verse eid="JOS 21:39"/></para>
<para style="p"><verse number="40" style="v" sid="JOS 21:40"/>लेवीहरूका बाँकी रहेका सबै मरारी वंशलाई दिइएका सहरहरू जम्मा बाह्र वटा थिए।<verse eid="JOS 21:40"/></para>
<para style="p"><verse number="41" style="v" sid="JOS 21:41"/>इस्राएलीहरूले अधिकार गरेका इलाकामा लेवीहरूका सहरहरू तिनीहरूका खर्कहरूसमेत, जम्मा अठचालीस वटा थिए।<verse eid="JOS 21:41"/></para>
<para style="p"><verse number="42" style="v" sid="JOS 21:42"/>यी सहरहरूका चारैतिर खर्कहरू थिए; प्रत्येक सहरहरूमा यस्तै थियो।<verse eid="JOS 21:42"/></para>
<para style="p"><verse number="43" style="v" sid="JOS 21:43"/>यसरी याहवेहले इस्राएलीहरूका पुर्खाहरूलाई दिनेछु भनी शपथ खानुभएका सबै देश तिनीहरूलाई दिनुभयो। अनि तिनीहरूले ती देशहरूमाथि अधिकार गरे, र त्यहाँ बसोबास गर्न लागे।<verse eid="JOS 21:43"/></para>
<para style="p"><verse number="44" style="v" sid="JOS 21:44"/>याहवेहले तिनीहरूका पुर्खाहरूसँग शपथ खानुभएझैँ, उहाँले तिनीहरूलाई चारैतिरबाट शान्ति दिनुभयो। तिनीहरूका कुनै पनि शत्रु तिनीहरूको विरुद्धमा खडा रहन सकेनन्। याहवेहले तिनीहरूका सबै शत्रुहरूलाई तिनीहरूको हातमा सुम्पिदिनुभयो।<verse eid="JOS 21:44"/></para>
<para style="p"><verse number="45" style="v" sid="JOS 21:45"/>याहवेहले इस्राएलीहरूलाई गर्नुभएका असल प्रतिज्ञाहरूमध्ये एउटै पनि असफल भएनन्; हरेक प्रतिज्ञाहरू पूरा भए।<verse eid="JOS 21:45"/></para>
<chapter eid="JOS 21"/>
<chapter number="22" style="c" sid="JOS 22"/>
<para style="p"><verse number="1" style="v" sid="JOS 22:1"/>तब रूबेनीहरू, गादीहरू र मनश्शेको आधा कुललाई यहोशूले बोलाए।<verse eid="JOS 22:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 22:2"/>अनि तिनीहरूलाई भने, “तिमीहरूले याहवेहका सेवक मोशाले आज्ञा गरेका सबै थोक गरेका छौ, र मैले तिमीहरूलाई आज्ञा दिएका हरेक कुरा पालन गरेका छौ।<verse eid="JOS 22:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 22:3"/>यतिका दिनदेखि लिएर आजसम्मै तिमीहरूका दाजुभाइहरूलाई नत्यागी तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरले दिनुभएका सबै आज्ञाहरू पूरा गरेका छौ।<verse eid="JOS 22:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 22:4"/>अब याहवेह तिमीहरूका परमेश्‍वरले प्रतिज्ञा गर्नुभएअनुसार उहाँले तिमीहरूका दाजुभाइहरूलाई विश्राम दिनुभएको छ। याहवेहका सेवक मोशाले तिमीहरूलाई यर्दनपारि दिएका आ-आफ्ना देशमा भएका तिमीहरूका घरमा फर्केर जाओ।<verse eid="JOS 22:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 22:5"/>तर तिमीहरूले याहवेहका सेवक मोशाले दिएका आज्ञाहरू बडो होसियारीसाथ पालन गर्नू। याहवेह तिमीहरूका परमेश्‍वरलाई प्रेम गर्नू, उहाँमा आज्ञाकारी हुनू, उहाँको आज्ञापालन गर्नू; उहाँमा लागिरहनू। तिमीहरूका सारा हृदयले र सारा प्राणले उहाँको सेवा गर्नू।”<verse eid="JOS 22:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 22:6"/>त्यसपछि यहोशूले तिनीहरूलाई आशिष् दिए, र पठाइदिए। अनि तिनीहरू आ-आफ्ना घरतिर गए।<verse eid="JOS 22:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 22:7"/>(मनश्शेको आधा कुललाई मोशाले बाशानमा ठाउँ दिएका थिए। तिनीहरूको अर्को आधा कुललाई यहोशूले तिनीहरूका दाजुभाइहरूसँग यर्दनको पश्‍चिमतिरको ठाउँ दिए।) जब यहोशूले तिनीहरूलाई आ-आफ्ना घरमा पठाए, तब तिनीहरूलाई आशिष् दिए।<verse eid="JOS 22:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 22:8"/>अनि तिनीहरूलाई भने, “तिमीहरू प्रशस्त सम्पत्ति, गाईबस्तुको ठूलो बथान, सुन, चाँदी, काँसो, फलाम र धेरै मात्रामा लुगाफाटाहरू लिएर आफ्ना घरमा फर्क। अनि तिमीहरूका शत्रुहरूबाट लुटेका मालसामानहरू आफ्ना दाजुभाइहरूसँग बाँडफाँड गर।”<verse eid="JOS 22:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 22:9"/>यसकारण रूबेनीहरू, गादीहरू र मनश्शेको आधा कुलले इस्राएलीहरूलाई शीलोमा छोडे। अनि याहवेहले मोशाद्वारा आज्ञा दिनुभएअनुसार तिनीहरूले प्राप्‍त गरेका आफ्नै देश गिलादतिर फर्कन कनानबाट हिँडे।<verse eid="JOS 22:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 22:10"/>जब तिनीहरू कनानको देश यर्दनको नजिकमा भएको गेलीलोतमा आइपुगे, तब रूबेनीहरू, गादीहरू र मनश्शेको आधा कुलले यर्दनको छेउमा एउटा विशाल वेदी बनाए।<verse eid="JOS 22:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 22:11"/>अनि जब तिनीहरूले कनानको सिमाना गेलीलोतमा, यर्दनको छेउ इस्राएलीहरूको किनारापट्टि वेदी बनाएको कुरा अरू इस्राएलीहरूले सुने,<verse eid="JOS 22:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 22:12"/>तब इस्राएलका सारा समुदायले तिनीहरूको विरुद्धमा युद्ध गर्न शीलोमा भेला भए।<verse eid="JOS 22:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 22:13"/>यसकारण इस्राएलीहरूले पुजारी एलाजारका छोरा पीनहासलाई रूबेनी, गादी, मनश्शेको आधा कुलकहाँ पठाए।<verse eid="JOS 22:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 22:14"/>तिनीहरूले उनीहरूसँग इस्राएलको हरेक वंशबाट एक-एक जना मुखिया छानेर दश जना पठाए। तिनीहरू इस्राएलका हरेक कुलहरूका परिवारबाटका अगुवाहरू थिए।<verse eid="JOS 22:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 22:15"/>तिनीहरू गिलादमा रूबेन, गाद र मनश्शेको आधा कुलका मानिसहरूकहाँ पुगेपछि तिनीहरूले उनीहरूलाई भने,<verse eid="JOS 22:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 22:16"/>“याहवेहको सारा समुदायले यसो भन्दछ: तिमीहरूले कसरी इस्राएलका परमेश्‍वरसित यसरी विश्‍वासघात गर्न सक्यौ? तिमीहरूले कसरी याहवेहदेखि तर्केर उहाँको विरुद्धमा आफ्ना लागि वेदी बनायौ?<verse eid="JOS 22:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 22:17"/>के पोरको पाप हाम्रा निम्ति पर्याप्‍त थिएन? याहवेहको समुदायमाथि विपत्ति आइलागे तापनि हामीले आजको दिनसम्म आफूलाई त्यस पापदेखि शुद्ध पार्न सकेका छैनौँ!<verse eid="JOS 22:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 22:18"/>अनि के अब तिमीहरू याहवेहदेखि तर्किरहन्छौ? “ ‘यदि तिमीहरू याहवेहको विरुद्धमा आज बागी भयौ भने भोलि उहाँ इस्राएलका सम्पूर्ण समुदायसँग क्रोधित हुनुहुनेछ।<verse eid="JOS 22:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 22:19"/>यदि तिमीहरूले अधिकार गरेको देश अशुद्ध भएको छ भने याहवेहको समागम पाल भएको देशमा आओ र हामीसँगै जमिनको उपभोग गर। तर याहवेहको वेदीबाहेक आफ्ना निम्ति अर्कै वेदी बनाएर याहवेह हाम्रा परमेश्‍वर अथवा हाम्रो विरुद्धमा बागी नहोओ।<verse eid="JOS 22:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 22:20"/>जब जेरहका छोरा आकानले अर्पण गरिएका कुराहरूको विषयमा विश्‍वासघात गरेका थिए, तब के सारा इस्राएलको समुदायमाथि क्रोध परेको थिएन? त्यहाँ त्यो एकलै मात्र आफ्नो पापले मरेन।’ ”<verse eid="JOS 22:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 22:21"/>तब रूबेन, गाद र मनश्शेको आधा कुलले इस्राएली वंशका मुखियाहरूलाई जवाफ दिए:<verse eid="JOS 22:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 22:22"/>सर्वशक्तिमान्, परमेश्‍वर, याहवेह! सर्वशक्तिमान्, परमेश्‍वर, याहवेह! उहाँले जान्‍नुहुन्छ! अनि इस्राएलले पनि जानोस्! यो याहवेहको विरुद्ध विद्रोह अर्थात् अनाज्ञाकारिता हो भने आज हामीलाई बाँकी नराख्नुहोस्!<verse eid="JOS 22:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 22:23"/>याहवेहबाट तर्केर जान र यसमाथि होमबलि, अन्‍नबलि अर्थात् मेलबलि चढाउन भनी हामीले आफ्नै वेदी बनाएका हौँ भने याहवेह आफैँले हामीबाट लेखा लिऊन्!<verse eid="JOS 22:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 22:24"/>“त्यसो होइन! हामीले आउँदा कुनै दिनमा तिमीहरूका सन्तानले हाम्रा सन्तानलाई, याहवेह इस्राएलका परमेश्‍वरसँग तिमीहरूको के सरोकार? भन्लान् कि भन्‍ने डरले पो यसो गरेका हौँ।<verse eid="JOS 22:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 22:25"/>याहवेहले यर्दनलाई तिमीहरू र हाम्रा बीचमा सिमाना बनाइदिनुभएको छ। हे रूबेनीहरू र हे गादीहरू हो! याहवेहमा तिमीहरूको कुनै भाग छैन भनेर तिमीहरूका सन्तानहरूले हाम्रा सन्तानहरूलाई याहवेहको भय मान्‍नबाट रोक्न सक्नेछन्।<verse eid="JOS 22:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 22:26"/>“त्यसकारण हामीले भन्यौँ, ‘हामी तयार भएर एउटा वेदी बनाऔँ, तर होमबलि अर्थात् बलिदानहरूका निम्ति होइन।<verse eid="JOS 22:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 22:27"/>तर यसको ठिक विपरीत तिमीहरू, हामीहरू र हाम्रा भावी पुस्ताहरूको बीचमा यो एउटा साक्षीको रूपमा रहोस्, ताकि हाम्रा होमबलिहरू, बलिदानहरू र मेलबलिहरूद्वारा उहाँको वासस्थानमा याहवेहलाई हामी सेवा गर्नेछौँ। अनि भविष्यमा तिमीहरूका सन्तानले हाम्रा सन्तानलाई याहवेहमा तिमीहरूको कुनै भाग छैन भनी भन्‍न नपाऊन्।’<verse eid="JOS 22:27"/></para>
<para style="p"><verse number="28" style="v" sid="JOS 22:28"/>“अनि हामीले भन्यौँ, ‘यदि कुनै दिन तिनीहरूले हामीलाई अर्थात् हाम्रा सन्तानलाई यसो भन्यो भने हामी यसो भन्‍नेछौँ: हाम्रा पितापुर्खाहरूले होमबलि र बलिदानहरू चढाउन होइन, तर हामी र तिमीहरूका बीचमा साक्षीको रूपमा बनाएको याहवेहको वेदीको ढाँचालाई हेर।’<verse eid="JOS 22:28"/></para>
<para style="p"><verse number="29" style="v" sid="JOS 22:29"/>“उहाँको समागम पालको सामु खडा रहेको याहवेह हाम्रा परमेश्‍वरको वेदीलाई छोडेर आज अर्कै वेदी बनाएर त्यसमाथि होमबलि, अन्‍नबलि र बलिदानहरू चढाएर याहवेहको विरुद्धमा बागी भएर उहाँदेखि तर्किएर जाने काम हामीबाट टाढा रहोस्!”<verse eid="JOS 22:29"/></para>
<para style="p"><verse number="30" style="v" sid="JOS 22:30"/>जब पुजारी पीनहास र तिनीसँग भएका समुदायका अगुवाहरू र इस्राएलका वंशहरूका मुखियाहरूले रूबेनका, गादका र मनश्शेहरूले भन्‍न चाहेका कुरा सुने, तब तिनीहरू प्रसन्‍न भए।<verse eid="JOS 22:30"/></para>
<para style="p"><verse number="31" style="v" sid="JOS 22:31"/>अनि पुजारी एलाजारका छोरा पीनहासले रूबेनीहरू, गादीहरू र मनश्शेहरूलाई भने, “आज हामी जान्दछौँ कि याहवेह हामीसँग हुनुहुन्छ। किनकि यस विषयमा तिमीहरूले याहवेहप्रति विश्‍वासघात गरेका छैनौ। अब तिमीहरूले इस्राएललाई याहवेहको हातबाट छुटाएका छौ।”<verse eid="JOS 22:31"/></para>
<para style="p"><verse number="32" style="v" sid="JOS 22:32"/>तब पुजारी एलाजारका छोरा पीनहास र अगुवाहरू गिलादमा रूबेनी र गादीहरूसँग भेटघाट गरेर कनानमा फर्के। अनि इस्राएलीहरूलाई त्यसको विवरण दिए।<verse eid="JOS 22:32"/></para>
<para style="p"><verse number="33" style="v" sid="JOS 22:33"/>त्यो विवरण सुनेर इस्राएलीहरू प्रसन्‍न भए, र परमेश्‍वरको प्रशंसा गरे। अनि रूबेनीहरू र गादीहरू बसेको देशमा तिनीहरूको विरुद्धमा युद्ध गरेर नष्‍ट पार्ने कुरा तिनीहरूले फेरि गरेनन्।<verse eid="JOS 22:33"/></para>
<para style="p"><verse number="34" style="v" sid="JOS 22:34"/>अनि रूबेनीहरू र गादीहरूले त्यस वेदीलाई यो नाम दिए: हाम्रा बीचमा एउटा मात्र साक्षी हुनुहुन्छ, जो केवल याहवेह परमेश्‍वर हुनुहुन्छ।<verse eid="JOS 22:34"/></para>
<chapter eid="JOS 22"/>
<chapter number="23" style="c" sid="JOS 23"/>
<para style="p"><verse number="1" style="v" sid="JOS 23:1"/>धेरै समय बितेपछि याहवेहले इस्राएललाई तिनीहरूका चारैतिरका सबै शत्रुहरूदेखि विश्राम दिनुभयो। अनि त्यस बेलासम्ममा यहोशू वृद्ध भइसकेका थिए।<verse eid="JOS 23:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 23:2"/>तब तिनले सारा इस्राएल, तिनीहरूका प्रधानहरू, अगुवाहरू, न्यायकर्ताहरू र अधिकृतहरूलाई बोलाएर तिनीहरूलाई भने: “म अब धेरै वृद्ध भएको छु।<verse eid="JOS 23:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 23:3"/>याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूका निम्ति यी सबै राष्ट्रहरूलाई गर्नुभएको हरेक कुरा तिमीहरूले देखेका छौ। याहवेह तिमीहरूका परमेश्‍वर नै तिमीहरूको निम्ति लड्नुभयो।<verse eid="JOS 23:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 23:4"/>याद गर, मैले कसरी तिमीहरूका कुलहरूका निम्ति उत्तराधिकारको रूपमा यर्दन र पश्‍चिममा महासागरको बीचमा रहेका सबै राष्ट्रहरूलाई जितेर तिनीहरूको देश तिमीहरूका बाँकी रहेका राष्ट्रहरूलाई भाग लगाइदिएको छु।<verse eid="JOS 23:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 23:5"/>याहवेह तिमीहरूका परमेश्‍वर आफैँले तिनीहरूलाई तिमीहरूका निम्ति धपाइदिनुहुनेछ। उहाँले तिनीहरूलाई तिमीहरूकै सामुबाट निकालिदिनुहुनेछ। अनि याहवेह तिमीहरूका परमेश्‍वरले तिमीहरूलाई प्रतिज्ञा गर्नुभएझैँ तिमीहरूले तिनीहरूको देशमाथि अधिकार गर्नेछौ।<verse eid="JOS 23:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 23:6"/>“त्यसकारण अति बलियो होओ; मोशाको व्यवस्थाको पुस्तकमा लेखिएका कुराहरूबाट दायाँ अथवा बायाँतिर नलागी होसियारीसाथ पालन गर्नू।<verse eid="JOS 23:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 23:7"/>तिमीहरूका बीचमा बसोबास गर्ने यी जातिहरूसँग सम्बन्ध नराख्नू। तिनीहरूका देवी-देवताहरूका नाम नपुकार्नू, अथवा तिनीहरूका नामहरूमा शपथ नखानू। तिमीहरूले तिनीहरूको सेवा नगर्नू, अथवा तिनीहरूका सामु ननिहुरनू।<verse eid="JOS 23:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 23:8"/>तर तिमीहरूले अहिलेसम्म गरेझैँ याहवेह तिमीहरूका परमेश्‍वरमा विश्‍वासयोग्य भइरहनू।<verse eid="JOS 23:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 23:9"/>“याहवेहले तिमीहरूको सामुबाट महान् र शक्तिशाली जातिहरूलाई धपाइदिनुभयो; त्यसैले आजको दिनसम्म कोही पनि तिमीहरूको विरुद्धमा खडा रहन सकेको छैन।<verse eid="JOS 23:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 23:10"/>तिमीहरूमध्ये एक जनाले एक हजारलाई परास्त गर्न सक्छौ। किनकि याहवेह तिमीहरूका परमेश्‍वरले प्रतिज्ञा गर्नुभएझैँ उहाँले तिमीहरूका निम्ति युद्ध गरिदिनुहुन्छ।<verse eid="JOS 23:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 23:11"/>यसकारण याहवेह तिमीहरूका परमेश्‍वरलाई होसियारीसाथ प्रेम गर्नू।<verse eid="JOS 23:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 23:12"/>“तर यदि तिमीहरू तर्केर तिमीहरूका बीचमा बसोबास गर्ने बाँकी रहेका यी जातिहरूसँग तिमीहरूले सम्बन्ध राख्यौ र तिमीहरूले तिनीहरूसँग विवाह गर्‍यौ भने,<verse eid="JOS 23:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 23:13"/>यो निश्‍चय जानिराख—याहवेह तिमीहरूका परमेश्‍वरले यी जातिहरूलाई तिमीहरूका सामुबाट धपाउनुहुनेछैन। बरु जबसम्म याहवेह तिमीहरूका परमेश्‍वरले दिनुभएको यस असल देशबाट तिमीहरू नष्‍ट हुँदैनौ, तबसम्म तिनीहरू तिमीहरूका निम्ति फन्दा र पासो हुनेछन्। यसकासाथै तिमीहरूका पिठिउँमा कोर्रा र तिमीहरूका आँखामा काँडासरह बन्‍नेछन्।<verse eid="JOS 23:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 23:14"/>“अब म सारा पृथ्वीको नियमअनुसार जान लागेको छु। याहवेह, तिमीहरूका परमेश्‍वरले तिमीहरूलाई दिनुभएको उत्तम प्रतिज्ञाहरूमध्ये एउटै पनि अपूरो रहेको छैन भनी आफ्ना सारा हृदय र प्राणले जान्दछौ। हरेक प्रतिज्ञा पूरा भएका छन्। एउटै पनि असफल भएको छैन।<verse eid="JOS 23:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 23:15"/>तर याहवेह तिमीहरूका परमेश्‍वरको हरेक असल प्रतिज्ञा साँचो ठहरिएझैँ, यदि तिमीहरूले उहाँको आज्ञापालन गरेनौ भने उहाँले तिमीहरूलाई दिनुभएको यो असल देशबाट तिमीहरू नष्‍ट नभएसम्म उहाँले तिमीहरूलाई होशियार गराउनुभएका सबै खराब कुराहरू पनि ल्याउनुहुनेछ।<verse eid="JOS 23:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 23:16"/>यदि तिमीहरूले याहवेह तिमीहरूका परमेश्‍वरले आज्ञा गर्नुभएको करार भङ्ग गर्‍यौ र अरू देवी-देवताको सेवा गर्दै तिनीहरूका सामु निहुर्‍यौ भने याहवेहको क्रोध तिमीहरूमाथि पर्नेछ। अनि उहाँले तिमीहरूलाई दिनुभएको यस असल देशबाट तिमीहरू चाँडै नै नाश हुनेछौ।”<verse eid="JOS 23:16"/></para>
<chapter eid="JOS 23"/>
<chapter number="24" style="c" sid="JOS 24"/>
<para style="p"><verse number="1" style="v" sid="JOS 24:1"/>तब यहोशूले इस्राएलका सबै कुलहरूलाई शेकेममा भेला गराए। तिनले इस्राएलका प्रधानहरू, अगुवाहरू, न्यायकर्ताहरू र अधिकृतहरूलाई बोलाए। अनि तिनीहरूले आफैँलाई परमेश्‍वरको सामु उपस्थित गराए।<verse eid="JOS 24:1"/></para>
<para style="p"><verse number="2" style="v" sid="JOS 24:2"/>यहोशूले ती सबै मानिसहरूलाई भने, “याहवेह इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘धेरै वर्षअगि अब्राहाम र नाहोरका बुबा तेरह लगायत तिमीहरूका पितापुर्खाहरू यूफ्रेटिस नदीपारि बस्दथे। अनि अरू देवी-देवताहरू पुज्दथे।<verse eid="JOS 24:2"/></para>
<para style="p"><verse number="3" style="v" sid="JOS 24:3"/>तर मैले तिमीहरूका पिता अब्राहामलाई त्यस नदी पारिको देशबाट ल्याएँ। अनि कनान देशभरि डोर्‍याएँ र उसलाई धेरै सन्तानहरू दिएँ। अनि मैले उसलाई इसहाक दिएँ।<verse eid="JOS 24:3"/></para>
<para style="p"><verse number="4" style="v" sid="JOS 24:4"/>इसहाकलाई मैले याकोब र एसाव दिएँ। मैले एसावलाई सेइरको पहाडी देश अधिकार गर्न दिएँ। तर याकोब र उसका छोराहरू तल इजिप्टतिर गए।<verse eid="JOS 24:4"/></para>
<para style="p"><verse number="5" style="v" sid="JOS 24:5"/>“ ‘तब मैले मोशा र हारूनलाई पठाएँ। अनि मैले इजिप्टमा विपत्तिहरू ल्याएर त्यहाँका मानिसहरूलाई कष्‍ट दिएँ। मैले तिमीहरूलाई बाहिर निकालेर ल्याएँ।<verse eid="JOS 24:5"/></para>
<para style="p"><verse number="6" style="v" sid="JOS 24:6"/>जब मैले तिमीहरूका पितापुर्खाहरूलाई इजिप्टबाट बाहिर निकालेर ल्याएँ, तब तिमीहरू लाल समुद्रमा आइपुग्यौ। अनि इजिप्टियनहरूले घोडचढीहरू र रथहरूसहित तिमीहरूलाई समुद्रसम्मै पछ्याए।<verse eid="JOS 24:6"/></para>
<para style="p"><verse number="7" style="v" sid="JOS 24:7"/>तर तिनीहरूले सहायताको निम्ति याहवेहसँग पुकार गरे। अनि मैले तिमीहरू र इजिप्टियनहरूको बीचमा अन्धकार पारेँ। मैले समुद्रलाई तिनीहरूमाथि घोप्ट्याइदिएँ; र तिनीहरूलाई डुबाइदिएँ। मैले इजिप्टियनहरूलाई गरेका कुरा तिमीहरूले आफ्नै आँखाले देख्यौ। त्यसपछि तिमीहरू उजाडस्थानमा लामो समयसम्म बस्यौ।<verse eid="JOS 24:7"/></para>
<para style="p"><verse number="8" style="v" sid="JOS 24:8"/>“ ‘मैले तिमीहरूलाई यर्दनको पूर्वमा बस्‍ने एमोरीहरूको देशमा ल्याएँ। तिनीहरूले तिमीहरू विरुद्ध युद्ध गरे। तर मैले तिनीहरूलाई तिमीहरूका हातमा सुम्पिदिएँ। मैले तिनीहरूलाई तिमीहरूको सामुबाट नाश गरिदिएँ। अनि तिमीहरूले तिनीहरूको देशमा अधिकार गर्‍यौ।<verse eid="JOS 24:8"/></para>
<para style="p"><verse number="9" style="v" sid="JOS 24:9"/>जब मोआबको राजा सिप्पोरको छोरा बालाकले इस्राएलको विरुद्धमा युद्ध गर्ने तयारी गर्‍यो, तब त्यसले तिमीहरूलाई सराप्न भनी बओरको छोरा बालामलाई बोलायो।<verse eid="JOS 24:9"/></para>
<para style="p"><verse number="10" style="v" sid="JOS 24:10"/>तर मैले बालामको कुरा सुनिनँ। यसैकारण त्यसले तिमीहरूलाई बारम्बार आशिष् दियो। अनि मैले तिमीहरूलाई बालकको हातबाट छुटाएँ।<verse eid="JOS 24:10"/></para>
<para style="p"><verse number="11" style="v" sid="JOS 24:11"/>“ ‘त्यसपछि तिमीहरू यर्दन पार गरेर यरीहोमा आयौ। अनि यरीहोका मानिसहरूले तिमीहरूको विरुद्धमा युद्ध गरे। तिनीहरूले जस्तै तिमीहरूको विरुद्धमा एमोरीहरू, परिज्जीहरू, कनानीहरू, हित्तीहरू, गिर्गाशीहरू, हिव्वीहरू र यबूसीहरूले पनि युद्ध गरे। तर मैले तिनीहरूलाई तिमीहरूका हातमा सुम्पिदिएँ।<verse eid="JOS 24:11"/></para>
<para style="p"><verse number="12" style="v" sid="JOS 24:12"/>मैले तिमीहरूको अगि-अगि अरिङ्गाल पठाइदिएँ; जसले तिनीहरूलाई र दुई एमोरी राजाहरूलाई पनि तिमीहरूको सामुबाट धपाइदिएँ। त्यो तिमीहरूको आफ्नै तरवार र धनुकाँडले गरेका थिएनौ।<verse eid="JOS 24:12"/></para>
<para style="p"><verse number="13" style="v" sid="JOS 24:13"/>यसरी मैले तिमीहरूलाई तिमीहरूले परिश्रम नै नगरेको देश र तिमीहरूले नबनाएका सहरहरू दिएँ। अनि तिमीहरू त्यहाँ बस्यौ र तिमीहरूले नरोपेका दाखबारी र जैतुनबारीका फल खाइरहेका छौ।’<verse eid="JOS 24:13"/></para>
<para style="p"><verse number="14" style="v" sid="JOS 24:14"/>“यसकारण अब याहवेहको डर मानेर पूर्ण विश्‍वासयोग्यतामा उहाँको सेवा गर। तिमीहरूका पितापुर्खाहरूले नदीपारि र इजिप्टमा पुजेका देवी-देवताहरू फ्याँक र याहवेहको सेवा गर।<verse eid="JOS 24:14"/></para>
<para style="p"><verse number="15" style="v" sid="JOS 24:15"/>तर यदि याहवेहको सेवा गर्न तिमीहरूलाई इच्छा लाग्दैन भने तिमीहरूले कसको सेवा गर्ने हो, नदीपारि तिमीहरूका पितापुर्खाहरूले पुजेका देवी-देवताहरू या तिमीहरू अहिले बसिरहेका एमोरीहरूका ठाउँका देवी-देवताहरू, सो रोज। तर म र मेरो घरानाले चाहिँ याहवेहकै सेवा गर्नेछौँ।”<verse eid="JOS 24:15"/></para>
<para style="p"><verse number="16" style="v" sid="JOS 24:16"/>तब मानिसहरूले जवाफ दिए, “हामीले याहवेहलाई त्यागेर अरू देवी-देवताहरूको सेवा गर्ने, यस्तो काम हामीबाट कदापि नहोस्!<verse eid="JOS 24:16"/></para>
<para style="p"><verse number="17" style="v" sid="JOS 24:17"/>हामी र हाम्रा पितापुर्खाहरूलाई दासत्वको देश इजिप्टबाट ल्याउनुहुने र हाम्रा आँखाकै सामु ती अलौकिक चिन्हहरू गर्नुहुने याहवेह हाम्रा परमेश्‍वर आफैँ हुनुहुन्छ। जब हामी ती सबै जातिहरूका बीचबाट भएर आयौँ, तब उहाँले नै हामीलाई हाम्रो यात्राभरि सुरक्षा गर्नुभयो।<verse eid="JOS 24:17"/></para>
<para style="p"><verse number="18" style="v" sid="JOS 24:18"/>अनि याहवेहले हाम्रो सामुबाट यस देशमा बस्‍ने एमोरीहरू लगायत सबै जातिहरूलाई धपाइदिनुभयो। हामी पनि याहवेहकै सेवा गर्नेछौँ; किनकि उहाँ हाम्रा परमेश्‍वर हुनुहुन्छ।”<verse eid="JOS 24:18"/></para>
<para style="p"><verse number="19" style="v" sid="JOS 24:19"/>यहोशूले मानिसहरूलाई भने, “तिमीहरूले याहवेहको सेवा गर्न सक्दैनौ; किनकि उहाँ पवित्र परमेश्‍वर हुनुहुन्छ। उहाँ डाह गर्ने परमेश्‍वर हुनुहुन्छ। उहाँले तिमीहरूका विद्रोह र पापहरू क्षमा गर्नुहुन्‍न।<verse eid="JOS 24:19"/></para>
<para style="p"><verse number="20" style="v" sid="JOS 24:20"/>यदि तिमीहरूले याहवेहलाई त्यागेर विदेशी देवी-देवताहरूलाई सेवा गर्‍यौ भने उहाँले तिमीहरूमाथि अहिलेसम्म गर्नुभएको भलाइबाट फर्कनुहुनेछ। अनि उहाँले तिमीहरूमाथि विपत्ति ल्याएर तिमीहरूलाई भष्म पारिदिनुहुनेछ।”<verse eid="JOS 24:20"/></para>
<para style="p"><verse number="21" style="v" sid="JOS 24:21"/>तर मानिसहरूले यहोशूलाई भने, “होइन! हामी याहवेहकै सेवा गर्नेछौँ।”<verse eid="JOS 24:21"/></para>
<para style="p"><verse number="22" style="v" sid="JOS 24:22"/>तब यहोशूले भने, “तिमीहरूले याहवेहको सेवा गर्न रोजेकोमा तिमीहरू आफैँ आफ्नो विरुद्धमा साक्षी छौ।” तिनीहरूले जवाफ दिए, “हजुर, हामी आफैँ साक्षी छौँ।”<verse eid="JOS 24:22"/></para>
<para style="p"><verse number="23" style="v" sid="JOS 24:23"/>यहोशूले भने, “त्यसो भए अब तिमीहरूसँग भएका विदेशी देवी-देवताहरू हटाओ। अनि तिमीहरूका हृदय याहवेह इस्राएलका परमेश्‍वरतर्फ लगाओ।”<verse eid="JOS 24:23"/></para>
<para style="p"><verse number="24" style="v" sid="JOS 24:24"/>अनि मानिसहरूले यहोशूलाई भने, “हामी याहवेह हाम्रा परमेश्‍वरकै सेवा गर्नेछौँ; र उहाँकै आज्ञापालन गर्नेछौँ।”<verse eid="JOS 24:24"/></para>
<para style="p"><verse number="25" style="v" sid="JOS 24:25"/>त्यस दिन यहोशूले मानिसहरूका निम्ति करार बाँधे। अनि शेकेममा तिनीहरूका निम्ति उर्दी र नियमहरू बनाए।<verse eid="JOS 24:25"/></para>
<para style="p"><verse number="26" style="v" sid="JOS 24:26"/>अनि यहोशूले ती कुराहरू परमेश्‍वरको व्यवस्थाको पुस्तकमा लेखे। त्यसपछि तिनले एउटा ठूलो ढुङ्गा लिए। अनि त्यसलाई याहवेहको पवित्र ठाउँको छेउमा फलाँटको रूखमुनि खडा गरे।<verse eid="JOS 24:26"/></para>
<para style="p"><verse number="27" style="v" sid="JOS 24:27"/>तिनले सबै मानिसहरूलाई भने, “हेर! यो ढुङ्गा हाम्रो विरुद्धमा साक्षी हुनेछ। याहवेहले हामीलाई भन्‍नुभएका सबै कुराहरू यसले सुनेको छ। तिमीहरू आफ्ना परमेश्‍वरप्रति विश्‍वासयोग्य रहेनौ भने यो तिमीहरूको विरुद्धमा साक्षी हुनेछ।”<verse eid="JOS 24:27"/></para>
<para style="p"><verse number="28" style="v" sid="JOS 24:28"/>त्यसपछि यहोशूले प्रत्येक मानिसहरूलाई तिनीहरूका आ-आफ्नै उत्तराधिकारको ठाउँमा पठाइदिए।<verse eid="JOS 24:28"/></para>
<para style="p"><verse number="29" style="v" sid="JOS 24:29"/>यी कुराहरूपछि याहवेहका सेवक, नूनका छोरा यहोशूको एक सय दश वर्षको उमेरमा मृत्यु भयो।<verse eid="JOS 24:29"/></para>
<para style="p"><verse number="30" style="v" sid="JOS 24:30"/>अनि तिनीहरूले उनलाई उनको उत्तराधिकारको ठाउँ गाश पर्वतको उत्तरमा भएको एफ्राइमको पहाडी मुलुकमा रहेको तिम्नथ-सेरहमा गाडे।<verse eid="JOS 24:30"/></para>
<para style="p"><verse number="31" style="v" sid="JOS 24:31"/>इस्राएलले यहोशूको र उनीभन्दा धेरै बाँचेका प्रधानहरूका जीवनकालभरि नै याहवेहको सेवा गर्दैरहे जसले इस्राएलका निम्ति याहवेहले गर्नुभएको हरेक कुराहरूको अनुभव गरेका थिए।<verse eid="JOS 24:31"/></para>
<para style="p"><verse number="32" style="v" sid="JOS 24:32"/>इस्राएलीहरूले इजिप्टबाट ल्याएका योसेफका हड्डीहरू शेकेमका पिता हामोरका छोराहरूबाट एक सय चाँदीका टुक्राहरूमा याकोबले किनेको जमिन शेकेममा गाडे। त्यो शेकेम योसेफका सन्तानको उत्तराधिकार भयो।<verse eid="JOS 24:32"/></para>
<para style="p"><verse number="33" style="v" sid="JOS 24:33"/>अनि हारूनका छोरा एलाजारको पनि मृत्यु भयो। तब तिनका छोरा पीनहासलाई दिइएको भाग एफ्राइमको पहाडी मुलुकको गेबामा तिनलाई गाडियो।<verse eid="JOS 24:33"/></para>
<chapter eid="JOS 24"/>
</usx>